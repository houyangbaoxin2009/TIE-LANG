type tie<class>
// crc.tie：嵌入式基础层（rdu）——增量式校验模块（命名空间 rdu_crc）
// 层级定位：rdu = Reusable Device Utils，嵌入式基础层——面向裸机/无操作系统的
// 底层场景提供纯计算工具，编译出的 .a 零运行时依赖（freestanding 可直接链接）。
// 用途：逐字节校验和 / 哈希（**非加密安全**，可碰撞，勿用于密码/签名/防篡改）。
//
// 无栈纪律（本模块全部满足）：
//   1. 零原语调用：只用位运算（& | ^ << >>）与算术/比较，不调用任何语言底座
//      内建函数（std/crypto.tie 依赖 str_len/str_char/char_code 与查表，rdu 版
//      改为逐位纯算法，无表无原语）；函数参数只接受 i64 标量（字节）；
//   2. 零动态内存：不创建表（无 CRC 查表）、不拼接字符串；
//   3. 无递归；
//   4. 无顶层全局变量（无惰性表构建，纯函数，同输入同输出）；
//   5. 编译出的 .a 无任何外部函数声明（IR 中无 declare），裸机可直接链接。
//
// 增量式用法（调用方逐字节喂入 + final 收尾，任意长度数据只需常数状态）：
//   var crc: i64 = rdu_crc.crc32_init()
//   // 对每个字节 b（0..255）：crc = rdu_crc.crc32_update(crc, b)
//   var sum: i64 = rdu_crc.crc32_final(crc)
//   crc8 / crc16 同理（final 为空操作，仅保持接口一致）。
//
// == 移位语义 ==
//   i64 的 `>>` 生成 ashr（算术右移）。本模块所有移位操作数恒为正（crc 值每步
//   & 掩码 / 除以 2 后 < 2^32 且符号位恒为 0），算术右移即等价逻辑右移，高位补 0，
//   逐字节位运算正确（与 std/crypto.tie 的论证一致）。
//
// == crc8 算法选择说明（与任务描述有出入，以标准校验向量为准）==
//   任务描述的反射式算法（lsb 判断 + c>>1 + c^0x07）对标准向量 "123456789" 产出
//   0x02，而 CRC-8/ATM 官方校验向量为 0xF4=244。CRC-8/ATM（多项式 0x07）是
//   非反射（refin=false）CRC，标准逐位算法为 MSB-first：判断最高位，c 左移，
//   最高位为 1 则异或 0x07。本模块采用该标准算法以保证 demo 期望值 0xF4 成立。
//   （异或 0x07 只影响低 8 位，先左移截断再异或与先异或再截断结果一致，已实测验证）
//
// == crc32/fnv1a 数值安全 ==
//   crc32 每步结果恒 < 2^32 且恒正（0xEDB88320 < 2^32，c>>1 < 2^31，异或后仍
//   < 2^32），输出 ^ 0xFFFFFFFF 亦 < 2^32。fnv1a 乘法 (2^32-1)*0x01000193 ≈
//   7.2e16 << i64::MAX（9.2e18），永不溢出；每步 & 0xFFFFFFFF 掩码保证恒正。
//
// 调用：import 后 rdu_crc.crc8_update(...) / rdu_crc.fnv1a_update(...)。
// 命名规范：命名空间内函数不加 rdu_crc_ 前缀（与 std/crypto.tie 风格一致）。

namespace rdu_crc {
// ==================== CRC-8（CRC-8/ATM，多项式 0x07，非反射）====================
// 初始化：返回初始校验值 0（CRC-8/ATM init = 0x00，xorout = 0x00）
pub func crc8_init() -> i64 {
    return 0
}

// 更新：喂入一个字节，返回新的 8 位 CRC（恒 < 256）
// 非反射 MSB-first 逐位算法：c ^= byte，8 次「最高位为 1 则 (c<<1)^0x07 否则 c<<1」，
// 左移后用 & 0xFF 截断回 8 位（0x07 的位全在低 8 位，截断顺序不影响结果）
pub func crc8_update(crc: i64, byte: i64) -> i64 {
    var c: i64 = crc ^ byte
    var k: i64 = 0
    while k < 8 {
        if (c & 0x80) != 0 {
            c = ((c << 1) ^ 0x07) & 0xFF
        } else {
            c = (c << 1) & 0xFF
        }
        k = k + 1
    }
    return c
}

// ==================== CRC-16（CRC-16/IBM，反射多项式 0xA001）====================
// 初始化：返回初始校验值 0（CRC-16/IBM init = 0x0000，xorout = 0x0000）
pub func crc16_init() -> i64 {
    return 0
}

// 更新：喂入一个字节，返回新的 16 位 CRC（恒 < 65536）
// 反射式逐位算法：c ^= byte，8 次「最低位为 1 则 (c>>1)^0xA001 否则 c>>1」；
// 0xA001 < 2^16，c 每步 < 2^16，正数算术右移即逻辑右移
pub func crc16_update(crc: i64, byte: i64) -> i64 {
    var c: i64 = crc ^ byte
    var k: i64 = 0
    while k < 8 {
        var lsb: i64 = c & 1
        c = c >> 1
        if lsb != 0 {
            c = c ^ 0xA001
        }
        k = k + 1
    }
    return c
}

// ==================== CRC-32（CRC-32/IEEE 802.3，反射多项式 0xEDB88320）========
// 初始化：返回初始校验值 0xFFFFFFFF（IEEE 802.3 init = 0xFFFFFFFF）
pub func crc32_init() -> i64 {
    return 0xFFFFFFFF
}

// 更新：喂入一个字节，返回新的 32 位 CRC（恒 < 2^32）
// 反射式逐位算法：c ^= byte，8 次「最低位为 1 则 (c>>1)^0xEDB88320 否则 c>>1」；
// 0xEDB88320 < 2^32，c 每步 < 2^32 恒正，算术右移即逻辑右移
pub func crc32_update(crc: i64, byte: i64) -> i64 {
    var c: i64 = crc ^ byte
    var k: i64 = 0
    while k < 8 {
        var lsb: i64 = c & 1
        c = c >> 1
        if lsb != 0 {
            c = c ^ 0xEDB88320
        }
        k = k + 1
    }
    return c
}

// 收尾：输出异或 0xFFFFFFFF（IEEE 802.3 xorout = 0xFFFFFFFF），结果恒 < 2^32
// 标准校验向量：crc32("123456789") == 0xCBF43926 == 3421780262
pub func crc32_final(crc: i64) -> i64 {
    return crc ^ 0xFFFFFFFF
}

// ==================== FNV-1a（32 位）============================================
// 初始化：返回偏移基数 0x811C9DC5（2166136261）
pub func fnv1a_init() -> i64 {
    return 0x811C9DC5
}

// 更新：喂入一个字节，返回新的 32 位 FNV-1a 哈希（恒 < 2^32）
// 算法：(h ^ 字节) * 0x01000193，再 & 0xFFFFFFFF 截断回 32 位；
// 乘法数值 (2^32-1)*0x01000193 ≈ 7.2e16 < i64::MAX 9.2e18，安全不溢出
pub func fnv1a_update(hash: i64, byte: i64) -> i64 {
    var h: i64 = (hash ^ byte) & 0xFFFFFFFF
    h = (h * 0x01000193) & 0xFFFFFFFF
    return h
}
}
