type tie<class>
// fixed.tie：嵌入式基础层（rdu）——Q16.16 定点数模块（命名空间 rdu_fixed）
// 层级定位：rdu = Reusable Device Utils，嵌入式基础层——面向裸机/无操作系统的
// 底层场景提供纯计算工具，编译出的 .a 零运行时依赖（freestanding 可直接链接）。
// 用途：无 FPU 的裸机芯片上以整数近似浮点（16 位整数部分 + 16 位小数部分），
// 表示方式：i64 低 16 位为小数，高 48 位为整数（约定数值在 ±2^15 量级内使用）。
//
// 无栈纪律（本模块全部满足）：
//   1. 零原语调用：只用移位 / 乘法 / 除法 / 按位与，不调用任何语言底座内建函数；
//   2. 零动态内存：参数全部为 i64 标量；
//   3. 无递归；
//   4. 无顶层全局变量（纯函数，同输入同输出）；
//   5. 编译出的 .a 无任何外部函数声明（IR 中无 declare），裸机可直接链接。
//
// 说明：fixed_to_f64 / fixed_from_f64 被省略——本仓库现有 i64↔f64 互转均经由
// 字符串原语实现（std/linalg.tie、std/exmath.tie 的 to_f64 用 parse_float(to_string(v))），
// 违反无栈纪律（禁止 to_string 等原语），故不提供浮点互转；需要双精度时请自行
// 在带 FPU 的环境用 f64 类型（见 rdu/math.tie）。
// 注：fixed_div 与 fixed_floor 对负数取整方向为向零截断（除法）与算术右移向下
// 取整，与 C 语言整型语义一致。
//
// 调用：import 后 rdu_fixed.fixed_mul(...) / rdu_fixed.fixed_div(...)。
// 命名规范：命名空间内函数不加 rdu_fixed_ 前缀（与 std 库风格一致）。

namespace rdu_fixed {
// 定点乘法：Q16.16 * Q16.16 = (a*b) 的低 16 位小数仍落在低 16 位，故右移 16 位
// 数值安全：a/b 各约 32 位有效（约定值域），乘积 ≤ 64 位 i64 范围内不溢出
// 例：fixed_mul(3<<16, 2<<16) = (3*2)<<16 = 6<<16 = 393216
pub func fixed_mul(a: i64, b: i64) -> i64 {
    return (a * b) >> 16
}

// 定点除法：Q16.16 / Q16.16 = (a<<16)/b；b==0 防御性返回 0
// 原理：a = A*2^16（A 为真实值），a/b = A/B 应为 Q16.16 表示即 (A/B)*2^16，
// 展开 (a<<16)/b = (A*2^16*2^16)/(B*2^16) = (A/B)*2^16 ✓
// 数值安全：a<<16 为 48 位有效，i64 范围内安全
// 例：fixed_div(6<<16, 2<<16) = (6*2^16*2^16)/(2*2^16) = 3*2^16 = 3<<16 = 196608
pub func fixed_div(a: i64, b: i64) -> i64 {
    if b == 0 {
        return 0
    }
    return (a << 16) / b
}

// 定点取整：去掉小数部分（右移 16 位即 Q16.16 → 整数）
// 例：fixed_floor(6<<16 = 393216) = 6
pub func fixed_floor(a: i64) -> i64 {
    return a >> 16
}

// 取小数部分：低 16 位（0..65535，即 0.0..0.99998 的定点表示）
// 例：fixed_frac(6<<16) = 0；fixed_frac(6<<16 + 0x8000) = 0x8000（0.5）
pub func fixed_frac(a: i64) -> i64 {
    return a & 0xFFFF
}
}
