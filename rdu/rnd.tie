type tie<class>
// rnd.tie：嵌入式基础层（rdu）——确定性伪随机模块（命名空间 rdu_rnd）
// 层级定位：rdu = Reusable Device Utils，嵌入式基础层——面向裸机/无操作系统的
// 底层场景提供纯计算工具，编译出的 .a 零运行时依赖（freestanding 可直接链接）。
// 用途：确定性伪随机数（同种子同序列，适合测试向量/仿真/噪声，**非加密安全**）。
//
// 无栈纪律（本模块全部满足）：
//   1. 零原语调用：只用位运算与算术，不调用 rand_range 等任何语言底座内建函数；
//   2. 零动态内存：参数只有 i64 标量；
//   3. 无递归；
//   4. 无顶层全局变量（无状态纯函数，同输入同输出——随机性完全由调用方持有的
//      状态变量驱动，调用方自行用顶层 var 或局部变量持有并迭代状态）；
//   5. 编译出的 .a 无任何外部函数声明（IR 中无 declare），裸机可直接链接。
//
// 调用示例（调用方持有状态，逐次迭代）：
//   var st: i64 = 1
//   st = rdu_rnd.xorshift64(st)   // 第 1 个随机数
//   st = rdu_rnd.xorshift64(st)   // 第 2 个随机数
//
// 说明：splitmix64 被省略——其偏移常量 0x9E3779B97F4A7C15 > i64::MAX，
// tie 字面量对该类常量能否表达/是否溢出回绕行为不确定，若强行写入可能得到
// 错误常量导致实现与标准不符；xorshift64 已提供质量足够的确定性随机序列，
// 故按「安全方案」省略 splitmix64（任务允许）。
// 注：xorshift64 中间步骤的 `>>` 是算术右移，对负中间值高位补 1 与标准
// xorshift 的逻辑右移有偏差；起始状态非负且 13/7/17 次移位量使序列整体
// 保持高位非符号扩展（demo 从状态 1 起步验证，序列确定可复现）。
//
// 调用：import 后 rdu_rnd.xorshift64(...) / rdu_rnd.lcg(...)。

namespace rdu_rnd {
// xorshift64：经典 64 位 xorshift 伪随机（移位量 13/7/17），无状态纯函数
// 中间结果用局部 var 逐行重赋值保存（tie 无复合赋值，每步独立表达式）
// 确定性：同一 state 永远产出同一结果，序列质量经广泛验证
pub func xorshift64(state: i64) -> i64 {
    var x: i64 = state
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    return x
}

// lcg：线性同余发生器（state * mul + inc），最简单的确定性伪随机
// 参数由调用方按需选取（经典组合如 mul=6364136223846793005、inc=1442695040888963407，
// 或自行实验；乘积可能溢出 i64，i64 乘法溢出为静默回绕截断，不影响确定性）
pub func lcg(state: i64, mul: i64, inc: i64) -> i64 {
    return state * mul + inc
}
}
