type tie<logic>
// scripts/migrate_tie_type.tie：旧 `// tie:xxx` 头部注释声明 → 新 `type tie<X>` 声明 迁移工具
// 用法：<exe> <文件或目录>...     递归处理 *.tie（排除含 archive 的路径与脚本自身）
// 迁移映射（仅头部区）：
//   `// tie:logic`   → `type tie<logic>`
//   `// tie:library` → `type tie<class>`
//   `// tie:data`    → `type tie<data>`
//   `// tie:ui`      → `type tie<ui>`
//   `// tie:db`      → `type tie<db>`
//   `// tie:opt=...` / `// tie:target=...` → 删除该行（选项体系已移除，opt 仅 CLI）
//   其他 `// tie:...` → 保留原样（普通注释）
// 头部区 = 文件最前连续行（允许空行间隔），遇第一个非空非 `// tie:` 行停止；
// 头部区之外的行一律不动。自包含（零 import），仅用语言底座原语。

// ==================== 自包含字符串工具（码点级） ====================

// 去除首尾空白（空格/制表）
func s_trim(s: string) -> string {
    var n: i64 = str_len(s)
    var start: i64 = 0
    while start < n && (str_char(s, start) == " " || str_char(s, start) == "\t") {
        start = start + 1
    }
    var end: i64 = n
    while end > start && (str_char(s, end - 1) == " " || str_char(s, end - 1) == "\t") {
        end = end - 1
    }
    return s_slice(s, start, end)
}

// 取 [start, end) 子串（码点级；越界按边界收敛）
func s_slice(s: string, start: i64, end: i64) -> string {
    var out: string = ""
    var i: i64 = start
    while i < end {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

// s 是否以 p 开头
func s_has_prefix(s: string, p: string) -> bool {
    var n: i64 = str_len(s)
    var m: i64 = str_len(p)
    if n < m {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_char(s, i) != str_char(p, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// s 是否以 suf 结尾
func s_has_suffix(s: string, suf: string) -> bool {
    var n: i64 = str_len(s)
    var m: i64 = str_len(suf)
    if n < m {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_char(s, n - m + i) != str_char(suf, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// s 是否含子串 sub
func s_contains(s: string, sub: string) -> bool {
    var n: i64 = str_len(s)
    var m: i64 = str_len(sub)
    if m == 0 {
        return true
    }
    var i: i64 = 0
    while i + m <= n {
        var j: i64 = 0
        var hit = true
        while j < m {
            if str_char(s, i + j) != str_char(sub, j) {
                hit = false
                break
            }
            j = j + 1
        }
        if hit {
            return true
        }
        i = i + 1
    }
    return false
}

// 按 \n 拆行（保留空行；丢弃行尾 \r）
func s_lines(s: string) -> table<string> {
    var rows = table_new_string()
    var n: i64 = str_len(s)
    var cur: string = ""
    var i: i64 = 0
    while i < n {
        var c = str_char(s, i)
        if c == "\n" {
            table_push(rows, cur)
            cur = ""
        } else if c != "\r" {
            cur = cur + c
        }
        i = i + 1
    }
    table_push(rows, cur)
    return rows
}

// 用 \n 连接表元素（无尾部换行）
func s_join(rows: table<string>) -> string {
    var out: string = ""
    var n: i64 = len(rows)
    var i: i64 = 0
    while i < n {
        if i > 0 {
            out = out + "\n"
        }
        out = out + rows[i]
        i = i + 1
    }
    return out
}

// 取路径文件名（最后一个 / 或 \ 之后）
func s_file_name(p: string) -> string {
    var n: i64 = str_len(p)
    var last: i64 = -1
    var i: i64 = 0
    while i < n {
        var c = str_char(p, i)
        if c == "/" || c == "\\" {
            last = i
        }
        i = i + 1
    }
    if last < 0 {
        return p
    }
    return s_slice(p, last + 1, n)
}

// ==================== 迁移规则 ====================

// 单行迁移：返回迁移后行；返回空串 = 删除该行
func migrate_line(raw: string) -> string {
    var t = s_trim(raw)
    if !s_has_prefix(t, "// tie:") {
        return raw
    }
    var rest = s_trim(s_slice(t, 7, str_len(t)))
    if rest == "logic" {
        return "type tie<logic>"
    }
    if rest == "library" {
        return "type tie<class>"
    }
    if rest == "data" {
        return "type tie<data>"
    }
    if rest == "ui" {
        return "type tie<ui>"
    }
    if rest == "db" {
        return "type tie<db>"
    }
    // 选项行：opt=/target=（选项体系已移除，opt 仅 CLI）
    if s_has_prefix(rest, "opt=") || s_has_prefix(rest, "target=") {
        return ""
    }
    return raw
}

// 迁移单个文件：返回 0=未变 / 1=已变 / -1=失败
func migrate_file(path: string) -> i64 {
    if !file_exists(path) {
        println("跳过(不存在): " + path)
        return -1
    }
    var src = file_read(path)
    var lines = s_lines(src)
    var changed: i64 = 0
    var in_header = true
    var out = table_new_string()
    var n: i64 = len(lines)
    var i: i64 = 0
    while i < n {
        var ln = lines[i]
        if in_header {
            var t = s_trim(ln)
            if str_len(t) == 0 {
                // 头部区空行：保留
                table_push(out, ln)
            } else if s_has_prefix(t, "// tie:") {
                var m = migrate_line(ln)
                if str_len(m) == 0 {
                    // 行删除
                    changed = changed + 1
                } else {
                    if m != ln {
                        changed = changed + 1
                    }
                    table_push(out, m)
                }
            } else {
                // 第一个非头部行：头部区结束，原样保留
                in_header = false
                table_push(out, ln)
            }
        } else {
            table_push(out, ln)
        }
        i = i + 1
    }
    if changed > 0 {
        if !file_write(path, s_join(out)) {
            println("写入失败: " + path)
            return -1
        }
        println("迁移: " + path + "（" + to_string(changed) + " 行变更）")
        return 1
    }
    return 0
}

// 递归处理目录：walk_dir 返回相对路径（含子目录）；返回变更文件数
func process_dir(dir: string, self_name: string) -> i64 {
    var rows = walk_dir(dir)
    var total: i64 = 0
    var n: i64 = len(rows)
    var i: i64 = 0
    while i < n {
        var rel = rows[i]
        // 排除 archive 归档目录（历史存档不迁移）
        if s_contains(rel, "archive") {
            i = i + 1
            continue
        }
        // 只处理 .tie 文件
        if !s_has_suffix(rel, ".tie") {
            i = i + 1
            continue
        }
        // 跳过脚本自身
        if s_file_name(rel) == self_name {
            i = i + 1
            continue
        }
        var full = dir + "/" + rel
        var c = migrate_file(full)
        if c > 0 {
            total = total + 1
        }
        i = i + 1
    }
    return total
}

// ==================== 入口 ====================

// 入口：对每个参数（文件或目录）执行迁移；返回 0 = 完成。
func main() -> i64 {
    var n = arg_count()
    var files_changed: i64 = 0
    var params: i64 = 0
    var self_name = "migrate_tie_type.tie"
    var i: i64 = 0
    while i < n {
        var p = arg_string(i)
        params = params + 1
        if s_has_suffix(p, ".tie") {
            // 单文件参数
            var c = migrate_file(p)
            if c > 0 {
                files_changed = files_changed + 1
            }
        } else {
            // 目录参数：递归
            var c = process_dir(p, self_name)
            files_changed = files_changed + c
        }
        i = i + 1
    }
    println("完成: 处理 " + to_string(params) + " 个参数，变更 " + to_string(files_changed) + " 个文件")
    return 0
}
