type tie<class>
// intern.tie：标准库——字符串池（intern，命名空间 intern，自举 T0.6）
// 作用：把字符串登记为稳定整数 id（相同串返回相同 id），供编译器符号表把
// O(len) 字符串比较降为 O(1) 整数比较（阶段 2 compiler/lib/interner.tie 消费，
// AST 名字字段存池 id——B1 列式设计依赖）。
//
// 数据结构（性能重构：哈希桶版）：
// - intern_pool  : table<string>  id -> 串（按登记序追加，pool[id] == 该 id 的串）
// - intern_keys  : table<string>  正查键：已登记串（无序，追加序）
// - intern_vals  : table<i64>     与 intern_keys 平行，keys[i] 对应 vals[i]（id）
// - intern_bucket: table<i64>     哈希桶（开放寻址线性探测）；桶值 = keys 下标 + 1，
//                  0 = 空槽（keys 下标从 0 起，+1 偏移让 0 可做空哨兵）
// - intern_bcnt  : i64            桶数（2 的幂增长，初值 1024）
// 正查 = 哈希定位 + 线性探测（每次探测一次 strcmp 确认）；插入 = 纯追加
// keys/vals + 桶登记（O(1)），负载 > 0.7 时翻倍 rehash（全量重探测）。
//
// 历史性能教训（防回归）：
// - 初版「追加尾部 + 向前冒泡」：O(n) 次 strcmp + O(n) 交换，每次插入 → O(n²) strcmp；
// - 二版「二分定位 + 从尾向前位移」：O(log n) 次 strcmp + O(n) 表搬移/次插入 →
//   O(n²) 搬移总量。自举实测：数万 lexeme 登记构成 parse 阶段平方热点；
// - 本版（哈希桶）：查找 O(1) 均摊（1~2 次 strcmp + 探测），插入纯追加 O(1)
//   均摊，rehash 摊入后续操作。整体 O(n) —— 三代演进的终点结构。
//
// 约定（接口稳定，消费者依赖）：
// - id 从 0 递增分配（首次登记得 0，之后逐个 +1）；重复登记返回原 id，不新增条目；
// - lookup(id) 对未登记 id（含负数、越界）返回空串 "" 哨兵；编译器侧另有
//   -1 表示"无名字"，与本哨兵区分——调用方须先判空串再判 -1；
// - 池为模块级全局状态：同一进程内跨函数、跨模块调用共享（import 文本内联，
//   全局变量随内联进入消费文件顶层，main 入口运行时初始化）。
// 调用：import 后 intern.intern(...) / intern.lookup(...) / intern.interned_len()
// 命名规范：命名空间内函数不加 intern_ 前缀；内部工具私有（非 pub）。

// 全局状态：id -> 串（反向表，按登记序）
var intern_pool: table<string>;
// 正查键表：已登记串（无序追加序；有序性无人依赖——旧二分已被哈希替代）
var intern_keys: table<string>;
// 正查值表：与 intern_keys 平行，keys[i] 对应串的 id
var intern_vals: table<i64>;
// 哈希桶（开放寻址线性探测）：桶值 = keys 下标 + 1；0 = 空槽
var intern_bucket: table<i64>;
// 桶数（2 的幂，从 1024 起）
var intern_bcnt: i64 = 0;

namespace intern {

// 哈希函数：Java 式多项式滚动（h = h*31 + byte），i64 乘法溢出环绕（哈希
// 只要求进程内一致性，环绕无害）。字节级扫描 O(len)，比 strcmp 便宜。
// 返回前取非负（桶下标模运算要求非负）。
func hash_str(s: string) -> i64 {
    var h: i64 = 0
    var n: i64 = len(s)
    var i: i64 = 0
    while i < n {
        h = h * 31 + str_byte(s, i)
        i = i + 1
    }
    if h < 0 {
        h = 0 - h
    }
    return h
}

// 桶初始化（首次 intern 时懒执行）：1024 桶全空（0 填充）
func bucket_init() {
    if intern_bcnt > 0 {
        return
    }
    intern_bcnt = 1024
    intern_bucket = table_new_i64()
    var i: i64 = 0
    while i < intern_bcnt {
        table_push(intern_bucket, 0)
        i = i + 1
    }
}

// 单键登记进桶（线性探测放首个空槽）：key_idx 为 keys 下标。
// 调用前提：该串尚未在桶中（intern 主流程已探测未命中）。
func bucket_put(key_idx: i64) {
    var s = intern_keys[key_idx]
    var h = hash_str(s)
    var i = h % intern_bcnt
    while intern_bucket[i] != 0 {
        i = i + 1
        if i >= intern_bcnt {
            i = 0
        }
    }
    intern_bucket[i] = key_idx + 1
}

// 负载超 0.7 → 桶翻倍重建（全量 keys 重新探测登记；均摊 O(1)/次插入）
func bucket_grow() {
    var cnt = len(intern_keys)
    if cnt * 10 <= intern_bcnt * 7 {
        return
    }
    var new_bcnt = intern_bcnt * 2
    intern_bucket = table_new_i64()
    var i: i64 = 0
    while i < new_bcnt {
        table_push(intern_bucket, 0)
        i = i + 1
    }
    intern_bcnt = new_bcnt
    // 全量重登记
    var k: i64 = 0
    while k < cnt {
        bucket_put(k)
        k = k + 1
    }
}

// 把字符串 s 登记进池，返回稳定 id：相同串返回相同 id（id 从 0 递增）。
// 哈希探测查找（O(1) 均摊）；未命中 → 纯追加 keys/vals + 桶登记。
pub func intern(s: string) -> i64 {
    bucket_init()
    var h = hash_str(s)
    var i = h % intern_bcnt
    // 线性探测：非空槽逐个 strcmp 确认；空槽 = 未登记
    while intern_bucket[i] != 0 {
        var k = intern_bucket[i] - 1
        if intern_keys[k] == s {
            return intern_vals[k]
        }
        i = i + 1
        if i >= intern_bcnt {
            i = 0
        }
    }
    // 新串：id 为追加前池长（0 起始递增）；keys/vals 纯追加（零位移）
    var id: i64 = len(intern_pool)
    table_push(intern_pool, s)
    table_push(intern_keys, s)
    table_push(intern_vals, id)
    // 桶登记（放当前空槽 i；桶值 = keys 下标 + 1，末元素下标 = len-1）
    intern_bucket[i] = len(intern_keys)
    // 负载检查（翻倍 rehash 均摊）
    bucket_grow()
    return id
}

// id -> 串（pool 下标 O(1)）；id 未登记（负数或 >= 池长）返回约定哨兵空串 ""。
// 注意：空串哨兵与编译器侧 -1"无名字"哨兵是不同约定——空串表示"该 id 未登记"。
pub func lookup(id: i64) -> string {
    if id < 0 {
        return ""
    }
    if id >= len(intern_pool) {
        return ""
    }
    return intern_pool[id]
}

// 池中当前条目数（已登记的不同串数量）。
pub func interned_len() -> i64 {
    return len(intern_pool)
}
}
