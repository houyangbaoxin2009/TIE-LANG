type tie<class>
// string.tie：标准库——字符串工具函数（命名空间 str，string 是类型关键字不可用）
// 全部基于 str_char + str_len + 字符串拼接 + 循环/分支实现，不使用下标索引与字符转换
// 注意：字符串**码点级**遍历必须用 str_len（码点数）而非 len（字节数）——str_char
// 按码点索引，中文等多字节字符（UTF-8 一个汉字 3 字节）下 len 的字节数会放大
// 边界导致 trim/slice 等错位（尾随空白无法去除、子串匹配错位）。表元素数仍用 len。
// 调用：import 后 str.trim(...) / str.split(...)；命名空间内互调为裸调用
// 命名规范：命名空间内函数不加 str_ 前缀（统一 func 写法，Harbor M2.1.6）

namespace str {
// 判断单字符字符串是否为空白字符（空格、制表符、换行、回车）
func is_whitespace(c: string) -> bool {
    if c == " " {
        return true
    }
    if c == "\t" {
        return true
    }
    if c == "\n" {
        return true
    }
    if c == "\r" {
        return true
    }
    return false
}

// 去除字符串首尾空白字符；全空白字符串返回空串
pub func trim(s: string) -> string {
    return trim_end(trim_start(s))
}

// 去掉字符串首部空白字符；全空白字符串返回空串
pub func trim_start(s: string) -> string {
    var n: i64 = str_len(s)
    var start: i64 = 0
    while start < n && is_whitespace(str_char(s, start)) {
        start = start + 1
    }
    return slice(s, start, n)
}

// 去掉字符串尾部空白字符；全空白字符串返回空串
pub func trim_end(s: string) -> string {
    var n: i64 = str_len(s)
    var end: i64 = n
    while end > 0 && is_whitespace(str_char(s, end - 1)) {
        end = end - 1
    }
    return slice(s, 0, end)
}

// 截取字符串 [start, end) 区间的子串；越界自动收敛到边界；空串或 start>=end 返回空串。
// 性能重写（O(n)）：旧实现逐字符 `result + str_char(s,i)` 是双重 O(n²)——
// 每次 `+` 全量拷贝 result + str_char 每次从头跳 i 个码点。新实现：
// 一次码点扫描定位字节区间 [byte_lo, byte_hi)，StringBuilder 逐字节拷贝。
pub func slice(s: string, start: i64, end: i64) -> string {
    var n: i64 = str_len(s)
    // 空串直接返回空串
    if n == 0 {
        return ""
    }
    // 收敛 start 到 [0, n]
    var lo: i64 = start
    if lo < 0 {
        lo = 0
    }
    if lo > n {
        lo = n
    }
    // 收敛 end 到 [0, n]
    var hi: i64 = end
    if hi < 0 {
        hi = 0
    }
    if hi > n {
        hi = n
    }
    // start >= end 返回空串
    if lo >= hi {
        return ""
    }
    // 定位起点字节偏移：跳过 lo 个码点
    var byte_lo: i64 = 0
    var i: i64 = 0
    while i < lo {
        byte_lo = byte_lo + utf8_seq_len(s, byte_lo)
        i = i + 1
    }
    // 定位终点字节偏移：再数 hi - lo 个码点（顺路扫描，不回头）
    var byte_hi: i64 = byte_lo
    var j: i64 = lo
    while j < hi {
        byte_hi = byte_hi + utf8_seq_len(s, byte_hi)
        j = j + 1
    }
    // 字节区间逐字节拷贝进 StringBuilder（二进制安全）→ 一次产串
    var sb = string_builder()
    var k: i64 = byte_lo
    while k < byte_hi {
        sb_append_byte(sb, str_byte(s, k))
        k = k + 1
    }
    return sb_build(sb)
}

// 判断 s 是否包含子串 sub；空子串视为包含
pub func contains(s: string, sub: string) -> bool {
    var n: i64 = str_len(s)
    var m: i64 = str_len(sub)
    // 空子串总是包含
    if m == 0 {
        return true
    }
    // 子串比主串长，不可能包含
    if m > n {
        return false
    }
    // 从每个起点位置尝试完整匹配
    var i: i64 = 0
    while i <= n - m {
        var j: i64 = 0
        var matched: bool = true
        while j < m && matched {
            if str_char(s, i + j) != str_char(sub, j) {
                matched = false
            }
            j = j + 1
        }
        if matched {
            return true
        }
        i = i + 1
    }
    return false
}

// 返回子串 sub 在 s 中首次出现的位置（字符索引，从 0 起）；未找到返回 -1。
// 空子串视为在位置 0 命中；子串比主串长必然未找到。
// 与 contains 同扫描模式：从每个起点完整匹配，命中即返回该起点。
pub func find(s: string, sub: string) -> i64 {
    var n: i64 = str_len(s)
    var m: i64 = str_len(sub)
    // 空子串：位置 0 命中
    if m == 0 {
        return 0
    }
    // 子串比主串长，不可能匹配
    if m > n {
        return -1
    }
    var i: i64 = 0
    while i <= n - m {
        var j: i64 = 0
        var matched: bool = true
        while j < m && matched {
            if str_char(s, i + j) != str_char(sub, j) {
                matched = false
            }
            j = j + 1
        }
        if matched {
            return i
        }
        i = i + 1
    }
    return -1
}

// 判断 s 是否以 prefix 开头；空前缀视为真
pub func starts_with(s: string, prefix: string) -> bool {
    var n: i64 = str_len(s)
    var m: i64 = str_len(prefix)
    // 前缀比主串长，不可能匹配
    if m > n {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_char(s, i) != str_char(prefix, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 判断 s 是否以 suffix 结尾；空后缀视为真
pub func ends_with(s: string, suffix: string) -> bool {
    var n: i64 = str_len(s)
    var m: i64 = str_len(suffix)
    // 后缀比主串长，不可能匹配
    if m > n {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_char(s, n - m + i) != str_char(suffix, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 将 s 中所有出现的 from 替换为 to；from 为空串时原样返回（避免死循环）
pub func replace(s: string, from: string, to: string) -> string {
    var n: i64 = str_len(s)
    var m: i64 = str_len(from)
    // from 为空串：不替换，直接返回原串
    if m == 0 {
        return s
    }
    var result: string = ""
    var i: i64 = 0
    while i < n {
        // 检查从 i 开始是否完整匹配 from
        var matched: bool = true
        var j: i64 = 0
        while j < m && matched {
            if i + j >= n {
                matched = false
            } else if str_char(s, i + j) != str_char(from, j) {
                matched = false
            }
            j = j + 1
        }
        if matched {
            // 匹配成功：追加 to，跳过 from 的长度
            result = result + to
            i = i + m
        } else {
            // 未匹配：追加单个字符，前进一位
            result = result + str_char(s, i)
            i = i + 1
        }
    }
    return result
}

// 按分隔符 sep 把 s 切分为字符串动态表（表元素为各段子串）：
// - sep 为空串时不切分，返回单元素表 [s]（避免死循环）；
// - 连续出现的分隔符产生空字符串元素（"a,,b" 按 "," 切 → ["a","","b"]）；
// - 分隔符开头/结尾时首尾产生空字符串元素（",a," → ["","a",""]）；
// - s 为空串时返回 [" " 的一个空元素]（与主流语言 split 语义一致）。
// 算法：从左到右扫描，命中 sep 即切出一段 [start, i)，跳过 sep 后继续；
// 扫描结束后把最后一段 [start, n) 推入（可能为空串）。
pub func split(s: string, sep: string) -> table {
    // 性能重写（O(n) 字节级）：旧实现匹配循环每字符 str_char(s, i+j) 从头
    // 跳（O(i)）+ 每段 slice 码点定位（O(start)），双重平方——30 万字节文件
    // split 实测 ~20 秒（编译器 import 展开的 sem 瓶颈根源）。
    // 新实现：sep 预转字节表（O(m)），字节扫描匹配（UTF-8 自同步性保证
    // 字节序列匹配 ≡ 码点序列匹配），段用 StringBuilder 累积（reset 复用）。
    var t = table_new_string()
    var blen: i64 = len(s)
    var sb = string_builder()
    // sep 字节表
    var seplen: i64 = len(sep)
    if seplen == 0 {
        table_push(t, s)
        return t
    }
    var sepb = table_new_i64()
    var q: i64 = 0
    while q < seplen {
        table_push(sepb, str_byte(sep, q))
        q = q + 1
    }
    var i: i64 = 0
    while i < blen {
        // 检查从 i 开始是否完整匹配 sep（字节级）
        var matched: bool = true
        var j: i64 = 0
        while j < seplen {
            if i + j >= blen {
                matched = false
                break
            }
            if str_byte(s, i + j) != sepb[j] {
                matched = false
                break
            }
            j = j + 1
        }
        if matched {
            // 段结束：build 快照 + reset 复用缓冲
            table_push(t, sb_build(sb))
            sb_reset(sb)
            i = i + seplen
        } else {
            sb_append_byte(sb, str_byte(s, i))
            i = i + 1
        }
    }
    // 收尾：最后一段（含尾部无 sep 的残余；空段语义与旧版一致）
    table_push(t, sb_build(sb))
    return t
}

// 将 s 中 ASCII 小写字母（a-z）转为大写；其余字符原样保留。
// 算法：用小写表定位字符下标，从大写表取对应字符（无字符算术原语，查表实现）。
pub func to_upper(s: string) -> string {
    var lower = "abcdefghijklmnopqrstuvwxyz"
    var upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    var out: string = ""
    var n: i64 = str_len(s)
    var i: i64 = 0
    while i < n {
        var c = str_char(s, i)
        var idx = find(lower, c)
        if idx >= 0 {
            out = out + str_char(upper, idx)
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

// 将 s 中 ASCII 大写字母（A-Z）转为小写；其余字符原样保留（查表实现）。
pub func to_lower(s: string) -> string {
    var lower = "abcdefghijklmnopqrstuvwxyz"
    var upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    var out: string = ""
    var n: i64 = str_len(s)
    var i: i64 = 0
    while i < n {
        var c = str_char(s, i)
        var idx = find(upper, c)
        if idx >= 0 {
            out = out + str_char(lower, idx)
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

// 把字符串表 items 的元素用 sep 连接成一个字符串；空表返回空串。
// 约定：items 是字符串动态表（table<string>），与 split 的输出互逆。
pub func join(items: table, sep: string) -> string {
    // 性能重写（O(total)）：旧 out + items[i] 逐段全量拷贝是 O(n²)——
    // 万行文本 join 实测秒级。StringBuilder 原地追加替代。
    var n: i64 = len(items)
    if n == 0 {
        return ""
    }
    var sb = string_builder()
    var i: i64 = 0
    while i < n {
        if i > 0 {
            sb_append(sb, sep)
        }
        sb_append(sb, items[i])
        i = i + 1
    }
    return sb_build(sb)
}

// 把 s 重复 n 次拼接；n <= 0 返回空串（n 为负视为不重复）。
pub func repeat(s: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + s
        i = i + 1
    }
    return out
}

// 深拷贝字符串（S1.5 移动语义配套）：返回 s 的独立副本。
// 实现复用字符串拼接 s + ""（irgen 生成 str_cat 指令 = malloc+memcpy 新缓冲），
// 保证 clone 结果与源完全独立，后续修改互不影响（无需引用计数）。
// 语义：clone/copy 调用处实参**借用**（smove 特判不移动源），
// 与移动语义的"复制需显式 clone"配套（docs/plans/ui-framework.md §4.2 + roadmap §S1.5）。
// 注：此为标准库过渡实现（纯 tie，零共享文件改动）；后续可升格为语言内置
// （sbuiltin 注册 + irgen 直接生成），行为等价。
pub func clone(s: string) -> string {
    return s + ""
}

// copy = clone 的语义别名（显式复制，不移动源；语义与 clone 完全一致）。
pub func copy(s: string) -> string {
    return clone(s)
}
}