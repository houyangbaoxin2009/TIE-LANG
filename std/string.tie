// tie:library
// string.tie：标准库——字符串工具函数（命名空间 str，string 是类型关键字不可用）
// 全部基于 str_char + len + 字符串拼接 + 循环/分支实现，不使用下标索引与字符转换
// 调用：import 后 str.str_trim(...) / str.str_split(...)；命名空间内互调为裸调用

namespace str {
// 判断单字符字符串是否为空白字符（空格、制表符、换行、回车）
func is_whitespace(c: string) -> bool {
    if c == " " {
        return true
    }
    if c == "\t" {
        return true
    }
    if c == "\n" {
        return true
    }
    if c == "\r" {
        return true
    }
    return false
}

// 去除字符串首尾空白字符；全空白字符串返回空串
func str_trim(s: string) -> string {
    var n: i64 = len(s)
    // 从头部跳过空白，定位第一个非空白字符
    var start: i64 = 0
    while start < n && is_whitespace(str_char(s, start)) {
        start = start + 1
    }
    // 从尾部跳过空白，定位最后一个非空白字符之后的位置
    var end: i64 = n
    while end > start && is_whitespace(str_char(s, end - 1)) {
        end = end - 1
    }
    // 截取 [start, end) 区间
    return str_slice(s, start, end)
}

// 截取字符串 [start, end) 区间的子串；越界自动收敛到边界；空串或 start>=end 返回空串
func str_slice(s: string, start: i64, end: i64) -> string {
    var n: i64 = len(s)
    // 空串直接返回空串
    if n == 0 {
        return ""
    }
    // 收敛 start 到 [0, n]
    var lo: i64 = start
    if lo < 0 {
        lo = 0
    }
    if lo > n {
        lo = n
    }
    // 收敛 end 到 [0, n]
    var hi: i64 = end
    if hi < 0 {
        hi = 0
    }
    if hi > n {
        hi = n
    }
    // start >= end 返回空串
    if lo >= hi {
        return ""
    }
    // 逐字符拼接子串
    var result: string = ""
    var i: i64 = lo
    while i < hi {
        result = result + str_char(s, i)
        i = i + 1
    }
    return result
}

// 判断 s 是否包含子串 sub；空子串视为包含
func str_contains(s: string, sub: string) -> bool {
    var n: i64 = len(s)
    var m: i64 = len(sub)
    // 空子串总是包含
    if m == 0 {
        return true
    }
    // 子串比主串长，不可能包含
    if m > n {
        return false
    }
    // 从每个起点位置尝试完整匹配
    var i: i64 = 0
    while i <= n - m {
        var j: i64 = 0
        var matched: bool = true
        while j < m && matched {
            if str_char(s, i + j) != str_char(sub, j) {
                matched = false
            }
            j = j + 1
        }
        if matched {
            return true
        }
        i = i + 1
    }
    return false
}

// 返回子串 sub 在 s 中首次出现的位置（字符索引，从 0 起）；未找到返回 -1。
// 空子串视为在位置 0 命中；子串比主串长必然未找到。
// 与 str_contains 同扫描模式：从每个起点完整匹配，命中即返回该起点。
func str_find(s: string, sub: string) -> i64 {
    var n: i64 = len(s)
    var m: i64 = len(sub)
    // 空子串：位置 0 命中
    if m == 0 {
        return 0
    }
    // 子串比主串长，不可能匹配
    if m > n {
        return -1
    }
    var i: i64 = 0
    while i <= n - m {
        var j: i64 = 0
        var matched: bool = true
        while j < m && matched {
            if str_char(s, i + j) != str_char(sub, j) {
                matched = false
            }
            j = j + 1
        }
        if matched {
            return i
        }
        i = i + 1
    }
    return -1
}

// 判断 s 是否以 prefix 开头；空前缀视为真
func str_starts_with(s: string, prefix: string) -> bool {
    var n: i64 = len(s)
    var m: i64 = len(prefix)
    // 前缀比主串长，不可能匹配
    if m > n {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_char(s, i) != str_char(prefix, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 判断 s 是否以 suffix 结尾；空后缀视为真
func str_ends_with(s: string, suffix: string) -> bool {
    var n: i64 = len(s)
    var m: i64 = len(suffix)
    // 后缀比主串长，不可能匹配
    if m > n {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_char(s, n - m + i) != str_char(suffix, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 将 s 中所有出现的 from 替换为 to；from 为空串时原样返回（避免死循环）
func str_replace(s: string, from: string, to: string) -> string {
    var n: i64 = len(s)
    var m: i64 = len(from)
    // from 为空串：不替换，直接返回原串
    if m == 0 {
        return s
    }
    var result: string = ""
    var i: i64 = 0
    while i < n {
        // 检查从 i 开始是否完整匹配 from
        var matched: bool = true
        var j: i64 = 0
        while j < m && matched {
            if i + j >= n {
                matched = false
            } else if str_char(s, i + j) != str_char(from, j) {
                matched = false
            }
            j = j + 1
        }
        if matched {
            // 匹配成功：追加 to，跳过 from 的长度
            result = result + to
            i = i + m
        } else {
            // 未匹配：追加单个字符，前进一位
            result = result + str_char(s, i)
            i = i + 1
        }
    }
    return result
}

// 按分隔符 sep 把 s 切分为字符串动态表（表元素为各段子串）：
// - sep 为空串时不切分，返回单元素表 [s]（避免死循环）；
// - 连续出现的分隔符产生空字符串元素（"a,,b" 按 "," 切 → ["a","","b"]）；
// - 分隔符开头/结尾时首尾产生空字符串元素（",a," → ["","a",""]）；
// - s 为空串时返回 [" " 的一个空元素]（与主流语言 split 语义一致）。
// 算法：从左到右扫描，命中 sep 即切出一段 [start, i)，跳过 sep 后继续；
// 扫描结束后把最后一段 [start, n) 推入（可能为空串）。
func str_split(s: string, sep: string) -> table {
    var t = table_new_string()
    var m: i64 = len(sep)
    // 空分隔符：不切分，整串作为唯一元素
    if m == 0 {
        table_push(t, s)
        return t
    }
    var n: i64 = len(s)
    var start: i64 = 0
    var i: i64 = 0
    while i < n {
        // 检查从 i 开始是否完整匹配 sep
        var matched: bool = true
        var j: i64 = 0
        while j < m && matched {
            if i + j >= n {
                matched = false
            } else if str_char(s, i + j) != str_char(sep, j) {
                matched = false
            }
            j = j + 1
        }
        if matched {
            // 切出一段 [start, i)，跳过 sep 继续
            table_push(t, str_slice(s, start, i))
            i = i + m
            start = i
        } else {
            // 未命中：前进一位
            i = i + 1
        }
    }
    // 收尾：最后一段 [start, n)（sep 结尾时 start==n → 空元素）
    table_push(t, str_slice(s, start, n))
    return t
}
}