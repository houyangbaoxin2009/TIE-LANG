// tie:library
// format.tie：标准库——格式化函数（命名空间 format）
// 全部基于 to_string + str_char + len + 字符串拼接 + 循环/分支实现，不使用下标索引
// 与字符转换；负数十六进制用「负号前缀 + 绝对值」表示（与常见语言一致）。
// 调用：import 后 format.format_int(...) / format.format_pad(...)

namespace format {
// 整数 → 十进制字符串（委托 to_string，与 Rust {} 默认格式一致）
pub func format_int(v: i64) -> string {
    return to_string(v)
}

// 整数右对齐格式化：不足 width 位时左侧补空格；宽度不足或相等时原样返回（不截断）
pub func format_pad(v: i64, width: i64) -> string {
    var s: string = to_string(v)
    var n: i64 = len(s)
    // 逐字符在左侧补空格，直到长度达到 width
    while n < width {
        s = " " + s
        n = n + 1
    }
    return s
}

// 整数转小写十六进制（不带 0x 前缀）；负数输出「-」+ 绝对值十六进制
// 算法：反复取 n % 16 得最低位数字，用 str_char 从常量串取对应字符，再 n / 16 右移
pub func format_int_hex(v: i64) -> string {
    // 零直接返回 "0"（不进循环，避免空串）
    if v == 0 {
        return "0"
    }
    var neg: bool = false
    var n: i64 = v
    // 负数：记录负号，取绝对值（i64::MIN 的取反在补码下回绕为自身，输出
    // "-8000000000000000"，数学上恰等于 MIN，行为正确）
    if n < 0 {
        neg = true
        n = -n
    }
    var digits: string = "0123456789abcdef"
    var result: string = ""
    while n > 0 {
        result = str_char(digits, n % 16) + result
        n = n / 16
    }
    if neg {
        return "-" + result
    }
    return result
}

// 布尔格式化：true / false
pub func format(b: bool) -> string {
    if b {
        return "true"
    }
    return "false"
}
}