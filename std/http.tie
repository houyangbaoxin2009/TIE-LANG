type tie<class>
// http.tie：标准库——HTTP 客户端与 URL 编码工具（命名空间 http），纯函数 + 底座
// 原语 http_get / http_get_file 的直接包装，不引入任何网络依赖。
// 调用：import 后 http.get(url) / http.url_encode(s)；命名空间内互调为裸调用。
// 命名规范：命名空间内函数不加 http_ 前缀（统一 func 写法，Harbor M2.1.6）。
// 局限：
//   1. 底座原语仅支持 http://（https/TLS 留待后续），且失败时由编译器输出
//      "运行时错误"并退出进程（exit 1）——tie 语言暂无可捕获的异常机制，std 层
//      无法把失败转为返回值，"失败返回空串"仅作文档约定，实际调用前请自行确保
//      URL 可访问；
//   2. url_encode / url_decode 基于码点级字符串操作，只处理 ASCII 范围字符，
//      非 ASCII 码点（中文等）url_encode 返回空串，url_decode 无法构造任意字节
//      字符（tie 无「码点 → 字符」原语，只能查可打印 ASCII 表）；
//   3. **已知后端 bug（Rust tie-llvm）**：循环内 str_char 返回值跨函数调用会被
//      破坏——运行期字符串被错误烘焙为 @.str.N 常量（见 2026-08-12 复现：常量
//      `c"a%140b\00"` 声明 [6 x i8] 实际 7 字节，opt 拒绝）。url_encode/url_decode
//      的查表辅助（hex2/to_printable）因此不可靠，**测试暂缓，待自举后端
//      （compiler/backend/llvmgen.tie，显式字符串池 id 无此问题）落地后补测**。

namespace http {
// HTTP GET 指定 URL，返回响应正文；失败返回空串（文档约定，实际由编译器报错退出）。
// 注意：连接失败 / 非 200 / 仅 http:// ——见文件头局限说明。
pub func get(url: string) -> string {
    return http_get(url)
}

// HTTP GET 下载到本地文件；成功返回 true，失败返回 false（不触发运行时错误，
// 失败只返回 false，可安全用于二进制包下载判断）。
pub func get_file(url: string, path: string) -> bool {
    return http_get_file(url, path)
}

// 两位大写十六进制字符串（无 % 前缀），url_encode 的内部辅助函数。
// **不用 str_char 查表**：Rust tie-llvm 后端存在字符串缓冲 bug（循环内 str_char
// 返回值被后续字符串拼接覆盖，详见 _repro_diag7 复现），查表方案在循环内不稳定；
// 改用 to_string（数字）与字面量分支（字母），无字符串表、无 str_char，彻底规避。
func hex2(v: i64) -> string {
    if v < 10 {
        return to_string(v)
    }
    if v == 10 {
        return "A"
    }
    if v == 11 {
        return "B"
    }
    if v == 12 {
        return "C"
    }
    if v == 13 {
        return "D"
    }
    if v == 14 {
        return "E"
    }
    return "F"
}

// 单字符十六进制数字 → 数值 0..15；非十六进制字符返回 -1（url_decode 校验用）。
func hex_val(c: string) -> i64 {
    var cp: i64 = char_code(c)
    // '0'-'9' → 0..9
    if cp >= 48 && cp <= 57 {
        return cp - 48
    }
    // 'A'-'F' → 10..15
    if cp >= 65 && cp <= 70 {
        return cp - 65 + 10
    }
    // 'a'-'f' → 10..15
    if cp >= 97 && cp <= 102 {
        return cp - 97 + 10
    }
    return -1
}

// 字节值（0..255）→ 可打印 ASCII 单字符；非可打印（<32 或 >126）返回空串。
// 查表方案：常量字符串含 32..126 全部 95 个可打印字符，str_char(表, v-32) 定位
// （tie 无任意码点→字符原语，非可打印字节无法构造，返回空串）。
func to_printable(v: i64) -> string {
    var printable = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    if v >= 32 && v <= 126 {
        return str_char(printable, v - 32)
    }
    return ""
}

// percent 编码：字母数字 -_.~ 原样保留（RFC 3986 unreserved）；空格 → %20；
// 其余 ASCII（0..127）→ %XX（大写十六进制）；非 ASCII 码点返回空串（局限）。
// 与 std/encoding 同规则：仅 ASCII 支持，超集字符（UTF-8 多字节）拒绝。
pub func url_encode(s: string) -> string {
    var out: string = ""
    var n: i64 = str_len(s)
    var i: i64 = 0
    while i < n {
        var c = str_char(s, i)
        var cp: i64 = char_code(c)
        // 字母数字（0-9 A-Z a-z）原样
        if (cp >= 48 && cp <= 57) || (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) {
            out = out + c
        } else if c == "-" || c == "_" || c == "." || c == "~" {
            // RFC 3986 unreserved 保留字符原样
            out = out + c
        } else if c == " " {
            // 空格 → %20
            out = out + "%20"
        } else if cp >= 0 && cp <= 127 {
            // 其余 ASCII 控制/符号 → %XX 大写
            out = out + "%" + hex2(cp)
        } else {
            // 非 ASCII 码点：无法表示，返回空串（局限）
            return ""
        }
        i = i + 1
    }
    return out
}

// percent 解码（url_encode 的逆）：%XX → 字节（按可打印 ASCII 查表还原）、
// + → 空格；其它字符原样。非法编码（% 后不足两位十六进制）返回空串。
// 局限：%XX 还原的字节若不可打印（<32 或 >126），tie 无码点→字符原语，
// 该字节被跳过（to_printable 返回空串）。
pub func url_decode(s: string) -> string {
    var out: string = ""
    var n: i64 = str_len(s)
    var i: i64 = 0
    while i < n {
        var c = str_char(s, i)
        if c == "+" {
            // 表单编码：+ → 空格
            out = out + " "
            i = i + 1
        } else if c == "%" {
            // % 后必须恰好两个十六进制数字，否则非法返回空串
            if i + 2 >= n {
                return ""
            }
            var hi: i64 = hex_val(str_char(s, i + 1))
            var lo: i64 = hex_val(str_char(s, i + 2))
            if hi < 0 || lo < 0 {
                return ""
            }
            var v: i64 = hi * 16 + lo
            out = out + to_printable(v)
            i = i + 3
        } else {
            out = out + c
            i = i + 1
        }
    }
    return out
}
}
