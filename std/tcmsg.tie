// tie:library
// tcmsg.tie：标准库——控制台信息库（消息系统，i18n，命名空间形式）
//
// 基于语言底座原语 msg_set_lang / msg_register / msg_t：
// - msg_set_lang(lang)：切换当前语言（如 "zh" / "en"）
// - msg_register(key, lang, text)：登记 (键, 语言) → 文本（同键同语言覆盖）
// - msg_t(key)：查询键的翻译，回退顺序 当前语言 → zh → 键本身
// 当前语言 + 消息字典存 Rust thread_local（见 tie-interp C ABI 桥）。
//
// 综合方案（默认值参数，M2.1）：
// - 文本随调用传入（方案 A）：err(langs, texts) —— texts 按 langs 顺序给文本，就近自包含
// - 字典集中登记（方案 B）：err(langs) —— 省略 texts，从 msg_t 字典查，单一事实来源
// 两形态共用同一函数：texts 有默认值空表 []，函数体内用 len(texts) > 0 区分。

// 依赖 string.tie（str.starts_with 语言前缀匹配）：
// 注意——当前 import 展开不做去重，调用方只需导入 tcmsg.tie（string.tie 会随同展开）。
import "./string.tie"

namespace tcmsg {
    // 打印错误级消息：前缀「错误: 」+ 当前语言翻译（未登记时回退键本身）
    func error(key: string) {
        println("错误: " + msg_t(key))
    }

    // 打印警告级消息：前缀「警告: 」+ 当前语言翻译（未登记时回退键本身）
    func warn(key: string) {
        println("警告: " + msg_t(key))
    }

    // 打印信息级消息：前缀「信息: 」+ 当前语言翻译（未登记时回退键本身）
    func info(key: string) {
        println("信息: " + msg_t(key))
    }

    // 切换消息系统当前语言（透传内置 msg_set_lang）
    func set_lang(lang: string) {
        msg_set_lang(lang)
    }

    // 登记一条消息文本（透传内置 msg_register）
    func register(key: string, lang: string, content: string) {
        msg_register(key, lang, content)
    }

    // 查询键的翻译（透传内置 msg_t，回退规则一致）
    func t(key: string) -> string {
        return msg_t(key)
    }

    // 错误子命名空间：按错误键分组，提供多语言 API
    namespace error {
        // 综合方案示例：no_file 错误。
        // 调用形态 1（方案 B）：tcmsg::error.no_file(["zh-cn","en-us"])
        //   → 省略 texts，从字典查当前语言的 no_file 文本（需先 register 登记）
        // 调用形态 2（方案 A）：tcmsg::error.no_file(["zh-cn","en-us"], ["文件不存在","File not found"])
        //   → texts 按 langs 顺序给文本，直接返回当前语言对应文本，调用点自包含
        func no_file(langs: table, texts: table = []) -> string {
            // 方案 A：调用方提供了文本表（非空）→ 按当前语言匹配 langs 取文本
            if len(texts) > 0 {
                // langs 与 texts 按位置对应；langs[i] 是地区码（如 "zh-cn"），
                // 当前语言是基础码（如 "zh"）→ 用前缀匹配（"zh-cn" 以 "zh" 开头）
                var i: i64 = 0
                while i < len(langs) {
                    if str.starts_with(langs[i], msg_get_lang()) {
                        return texts[i]
                    }
                    i = i + 1
                }
                // 未命中任何语言 → 回退第一个文本
                return texts[0]
            }
            // 方案 B：字典集中登记（键 "error.no_file"），msg_t 回退规则兜底
            return msg_t("error.no_file")
        }
    }
}
