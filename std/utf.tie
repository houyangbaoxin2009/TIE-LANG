type tie<class>
// utf.tie：标准库——UTF-8/Unicode 码点工具（命名空间 utf），全部纯函数，
// 只依赖底座原语（char_code / str_char / str_len）+ 位运算 + 字符串拼接 + 循环/分支。
// 码点级 vs 字节级：tie 字符串内部是 UTF-8 编码，中文一个汉字 3 字节。str_len / str_char
// 按**码点**（字符）工作；byte_len / utf8_bytes / hex_escape 按 **UTF-8 字节**工作——
// 两者必须分清，混用会错位（"四"的 str_len 为 1 而字节数为 3）。本模块输出字节级
// 信息，供 LLVM 字符串转义、字节计数等场景使用。
// 对齐参考：Rust crates/tie-llvm/src/ir.rs 的 escape_ir_string(4879-4897)——hex_escape
// 采用同款「非可打印字节 → \XX 大写十六进制」格式，可直接用于 LLVM c"..." 字符串常量。
// 替代的散落实现（本模块集中收纳，不改动它们）：examples/byte_demo.tie 的 ascii(c)
// （字符→ASCII 码查表）；compiler/frontend/lex_tokdefs.tie 的 is_alpha(c: i64)；
// archive/compiler-v1/lexer.tie 的字符分类；ext/codec/zstd|lz4|brotli.tie 的
// 32..126 可打印 ASCII 查表 char↔code。
// 调用：import 后 utf.codepoint(...) / utf.byte_len(...)；命名空间内互调为裸调用。
// 命名规范：命名空间内函数不加 utf_ 前缀（统一 func 写法，Harbor M2.1.6）。
// 码点 → 字符：底座原语 str_from_code（任意合法 Unicode 码点，含中文/emoji；
// 非法码点返回空串），本模块 from_code 为其封装，与 codepoint（字符 → 码点）对称；
// utf.to_char 仍保留 ASCII 查表方案（码点 → 可打印 ASCII 单字符，历史约定）。

namespace utf {
// 单字符字符串 → Unicode 码点（UTF-32）。空串 / 非单字符返回 -1。
// 注意：底座原语 char_code 取「首字符」且空串返回 -1，此处额外校验必须恰好一个码点
// （多字符字符串不返回首字符码点，而是整体拒绝，保证"单字符"契约）。
pub func codepoint(ch: string) -> i64 {
    if str_len(ch) != 1 {
        return -1
    }
    return char_code(ch)
}

// 码点 → 单字符字符串（UTF-8 编码）。与 codepoint 对称（码点 ↔ 字符 双向转换）。
// 底层原语 str_from_code 使用 Rust char::from_u32 校验：非法码点（负值、超过
// 0x10FFFF、代理区 D800-DFFF）返回空串。此前 tie 无「码点 → 任意字符」路径
// （utf.to_char 仅可打印 ASCII 查表），本函数补齐完整 Unicode——tie:zd 二进制
// 序列化解码中文的必要前提。
pub func from_code(n: i64) -> string {
    return str_from_code(n)
}

// 字符串 → 单字符码点表（table<string>）：逐码点取出，可作随机码点索引
// （cs[i] O(1)）——与逐码点线性遍历的 s.chars() 互补。码点数 = len(result)
// = codepoint_count(s)。空串返回空表。
// 码点索引与字节索引分离：本函数按**码点**（字符）切分，不依赖 UTF-8 字节数。
pub func to_chars(s: string) -> table {
    var t = table_new_string()
    var n: i64 = str_len(s)
    var i: i64 = 0
    while i < n {
        table_push(t, str_char(s, i))
        i = i + 1
    }
    return t
}

// 字符串码点（字符）总数 ≈ str_len 的显式包装（码点索引边界用）。
// 与 byte_len 对称：byte_len 是 UTF-8 字节数（中文一字 3 字节），
// codepoint_count 是字符数（中文一字 1）。码点索引与字节索引分离的正确依据。
pub func codepoint_count(s: string) -> i64 {
    return str_len(s)
}

// 码点 → UTF-8 字节数：≤0x7F 1 字节；≤0x7FF 2 字节；≤0xFFFF 3 字节；≤0x10FFFF 4 字节；
// 越界（负值或超过 Unicode 上限 0x10FFFF）返回 0。
pub func utf8_bytes(cp: i64) -> i64 {
    // 负值不是合法码点，返回 0（不能落入 ≤0x7F 分支）
    if cp < 0 {
        return 0
    }
    if cp <= 0x7F {
        return 1
    }
    if cp <= 0x7FF {
        return 2
    }
    if cp <= 0xFFFF {
        return 3
    }
    if cp <= 0x10FFFF {
        return 4
    }
    // 超过 Unicode 上限：非法码点，返回 0
    return 0
}

// 字符串 UTF-8 字节数：逐码点取码值并累计 utf8_bytes；空串返回 0。
// 与 str_len 的区别：str_len 是码点数（字符数），byte_len 是字节数——
// "四段式"的 str_len 为 3、byte_len 为 9（每字 3 字节）。
pub func byte_len(s: string) -> i64 {
    var n: i64 = str_len(s)
    var total: i64 = 0
    var i: i64 = 0
    while i < n {
        // str_char 越界返回空串，但 i < n 保证不越界；char_code 取该单字符码点
        var cp: i64 = char_code(str_char(s, i))
        total = total + utf8_bytes(cp)
        i = i + 1
    }
    return total
}

// 0..255 → 两位大写十六进制字符串（无 \ 前缀），hex_escape 的内部辅助函数。
// 查表实现：十六进制数字表 "0123456789ABCDEF" 按下标取字符（tie 无数字→字符原语）。
func hex2(v: i64) -> string {
    var hex = "0123456789ABCDEF"
    var hi: i64 = v >> 4
    var lo: i64 = v & 0xF
    return str_char(hex, hi) + str_char(hex, lo)
}

// 码点 → LLVM c"..." 风格字节转义序列：UTF-8 编码的**每个字节**输出大写 \XX。
// 示例：0x56DB（"四"）→ "\E5\9B\9B"；0x41（"A"）→ "\41"。
// 对齐 crates/tie-llvm/src/ir.rs escape_ir_string：非可打印字节输出 \XX 大写十六进制。
// UTF-8 位运算（逐字节取码点高位 + 0x80 延续位）：
//   2 字节 = 0xC0|(cp>>6), 0x80|(cp&0x3F)
//   3 字节 = 0xE0|(cp>>12), 0x80|((cp>>6)&0x3F), 0x80|(cp&0x3F)
//   4 字节 = 0xF0|(cp>>18), 0x80|((cp>>12)&0x3F), 0x80|((cp>>6)&0x3F), 0x80|(cp&0x3F)
// 越界码点（utf8_bytes 返回 0）返回空串。
pub func hex_escape(cp: i64) -> string {
    var n: i64 = utf8_bytes(cp)
    // 越界码点：无 UTF-8 编码，返回空串
    if n == 0 {
        return ""
    }
    // 1 字节：ASCII 直接 \XX
    if n == 1 {
        return "\\" + hex2(cp)
    }
    // 2 字节：0xC0|(cp>>6), 0x80|(cp&0x3F)
    if n == 2 {
        var b0: i64 = 0xC0 | (cp >> 6)
        var b1: i64 = 0x80 | (cp & 0x3F)
        return "\\" + hex2(b0) + "\\" + hex2(b1)
    }
    // 3 字节：0xE0|(cp>>12), 0x80|((cp>>6)&0x3F), 0x80|(cp&0x3F)
    if n == 3 {
        var b0: i64 = 0xE0 | (cp >> 12)
        var b1: i64 = 0x80 | ((cp >> 6) & 0x3F)
        var b2: i64 = 0x80 | (cp & 0x3F)
        return "\\" + hex2(b0) + "\\" + hex2(b1) + "\\" + hex2(b2)
    }
    // 4 字节：0xF0|(cp>>18), 0x80|((cp>>12)&0x3F), 0x80|((cp>>6)&0x3F), 0x80|(cp&0x3F)
    var b0: i64 = 0xF0 | (cp >> 18)
    var b1: i64 = 0x80 | ((cp >> 12) & 0x3F)
    var b2: i64 = 0x80 | ((cp >> 6) & 0x3F)
    var b3: i64 = 0x80 | (cp & 0x3F)
    return "\\" + hex2(b0) + "\\" + hex2(b1) + "\\" + hex2(b2) + "\\" + hex2(b3)
}

// 码点是否为 ASCII（0..127）。负值不是 ASCII。
pub func is_ascii(cp: i64) -> bool {
    return cp >= 0 && cp <= 127
}

// 码点是否为 ASCII 字母（65..90 'A'-'Z'，97..122 'a'-'z'）。
pub func is_letter(cp: i64) -> bool {
    return (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122)
}

// 可打印 ASCII 码点（32..126）→ 单字符；越界返回空串。
// 查表方案：常量字符串含 32..126 全部 95 个可打印字符，str_char(表, cp-32) 定位。
// 局限：非 ASCII 码点（如 0x4E2D "中"）无法还原为字符，返回空串——完整 Unicode
// 码点 → 字符用底座原语 str_from_code（本模块 from_code 封装）。
// 命名说明：函数名本应为 char，但 char 是 tie 类型关键字（TyKw::Char）保留字，
// 不能用作函数名，故以 to_char 命名（码点→字符的转换语义）。
pub func to_char(cp: i64) -> string {
    // 32..126 全部 95 个可打印 ASCII 字符表（变量名 chars，table 是类型关键字保留字）
    var chars = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    if cp < 32 || cp > 126 {
        return ""
    }
    return str_char(chars, cp - 32)
}
}
