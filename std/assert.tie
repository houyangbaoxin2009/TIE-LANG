type tie<class>
// assert.tie：标准库——基础断言函数（命名空间 assert），失败时打印错误信息并退出进程
// 调用：import 后 assert.assert(...) / assert.assert_eq(...) / assert.assert_neq(...)

namespace assert {
// 断言条件为真；条件为假时打印错误并退出（退出码 1）
pub func assert(cond: bool) {
    if !cond {
        println("assert 失败：条件为假")
        exit(1)
    }
}

// 断言两个整数相等；不相等时打印两个值并退出（退出码 1）
pub func assert_eq(a: i64, b: i64) {
    if a != b {
        println("assert_eq 失败：" + to_string(a) + " != " + to_string(b))
        exit(1)
    }
}

// 断言两个整数不相等；相等时打印两个值并退出（退出码 1）
pub func assert_neq(a: i64, b: i64) {
    if a == b {
        println("assert_neq 失败：" + to_string(a) + " == " + to_string(b))
        exit(1)
    }
}

// 断言两个浮点相等；不相等时打印两个值并退出（退出码 1）
pub func assert_eq_f64(a: f64, b: f64) {
    if a != b {
        println("assert_eq_f64 失败：" + to_string(a) + " != " + to_string(b))
        exit(1)
    }
}

// 断言两个字符串相等；不相等时打印两个值并退出（退出码 1）
pub func assert_eq_str(a: string, b: string) {
    if a != b {
        println("assert_eq_str 失败：" + a + " != " + b)
        exit(1)
    }
}
}