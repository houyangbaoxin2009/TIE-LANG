type tie<logic>
// compiler/proto/semantic_test.tie —— 自举 v2 T1.3 语义单遍验收程序
// ============================================================
// 职责：对 corpus（scripts/bench/corpus.txt）中 pass 文件逐个做语义检查，
//       统计 OK/ERR/excluded（import 依赖文件原型不展开，归入 excluded）；
//       内嵌负例断言错误消息含核心关键词。
//
// 运行：tie-llvm 编译后从仓库根执行（相对路径读 corpus 与源码）。
// 只 import "./semantic.tie"（其链式 import parser -> lexer -> intern/string）。

import "./semantic.tie"

// 判断字符串是否以 "ERR:" 开头（parse_src/check 统一错误协议）
func has_err(s: string) -> bool {
    var n = str_len(s)
    if n < 4 {
        return false
    }
    if str_char(s, 0) == "E" {
        if str_char(s, 1) == "R" {
            if str_char(s, 2) == "R" {
                if str_char(s, 3) == ":" {
                    return true
                }
            }
        }
    }
    return false
}

// 判断源码是否含 import 语句（排除 import 依赖文件）
func has_import(src: string) -> bool {
    var n = str_len(src)
    var i: i64 = 0
    while i + 6 <= n {
        if str_char(src, i) == "i" {
            if str_char(src, i + 1) == "m" {
                if str_char(src, i + 2) == "p" {
                    if str_char(src, i + 3) == "o" {
                        if str_char(src, i + 4) == "r" {
                            if str_char(src, i + 5) == "t" {
                                return true
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return false
}

// 逐文件语义检查：返回 1=OK 0=ERR -1=excluded
func check_file(path: string) -> i64 {
    var src = file_read(path)
    if has_import(src) {
        return -1
    }
    var ast = parser.parse_src(src)
    if has_err(ast) {
        println("  解析失败  " + path + " :: " + ast)
        return 0
    }
    var r = semantic.check(ast)
    if has_err(r) {
        println("  语义失败  " + path + " :: " + r)
        return 0
    }
    return 1
}

// 负例断言：check 失败且消息含关键词
func expect_err(src: string, keyword: string, label: string) -> i64 {
    var ast = parser.parse_src(src)
    if has_err(ast) {
        println("  负例错误（解析失败）  " + label + " :: " + ast)
        return 0
    }
    var r = semantic.check(ast)
    if !has_err(r) {
        println("  负例未报错  " + label)
        return 0
    }
    if !contains_msg(r, keyword) {
        println("  负例消息缺关键词  " + label + " :: " + r + " （期望含 " + keyword + "）")
        return 0
    }
    return 1
}

// 错误消息是否含关键词（子串匹配）
func contains_msg(msg: string, kw: string) -> bool {
    var n = str_len(msg)
    var m = str_len(kw)
    if m > n {
        return false
    }
    var i: i64 = 0
    while i + m <= n {
        var match: bool = true
        var j: i64 = 0
        while j < m {
            if str_char(msg, i + j) != str_char(kw, j) {
                match = false
                break
            }
            j = j + 1
        }
        if match {
            return true
        }
        i = i + 1
    }
    return false
}

func main() {
    // ============ corpus 全量检查 ============
    var corpus = file_read("scripts/bench/corpus.txt")
    var total_ok: i64 = 0
    var total_err: i64 = 0
    var total_excl: i64 = 0
    // 逐行解析 corpus
    var n = str_len(corpus)
    var pos: i64 = 0
    var line_start: i64 = 0
    while pos <= n {
        var at_end: bool = false
        if pos == n {
            at_end = true
        } else {
            if str_char(corpus, pos) == "\n" {
                at_end = true
            }
        }
        if at_end {
            var line = str.slice(corpus, line_start, pos)
            // 跳过注释/空行
            var line_len = str_len(line)
            var is_comment: bool = false
            if line_len > 0 {
                if str_char(line, 0) == "#" {
                    is_comment = true
                }
            }
            if line_len > 0 && !is_comment {
                // 格式：<path> <pass|fail>
                var space_at: i64 = -1
                var i: i64 = 0
                while i < line_len {
                    if str_char(line, i) == " " {
                        space_at = i
                        break
                    }
                    i = i + 1
                }
                var path = ""
                var role = ""
                if space_at >= 0 {
                    path = str.slice(line, 0, space_at)
                    role = str.slice(line, space_at + 1, line_len)
                }
                if role == "pass" {
                    var r = check_file(path)
                    if r == 1 {
                        total_ok = total_ok + 1
                    } else if r == 0 {
                        total_err = total_err + 1
                    } else {
                        total_excl = total_excl + 1
                    }
                }
            }
            line_start = pos + 1
        }
        pos = pos + 1
    }
    println("semantic 验收通过：" + to_string(total_ok) + "/" + to_string(total_ok + total_err) + "（excluded " + to_string(total_excl) + "，ERR " + to_string(total_err) + "）")

    // ============ 负例断言 ============
    var neg_ok: i64 = 0
    var neg_total: i64 = 0
    var n1 = expect_err("func main() {\n    var x = 1\n    println(y)\n}\n", "未声明的变量", "未声明变量")
    neg_total = neg_total + 1
    neg_ok = neg_ok + n1
    var n2 = expect_err("func main() {\n    var x: i64 = \"hello\"\n}\n", "类型不匹配", "类型不匹配")
    neg_total = neg_total + 1
    neg_ok = neg_ok + n2
    var n3 = expect_err("func main() {\n    const K: i64 = 1\n    K = 2\n}\n", "不能给 const", "const 赋值")
    neg_total = neg_total + 1
    neg_ok = neg_ok + n3
    var n4 = expect_err("func f() {}\nfunc f() {}\nfunc main() {}\n", "重复定义", "函数重复定义")
    neg_total = neg_total + 1
    neg_ok = neg_ok + n4
    var n5 = expect_err("func main() {\n    break\n}\n", "只能出现在循环体内", "循环外 break")
    neg_total = neg_total + 1
    neg_ok = neg_ok + n5
    println("负例断言：" + to_string(neg_ok) + "/" + to_string(neg_total) + " 通过")

    // ============ 类型表验证（check_debug）============
    var hello = file_read("examples/hello.tie")
    var ast2 = parser.parse_src(hello)
    if !has_err(ast2) {
        var dbg = semantic.check_debug(ast2)
        println("类型表/签名摘要：")
        println(dbg)
    }

    if total_err == 0 && neg_ok == neg_total {
        println("semantic 验收全部通过")
        exit(0)
    } else {
        println("semantic 验收存在失败项")
        exit(1)
    }
}
