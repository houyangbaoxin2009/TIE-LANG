type tie<class>
// compiler/middle/types.tie —— 自举 v2 T2.1：类型系统（type id 自编码）
// ============================================================
// 里程碑：自举 v2 计划 T2.1 模块化地基。从阶段 1 原型
// compiler/proto/semantic.tie 提炼（文件头注释的类型编码方案 +
// ty_named/ty_table/ty_map/ty_struct_idx/ty_tuple_idx/ty_kind/
// ty_low/判据族/type_name + S_T_*/S_K_* 常量）。
//
// # 类型编码（type id 自编码，O(1) 构造/比较，高位分离防冲突）
//   Named 类型：id = TyKw 索引（0=i8 1=i16 2=i32 3=i64 4=u8 5=u16
//     6=u32 7=u64 8=f32 9=f64 10=bool 11=trit 12=char 13=string
//     14=void 15=code 16=num 17=text 18=misc 19=table 20=map）
//   table<T> ：id = 1<<40 | T
//   map<V>   ：id = 2<<40 | V
//   struct S ：id = 3<<40 | struct_索引（struct 表行号）
//   tuple    ：id = 4<<40 | tuple_索引（tuple 表行号）
//   TypeVar  ：id = 5<<40 | intern 池 id（泛型类型参数，名字即身份——
//     同名类型参数全局同 id、跨函数稳定，mangling 友好；intern 池 id
//     < 2^40 保证不碰撞。语义层登记泛型形参时调用 var_of 获取）。
//   enum E  ：id = 6<<40 | enum_索引（enum 表行号，最高段）
//   高位分离保证任意嵌套组合不冲突（负载 < 2^40）。
//   解码：kind(id) 判类别（0=Named 1=Table 2=Map 3=Struct 4=Tuple
//   5=TypeVar 6=Enum），low(id) 取负载（元素类型/索引/intern 池 id）。
//   TypeVar 兼容性：table<TypeVar>/map<TypeVar> 走嵌套聚合序号表路径
//   （var_of 结果恒 ≥ NEST_SLOT_OFF，table_of 查/登记 nest_tbl_elems），
//   table_elem 可完整还原回 TypeVar id；判据族（is_int/is_float/
//   is_number/is_bool_like/is_wide/is_table/is_map）对 TypeVar 均 false
//   ——TypeVar 不是任何具体类型，须在单态化时替换为具体类型后再判定。
//
// # 判据族（语义检查/IR 生成共用，从 semantic 提炼）
//   is_int / is_float / is_number / is_bool_like / is_wide
//   （num/text/misc 宽类型框）/ is_table / is_map / table_elem
//   注意：裸关键字 table(19)/map(20) 与参数化 table<T>/map<V>
//   都算 is_table / is_map（与 semantic 行为一致）。
//
// # struct 名登记（type_name 递归还原用）
//   struct 名表（st_names，索引 -> 名字）由本模块维护，语义阶段
//   登记 struct 后调用 set_struct_name(idx, name)，type_name 即可
//   还原完整名字（无该登记时回退 "struct"）。
//   tuple 类型名固定 "tuple"（semantic 同款，无字段名表）。
//
// 调用：import 后 types.named(...) / types.type_name(...)
// 命名规范：命名空间内函数不加 types_ 前缀；内部工具私有（非 pub）。

import "../lib/interner.tie"

// ---------- 类型类别常量（kind(id) 返回值）----------
const K_NAMED: i64 = 0;
const K_TABLE: i64 = 1;
const K_MAP: i64 = 2;
const K_STRUCT: i64 = 3;
const K_TUPLE: i64 = 4;
const K_TYPEVAR: i64 = 5;
const K_ENUM: i64 = 6;
const K_PTR: i64 = 7;        // ptr<T> 类型化指针（S1.2）
const K_SLICE: i64 = 8;      // slice<T> 切片（指针+长度，S1.2）
const K_ATOMIC: i64 = 9;     // atomic<T> 原子类型（S1.2）
const K_FN: i64 = 10;        // fn 函数值类型（S2.2，闭包/函数指针）
const K_PORT: i64 = 11;      // port 对象类型（S2.4：接口对象，LLVM 表示 = ptr 指向堆打包 {data,vtable}）
const K_ACTOR: i64 = 12;     // actor 句柄类型（一期并发：运行期一张 actor 表管所有权，LLVM 表示 = i64 句柄槽）
const K_SHIFT: i64 = 40;           // 高位分离位移量（负载 < 2^40）

// ---------- TyKw 索引常量（0..22，对齐 Rust TyKw 变体顺序）----------
const TK_I8: i64 = 0;
const TK_I16: i64 = 1;
const TK_I32: i64 = 2;
const TK_I64: i64 = 3;
const TK_U8: i64 = 4;
const TK_U16: i64 = 5;
const TK_U32: i64 = 6;
const TK_U64: i64 = 7;
const TK_F32: i64 = 8;
const TK_F64: i64 = 9;
const TK_BOOL: i64 = 10;
const TK_TRIT: i64 = 11;
const TK_CHAR: i64 = 12;
const TK_STR: i64 = 13;
const TK_VOID: i64 = 14;
const TK_CODE: i64 = 15;
const TK_NUM: i64 = 16;
const TK_TEXT: i64 = 17;
const TK_MISC: i64 = 18;
const TK_TABLE: i64 = 19;
const TK_MAP: i64 = 20;
// 批次 2（i128/u128）：128 位整数（2026-08-19，dev33 计划任务 3-6）。
// 注：Named 类型 id = TyKw 索引（0..22），kind(id) 用 id < 100 判 Named，
// 新类型索引 < 100 不破坏编码；tykw_names 按索引对齐（见 ensure_tykw_names）。
const TK_I128: i64 = 21;
const TK_U128: i64 = 22;

// 高位基数常量（= 1<<40 / 2<<40 / 3<<40 / 4<<40 / 5<<40 / 6<<40，
// 写死字面量避免运行期位移）
// 6<<40 = 6597069766656，i64 有符号下远小于 2^63 无溢出。
// S1.2 新增 ptr/slice/atomic 段：7/8/9 << 40。
const BASE_TABLE: i64 = 1099511627776;
const BASE_MAP: i64 = 2199023255552;
const BASE_STRUCT: i64 = 3298534883328;
const BASE_TUPLE: i64 = 4398046511104;
const BASE_TYPEVAR: i64 = 5497558138880;
const BASE_ENUM: i64 = 6597069766656;
const BASE_PTR: i64 = 7696581394432;
const BASE_SLICE: i64 = 8796093022208;
const BASE_ATOMIC: i64 = 9895604649984;
// S2.2 fn 函数值类型段：id = 10<<40 | fn 签名索引（签名表行号）。
// 签名 = 返回类型 + 参数类型列表，查 fn 签名表编码（低负载为索引）。
// 10<<40 = 10995116277760，i64 有符号下远小于 2^63 无溢出。
const BASE_FN: i64 = 10995116277760;
// S2.4 port 对象类型段：id = 11<<40 | port 索引（port 表行号）。
// 11<<40 = 12094627905536，i64 有符号下远小于 2^63 无溢出。
// port 对象语义 = {data: ptr, vtable: ptr}（docs/plans/port-model.md §4.1），
// LLVM 表示 = 单个 ptr（指向堆上打包对象 {data,vtable}）——表/传参/字段
// 天然支持（探针异构 table<Drawable> 依赖此表示，见 S2.4 注释）。
const BASE_PORT: i64 = 12094627905536;
// 一期并发 actor 句柄类型段：id = 12<<40 | actor 索引（actor 表行号）。
// 12<<40 = 13194139533312，i64 有符号下远小于 2^63 无溢出。
const BASE_ACTOR: i64 = 13194139533312;

// ---------- 全局状态（懒构建）----------
var tykw_names: table<string>;   // TyKw 索引 -> 类型名（错误消息用）
var st_names: table<string>;     // struct 名表（索引 -> 名字；type_name 还原用）
var en_names: table<string>;     // enum 名表（索引 -> 名字；type_name 还原用）
// 一期并发 actor 名表（索引 -> 名字；type_name 还原用，由语义层 set_actor_name 登记）
var act_names: table<string>;
// 嵌套聚合登记表（序号 → 元素/值类型 id）：table<table<T>> / map<聚合> 的编码载体。
// 背景：table_of(聚合) 若直接 BASE_TABLE + 聚合，会因聚合 id ≥ 2^40 进位撞入
// map 段（table<table<i64>> = 2^41+3 == map<i64>）——嵌套类型必须查表编码。
var nest_tbl_elems: table<i64>;  // 嵌套表元素段（序号 → 元素类型 id）
var nest_map_vals: table<i64>;   // 嵌套 map 值段（序号 → 值类型 id）
// S1.2 不安全类型嵌套负载段（序号 → 元素类型 id；同 table_of 防进位方案）
var nest_ptr_elems: table<i64>;    // 嵌套 ptr 元素段
var nest_slice_elems: table<i64>;  // 嵌套 slice 元素段
var nest_atomic_elems: table<i64>; // 嵌套 atomic 元素段
// S2.2 fn 函数值类型签名表（段式，索引即 fn 类型低负载）：
// fn_ret    签名索引 -> 返回类型 id
// fn_nparams 签名索引 -> 参数个数
// fn_params 参数类型扁平段（前缀和由 fn_paroff 记录偏移）
var fn_ret: table<i64>;      // fn 签名索引 -> 返回类型 id
var fn_nparams: table<i64>;  // fn 签名索引 -> 参数个数
var fn_paroff: table<i64>;   // fn 签名索引 -> fn_params 段起始偏移
var fn_params: table<i64>;   // 参数类型扁平段（前缀和式）
// S2.4 port 名表（索引 -> 名字；type_name 还原用，由语义层 set_port_name 登记）
var pt_names: table<string>;

// 嵌套负载序号偏移（避开 named 负载段 0..99；named 仅 0..20 安全余量）
const NEST_SLOT_OFF: i64 = 100;

namespace types {

// ---------- 类型 id 构造（编码，O(1)）----------

// Named 类型：id = TyKw 索引（0..20，见 TK_* 常量）。
pub func named(kw: i64) -> i64 {
    return kw
}

// table<T>：id = 1<<40 | T（T 为任意 type id，含嵌套）。
// 嵌套聚合元素（T ≥ 100）查/登记序号表，负载 = 100 + 序号——防止
// BASE_TABLE + 聚合进位碰撞 map 段（历史 bug：table<table<i64>> == map<i64>）。
pub func table_of(elem: i64) -> i64 {
    if elem < NEST_SLOT_OFF {
        return BASE_TABLE + elem  // 快路径：named 元素（0..99）
    }
    var n = len(nest_tbl_elems)
    var i: i64 = 0
    while i < n {
        if nest_tbl_elems[i] == elem {
            return BASE_TABLE + NEST_SLOT_OFF + i
        }
        i = i + 1
    }
    table_push(nest_tbl_elems, elem)
    return BASE_TABLE + NEST_SLOT_OFF + n
}

// map<V>：id = 2<<40 | V（嵌套聚合值同 table_of 的序号表方案）。
pub func map_of(v: i64) -> i64 {
    if v < NEST_SLOT_OFF {
        return BASE_MAP + v
    }
    var n = len(nest_map_vals)
    var i: i64 = 0
    while i < n {
        if nest_map_vals[i] == v {
            return BASE_MAP + NEST_SLOT_OFF + i
        }
        i = i + 1
    }
    table_push(nest_map_vals, v)
    return BASE_MAP + NEST_SLOT_OFF + n
}

// struct S：id = 3<<40 | struct_索引（struct 表行号）。
pub func struct_of(idx: i64) -> i64 {
    return BASE_STRUCT + idx
}

// tuple：id = 4<<40 | tuple_索引（tuple 表行号）。
pub func tuple_of(idx: i64) -> i64 {
    return BASE_TUPLE + idx
}

// TypeVar（泛型类型参数）：id = 5<<40 | intern.intern(name)。
// 名字即身份——同名类型参数全局同 id、跨函数稳定（mangling 友好）；
// intern 池 id < 2^40 保证不碰撞（named/table/map/struct/tuple 均 < 5<<40）。
// 供语义层登记泛型形参使用；还原名字走 type_name（interner.lookup(low(t))）。
pub func var_of(name: string) -> i64 {
    return BASE_TYPEVAR + interner.intern(name)
}

// enum E：id = 6<<40 | enum_索引（enum 表行号）。
pub func enum_of(idx: i64) -> i64 {
    return BASE_ENUM + idx
}

// ---------- S1.2 不安全类型（ptr/slice/atomic）构造 ----------
// 嵌套聚合负载（T ≥ NEST_SLOT_OFF）走各自序号表（同 table_of 方案防进位碰撞）。
// ptr<T>：id = 7<<40 | T。T 为任意类型 id（含嵌套聚合）。
pub func ptr_of(elem: i64) -> i64 {
    if elem < NEST_SLOT_OFF {
        return BASE_PTR + elem
    }
    var n = len(nest_ptr_elems)
    var i: i64 = 0
    while i < n {
        if nest_ptr_elems[i] == elem {
            return BASE_PTR + NEST_SLOT_OFF + i
        }
        i = i + 1
    }
    table_push(nest_ptr_elems, elem)
    return BASE_PTR + NEST_SLOT_OFF + n
}

// slice<T>：id = 8<<40 | T（指针 + 长度；元素类型）。
pub func slice_of(elem: i64) -> i64 {
    if elem < NEST_SLOT_OFF {
        return BASE_SLICE + elem
    }
    var n = len(nest_slice_elems)
    var i: i64 = 0
    while i < n {
        if nest_slice_elems[i] == elem {
            return BASE_SLICE + NEST_SLOT_OFF + i
        }
        i = i + 1
    }
    table_push(nest_slice_elems, elem)
    return BASE_SLICE + NEST_SLOT_OFF + n
}

// atomic<T>：id = 9<<40 | T（原子类型，第一版 i64/f64/bool）。
pub func atomic_of(elem: i64) -> i64 {
    if elem < NEST_SLOT_OFF {
        return BASE_ATOMIC + elem
    }
    var n = len(nest_atomic_elems)
    var i: i64 = 0
    while i < n {
        if nest_atomic_elems[i] == elem {
            return BASE_ATOMIC + NEST_SLOT_OFF + i
        }
        i = i + 1
    }
    table_push(nest_atomic_elems, elem)
    return BASE_ATOMIC + NEST_SLOT_OFF + n
}

// ---------- S2.2 fn 函数值类型构造 ----------
// fn(A, B) -> R：id = 10<<40 | 签名索引。签名 = 返回类型 + 参数类型列表，
// 查 fn 签名表编码（低负载为签名表行号）。参数可含任意类型 id（含嵌套聚合、
// 另一个 fn 类型——函数值作参数天然合法）。
// fn_of 查重/登记：按返回类型 + 参数列表逐一比对，命中返回既有索引；
// 未命中追加登记并返回新索引。参数类型存扁平段（fn_params），
// 每个签名记录参数个数与段偏移（fn_nparams / fn_paroff）。
pub func fn_of(ret: i64, params: table<i64>) -> i64 {
    var n = len(fn_ret)
    var i: i64 = 0
    while i < n {
        if fn_ret[i] == ret && fn_nparams[i] == len(params) {
            var off = fn_paroff[i]
            var ok: bool = true
            var j: i64 = 0
            while j < len(params) {
                if fn_params[off + j] != params[j] {
                    ok = false
                    break
                }
                j = j + 1
            }
            if ok {
                return BASE_FN + i
            }
        }
        i = i + 1
    }
    table_push(fn_ret, ret)
    table_push(fn_nparams, len(params))
    table_push(fn_paroff, len(fn_params))
    var k: i64 = 0
    while k < len(params) {
        table_push(fn_params, params[k])
        k = k + 1
    }
    return BASE_FN + n
}

// fn 返回类型：fn 类型 -> 返回类型 id；非 fn 类型返回 -1。
pub func fn_ret_ty(t: i64) -> i64 {
    var idx = low(t)
    if idx >= 0 && idx < len(fn_ret) {
        return fn_ret[idx]
    }
    return -1
}

// fn 参数个数：fn 类型 -> 参数个数；非 fn 类型返回 -1。
pub func fn_nparams_of(t: i64) -> i64 {
    var idx = low(t)
    if idx >= 0 && idx < len(fn_nparams) {
        return fn_nparams[idx]
    }
    return -1
}

// fn 第 k 个参数类型：fn 类型 -> 参数类型 id；越界/非 fn 返回 -1。
pub func fn_param_of(t: i64, k: i64) -> i64 {
    var idx = low(t)
    if idx >= 0 && idx < len(fn_nparams) {
        if k >= 0 && k < fn_nparams[idx] {
            return fn_params[fn_paroff[idx] + k]
        }
    }
    return -1
}

// ---------- S2.4 port 对象类型构造 ----------
// port P：id = 11<<40 | port 索引（port 表行号，语义层登记顺序）。
pub func port_of(idx: i64) -> i64 {
    return BASE_PORT + idx
}

// port 类型判据：kind == K_PORT（11<<40 段）。
pub func is_port(t: i64) -> bool {
    if kind(t) == K_PORT {
        return true
    }
    return false
}

// 登记 port 索引 -> 名字（语义层收集 port 时调用；追加式，
// 索引 = 登记顺序，与语义 port 表行号对应）。
pub func set_port_name(idx: i64, nm: string) {
    while len(pt_names) < idx {
        table_push(pt_names, "")
    }
    table_push(pt_names, nm)
}

// ---------- 一期并发 actor 句柄类型构造 ----------
// actor A 句柄：id = 12<<40 | actor 表行号（语义层登记顺序）。
pub func actor_of(idx: i64) -> i64 {
    return BASE_ACTOR + idx
}
// actor 句柄判据：kind == K_ACTOR（12<<40 段）。
pub func is_actor(t: i64) -> bool {
    if kind(t) == K_ACTOR {
        return true
    }
    return false
}
// 登记 actor 索引 -> 名字（语义层收集 actor 时调用；追加式，索引 = 登记顺序）。
pub func set_actor_name(idx: i64, nm: string) {
    while len(act_names) < idx {
        table_push(act_names, "")
    }
    table_push(act_names, nm)
}

// ---------- 类型 id 解码 ----------

// 类型类别：0=Named 1=Table 2=Map 3=Struct 4=Tuple 5=TypeVar 6=Enum
// 7=Ptr 8=Slice 9=Atomic 10=Fn。
// Named 判定用 id < 100（TyKw 索引 0..20，留余量）；
// 其余按高位阈值顺序判别（Fn 段 10<<40 最高必须最先判；之后
// Atomic 9<<40、Slice 8<<40、Ptr 7<<40、Enum 6<<40、TypeVar、Tuple、
// Struct、Map，其余为 Table——与 semantic ty_kind 一致）。
pub func kind(id: i64) -> i64 {
    if id < 100 {
        return K_NAMED
    }
    if id >= BASE_ACTOR {
        return K_ACTOR
    }
    if id >= BASE_PORT {
        return K_PORT
    }
    if id >= BASE_FN {
        return K_FN
    }
    if id >= BASE_ATOMIC {
        return K_ATOMIC
    }
    if id >= BASE_SLICE {
        return K_SLICE
    }
    if id >= BASE_PTR {
        return K_PTR
    }
    if id >= BASE_ENUM {
        return K_ENUM
    }
    if id >= BASE_TYPEVAR {
        return K_TYPEVAR
    }
    if id >= BASE_TUPLE {
        return K_TUPLE
    }
    if id >= BASE_STRUCT {
        return K_STRUCT
    }
    if id >= BASE_MAP {
        return K_MAP
    }
    return K_TABLE
}

// 类型负载：Table/Map/Ptr/Slice/Atomic 的元素类型 id、Struct/Tuple/Enum/Port 的
// 索引、TypeVar 的 intern 池 id；Named 类型无意义（调用方先判 kind）。
pub func low(id: i64) -> i64 {
    if id >= BASE_ACTOR {
        return id - BASE_ACTOR
    }
    if id >= BASE_PORT {
        return id - BASE_PORT
    }
    if id >= BASE_FN {
        return id - BASE_FN
    }
    if id >= BASE_ATOMIC {
        return id - BASE_ATOMIC
    }
    if id >= BASE_SLICE {
        return id - BASE_SLICE
    }
    if id >= BASE_PTR {
        return id - BASE_PTR
    }
    if id >= BASE_ENUM {
        return id - BASE_ENUM
    }
    if id >= BASE_TYPEVAR {
        return id - BASE_TYPEVAR
    }
    if id >= BASE_TUPLE {
        return id - BASE_TUPLE
    }
    if id >= BASE_STRUCT {
        return id - BASE_STRUCT
    }
    if id >= BASE_MAP {
        return id - BASE_MAP
    }
    return id - BASE_TABLE
}

// ---------- 判据族（语义检查/IR 生成共用）----------

// 整数类型：i8/i16/i32/i64/i128/u8/u16/u32/u64/u128（Named 且 TyKw 在整数区间）。
pub func is_int(t: i64) -> bool {
    if t >= 100 {
        return false
    }
    if t == TK_I8 || t == TK_I16 || t == TK_I32 || t == TK_I64 || t == TK_I128 {
        return true
    }
    if t == TK_U8 || t == TK_U16 || t == TK_U32 || t == TK_U64 || t == TK_U128 {
        return true
    }
    return false
}

// 浮点类型：f32/f64。
pub func is_float(t: i64) -> bool {
    if t == TK_F32 || t == TK_F64 {
        return true
    }
    return false
}

// 数值类型：整数或浮点（算术运算合法域）。
pub func is_number(t: i64) -> bool {
    if is_int(t) {
        return true
    }
    return is_float(t)
}

// 布尔类：bool/trit（条件语境合法域，trit 三值逻辑）。
pub func is_bool_like(t: i64) -> bool {
    if t == TK_BOOL || t == TK_TRIT {
        return true
    }
    return false
}

// 宽类型：num/text/misc（类别框，未细化的泛化类型）。
pub func is_wide(t: i64) -> bool {
    if t == TK_NUM || t == TK_TEXT || t == TK_MISC {
        return true
    }
    return false
}

// 表类：裸 table 关键字或参数化 table<T>/map<V>（含裸 map）。
// 注意与 map 判据的区分：is_table 覆盖 map（semantic 同款，
// 表/映射统一按表处理，迭代/下标语义一致）。
pub func is_table(t: i64) -> bool {
    if t == TK_TABLE {
        return true
    }
    var k = kind(t)
    if k == K_TABLE {
        return true
    }
    if k == K_MAP {
        return true
    }
    return false
}

// 映射类：裸 map 关键字或参数化 map<V>。
pub func is_map(t: i64) -> bool {
    if t == TK_MAP {
        return true
    }
    if kind(t) == K_MAP {
        return true
    }
    return false
}

// 枚举判据：kind == K_ENUM（6<<40 段）。
// 供语义层识别枚举类型（构造/匹配/类型检查按 kind 分派）。
pub func is_enum(t: i64) -> bool {
    if kind(t) == K_ENUM {
        return true
    }
    return false
}

// TypeVar 判据：kind == K_TYPEVAR（5<<40 段）。
// 供语义层识别泛型形参（如函数签名类型槽位里出现 TypeVar 时走单态化
// 替换路径）；单态化替换后应还原为具体类型再走其余判据族。
pub func is_typevar(t: i64) -> bool {
    if kind(t) == K_TYPEVAR {
        return true
    }
    return false
}

// 表元素类型：参数化 table<T>/map<V>/ptr<T>/slice<T>/atomic<T> 返回负载 T；
// 裸 table/map 关键字返回 -1（元素类型未知）。
// 嵌套聚合负载（≥ NEST_SLOT_OFF）查序号表还原真实元素类型。
pub func table_elem(t: i64) -> i64 {
    var k = kind(t)
    if k == K_TABLE {
        var ld = low(t)
        if ld < NEST_SLOT_OFF {
            return ld  // named 元素（0..99）
        }
        var si = ld - NEST_SLOT_OFF
        if si >= 0 && si < len(nest_tbl_elems) {
            return nest_tbl_elems[si]
        }
        return -1
    }
    if k == K_MAP {
        var ld2 = low(t)
        if ld2 < NEST_SLOT_OFF {
            return ld2
        }
        var si2 = ld2 - NEST_SLOT_OFF
        if si2 >= 0 && si2 < len(nest_map_vals) {
            return nest_map_vals[si2]
        }
        return -1
    }
    if k == K_PTR {
        var lp = low(t)
        if lp < NEST_SLOT_OFF {
            return lp
        }
        var sp = lp - NEST_SLOT_OFF
        if sp >= 0 && sp < len(nest_ptr_elems) {
            return nest_ptr_elems[sp]
        }
        return -1
    }
    if k == K_SLICE {
        var ls = low(t)
        if ls < NEST_SLOT_OFF {
            return ls
        }
        var ss = ls - NEST_SLOT_OFF
        if ss >= 0 && ss < len(nest_slice_elems) {
            return nest_slice_elems[ss]
        }
        return -1
    }
    if k == K_ATOMIC {
        var la = low(t)
        if la < NEST_SLOT_OFF {
            return la
        }
        var sa = la - NEST_SLOT_OFF
        if sa >= 0 && sa < len(nest_atomic_elems) {
            return nest_atomic_elems[sa]
        }
        return -1
    }
    return -1
}

// ---------- S1.2 不安全类型判据 ----------
// ptr/slice/atomic 判据（kind 段判别）。
pub func is_ptr(t: i64) -> bool {
    if kind(t) == K_PTR {
        return true
    }
    return false
}
pub func is_slice(t: i64) -> bool {
    if kind(t) == K_SLICE {
        return true
    }
    return false
}
pub func is_atomic(t: i64) -> bool {
    if kind(t) == K_ATOMIC {
        return true
    }
    return false
}

// 是否不安全类型（指针/切片/原子——安全代码不可见，S1.2 S1 全归 unsafe）
pub func is_unsafe_ty(t: i64) -> bool {
    var k = kind(t)
    if k == K_PTR || k == K_SLICE || k == K_ATOMIC {
        return true
    }
    return false
}

// ---------- struct / enum 名登记（type_name 还原用）----------

// 登记 struct 索引 -> 名字（语义阶段收集 struct 时调用；
// 追加式，索引 = 登记顺序，与语义 struct 表行号对应）。
pub func set_struct_name(idx: i64, nm: string) {
    while len(st_names) < idx {
        table_push(st_names, "")
    }
    table_push(st_names, nm)
}

// 登记 enum 索引 -> 名字（语义阶段收集 enum 时调用；追加式，
// 索引 = 登记顺序，与语义 enum 表行号对应）。
pub func set_enum_name(idx: i64, nm: string) {
    while len(en_names) < idx {
        table_push(en_names, "")
    }
    table_push(en_names, nm)
}

// ---------- 类型名字（错误消息用；递归还原）----------

// 构建 TyKw 索引 -> 类型名表（懒构建，仅 type_name 使用）。
func ensure_tykw_names() {
    if len(tykw_names) > 0 {
        return
    }
    tykw_names = table_new_string()
    table_push(tykw_names, "i8")
    table_push(tykw_names, "i16")
    table_push(tykw_names, "i32")
    table_push(tykw_names, "i64")
    table_push(tykw_names, "u8")
    table_push(tykw_names, "u16")
    table_push(tykw_names, "u32")
    table_push(tykw_names, "u64")
    table_push(tykw_names, "f32")
    table_push(tykw_names, "f64")
    table_push(tykw_names, "bool")
    table_push(tykw_names, "trit")
    table_push(tykw_names, "char")
    table_push(tykw_names, "string")
    table_push(tykw_names, "void")
    table_push(tykw_names, "code")
    table_push(tykw_names, "num")
    table_push(tykw_names, "text")
    table_push(tykw_names, "misc")
    table_push(tykw_names, "table")
    table_push(tykw_names, "map")
    // 批次 2（i128/u128）：索引 21/22 对齐 TK_I128/TK_U128
    table_push(tykw_names, "i128")
    table_push(tykw_names, "u128")
}

// 类型 id -> 名字（递归）：Named 查 tykw_names；Table/Map 递归
// 拼 "table<T>"/"map<V>"；Struct 查 st_names（未登记回退 "struct"）；
// Tuple 固定 "tuple"；TypeVar 经 interner.lookup(low(t)) 还原参数名
// （intern 池 id 越界兜底 "?"）。错误消息用（与 semantic type_name 一致）。
pub func type_name(t: i64) -> string {
    var k = kind(t)
    if k == K_NAMED {
        ensure_tykw_names()
        if t >= 0 && t < len(tykw_names) {
            return tykw_names[t]
        }
        return "?"
    }
    if k == K_TABLE {
        return "table<" + type_name(table_elem(t)) + ">"
    }
    if k == K_MAP {
        return "map<" + type_name(table_elem(t)) + ">"
    }
    if k == K_PTR {
        return "ptr<" + type_name(table_elem(t)) + ">"
    }
    if k == K_SLICE {
        return "slice<" + type_name(table_elem(t)) + ">"
    }
    if k == K_ATOMIC {
        return "atomic<" + type_name(table_elem(t)) + ">"
    }
    if k == K_STRUCT {
        var idx = low(t)
        if idx >= 0 && idx < len(st_names) {
            return st_names[idx]
        }
        return "struct"
    }
    if k == K_ENUM {
        var eidx = low(t)
        if eidx >= 0 && eidx < len(en_names) {
            return en_names[eidx]
        }
        return "enum"   // 未登记兜底（理论不发生，防御性）
    }
    if k == K_TYPEVAR {
        var iv = low(t)
        if interner.is_valid(iv) {
            return interner.lookup(iv)
        }
        return "?"   // intern 池 id 越界兜底（理论不发生，防御性）
    }
    if k == K_PORT {
        var pidx = low(t)
        if pidx >= 0 && pidx < len(pt_names) {
            return pt_names[pidx]
        }
        return "port"   // 未登记兜底（理论不发生，防御性）
    }
    if k == K_ACTOR {
        // 一期并发 actor 句柄：显示类型名（如 "Counter"）
        var aidx = low(t)
        if aidx >= 0 && aidx < len(act_names) {
            return act_names[aidx]
        }
        return "actor"   // 未登记兜底（理论不发生，防御性）
    }
    if k == K_FN {
        var s: string = "fn("
        var np = fn_nparams_of(t)
        var i: i64 = 0
        while i < np {
            if i > 0 {
                s = s + ", "
            }
            s = s + type_name(fn_param_of(t, i))
            i = i + 1
        }
        s = s + ") -> " + type_name(fn_ret_ty(t))
        return s
    }
    return "tuple"
}

// fn 类型判据：kind == K_FN（10<<40 段）。供语义层识别函数值类型
// （变量/参数/字段声明与调用检查按 kind 分派）。
pub func is_fn(t: i64) -> bool {
    if kind(t) == K_FN {
        return true
    }
    return false
}

}   // namespace types
