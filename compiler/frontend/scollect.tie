type tie<class>
// compiler/frontend/scollect.tie —— T2.6 顶层收集子遍（模块拆分）
// ============================================================
// 里程碑：自举 v2 计划 T2.6（.omo/plans/self-hosting-v2.md）完整语义分析
// 拆分为 8 模块之一（本文件 = 顶层收集：函数/命名空间/struct/全局变量/
// extern 登记 + struct 字段拍平 + 返回表预扫描 + 命名空间全名补全）。
// 对应 proto/semantic.tie 862-872（tre_bi_init）+ 873-957（collect_top）
// + 960-1058（find_struct_node/collect_struct_fields/collect_all_struct_fields）
// + 1066-1207（scan_return_elem/scan_blk/collect_all_return_tables）
// + 1208-1247（collect_fn）+ 1266-1336（collect_ns/ns_full_name）
// + 1339-1407（collect_global_var）逻辑搬移。
// 依赖：./sstate.tie（AST 全局 + 符号表 + 工具）+ ./sinfer.tie（表达式推断
// + resolve_call_name + table_ret_elem）。树式无环：由 scheck.tie import。
import "./sinfer.tie"

namespace scollect {

// 内置函数返回表预登记（语言底座）
pub func tre_bi_init() {
    tre_bi_keys = table_new_i64()
    tre_bi_vals = table_new_i64()
    sstate.sorted_insert(tre_bi_keys, tre_bi_vals, intern.intern("list_dir"), types.named(TK_STR))
    sstate.sorted_insert(tre_bi_keys, tre_bi_vals, intern.intern("walk_dir"), types.named(TK_STR))
    sstate.sorted_insert(tre_bi_keys, tre_bi_vals, intern.intern("byte_read"), types.named(TK_I64))
    sstate.sorted_insert(tre_bi_keys, tre_bi_vals, intern.intern("byte_concat"), types.named(TK_I64))
    sstate.sorted_insert(tre_bi_keys, tre_bi_vals, intern.intern("regex_find_all"), types.named(TK_STR))
}

// extern 返回类型标量判定（对齐 Rust is_scalar_extern_ty：i8..u64/f32/f64/bool/char/string）
func is_scalar_t(t: i64) -> bool {
    if types.kind(t) != K_NAMED {
        return false
    }
    // Named 且 TyKw 在标量集（0-10, 12-13；排除 trit=11, void=14+）
    if t >= 0 && t <= 10 {
        return true
    }
    if t == TK_CHAR || t == TK_STR {
        return true
    }
    return false
}

// 顶层函数签名收集（含参数/返回类型解析 + 默认值/ref 校验）
pub func collect_fn(fn_node: i64, full: string) -> i64 {
    // 泛型模板登记分派（2026-08-14 泛型语法）：children[0] == N_TYPE_PARAMS
    // 时按模板登记（sstate.reg_generic → gt_* 表），**不**按普通函数收集——
    // 否则模板参数类型（TypeVar 名如 "T"）经 stype.parse_type_node 会报
    // "类 'T' 未定义"。单态化展开语义由 T3b 负责，本任务只保证泛型声明
    // 本身不使语义崩溃 + 模板结构就位。
    if sstate.nchild(fn_node) > 0 {
        var slot0 = sstate.child(fn_node, 0)
        if slot0 >= 0 && s_tags[slot0] == S_N_TYPE_PARAMS {
            var gret = sstate.reg_generic(full, fn_node, 0)
            if gret < 0 {
                return -1
            }
            return 0
        }
    }
    var nparams = s_aux[fn_node]
    var is_pub = s_vals[fn_node]
    // 返回类型：FnDef children[slot_off]（新布局 children[0]=泛型槽→偏移 1；
    // 旧布局无槽→children[0]=返回类型。slot_off 统一判定保证自举双兼容）
    var rt_node = sstate.child(fn_node, sstate.slot_off(fn_node))
    var ret_ty = sgen.parse_generic_type_node(rt_node)
    if ret_ty < 0 {
        return -1
    }
    var p_tys: table<i64> = table_new_i64()
    var p_refs: table<i64> = table_new_i64()
    var p_defs: table<i64> = table_new_i64()
    var p_vars: table<i64> = table_new_i64()
    var required: i64 = nparams
    // 变参函数：必选数初值扣掉变参本身（调用方可传 0 个额外实参；
    // 下方循环对变参跳过时保留该初值——如 `sum(rest: ...i64)` 需 0）
    if nparams > 0 {
        var lastp = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + (nparams - 1))
        if s_aux[lastp] == 1 {
            required = nparams - 1
        }
    }
    // 默认值校验：ref 不能带默认值 + 可选参数必须连续 + 默认值必须字面量 + 类型匹配
    var seen_default: bool = false
    var k: i64 = 0
    while k < nparams {
        // 第 k 个参数：children[slot_off + 1 + k]
        var p = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + k)
        var pt = sgen.parse_generic_type_node(sstate.child(p, 0))
        if pt < 0 {
            return -1
        }
        var is_ref = s_vals[p]
        var is_var = s_aux[p]   // 变参标志（`name: ...T`，parser 写入 aux）
        var has_def: i64 = 0
        var def_node: i64 = -1
        if sstate.nchild(p) > 1 {
            def_node = sstate.child(p, 1)
            if def_node >= 0 {
                has_def = 1
            }
        }
        // 变参（`...T`）：必须最后一个、无 ref、无默认值、元素类型限标量
        if is_var == 1 {
            if k != nparams - 1 {
                sm_err_line = s_lines[p]
                sm_err_col = s_cols[p]
                sm_err_msg = "变参参数 '" + sstate.name_str(p) + "' 必须是最后一个参数"
                return -1
            }
            if is_ref == 1 {
                sm_err_line = s_lines[p]
                sm_err_col = s_cols[p]
                sm_err_msg = "变参参数 '" + sstate.name_str(p) + "' 不能同时使用 ref 修饰"
                return -1
            }
            if has_def == 1 {
                sm_err_line = s_lines[p]
                sm_err_col = s_cols[p]
                sm_err_msg = "变参参数 '" + sstate.name_str(p) + "' 不能有默认值"
                return -1
            }
            // 元素类型限标量（i8..u64/f32/f64/bool/char/string；对齐 extern 标量集）
            if !is_scalar_t(pt) {
                sm_err_line = s_lines[p]
                sm_err_col = s_cols[p]
                sm_err_msg = "变参参数 '" + sstate.name_str(p) + "' 元素类型必须是标量（i8..u64/f32/f64/bool/char/string），实际是 " + types.type_name(pt)
                return -1
            }
            // 变参在函数体/调用点表现为 table<T>（签名登记表类型）
            pt = types.table_of(pt)
        }
        // ref 参数不能有默认值（对齐 Rust：必须在调用点传实参）
        if is_ref == 1 && has_def == 1 {
            sm_err_line = s_lines[p]
            sm_err_col = s_cols[p]
            sm_err_msg = "参数 '" + sstate.name_str(p) + "' 的 ref 参数不能有默认值（必须在调用点传实参）"
            return -1
        }
        // ref 形参仅支持表参数（对齐 Rust：标量/字符串/struct 形参引用无实义）
        if is_ref == 1 && !types.is_table(pt) {
            sm_err_line = s_lines[p]
            sm_err_col = s_cols[p]
            sm_err_msg = "参数 '" + sstate.name_str(p) + "' 的 ref 修饰仅支持表参数（table/table<T>），实际是 " + types.type_name(pt)
            return -1
        }
        // 可选参数（带默认值）必须连续排在必选参数之后
        // （变参不参与该约束——它恒居末位，前面允许可选参数）
        if has_def == 1 {
            seen_default = true
        } else if seen_default && is_var == 0 {
            sm_err_line = s_lines[p]
            sm_err_col = s_cols[p]
            sm_err_msg = "参数 '" + sstate.name_str(p) + "' 缺少默认值：可选参数（带默认值）必须连续排在必选参数之后"
            return -1
        }
        // 默认值必须是字面量（数/布尔/字符/字符串或空表 []）
        if has_def == 1 {
            var dt = def_node
            var dtag = s_tags[dt]
            var is_ok: bool = false
            if dtag == S_N_INT_LIT || dtag == S_N_FLOAT_LIT || dtag == S_N_BOOL_LIT || dtag == S_N_CHAR_LIT || dtag == S_N_STR_LIT {
                is_ok = true
            } else if dtag == S_N_TABLE_LIT {
                if sstate.nchild(dt) == 0 {
                    is_ok = true
                }
            }
            if !is_ok {
                sm_err_line = s_lines[p]
                sm_err_col = s_cols[p]
                sm_err_msg = "参数 '" + sstate.name_str(p) + "' 的默认值必须是字面量（数/布尔/字符/字符串或空表 []）"
                return -1
            }
            // 默认值类型匹配：默认值推导类型必须与参数类型兼容
            // 空表字面量 [] 默认值：直接通过（对齐 Rust：空表 → 任意表类型）
            var dt_ty = sinfer.infer_expr(dt)
            if dt_ty < 0 {
                return -1
            }
            var is_empty_tbl: bool = false
            if dtag == S_N_TABLE_LIT {
                if sstate.nchild(dt) == 0 {
                    is_empty_tbl = true
                }
            }
            if !is_empty_tbl {
                if !stype.types_match(pt, dt_ty, dt) {
                    sm_err_line = s_lines[p]
                    sm_err_col = s_cols[p]
                    sm_err_msg = "参数 '" + sstate.name_str(p) + "' 默认值类型不匹配：期望 " + types.type_name(pt) + "，实际 " + types.type_name(dt_ty)
                    return -1
                }
            }
        }
        table_push(p_tys, pt)
        table_push(p_refs, is_ref)
        table_push(p_defs, has_def)
        table_push(p_vars, is_var)
        // 必选数：变参本身不计数（调用方可传 0 个额外实参）
        if has_def == 0 && is_var == 0 {
            required = k + 1
        }
        k = k + 1
    }
    // M2.1.8：namespace <struct 名> 内的函数，首参 == 该 struct 类型 → 首参
    // **自动按引用传递**（对齐 Rust ir.rs：param_by_ref[0]，字段修改反映到调用方）。
    // `pub func inc(c: Counter)` 在 namespace Counter 内：c 首参标 ref，
    // c.inc() 转发时传 c 的槽地址，inc 内 c.count 修改写回调用方。
    if nparams > 0 {
        var last2 = sstate.rfind_ns(full)
        if last2 >= 0 {
            var ns_name = ig_slice2(full, 0, last2)
            var snid = intern.intern(ns_name)
            var sidx2 = sstate.bs_find(st_keys, snid)
            if sidx2 >= 0 {
                var si2 = st_vals[sidx2]
                if p_tys[0] == types.struct_of(si2) {
                    p_refs[0] = 1  // 首参按引用（接收者）
                }
            }
        }
    }
    if sstate.reg_fn(full, is_pub, nparams, required, ret_ty, p_tys, p_refs, p_defs, p_vars) < 0 {
        sm_err_line = s_lines[fn_node]
        sm_err_col = s_cols[fn_node]
        return -1
    }
    return 0
}

// 字符串切片（scollect 本地辅助；对齐 irgen.ig_slice）
func ig_slice2(s: string, start: i64, end: i64) -> string {
    var out: string = ""
    var i: i64 = start
    while i < end {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

// 顶层 struct 声明登记分派（泛型语法 2026-08-14）：
// children[0] == N_TYPE_PARAMS → 泛型 struct 模板登记（sstate.reg_generic →
// gt_* 表，跳过普通 struct 收集——模板字段的 TypeVar 类型无法静态解析，
// collect_struct_fields 会因"类 'T' 未定义"崩溃）；否则普通 reg_struct。
// 返回 0 成功 / -1 错误（sm_err_* 已置）。
func collect_struct_decl(s: i64) -> i64 {
    var nm = sstate.name_str(s)
    if sstate.nchild(s) > 0 {
        var slot0 = sstate.child(s, 0)
        if slot0 >= 0 && s_tags[slot0] == S_N_TYPE_PARAMS {
            var gret = sstate.reg_generic(nm, s, 1)
            if gret < 0 {
                return -1
            }
            return 0
        }
    }
    var parent = ""
    var p = s_aux[s]
    if p >= 0 {
        parent = intern.lookup(p)
    }
    // struct 与函数名冲突（对齐 Rust check_struct_namespace：struct 名不能与
    // 同命名空间函数同名——构造调用 vs 函数调用的歧义）
    var snid = intern.intern(nm)
    if sstate.bs_find(fn_keys, snid) >= 0 {
        sm_err_line = s_lines[s]
        sm_err_col = s_cols[s]
        sm_err_msg = "struct 名 '" + nm + "' 与函数名冲突"
        return -1
    }
    var idx = sstate.reg_struct(nm, parent)
    if idx < 0 {
        sm_err_line = s_lines[s]
        sm_err_col = s_cols[s]
        return -1
    }
    // struct 名登记（types.type_name / 泛型 mangling 片段还原用；追加式与
    // reg_struct 索引顺序一致——实例化 struct 由 sgen.instantiate_struct 同步登记）
    types.set_struct_name(idx, nm)
    return 0
}

// 查找顶层 struct 定义节点（按名字）
pub func find_struct_node(name: string) -> i64 {
    var n = sstate.nchild(g_root)
    var i: i64 = 0
    while i < n {
        var s = sstate.child(g_root, i)
        if s_tags[s] == S_N_STRUCT {
            if sstate.name_str(s) == name {
                return s
            }
        }
        i = i + 1
    }
    return -1
}

// 泛型类型引用预实例化（2026-08-14 泛型字段类型修复）。
// 遍历已登记 struct（st_keys，动态增长）的字段类型节点，用泛型感知解析触发
// 模板 struct 引用（如 `A<i64>`）的 instantiate_struct。必须发生在
// collect_all_struct_fields 之前——否则字段类型解析的实例化副作用会把
// cls_fldoff 顶偏（详见 collect_struct_fields 注释）。此时实例化已幂等，
// 正式字段拍平不再产生新副作用，off 稳定。
pub func pre_instantiate_field_types() -> i64 {
    var i: i64 = 0
    while i < len(st_keys) {
        var nm = intern.lookup(st_keys[i])
        var snode = find_struct_node(nm)
        if snode >= 0 {
            var soff = sstate.slot_off(snode)
            var nf = sstate.nchild(snode) - soff
            var k: i64 = 0
            while k < nf {
                var f = sstate.child(snode, soff + k)
                var fty = sgen.parse_generic_type_node(sstate.child(f, 0))
                if fty < 0 {
                    sm_err_line = s_lines[f]
                    sm_err_col = s_cols[f]
                    return -1
                }
                k = k + 1
            }
        }
        i = i + 1  // len(st_keys) 每次重求——实例化增长自动覆盖
    }
    return 0
}

// 收集单个 struct 的拍平字段（含继承）
pub func collect_struct_fields(si: i64) -> i64 {
    if cls_done[si] == 1 {
        return 0
    }
    // 继承环检测（对齐 Rust check_inheritance_cycle）：沿 cls_parent 链走，
    // 若回到自身（si）则成环。A extends B、B extends A → A→B→A。
    var start_si = si
    var cur: i64 = si
    var guard: i64 = 0
    var has_cycle: bool = false
    while guard < 1000 {
        var pp = cls_parent[cur]
        if pp < 0 {
            break
        }
        var pidx = sstate.bs_find(st_keys, pp)
        if pidx < 0 {
            break
        }
        var psi = st_vals[pidx]
        if psi == start_si {
            has_cycle = true
            break
        }
        cur = psi
        guard = guard + 1
    }
    if has_cycle {
        var nm = intern.lookup(st_keys[si])
        sm_err_line = s_lines[find_struct_node(nm)]
        sm_err_col = s_cols[find_struct_node(nm)]
        sm_err_msg = "struct 继承形成环（含 '" + nm + "'）"
        return -1
    }
    cls_done[si] = 1
    var p = cls_parent[si]
    if p >= 0 {
        var pidx = sstate.bs_find(st_keys, p)
        var psi = st_vals[pidx]
        var r = collect_struct_fields(psi)
        if r < 0 {
            return -1
        }
        // 字段段起点对齐父字段段
        cls_fldoff[si] = cls_fldoff[psi]
        cls_nfld[si] = cls_nfld[psi]
    } else {
        // 无父：字段段起点 = 当前 fld_names 末尾
        cls_fldoff[si] = len(fld_names)
        cls_nfld[si] = 0
    }
    var nm = intern.lookup(st_keys[si])
    var snode = find_struct_node(nm)
    if snode < 0 {
        sm_err_line = 1
        sm_err_col = 1
        sm_err_msg = "内部错误：struct '" + nm + "' 定义节点未找到"
        return -1
    }
    // 自身字段：Struct children = [泛型槽, ClassField...]，字段从 children[1] 起
    var soff = sstate.slot_off(snode)  // struct 泛型槽偏移（恒 1；防御读取）
    var nf = sstate.nchild(snode) - soff
    // 2026-08-14 泛型修复：先预解析全部字段类型到临时表，再设 cls_fldoff，最后统一
    // push。原因：字段类型中的模板 struct 引用（如 `A<i64>`）经 sgen.parse_generic_type_node
    // 会触发 instantiate_struct → 立即把实例化 struct 的字段 push 进 fld_*。若 cls_fldoff
    // 在解析前设置，这些副作用字段会把 off 顶偏（构造时读到别的 struct 的字段段，
    // 报"字段 'v' 期望 i64，实际 A$i64"这类错位）。先解析 → off 取解析后的长度 →
    // 自身字段 push 在副作用字段之后，off 恒正确。
    var f_ids: table<i64> = table_new_i64()
    var f_tys: table<i64> = table_new_i64()
    var f_defs: table<i64> = table_new_i64()
    var k: i64 = 0
    while k < nf {
        var f = sstate.child(snode, soff + k)
        var fty = sgen.parse_generic_type_node(sstate.child(f, 0))
        if fty < 0 {
            sm_err_line = s_lines[f]
            sm_err_col = s_cols[f]
            return -1
        }
        table_push(f_ids, intern.intern(sstate.name_str(f)))
        table_push(f_tys, fty)
        // 字段默认值（`var y: i64 = 10` → child(f, 1)；无默认值 -1）
        var fdef: i64 = -1
        if sstate.nchild(f) > 1 {
            fdef = sstate.child(f, 1)
        }
        table_push(f_defs, fdef)
        k = k + 1
    }
    // 字段段起点：无父 = 类型解析完成后 fld_* 的当前长度（副作用字段已在其内，
    // off 恒正确）；有父 = 继承父字段段（前面 294-310 已设 off/nfld，不覆盖）
    if cls_parent[si] < 0 {
        cls_fldoff[si] = len(fld_names)
        cls_nfld[si] = 0
    }
    // 统一 push 自身字段（重名检查覆盖继承字段 + 已 push 的自身字段）
    var kk: i64 = 0
    while kk < nf {
        var fnid = f_ids[kk]
        var d: i64 = 0
        var dup: bool = false
        while d < cls_nfld[si] {
            if fld_names[cls_fldoff[si] + d] == fnid {
                dup = true
                break
            }
            d = d + 1
        }
        if dup {
            var f2 = sstate.child(snode, soff + kk)
            sm_err_line = s_lines[f2]
            sm_err_col = s_cols[f2]
            sm_err_msg = "字段 '" + nm + "." + sstate.name_str(f2) + "' 与继承链中的字段重名（字段名必须跨继承链唯一）"
            return -1
        }
        table_push(fld_names, fnid)
        table_push(fld_tys, f_tys[kk])
        table_push(fld_defs, f_defs[kk])
        cls_nfld[si] = cls_nfld[si] + 1
        kk = kk + 1
    }
    return 0
}

// 全部 struct 字段收集（check 前调用）
pub func collect_all_struct_fields() -> i64 {
    var n = len(st_keys)
    var i: i64 = 0
    while i < n {
        var si = st_vals[i]
        var r = collect_struct_fields(si)
        if r < 0 {
            return -1
        }
        i = i + 1
    }
    return 0
}

// 返回表达式元素类型（表字面量/构造调用/变量）
pub func scan_return_elem(e: i64) -> i64 {
    var tag = s_tags[e]
    if tag == S_N_CALL {
        var nm = sstate.name_str(e)
        if nm == "table_new_i64" {
            return types.named(TK_I64)
        }
        if nm == "table_new_f64" {
            return types.named(TK_F64)
        }
        if nm == "table_new_string" {
            return types.named(TK_STR)
        }
        if nm == "table_new_bool" {
            return types.named(TK_BOOL)
        }
        // 已登记返回表的函数调用（裸名经 resolve_call_name 补全 using/命名空间前缀）
        var fnm = sinfer.resolve_call_name(nm)
        return sinfer.table_ret_elem(fnm)
    }
    if tag == S_N_TABLE_LIT {
        var nc = sstate.nchild(e)
        if nc == 0 {
            return types.named(TK_I64)
        }
        // 表字面量：取首元素值推断
        return scan_return_elem(sstate.child(sstate.child(e, 0), 1))
    }
    if tag == S_N_VAR {
        var nm = sstate.name_str(e)
        // 查本函数体内同名 var 声明的初始化
        var nparams = s_aux[g_cur_scan_fn]
        // 函数体：children[slot_off + 1 + nparams]
        return scan_blk(sstate.child(g_cur_scan_fn, sstate.slot_off(g_cur_scan_fn) + 1 + nparams), nm)
    }
    return -1
}

// 遍历语句块：want 为空 → 找 return 表达式推断元素类型；否则找同名 var 声明
pub func scan_blk(blk: i64, want: string) -> i64 {
    var n = sstate.nchild(blk)
    var i: i64 = 0
    while i < n {
        var s = sstate.child(blk, i)
        var tag = s_tags[s]
        if want == "" {
            if tag == S_N_RETURN {
                var v = sstate.child(s, 0)
                if v >= 0 {
                    var e = scan_return_elem(v)
                    if e >= 0 {
                        return e
                    }
                }
            }
        } else {
            if tag == S_N_VAR_DECL {
                if sstate.name_str(s) == want {
                    var init = sstate.child(s, 1)
                    if init >= 0 {
                        var e = scan_return_elem(init)
                        if e >= 0 {
                            return e
                        }
                    }
                }
            }
        }
        // 递归子块：if/while/for/switch
        var r: i64 = -1
        if tag == S_N_IF {
            r = scan_blk(sstate.child(s, 1), want)
            if r >= 0 {
                return r
            }
            var el = sstate.child(s, 2)
            if el >= 0 {
                r = scan_blk(el, want)
                if r >= 0 {
                    return r
                }
            }
        } else if tag == S_N_WHILE {
            r = scan_blk(sstate.child(s, 1), want)
            if r >= 0 {
                return r
            }
        } else if tag == S_N_FOR {
            r = scan_blk(sstate.child(s, 1), want)
            if r >= 0 {
                return r
            }
        } else if tag == S_N_SWITCH {
            var ncases = s_aux[s]
            var k: i64 = 0
            while k < ncases {
                var c = sstate.child(s, 1 + k)
                r = scan_blk(sstate.child(c, 2), want)
                if r >= 0 {
                    return r
                }
                k = k + 1
            }
            var dflt = sstate.child(s, 1 + ncases)
            if dflt >= 0 {
                r = scan_blk(dflt, want)
                if r >= 0 {
                    return r
                }
            }
        }
        i = i + 1
    }
    return -1
}

// 全部返回表函数预扫描（check 前调用）
pub func collect_all_return_tables() -> i64 {
    var n = len(fn_keys)
    var i: i64 = 0
    while i < n {
        var fname = intern.lookup(fn_keys[i])
        var sig = sstate.fn_sig(fname)
        if sig >= 0 {
            if sg_ret[sig] == TK_TABLE {
                var fn_node = find_fn_node(fname)
                if fn_node >= 0 {
                    g_cur_scan_fn = fn_node
                    var nparams = s_aux[fn_node]
                    // 函数体：children[slot_off + 1 + nparams]
                    var e = scan_blk(sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + nparams), "")
                    if e >= 0 {
                        if sstate.bs_find(tre_keys, fn_keys[i]) < 0 {
                            sstate.sorted_insert(tre_keys, tre_vals, fn_keys[i], e)
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return 0
}

// 命名空间递归收集（全名路径段压栈 + 递归）
pub func collect_ns(ns_node: i64) -> i64 {
    var nsegs = s_aux[ns_node]
    var body: i64 = -1
    var i: i64 = 0
    while i < nsegs {
        var seg = sstate.child(ns_node, i)
        sstate.ns_push(s_names[seg])
        i = i + 1
    }
    body = sstate.child(ns_node, nsegs)
    // 命名空间内：函数/嵌套命名空间/struct
    var nb = sstate.nchild(body)
    var j: i64 = 0
    while j < nb {
        var s = sstate.child(body, j)
        var tag = s_tags[s]
        if tag == S_N_FN_DEF {
            var full = sstate.ns_full_name(sstate.name_str(s))
            var r = collect_fn(s, full)
            if r < 0 {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                return -1
            }
        } else if tag == S_N_NAMESPACE {
            var r = collect_ns(s)
            if r < 0 {
                return -1
            }
        } else if tag == S_N_STRUCT {
            // 泛型 struct 模板 / 普通 struct 统一分派登记
            var rd = collect_struct_decl(s)
            if rd < 0 {
                return -1
            }
        }
        j = j + 1
    }
    // 弹栈
    i = 0
    while i < nsegs {
        sstate.ns_pop()
        i = i + 1
    }
    return 0
}

// 顶层全局变量收集
pub func collect_global_var(v: i64) -> i64 {
    var nm = sstate.name_str(v)
    var is_const = s_vals[v]
    var ty_node = sstate.child(v, 0)
    var init = sstate.child(v, 1)
    // 必须显式标注类型
    if ty_node < 0 {
        sm_err_line = s_lines[v]
        sm_err_col = s_cols[v]
        sm_err_msg = "全局变量 '" + nm + "' 必须显式标注类型（如 var x: i64）"
        return -1
    }
    var ty = sgen.parse_generic_type_node(ty_node)
    if ty < 0 {
        return -1
    }
    var nid = intern.intern(nm)
    if sstate.bs_find(gb_keys, nid) >= 0 {
        sm_err_line = s_lines[v]
        sm_err_col = s_cols[v]
        sm_err_msg = "全局变量 '" + nm + "' 重复定义"
        return -1
    }
    if sstate.bs_find(fn_keys, nid) >= 0 {
        sm_err_line = s_lines[v]
        sm_err_col = s_cols[v]
        sm_err_msg = "全局变量 '" + nm + "' 与函数名冲突"
        return -1
    }
    var k = types.kind(ty)
    if k == K_TABLE || k == K_MAP || ty == TK_TABLE || ty == TK_MAP {
        // 表全局：const 支持（内容修改如 table_push 允许，整变量重绑定由
        // scheck 的 gb_const_of 拦截）；初始化必须空表
        // 初始化若非空表字面量（对齐 Rust：元素类型可由标注推导，非空表
        // 的静态布局与调用点克隆不一致）——拦截
        if init >= 0 {
            var itag = s_tags[init]
            var init_ok: bool = false
            if itag == S_N_TABLE_LIT {
                if sstate.nchild(init) == 0 {
                    init_ok = true
                }
            }
            if !init_ok {
                sm_err_line = s_lines[v]
                sm_err_col = s_cols[v]
                sm_err_msg = "全局表 '" + nm + "' 的初始化必须是空表 []（元素类型由标注决定）"
                return -1
            }
        }
        var elem: i64 = -1
        if ty == TK_TABLE {
            elem = types.named(TK_STR)
        } else if k == K_TABLE {
            elem = types.table_elem(ty)
        } else {
            elem = types.named(TK_STR)
        }
        sstate.sorted_insert_gb(gb_keys, gb_vals, gb_const, gb_telem, nid, ty, is_const, elem)
        return 0
    }
    // 标量全局：字面量初始化 + 类型匹配
    if init >= 0 {
        var it = sinfer.infer_expr(init)
        if it < 0 {
            return -1
        }
        if !stype.types_match(ty, it, init) {
            sm_err_line = s_lines[v]
            sm_err_col = s_cols[v]
            sm_err_msg = "全局变量 '" + nm + "' 初始化类型不匹配：期望 " + types.type_name(ty) + "，实际 " + types.type_name(it)
            return -1
        }
    }
    sstate.sorted_insert_gb(gb_keys, gb_vals, gb_const, gb_telem, nid, ty, is_const, -1)
    return 0
}

// 收集全部顶层语句（第一子遍）：遍历 g_extra_tops（semantic 主入口
// import 展开后填充：主文件顶层 + 全部被导入文件顶层）。
// 返回 0 成功 / -1 错误
pub func collect_top() -> i64 {
    var n = len(g_extra_tops)
    var i: i64 = 0
    while i < n {
        var s = g_extra_tops[i]
        var tag = s_tags[s]
        if tag == S_N_FN_DEF {
            var full = sstate.name_str(s)
            var r = collect_fn(s, full)
            if r < 0 {
                return -1
            }
        } else if tag == S_N_NAMESPACE {
            var r = collect_ns(s)
            if r < 0 {
                return -1
            }
        } else if tag == S_N_STRUCT {
            // 泛型 struct 模板 / 普通 struct 统一分派登记
            var rd = collect_struct_decl(s)
            if rd < 0 {
                return -1
            }
        } else if tag == S_N_VAR_DECL {
            var r = collect_global_var(s)
            if r < 0 {
                return -1
            }
        } else if tag == S_N_EXTERN {
            var full = sstate.name_str(s)
            var nparams = s_aux[s]
            // extern 与已有函数重复定义（对齐 Rust：extern 专用消息）
            if sstate.fn_sig(full) >= 0 {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "extern 函数 '" + full + "' 与已有函数重复定义"
                return -1
            }
            var ret_ty = sgen.parse_generic_type_node(sstate.child(s, 0))
            if ret_ty < 0 {
                return -1
            }
            // extern 返回类型必须是标量（i8..u64/f32/f64/bool/char/string）或 void
            var ret_ok: bool = false
            if types.kind(ret_ty) == K_NAMED {
                if ret_ty == TK_VOID || is_scalar_t(ret_ty) {
                    ret_ok = true
                }
            }
            if !ret_ok {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "extern 函数 '" + full + "' 的返回类型必须是标量（i8..u64/f32/f64/bool/char/string）或 void，实际是 " + types.type_name(ret_ty)
                return -1
            }
            var p_tys: table<i64> = table_new_i64()
            var p_refs: table<i64> = table_new_i64()
            var p_defs: table<i64> = table_new_i64()
            var p_vars: table<i64> = table_new_i64()
            var k: i64 = 0
            while k < nparams {
                var p = sstate.child(s, 1 + k)
                var pt = sgen.parse_generic_type_node(sstate.child(p, 0))
                if pt < 0 {
                    return -1
                }
                // extern 参数必须是标量（对齐 Rust is_scalar_extern_ty）
                if !is_scalar_t(pt) {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "extern 函数 '" + full + "' 的参数 '" + sstate.name_str(p) + "' 必须是标量类型（i8..u64/f32/f64/bool/char/string），实际是 " + types.type_name(pt)
                    return -1
                }
                table_push(p_tys, pt)
                table_push(p_refs, 0)
                table_push(p_defs, 0)
                table_push(p_vars, 0)
                k = k + 1
            }
            if sstate.reg_fn(full, 1, nparams, nparams, ret_ty, p_tys, p_refs, p_defs, p_vars) < 0 {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                return -1
            }
            // extern 名集合（语义登记）
            sstate.sorted_insert(ext_keys, ext_keys, intern.intern(full), 0)
        } else if tag == S_N_IMPORT {
            // import 展开在 semantic 主入口处理（读文件 + 递归）
        } else if tag == S_N_USING {
            // 收集 using 引入的命名空间段（裸调用补全候选）
            var nsegs = s_aux[s]
            var k2: i64 = 0
            while k2 < nsegs {
                var seg = sstate.child(s, k2)
                table_push(using_prefixes, s_names[seg])
                k2 = k2 + 1
            }
            table_push(using_lens, nsegs)
        }
        i = i + 1
    }
    return 0
}

// 查找函数定义节点（顶层 + 命名空间递归）
// 顶层遍历 g_extra_tops（import 展开后的全部文件顶层）；namespace 内递归。
pub func find_fn_node(full: string) -> i64 {
    var n = len(g_extra_tops)
    var i: i64 = 0
    while i < n {
        var s = g_extra_tops[i]
        var tag = s_tags[s]
        if tag == S_N_FN_DEF {
            if sstate.ns_full_name(sstate.name_str(s)) == full {
                return s
            }
        } else if tag == S_N_NAMESPACE {
            var nsegs = s_aux[s]
            var j: i64 = 0
            while j < nsegs {
                var seg = sstate.child(s, j)
                sstate.ns_push(s_names[seg])
                j = j + 1
            }
            var body = sstate.child(s, nsegs)
            var found = find_fn_in_ns(body, full)
            j = 0
            while j < nsegs {
                ns_top = ns_top - 1
                j = j + 1
            }
            if found >= 0 {
                return found
            }
        }
        i = i + 1
    }
    return -1
}

// 命名空间体内递归查找函数节点（含嵌套 namespace）
func find_fn_in_ns(blk: i64, full: string) -> i64 {
    var n = sstate.nchild(blk)
    var i: i64 = 0
    while i < n {
        var s = sstate.child(blk, i)
        var tag = s_tags[s]
        if tag == S_N_FN_DEF {
            if sstate.ns_full_name(sstate.name_str(s)) == full {
                return s
            }
        } else if tag == S_N_NAMESPACE {
            var nsegs = s_aux[s]
            var j: i64 = 0
            while j < nsegs {
                var seg = sstate.child(s, j)
                sstate.ns_push(s_names[seg])
                j = j + 1
            }
            var body = sstate.child(s, nsegs)
            var found = find_fn_in_ns(body, full)
            j = 0
            while j < nsegs {
                ns_top = ns_top - 1
                j = j + 1
            }
            if found >= 0 {
                return found
            }
        }
        i = i + 1
    }
    return -1
}

}
