type tie<class>
// compiler/frontend/scollect.tie —— T2.6 顶层收集子遍（模块拆分）
// ============================================================
// 里程碑：自举 v2 计划 T2.6（.omo/plans/self-hosting-v2.md）完整语义分析
// 拆分为 8 模块之一（本文件 = 顶层收集：函数/命名空间/struct/全局变量/
// extern 登记 + struct 字段拍平 + 返回表预扫描 + 命名空间全名补全）。
// 对应 proto/semantic.tie 862-872（tre_bi_init）+ 873-957（collect_top）
// + 960-1058（find_struct_node/collect_struct_fields/collect_all_struct_fields）
// + 1066-1207（scan_return_elem/scan_blk/collect_all_return_tables）
// + 1208-1247（collect_fn）+ 1266-1336（collect_ns/ns_full_name）
// + 1339-1407（collect_global_var）逻辑搬移。
// 依赖：./sstate.tie（AST 全局 + 符号表 + 工具）+ ./sinfer.tie（表达式推断
// + resolve_call_name + table_ret_elem）+ ./scollect_port.tie（同 namespace
// scollect 跨文件拆分：S2.4 port/impl 及其余分区，本文件 import 文本内联并入）。
// 树式无环：由 scheck.tie import。
import "./sinfer.tie"
import "./scollect_port.tie"

// S2.4：impl 块暂存队列（N_IMPL 节点 id）。collect_top 遇到 N_IMPL 时只登记
// 队列（struct 声明可能在其后，须等全部 struct 登记完再解析）；
// collect_top 之后由 semantic 主流程调用 collect_impl_fns() 统一处理：
// 方法节点改名 <struct 名>::<方法名> → g_extra_tops → collect_fn → reg_impl。
// 注：tie 全局变量必须放文件顶层（namespace 外）。
var g_impl_pending: table<i64>;

namespace scollect {

// 内置函数返回表预登记（语言底座）
pub func tre_bi_init() {
    tre_bi_keys = table_new_i64()
    tre_bi_vals = table_new_i64()
    sstate.sorted_insert(tre_bi_keys, tre_bi_vals, intern.intern("list_dir"), types.named(TK_STR))
    sstate.sorted_insert(tre_bi_keys, tre_bi_vals, intern.intern("walk_dir"), types.named(TK_STR))
    sstate.sorted_insert(tre_bi_keys, tre_bi_vals, intern.intern("byte_read"), types.named(TK_I64))
    sstate.sorted_insert(tre_bi_keys, tre_bi_vals, intern.intern("byte_concat"), types.named(TK_I64))
    sstate.sorted_insert(tre_bi_keys, tre_bi_vals, intern.intern("regex_find_all"), types.named(TK_STR))
}

// extern 返回类型标量判定（对齐 Rust is_scalar_extern_ty：i8..u64/f32/f64/bool/char/string）
func is_scalar_t(t: i64) -> bool {
    if types.kind(t) != K_NAMED {
        return false
    }
    // Named 且 TyKw 在标量集（0-10, 12-13；排除 trit=11, void=14+）
    if t >= 0 && t <= 10 {
        return true
    }
    if t == TK_CHAR || t == TK_STR {
        return true
    }
    return false
}

// 顶层函数签名收集（含参数/返回类型解析 + 默认值/ref 校验）
pub func collect_fn(fn_node: i64, full: string) -> i64 {
    // 泛型模板登记分派（2026-08-14 泛型语法）：children[0] == N_TYPE_PARAMS
    // 时按模板登记（sstate.reg_generic → gt_* 表），**不**按普通函数收集——
    // 否则模板参数类型（TypeVar 名如 "T"）经 stype.parse_type_node 会报
    // "类 'T' 未定义"。单态化展开语义由 T3b 负责，本任务只保证泛型声明
    // 本身不使语义崩溃 + 模板结构就位。
    if sstate.nchild(fn_node) > 0 {
        var slot0 = sstate.child(fn_node, 0)
        if slot0 >= 0 {
            if s_tags[slot0] == S_N_TYPE_PARAMS {
                var gret = sstate.reg_generic(full, fn_node, 0)
                if gret < 0 {
                    return -1
                }
                return 0
            }
        }
    }
    var nparams = s_aux[fn_node]
    var is_pub = s_vals[fn_node]
    // S1.2：函数 unsafe 标志（val bit1）。参数/返回含指针类型的函数必须是
    // unsafe fn（安全函数不能触碰指针）。
    var is_unsafe = (is_pub >> 1) & 1
    // 返回类型：FnDef children[slot_off]（新布局 children[0]=泛型槽→偏移 1；
    // 旧布局无槽→children[0]=返回类型。slot_off 统一判定保证自举双兼容）
    var rt_node = sstate.child(fn_node, sstate.slot_off(fn_node))
    var ret_ty = sgen.parse_generic_type_node(rt_node)
    if ret_ty < 0 {
        return -1
    }
    if types.is_unsafe_ty(ret_ty) && is_unsafe == 0 {
        sm_err_line = s_lines[fn_node]
        sm_err_col = s_cols[fn_node]
        sm_err_msg = "返回指针/切片/原子类型 '" + types.type_name(ret_ty) + "' 的函数必须标注 unsafe（`unsafe fn`）"
        return -1
    }
    var p_tys: table<i64> = table_new_i64()
    var p_refs: table<i64> = table_new_i64()
    var p_defs: table<i64> = table_new_i64()
    var p_vars: table<i64> = table_new_i64()
    var required: i64 = nparams
    // 变参函数：必选数初值扣掉变参本身（调用方可传 0 个额外实参；
    // 下方循环对变参跳过时保留该初值——如 `sum(rest: ...i64)` 需 0）
    if nparams > 0 {
        var lastp = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + (nparams - 1))
        if s_aux[lastp] == 1 {
            required = nparams - 1
        }
    }
    // 默认值校验：ref 不能带默认值 + 可选参数必须连续 + 默认值必须字面量 + 类型匹配
    var seen_default: bool = false
    var k: i64 = 0
    while k < nparams {
        // 第 k 个参数：children[slot_off + 1 + k]
        var p = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + k)
        var pt = sgen.parse_generic_type_node(sstate.child(p, 0))
        if pt < 0 {
            return -1
        }
        // S1.2：安全函数参数不能是指针/切片/原子类型
        if types.is_unsafe_ty(pt) && is_unsafe == 0 {
            sm_err_line = s_lines[p]
            sm_err_col = s_cols[p]
            sm_err_msg = "参数 '" + sstate.name_str(p) + "' 的指针/切片/原子类型 '" + types.type_name(pt) + "' 只能在 unsafe 函数中使用"
            return -1
        }
        var is_ref = s_vals[p]
        var is_var = s_aux[p]   // 变参标志（`name: ...T`，parser 写入 aux）
        var has_def: i64 = 0
        var def_node: i64 = -1
        if sstate.nchild(p) > 1 {
            def_node = sstate.child(p, 1)
            if def_node >= 0 {
                has_def = 1
            }
        }
        // 变参（`...T`）：必须最后一个、无 ref、无默认值、元素类型限标量
        if is_var == 1 {
            if k != nparams - 1 {
                sm_err_line = s_lines[p]
                sm_err_col = s_cols[p]
                sm_err_msg = "变参参数 '" + sstate.name_str(p) + "' 必须是最后一个参数"
                return -1
            }
            if is_ref == 1 {
                sm_err_line = s_lines[p]
                sm_err_col = s_cols[p]
                sm_err_msg = "变参参数 '" + sstate.name_str(p) + "' 不能同时使用 ref 修饰"
                return -1
            }
            if has_def == 1 {
                sm_err_line = s_lines[p]
                sm_err_col = s_cols[p]
                sm_err_msg = "变参参数 '" + sstate.name_str(p) + "' 不能有默认值"
                return -1
            }
            // 元素类型限标量（i8..u64/f32/f64/bool/char/string；对齐 extern 标量集）
            if !is_scalar_t(pt) {
                sm_err_line = s_lines[p]
                sm_err_col = s_cols[p]
                sm_err_msg = "变参参数 '" + sstate.name_str(p) + "' 元素类型必须是标量（i8..u64/f32/f64/bool/char/string），实际是 " + types.type_name(pt)
                return -1
            }
            // 变参在函数体/调用点表现为 table<T>（签名登记表类型）
            pt = types.table_of(pt)
        }
        // ref 参数不能有默认值（对齐 Rust：必须在调用点传实参）
        if is_ref == 1 && has_def == 1 {
            sm_err_line = s_lines[p]
            sm_err_col = s_cols[p]
            sm_err_msg = "参数 '" + sstate.name_str(p) + "' 的 ref 参数不能有默认值（必须在调用点传实参）"
            return -1
        }
        // ref 形参仅支持表参数（对齐 Rust：标量/字符串/struct 形参引用无实义）
        if is_ref == 1 && !types.is_table(pt) {
            sm_err_line = s_lines[p]
            sm_err_col = s_cols[p]
            sm_err_msg = "参数 '" + sstate.name_str(p) + "' 的 ref 修饰仅支持表参数（table/table<T>），实际是 " + types.type_name(pt)
            return -1
        }
        // 可选参数（带默认值）必须连续排在必选参数之后
        // （变参不参与该约束——它恒居末位，前面允许可选参数）
        if has_def == 1 {
            seen_default = true
        } else if seen_default && is_var == 0 {
            sm_err_line = s_lines[p]
            sm_err_col = s_cols[p]
            sm_err_msg = "参数 '" + sstate.name_str(p) + "' 缺少默认值：可选参数（带默认值）必须连续排在必选参数之后"
            return -1
        }
        // 默认值必须是字面量（数/布尔/字符/字符串或空表 []）
        if has_def == 1 {
            var dt = def_node
            var dtag = s_tags[dt]
            var is_ok: bool = false
            if dtag == S_N_INT_LIT || dtag == S_N_FLOAT_LIT || dtag == S_N_BOOL_LIT || dtag == S_N_CHAR_LIT || dtag == S_N_STR_LIT {
                is_ok = true
            } else if dtag == S_N_TABLE_LIT {
                if sstate.nchild(dt) == 0 {
                    is_ok = true
                }
            }
            if !is_ok {
                sm_err_line = s_lines[p]
                sm_err_col = s_cols[p]
                sm_err_msg = "参数 '" + sstate.name_str(p) + "' 的默认值必须是字面量（数/布尔/字符/字符串或空表 []）"
                return -1
            }
            // 默认值类型匹配：默认值推导类型必须与参数类型兼容
            // 空表字面量 [] 默认值：直接通过（对齐 Rust：空表 → 任意表类型）
            var dt_ty = sinfer.infer_expr(dt)
            if dt_ty < 0 {
                return -1
            }
            var is_empty_tbl: bool = false
            if dtag == S_N_TABLE_LIT {
                if sstate.nchild(dt) == 0 {
                    is_empty_tbl = true
                }
            }
            if !is_empty_tbl {
                if !stype.types_match(pt, dt_ty, dt) {
                    sm_err_line = s_lines[p]
                    sm_err_col = s_cols[p]
                    sm_err_msg = "参数 '" + sstate.name_str(p) + "' 默认值类型不匹配：期望 " + types.type_name(pt) + "，实际 " + types.type_name(dt_ty)
                    return -1
                }
            }
        }
        table_push(p_tys, pt)
        table_push(p_refs, is_ref)
        table_push(p_defs, has_def)
        table_push(p_vars, is_var)
        // 必选数：变参本身不计数（调用方可传 0 个额外实参）
        if has_def == 0 && is_var == 0 {
            required = k + 1
        }
        k = k + 1
    }
    // M2.1.8：namespace <struct 名> 内的函数，首参 == 该 struct 类型 → 首参
    // **自动按引用传递**（对齐 Rust ir.rs：param_by_ref[0]，字段修改反映到调用方）。
    // `pub func inc(c: Counter)` 在 namespace Counter 内：c 首参标 ref，
    // c.inc() 转发时传 c 的槽地址，inc 内 c.count 修改写回调用方。
    if nparams > 0 {
        var last2 = sstate.rfind_ns(full)
        if last2 >= 0 {
            var ns_name = ig_slice2(full, 0, last2)
            var snid = intern.intern(ns_name)
            var sidx2 = sstate.bs_find(st_keys, snid)
            if sidx2 >= 0 {
                var si2 = st_vals[sidx2]
                if p_tys[0] == types.struct_of(si2) {
                    p_refs[0] = 1  // 首参按引用（接收者）
                }
            }
        }
    }
    if sstate.reg_fn(full, is_pub, nparams, required, ret_ty, p_tys, p_refs, p_defs, p_vars, fn_node) < 0 {
        sm_err_line = s_lines[fn_node]
        sm_err_col = s_cols[fn_node]
        return -1
    }
    return 0
}

// 字符串切片（scollect 本地辅助；对齐 irgen.ig_slice）
// 性能重写（O(n)）：字节定位 + StringBuilder 拷贝（旧逐字符拼接 O(n²)）
func ig_slice2(s: string, start: i64, end: i64) -> string {
    var n: i64 = str_len(s)
    if start < 0 {
        start = 0
    }
    if end > n {
        end = n
    }
    if start >= end {
        return ""
    }
    var b: i64 = 0
    var i: i64 = 0
    var bstart: i64 = 0
    while i < end {
        if i == start {
            bstart = b
        }
        b = b + utf8_seq_len(s, b)
        i = i + 1
    }
    var sb = string_builder()
    var k: i64 = bstart
    while k < b {
        sb_append_byte(sb, str_byte(s, k))
        k = k + 1
    }
    return sb_build(sb)
}

// 顶层 struct 声明登记分派（泛型语法 2026-08-14）：
// children[0] == N_TYPE_PARAMS → 泛型 struct 模板登记（sstate.reg_generic →
// gt_* 表，跳过普通 struct 收集——模板字段的 TypeVar 类型无法静态解析，
// collect_struct_fields 会因"类 'T' 未定义"崩溃）；否则普通 reg_struct。
// 返回 0 成功 / -1 错误（sm_err_* 已置）。
func collect_struct_decl(s: i64) -> i64 {
    var nm = sstate.name_str(s)
    if sstate.nchild(s) > 0 {
        var slot0 = sstate.child(s, 0)
        if slot0 >= 0 {
            if s_tags[slot0] == S_N_TYPE_PARAMS {
                var gret = sstate.reg_generic(nm, s, 1)
                if gret < 0 {
                    return -1
                }
                return 0
            }
        }
    }
    var parent = ""
    var p = s_aux[s]
    if p >= 0 {
        parent = intern.lookup(p)
    }
    // struct 与函数名冲突（对齐 Rust check_struct_namespace：struct 名不能与
    // 同命名空间函数同名——构造调用 vs 函数调用的歧义）
    var snid = intern.intern(nm)
    if sstate.bs_find(fn_keys, snid) >= 0 {
        sm_err_line = s_lines[s]
        sm_err_col = s_cols[s]
        sm_err_msg = "struct 名 '" + nm + "' 与函数名冲突"
        return -1
    }
    var idx = sstate.reg_struct(nm, parent)
    if idx < 0 {
        sm_err_line = s_lines[s]
        sm_err_col = s_cols[s]
        return -1
    }
    // struct 名登记（types.type_name / 泛型 mangling 片段还原用；追加式与
    // reg_struct 索引顺序一致——实例化 struct 由 sgen.instantiate_struct 同步登记）
    types.set_struct_name(idx, nm)
    return 0
}

// 查找顶层 struct 定义节点（按名字）
pub func find_struct_node(name: string) -> i64 {
    // import 展开后 struct 可能在 g_extra_tops（全部文件顶层，与 find_fn_node 一致）
    var n = len(g_extra_tops)
    var i: i64 = 0
    while i < n {
        var s = g_extra_tops[i]
        if s_tags[s] == S_N_STRUCT {
            if sstate.name_str(s) == name {
                return s
            }
        }
        i = i + 1
    }
    return -1
}

}