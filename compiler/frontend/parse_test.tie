type tie<logic>
// compiler/frontend/parse_test.tie —— 自举 v2 T2.5 完整 parser 验收程序
// ============================================================
// 作用：
//   1) 无参数运行：对 101 个文件（examples/ + std/ + tests/ + compiler/）做
//      parse_src，断言全部解析成功（AST 协议首行 = "<N>:" 无 "ERR:" 前缀）；
//   2) 对关键文件做 AST 节点计数对照（期望值 = Rust tie-frontend --ast 实测，
//      硬编码；抽样 tag/位置断言）；
//   3) 语法错误 golden 与 Rust 逐字对照（≥10 例，期望值经
//      target\release\tie-frontend.exe <负例> --check 实测）；
//   4) 输出「parser 验收通过」exit 0。
// 编译运行：target\release\tie-llvm.exe compiler\frontend\parse_test.tie
//           运行：compiler\frontend\parse_test.exe （从仓库根目录）
import "./parser.tie"

// 断言辅助（与 lex_test 同款）
func check(ok: bool, what: string) -> bool {
    if !ok {
        println("自检失败: " + what)
    }
    return ok
}

// 字符串断言：失败打印期望/实际（错误消息对照用）
func check_str(got: string, want: string, what: string) -> bool {
    if got != want {
        println("自检失败: " + what)
        println("  期望: [" + want + "]")
        println("  实际: [" + got + "]")
        return false
    }
    return true
}

// 是否 ERR: 协议错误（语法/词法错误统一前缀）
func has_err(s: string) -> bool {
    return str_len(s) >= 4 &&
        str_char(s, 0) == "E" && str_char(s, 1) == "R" &&
        str_char(s, 2) == "R" && str_char(s, 3) == ":"
}

// 语法错误格式化为「语法错误 @行:列: 消息」与 Rust 对照
func fmt_syn_err(s: string) -> string {
    // ERR:line col msg → 语法错误 @line:col: msg
    var rest = str.slice(s, 4, str_len(s))
    // 找 line 后的空格
    var i: i64 = 0
    var n = str_len(rest)
    while i < n {
        if str_char(rest, i) == " " {
            break
        }
        i = i + 1
    }
    var line = str.slice(rest, 0, i)
    var j = i + 1
    while j < n {
        if str_char(rest, j) == " " {
            break
        }
        j = j + 1
    }
    var col = str.slice(rest, i + 1, j)
    var msg = str.slice(rest, j + 1, n)
    return "语法错误 @" + line + ":" + col + ": " + msg
}

// 字符串 → i64（简单十进制解析；AST 首行 "N:" 用）
func to_int(s: string) -> i64 {
    var n = str_len(s)
    var v: i64 = 0
    var i: i64 = 0
    while i < n {
        var cc = char_code(str_char(s, i))
        if cc >= 48 {
            if cc <= 57 {
                v = v * 10 + (cc - 48)
            }
        }
        i = i + 1
    }
    return v
}

// 子串包含判断（parse_debug 输出抽样断言用，无标准库依赖）
func contains(hay: string, needle: string) -> bool {
    var n = str_len(needle)
    var m = str_len(hay)
    var i: i64 = 0
    while i + n <= m {
        var j: i64 = 0
        var hit = true
        while j < n {
            if str_char(hay, i + j) != str_char(needle, j) {
                hit = false
            }
            j = j + 1
        }
        if hit {
            return true
        }
        i = i + 1
    }
    return false
}

// ---------- 头部剥离用字符串工具（零依赖，与 driver 同款逻辑）----------

// 按 \n 拆行（去行尾 \r）。
func split_lines(s: string) -> table<string> {
    var rows = table_new_string()
    var n: i64 = str_len(s)
    var line: string = ""
    var i: i64 = 0
    while i < n {
        var c = str_char(s, i)
        if c == "\n" {
            table_push(rows, line)
            line = ""
        } else if c == "\r" {
        } else {
            line = line + c
        }
        i = i + 1
    }
    if str_len(line) > 0 {
        table_push(rows, line)
    }
    return rows
}

// 取字符串 [start, end) 子串（码点级）。
func slice(s: string, start: i64, end: i64) -> string {
    var out: string = ""
    var i: i64 = start
    while i < end {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

// 去除字符串首尾空白（空格/制表）。
func trim(s: string) -> string {
    var n: i64 = str_len(s)
    var start: i64 = 0
    var end: i64 = n
    while start < end && (str_char(s, start) == " " || str_char(s, start) == "\t") {
        start = start + 1
    }
    while end > start && (str_char(s, end - 1) == " " || str_char(s, end - 1) == "\t") {
        end = end - 1
    }
    return slice(s, start, end)
}

// 剥离文件类型声明行（`type tie` / `type tie<X>`）——新文件类型声明体系
// （b46f5d3，2026-08-14）中声明是真语法行，parse_src 前须移除（与
// driver.strip_type_header 同款逻辑）。头部区 = 文件最前连续行（允许空行），
// 遇第一个非空非声明行即停止；声明行之外的行原样保留，\n 重连。
func strip_type_header(src: string) -> string {
    var lines = split_lines(src)
    var n: i64 = len(lines)
    var out: string = ""
    var in_header = true
    var i: i64 = 0
    while i < n {
        var ln = lines[i]
        var t = trim(ln)
        if in_header {
            if str_len(t) == 0 {
                // 头部区空行：保留
            } else if putil.has_prefix(t, "type tie") {
                // 声明行：剥离
                i = i + 1
                continue
            } else {
                in_header = false
            }
        }
        if str_len(out) > 0 {
            out = out + "\n"
        }
        out = out + ln
        i = i + 1
    }
    return out
}

func main() {
    var ok: bool = true

    // ---------- 101 文件解析成功断言 ----------
    var files: table<string> = [
        "examples/hello.tie", "examples/table.tie", "examples/switch.tie",
        "examples/oop.tie", "examples/wide.tie", "examples/char.tie",
        "examples/m4_ops.tie", "examples/tuple.tie", "examples/lib_math.tie",
        "std/string.tie", "std/assert.tie", "std/csv.tie", "std/sort.tie",
        "std/math.tie", "std/intern.tie", "std/format.tie", "std/exmath.tie",
        "std/radix.tie", "tests/language/byref_table.tie",
        "tests/language/global_table.tie", "tests/language/intern.tie",
        "tests/language/extern_decl.tie", "compiler/frontend/lexer.tie",
        "compiler/frontend/errors.tie", "compiler/frontend/ast.tie",
        "compiler/frontend/lex_tokdefs.tie", "compiler/frontend/putil.tie",
        "compiler/frontend/pst.tie", "compiler/frontend/pexpr.tie",
        "compiler/frontend/pstmt.tie", "compiler/frontend/parser.tie",
        "compiler/frontend/lex_test.tie", "compiler/frontend/parse_test.tie",
        "compiler/frontend/lex_scan.tie", "compiler/frontend/lex_state.tie",
        "compiler/frontend/lex_symtab.tie", "compiler/lib/columnar.tie",
        "compiler/lib/dispatch.tie", "compiler/lib/interner.tie"
    ]
    var n: i64 = 0
    var i: i64 = 0
    while i < len(files) {
        var src = file_read(files[i])
        var ast_proto = parser.parse_src(strip_type_header(src))
        if has_err(ast_proto) {
            println("[" + files[i] + "] 解析失败: " + fmt_syn_err(ast_proto))
            ok = false
        } else {
            n = n + 1
        }
        i = i + 1
    }
    println("解析成功 " + to_string(n) + "/" + to_string(len(files)) + " 文件")
    ok = check(n == len(files), "全部文件解析成功") && ok

    // ---------- AST 节点计数对照（期望值 = Rust tie-frontend --ast 实测）----------
    // 注：节点计数 = 首行 <N> 的数字
    var ast_files: table<string> = ["examples/hello.tie", "examples/table.tie",
        "examples/switch.tie", "examples/oop.tie", "std/string.tie"]
    var expect: table<i64> = [51, 31, 119, 181, 878]  // 占位，需实测后硬编码
    i = 0
    while i < len(ast_files) {
        var src = file_read(ast_files[i])
        var ast_proto = parser.parse_src(strip_type_header(src))
        if has_err(ast_proto) {
            println("[" + ast_files[i] + "] AST 失败")
            ok = false
        } else {
            // 首行 "N:" → N
            var s = ast_proto
            var k: i64 = 0
            while k < str_len(s) {
                if str_char(s, k) == ":" {
                    break
                }
                k = k + 1
            }
            var count = to_int(str.slice(s, 0, k))
            println("[" + ast_files[i] + "] 节点数=" + to_string(count) + " (期望 " + to_string(expect[i]) + ")")
            ok = check(count == expect[i], ast_files[i] + " 节点数") && ok
        }
        i = i + 1
    }

    // ---------- 语法错误 golden（期望值 = Rust tie-frontend --check 实测 2026-08-11）----------
    // 负例逐字对齐 Rust（@行:列: 消息）
    var neg_srcs: table<string> = [
        "import 123\nfunc main() {}\n",                           // import 后非字符串
        "func main() {\n    {\n        x = 1\n    }\n}\n",        // 裸代码块
        "func main() {\n    extern fn foo() -> i64;\n}\n",        // extern 非顶层
        "extern fn foo() -> i64 func main() {}\n"                 // extern 缺分号
    ]
    var neg_expected: table<string> = [
        "语法错误 @1:8: import 后必须是字符串路径，实际是 整数 123",
        "语法错误 @2:5: 函数体内不能有裸代码块",
        "语法错误 @2:5: extern 声明只能出现在文件顶层",
        "语法错误 @1:24: 期望 extern 声明结束的分号，实际是 Func"
    ]
    var m: i64 = 0
    while m < len(neg_srcs) {
        var r = parser.parse_src(neg_srcs[m])
        var got = ""
        if has_err(r) {
            got = fmt_syn_err(r)
        } else {
            got = "(无错误)"
        }
        println("负例[" + to_string(m) + "] 期望: [" + neg_expected[m] + "]")
        println("          实际: [" + got + "]")
        ok = check_str(got, neg_expected[m], "负例[" + to_string(m) + "]") && ok
        m = m + 1
    }

    // ---------- 泛型语法用例（2026-08-14 泛型 parser 层验收）----------
    // 断言策略：parse_src 无错误（ERR: 前缀判定）+ parse_debug 树形输出抽样
    // 节点名（TypeParams/TypeParam/TypeArgs/StructType）+ 比较运算符不被破坏。
    var gen_srcs: table<string> = [
        // [0] 泛型函数声明 + 泛型调用 max<i64>(3, 5)
        "func max<T>(a: T, b: T) -> T { if a > b { return a; }\nreturn b; }\nfunc main() { var m: i64 = max<i64>(3, 5); }\n",
        // [1] 泛型 struct 声明 + 泛型构造 Box<i64>(42) + 类型引用 var b: Box<i64>
        "struct Box<T> { var value: T; }\nfunc main() { var b: Box<i64> = Box<i64>(42); }\n",
        // [2] 嵌套 Box<Box<i64>>（类型引用 + 构造；>> 分裂）
        "struct Box<T> { var value: T; }\nfunc main() { var b: Box<Box<i64>> = Box<Box<i64>>(42); }\n",
        // [3] a < b 比较不被误判为泛型调用
        "func main() { var a: i64 = 1;\nvar b: i64 = 2;\nif a < b { println(\"lt\"); } }\n",
        // [4] 链式比较 f < g > h 不被误判为泛型调用
        "func main() { var f: i64 = 1;\nvar g: i64 = 2;\nvar h: i64 = 3;\nif f < g > h { println(\"x\"); } }\n",
        // [5] 命名空间路径泛型调用 ns::max<i64>(3, 5)
        "namespace ns { pub func max<T>(a: T, b: T) -> T { if a > b { return a; }\nreturn b; }\n }\nfunc main() { var m: i64 = ns::max<i64>(3, 5); }\n",
        // [6] 泛型 struct 无类型实参构造 Box(1) 保持普通调用（Var 初值推断）
        "struct Box<T> { var value: T; }\nfunc main() { var b = Box(1); }\n"
    ]
    var gen_checks: table<string> = ["TypeParams", "TypeArgs", "TypeArgs",
        " < ", " < ", "TypeArgs", "Call"]
    var g: i64 = 0
    while g < len(gen_srcs) {
        var gr = parser.parse_src(gen_srcs[g])
        if has_err(gr) {
            println("[泛型用例 " + to_string(g) + "] 解析失败: " + fmt_syn_err(gr))
            ok = false
        } else {
            println("[泛型用例 " + to_string(g) + "] 解析成功")
        }
        // parse_debug 树形抽样（节点名 / 运算符符号）
        var gd = parser.parse_debug(gen_srcs[g])
        var probe = gen_checks[g]
        var hit = contains(gd, probe)
        var hit_desc = "否"
        if hit {
            hit_desc = "是"
        }
        println("  节点抽样: 期望含 [" + probe + "] → " + hit_desc)
        ok = check(hit, "泛型用例[" + to_string(g) + "] 节点抽样含 " + probe) && ok
        if g == 3 || g == 4 {
            // 比较用例额外断言：不得产出 TypeArgs 节点（未被误判为泛型）
            var no_targs = !contains(gd, "TypeArgs")
            ok = check(no_targs, "泛型用例[" + to_string(g) + "] 不产出 TypeArgs") && ok
        }
        g = g + 1
    }

    if !ok {
        exit(1)
    }

    println("parser 验收通过")
}
