type tie<class>
// compiler/frontend/sgen_inst.tie —— 模板实例化（展开器核心）分区
// ============================================================
// 里程碑：泛型单态化展开器（T3b）。从 sgen.tie 拆出的独立分区
// （原「模板实例化（展开器核心）」区块），沿用 sinfer→sinfer_ret 先例。
// 说明：与 sgen.tie 共用 namespace sgen 闭合并集，划分遵循同名 namespace
// 跨文件先例。子文件与被 import 文件（sgen.tie）文本内联并入同一编译单元，
// 故本文件内函数可与 sgen.tie 的主文件顶层函数裸名互相调用、访问主文件
// 顶层全局 var（如 g_inst_depth / g_extra_tops / cls_done / fld_names 等）。
// 本文件不含全局 var、不含 import（一切符号靠 sgen.tie 的 import 文本内联
// 可达：经 sstate/stype/types 等）。
namespace sgen {

// ==================== 模板实例化（展开器核心）====================

// S2.4 泛型约束校验（静态分发，port-model.md §2.3）：模板 gti 的第 k 个类型
// 参数带 port 约束（gtyp_cons 槽），实参 args[k]（K_STRUCT）必须已 impl 该
// port——违反 = 编译错误「类型 X 未实现 port Y」。TypeVar 实参（嵌套泛型，
// 如 Box<T> 里 T 未具体化）跳过——外层实例化时递归校验。约束引用的 port
// 未登记（如 `<T: NotPort>`）同样报错。返回 0 通过 / -1 报错。
pub func check_generic_constraints(gti: i64, args: table<i64>, line: i64, col: i64) -> i64 {
    var n = gtyp_nparams[gti]
    var off = gtyp_conoff[gti]
    var k: i64 = 0
    while k < n {
        var cons = gtyp_cons[off + k]
        if cons >= 0 {
            var pname = intern.lookup(cons)
            var pi = sstate.port_find(pname)
            if pi < 0 {
                sm_err_line = line
                sm_err_col = col
                sm_err_msg = "泛型约束引用的 port '" + pname + "' 未定义"
                return -1
            }
            var at = args[k]
            if types.is_typevar(at) {
                k = k + 1
                continue  // 嵌套泛型：外层实例化时校验
            }
            if !stype.impl_has_ty(pi, at) {
                sm_err_line = line
                sm_err_col = col
                sm_err_msg = "类型 '" + types.type_name(at) + "' 未实现 port '" + pname + "'（泛型约束不满足）"
                return -1
            }
        }
        k = k + 1
    }
    return 0
}

// 实例化函数模板 → 签名 id。幂等（fn_sig 已命中直接返回）。
// args：类型实参 id 表（按模板类型参数顺序，调用方已推断/显式确定）。
pub func instantiate_fn(gti: i64, args: table<i64>, line: i64, col: i64) -> i64 {
    var full = intern.lookup(gty_keys[gti])
    var mangled = mangle(full, args)
    var sig0 = sstate.fn_sig(mangled)
    if sig0 >= 0 {
        return sig0  // 已实例化（幂等）
    }
    // S2.4 泛型约束校验（静态分发）：实参化时检查 T 的实参类型 impl 约束 port
    //（漏 impl 的实参化 = 编译错误）。须在深度防御之前（校验不占递归深度）。
    if check_generic_constraints(gti, args, line, col) < 0 {
        return -1
    }
    // 递归深度防御（类型嵌套实例化链）
    g_inst_depth = g_inst_depth + 1
    if g_inst_depth > 64 {
        g_inst_depth = g_inst_depth - 1
        sm_err_line = line
        sm_err_col = col
        sm_err_msg = "泛型实例化深度超限（超过 64 层），疑似无限递归实例化：'" + full + "'"
        return -1
    }
    var node = gty_node[gti]
    var new_node = clone_subst(node, gti, args)
    if new_node < 0 {
        g_inst_depth = g_inst_depth - 1
        return -1
    }
    // 函数名 → mangled（irgen / check_fn_walk / find_fn_node / collect 按名查找）
    s_names[new_node] = intern.intern(mangled)
    // 登记签名（内联 collect_fn 简化版：TypeVar 已替换为具体类型，走现有类型系统）
    var nparams = s_aux[node]
    var is_pub = s_vals[node]
    var ret_node = sstate.child(new_node, sstate.slot_off(new_node))
    var ret_ty = stype.parse_type_node(ret_node)
    if ret_ty < 0 {
        g_inst_depth = g_inst_depth - 1
        if str_len(sm_err_msg) == 0 {
            sm_err_msg = "实例化 '" + mangled + "' 返回类型解析失败"
        }
        return -1
    }
    var p_tys: table<i64> = table_new_i64()
    var p_refs: table<i64> = table_new_i64()
    var p_defs: table<i64> = table_new_i64()
    var p_vars: table<i64> = table_new_i64()
    var required: i64 = nparams
    var seen_default: bool = false
    var k: i64 = 0
    while k < nparams {
        var p = sstate.child(new_node, sstate.slot_off(new_node) + 1 + k)
        var pt = stype.parse_type_node(sstate.child(p, 0))
        if pt < 0 {
            g_inst_depth = g_inst_depth - 1
            if str_len(sm_err_msg) == 0 {
                sm_err_msg = "实例化 '" + mangled + "' 参数 '" + sstate.name_str(p) + "' 类型解析失败"
            }
            return -1
        }
        // 变参（`...T`，parser 写入 aux）：签名存 table<T>（对齐 collect_fn）
        var is_var = s_aux[p]
        if is_var == 1 {
            pt = types.table_of(pt)
        }
        // ref 形参仅支持表（对齐 collect_fn 校验）
        if s_vals[p] == 1 && !types.is_table(pt) {
            g_inst_depth = g_inst_depth - 1
            sm_err_line = line
            sm_err_col = col
            sm_err_msg = "实例化 '" + mangled + "' 参数 '" + sstate.name_str(p) + "' 的 ref 修饰仅支持表参数，实际是 " + types.type_name(pt)
            return -1
        }
        table_push(p_tys, pt)
        table_push(p_refs, s_vals[p])
        table_push(p_vars, is_var)
        var has_def: i64 = 0
        if sstate.nchild(p) > 1 {
            if sstate.child(p, 1) >= 0 {
                has_def = 1
            }
        }
        table_push(p_defs, has_def)
        if has_def == 1 {
            seen_default = true
        } else if seen_default && is_var == 0 {
            g_inst_depth = g_inst_depth - 1
            sm_err_line = line
            sm_err_col = col
            sm_err_msg = "实例化 '" + mangled + "' 参数 '" + sstate.name_str(p) + "' 缺少默认值：可选参数（带默认值）必须连续排在必选参数之后"
            return -1
        }
        if has_def == 0 && is_var == 0 {
            required = k + 1
        }
        k = k + 1
    }
    // M2.1.8 自动 ref：命名空间前缀是（模板）struct 且首参是该 struct 类型 → 首参按引用。
    // 实例化方法（如 Box::get → Box$i64::get）前缀 "Box" 是模板 struct——首参 struct 类型 → ref。
    if nparams > 0 {
        var last2 = sstate.rfind_ns(mangled)
        if last2 >= 0 {
            var ns_name = ig_slice(mangled, 0, last2)
            var gns = sstate.gt_find(ns_name)
            var is_tmpl_s: bool = false
            if gns >= 0 && gty_is_struct[gns] == 1 {
                is_tmpl_s = true
            }
            var sidx2 = sstate.bs_find(st_keys, intern.intern(ns_name))
            if (is_tmpl_s || sidx2 >= 0) && types.kind(p_tys[0]) == K_STRUCT {
                p_refs[0] = 1
            }
        }
    }
    var sig = sstate.reg_fn(mangled, is_pub, nparams, required, ret_ty, p_tys, p_refs, p_defs, p_vars, new_node)
    if sig < 0 {
        g_inst_depth = g_inst_depth - 1
        sm_err_line = line
        sm_err_col = col
        return -1
    }
    // 追加 g_extra_tops：irgen 生成（gen_ast 遍历 g_extra_tops）+ check_fn_walk
    // 按 mangled 名找节点 + find_fn_node（返回表扫描）都依赖它
    table_push(g_extra_tops, new_node)
    // 去重记录
    sstate.gin_reg(mangled, gti, args, 0)
    // 返回裸 table：预登记返回表元素类型（tre_keys 幂等）——主流程的
    // collect_all_return_tables 在 expand_generics 后跑一轮覆盖预扫描展开的函数；
    // 检查阶段才展开的函数（infer_call 兜底）由此处即时登记
    if ret_ty == TK_TABLE {
        register_table_ret(mangled, new_node)
    }
    g_inst_depth = g_inst_depth - 1
    return sig
}

// 实例化 struct 模板 → struct 索引。幂等（st_keys 已命中直接返回）。
// 复制定义 → reg_struct → 字段拍平（无继承）→ g_extra_tops → gin 记录。
pub func instantiate_struct(gti: i64, args: table<i64>) -> i64 {
    var full = intern.lookup(gty_keys[gti])
    var mangled = mangle(full, args)
    var sidx = sstate.bs_find(st_keys, intern.intern(mangled))
    if sidx >= 0 {
        return st_vals[sidx]  // 已实例化（幂等）
    }
    // 实参个数校验
    var n_tp = gtyp_nparams[gti]
    if len(args) != n_tp {
        sm_err_line = 1
        sm_err_col = 1
        sm_err_msg = "泛型 struct '" + full + "' 需要 " + to_string(n_tp) + " 个类型参数，实际 " + to_string(len(args)) + " 个"
        return -1
    }
    // S2.4 泛型约束校验（静态分发）：struct 模板的约束实参化时同样检查
    if check_generic_constraints(gti, args, 1, 1) < 0 {
        return -1
    }
    g_inst_depth = g_inst_depth + 1
    if g_inst_depth > 64 {
        g_inst_depth = g_inst_depth - 1
        sm_err_msg = "泛型实例化深度超限（超过 64 层），疑似无限递归实例化：'" + full + "'"
        return -1
    }
    var node = gty_node[gti]
    var new_node = clone_subst(node, gti, args)
    if new_node < 0 {
        g_inst_depth = g_inst_depth - 1
        return -1
    }
    // struct 名 → mangled
    s_names[new_node] = intern.intern(mangled)
    var si = sstate.reg_struct(mangled, "")
    if si < 0 {
        g_inst_depth = g_inst_depth - 1
        sm_err_line = 1
        sm_err_col = 1
        return -1
    }
    // 字段拍平（实例化 struct 无父；cls_done 置位 → collect_all_struct_fields 跳过）
    cls_done[si] = 1
    cls_fldoff[si] = len(fld_names)
    cls_nfld[si] = 0
    var nc = sstate.nchild(new_node) - 1  // Struct children[0]=-1 槽，字段从 1 起
    var k: i64 = 0
    while k < nc {
        var f = sstate.child(new_node, 1 + k)
        var fty = stype.parse_type_node(sstate.child(f, 0))
        if fty < 0 {
            g_inst_depth = g_inst_depth - 1
            if str_len(sm_err_msg) == 0 {
                sm_err_msg = "实例化 '" + mangled + "' 字段 '" + sstate.name_str(f) + "' 类型解析失败"
            }
            return -1
        }
        var fnid = intern.intern(sstate.name_str(f))
        table_push(fld_names, fnid)
        table_push(fld_tys, fty)
        var fdef: i64 = -1
        if sstate.nchild(f) > 1 {
            fdef = sstate.child(f, 1)
        }
        table_push(fld_defs, fdef)
        cls_nfld[si] = cls_nfld[si] + 1
        k = k + 1
    }
    // struct 名登记（types.type_name 还原 / mangle 片段用）
    types.set_struct_name(si, mangled)
    // 追加 g_extra_tops（collect_all_struct_fields 遍历 st_keys 时 cls_done 跳过；
    // 保留节点便于调试；irgen 聚合类型由 st_keys + fld_* 驱动）
    table_push(g_extra_tops, new_node)
    // 去重记录
    sstate.gin_reg(mangled, gti, args, 1)
    g_inst_depth = g_inst_depth - 1
    return si
}

}