type tie<class>
// compiler/frontend/pexpr.tie —— T2.5 parser 表达式/类型解析（模块拆分）
// ============================================================
// 里程碑：自举 v2 计划 T2.5（.omo/plans/self-hosting-v2.md）完整 parser
// 拆分为 4 模块之一（本文件 = 表达式优先级链 + 一元/主表达式 + 元组/表
// 字面量 + 类型解析）。对应 proto/parser.tie 1726-2636 行逻辑搬移。
// 依赖：./pexpr_type.tie（类型解析，经其传递可达 putil token 流 + pst 状态 +
// ast 节点池 + errors/interner/string）。2026-08-14 泛型语法：调用点类型实参
// 解析（parse_type_args）由 pexpr_type 提供，故本模块 import pexpr_type。
// 树式无环：由 pstmt.tie import。
import "./pexpr_type.tie"

namespace pexpr {

// 构造二元节点（span 取左操作数起点，对齐 Rust expr_span 行为）
func mk_binary(op: i64, lhs: i64, rhs: i64) -> i64 {
    var n = ast.new_node(N_BINARY, -1, op, -1, ast.line(lhs), ast.col(lhs))
    var kids: table<i64> = table_new_i64()
    table_push(kids, lhs)
    table_push(kids, rhs)
    ast.set_children(n, kids)
    return n
}

// 构造一元节点
func mk_unary(op: i64, operand: i64, line: i64, col: i64) -> i64 {
    var n = ast.new_node(N_UNARY, -1, op, -1, line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, operand)
    ast.set_children(n, kids)
    return n
}

// 构造下标节点（span 取基址起点）
func mk_index(base: i64, index: i64) -> i64 {
    var n = ast.new_node(N_INDEX, -1, -1, -1, ast.line(base), ast.col(base))
    var kids: table<i64> = table_new_i64()
    table_push(kids, base)
    table_push(kids, index)
    ast.set_children(n, kids)
    return n
}

// ---------- 表达式优先级链（从低到高）----------

// 表达式：三目 → 可选范围 `..`
pub func parse_expr() -> i64 {
    var lhs = parse_ternary()
    if lhs < 0 {
        return -1
    }
    if putil.eat(lex_dotdot) {
        var line = ast.line(lhs)
        var col = ast.col(lhs)
        var end = parse_expr()
        if end < 0 {
            return -1
        }
        var n = ast.new_node(N_RANGE, -1, -1, -1, line, col)
        var kids: table<i64> = table_new_i64()
        table_push(kids, lhs)
        table_push(kids, end)
        ast.set_children(n, kids)
        return n
    }
    return lhs
}

// 三目运算符（右结合）：cond ? then : else
func parse_ternary() -> i64 {
    var lhs = parse_or()
    if lhs < 0 {
        return -1
    }
    if putil.eat(lex_question) {
        var line = ast.line(lhs)
        var col = ast.col(lhs)
        var then_expr = parse_expr()
        if then_expr < 0 {
            return -1
        }
        if !putil.expect(lex_colon, "':'") {
            return -1
        }
        var else_expr = parse_expr()
        if else_expr < 0 {
            return -1
        }
        var n = ast.new_node(N_TERNARY, -1, -1, -1, line, col)
        var kids: table<i64> = table_new_i64()
        table_push(kids, lhs)
        table_push(kids, then_expr)
        table_push(kids, else_expr)
        ast.set_children(n, kids)
        return n
    }
    return lhs
}

// 逻辑或 ||
func parse_or() -> i64 {
    var lhs = parse_and()
    if lhs < 0 {
        return -1
    }
    var d = false
    while !d {
        if putil.peek_tag() != lex_oror {
            d = true
        } else {
            putil.advance()
            var rhs = parse_and()
            if rhs < 0 {
                return -1
            }
            lhs = mk_binary(B_OR, lhs, rhs)
        }
    }
    return lhs
}

// 逻辑与 &&
func parse_and() -> i64 {
    var lhs = parse_bit_or()
    if lhs < 0 {
        return -1
    }
    var d = false
    while !d {
        if putil.peek_tag() != lex_andand {
            d = true
        } else {
            putil.advance()
            var rhs = parse_bit_or()
            if rhs < 0 {
                return -1
            }
            lhs = mk_binary(B_AND, lhs, rhs)
        }
    }
    return lhs
}

// 按位或 |
func parse_bit_or() -> i64 {
    var lhs = parse_bit_xor()
    if lhs < 0 {
        return -1
    }
    var d = false
    while !d {
        if putil.peek_tag() != lex_pipe {
            d = true
        } else {
            putil.advance()
            var rhs = parse_bit_xor()
            if rhs < 0 {
                return -1
            }
            lhs = mk_binary(B_BITOR, lhs, rhs)
        }
    }
    return lhs
}

// 按位异或 ^
func parse_bit_xor() -> i64 {
    var lhs = parse_bit_and()
    if lhs < 0 {
        return -1
    }
    var d = false
    while !d {
        if putil.peek_tag() != lex_caret {
            d = true
        } else {
            putil.advance()
            var rhs = parse_bit_and()
            if rhs < 0 {
                return -1
            }
            lhs = mk_binary(B_BITXOR, lhs, rhs)
        }
    }
    return lhs
}

// 按位与 &
func parse_bit_and() -> i64 {
    var lhs = parse_equality()
    if lhs < 0 {
        return -1
    }
    var d = false
    while !d {
        if putil.peek_tag() != lex_amp {
            d = true
        } else {
            putil.advance()
            var rhs = parse_equality()
            if rhs < 0 {
                return -1
            }
            lhs = mk_binary(B_BITAND, lhs, rhs)
        }
    }
    return lhs
}

// 相等 == !=
func parse_equality() -> i64 {
    var lhs = parse_comparison()
    if lhs < 0 {
        return -1
    }
    var d = false
    while !d {
        var op = -1
        if putil.peek_tag() == lex_eqeq {
            op = B_EQ
        } else if putil.peek_tag() == lex_noteq {
            op = B_NOTEQ
        } else {
            d = true
        }
        if !d {
            putil.advance()
            var rhs = parse_comparison()
            if rhs < 0 {
                return -1
            }
            lhs = mk_binary(op, lhs, rhs)
        }
    }
    return lhs
}

// 比较 < > <= >=
func parse_comparison() -> i64 {
    var lhs = parse_shift()
    if lhs < 0 {
        return -1
    }
    var d = false
    while !d {
        var op = -1
        if putil.peek_tag() == lex_lt {
            op = B_LT
        } else if putil.peek_tag() == lex_gt {
            op = B_GT
        } else if putil.peek_tag() == lex_le {
            op = B_LE
        } else if putil.peek_tag() == lex_ge {
            op = B_GE
        } else {
            d = true
        }
        if !d {
            putil.advance()
            var rhs = parse_shift()
            if rhs < 0 {
                return -1
            }
            lhs = mk_binary(op, lhs, rhs)
        }
    }
    return lhs
}

// 移位 << >>
func parse_shift() -> i64 {
    var lhs = parse_term()
    if lhs < 0 {
        return -1
    }
    var d = false
    while !d {
        var op = -1
        if putil.peek_tag() == lex_shl {
            op = B_SHL
        } else if putil.peek_tag() == lex_shr {
            op = B_SHR
        } else {
            d = true
        }
        if !d {
            putil.advance()
            var rhs = parse_term()
            if rhs < 0 {
                return -1
            }
            lhs = mk_binary(op, lhs, rhs)
        }
    }
    return lhs
}

// 加减 + -
func parse_term() -> i64 {
    var lhs = parse_factor()
    if lhs < 0 {
        return -1
    }
    var d = false
    while !d {
        var op = -1
        if putil.peek_tag() == lex_plus {
            op = B_ADD
        } else if putil.peek_tag() == lex_minus {
            op = B_SUB
        } else {
            d = true
        }
        if !d {
            putil.advance()
            var rhs = parse_factor()
            if rhs < 0 {
                return -1
            }
            lhs = mk_binary(op, lhs, rhs)
        }
    }
    return lhs
}

// 乘除模 * / %
func parse_factor() -> i64 {
    var lhs = parse_unary()
    if lhs < 0 {
        return -1
    }
    var d = false
    while !d {
        var op = -1
        if putil.peek_tag() == lex_star {
            op = B_MUL
        } else if putil.peek_tag() == lex_slash {
            op = B_DIV
        } else if putil.peek_tag() == lex_percent {
            op = B_MOD
        } else {
            d = true
        }
        if !d {
            putil.advance()
            var rhs = parse_unary()
            if rhs < 0 {
                return -1
            }
            lhs = mk_binary(op, lhs, rhs)
        }
    }
    return lhs
}

// ---------- 一元与主表达式 ----------

// 一元（前缀 - ! ++ --）+ 后缀访问链（[index] .field/.method ++ --）
pub func parse_unary() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    var expr = -1
    var tag = putil.peek_tag()
    if tag == lex_minus {
        putil.advance()
        var operand = parse_unary()
        if operand < 0 {
            return -1
        }
        expr = mk_unary(U_NEG, operand, line, col)
    } else if tag == lex_bang {
        putil.advance()
        var operand = parse_unary()
        if operand < 0 {
            return -1
        }
        expr = mk_unary(U_NOT, operand, line, col)
    } else if tag == lex_inc {
        putil.advance()
        var operand = parse_unary()
        if operand < 0 {
            return -1
        }
        expr = mk_unary(U_PRE_INC, operand, line, col)
    } else if tag == lex_dec {
        putil.advance()
        var operand = parse_unary()
        if operand < 0 {
            return -1
        }
        expr = mk_unary(U_PRE_DEC, operand, line, col)
    } else {
        expr = parse_primary()
        if expr < 0 {
            return -1
        }
    }
    // 后缀访问链
    var d = false
    while !d {
        var t = putil.peek_tag()
        if t == lex_lbracket {
            putil.advance()
            var index = parse_expr()
            if index < 0 {
                return -1
            }
            if !putil.expect(lex_rbracket, "']'") {
                return -1
            }
            expr = mk_index(expr, index)
        } else if t == lex_dot {
            putil.advance()
            var field = -1
            if putil.peek_tag() == lex_ident {
                field = interner.intern(putil.peek_lexeme())
                putil.advance()
            } else if putil.peek_tag() == lex_int {
                field = interner.intern(putil.peek_lexeme())
                putil.advance()
            } else if putil.peek_tag() == lex_dollar {
                // S3.3：准引用内字段名插值 `self.$field`（宏生成字段访问；
                // 构造 code 值时 `$field` 嵌入为字段名）
                if putil.peek_n(1) == lex_ident {
                    field = interner.intern("$" + putil.peek_lexeme_n(1))
                    putil.advance()
                    putil.advance()
                } else {
                    putil.set_err(putil.peek_line(), putil.peek_col(), "字段访问 '.' 后必须是字段名/方法名/数字下标/插值名，实际是 " + putil.describe(putil.peek_tag()))
                    return -1
                }
            } else {
                putil.set_err(putil.peek_line(), putil.peek_col(), "字段访问 '.' 后必须是字段名/方法名/数字下标，实际是 " + putil.describe(putil.peek_tag()))
                return -1
            }
            var type_args: i64 = -1
            if putil.peek_tag() == lex_lt {
                // 泛型方法调用探测：`obj.method<i64>(args)`。'<' 后是「完整
                // 类型实参列表 + '>' + '('」才按泛型处理，否则 '<' 留给后续
                // 比较运算符（is_generic_call_ahead 内部 save/restore 不消费）。
                if putil.is_generic_call_ahead() {
                    type_args = pexpr_type.parse_type_args()
                    if type_args < 0 {
                        return -1
                    }
                }
            }
            if putil.eat(lex_lparen) {
                // 方法调用：obj.m(args) / obj.m<i64>(args)
                var args: table<i64> = table_new_i64()
                if !parse_args_after_lparen(args) {
                    return -1
                }
                var mc = ast.new_node(N_METHOD_CALL, field, -1, -1, ast.line(expr), ast.col(expr))
                var mkids: table<i64> = table_new_i64()
                table_push(mkids, type_args)
                table_push(mkids, expr)
                var k: i64 = 0
                while k < len(args) {
                    table_push(mkids, args[k])
                    k = k + 1
                }
                ast.set_children(mc, mkids)
                expr = mc
            } else {
                var fa = ast.new_node(N_FIELD_ACCESS, field, -1, -1, ast.line(expr), ast.col(expr))
                var fkids: table<i64> = table_new_i64()
                table_push(fkids, expr)
                ast.set_children(fa, fkids)
                expr = fa
            }
        } else if t == lex_inc {
            putil.advance()
            expr = mk_unary(U_POST_INC, expr, ast.line(expr), ast.col(expr))
        } else if t == lex_dec {
            putil.advance()
            expr = mk_unary(U_POST_DEC, expr, ast.line(expr), ast.col(expr))
        } else if t == lex_question {
            // S2.3：`?` 后缀解包（expr ?）与三目（cond ? then : else）共用同一
            // token，此处用 save/restore 探测区分：吃 `?` 后若能解析出一个
            // 完整表达式且其后紧跟 ':'，则是三目形态 → 还原让 parse_ternary
            // 处理；否则是后缀解包 → 构造 N_TRY 节点。
            putil.save_pos()
            putil.advance()   // 吃 '?'
            var then = parse_expr()
            if then >= 0 && putil.peek_tag() == lex_colon {
                // 三目形态：还原，'?' 留给外层 parse_ternary
                putil.restore_pos()
                d = true
            } else {
                // 后缀解包：还原后按后缀消费 '?'，构造 N_TRY
                putil.restore_pos()
                putil.advance()
                var tn = ast.new_node(N_TRY, -1, -1, -1, ast.line(expr), ast.col(expr))
                var tkids: table<i64> = table_new_i64()
                table_push(tkids, expr)
                ast.set_children(tn, tkids)
                expr = tn
            }
        } else {
            d = true
        }
    }
    return expr
}

// 解析实参列表到 args（前提：'(' 已消费；以 ')' 结束）
pub func parse_args_after_lparen(args: ref table<i64>) -> bool {
    if putil.eat(lex_rparen) {
        return true
    }
    var d = false
    while !d {
        var a = parse_expr()
        if a < 0 {
            return false
        }
        table_push(args, a)
        if putil.eat(lex_comma) {
            // 继续
        } else {
            if !putil.expect(lex_rparen, "')'") {
                return false
            }
            d = true
        }
    }
    return true
}

// 原子表达式：字面量 / 标识符（路径/调用/变量）/ 括号元组 / 表字面量
func parse_primary() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    var tag = putil.peek_tag()
    if tag == lex_asm {
        // S1.2 I1：`asm!("template", in(reg) expr, out(reg) expr)` 内联汇编
        return parse_asm_expr(line, col)
    }
    // S3.3 准引用字面量：`` `(expr) ``（表达式形式，立即解析）或
    // `` `{ stmts } ``（块形式，块体延迟解析——与 S2.2 闭包体同机制）。
    if tag == lex_backtick {
        return parse_quasi(line, col)
    }
    // S3.3 插值表达式：`$x`（宏参数/变量嵌入）或 `$(expr)`（复杂表达式嵌入）。
    // 仅准引用内合法；普通代码出现由语义层对非宏上下文报错。
    if tag == lex_dollar {
        return parse_interp(line, col)
    }
    // S2.2 闭包字面量 `func(x: i64) -> i64 { ... }`：解析函数头（参数/返回
    // 类型）+ 配平跳过函数体 + 延迟快照登记，函数体由 pstmt_flow.
    // parse_deferred_closures 在 parse_program 末尾恢复解析（语义层 N_FN_LIT
    // 推断已同步实现）。
    if tag == lex_func {
        return parse_fn_lit(line, col)
    }
    if tag == lex_int {
        var lex = putil.peek_lexeme()
        // 批次 2：字面量值域限于 i64 可表示范围（parse_int_lit 返回 i64，
        // i128/u128 常量经 add i128 0, i64 构造，超范围回绕符号扩展错误）
        if putil.int_lit_overflow(lex) {
            putil.set_err(line, col, "整数字面量超出 i64 可表示范围")
            return -1
        }
        var v = putil.parse_int_lit(lex)
        // S1.3 L3：aux = 后缀类型 TyKw（-1 = 无后缀，默认 i64）
        var sufx = putil.parse_lit_suffix(lex)
        putil.advance()
        return ast.new_node(N_INT_LIT, -1, v, sufx, line, col)
    }
    if tag == lex_float {
        // S1.3 L3：剥离 f32/f64 后缀存纯数字文本（llvmgen 输出用），
        // aux = 后缀类型（无后缀 → f64，对齐现状 FloatLit 语义）
        var lex = putil.peek_lexeme()
        var lid = interner.intern(putil.strip_lit_suffix(lex))
        var sufx = putil.parse_lit_suffix(lex)
        if sufx < 0 {
            sufx = 9   // TK_F64
        }
        putil.advance()
        return ast.new_node(N_FLOAT_LIT, lid, -1, sufx, line, col)
    }
    if tag == lex_str {
        var lid = interner.intern(putil.peek_lexeme())
        putil.advance()
        return ast.new_node(N_STR_LIT, lid, -1, -1, line, col)
    }
    if tag == lex_charlit {
        var lid = interner.intern(putil.peek_lexeme())
        putil.advance()
        return ast.new_node(N_CHAR_LIT, lid, -1, -1, line, col)
    }
    if tag == lex_true {
        putil.advance()
        return ast.new_node(N_BOOL_LIT, -1, 1, -1, line, col)
    }
    if tag == lex_false {
        putil.advance()
        return ast.new_node(N_BOOL_LIT, -1, 0, -1, line, col)
    }
    if tag == lex_zero {
        putil.advance()
        return ast.new_node(N_TRIT_LIT, -1, 0, -1, line, col)
    }
    if tag == lex_ident {
        var name = interner.intern(putil.peek_lexeme())
        // 一期并发：run 上下文识别——`run <actor型名>(实参...)` 产出 N_RUN_ACTOR。
        // run 非保留字（规避 toolchain 的 func run()），仅当「run + 标识符 + '('」
        // 三连时按 actor 创建处理；其余情况（run(...) 函数调用 / run 作普通变量）
        // 落回常规 N_VAR/N_CALL 路径。注意 `run(tool...)`（run 后直接 '('）不匹配，
        // 恰好规避 toolchain 的 run(cmd) 调用误判。
        if str_len(putil.peek_lexeme()) > 0 && putil.peek_lexeme() == "run" {
            var nxt = putil.peek_n(1)
            if nxt == lex_ident {
                var anxt = putil.peek_n(2)
                if anxt == lex_lparen {
                    // `run <名>(...)`：actor 创建
                    var rl = putil.peek_line()
                    var rc = putil.peek_col()
                    putil.advance()   // run
                    var aname = putil.peek_lexeme()
                    putil.advance()   // actor 型名
                    // 实参（构造到 actor 的初始消息/参数；一期多为空）
                    var args: table<i64> = table_new_i64()
                    if putil.eat(lex_lparen) {
                        if !parse_args_after_lparen(args) {
                            return -1
                        }
                    }
                    var run = ast.new_node(N_RUN_ACTOR, -1, -1, -1, rl, rc)
                    var rkids: table<i64> = table_new_i64()
                    // 首子节点 = actor 类型名（N_NAMED_TYPE，语义层解析为句柄类型）
                    var tm = ast.new_node(N_NAMED_TYPE, interner.intern(aname), -1, -1, rl, rc)
                    table_push(rkids, tm)
                    var ai: i64 = 0
                    while ai < len(args) {
                        table_push(rkids, args[ai])
                        ai = ai + 1
                    }
                    ast.set_children(run, rkids)
                    return run
                }
            }
        }
        putil.advance()
        // 命名空间路径：a::b::c
        if putil.peek_tag() == lex_dcolon {
            var segs: table<i64> = table_new_i64()
            table_push(segs, name)
            while putil.eat(lex_dcolon) {
                var s = putil.expect_ident()
                if s < 0 {
                    return -1
                }
                table_push(segs, s)
            }
            // 路径尾段后跟调用：`ns::max(...)` / `ns::max<i64>(...)`
            // （2026-08-14 泛型语法）。段收集完毕，最后一段即函数名；产出
            // N_CALL（name=最后段，children=[类型实参槽, 实参...]）。若后跟
            // '.' 等则维持 N_PATH 原样（由 parse_unary 后缀链继续处理）。
            var last = segs[len(segs) - 1]
            var targs = -1
            if putil.peek_tag() == lex_lt {
                // 泛型调用探测：`ns::max<i64>(...)`。非泛型 '<'（比较）不消费。
                if putil.is_generic_call_ahead() {
                    targs = pexpr_type.parse_type_args()
                    if targs < 0 {
                        return -1
                    }
                }
            }
            if putil.peek_tag() == lex_lparen {
                putil.advance()
                var args: table<i64> = table_new_i64()
                if !parse_args_after_lparen(args) {
                    return -1
                }
                var call = ast.new_node(N_CALL, last, -1, -1, line, col)
                var ckids: table<i64> = table_new_i64()
                table_push(ckids, targs)
                var k: i64 = 0
                while k < len(args) {
                    table_push(ckids, args[k])
                    k = k + 1
                }
                ast.set_children(call, ckids)
                return call
            }
            var path = ast.new_node(N_PATH, -1, -1, -1, line, col)
            var pkids: table<i64> = table_new_i64()
            var i: i64 = 0
            while i < len(segs) {
                table_push(pkids, ast.new_node(N_SEGMENT, segs[i], -1, -1, line, col))
                i = i + 1
            }
            ast.set_children(path, pkids)
            return path
        }
        // 泛型调用/构造探测：`max<i64>(3, 5)` / `Box<i64>(42)`（2026-08-14）。
        // '<' 后是「完整类型实参列表 + '>' + '('」才按泛型处理，否则 '<' 是
        // 普通比较运算符（is_generic_call_ahead 内部 save/restore，不消费 token）。
        var targs = -1
        if putil.peek_tag() == lex_lt {
            if putil.is_generic_call_ahead() {
                targs = pexpr_type.parse_type_args()
                if targs < 0 {
                    return -1
                }
            }
        }
        // 函数调用
        if putil.eat(lex_lparen) {
            var args: table<i64> = table_new_i64()
            if !parse_args_after_lparen(args) {
                return -1
            }
            var call = ast.new_node(N_CALL, name, -1, -1, line, col)
            var ckids: table<i64> = table_new_i64()
            table_push(ckids, targs)
            var k: i64 = 0
            while k < len(args) {
                table_push(ckids, args[k])
                k = k + 1
            }
            ast.set_children(call, ckids)
            return call
        }
        return ast.new_node(N_VAR, name, -1, -1, line, col)
    }
    if tag == lex_lparen {
        return parse_paren_or_tuple(line, col)
    }
    if tag == lex_lbracket {
        return parse_table_lit(line, col)
    }
    putil.set_err(line, col, "无法以 " + putil.describe(tag) + " 开始表达式")
    return -1
}

// `(` 起始：元组字面量 `(1, "a")` / `(x: 1, y: 2)`，或分组表达式 `(expr)`
func parse_paren_or_tuple(line: i64, col: i64) -> i64 {
    if !putil.expect(lex_lparen, "'('") {
        return -1
    }
    if putil.eat(lex_rparen) {
        putil.set_err(line, col, "空元组 () 不支持")
        return -1
    }
    var first = parse_tuple_field()
    if first < 0 {
        return -1
    }
    if putil.eat(lex_comma) {
        var fields: table<i64> = table_new_i64()
        table_push(fields, first)
        var d = false
        while !d {
            var f = parse_tuple_field()
            if f < 0 {
                return -1
            }
            table_push(fields, f)
            if putil.eat(lex_comma) {
                // 继续
            } else {
                if !putil.expect(lex_rparen, "')'") {
                    return -1
                }
                d = true
            }
        }
        var tup = ast.new_node(N_TUPLE_LIT, -1, -1, -1, line, col)
        ast.set_children(tup, fields)
        return tup
    }
    // 无逗号 → 分组表达式
    if !putil.expect(lex_rparen, "')'") {
        return -1
    }
    if ast.name(first) != -1 {
        putil.set_err(line, col, "命名字段必须作为元组元素（如 (x: 1, y: 2)），单个 (x: 1) 不是合法表达式")
        return -1
    }
    return ast.child_at(first, 0)
}

// 元组字段：`name: expr`（命名字段）或 `expr`（匿名）——返回 TupleField 节点
func parse_tuple_field() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    if putil.peek_tag() == lex_ident {
        if putil.peek_n(1) == lex_colon {
            var name = interner.intern(putil.peek_lexeme())
            putil.advance()
            if !putil.expect(lex_colon, "':'") {
                return -1
            }
            var value = parse_expr()
            if value < 0 {
                return -1
            }
            var f = ast.new_node(N_TUPLE_FIELD, name, -1, -1, line, col)
            var kids: table<i64> = table_new_i64()
            table_push(kids, value)
            ast.set_children(f, kids)
            return f
        }
    }
    var value = parse_expr()
    if value < 0 {
        return -1
    }
    var f = ast.new_node(N_TUPLE_FIELD, -1, -1, -1, line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, value)
    ast.set_children(f, kids)
    return f
}

// 表字面量 `[col, col; row, row]`（逗号分列、分号分行；空表 [] 合法）
func parse_table_lit(line: i64, col: i64) -> i64 {
    if !putil.expect(lex_lbracket, "'['") {
        return -1
    }
    var cells: table<i64> = table_new_i64()
    if putil.eat(lex_rbracket) {
        return ast.new_node(N_TABLE_LIT, -1, -1, -1, line, col)
    }
    var row: i64 = 0
    var d = false
    while !d {
        var cell = parse_table_cell(row)
        if cell < 0 {
            return -1
        }
        table_push(cells, cell)
        var tag = putil.peek_tag()
        if tag == lex_comma {
            putil.advance()
        } else if tag == lex_semi {
            putil.advance()
            row = row + 1
        } else if tag == lex_rbracket {
            putil.advance()
            d = true
        } else {
            putil.set_err(putil.peek_line(), putil.peek_col(), "期望 , 或 ; 或 ]，实际是 " + putil.describe(tag))
            return -1
        }
    }
    var t = ast.new_node(N_TABLE_LIT, -1, -1, -1, line, col)
    // 二维表 desugar：存在 row > 0 的 cell（出现过 `;` 分行）→ 按行分组，
    // 每行构造一个**子表字面量**（N_TABLE_LIT，含该行全部 cell 作其子节点）
    // 作为外层表字面量的 cell——`[1,2;3,4]` 等价于 `[[1,2],[3,4]]`（嵌套表）。
    // 对齐 Rust 侧行为：多行 + 任何 id 元素（`id:value`）→ 报错。
    var max_row: i64 = 0
    var has_id: bool = false
    var c0: i64 = 0
    while c0 < len(cells) {
        var cc = cells[c0]
        var r = ast.val(cc)
        if r > max_row {
            max_row = r
        }
        if ast.child_at(cc, 0) >= 0 {
            has_id = true
        }
        c0 = c0 + 1
    }
    if max_row > 0 {
        if has_id {
            putil.set_err(putil.peek_line(), putil.peek_col(), "二维表不支持 id 元素")
            return -1
        }
        // 外层表字面量的 cell 必须是 N_TABLE_CELL 包装（与手写嵌套表
        // `[[1,2],[3,4]]` 结构一致：cell = [TableId或-1, 值]）——语义层
        // TableLit 推断按「cell → child(cell,1) 取值」遍历，直接放子表
        // 字面量作 cell 会被误当值节点（"无法推断表达式（节点 19）"）。
        var sub: table<i64> = table_new_i64()
        var r0: i64 = 0
        while r0 <= max_row {
            var rcells: table<i64> = table_new_i64()
            var c1: i64 = 0
            while c1 < len(cells) {
                if ast.val(cells[c1]) == r0 {
                    table_push(rcells, cells[c1])
                }
                c1 = c1 + 1
            }
            var subn = ast.new_node(N_TABLE_LIT, -1, -1, -1, line, col)
            ast.set_children(subn, rcells)
            // 每行包一个 N_TABLE_CELL（无 id，值为子表）
            var wcell = ast.new_node(N_TABLE_CELL, -1, -1, -1, line, col)
            var wkids: table<i64> = table_new_i64()
            table_push(wkids, -1)
            table_push(wkids, subn)
            ast.set_children(wcell, wkids)
            table_push(sub, wcell)
            r0 = r0 + 1
        }
        ast.set_children(t, sub)
    } else {
        ast.set_children(t, cells)
    }
    return t
}

// S1.2 I1 内联汇编：`asm!("template", in(reg) expr, out(reg) expr, ...)`
// 产出 N_ASM（name = 模板串池 id；children = 操作数节点——复用 N_PARAM：
// val = 0=in 1=out 2=inout，children[0] = 表达式）。
// 约束固定 "reg"（第一版；扩展约束语法后续）。
func parse_asm_expr(line: i64, col: i64) -> i64 {
    putil.advance()   // asm
    if !putil.expect(lex_bang, "'!'") {
        return -1
    }
    if !putil.expect(lex_lparen, "'('") {
        return -1
    }
    if putil.peek_tag() != lex_str {
        putil.set_err(putil.peek_line(), putil.peek_col(), "asm! 第一参数必须是模板字符串")
        return -1
    }
    var tmpl = interner.intern(putil.peek_lexeme())
    putil.advance()
    var ops: table<i64> = table_new_i64()
    if !putil.eat(lex_rparen) {
        // 有操作数：模板后必须跟逗号
        if !putil.expect(lex_comma, "','") {
            return -1
        }
        var d = false
        while !d {
            // 操作数：`in` / `out` / `inout`（in 是关键字 lex_in，out/inout 是
            // 标识符）+ `(` + `reg` + `)` + 表达式；或平台条件编译标注
            // `target("arch")`（任务17：按目标平台分支编译）。
            var kind = ""
            var kind_v: i64 = -1
            if putil.peek_tag() == lex_in {
                kind = "in"
                kind_v = 0
            } else if putil.peek_tag() == lex_ident {
                kind = putil.peek_lexeme()
                if kind == "out" {
                    kind_v = 1
                } else if kind == "inout" {
                    kind_v = 2
                } else if kind == "target" {
                    kind_v = 3
                } else {
                    putil.set_err(putil.peek_line(), putil.peek_col(), "asm! 操作数方向必须是 in / out / inout / target，实际是 '" + kind + "'")
                    return -1
                }
            } else {
                putil.set_err(putil.peek_line(), putil.peek_col(), "asm! 操作数必须形如 in(reg) 表达式 / out(reg) 表达式 / target(\"arch\")")
                return -1
            }
            putil.advance()
            if kind_v == 3 {
                // target("arch")：平台条件编译标注（N_PARAM name = 平台字符串池 id，
                // val = 3；children 空）。irgen 按当前编译目标匹配，不匹配 → 报错。
                if !putil.expect(lex_lparen, "'('") {
                    return -1
                }
                if putil.peek_tag() != lex_str {
                    putil.set_err(putil.peek_line(), putil.peek_col(), "asm! target() 参数必须是平台字符串字面量（如 target(\"x86_64\")）")
                    return -1
                }
                var arch = putil.peek_lexeme()
                putil.advance()
                if !putil.expect(lex_rparen, "')'") {
                    return -1
                }
                var p = ast.new_node(N_PARAM, interner.intern(arch), 3, -1, putil.peek_line(), putil.peek_col())
                var pk0: table<i64> = table_new_i64()
                ast.set_children(p, pk0)
                table_push(ops, p)
            } else {
                if !putil.expect(lex_lparen, "'('") {
                    return -1
                }
                if putil.peek_tag() != lex_ident || putil.peek_lexeme() != "reg" {
                    putil.set_err(putil.peek_line(), putil.peek_col(), "asm! 第一版只支持 reg 约束（in/out/inout(reg)）")
                    return -1
                }
                putil.advance()
                if !putil.expect(lex_rparen, "')'") {
                    return -1
                }
                var e = parse_unary()
                if e < 0 {
                    return -1
                }
                var p = ast.new_node(N_PARAM, -1, kind_v, -1, putil.peek_line(), putil.peek_col())
                var pkids: table<i64> = table_new_i64()
                table_push(pkids, e)
                ast.set_children(p, pkids)
                table_push(ops, p)
            }
            if putil.eat(lex_comma) {
                // 继续
            } else {
                if !putil.expect(lex_rparen, "')'") {
                    return -1
                }
                d = true
            }
        }
    }
    var n = ast.new_node(N_ASM, tmpl, -1, -1, line, col)
    ast.set_children(n, ops)
    return n
}

// 表单元格：`id:value`（id 为数字或字符串键）或普通 `value`
func parse_table_cell(row: i64) -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    var id_node = -1
    if putil.peek_tag() == lex_int {
        if putil.peek_n(1) == lex_colon {
            var v = putil.parse_int_lit(putil.peek_lexeme())
            putil.advance()   // 数字
            putil.advance()   // 冒号
            id_node = ast.new_node(N_TABLE_ID, -1, v, -1, line, col)
        }
    } else if putil.peek_tag() == lex_str {
        if putil.peek_n(1) == lex_colon {
            var lid = interner.intern(putil.peek_lexeme())
            putil.advance()   // 字符串
            putil.advance()   // 冒号
            id_node = ast.new_node(N_TABLE_ID, lid, -1, -1, line, col)
        }
    }
    var value = parse_expr()
    if value < 0 {
        return -1
    }
    var c = ast.new_node(N_TABLE_CELL, -1, row, -1, line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, id_node)
    table_push(kids, value)
    ast.set_children(c, kids)
    return c
}

// ---------- S2.2 闭包字面量 ----------

// 闭包字面量：`func(x: i64, y: i64) -> i64 { ... }`。
// 只解析「头部」（参数列表 + 返回类型），函数体 token 流配平跳过并登记
// 快照（putil.defer_closure_push）；整份文件解析完后由
// pstmt_flow.parse_deferred_closures 恢复快照、parse_block 解析函数体并
// 回填到 N_FN_LIT 的 children 末尾。
// 为何延迟：函数体是语句块，需要 pstmt_flow 的语句解析能力，但本模块
// （pexpr）在 import 树底层无法调用 pstmt_flow（成环：pstmt_flow → pstmt
// → pexpr → pstmt_flow）。延迟解析让 pexpr 只产出「头部完整、函数体待填」
// 的节点，由 import 树高层的 pstmt_top/pstmt_flow 回填。
func parse_fn_lit(line: i64, col: i64) -> i64 {
    putil.advance()   // func
    if !putil.expect(lex_lparen, "'('") {
        return -1
    }
    var params: table<i64> = table_new_i64()
    if !putil.eat(lex_rparen) {
        var d = false
        while !d {
            var pname = putil.expect_ident()
            if pname < 0 {
                return -1
            }
            if !putil.expect(lex_colon, "':'") {
                return -1
            }
            var is_var: i64 = 0
            if putil.eat(lex_ellipsis) {
                is_var = 1   // 变参：`name: ...T`（必须是最后一个参数）
            }
            var by_ref: i64 = 0
            if putil.eat(lex_ref) {
                by_ref = 1
            }
            if is_var == 1 && by_ref == 1 {
                putil.set_err(putil.peek_line(), putil.peek_col(), "变参参数不能同时使用 ref 修饰")
                return -1
            }
            var pty = pexpr_type.parse_type()
            if pty < 0 {
                return -1
            }
            var pdef = -1
            if putil.eat(lex_eq) {
                if is_var == 1 {
                    putil.set_err(putil.peek_line(), putil.peek_col(), "变参参数不能有默认值")
                    return -1
                }
                pdef = parse_expr()
                if pdef < 0 {
                    return -1
                }
            }
            if is_var == 1 && putil.peek_tag() == lex_comma {
                putil.set_err(putil.peek_line(), putil.peek_col(), "变参参数必须是最后一个参数")
                return -1
            }
            var p = ast.new_node(N_PARAM, pname, by_ref, is_var, putil.peek_line(), putil.peek_col())
            var pkids: table<i64> = table_new_i64()
            table_push(pkids, pty)
            table_push(pkids, pdef)
            ast.set_children(p, pkids)
            table_push(params, p)
            if putil.eat(lex_comma) {
                // 继续
            } else {
                if !putil.expect(lex_rparen, "')'") {
                    return -1
                }
                d = true
            }
        }
    }
    var ret_ty = -1
    if putil.eat(lex_arrow) {
        ret_ty = pexpr_type.parse_type()
        if ret_ty < 0 {
            return -1
        }
    } else {
        ret_ty = ast.new_node(N_NAMED_TYPE, interner.intern("void"), 14, -1, line, col)
    }
    if putil.peek_tag() != lex_lbrace {
        putil.set_err(putil.peek_line(), putil.peek_col(), "闭包函数体必须是以 '{' 开始的代码块")
        return -1
    }
    // 创建节点：先设头部 children（泛型槽、返回类型、参数...），函数体
    // 由延迟回填追加到 children 末尾。布局与 N_FN_DEF 一致。
    var f = ast.new_node(N_FN_LIT, -1, -1, len(params), line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, -1)   // 泛型槽（闭包暂不支持显式类型参数）
    table_push(kids, ret_ty)
    var i: i64 = 0
    while i < len(params) {
        table_push(kids, params[i])
        i = i + 1
    }
    ast.set_children(f, kids)
    // 登记函数体起始快照（游标此刻停在 '{' 上），随后配平跳过函数体 token
    putil.defer_closure_push(f)
    if !skip_closure_body() {
        return -1
    }
    return f
}

// 配平跳过闭包函数体 `{ ... }`（不建 AST，只消费 token 流到匹配的 '}'）。
// 函数体由 pstmt_flow.parse_deferred_closures 在 parse_program 末尾恢复
// 快照后重新解析（本模块无法调用 pstmt_flow——import 树成环）。
// 注意：字符串/字符字面量是单 token（lex_str），其内部花括号不会干扰
// 配平；嵌套闭包/普通块的花括号正常计数。
func skip_closure_body() -> bool {
    if !putil.expect(lex_lbrace, "'{'") {
        return false
    }
    var depth: i64 = 1   // 已消费起始 '{'，depth=1 表示进入一层
    while depth > 0 {
        var tag = putil.peek_tag()
        if tag == lex_eof {
            putil.set_err(putil.peek_line(), putil.peek_col(), "闭包函数体未闭合：期望 '}'")
            return false
        }
        if tag == lex_lbrace {
            depth = depth + 1
        } else if tag == lex_rbrace {
            depth = depth - 1
        }
        putil.advance()
    }
    return true
}

// ---------- S3.3 准引用 / 插值 ----------

// 准引用字面量：`` ` `` 已消费。两形态：
//   `` `(expr) ``  表达式形式：立即用 parse_expr 解析（内部可含 $ 插值与
//                  嵌套准引用），产出 N_CODE_LIT(val=0, children=[expr])。
//   `` `{ stmts } `` 块形式：登记 N_CODE_LIT(val=1) + 块体 token 流快照
//                  （putil.defer_code_push），配平跳过块体；块体由
//                  pstmt_flow.parse_deferred_code_blocks 在 parse_program
//                  末尾恢复快照、parse_block 解析、回填 children[0]（StmtList）。
// 准引用内容必须是语法合法的表达式/语句块（宏 model §3.4：构造期检查）。
func parse_quasi(line: i64, col: i64) -> i64 {
    putil.advance()   // 反引号
    var tag = putil.peek_tag()
    if tag == lex_lparen {
        putil.advance()
        var expr = parse_expr()
        if expr < 0 {
            return -1
        }
        if !putil.expect(lex_rparen, "')'") {
            return -1
        }
        var n = ast.new_node(N_CODE_LIT, -1, 0, -1, line, col)
        var kids: table<i64> = table_new_i64()
        table_push(kids, expr)
        ast.set_children(n, kids)
        return n
    }
    if tag == lex_lbrace {
        var n = ast.new_node(N_CODE_LIT, -1, 1, -1, line, col)
        var kids: table<i64> = table_new_i64()
        table_push(kids, -1)   // 块体待回填（parse_deferred_code_blocks 填入）
        ast.set_children(n, kids)
        putil.defer_code_push(n)
        if !skip_quasi_body() {
            return -1
        }
        return n
    }
    putil.set_err(line, col, "准引用必须是 `(表达式)` 或 `{语句块}`，实际是 " + putil.describe(tag))
    return -1
}

// 配平跳过准引用块体 `{ ... }`（与 skip_closure_body 同款；块体由
// pstmt_flow.parse_deferred_code_blocks 恢复快照后重新解析）。
func skip_quasi_body() -> bool {
    if !putil.expect(lex_lbrace, "'{'") {
        return false
    }
    var depth: i64 = 1
    while depth > 0 {
        var tag = putil.peek_tag()
        if tag == lex_eof {
            putil.set_err(putil.peek_line(), putil.peek_col(), "准引用块未闭合：期望 '}'")
            return false
        }
        if tag == lex_lbrace {
            depth = depth + 1
        } else if tag == lex_rbrace {
            depth = depth - 1
        }
        putil.advance()
    }
    return true
}

// 插值表达式：`$` 已消费。两形态：
//   `$ident`  简单形式：N_CODE_INTERP(name=变量名池 id)——宏参数（code）
//             嵌入其 AST；gensym 字符串嵌入为标识符引用。
//   `$(expr)` 复杂形式：N_CODE_INTERP(children=[表达式])——表达式求值为
//             code/字符串后嵌入。
func parse_interp(line: i64, col: i64) -> i64 {
    putil.advance()   // $
    if putil.peek_tag() == lex_ident {
        var nm = interner.intern(putil.peek_lexeme())
        putil.advance()
        return ast.new_node(N_CODE_INTERP, nm, -1, -1, line, col)
    }
    if putil.peek_tag() == lex_lparen {
        putil.advance()
        var expr = parse_expr()
        if expr < 0 {
            return -1
        }
        if !putil.expect(lex_rparen, "')'") {
            return -1
        }
        var n = ast.new_node(N_CODE_INTERP, -1, -1, -1, line, col)
        var kids: table<i64> = table_new_i64()
        table_push(kids, expr)
        ast.set_children(n, kids)
        return n
    }
    putil.set_err(line, col, "插值必须是 $标识符 或 $(表达式)，实际是 " + putil.describe(putil.peek_tag()))
    return -1
}

}
