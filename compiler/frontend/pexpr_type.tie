type tie<class>
// compiler/frontend/pexpr_type.tie — T2.5 parser 类型解析（再拆分）
// ============================================================
// 里程碑：自举 v2 计划 T2.5 完整 parser 再拆分（2026-08-11）：
// 原 pexpr.tie 拆出「类型解析 parse_type + parse_tuple_type」部分。
// 依赖：./putil.tie（token 流/工具，经其传递可达 pst/ast/errors/interner/string）。
// 2026-08-14 泛型语法：原 import ./pexpr.tie 改为 ./putil.tie——本模块不调用
// pexpr 命名空间函数（只调 putil/ast/interner），改为平级依赖后 pexpr 才能
// import 本模块（调用 parse_type_args），树仍无环：
//   pstmt → pexpr → pexpr_type → putil
// 树式无环：由 pexpr.tie import（传递可达上层）。
import "./putil.tie"

namespace pexpr_type {

pub func parse_type() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    var tag = putil.peek_tag()
    if tag == lex_typekw {
        var lex = putil.peek_lexeme()
        var tk = putil.typekw_index(lex)
        putil.advance()
        if tk == 19 {
            if putil.eat(lex_lt) {
                var elem = parse_type()
                if elem < 0 {
                    return -1
                }
                if !putil.expect_type_gt("表元素类型后需 '>'") {
                    return -1
                }
                var t = ast.new_node(N_TABLE_TYPE, -1, -1, -1, line, col)
                var kids: table<i64> = table_new_i64()
                table_push(kids, elem)
                ast.set_children(t, kids)
                return t
            }
            return ast.new_node(N_NAMED_TYPE, interner.intern(lex), 19, -1, line, col)
        }
        if tk == 20 {
            if putil.eat(lex_lt) {
                var val = parse_type()
                if val < 0 {
                    return -1
                }
                if !putil.expect_type_gt("键值表值类型后需 '>'") {
                    return -1
                }
                var t = ast.new_node(N_MAP_TYPE, -1, -1, -1, line, col)
                var kids: table<i64> = table_new_i64()
                table_push(kids, val)
                ast.set_children(t, kids)
                return t
            }
            // 裸 map = map<i64>
            var i64node = ast.new_node(N_NAMED_TYPE, interner.intern("i64"), 3, -1, line, col)
            var t = ast.new_node(N_MAP_TYPE, -1, -1, -1, line, col)
            var kids: table<i64> = table_new_i64()
            table_push(kids, i64node)
            ast.set_children(t, kids)
            return t
        }
        return ast.new_node(N_NAMED_TYPE, interner.intern(lex), tk, -1, line, col)
    }
    if tag == lex_lparen {
        return parse_tuple_type(line, col)
    }
    if tag == lex_ident {
        // S2.2 函数值类型：`fn(参数类型...) -> 返回类型`。
        // 'fn' 是标识符 token（非关键字，unsafe fn 语法兼容），此处特判：
        // 标识符文本 == "fn" 且后随 '(' → 函数类型；否则按结构类型引用解析。
        if putil.peek_lexeme() == "fn" && putil.peek_n(1) == lex_lparen {
            return parse_fn_type(line, col)
        }
        // 结构类型引用：`Box` 或 `Box<i64>`（2026-08-14 泛型类型实参）。
        // N_STRUCT_TYPE children = [类型实参槽]：`Box<i64>` → N_TYPE_ARGS 子节点；
        // `Box` 裸引用 → children[0] = -1（兼容现有布局）。
        var name = interner.intern(putil.peek_lexeme())
        putil.advance()
        var t = ast.new_node(N_STRUCT_TYPE, name, -1, -1, line, col)
        var tkids: table<i64> = table_new_i64()
        if putil.peek_tag() == lex_lt {
            var targs = parse_type_args()
            if targs < 0 {
                return -1
            }
            table_push(tkids, targs)
        } else {
            table_push(tkids, -1)
        }
        ast.set_children(t, tkids)
        return t
    }
    putil.set_err(line, col, "期望类型，实际是 " + putil.describe(tag))
    return -1
}

// 函数值类型：`fn(参数类型...) -> 返回类型`（S2.2，闭包/函数指针）。
// 前提：当前 peek 为标识符 "fn"（'fn' 是标识符 token，此处特判消费）。
// 产出 N_FN_TYPE 节点：children = [返回类型, 参数类型...]（返回类型在前，
// 与 N_FN_DEF 的 children 布局呼应）。返回类型可省略（缺省 void）。
func parse_fn_type(line: i64, col: i64) -> i64 {
    putil.advance()   // 消费 "fn"
    if !putil.expect(lex_lparen, "'('") {
        return -1
    }
    var params: table<i64> = table_new_i64()
    if !putil.eat(lex_rparen) {
        var d = false
        while !d {
            var pty = parse_type()
            if pty < 0 {
                return -1
            }
            table_push(params, pty)
            if putil.eat(lex_comma) {
                // 继续
            } else {
                if !putil.expect(lex_rparen, "')'") {
                    return -1
                }
                d = true
            }
        }
    }
    var ret = -1
    if putil.eat(lex_arrow) {
        ret = parse_type()
        if ret < 0 {
            return -1
        }
    } else {
        ret = ast.new_node(N_NAMED_TYPE, interner.intern("void"), 14, -1, line, col)
    }
    var t = ast.new_node(N_FN_TYPE, -1, -1, -1, line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, ret)
    var i: i64 = 0
    while i < len(params) {
        table_push(kids, params[i])
        i = i + 1
    }
    ast.set_children(t, kids)
    return t
}

// 类型实参列表：`<T1, T2, ...>`（使用点，如 `Box<i64>` / `max<i64>(...)`）。
// 逐个用 parse_type 递归解析实参（实参可为内建泛型 table<T>/map<T>、嵌套
// 结构引用 Box<i64>、元组类型等）；闭合用 expect_type_gt（自动处理 `>>` 分裂）。
// 返回 N_TYPE_ARGS 节点（children = 类型节点序列）。
// 前提：当前 peek 为 '<'（本函数消费之）。
pub func parse_type_args() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    if !putil.expect(lex_lt, "'<'") {
        return -1
    }
    var args: table<i64> = table_new_i64()
    var a = parse_type()
    if a < 0 {
        return -1
    }
    table_push(args, a)
    while putil.eat(lex_comma) {
        a = parse_type()
        if a < 0 {
            return -1
        }
        table_push(args, a)
    }
    if !putil.expect_type_gt("类型实参列表后需 '>'") {
        return -1
    }
    var n = ast.new_node(N_TYPE_ARGS, -1, -1, -1, line, col)
    ast.set_children(n, args)
    return n
}

// 元组类型：`(T1, T2, ...)` / `(name: T1, name: T2, ...)`
func parse_tuple_type(line: i64, col: i64) -> i64 {
    if !putil.expect(lex_lparen, "'('") {
        return -1
    }
    if putil.eat(lex_rparen) {
        putil.set_err(line, col, "空元组类型 () 不支持")
        return -1
    }
    var fields: table<i64> = table_new_i64()
    var d = false
    while !d {
        var name = -1
        if putil.peek_tag() == lex_ident {
            if putil.peek_n(1) == lex_colon {
                name = interner.intern(putil.peek_lexeme())
                putil.advance()
                if !putil.expect(lex_colon, "':'") {
                    return -1
                }
            }
        }
        var fty = parse_type()
        if fty < 0 {
            return -1
        }
        var f = ast.new_node(N_TUPLE_TYPE_FIELD, name, -1, -1, line, col)
        var fkids: table<i64> = table_new_i64()
        table_push(fkids, fty)
        ast.set_children(f, fkids)
        table_push(fields, f)
        if putil.eat(lex_comma) {
            // 继续
        } else {
            if !putil.expect(lex_rparen, "')'") {
                return -1
            }
            d = true
        }
    }
    var t = ast.new_node(N_TUPLE_TYPE, -1, -1, -1, line, col)
    ast.set_children(t, fields)
    return t
}
}
