type tie<class>
// compiler/frontend/pst.tie —— T2.5 parser 全局状态（模块拆分）
// ============================================================
// 里程碑：自举 v2 计划 T2.5（.omo/plans/self-hosting-v2.md）完整 parser
// 拆分为 4 模块之一（本文件 = parser 全局状态，零依赖叶节点）。
// 全部共享状态放文件顶层（tie 约束：全局变量只能顶层声明），
// 供 putil/pexpr/pstmt/parser 各模块函数裸名访问（跨文件已验证可行）。
// 依赖：无。由 putil.tie import（传递可达上层）。
// 对应 proto/parser.tie 232-251 行状态 + reset 逻辑拆出。

// ---------- 词法游标与 pending（>> 分裂）状态 ----------
var g_pos: i64 = 0;           // 真实 token 流游标
var g_pending: table<i64>;    // 待消费虚拟 token 队列（FIFO）
var g_pending_idx: i64 = 0;   // 指向 g_pending 中下一个待消费位置
var g_pending_lines: table<i64>;  // 虚拟 token 的旁路行号
var g_pending_cols: table<i64>;   // 虚拟 token 的旁路列号
var g_pending_lexemes: table<i64>; // 虚拟 token 的旁路 lexeme 池 id（split 分裂用）

// ---------- 泛型探测位置保存/恢复（try 回退，2026-08-14）----------
// save_pos 快照 token 流（真实游标 + pending 队列完整内容 + 错误槽）到 g_save_*；
// restore_pos 恢复到保存时刻（探测期间 split 追加/原位覆盖均被还原）。
// 注意：save/restore 成对使用且不嵌套（泛型调用探测是同步的）。
var g_save_pos: i64 = 0;          // 真实 token 流游标快照
var g_save_idx: i64 = 0;          // pending 队列游标快照
var g_save_pending: table<i64>;   // pending 队列 tag 快照
var g_save_pending_lines: table<i64>;  // pending 队列行号快照
var g_save_pending_cols: table<i64>;   // pending 队列列号快照
var g_save_pending_lexemes: table<i64>;// pending 队列 lexeme 池 id 快照
var g_save_err_line: i64 = 0;     // 语法错误槽行号快照
var g_save_err_col: i64 = 0;      // 语法错误槽列号快照
var g_save_err_msg: string = "";  // 语法错误槽消息快照

// ---------- 延迟闭包函数体快照（S2.2）----------
// 闭包字面量 `func(x: i64) -> i64 { ... }` 是表达式，由 pexpr.parse_primary
// 解析头部（参数+返回类型）；函数体是语句块，需要 pstmt_flow 的语句解析，
// 但 pexpr 在 import 树底层无法调用 pstmt_flow（成环：pstmt_flow → pstmt →
// pexpr）。方案：parse_primary 遇 func 字面量时只解析头部并「配平跳过」
// 函数体 token（不建 AST），同时登记函数体起始处的完整 token 流快照
// （与 save_pos 同构但**多槽**——闭包可嵌套/多个，见 putil.defer_closure_*）；
// 整份文件解析完后由 pstmt_flow.parse_deferred_closures 逐闭包恢复快照、
// parse_block 解析函数体、回填到 N_FN_LIT。
var g_defer_nodes: table<i64>;       // 待回填的 N_FN_LIT 节点 id（一一对应快照）
var g_defer_pos: table<i64>;         // 快照：真实 token 流游标 g_pos
var g_defer_idx: table<i64>;         // 快照：pending 队列游标 g_pending_idx
var g_defer_pending: table<table<i64>>;      // 快照：pending 队列 tag（嵌套表 E1）
var g_defer_pending_lines: table<table<i64>>;   // 快照：行号
var g_defer_pending_cols: table<table<i64>>;    // 快照：列号
var g_defer_pending_lexemes: table<table<i64>>; // 快照：lexeme 池 id
var g_defer_err_line: table<i64>;    // 快照：语法错误槽行号
var g_defer_err_col: table<i64>;     // 快照：语法错误槽列号
var g_defer_err_msg: table<string>;  // 快照：语法错误槽消息

// ---------- 延迟准引用块快照（S3.3）----------
// 准引用块字面量 `` `{ stmts } `` 是表达式，由 pexpr.parse_primary 解析反引号
// 头（登记 N_CODE_LIT 节点 + 配平跳过块体 token）；块体是语句块，需要
// pstmt_flow 的语句解析（同 S2.2 闭包的同款成环约束）。方案与闭包完全同构：
// 登记「块体起始处完整 token 流快照」到 g_defer_code_* 多槽表，整份文件解析
// 完后由 pstmt_flow.parse_deferred_code_blocks 逐块恢复快照、parse_block 解析
// 块体、回填到 N_CODE_LIT 的 children[0]（块形式子 AST = StmtList）。
// 嵌套/交错：闭包体里可有准引用块、准引用块里可有闭包——parse_program 末尾
// 用 parse_deferred_all 交替处理两张延迟表直到两者都稳定（见 pstmt_top）。
var g_defer_code_nodes: table<i64>;  // 待回填的 N_CODE_LIT 节点 id（一一对应快照）
var g_defer_code_pos: table<i64>;    // 快照：真实 token 流游标 g_pos
var g_defer_code_idx: table<i64>;    // 快照：pending 队列游标 g_pending_idx
var g_defer_code_pending: table<table<i64>>;       // 快照：pending 队列 tag
var g_defer_code_pending_lines: table<table<i64>>; // 快照：行号
var g_defer_code_pending_cols: table<table<i64>>;  // 快照：列号
var g_defer_code_pending_lexemes: table<table<i64>>; // 快照：lexeme 池 id
var g_defer_code_err_line: table<i64>;  // 快照：语法错误槽行号
var g_defer_code_err_col: table<i64>;   // 快照：语法错误槽列号
var g_defer_code_err_msg: table<string>;// 快照：语法错误槽消息
// 当前是否在解析准引用块体（`` `{ ... } `` 延迟回填期间置位）。
// 用途（S3.3）：准引用块内语句起始位置的 `func name() {...}` 按**函数定义**
// 解析（宏生成函数）；普通函数体内 `func` 保持闭包字面量语义不变。
var g_in_quasi_block: i64 = 0;

// ---------- 语法错误槽位（parse 返回 ERR: 协议）----------
var p_err_line: i64 = 0;
var p_err_col: i64 = 0;
var p_err_msg: string = "";

// ---------- 元组解构临时变量计数器（生成 _tmpN 唯一名）----------
var g_tmp: i64 = 0;

namespace pst {
}
