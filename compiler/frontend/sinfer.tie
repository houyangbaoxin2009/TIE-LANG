type tie<class>
// compiler/frontend/sinfer.tie —— T2.6 表达式类型推断（模块拆分）
// ============================================================
// 里程碑：自举 v2 计划 T2.6（.omo/plans/self-hosting-v2.md）完整语义分析
// 拆分为 8 模块之一（本文件 = 表达式类型推断 + 调用解析 + 作用域辅助）。
// 对应 proto/semantic.tie 1980-2112（作用域辅助）+ 2115-2645（infer_expr）
// + 2652-2704（resolve_call_name）+ 2706-2896（infer_call/infer_method_call）
// + 2899-3003（recv_path_name/infer_struct_method）逻辑搬移。
// 依赖：./sstate.tie（AST 全局 + 符号表 + 工具）+ ./stype.tie（类型匹配）+
// ./sbuiltin.tie（内置函数签名）。树式无环：由 scollect.tie import。
import "./sbuiltin.tie"
import "./sgen.tie"

namespace sinfer {

// ==================== 作用域辅助 ====================
// 查局部作用域（返回类型 id；-1 = 未声明）
pub func lv_find(nid: i64) -> i64 {
    var idx = sstate.bs_find(lv_keys, nid)
    if idx < 0 {
        return -1
    }
    return lv_vals[idx]
}
pub func lv_const_of(nid: i64) -> i64 {
    var idx = sstate.bs_find(lv_keys, nid)
    if idx < 0 {
        return 0
    }
    return lv_const[idx]
}
pub func lv_telem_of(nid: i64) -> i64 {
    var idx = sstate.bs_find(lv_keys, nid)
    if idx < 0 {
        return -1
    }
    return lv_telem[idx]
}
pub func lv_dyn_of(nid: i64) -> i64 {
    var idx = sstate.bs_find(lv_keys, nid)
    if idx < 0 {
        return 0
    }
    return lv_dyn[idx]
}

// 局部作用域插入（五表同步；已存在覆盖，对齐 Rust scope.insert）
pub func lv_insert(nid: i64, ty: i64, is_const: i64, telem: i64, dyn: i64) -> i64 {
    var pos0 = sstate.bs_find(lv_keys, nid)
    if pos0 >= 0 {
        lv_vals[pos0] = ty
        lv_const[pos0] = is_const
        lv_telem[pos0] = telem
        lv_dyn[pos0] = dyn
        return pos0
    }
    var n = len(lv_keys)
    var lo: i64 = 0
    var hi: i64 = n - 1
    var pos: i64 = n
    while lo <= hi {
        var mid = (lo + hi) / 2
        if lv_keys[mid] < nid {
            lo = mid + 1
        } else {
            pos = mid
            hi = mid - 1
        }
    }
    table_push(lv_keys, 0)
    table_push(lv_vals, 0)
    table_push(lv_const, 0)
    table_push(lv_telem, 0)
    table_push(lv_dyn, 0)
    var i: i64 = n
    while i > pos {
        lv_keys[i] = lv_keys[i - 1]
        lv_vals[i] = lv_vals[i - 1]
        lv_const[i] = lv_const[i - 1]
        lv_telem[i] = lv_telem[i - 1]
        lv_dyn[i] = lv_dyn[i - 1]
        i = i - 1
    }
    lv_keys[pos] = nid
    lv_vals[pos] = ty
    lv_const[pos] = is_const
    lv_telem[pos] = telem
    lv_dyn[pos] = dyn
    return pos
}

// 全局变量查询（返回类型 id；-1 = 未声明）
pub func gb_find(nid: i64) -> i64 {
    var idx = sstate.bs_find(gb_keys, nid)
    if idx < 0 {
        return -1
    }
    return gb_vals[idx]
}
pub func gb_const_of(nid: i64) -> i64 {
    var idx = sstate.bs_find(gb_keys, nid)
    if idx < 0 {
        return 0
    }
    return gb_const[idx]
}
pub func gb_telem_of(nid: i64) -> i64 {
    var idx = sstate.bs_find(gb_keys, nid)
    if idx < 0 {
        return -1
    }
    return gb_telem[idx]
}

// 表元素类型（变量名）：局部 → 全局 → -1
pub func var_table_elem(nid: i64) -> i64 {
    var i = sstate.bs_find(lv_keys, nid)
    if i >= 0 {
        return lv_telem[i]
    }
    var j = sstate.bs_find(gb_keys, nid)
    if j >= 0 {
        return gb_telem[j]
    }
    return -1
}
pub func var_dyn(nid: i64) -> i64 {
    var i = sstate.bs_find(lv_keys, nid)
    if i >= 0 {
        return lv_dyn[i]
    }
    var j = sstate.bs_find(gb_keys, nid)
    if j >= 0 {
        return 1
    }
    return 0
}

// 函数返回表元素类型查询（fn 名 -> 元素类型；-1 无）
pub func table_ret_elem(fn_name: string) -> i64 {
    var nid = intern.intern(fn_name)
    var idx = sstate.bs_find(tre_keys, nid)
    if idx >= 0 {
        return tre_vals[idx]
    }
    var bi = sstate.bs_find(tre_bi_keys, nid)
    if bi >= 0 {
        return tre_bi_vals[bi]
    }
    return -1
}

// 从实参表达式节点推断表元素类型（对齐 Rust arg_table_elem_ty）：
// - 表字面量 TableLit：取首单元格值类型（空表 → i64）
// - 变量 Var：查局部/全局表的元素类型（lv_telem/gb_telem）
// - 调用 Call：查返回表元素类型（table_ret_elem）
// 返回元素类型 id；-1 = 无法推断（非表实参或裸表）
pub func arg_table_elem_ty(a: i64) -> i64 {
    var tag = s_tags[a]
    if tag == S_N_TABLE_LIT {
        var nc = sstate.nchild(a)
        if nc == 0 {
            return types.named(TK_I64)
        }
        // 表字面量：取首元素值类型（cell 结构 [id, 值]）
        var first = sstate.child(a, 0)
        var vt = infer_expr(sstate.child(first, 1))
        if vt < 0 {
            return -1
        }
        return vt
    }
    if tag == S_N_VAR {
        var nm = sstate.name_str(a)
        var nid = intern.intern(nm)
        var te = var_table_elem(nid)
        if te >= 0 {
            return te
        }
        return -1
    }
    if tag == S_N_CALL {
        var fnm = sstate.name_str(a)
        // 动态表构造：table_new_i64 → i64 等
        if fnm == "table_new_i64" {
            return types.named(TK_I64)
        }
        if fnm == "table_new_f64" {
            return types.named(TK_F64)
        }
        if fnm == "table_new_string" {
            return types.named(TK_STR)
        }
        if fnm == "table_new_bool" {
            return types.named(TK_BOOL)
        }
        // 返回表的函数：用解析后全名查
        var full = resolve_call_name(fnm)
        return table_ret_elem(full)
    }
    return -1
}

// ==================== 裸调用名解析（M2.1.7） ====================
// 候选 1：顶层裸名；候选 2：当前命名空间前缀补全（逐级外层）；
// 候选 3：using 引入的命名空间。返回实际注册键（全名）。
// T3b 泛型扩展：候选命中判定同时覆盖普通函数（fn_sig）与泛型模板（gt_find）
// ——模板不进入 fn_keys，裸调用名解析须能定位到 gt_* 表。
pub func resolve_call_name(name: string) -> string {
    var nid = intern.intern(name)
    if sstate.fn_sig(name) >= 0 {
        return name
    }
    if sstate.gt_find(name) >= 0 {
        return name
    }
    // 候选 2：当前命名空间逐级外层补全
    if ns_top > 0 {
        var depth: i64 = ns_top
        while depth >= 0 {
            var full: string = ""
            var i: i64 = 0
            while i < depth {
                if i > 0 {
                    full = full + "::"
                }
                full = full + intern.lookup(ns_stack[i])
                i = i + 1
            }
            var cand: string = ""
            if full != "" {
                cand = full + "::" + name
            } else {
                cand = name
            }
            if sstate.fn_sig(cand) >= 0 || sstate.gt_find(cand) >= 0 {
                return cand
            }
            depth = depth - 1
        }
    }
    // 候选 3：using 引入的命名空间
    var off: i64 = 0
    var u: i64 = 0
    while u < len(using_lens) {
        var ln = using_lens[u]
        var full: string = ""
        var i: i64 = 0
        while i < ln {
            if i > 0 {
                full = full + "::"
            }
            full = full + intern.lookup(using_prefixes[off + i])
            i = i + 1
        }
        var cand = full + "::" + name
        if sstate.fn_sig(cand) >= 0 || sstate.gt_find(cand) >= 0 {
            return cand
        }
        off = off + ln
        u = u + 1
    }
    return name
}

// ==================== 表达式类型推断 ====================
// infer_expr(id) -> 类型 id；-1 = 错误（g_err_* 已置）
pub func infer_expr(id: i64) -> i64 {
    var tag = s_tags[id]
    // 字面量
    if tag == 0 {
        node_types[id] = types.named(TK_I64)
        g_typed = g_typed + 1
        return types.named(TK_I64)
    }
    if tag == 1 {
        node_types[id] = types.named(TK_F64)
        g_typed = g_typed + 1
        return types.named(TK_F64)
    }
    if tag == 2 {
        node_types[id] = types.named(TK_STR)
        g_typed = g_typed + 1
        return types.named(TK_STR)
    }
    if tag == 3 {
        node_types[id] = types.named(TK_CHAR)
        g_typed = g_typed + 1
        return types.named(TK_CHAR)
    }
    if tag == 4 {
        node_types[id] = types.named(TK_BOOL)
        g_typed = g_typed + 1
        return types.named(TK_BOOL)
    }
    if tag == 5 {
        node_types[id] = types.named(TK_TRIT)
        g_typed = g_typed + 1
        return types.named(TK_TRIT)
    }
    // Var
    if tag == S_N_VAR {
        var nm = sstate.name_str(id)
        var nid = intern.intern(nm)
        var lt = lv_find(nid)
        if lt >= 0 {
            node_types[id] = lt
            g_typed = g_typed + 1
            return lt
        }
        var gt = gb_find(nid)
        if gt >= 0 {
            node_types[id] = gt
            g_typed = g_typed + 1
            return gt
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "未声明的变量 '" + nm + "'"
        return -1
    }
    // Range
    if tag == S_N_RANGE {
        var st = infer_expr(sstate.child(id, 0))
        if st < 0 {
            return -1
        }
        var en = infer_expr(sstate.child(id, 1))
        if en < 0 {
            return -1
        }
        if !types.is_int(st) || !types.is_int(en) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "范围两端必须是整数"
            return -1
        }
        node_types[id] = types.named(TK_I64)
        g_typed = g_typed + 1
        return types.named(TK_I64)
    }
    // Unary
    if tag == S_N_UNARY {
        var op = s_vals[id]
        var operand = infer_expr(sstate.child(id, 0))
        if operand < 0 {
            return -1
        }
        if op == 0 {
            // Neg：数字
            if !types.is_number(operand) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "取负运算的操作数必须是数字"
                return -1
            }
        } else if op == 1 {
            // Not：bool 或 trit
            if !types.is_bool_like(operand) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "逻辑非的操作数必须是 bool"
                return -1
            }
        } else {
            // 自增/自减：可写数字变量
            var target = sstate.child(id, 0)
            if s_tags[target] != S_N_VAR {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "自增/自减的操作数必须是可写数字变量"
                return -1
            }
            var nm = sstate.name_str(target)
            var nid2 = intern.intern(nm)
            if lv_const_of(nid2) == 1 {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "不能对 const 变量 '" + nm + "' 自增/自减"
                return -1
            }
            if !types.is_number(operand) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "自增/自减的操作数必须是可写数字变量"
                return -1
            }
        }
        node_types[id] = operand
        g_typed = g_typed + 1
        return operand
    }
    // Binary
    if tag == S_N_BINARY {
        var op = s_vals[id]
        var lhs = infer_expr(sstate.child(id, 0))
        if lhs < 0 {
            return -1
        }
        var rhs = infer_expr(sstate.child(id, 1))
        if rhs < 0 {
            return -1
        }
        // 两侧类型一致（trit×i64 例外；int×float 混用；string+string 拼接）
        var type_ok: bool = false
        if lhs == rhs {
            type_ok = true
        } else if types.is_bool_like(lhs) && types.is_bool_like(rhs) {
            type_ok = true
        } else if lhs == TK_TRIT && types.is_int(rhs) {
            type_ok = true
        } else if rhs == TK_TRIT && types.is_int(lhs) {
            type_ok = true
        } else if types.is_int(lhs) && types.is_int(rhs) {
            type_ok = true
        } else if types.is_float(lhs) && types.is_float(rhs) {
            type_ok = true
        } else if types.is_int(lhs) && types.is_float(rhs) {
            type_ok = true
        } else if types.is_float(lhs) && types.is_int(rhs) {
            type_ok = true
        } else if op == 0 && lhs == TK_STR && rhs == TK_STR {
            // 字符串拼接
            type_ok = true
        } else if op >= 5 && op <= 10 && types.kind(lhs) == K_TUPLE &&
            types.kind(rhs) == K_TUPLE && stype.tuple_equal(lhs, rhs) {
            // 元组比较：结构相等（逐字段类型一致，嵌套元组递归）即合法——
            // `(1,2) == (1,2)` 两侧各登记独立 tuple 类型 id，须按字段结构
            // 比较（对齐 Rust 行为）；==/!= 放行，< > <= >= 在下文 op 分组
            // 检查中报「比较运算符不能用于 tuple」
            type_ok = true
        }
        if !type_ok {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "二元运算两侧类型不一致：" + types.type_name(lhs) + " 与 " + types.type_name(rhs)
            return -1
        }
        // 按运算符分组校验
        if op <= 4 || op == 13 || op == 14 || op == 15 || op == 16 || op == 17 {
            // 算术/位运算：数字（位运算需整数）
            if !types.is_number(lhs) && lhs != TK_STR && !(lhs == TK_TRIT || rhs == TK_TRIT) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "算术运算符不能用于 " + types.type_name(lhs)
                return -1
            }
            if op >= 13 && !types.is_int(lhs) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "位运算只支持整数，不能用于 " + types.type_name(lhs)
                return -1
            }
            if op == 4 && !types.is_int(lhs) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "取模运算只支持整数"
                return -1
            }
        } else if op <= 10 {
            // 比较：数字/字符串/bool/trit；元组仅 ==/!=（逐字段），< > <= >= 仍报错
            if types.kind(lhs) == K_TUPLE {
                if op == 5 || op == 6 {
                    // 元组相等比较：合法（结果 bool，rt 在下方比较分支统一处理）
                } else {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "比较运算符不能用于 " + types.type_name(lhs)
                    return -1
                }
            } else if !types.is_number(lhs) && lhs != TK_STR && !types.is_bool_like(lhs) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "比较运算符不能用于 " + types.type_name(lhs)
                return -1
            }
        } else if op <= 12 {
            // 逻辑：bool 或 trit
            if !types.is_bool_like(lhs) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "逻辑运算符两侧必须是 bool（或两侧同为 trit）"
                return -1
            }
        }
        var rt = lhs
        if types.is_int(lhs) && types.is_float(rhs) {
            rt = rhs
        }
        if types.is_float(lhs) && types.is_int(rhs) {
            rt = lhs
        }
        // trit × i64 混合（t + 5 / 5 - t）：结果 i64（irgen 生成 i64 运算并
        // sext trit 侧——曾按 lhs 标 TK_TRIT，IR 结果 i64 却被当 i8 转换/打印）
        if lhs == TK_TRIT && types.is_int(rhs) {
            rt = rhs
        }
        if rhs == TK_TRIT && types.is_int(lhs) {
            rt = lhs
        }
        if op <= 10 && op >= 5 {
            // 比较/逻辑：结果 bool
            rt = types.named(TK_BOOL)
        }
        node_types[id] = rt
        g_typed = g_typed + 1
        return rt
    }
    // Ternary
    if tag == S_N_TERNARY {
        var cond = infer_expr(sstate.child(id, 0))
        if cond < 0 {
            return -1
        }
        if !types.is_bool_like(cond) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "三目条件必须是 bool"
            return -1
        }
        var th = infer_expr(sstate.child(id, 1))
        if th < 0 {
            return -1
        }
        var el = infer_expr(sstate.child(id, 2))
        if el < 0 {
            return -1
        }
        if th != el && !(types.is_int(th) && types.is_int(el)) && !(types.is_float(th) && types.is_float(el)) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "三目两分支类型不一致：" + types.type_name(th) + " 与 " + types.type_name(el)
            return -1
        }
        node_types[id] = th
        g_typed = g_typed + 1
        return th
    }
    // Path：不能作值
    if tag == S_N_PATH {
        // Path 名字在 Segment children 中（name 字段为空），拼接完整路径
        var pname = recv_path_name(id)
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "命名空间路径 '" + pname + "' 不能作为值使用（只能用于调用，如 'x::f()'）"
        return -1
    }
    // TypeLit：仅 switch case
    if tag == S_N_TYPE_LIT {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "类型字面量只能用作 switch 的 case 类型匹配"
        return -1
    }
    // Index
    if tag == S_N_INDEX {
        var base = infer_expr(sstate.child(id, 0))
        if base < 0 {
            return -1
        }
        var idx = infer_expr(sstate.child(id, 1))
        if idx < 0 {
            return -1
        }
        if types.is_table(base) {
            var elem = types.table_elem(base)
            if elem < 0 {
                // 表变量：查 var_table_elem
                var base_node = sstate.child(id, 0)
                if s_tags[base_node] == S_N_VAR {
                    var nm = sstate.name_str(base_node)
                    var nid = intern.intern(nm)
                    var te = var_table_elem(nid)
                    if te >= 0 {
                        node_types[id] = te
                        g_typed = g_typed + 1
                        return te
                    }
                }
                // 裸 table：元素类型未知，默认 i64
                node_types[id] = types.named(TK_I64)
                g_typed = g_typed + 1
                return types.named(TK_I64)
            }
            node_types[id] = elem
            g_typed = g_typed + 1
            return elem
        }
        if base == TK_STR {
            if !types.is_int(idx) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "下标必须是整数，实际是 " + types.type_name(idx)
                return -1
            }
            // 对齐 Rust 版：s[i] → 取第 i 个字符（char），非 string
            node_types[id] = types.named(TK_CHAR)
            g_typed = g_typed + 1
            return types.named(TK_CHAR)
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "下标访问的对象必须是表或字符串，实际是 " + types.type_name(base)
        return -1
    }
    // FieldAccess
    if tag == S_N_FIELD_ACCESS {
        var base = infer_expr(sstate.child(id, 0))
        if base < 0 {
            return -1
        }
        var fnm = sstate.name_str(id)
        var bk = types.kind(base)
        if bk == K_TUPLE {
            var ti = types.low(base)
            var off = tup_offs[ti]
            var cnt = tup_n[ti]
            var i: i64 = 0
            while i < cnt {
                var fnid = tup_names[off + i]
                // 访问顺序：数字下标（.0 起）→ ItemN（1 起编号）→ 字段名
                var hit: bool = false
                if fnm == to_string(i) {
                    hit = true
                } else if fnm == "Item" + to_string(i + 1) {
                    hit = true
                } else if fnid >= 0 {
                    if intern.lookup(fnid) == fnm {
                        hit = true
                    }
                }
                if hit {
                    node_types[id] = tup_tys[off + i]
                    g_typed = g_typed + 1
                    return tup_tys[off + i]
                }
                i = i + 1
            }
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "元组没有字段 '" + fnm + "'"
            return -1
        }
        if bk == K_STRUCT {
            // P8：struct 字段访问的 base 必须可寻址
            var base_node = sstate.child(id, 0)
            if !sstate.is_addressable(base_node) {
                var cls_name = sstate.struct_name_of(types.low(base))
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "struct 实例 '" + cls_name + "' 的字段访问需要可寻址对象（变量/字段链），"
                return -1
            }
            var si = types.low(base)
            var off = cls_fldoff[si]
            var cnt = cls_nfld[si]
            var i: i64 = 0
            while i < cnt {
                if intern.lookup(fld_names[off + i]) == fnm {
                    node_types[id] = fld_tys[off + i]
                    g_typed = g_typed + 1
                    return fld_tys[off + i]
                }
                i = i + 1
            }
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "类 '" + intern.lookup(st_keys[si]) + "' 没有字段 '" + fnm + "'"
            return -1
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "字段访问 '.' 的对象必须是元组或类实例，实际是 " + types.type_name(base)
        return -1
    }
    // TableLit
    if tag == S_N_TABLE_LIT {
        var nc = sstate.nchild(id)
        if nc == 0 {
            // 空表：i64
            node_types[id] = types.named(TK_I64)
            g_typed = g_typed + 1
            return types.named(TK_I64)
        }
        // map 检测：TableId 子节点存在
        var is_map: bool = false
        var i: i64 = 0
        while i < nc {
            var cell = sstate.child(id, i)
            var cid = sstate.child(cell, 0)
            if cid >= 0 {
                if s_tags[cid] == S_N_TABLE_ID {
                    is_map = true
                }
            }
            i = i + 1
        }
        if is_map {
            // map<val_ty>：所有值类型一致
            var val_ty: i64 = -1
            var i2: i64 = 0
            while i2 < nc {
                var cell = sstate.child(id, i2)
                var vt = infer_expr(sstate.child(cell, 1))
                if vt < 0 {
                    return -1
                }
                if val_ty < 0 {
                    val_ty = vt
                } else {
                    if vt != val_ty && !(types.is_int(vt) && types.is_int(val_ty)) {
                        sm_err_line = s_lines[id]
                        sm_err_col = s_cols[id]
                        sm_err_msg = "键值表值类型不匹配：map 值为 " + types.type_name(val_ty) + " 与 " + types.type_name(vt)
                        return -1
                    }
                }
                i2 = i2 + 1
            }
            node_types[id] = types.map_of(val_ty)
            g_typed = g_typed + 1
            return types.map_of(val_ty)
        }
        // 普通表：元素类型一致（空表字面量 [] 跳过——类型由兄弟元素决定，
        // 否则 [[1,2],[]] 会因空表 fallback i64 报"表元素类型不一致"）
        var elem_ty: i64 = -1
        var i3: i64 = 0
        while i3 < nc {
            var cell = sstate.child(id, i3)
            var val_node = sstate.child(cell, 1)
            if s_tags[val_node] == S_N_TABLE_LIT && sstate.nchild(val_node) == 0 {
                i3 = i3 + 1
                continue  // 空表：不取类型、不校验（由兄弟元素定型）
            }
            var vt = infer_expr(val_node)
            if vt < 0 {
                return -1
            }
            if elem_ty < 0 {
                elem_ty = vt
            } else {
                if vt != elem_ty && !(types.is_int(vt) && types.is_int(elem_ty)) && !(types.is_float(vt) && types.is_float(elem_ty)) {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "表元素类型不一致：" + types.type_name(elem_ty) + " 与 " + types.type_name(vt)
                    return -1
                }
            }
            i3 = i3 + 1
        }
        if elem_ty < 0 {
            elem_ty = types.named(TK_I64)  // 全空表：兜底 i64
        }
        node_types[id] = types.table_of(elem_ty)
        g_typed = g_typed + 1
        return types.table_of(elem_ty)
    }
    // TupleLit
    if tag == S_N_TUPLE_LIT {
        var nc = sstate.nchild(id)
        if nc == 0 {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "空元组 () 不支持"
            return -1
        }
        // 字段名查重
        var i: i64 = 0
        while i < nc {
            var f = sstate.child(id, i)
            var fnid = s_names[f]
            if fnid >= 0 {
                var j: i64 = 0
                while j < i {
                    var g = sstate.child(id, j)
                    if s_names[g] == fnid {
                        sm_err_line = s_lines[id]
                        sm_err_col = s_cols[id]
                        sm_err_msg = "元组字段名 '" + intern.lookup(fnid) + "' 重复"
                        return -1
                    }
                    j = j + 1
                }
            }
            i = i + 1
        }
        // 登记 tuple 类型（先占位再填值保证字段段紧凑）
        var idx = len(tuple_tys)
        var off = len(tup_names)
        table_push(tup_offs, off)
        table_push(tup_n, nc)
        table_push(tuple_tys, types.tuple_of(idx))
        var jj: i64 = 0
        while jj < nc {
            table_push(tup_names, -1)
            table_push(tup_tys, 0)
            jj = jj + 1
        }
        var i2: i64 = 0
        while i2 < nc {
            var f = sstate.child(id, i2)
            var ft = infer_expr(sstate.child(f, 0))
            if ft < 0 {
                return -1
            }
            tup_names[off + i2] = s_names[f]
            tup_tys[off + i2] = ft
            i2 = i2 + 1
        }
        var rt = types.tuple_of(idx)
        node_types[id] = rt
        g_typed = g_typed + 1
        return rt
    }
    // Call
    if tag == S_N_CALL {
        return infer_call(id)
    }
    // MethodCall
    if tag == S_N_METHOD_CALL {
        return infer_method_call(id)
    }
    sm_err_line = s_lines[id]
    sm_err_col = s_cols[id]
    sm_err_msg = "无法推断表达式（节点 " + to_string(tag) + "）"
    return -1
}

// 变参元素类型（`...T` → T；非变参 -1）。签名存的是 table<T>。
func sstate_fn_variadic_elem(sig: i64) -> i64 {
    var n = sg_nparams[sig]
    if n <= 0 {
        return -1
    }
    if sp_vars[sg_off[sig] + n - 1] != 1 {
        return -1
    }
    return types.table_elem(sp_tys[sg_off[sig] + n - 1])
}

// 函数调用推断
pub func infer_call(id: i64) -> i64 {
    var fnm = sstate.name_str(id)
    // 实参收集：Call children = [泛型槽(-1或N_TYPE_ARGS), 实参...]，
    // 实参从 children[slot_off] 起（slot_off 恒 1，统一走辅助保证一致）
    var args: table<i64> = table_new_i64()
    var off = sstate.slot_off(id)
    var nc = sstate.nchild(id) - off
    var i: i64 = 0
    while i < nc {
        table_push(args, sstate.child(id, off + i))
        i = i + 1
    }
    // 内置函数：先校验个数（-2=参数错误已报），通过后逐个推断实参
    var br = sbuiltin.builtin_call(fnm, args, id)
    if br >= -1 && br != -3 {
        // 实参类型推断（未声明变量/类型错误在此暴露；只做检查不改结果）
        var ka: i64 = 0
        while ka < nc {
            var at = infer_expr(args[ka])
            if at < 0 {
                return -1
            }
            ka = ka + 1
        }
        // table_push 特殊检查（对齐 Rust）：第 1 参数必须表变量 + 动态表 + 元素类型匹配
        if fnm == "table_push" {
            var t0 = s_tags[args[0]]
            if t0 != S_N_VAR {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "table_push() 第 1 个参数必须是表变量（不能是字面量/下标）"
                return -1
            }
            var tnm = sstate.name_str(args[0])
            var tnid = intern.intern(tnm)
            var elem = var_table_elem(tnid)
            if elem < 0 {
                // 查找失败：默认 i64
                elem = types.named(TK_I64)
            }
            var x_ty = infer_expr(args[1])
            if x_ty < 0 {
                return -1
            }
            if !stype.types_match(elem, x_ty, args[1]) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "table_push() 元素类型不匹配：表 '" + tnm + "' 的元素是 " + types.type_name(elem) + "，推入的是 " + types.type_name(x_ty)
                return -1
            }
            node_types[id] = types.named(TK_VOID)
            g_typed = g_typed + 1
            return types.named(TK_VOID)
        }
        // table_at 特殊检查（对齐 Rust）：下标必须整数
        if fnm == "table_at" {
            var i_ty = infer_expr(args[1])
            if i_ty < 0 {
                return -1
            }
            if !types.is_int(i_ty) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "table_at() 下标必须是整数，实际是 " + types.type_name(i_ty)
                return -1
            }
            node_types[id] = br
            g_typed = g_typed + 1
            return br
        }
        // eval 特殊检查（对齐 Rust）：参数必须是字符串
        if fnm == "eval" {
            var e_ty = infer_expr(args[0])
            if e_ty < 0 {
                return -1
            }
            if e_ty != TK_STR {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "eval() 参数必须是字符串，实际是 " + types.type_name(e_ty)
                return -1
            }
            node_types[id] = types.named(TK_STR)
            g_typed = g_typed + 1
            return types.named(TK_STR)
        }
        if br == -1 {
            // void
            node_types[id] = types.named(TK_VOID)
            g_typed = g_typed + 1
            return types.named(TK_VOID)
        }
        node_types[id] = br
        g_typed = g_typed + 1
        return br
    }
    if br == -2 {
        return -1
    }
    // struct 构造
    var snid = intern.intern(fnm)
    var sidx = sstate.bs_find(st_keys, snid)
    if sidx >= 0 {
        var si = st_vals[sidx]
        var nf = cls_nfld[si]
        if nc > nf {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "构造 '" + fnm + "' 最多 " + to_string(nf) + " 个参数（字段数），实际 " + to_string(nc) + " 个"
            return -1
        }
        // 字段类型匹配
        var off = cls_fldoff[si]
        var j: i64 = 0
        while j < nc {
            var at = infer_expr(args[j])
            if at < 0 {
                return -1
            }
            if !stype.types_match(fld_tys[off + j], at, args[j]) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "构造 '" + fnm + "' 参数类型不匹配：字段 '" + intern.lookup(fld_names[off + j]) + "' 期望 " + types.type_name(fld_tys[off + j]) + "，实际 " + types.type_name(at)
                return -1
            }
            j = j + 1
        }
        node_types[id] = types.struct_of(si)
        g_typed = g_typed + 1
        return types.struct_of(si)
    }
    // T3b 泛型（2026-08-14）：普通函数/struct 未命中但 gt_* 模板表命中 →
    // 泛型调用路径（构造或函数，调用点推断 + 单态化展开）
    var full_name = resolve_call_name(fnm)
    var gti = sstate.gt_find(full_name)
    if gti >= 0 && gty_is_struct[gti] == 1 {
        return infer_generic_struct_construct(full_name, gti, id, args)
    }
    if gti >= 0 && gty_is_struct[gti] == 0 {
        return infer_generic_fn_call(full_name, gti, id, args)
    }
    // 用户函数（裸调用解析：顶层 / 当前命名空间补全 / using 前缀补全）
    var sig = sstate.fn_sig(full_name)
    if sig < 0 {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "未定义的函数 '" + fnm + "'"
        return -1
    }
    // 可见性校验
    var vr = sstate.check_visibility(full_name, sig, id)
    if vr < 0 {
        return -1
    }
    var req = sg_required[sig]
    var total = sg_nparams[sig]
    var has_var = sstate.fn_has_variadic(sig) == 1
    // 变参函数：实参数无上界（固定部分 + 任意个额外元素实参）
    if nc < req || (!has_var && nc > total) {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        var cnt_desc = ""
        if has_var {
            cnt_desc = to_string(req) + "+"
        } else if req == total {
            cnt_desc = to_string(total)
        } else {
            cnt_desc = to_string(req) + "-" + to_string(total)
        }
        sm_err_msg = "函数 '" + fnm + "' 期望 " + cnt_desc + " 个参数，实际 " + to_string(nc) + " 个"
        return -1
    }
    var off = sg_off[sig]
    var j2: i64 = 0
    while j2 < nc {
        var at = infer_expr(args[j2])
        if at < 0 {
            return -1
        }
        var want = sp_tys[off + j2]
        // 变参：超过固定形参数（total-1）的实参与变参元素类型 T 匹配
        var want_fixed: bool = true
        if has_var {
            if j2 >= total - 1 {
                want = sstate_fn_variadic_elem(sig)
                want_fixed = false
            }
        }
        // 表形参（table<T>）的元素不匹配留给 A1 专用检查；非表类型 mismatch 报通用消息
        var want_is_tbl = types.kind(want) == K_TABLE
        var at_is_tbl = types.kind(at) == K_TABLE
        if !stype.types_compatible(want, at) && !stype.types_match(want, at, args[j2]) {
            if !(want_is_tbl && at_is_tbl) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "调用 '" + fnm + "' 参数类型不匹配：期望 " + types.type_name(want) + "，实际 " + types.type_name(at)
                return -1
            }
        }
        // A1：形参 table<T> 的元素类型校验——实参表字面量/动态表变量/返回表的调用，
        // 其元素类型须与 T 一致（裸 table 形参不校验，对齐 Rust）
        if want_fixed && want_is_tbl && !(want == TK_TABLE) {
            var want_elem = types.table_elem(want)
            var got_elem = arg_table_elem_ty(args[j2])
            if got_elem >= 0 {
                if !stype.types_compatible(want_elem, got_elem) {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "调用 '" + fnm + "' 表参数元素类型不匹配：期望 table<" + types.type_name(want_elem) + ">，实际 table<" + types.type_name(got_elem) + ">"
                    return -1
                }
            }
        }
        // ref 参数实参校验（对齐 Rust T0.3 by_ref）：实参必须是可寻址变量（变量/字段链），
        // 且必须是动态表（table_new_* 创建）——IR 需取地址写回
        if want_fixed && sp_refs[off + j2] == 1 {
            if !sstate.is_addressable(args[j2]) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "调用 '" + fnm + "' 的 ref 参数需要可寻址的变量实参（不能是字面量/下标/调用结果等不可取地址）"
                return -1
            }
            if s_tags[args[j2]] == S_N_VAR {
                var vname = sstate.name_str(args[j2])
                var vnid = intern.intern(vname)
                if var_dyn(vnid) != 1 {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "调用 '" + fnm + "' 的 ref 参数实参 '" + vname + "' 必须是动态表（table_new_* 创建），'" + vname + "' 是定长表"
                    return -1
                }
            }
        }
        j2 = j2 + 1
    }
    var rt = sg_ret[sig]
    node_types[id] = rt
    g_typed = g_typed + 1
    return rt
}

// ==================== 泛型调用路径（T3b 单态化 + 调用点推断）====================
// 实参表类型细化：`table_new_*()` 变量/返回的类型是裸 table（元素类型在
// var_table_elem / table_ret_elem），泛型推断需带元素类型（table<T> 匹配）。
// 例如 Box<table<i64>>(t)：t 的裸 table 若直接绑定 T 会与显式 table<i64> 冲突。
func refine_arg_ty(a: i64, t: i64) -> i64 {
    if t == TK_TABLE || t == TK_MAP {
        var te: i64 = -1
        if s_tags[a] == S_N_VAR {
            te = var_table_elem(intern.intern(sstate.name_str(a)))
        }
        if te >= 0 {
            if t == TK_MAP {
                return types.map_of(te)
            }
            return types.table_of(te)
        }
    }
    return t
}

// 显式类型实参解析（调用点 N_TYPE_ARGS → 类型实参表；-1 槽 = 无显式实参）。
// 返回实参表；解析失败返回空表且 sm_err_* 已置（调用方据 sm_err_msg 判定）。
func parse_explicit_args(id: i64) -> table<i64> {
    var out: table<i64> = table_new_i64()
    var off = sstate.slot_off(id)
    if off == 1 && sstate.nchild(id) > 0 {
        var slot = sstate.child(id, 0)
        if slot >= 0 && s_tags[slot] == S_N_TYPE_ARGS {
            out = sgen.parse_type_args_ast(slot)
            // 无显式实参 → 空表；解析失败也是空表（sm_err_* 区分）
        }
    }
    return out
}

// 泛型函数调用：`max(3, 5)`（推断）/ `max<i64>(9, 4)`（显式）/ `pick(5, "hi")`。
// 流程：显式实参解析 → 实参类型表 → 模板形参 AST 模式匹配绑定 TypeVar →
// 构造 mangled 名 → 单态化展开（instantiate_fn）→ 重写调用名 → 实例化签名
// 的常规参数检查 → 返回实例化返回类型。
pub func infer_generic_fn_call(full_name: string, gti: i64, id: i64, args: table<i64>) -> i64 {
    var nc = len(args)
    var explicit = parse_explicit_args(id)
    if len(explicit) == 0 && str_len(sm_err_msg) > 0 {
        return -1  // 显式类型实参解析失败（sm_err_* 已置）
    }
    // 实参类型表（infer_expr 已知类型）
    var arg_tys: table<i64> = table_new_i64()
    var k: i64 = 0
    while k < nc {
        var at = infer_expr(args[k])
        if at < 0 {
            return -1
        }
        at = refine_arg_ty(args[k], at)
        table_push(arg_tys, at)
        k = k + 1
    }
    // 推断类型实参（AST 模式匹配绑定 TypeVar）
    var tmpl_node = gty_node[gti]
    var args_t = sgen.infer_type_args(tmpl_node, gti, explicit, 0, arg_tys, id)
    if len(args_t) == 0 {
        return -1  // 推断失败/冲突已报错
    }
    // 单态化展开
    var mangled = sgen.mangle(full_name, args_t)
    var sig = sgen.instantiate_fn(gti, args_t, s_lines[id], s_cols[id])
    if sig < 0 {
        return -1
    }
    // 重写调用名 → mangled（irgen 按名生成；检查循环去重后走普通路径）
    s_names[id] = intern.intern(mangled)
    // 可见性校验
    var vr = sstate.check_visibility(mangled, sig, id)
    if vr < 0 {
        return -1
    }
    // 参数个数（实例化签名）
    var req = sg_required[sig]
    var total = sg_nparams[sig]
    if nc < req || nc > total {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "函数 '" + full_name + "' 期望 " + to_string(req) + " 个参数，实际 " + to_string(nc) + " 个"
        return -1
    }
    // 参数类型检查（实例化形参已具体化 → 现有类型系统自然验证）
    var off = sg_off[sig]
    var j2: i64 = 0
    while j2 < nc {
        var want = sp_tys[off + j2]
        var at = arg_tys[j2]
        if !stype.types_compatible(want, at) && !stype.types_match(want, at, args[j2]) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "调用 '" + full_name + "' 参数类型不匹配：期望 " + types.type_name(want) + "，实际 " + types.type_name(at)
            return -1
        }
        // ref 参数实参校验（对齐普通路径）
        if sp_refs[off + j2] == 1 {
            if !sstate.is_addressable(args[j2]) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "调用 '" + full_name + "' 的 ref 参数需要可寻址的变量实参（不能是字面量/下标/调用结果等不可取地址）"
                return -1
            }
        }
        j2 = j2 + 1
    }
    var rt = sg_ret[sig]
    node_types[id] = rt
    g_typed = g_typed + 1
    return rt
}

// 泛型 struct 构造：`Box<i64>(42)`（显式）/ `Box(3.14)`（推断）。
// 流程：显式实参解析 → 实参类型表 → 模板字段类型 AST 匹配绑定 TypeVar →
// 展开 struct（instantiate_struct，字段拍平）→ 重写调用名 → 实例化字段类型
// 校验 → 返回实例化 struct 类型 id。
pub func infer_generic_struct_construct(full_name: string, gti: i64, id: i64, args: table<i64>) -> i64 {
    var nc = len(args)
    var explicit = parse_explicit_args(id)
    if len(explicit) == 0 && str_len(sm_err_msg) > 0 {
        return -1  // 显式类型实参解析失败
    }
    var arg_tys: table<i64> = table_new_i64()
    var k: i64 = 0
    while k < nc {
        var at = infer_expr(args[k])
        if at < 0 {
            return -1
        }
        at = refine_arg_ty(args[k], at)
        table_push(arg_tys, at)
        k = k + 1
    }
    var tmpl_node = gty_node[gti]
    var nfld = sstate.nchild(tmpl_node) - 1
    if nc > nfld {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "构造 '" + full_name + "' 最多 " + to_string(nfld) + " 个参数（字段数），实际 " + to_string(nc) + " 个"
        return -1
    }
    // 推断类型实参（字段类型与实参匹配）
    var args_t = sgen.infer_type_args_fields(tmpl_node, gti, explicit, arg_tys, id)
    if len(args_t) == 0 {
        return -1  // 推断失败/冲突已报错
    }
    // 展开 struct（reg_struct + 字段拍平 + gin 记录）
    var si = sgen.instantiate_struct(gti, args_t)
    if si < 0 {
        return -1
    }
    var mangled = sgen.mangle(full_name, args_t)
    // 重写调用名 → mangled（irgen 构造路径按 st_keys 命中）
    s_names[id] = intern.intern(mangled)
    // 实例化字段类型校验（非 TypeVar 字段的实参匹配也在此暴露）
    var off = cls_fldoff[si]
    var j: i64 = 0
    while j < nc {
        if !stype.types_match(fld_tys[off + j], arg_tys[j], args[j]) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "构造 '" + mangled + "' 参数类型不匹配：字段 '" + intern.lookup(fld_names[off + j]) + "' 期望 " + types.type_name(fld_tys[off + j]) + "，实际 " + types.type_name(arg_tys[j])
            return -1
        }
        j = j + 1
    }
    var rt = types.struct_of(si)
    node_types[id] = rt
    g_typed = g_typed + 1
    return rt
}

// 方法调用推断（命名空间函数 / struct 方法转发）
pub func infer_method_call(id: i64) -> i64 {
    // MethodCall 接收者 = children[slot_off]（新布局 children[0]=泛型槽→偏移 1；
    // 旧布局无槽→children[0]=接收者。slot_off 统一判定保证自举双兼容）
    var recv = sstate.child(id, sstate.slot_off(id))
    var mname = sstate.name_str(id)
    var args: table<i64> = table_new_i64()
    var nc = sstate.nchild(id)
    var off = sstate.slot_off(id)  // 泛型槽偏移（新布局恒 1，旧布局 0）
    var i: i64 = off + 1
    while i < nc {
        table_push(args, sstate.child(id, i))
        i = i + 1
    }
    // 接收者是命名空间路径（Var 未绑定）→ ns 调用
    var full = ""
    if s_tags[recv] == S_N_VAR {
        var rname = sstate.name_str(recv)
        var rnid = intern.intern(rname)
        var rt2 = lv_find(rnid)
        if rt2 < 0 {
            rt2 = gb_find(rnid)
        }
        if rt2 < 0 {
            // 未绑定：命名空间前缀
            full = rname + "::" + mname
        } else {
            // struct 实例方法转发
            return infer_struct_method(recv, rt2, mname, args, id)
        }
    } else {
        // Path 接收者 → ns 调用
        full = recv_path_name(recv) + "::" + mname
    }
    if full == "::" + mname {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "方法调用的对象必须是 struct 实例或 struct 名，实际是 " + types.type_name(infer_expr(recv))
        return -1
    }
    var sig = sstate.fn_sig(full)
    if sig < 0 {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "命名空间函数 '" + full + "' 未定义"
        return -1
    }
    // 可见性校验
    var vr = sstate.check_visibility(full, sig, id)
    if vr < 0 {
        return -1
    }
    var req = sg_required[sig]
    var total = sg_nparams[sig]
    var has_var = sstate.fn_has_variadic(sig) == 1
    if len(args) < req || (!has_var && len(args) > total) {
        var cnt_desc2 = ""
        if has_var {
            cnt_desc2 = to_string(req) + "+"
        } else if req == total {
            cnt_desc2 = to_string(total)
        } else {
            cnt_desc2 = to_string(req) + "-" + to_string(total)
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "命名空间函数 '" + full + "' 期望 " + cnt_desc2 + " 个参数，实际 " + to_string(len(args)) + " 个"
        return -1
    }
    var off = sg_off[sig]
    var j: i64 = 0
    while j < len(args) {
        var at = infer_expr(args[j])
        if at < 0 {
            return -1
        }
        var want = sp_tys[off + j]
        if has_var {
            if j >= total - 1 {
                want = sstate_fn_variadic_elem(sig)   // 变参：元素类型匹配
            }
        }
        if !stype.types_compatible(want, at) && !stype.types_match(want, at, args[j]) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "调用 '" + full + "' 参数类型不匹配：期望 " + types.type_name(want) + "，实际 " + types.type_name(at)
            return -1
        }
        j = j + 1
    }
    var rt = sg_ret[sig]
    node_types[id] = rt
    g_typed = g_typed + 1
    return rt
}

// 接收者路径名拼接（Segment 链 / FieldAccess 链 / Var / Path 统一递归）
pub func recv_path_name(recv: i64) -> string {
    var tag = s_tags[recv]
    if tag == S_N_VAR {
        return sstate.name_str(recv)
    }
    if tag == S_N_FIELD_ACCESS {
        // FieldAccess[name=字段名, children=[基址]]：字段名在 name 字段
        var base = sstate.child(recv, 0)
        var bp = recv_path_name(base)
        var fnm = sstate.name_str(recv)
        if bp == "" {
            return fnm
        }
        return bp + "::" + fnm
    }
    if tag == S_N_PATH {
        // Path(children=[Segment...])：逐段拼接
        var out: string = ""
        var nc = sstate.nchild(recv)
        var i: i64 = 0
        while i < nc {
            if i > 0 {
                out = out + "::"
            }
            out = out + sstate.name_str(sstate.child(recv, i))
            i = i + 1
        }
        return out
    }
    // 兜底：逐 child 拼接名字
    var out2: string = ""
    var nc2 = sstate.nchild(recv)
    var j: i64 = 0
    while j < nc2 {
        if j > 0 {
            out2 = out2 + "::"
        }
        out2 = out2 + sstate.name_str(sstate.child(recv, j))
        j = j + 1
    }
    return out2
}

// struct 实例方法转发
pub func infer_struct_method(recv: i64, recv_ty: i64, mname: string, args: table<i64>, id: i64) -> i64 {
    var bk = types.kind(recv_ty)
    if bk != K_STRUCT {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "方法调用的对象必须是 struct 实例或 struct 名，实际是 " + types.type_name(recv_ty)
        return -1
    }
    var si = types.low(recv_ty)
    var sname = intern.lookup(st_keys[si])
    var full = sname + "::" + mname
    var sig = sstate.fn_sig(full)
    if sig < 0 {
        // T3b 泛型方法（2026-08-14）：接收者是实例化 struct（如 Box$i64）→
        // 目标函数 = 模板方法（Box::get）→ 从接收者类型提取类型实参 → 展开
        var rec = sstate.gin_find(sname)
        if rec >= 0 && gin_is_struct[rec] == 1 {
            var tmpl_full = intern.lookup(gty_keys[gin_tmpl[rec]])  // "Box"
            var tmpl_method = tmpl_full + "::" + mname              // "Box::get"
            var m_gti = sstate.gt_find(tmpl_method)
            if m_gti >= 0 && gty_is_struct[m_gti] == 0 {
                var gr = infer_generic_method(rec, m_gti, tmpl_method, recv, recv_ty, args, id)
                if gr >= 0 {
                    return gr
                }
                if str_len(sm_err_msg) > 0 {
                    return -1  // 泛型方法推断/展开失败（已报错）
                }
            }
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "struct '" + sname + "'（含继承链）没有方法 '" + mname + "'"
        return -1
    }
    // 方法函数必须 pub
    var vr = sstate.check_visibility(full, sig, id)
    if vr < 0 {
        return -1
    }
    // 方法：首参 = 接收者（按引用）。参数个数（含接收者对象，对齐 Rust）：
    // required = sg_required（含接收者必选数），total = 形参数，n_args = args+1
    var req_m = sg_required[sig]
    var total = sg_nparams[sig]
    var has_var = sstate.fn_has_variadic(sig) == 1
    var n_args = len(args) + 1
    if n_args < req_m || (!has_var && n_args > total) {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        var cnt_m = ""
        if has_var {
            cnt_m = to_string(req_m) + "+"
        } else if req_m == total {
            cnt_m = to_string(total)
        } else {
            cnt_m = to_string(req_m) + "-" + to_string(total)
        }
        sm_err_msg = "方法 '" + full + "' 期望 " + cnt_m + " 个参数（含接收者对象），实际 " + to_string(n_args) + " 个"
        return -1
    }
    // 接收者类型匹配（首参）
    var off = sg_off[sig]
    var want = sp_tys[off]
    if !stype.types_compatible(want, recv_ty) {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "方法 '" + full + "' 首参类型不匹配：期望 " + types.type_name(want) + "，实际 " + types.type_name(recv_ty)
        return -1
    }
    var j: i64 = 0
    while j < len(args) {
        var at = infer_expr(args[j])
        if at < 0 {
            return -1
        }
        var want2 = sp_tys[off + 1 + j]
        if has_var {
            if 1 + j >= total - 1 {
                want2 = sstate_fn_variadic_elem(sig)   // 变参：元素类型匹配
            }
        }
        if !stype.types_compatible(want2, at) && !stype.types_match(want2, at, args[j]) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "方法 '" + full + "' 参数类型不匹配：期望 " + types.type_name(want2) + "，实际 " + types.type_name(at)
            return -1
        }
        j = j + 1
    }
    var rt = sg_ret[sig]
    node_types[id] = rt
    g_typed = g_typed + 1
    return rt
}

// ==================== 泛型方法调用（T3b） ====================
// 接收者 = 实例化 struct（rec 为其 gin 记录），目标 = 模板方法（tmpl_method
// 如 "Box::get"）。类型实参：首参（接收者，Box<T> ↔ recv_ty）匹配 + 其余实参
// 推断；然后展开方法模板（mangled = Box$i64::get，与 irgen 方法分派一致）。
// 返回实例化返回类型；失败 -1（推断/展开失败已报错；未报错 = 不适用）。
func infer_generic_method(rec: i64, m_gti: i64, tmpl_method: string, recv: i64, recv_ty: i64, args: table<i64>, id: i64) -> i64 {
    // 显式类型实参（MethodCall 的 N_TYPE_ARGS，`b.get<i64>(...)`）
    var explicit = parse_explicit_args(id)
    if len(explicit) == 0 && str_len(sm_err_msg) > 0 {
        return -1
    }
    // 实参类型表：接收者为首参（类型 = 实例化 struct）
    var m_args_t: table<i64> = table_new_i64()
    table_push(m_args_t, recv_ty)
    var k: i64 = 0
    while k < len(args) {
        var at = infer_expr(args[k])
        if at < 0 {
            return -1
        }
        table_push(m_args_t, at)
        k = k + 1
    }
    // 推断类型实参（首参 Box<T> ↔ recv_ty 绑定 T，其余实参补全）
    var tmpl_node = gty_node[m_gti]
    var args_t = sgen.infer_type_args(tmpl_node, m_gti, explicit, 0, m_args_t, id)
    if len(args_t) == 0 {
        return -1  // 推断失败/冲突已报错
    }
    // 展开方法模板（mangled = Box$i64::get，与 irgen gen_method_call 分派名一致）
    var mangled = sgen.mangle(tmpl_method, args_t)
    var sig2 = sgen.instantiate_fn(m_gti, args_t, s_lines[id], s_cols[id])
    if sig2 < 0 {
        return -1
    }
    // 可见性校验
    var vr = sstate.check_visibility(mangled, sig2, id)
    if vr < 0 {
        return -1
    }
    // 参数个数（含接收者对象）
    var req_m = sg_required[sig2]
    var total = sg_nparams[sig2]
    var n_args = len(args) + 1
    if n_args < req_m || n_args > total {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "方法 '" + tmpl_method + "' 期望 " + to_string(req_m) + "-" + to_string(total) + " 个参数（含接收者对象），实际 " + to_string(n_args) + " 个"
        return -1
    }
    // 接收者类型匹配（首参 = 实例化 struct，与实例化形参一致）
    var off = sg_off[sig2]
    var want = sp_tys[off]
    if !stype.types_compatible(want, recv_ty) {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "方法 '" + tmpl_method + "' 首参类型不匹配：期望 " + types.type_name(want) + "，实际 " + types.type_name(recv_ty)
        return -1
    }
    // 其余实参类型检查（实例化形参已具体化）
    var j: i64 = 0
    while j < len(args) {
        var at = infer_expr(args[j])
        if at < 0 {
            return -1
        }
        var want2 = sp_tys[off + 1 + j]
        if !stype.types_compatible(want2, at) && !stype.types_match(want2, at, args[j]) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "方法 '" + tmpl_method + "' 参数类型不匹配：期望 " + types.type_name(want2) + "，实际 " + types.type_name(at)
            return -1
        }
        j = j + 1
    }
    var rt = sg_ret[sig2]
    node_types[id] = rt
    g_typed = g_typed + 1
    return rt
}

}
