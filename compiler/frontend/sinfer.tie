type tie<class>
// compiler/frontend/sinfer.tie —— T2.6 表达式类型推断（模块拆分）
// ============================================================
// 里程碑：自举 v2 计划 T2.6（.omo/plans/self-hosting-v2.md）完整语义分析
// 拆分为 8 模块之一（本文件 = 表达式类型推断 + 调用解析 + 作用域辅助）。
// 对应 proto/semantic.tie 1980-2112（作用域辅助）+ 2115-2645（infer_expr）
// + 2652-2704（resolve_call_name）+ 2706-2896（infer_call/infer_method_call）
// + 2899-3003（recv_path_name/infer_struct_method）逻辑搬移。
// 依赖：./sstate.tie（AST 全局 + 符号表 + 工具）+ ./stype.tie（类型匹配）+
// ./sbuiltin.tie（内置函数签名）。树式无环：由 scollect.tie import。
import "./sbuiltin.tie"
import "./sgen.tie"

namespace sinfer {

// ==================== 作用域辅助 ====================
// 查局部作用域（返回类型 id；-1 = 未声明）
pub func lv_find(nid: i64) -> i64 {
    var idx = sstate.bs_find(lv_keys, nid)
    if idx < 0 {
        return -1
    }
    return lv_vals[idx]
}
pub func lv_const_of(nid: i64) -> i64 {
    var idx = sstate.bs_find(lv_keys, nid)
    if idx < 0 {
        return 0
    }
    return lv_const[idx]
}
pub func lv_telem_of(nid: i64) -> i64 {
    var idx = sstate.bs_find(lv_keys, nid)
    if idx < 0 {
        return -1
    }
    return lv_telem[idx]
}
pub func lv_dyn_of(nid: i64) -> i64 {
    var idx = sstate.bs_find(lv_keys, nid)
    if idx < 0 {
        return 0
    }
    return lv_dyn[idx]
}

// 局部作用域插入（五表同步；已存在覆盖，对齐 Rust scope.insert）
pub func lv_insert(nid: i64, ty: i64, is_const: i64, telem: i64, dyn: i64) -> i64 {
    var pos0 = sstate.bs_find(lv_keys, nid)
    if pos0 >= 0 {
        lv_vals[pos0] = ty
        lv_const[pos0] = is_const
        lv_telem[pos0] = telem
        lv_dyn[pos0] = dyn
        return pos0
    }
    var n = len(lv_keys)
    var lo: i64 = 0
    var hi: i64 = n - 1
    var pos: i64 = n
    while lo <= hi {
        var mid = (lo + hi) / 2
        if lv_keys[mid] < nid {
            lo = mid + 1
        } else {
            pos = mid
            hi = mid - 1
        }
    }
    table_push(lv_keys, 0)
    table_push(lv_vals, 0)
    table_push(lv_const, 0)
    table_push(lv_telem, 0)
    table_push(lv_dyn, 0)
    var i: i64 = n
    while i > pos {
        lv_keys[i] = lv_keys[i - 1]
        lv_vals[i] = lv_vals[i - 1]
        lv_const[i] = lv_const[i - 1]
        lv_telem[i] = lv_telem[i - 1]
        lv_dyn[i] = lv_dyn[i - 1]
        i = i - 1
    }
    lv_keys[pos] = nid
    lv_vals[pos] = ty
    lv_const[pos] = is_const
    lv_telem[pos] = telem
    lv_dyn[pos] = dyn
    return pos
}

// 全局变量查询（返回类型 id；-1 = 未声明）
pub func gb_find(nid: i64) -> i64 {
    var idx = sstate.bs_find(gb_keys, nid)
    if idx < 0 {
        return -1
    }
    return gb_vals[idx]
}
pub func gb_const_of(nid: i64) -> i64 {
    var idx = sstate.bs_find(gb_keys, nid)
    if idx < 0 {
        return 0
    }
    return gb_const[idx]
}
pub func gb_telem_of(nid: i64) -> i64 {
    var idx = sstate.bs_find(gb_keys, nid)
    if idx < 0 {
        return -1
    }
    return gb_telem[idx]
}

// 表元素类型（变量名）：局部 → 全局 → -1
pub func var_table_elem(nid: i64) -> i64 {
    var i = sstate.bs_find(lv_keys, nid)
    if i >= 0 {
        return lv_telem[i]
    }
    var j = sstate.bs_find(gb_keys, nid)
    if j >= 0 {
        return gb_telem[j]
    }
    return -1
}
pub func var_dyn(nid: i64) -> i64 {
    var i = sstate.bs_find(lv_keys, nid)
    if i >= 0 {
        return lv_dyn[i]
    }
    var j = sstate.bs_find(gb_keys, nid)
    if j >= 0 {
        return 1
    }
    return 0
}

// 函数返回表元素类型查询（fn 名 -> 元素类型；-1 无）
pub func table_ret_elem(fn_name: string) -> i64 {
    var nid = intern.intern(fn_name)
    var idx = sstate.bs_find(tre_keys, nid)
    if idx >= 0 {
        return tre_vals[idx]
    }
    var bi = sstate.bs_find(tre_bi_keys, nid)
    if bi >= 0 {
        return tre_bi_vals[bi]
    }
    return -1
}

// 从实参表达式节点推断表元素类型（对齐 Rust arg_table_elem_ty）：
// - 表字面量 TableLit：取首单元格值类型（空表 → i64）
// - 变量 Var：查局部/全局表的元素类型（lv_telem/gb_telem）
// - 调用 Call：查返回表元素类型（table_ret_elem）
// 返回元素类型 id；-1 = 无法推断（非表实参或裸表）
pub func arg_table_elem_ty(a: i64) -> i64 {
    var tag = s_tags[a]
    if tag == S_N_TABLE_LIT {
        var nc = sstate.nchild(a)
        if nc == 0 {
            return types.named(TK_I64)
        }
        // 表字面量：取首元素值类型（cell 结构 [id, 值]）
        var first = sstate.child(a, 0)
        var vt = infer_expr(sstate.child(first, 1))
        if vt < 0 {
            return -1
        }
        return vt
    }
    if tag == S_N_VAR {
        var nm = sstate.name_str(a)
        var nid = intern.intern(nm)
        var te = var_table_elem(nid)
        if te >= 0 {
            return te
        }
        return -1
    }
    if tag == S_N_CALL {
        var fnm = sstate.name_str(a)
        // 动态表构造：table_new_i64 → i64 等
        if fnm == "table_new_i64" {
            return types.named(TK_I64)
        }
        if fnm == "table_new_f64" {
            return types.named(TK_F64)
        }
        if fnm == "table_new_string" {
            return types.named(TK_STR)
        }
        if fnm == "table_new_bool" {
            return types.named(TK_BOOL)
        }
        // 返回表的函数：用解析后全名查
        var full = resolve_call_name(fnm)
        return table_ret_elem(full)
    }
    return -1
}

// ==================== 裸调用名解析（M2.1.7） ====================
// 候选 1：顶层裸名；候选 2：当前命名空间前缀补全（逐级外层）；
// 候选 3：using 引入的命名空间。返回实际注册键（全名）。
// T3b 泛型扩展：候选命中判定同时覆盖普通函数（fn_sig）与泛型模板（gt_find）
// ——模板不进入 fn_keys，裸调用名解析须能定位到 gt_* 表。
pub func resolve_call_name(name: string) -> string {
    var nid = intern.intern(name)
    if sstate.fn_sig(name) >= 0 {
        return name
    }
    if sstate.gt_find(name) >= 0 {
        return name
    }
    // 候选 2：当前命名空间逐级外层补全
    if ns_top > 0 {
        var depth: i64 = ns_top
        while depth >= 0 {
            var full: string = ""
            var i: i64 = 0
            while i < depth {
                if i > 0 {
                    full = full + "::"
                }
                full = full + intern.lookup(ns_stack[i])
                i = i + 1
            }
            var cand: string = ""
            if full != "" {
                cand = full + "::" + name
            } else {
                cand = name
            }
            if sstate.fn_sig(cand) >= 0 || sstate.gt_find(cand) >= 0 {
                return cand
            }
            depth = depth - 1
        }
    }
    // 候选 3：using 引入的命名空间
    var off: i64 = 0
    var u: i64 = 0
    while u < len(using_lens) {
        var ln = using_lens[u]
        var full: string = ""
        var i: i64 = 0
        while i < ln {
            if i > 0 {
                full = full + "::"
            }
            full = full + intern.lookup(using_prefixes[off + i])
            i = i + 1
        }
        var cand = full + "::" + name
        if sstate.fn_sig(cand) >= 0 || sstate.gt_find(cand) >= 0 {
            return cand
        }
        off = off + ln
        u = u + 1
    }
    return name
}

// ==================== 表达式类型推断 ====================
// infer_expr(id) -> 类型 id；-1 = 错误（g_err_* 已置）
pub func infer_expr(id: i64) -> i64 {
    var tag = s_tags[id]
    // 字面量
    if tag == 0 {
        // S1.3 L3 后缀字面量：aux = 后缀类型 TyKw（-1 = 无后缀 → i64）
        // 批次 2（i128/u128）：后缀类型含 TK_I128(21)/TK_U128(22)——
        // 原 `sfx <= 9` 只覆盖 i8..f64，i128/u128 会落默认 i64 槽。
        var sfx = s_aux[id]
        if (sfx >= 0 && sfx <= 9) || sfx == TK_I128 || sfx == TK_U128 {
            node_types[id] = types.named(sfx)
            g_typed = g_typed + 1
            return types.named(sfx)
        }
        node_types[id] = types.named(TK_I64)
        g_typed = g_typed + 1
        return types.named(TK_I64)
    }
    if tag == 1 {
        // S1.3 L3 浮点后缀：aux = f32(8)/f64(9)（parser 已定，无后缀默认 f64）
        var sfx2 = s_aux[id]
        if sfx2 == TK_F32 {
            node_types[id] = types.named(TK_F32)
            g_typed = g_typed + 1
            return types.named(TK_F32)
        }
        node_types[id] = types.named(TK_F64)
        g_typed = g_typed + 1
        return types.named(TK_F64)
    }
    if tag == 2 {
        node_types[id] = types.named(TK_STR)
        g_typed = g_typed + 1
        return types.named(TK_STR)
    }
    if tag == 3 {
        node_types[id] = types.named(TK_CHAR)
        g_typed = g_typed + 1
        return types.named(TK_CHAR)
    }
    if tag == 4 {
        node_types[id] = types.named(TK_BOOL)
        g_typed = g_typed + 1
        return types.named(TK_BOOL)
    }
    if tag == 5 {
        node_types[id] = types.named(TK_TRIT)
        g_typed = g_typed + 1
        return types.named(TK_TRIT)
    }
    // S3.3 准引用/插值表达式：code 类型（编译期 AST 片段值）。宏体不经过
    // 语义检查（编译期由 interp 执行）；普通代码里 code 值被 scheck 的
    // 变量类型检查/参数类型匹配拦截（code 只能在宏中使用）。
    if tag == 136 {   // N_CODE_LIT（准引用字面量）
        node_types[id] = types.named(TK_CODE)
        g_typed = g_typed + 1
        return types.named(TK_CODE)
    }
    if tag == 137 {   // N_CODE_INTERP（插值表达式）
        node_types[id] = types.named(TK_CODE)
        g_typed = g_typed + 1
        return types.named(TK_CODE)
    }
    // Var
    if tag == S_N_VAR {
        var nm = sstate.name_str(id)
        var nid = intern.intern(nm)
        var lt = lv_find(nid)
        if lt >= 0 {
            // S2.2 闭包捕获分析：闭包体检查期间（g_clo_depth > 0）引用变量，
            // 且该变量既非闭包参数（cl_params 段）、也非闭包体内局部（cl_locals
            // 段）→ 属于登记时快照中的外层变量 → 捕获。登记 (名 id, 类型 id)
            // 到 cl_capkeys/cl_capvals（当前闭包段内查重，重复引用只登记一次）。
            if g_clo_depth > 0 && g_clo_cur >= 0 {
                var ci = g_clo_cur
                var is_param = sstate.seg_has(cl_params, cl_paramoff[ci], cl_nparams[ci], nid)
                if is_param == 0 {
                    var is_local = sstate.seg_has(cl_locals, cl_locloff[ci], len(cl_locals) - cl_locloff[ci], nid)
                    if is_local == 0 {
                        var is_cap = sstate.seg_has(cl_capkeys, cl_capoff[ci], len(cl_capkeys) - cl_capoff[ci], nid)
                        if is_cap == 0 {
                            table_push(cl_capkeys, nid)
                            table_push(cl_capvals, lt)
                        }
                    }
                }
            }
            node_types[id] = lt
            g_typed = g_typed + 1
            return lt
        }
        var gt = gb_find(nid)
        if gt >= 0 {
            node_types[id] = gt
            g_typed = g_typed + 1
            return gt
        }
        // S2.2 命名函数提升：变量查找失败后查函数签名（裸名 + 命名空间补全），
        // 命中 → 构造 fn 类型（命名函数名可直接用作函数值，如 `var f: fn(A)->R
        // = my_func`）。泛型模板（gt_find）暂不提升（单态化后函数值未定义）。
        var full_f = resolve_call_name(nm)
        var fsig = sstate.fn_sig(full_f)
        if fsig >= 0 {
            var fret = sg_ret[fsig]
            var fnp = sg_nparams[fsig]
            var foff = sg_off[fsig]
            var fpts: table<i64> = table_new_i64()
            var k2: i64 = 0
            while k2 < fnp {
                table_push(fpts, sp_tys[foff + k2])
                k2 = k2 + 1
            }
            var fnty = types.fn_of(fret, fpts)
            node_types[id] = fnty
            g_typed = g_typed + 1
            return fnty
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "未声明的变量 '" + nm + "'"
        return -1
    }
    // Range
    if tag == S_N_RANGE {
        var st = infer_expr(sstate.child(id, 0))
        if st < 0 {
            return -1
        }
        var en = infer_expr(sstate.child(id, 1))
        if en < 0 {
            return -1
        }
        if !types.is_int(st) || !types.is_int(en) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "范围两端必须是整数"
            return -1
        }
        node_types[id] = types.named(TK_I64)
        g_typed = g_typed + 1
        return types.named(TK_I64)
    }
    // Unary
    if tag == S_N_UNARY {
        var op = s_vals[id]
        var operand = infer_expr(sstate.child(id, 0))
        if operand < 0 {
            return -1
        }
        if op == 0 {
            // Neg：数字
            if !types.is_number(operand) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "取负运算的操作数必须是数字"
                return -1
            }
        } else if op == 1 {
            // Not：bool 或 trit
            if !types.is_bool_like(operand) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "逻辑非的操作数必须是 bool"
                return -1
            }
        } else {
            // 自增/自减：可写数字变量
            var target = sstate.child(id, 0)
            if s_tags[target] != S_N_VAR {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "自增/自减的操作数必须是可写数字变量"
                return -1
            }
            var nm = sstate.name_str(target)
            var nid2 = intern.intern(nm)
            if lv_const_of(nid2) == 1 {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "不能对 const 变量 '" + nm + "' 自增/自减"
                return -1
            }
            if !types.is_number(operand) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "自增/自减的操作数必须是可写数字变量"
                return -1
            }
        }
        node_types[id] = operand
        g_typed = g_typed + 1
        return operand
    }
    // Binary
    if tag == S_N_BINARY {
        var op = s_vals[id]
        var lhs = infer_expr(sstate.child(id, 0))
        if lhs < 0 {
            return -1
        }
        var rhs = infer_expr(sstate.child(id, 1))
        if rhs < 0 {
            return -1
        }
        // 枚举 ==/!= 比较拦截（一期）：枚举按 tag 比较语义未定义，报错
        if op == 5 || op == 6 {
            if types.kind(lhs) == K_ENUM || types.kind(rhs) == K_ENUM {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "枚举暂不支持 == 比较"
                return -1
            }
        }
        // 两侧类型一致（trit×i64 例外；int×float 混用；string+string 拼接）
        var type_ok: bool = false
        if lhs == rhs {
            type_ok = true
        } else if types.is_bool_like(lhs) && types.is_bool_like(rhs) {
            type_ok = true
        } else if lhs == TK_TRIT && types.is_int(rhs) {
            type_ok = true
        } else if rhs == TK_TRIT && types.is_int(lhs) {
            type_ok = true
        } else if types.is_int(lhs) && types.is_int(rhs) {
            type_ok = true
        } else if types.is_float(lhs) && types.is_float(rhs) {
            type_ok = true
        } else if types.is_int(lhs) && types.is_float(rhs) {
            type_ok = true
        } else if types.is_float(lhs) && types.is_int(rhs) {
            type_ok = true
        } else if op == 0 && lhs == TK_STR && rhs == TK_STR {
            // 字符串拼接
            type_ok = true
        } else if op >= 5 && op <= 10 && types.kind(lhs) == K_TUPLE &&
            types.kind(rhs) == K_TUPLE && stype.tuple_equal(lhs, rhs) {
            // 元组比较：结构相等（逐字段类型一致，嵌套元组递归）即合法——
            // `(1,2) == (1,2)` 两侧各登记独立 tuple 类型 id，须按字段结构
            // 比较（对齐 Rust 行为）；==/!= 放行，< > <= >= 在下文 op 分组
            // 检查中报「比较运算符不能用于 tuple」
            type_ok = true
        }
        if !type_ok {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "二元运算两侧类型不一致：" + types.type_name(lhs) + " 与 " + types.type_name(rhs)
            return -1
        }
        // 按运算符分组校验
        if op <= 4 || op == 13 || op == 14 || op == 15 || op == 16 || op == 17 {
            // 算术/位运算：数字（位运算需整数）
            if !types.is_number(lhs) && lhs != TK_STR && !(lhs == TK_TRIT || rhs == TK_TRIT) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "算术运算符不能用于 " + types.type_name(lhs)
                return -1
            }
            if op >= 13 && !types.is_int(lhs) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "位运算只支持整数，不能用于 " + types.type_name(lhs)
                return -1
            }
            if op == 4 && !types.is_int(lhs) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "取模运算只支持整数"
                return -1
            }
        } else if op <= 10 {
            // 比较：数字/字符串/bool/trit；元组仅 ==/!=（逐字段），< > <= >= 仍报错
            if types.kind(lhs) == K_TUPLE {
                if op == 5 || op == 6 {
                    // 元组相等比较：合法（结果 bool，rt 在下方比较分支统一处理）
                } else {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "比较运算符不能用于 " + types.type_name(lhs)
                    return -1
                }
            } else if !types.is_number(lhs) && lhs != TK_STR && !types.is_bool_like(lhs) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "比较运算符不能用于 " + types.type_name(lhs)
                return -1
            }
        } else if op <= 12 {
            // 逻辑：bool 或 trit
            if !types.is_bool_like(lhs) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "逻辑运算符两侧必须是 bool（或两侧同为 trit）"
                return -1
            }
        }
        var rt = lhs
        if types.is_int(lhs) && types.is_float(rhs) {
            rt = rhs
        }
        if types.is_float(lhs) && types.is_int(rhs) {
            rt = lhs
        }
        // S1.3 A1 混合宽度整数运算：结果 = 宽度更大者（i8 + i16 → i16 算术；
        // i8 + u16 → 16 位算术。同宽度 i/u 混合 → 保持 lhs（LLVM 位模式一致，
        // 无符号性区分——与 tie 现状有符号语义保持一致）。
        // L2 上下文推断：字面量侧常量在对方窄类型范围内 → 按对方类型
        // （`f + 1`：f 是 u8，常量 1 在 u8 范围 → u8 算术，结果 u8）
        if types.is_int(lhs) && types.is_int(rhs) {
            var l_node = sstate.child(id, 0)
            var r_node = sstate.child(id, 1)
            var l_lit = s_tags[l_node] == 0
            var r_lit = s_tags[r_node] == 0
            var lw = stype.int_width(lhs)
            var rw = stype.int_width(rhs)
            if l_lit && !r_lit {
                // 左字面量、右变量：左常量在右类型范围 → 右类型；否则宽者
                if lit_in_range(s_vals[l_node], rhs) {
                    rt = rhs
                } else if rw > lw {
                    rt = rhs
                } else {
                    rt = lhs
                }
            } else if r_lit && !l_lit {
                // 右字面量、左变量：右常量在左类型范围 → 左类型；否则宽者
                if lit_in_range(s_vals[r_node], lhs) {
                    rt = lhs
                } else if lw > rw {
                    rt = lhs
                } else {
                    rt = rhs
                }
            } else if !l_lit && !r_lit {
                // 两侧变量：宽者
                if rw > lw {
                    rt = rhs
                } else {
                    rt = lhs
                }
            }
            // 两侧字面量：无上下文 → 保持 i64（默认），由目标标注截断
        }
        // S1.3 f32 算术：f32 与 f64 混合 → f64；f32+f32 → 提升 f64 计算
        // （f32 仅 extern/repr(C) 互操作，算术统一 f64——int-model 未决问题 1）
        if (lhs == TK_F32 || rhs == TK_F32) && (lhs == TK_F64 || rhs == TK_F64) {
            rt = types.named(TK_F64)
        }
        // trit × i64 混合（t + 5 / 5 - t）：结果 i64（irgen 生成 i64 运算并
        // sext trit 侧——曾按 lhs 标 TK_TRIT，IR 结果 i64 却被当 i8 转换/打印）
        if lhs == TK_TRIT && types.is_int(rhs) {
            rt = rhs
        }
        if rhs == TK_TRIT && types.is_int(lhs) {
            rt = lhs
        }
        if op <= 10 && op >= 5 {
            // 比较/逻辑：结果 bool
            rt = types.named(TK_BOOL)
        }
        node_types[id] = rt
        g_typed = g_typed + 1
        return rt
    }
    // Ternary
    if tag == S_N_TERNARY {
        var cond = infer_expr(sstate.child(id, 0))
        if cond < 0 {
            return -1
        }
        if !types.is_bool_like(cond) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "三目条件必须是 bool"
            return -1
        }
        var th = infer_expr(sstate.child(id, 1))
        if th < 0 {
            return -1
        }
        var el = infer_expr(sstate.child(id, 2))
        if el < 0 {
            return -1
        }
        if th != el && !(types.is_int(th) && types.is_int(el)) && !(types.is_float(th) && types.is_float(el)) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "三目两分支类型不一致：" + types.type_name(th) + " 与 " + types.type_name(el)
            return -1
        }
        node_types[id] = th
        g_typed = g_typed + 1
        return th
    }
    // Path：不能作值
    if tag == S_N_PATH {
        // Path 名字在 Segment children 中（name 字段为空），拼接完整路径
        var pname = recv_path_name(id)
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "命名空间路径 '" + pname + "' 不能作为值使用（只能用于调用，如 'x::f()'）"
        return -1
    }
    // TypeLit：仅 switch case
    if tag == S_N_TYPE_LIT {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "类型字面量只能用作 switch 的 case 类型匹配"
        return -1
    }
    // S1.2 I1 asm!：unsafe 上下文 + 操作数表达式推断；返回 void
    if tag == S_N_ASM {
        if g_unsafe_depth == 0 {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "asm! 内联汇编必须在 unsafe 块或 unsafe 函数中使用（安全代码禁止触底）"
            return -1
        }
        var nc = sstate.nchild(id)
        var k: i64 = 0
        while k < nc {
            var op = sstate.child(id, k)
            var e = sstate.child(op, 0)
            var ot = infer_expr(e)
            if ot < 0 {
                return -1
            }
            k = k + 1
        }
        node_types[id] = types.named(TK_VOID)
        g_typed = g_typed + 1
        return types.named(TK_VOID)
    }
    // Index
    if tag == S_N_INDEX {
        var base = infer_expr(sstate.child(id, 0))
        if base < 0 {
            return -1
        }
        var idx = infer_expr(sstate.child(id, 1))
        if idx < 0 {
            return -1
        }
        if types.is_table(base) {
            var elem = types.table_elem(base)
            if elem < 0 {
                // 表变量：查 var_table_elem
                var base_node = sstate.child(id, 0)
                if s_tags[base_node] == S_N_VAR {
                    var nm = sstate.name_str(base_node)
                    var nid = intern.intern(nm)
                    var te = var_table_elem(nid)
                    if te >= 0 {
                        node_types[id] = te
                        g_typed = g_typed + 1
                        return te
                    }
                }
                // 裸 table：元素类型未知，默认 i64
                node_types[id] = types.named(TK_I64)
                g_typed = g_typed + 1
                return types.named(TK_I64)
            }
            node_types[id] = elem
            g_typed = g_typed + 1
            return elem
        }
        if base == TK_STR {
            if !types.is_int(idx) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "下标必须是整数，实际是 " + types.type_name(idx)
                return -1
            }
            // 对齐 Rust 版：s[i] → 取第 i 个字符（char），非 string
            node_types[id] = types.named(TK_CHAR)
            g_typed = g_typed + 1
            return types.named(TK_CHAR)
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "下标访问的对象必须是表或字符串，实际是 " + types.type_name(base)
        return -1
    }
    // FieldAccess
    if tag == S_N_FIELD_ACCESS {
        var base_node = sstate.child(id, 0)
        var fnm = sstate.name_str(id)
        // 枚举变体常量探测（EnumName.Variant）：base 是未绑定变量（枚举名）时，
        // 查 en_keys 命中 → 变体引用。必须在 infer_expr(base) 之前拦截——
        // 否则枚举名被当未声明变量报错。无 payload 变体 = 常量值；带 payload
        // 变体的裸引用报错（须用 EnumName.Variant(...) 构造）。
        if s_tags[base_node] == S_N_VAR {
            var bname = sstate.name_str(base_node)
            var eidx = sstate.bs_find(en_keys, intern.intern(bname))
            if eidx >= 0 {
                var ei = en_vals[eidx]
                var varoff = en_varoff[ei]
                var nvar = en_nvar[ei]
                var found: i64 = -1
                var k: i64 = 0
                while k < nvar {
                    if intern.lookup(en_vnames[varoff + k]) == fnm {
                        found = k
                        break
                    }
                    k = k + 1
                }
                if found >= 0 {
                    if en_vnfld[varoff + found] == 0 {
                        // 无 payload 变体：枚举常量值
                        node_types[id] = types.enum_of(ei)
                        g_typed = g_typed + 1
                        return types.enum_of(ei)
                    }
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "变体 '" + bname + "." + fnm + "' 需要 payload 参数（不能裸引用，请用 " + bname + "." + fnm + "(...) 构造）"
                    return -1
                }
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "枚举 '" + bname + "' 没有变体 '" + fnm + "'"
                return -1
            }
            // 泛型 enum 模板的裸变体引用（Option.None）：无实参可推断类型实参 →
            // 报错（一期不支持；构造调用带 payload 实参可推断）
            var gidx2 = sstate.gt_find(bname)
            if gidx2 >= 0 && gty_is_struct[gidx2] == 2 {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "泛型枚举变体 '" + bname + "." + fnm + "' 无法推断类型参数（裸引用无实参，请用带 payload 的构造调用，如 " + bname + ".Some(...)）"
                return -1
            }
        }
        var base = infer_expr(base_node)
        if base < 0 {
            return -1
        }
        var bk = types.kind(base)
        if bk == K_TUPLE {
            var ti = types.low(base)
            var off = tup_offs[ti]
            var cnt = tup_n[ti]
            var i: i64 = 0
            while i < cnt {
                var fnid = tup_names[off + i]
                // 访问顺序：数字下标（.0 起）→ ItemN（1 起编号）→ 字段名
                var hit: bool = false
                if fnm == to_string(i) {
                    hit = true
                } else if fnm == "Item" + to_string(i + 1) {
                    hit = true
                } else if fnid >= 0 {
                    if intern.lookup(fnid) == fnm {
                        hit = true
                    }
                }
                if hit {
                    node_types[id] = tup_tys[off + i]
                    g_typed = g_typed + 1
                    return tup_tys[off + i]
                }
                i = i + 1
            }
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "元组没有字段 '" + fnm + "'"
            return -1
        }
        if bk == K_STRUCT {
            // P8：struct 字段访问的 base 必须可寻址
            var base_node = sstate.child(id, 0)
            if !sstate.is_addressable(base_node) {
                var cls_name = sstate.struct_name_of(types.low(base))
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "struct 实例 '" + cls_name + "' 的字段访问需要可寻址对象（变量/字段链），"
                return -1
            }
            var si = types.low(base)
            var off = cls_fldoff[si]
            var cnt = cls_nfld[si]
            var i: i64 = 0
            while i < cnt {
                if intern.lookup(fld_names[off + i]) == fnm {
                    node_types[id] = fld_tys[off + i]
                    g_typed = g_typed + 1
                    return fld_tys[off + i]
                }
                i = i + 1
            }
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "类 '" + intern.lookup(st_keys[si]) + "' 没有字段 '" + fnm + "'"
            return -1
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "字段访问 '.' 的对象必须是元组或类实例，实际是 " + types.type_name(base)
        return -1
    }
    // TableLit
    if tag == S_N_TABLE_LIT {
        var nc = sstate.nchild(id)
        if nc == 0 {
            // 空表：i64
            node_types[id] = types.named(TK_I64)
            g_typed = g_typed + 1
            return types.named(TK_I64)
        }
        // map 检测：TableId 子节点存在
        var is_map: bool = false
        var i: i64 = 0
        while i < nc {
            var cell = sstate.child(id, i)
            var cid = sstate.child(cell, 0)
            if cid >= 0 {
                if s_tags[cid] == S_N_TABLE_ID {
                    is_map = true
                }
            }
            i = i + 1
        }
        if is_map {
            // map<val_ty>：所有值类型一致
            var val_ty: i64 = -1
            var i2: i64 = 0
            while i2 < nc {
                var cell = sstate.child(id, i2)
                var vt = infer_expr(sstate.child(cell, 1))
                if vt < 0 {
                    return -1
                }
                if val_ty < 0 {
                    val_ty = vt
                } else {
                    if vt != val_ty && !(types.is_int(vt) && types.is_int(val_ty)) {
                        sm_err_line = s_lines[id]
                        sm_err_col = s_cols[id]
                        sm_err_msg = "键值表值类型不匹配：map 值为 " + types.type_name(val_ty) + " 与 " + types.type_name(vt)
                        return -1
                    }
                }
                i2 = i2 + 1
            }
            node_types[id] = types.map_of(val_ty)
            g_typed = g_typed + 1
            return types.map_of(val_ty)
        }
        // 普通表：元素类型一致（空表字面量 [] 跳过——类型由兄弟元素决定，
        // 否则 [[1,2],[]] 会因空表 fallback i64 报"表元素类型不一致"）
        var elem_ty: i64 = -1
        var i3: i64 = 0
        while i3 < nc {
            var cell = sstate.child(id, i3)
            var val_node = sstate.child(cell, 1)
            if s_tags[val_node] == S_N_TABLE_LIT && sstate.nchild(val_node) == 0 {
                i3 = i3 + 1
                continue  // 空表：不取类型、不校验（由兄弟元素定型）
            }
            var vt = infer_expr(val_node)
            if vt < 0 {
                return -1
            }
            if elem_ty < 0 {
                elem_ty = vt
            } else {
                if vt != elem_ty && !(types.is_int(vt) && types.is_int(elem_ty)) && !(types.is_float(vt) && types.is_float(elem_ty)) {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "表元素类型不一致：" + types.type_name(elem_ty) + " 与 " + types.type_name(vt)
                    return -1
                }
            }
            i3 = i3 + 1
        }
        if elem_ty < 0 {
            elem_ty = types.named(TK_I64)  // 全空表：兜底 i64
        }
        node_types[id] = types.table_of(elem_ty)
        g_typed = g_typed + 1
        return types.table_of(elem_ty)
    }
    // TupleLit
    if tag == S_N_TUPLE_LIT {
        var nc = sstate.nchild(id)
        if nc == 0 {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "空元组 () 不支持"
            return -1
        }
        // 字段名查重
        var i: i64 = 0
        while i < nc {
            var f = sstate.child(id, i)
            var fnid = s_names[f]
            if fnid >= 0 {
                var j: i64 = 0
                while j < i {
                    var g = sstate.child(id, j)
                    if s_names[g] == fnid {
                        sm_err_line = s_lines[id]
                        sm_err_col = s_cols[id]
                        sm_err_msg = "元组字段名 '" + intern.lookup(fnid) + "' 重复"
                        return -1
                    }
                    j = j + 1
                }
            }
            i = i + 1
        }
        // 登记 tuple 类型（先占位再填值保证字段段紧凑）
        var idx = len(tuple_tys)
        var off = len(tup_names)
        table_push(tup_offs, off)
        table_push(tup_n, nc)
        table_push(tuple_tys, types.tuple_of(idx))
        var jj: i64 = 0
        while jj < nc {
            table_push(tup_names, -1)
            table_push(tup_tys, 0)
            jj = jj + 1
        }
        var i2: i64 = 0
        while i2 < nc {
            var f = sstate.child(id, i2)
            var ft = infer_expr(sstate.child(f, 0))
            if ft < 0 {
                return -1
            }
            tup_names[off + i2] = s_names[f]
            tup_tys[off + i2] = ft
            i2 = i2 + 1
        }
        var rt = types.tuple_of(idx)
        node_types[id] = rt
        g_typed = g_typed + 1
        return rt
    }
    // S2.2 闭包字面量（N_FN_LIT）：构造 fn 类型 + 登记延迟检查队列。
    // 布局（parse_fn_lit）：children = [泛型槽(-1), ret_ty, params..., body]，
    // aux = nparams。ret_ty 无 -> 时解析器已生成 void 节点（N_NAMED_TYPE）。
    // 闭包体（语句块）检查延迟到语义主流程末尾的 scheck.check_pending_closures()
    // （sinfer 无法调用 scheck——import 树反向）。此处只做：
    // ① 解析返回/参数类型 → types.fn_of 登记 fn 签名（含函数值作参数/返回）；
    // ② 保存登记时 lv 快照（捕获基准：闭包体检查重建独立作用域用）；
    // ③ 入队 g_clo_pending（FIFO）。捕获分析在 S_N_VAR 分支完成。
    if tag == S_N_FN_LIT {
        var slot = sstate.slot_off(id)
        var nparams = s_aux[id]
        // 返回类型节点：children[slot]（N_FN_LIT 布局 = 泛型槽(0)、返回类型(1)、
        // 参数(2..)、函数体(末尾)；slot_off 返回 1 = 有泛型槽）
        var ret_node = sstate.child(id, slot)
        var ret_ty = sgen.parse_generic_type_node(ret_node)
        if ret_ty < 0 {
            return -1
        }
        // 参数类型收集：children[slot+1 .. slot+1+nparams)，N_PARAM child(0)=pty
        var ptys: table<i64> = table_new_i64()
        var k: i64 = 0
        while k < nparams {
            var pnode = sstate.child(id, slot + 1 + k)
            var pty_node = sstate.child(pnode, 0)
            var pty = sgen.parse_generic_type_node(pty_node)
            if pty < 0 {
                return -1
            }
            table_push(ptys, pty)
            k = k + 1
        }
        var fnty = types.fn_of(ret_ty, ptys)
        node_types[id] = fnty
        g_typed = g_typed + 1
        // 登记闭包：入队 + 签名段 + 登记时 lv 快照
        var ci = len(g_clo_pending)
        table_push(g_clo_pending, id)
        table_push(cl_ret, ret_ty)
        table_push(cl_nparams, nparams)
        table_push(cl_paroff, len(cl_ptys))
        var k2: i64 = 0
        while k2 < nparams {
            table_push(cl_ptys, ptys[k2])
            k2 = k2 + 1
        }
        // 参数名段（捕获遮蔽判定：闭包参数遮蔽外层同名变量）
        table_push(cl_paramoff, len(cl_params))
        var k3: i64 = 0
        while k3 < nparams {
            var pnode2 = sstate.child(id, slot + 1 + k3)
            table_push(cl_params, s_names[pnode2])
            k3 = k3 + 1
        }
        // 登记时 lv 快照（捕获基准：五表拍平进 cl_o* 段）
        table_push(cl_off, len(cl_okeys))
        var ni: i64 = 0
        while ni < len(lv_keys) {
            table_push(cl_okeys, lv_keys[ni])
            table_push(cl_ovals, lv_vals[ni])
            table_push(cl_oconst, lv_const[ni])
            table_push(cl_otelem, lv_telem[ni])
            table_push(cl_odyn, lv_dyn[ni])
            ni = ni + 1
        }
        table_push(cl_nouter, len(lv_keys))
        // 闭包局部段起点（检查闭包体时 check_var_decl 动态追加）
        table_push(cl_locloff, len(cl_locals))
        // 捕获段起点（S_N_VAR 捕获登记时动态追加）
        table_push(cl_capoff, len(cl_capkeys))
        return fnty
    }
    // Call
    if tag == S_N_CALL {
        return infer_call(id)
    }
    // MethodCall
    if tag == S_N_METHOD_CALL {
        return infer_method_call(id)
    }
    // S2.3：`expr ?` 后缀解包（Result/Option）
    if tag == S_N_TRY {
        return infer_try_unwrap(id)
    }
    sm_err_line = s_lines[id]
    sm_err_col = s_cols[id]
    sm_err_msg = "无法推断表达式（节点 " + to_string(tag) + "）"
    return -1
}

// ==================== S2.3 ? 后缀解包 ====================
// `expr ?`：expr 必须是 Result/Option 类枚举（含 Ok/Err 或 Some/None 变体）。
// 语义：
//   - 解包类型 = Ok/Some 变体的 payload 类型（解包后表达式的类型）
//   - 当前函数返回类型必须是「同一枚举实例」（Result/Option），
//     否则 `?` 无法提前返回 Err/None（编译错误）
// 返回解包类型；失败 -1（错误已置 sm_err_*）。
func infer_try_unwrap(id: i64) -> i64 {
    var operand = sstate.child(id, 0)
    var ot = infer_expr(operand)
    if ot < 0 {
        return -1
    }
    if types.kind(ot) != K_ENUM {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "'?' 解包的操作数必须是 Result/Option 枚举，实际是 " + types.type_name(ot)
        return -1
    }
    var ei = types.low(ot)
    var varoff = en_varoff[ei]
    var nvar = en_nvar[ei]
    // 找 Ok/Some 变体（payload 解包）与 Err/None 变体（提前返回标记）
    var ok_i: i64 = -1
    var err_i: i64 = -1
    var k: i64 = 0
    while k < nvar {
        var vn = intern.lookup(en_vnames[varoff + k])
        if vn == "Ok" || vn == "Some" {
            ok_i = k
        } else if vn == "Err" || vn == "None" {
            err_i = k
        }
        k = k + 1
    }
    if ok_i < 0 || err_i < 0 {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "'?' 解包要求枚举 '" + types.type_name(ot) + "' 具有 Ok/Some 与 Err/None 变体（Result/Option 形态）"
        return -1
    }
    // 当前函数返回类型必须是同一枚举实例（Err/None 提前返回的落点）
    // S2.2 闭包：闭包体内的 ? 解包以闭包返回类型（g_clo_ret_stack 栈顶）为基准
    var ret_ty = sg_ret[g_curfn]
    if g_clo_ret_top > 0 {
        ret_ty = g_clo_ret_stack[g_clo_ret_top - 1]
    }
    if ret_ty < 0 {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "'?' 解包只能用于返回 Result/Option 的函数内（当前函数无返回类型）"
        return -1
    }
    if types.kind(ret_ty) != K_ENUM {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "'?' 解包只能用于返回 Result/Option 的函数内，当前函数返回 " + types.type_name(ret_ty)
        return -1
    }
    var rei = types.low(ret_ty)
    if rei != ei {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "'?' 解包错误类型不匹配：函数返回 " + types.type_name(ret_ty) + "，操作数是 " + types.type_name(ot)
        return -1
    }
    // 解包类型 = Ok/Some 变体的 payload 类型（单字段）
    var foff = en_vfldoff[varoff + ok_i]
    if en_vnfld[varoff + ok_i] != 1 {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "内部错误：'?' 解包的 Ok/Some 变体应恰有一个 payload 字段"
        return -1
    }
    var unwrap = en_ftys[foff]
    node_types[id] = unwrap
    g_typed = g_typed + 1
    return unwrap
}

// 变参元素类型（`...T` → T；非变参 -1）。签名存的是 table<T>。
func sstate_fn_variadic_elem(sig: i64) -> i64 {
    var n = sg_nparams[sig]
    if n <= 0 {
        return -1
    }
    if sp_vars[sg_off[sig] + n - 1] != 1 {
        return -1
    }
    return types.table_elem(sp_tys[sg_off[sig] + n - 1])
}

// 函数调用推断
// ---------- S1.3 字面量范围判定 ----------
// 常量值 v 是否在类型 ty 的范围内（与 stype.types_match 的 C3 范围检查
// 同一套边界；i64/u64 原生范围恒 true）。Binary 混合宽度上下文推断用。
func lit_in_range(v: i64, ty: i64) -> bool {
    if ty == TK_I8 && (v < -128 || v > 127) {
        return false
    }
    if ty == TK_I16 && (v < -32768 || v > 32767) {
        return false
    }
    if ty == TK_I32 && (v < -2147483648 || v > 2147483647) {
        return false
    }
    if ty == TK_U8 && (v < 0 || v > 255) {
        return false
    }
    if ty == TK_U16 && (v < 0 || v > 65535) {
        return false
    }
    if ty == TK_U32 && (v < 0 || v > 4294967295) {
        return false
    }
    return true
}

// ---------- S1.3 checked_* 返回元组登记 ----------
// (T, bool) 二元组类型 id：查重（已登记直接返回）或追加登记
// （tup_offs/tup_n/tup_names/tup_tys/tuple_tys 为 sstate 顶层全局，
// 与 stype.parse_type_node 的 tuple 登记同布局）。irgen 的 cmpxchg 提取也复用。
pub func tuple2_of(t0: i64, t1: i64) -> i64 {
    var i: i64 = 0
    while i < len(tuple_tys) {
        var off = tup_offs[i]
        if tup_n[i] == 2 && tup_tys[off] == t0 && tup_tys[off + 1] == t1 {
            return tuple_tys[i]
        }
        i = i + 1
    }
    var idx = len(tuple_tys)
    var off2 = len(tup_names)
    table_push(tup_offs, off2)
    table_push(tup_n, 2)
    table_push(tuple_tys, types.tuple_of(idx))
    table_push(tup_names, -1)
    table_push(tup_tys, t0)
    table_push(tup_names, -1)
    table_push(tup_tys, t1)
    return types.tuple_of(idx)
}

pub func infer_call(id: i64) -> i64 {
    var fnm = sstate.name_str(id)
    // 实参收集：Call children = [泛型槽(-1或N_TYPE_ARGS), 实参...]，
    // 实参从 children[slot_off] 起（slot_off 恒 1，统一走辅助保证一致）
    var args: table<i64> = table_new_i64()
    var off = sstate.slot_off(id)
    var nc = sstate.nchild(id) - off
    var i: i64 = 0
    while i < nc {
        table_push(args, sstate.child(id, off + i))
        i = i + 1
    }
    // ---------- S1.3 checked_* 溢出检测函数族 ----------
    // checked_add/sub/mul/div/shl/shr（2 参整数）+ checked_neg（1 参整数）
    // → 返回 (T, bool) 元组（T = 公共宽度类型；bool = 溢出标志）。
    // 先于 builtin_call（返回 -3 会误入用户函数路径报"无签名"）。
    if fnm == "checked_add" || fnm == "checked_sub" || fnm == "checked_mul" ||
        fnm == "checked_div" || fnm == "checked_shl" || fnm == "checked_shr" ||
        fnm == "checked_neg" {
        var need = 2
        if fnm == "checked_neg" {
            need = 1
        }
        if nc != need {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = fnm + "() 期望 " + to_string(need) + " 个参数，实际 " + to_string(nc) + " 个"
            return -1
        }
        var t0 = infer_expr(args[0])
        if t0 < 0 {
            return -1
        }
        if !types.is_int(t0) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = fnm + "() 参数必须是整数，实际是 " + types.type_name(t0)
            return -1
        }
        var ct = t0
        if need == 2 {
            var t1 = infer_expr(args[1])
            if t1 < 0 {
                return -1
            }
            if !types.is_int(t1) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = fnm + "() 参数必须是整数，实际是 " + types.type_name(t1)
                return -1
            }
            if stype.int_width(t1) > stype.int_width(t0) {
                ct = t1
            }
            if stype.is_signed(t0) != stype.is_signed(t1) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = fnm + "() 不支持有符号与无符号混合（" + types.type_name(t0) + " 与 " + types.type_name(t1) + "）"
                return -1
            }
        }
        var rt = tuple2_of(ct, types.named(TK_BOOL))
        node_types[id] = rt
        g_typed = g_typed + 1
        return rt
    }
    // 内置函数：先校验个数（-2=参数错误已报），通过后逐个推断实参
    var br = sbuiltin.builtin_call(fnm, args, id)
    if br >= -1 && br != -3 {
        // S1.2 安全边界：unsafe 内置（指针/内存操作）在安全代码中调用 = 编译错误
        if g_unsafe_depth == 0 {
            if fnm == "addr_of" || fnm == "addr_of_field" || fnm == "deref" || fnm == "deref_write" ||
                fnm == "is_null" || fnm == "ptr_add" || fnm == "ptr_to_int" || fnm == "int_to_ptr" ||
                fnm == "alloc" || fnm == "free" || fnm == "memcpy" || fnm == "memset" ||
                fnm == "slice_of" || fnm == "slice_len" || fnm == "slice_index" {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "调用 unsafe 内置 '" + fnm + "' 必须在 unsafe 块或 unsafe 函数中（安全代码禁止触底）"
                return -1
            }
        }
        // 实参类型推断（未声明变量/类型错误在此暴露；只做检查不改结果）
        var ka: i64 = 0
        while ka < nc {
            var at = infer_expr(args[ka])
            if at < 0 {
                return -1
            }
            ka = ka + 1
        }
        // S1.2 动态返回类型特判（builtin_call 无法静态确定）：
        // addr_of(x) → ptr<实参类型>；deref(p) → 指针元素类型；
        // slice_of(a, s, n) → slice<元素类型>；ptr_add(p, n) → ptr<元素类型>
        if fnm == "addr_of" {
            var a0 = infer_expr(args[0])
            if a0 < 0 {
                return -1
            }
            node_types[id] = types.ptr_of(a0)
            g_typed = g_typed + 1
            return node_types[id]
        }
        if fnm == "deref" || fnm == "ptr_add" {
            var p0 = infer_expr(args[0])
            if p0 < 0 {
                return -1
            }
            if !types.is_ptr(p0) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = fnm + "() 第 1 个参数必须是指针类型，实际是 " + types.type_name(p0)
                return -1
            }
            var e0 = types.table_elem(p0)
            if fnm == "deref" {
                node_types[id] = e0
            } else {
                node_types[id] = types.ptr_of(e0)
            }
            g_typed = g_typed + 1
            return node_types[id]
        }
        if fnm == "slice_of" {
            var a1 = infer_expr(args[0])
            if a1 < 0 {
                return -1
            }
            // S1.2：第一版 slice_of 只支持字符串（ptr 即数据指针）；
            // 动态表数据区在运行时桥内无数据指针桥（后置）。
            var et1: i64 = types.named(TK_U8)
            if a1 != TK_STR {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "slice_of() 第一版只支持字符串（表的数据指针桥后置），实际是 " + types.type_name(a1)
                return -1
            }
            node_types[id] = types.slice_of(et1)
            g_typed = g_typed + 1
            return node_types[id]
        }
        if fnm == "slice_index" {
            var s0 = infer_expr(args[0])
            if s0 < 0 {
                return -1
            }
            if !types.is_slice(s0) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "slice_index() 第 1 个参数必须是切片类型，实际是 " + types.type_name(s0)
                return -1
            }
            node_types[id] = types.table_elem(s0)
            g_typed = g_typed + 1
            return node_types[id]
        }
        if fnm == "slice_len" {
            var s1 = infer_expr(args[0])
            if s1 < 0 {
                return -1
            }
            if !types.is_slice(s1) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "slice_len() 参数必须是切片类型，实际是 " + types.type_name(s1)
                return -1
            }
            node_types[id] = types.named(TK_I64)
            g_typed = g_typed + 1
            return node_types[id]
        }
        // as_* 特殊检查（S1.3）：参数必须是数字（整数/浮点），转换才有意义
        if fnm == "as_i8" || fnm == "as_i16" || fnm == "as_i32" || fnm == "as_i64" ||
            fnm == "as_u8" || fnm == "as_u16" || fnm == "as_u32" || fnm == "as_u64" ||
            fnm == "as_f32" || fnm == "as_f64" ||
            fnm == "as_i128" || fnm == "as_u128" {
            var a_ty = infer_expr(args[0])
            if a_ty < 0 {
                return -1
            }
            if !types.is_number(a_ty) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = fnm + "() 参数必须是数字（整数/浮点），实际是 " + types.type_name(a_ty)
                return -1
            }
            node_types[id] = br
            g_typed = g_typed + 1
            return br
        }
        // table_push 特殊检查（对齐 Rust）：第 1 参数必须表变量 + 动态表 + 元素类型匹配
        if fnm == "table_push" {
            var t0 = s_tags[args[0]]
            if t0 != S_N_VAR {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "table_push() 第 1 个参数必须是表变量（不能是字面量/下标）"
                return -1
            }
            var tnm = sstate.name_str(args[0])
            var tnid = intern.intern(tnm)
            var elem = var_table_elem(tnid)
            if elem < 0 {
                // 查找失败：默认 i64
                elem = types.named(TK_I64)
            }
            var x_ty = infer_expr(args[1])
            if x_ty < 0 {
                return -1
            }
            if !stype.types_match(elem, x_ty, args[1]) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "table_push() 元素类型不匹配：表 '" + tnm + "' 的元素是 " + types.type_name(elem) + "，推入的是 " + types.type_name(x_ty)
                return -1
            }
            node_types[id] = types.named(TK_VOID)
            g_typed = g_typed + 1
            return types.named(TK_VOID)
        }
        // table_at 特殊检查（对齐 Rust）：下标必须整数
        if fnm == "table_at" {
            var i_ty = infer_expr(args[1])
            if i_ty < 0 {
                return -1
            }
            if !types.is_int(i_ty) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "table_at() 下标必须是整数，实际是 " + types.type_name(i_ty)
                return -1
            }
            node_types[id] = br
            g_typed = g_typed + 1
            return br
        }
        // eval 特殊检查（对齐 Rust）：参数必须是字符串
        if fnm == "eval" {
            var e_ty = infer_expr(args[0])
            if e_ty < 0 {
                return -1
            }
            if e_ty != TK_STR {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "eval() 参数必须是字符串，实际是 " + types.type_name(e_ty)
                return -1
            }
            node_types[id] = types.named(TK_STR)
            g_typed = g_typed + 1
            return types.named(TK_STR)
        }
        if br == -1 {
            // void
            node_types[id] = types.named(TK_VOID)
            g_typed = g_typed + 1
            return types.named(TK_VOID)
        }
        node_types[id] = br
        g_typed = g_typed + 1
        return br
    }
    if br == -2 {
        return -1
    }
    // struct 构造
    var snid = intern.intern(fnm)
    var sidx = sstate.bs_find(st_keys, snid)
    if sidx >= 0 {
        var si = st_vals[sidx]
        var nf = cls_nfld[si]
        if nc > nf {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "构造 '" + fnm + "' 最多 " + to_string(nf) + " 个参数（字段数），实际 " + to_string(nc) + " 个"
            return -1
        }
        // 字段类型匹配
        var off = cls_fldoff[si]
        var j: i64 = 0
        while j < nc {
            var at = infer_expr(args[j])
            if at < 0 {
                return -1
            }
            if !stype.types_match(fld_tys[off + j], at, args[j]) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "构造 '" + fnm + "' 参数类型不匹配：字段 '" + intern.lookup(fld_names[off + j]) + "' 期望 " + types.type_name(fld_tys[off + j]) + "，实际 " + types.type_name(at)
                return -1
            }
            j = j + 1
        }
        node_types[id] = types.struct_of(si)
        g_typed = g_typed + 1
        return types.struct_of(si)
    }
    // T3b 泛型（2026-08-14）：普通函数/struct 未命中但 gt_* 模板表命中 →
    // 泛型调用路径（构造或函数，调用点推断 + 单态化展开）
    var full_name = resolve_call_name(fnm)
    var gti = sstate.gt_find(full_name)
    if gti >= 0 && gty_is_struct[gti] == 1 {
        return infer_generic_struct_construct(full_name, gti, id, args)
    }
    if gti >= 0 && gty_is_struct[gti] == 0 {
        return infer_generic_fn_call(full_name, gti, id, args)
    }
    // 用户函数（裸调用解析：顶层 / 当前命名空间补全 / using 前缀补全）
    var sig = sstate.fn_sig(full_name)
    if sig < 0 {
        // S2.2 闭包函数值调用：函数签名未命中时，若调用名是 fn 类型变量
        // （闭包字面量 / 函数值参数），按函数值调用检查：参数个数、参数
        // 类型逐个匹配，返回类型 = fn 返回类型。
        var fv_nid = intern.intern(fnm)
        var fv_ty = lv_find(fv_nid)
        if fv_ty < 0 {
            fv_ty = gb_find(fv_nid)
        }
        if fv_ty >= 0 && types.is_fn(fv_ty) {
            var fn_np = types.fn_nparams_of(fv_ty)
            if nc != fn_np {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "函数值调用 '" + fnm + "' 期望 " + to_string(fn_np) + " 个参数，实际 " + to_string(nc) + " 个"
                return -1
            }
            var kf: i64 = 0
            while kf < nc {
                var want = types.fn_param_of(fv_ty, kf)
                var at = infer_expr(args[kf])
                if at < 0 {
                    return -1
                }
                if !stype.types_compatible(want, at) && !stype.types_match(want, at, args[kf]) {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "函数值调用 '" + fnm + "' 参数类型不匹配：期望 " + types.type_name(want) + "，实际 " + types.type_name(at)
                    return -1
                }
                kf = kf + 1
            }
            var frt = types.fn_ret_ty(fv_ty)
            node_types[id] = frt
            g_typed = g_typed + 1
            return frt
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "未定义的函数 '" + fnm + "'"
        return -1
    }
    // 可见性校验
    var vr = sstate.check_visibility(full_name, sig, id)
    if vr < 0 {
        return -1
    }
    // S1.2 安全边界：unsafe 函数（含 extern）在安全代码中调用 = 编译错误
    if sstate.sig_unsafe(sig) == 1 && g_unsafe_depth == 0 {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "调用 unsafe 函数 '" + fnm + "' 必须在 unsafe 块或 unsafe 函数中（安全代码禁止触底）"
        return -1
    }
    var req = sg_required[sig]
    var total = sg_nparams[sig]
    var has_var = sstate.fn_has_variadic(sig) == 1
    // 变参函数：实参数无上界（固定部分 + 任意个额外元素实参）
    if nc < req || (!has_var && nc > total) {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        var cnt_desc = ""
        if has_var {
            cnt_desc = to_string(req) + "+"
        } else if req == total {
            cnt_desc = to_string(total)
        } else {
            cnt_desc = to_string(req) + "-" + to_string(total)
        }
        sm_err_msg = "函数 '" + fnm + "' 期望 " + cnt_desc + " 个参数，实际 " + to_string(nc) + " 个"
        return -1
    }
    var off = sg_off[sig]
    var j2: i64 = 0
    while j2 < nc {
        var want = sp_tys[off + j2]
        // 变参：超过固定形参数（total-1）的实参与变参元素类型 T 匹配
        var want_fixed: bool = true
        if has_var {
            if j2 >= total - 1 {
                want = sstate_fn_variadic_elem(sig)
                want_fixed = false
            }
        }
        var at = infer_expr(args[j2])
        if at < 0 {
            // S2.3 目标类型引导：泛型 enum 构造实参（Result.Err("x") / Option.None）
            // 类型参数推断不全时（Err 不含 T / None 无 payload），用形参类型补全。
            // 与 scheck 赋值/return/var 声明三处引导同模式：保存-恢复错误三件套。
            if want_fixed {
                var sv_l = sm_err_line
                var sv_c = sm_err_col
                var sv_m = sm_err_msg
                var hv = try_enum_construct_hinted(args[j2], want)
                if hv >= 0 {
                    sm_err_line = 0
                    sm_err_col = 0
                    sm_err_msg = ""
                    at = hv
                } else {
                    if sm_err_msg == sv_m {
                        // 引导未命中（非泛型 enum 构造）：恢复原错误
                        sm_err_line = sv_l
                        sm_err_col = sv_c
                        sm_err_msg = sv_m
                    }
                    return -1
                }
            } else {
                return -1
            }
        }
        // 表形参（table<T>）的元素不匹配留给 A1 专用检查；非表类型 mismatch 报通用消息
        var want_is_tbl = types.kind(want) == K_TABLE
        var at_is_tbl = types.kind(at) == K_TABLE
        if !stype.types_compatible(want, at) && !stype.types_match(want, at, args[j2]) {
            if !(want_is_tbl && at_is_tbl) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "调用 '" + fnm + "' 参数类型不匹配：期望 " + types.type_name(want) + "，实际 " + types.type_name(at)
                return -1
            }
        }
        // A1：形参 table<T> 的元素类型校验——实参表字面量/动态表变量/返回表的调用，
        // 其元素类型须与 T 一致（裸 table 形参不校验，对齐 Rust）
        if want_fixed && want_is_tbl && !(want == TK_TABLE) {
            var want_elem = types.table_elem(want)
            var got_elem = arg_table_elem_ty(args[j2])
            if got_elem >= 0 {
                if !stype.types_compatible(want_elem, got_elem) {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "调用 '" + fnm + "' 表参数元素类型不匹配：期望 table<" + types.type_name(want_elem) + ">，实际 table<" + types.type_name(got_elem) + ">"
                    return -1
                }
            }
        }
        // ref 参数实参校验（对齐 Rust T0.3 by_ref）：实参必须是可寻址变量（变量/字段链），
        // 且必须是动态表（table_new_* 创建）——IR 需取地址写回
        if want_fixed && sp_refs[off + j2] == 1 {
            if !sstate.is_addressable(args[j2]) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "调用 '" + fnm + "' 的 ref 参数需要可寻址的变量实参（不能是字面量/下标/调用结果等不可取地址）"
                return -1
            }
            if s_tags[args[j2]] == S_N_VAR {
                var vname = sstate.name_str(args[j2])
                var vnid = intern.intern(vname)
                if var_dyn(vnid) != 1 {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "调用 '" + fnm + "' 的 ref 参数实参 '" + vname + "' 必须是动态表（table_new_* 创建），'" + vname + "' 是定长表"
                    return -1
                }
            }
        }
        j2 = j2 + 1
    }
    var rt = sg_ret[sig]
    node_types[id] = rt
    g_typed = g_typed + 1
    return rt
}

// ==================== S1.2 A1 atomic<T> 内置方法 ====================
// 方法集（第一版 i64/f64/bool 元素）：
//   load() → T                    （无参）
//   store(v, order)               （2 参，返回 void）
//   fetch_add/sub/and/or/xor(v, order) → T（读改写，返回旧值）
//   compare_exchange(exp, new, order) → bool（CAS 成功标志）
// order 参数：Relaxed/Acquire/Release/AcqRel/SeqCst 标识符 → IMM 0..4。
// 全部要求 unsafe 上下文。
func infer_atomic_method(aty: i64, mname: string, args: table<i64>, id: i64) -> i64 {
    if g_unsafe_depth == 0 {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "原子操作 '" + mname + "()' 必须在 unsafe 块或 unsafe 函数中使用（安全代码禁止触底）"
        return -1
    }
    var elem = types.table_elem(aty)
    var nargs = len(args)
    if mname == "load" {
        if nargs > 1 {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "atomic.load() 期望 0 或 1 个参数（内存序），实际 " + to_string(nargs) + " 个"
            return -1
        }
        if nargs == 1 {
            if infer_asm_order(args[0], id) < 0 {
                return -1
            }
        }
        node_types[id] = elem
        g_typed = g_typed + 1
        return elem
    }
    if mname == "store" {
        if nargs != 2 {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "atomic.store() 期望 2 个参数（值, 内存序），实际 " + to_string(nargs) + " 个"
            return -1
        }
        var vt = infer_expr(args[0])
        if vt < 0 {
            return -1
        }
        if !stype.types_match(elem, vt, args[0]) && !stype.types_compatible(elem, vt) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "atomic.store() 值类型不匹配：期望 " + types.type_name(elem) + "，实际 " + types.type_name(vt)
            return -1
        }
        if infer_asm_order(args[1], id) < 0 {
            return -1
        }
        node_types[id] = types.named(TK_VOID)
        g_typed = g_typed + 1
        return types.named(TK_VOID)
    }
    if mname == "fetch_add" || mname == "fetch_sub" || mname == "fetch_and" ||
        mname == "fetch_or" || mname == "fetch_xor" {
        if nargs != 2 {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "atomic." + mname + "() 期望 2 个参数（增量, 内存序），实际 " + to_string(nargs) + " 个"
            return -1
        }
        var vt2 = infer_expr(args[0])
        if vt2 < 0 {
            return -1
        }
        if !stype.types_match(elem, vt2, args[0]) && !stype.types_compatible(elem, vt2) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "atomic." + mname + "() 值类型不匹配：期望 " + types.type_name(elem) + "，实际 " + types.type_name(vt2)
            return -1
        }
        if infer_asm_order(args[1], id) < 0 {
            return -1
        }
        node_types[id] = elem
        g_typed = g_typed + 1
        return elem
    }
    if mname == "compare_exchange" {
        if nargs != 3 {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "atomic.compare_exchange() 期望 3 个参数（期望值, 新值, 内存序），实际 " + to_string(nargs) + " 个"
            return -1
        }
        var et = infer_expr(args[0])
        if et < 0 {
            return -1
        }
        if !stype.types_match(elem, et, args[0]) && !stype.types_compatible(elem, et) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "atomic.compare_exchange() 期望值类型不匹配：期望 " + types.type_name(elem) + "，实际 " + types.type_name(et)
            return -1
        }
        var nt = infer_expr(args[1])
        if nt < 0 {
            return -1
        }
        if !stype.types_match(elem, nt, args[1]) && !stype.types_compatible(elem, nt) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "atomic.compare_exchange() 新值类型不匹配：期望 " + types.type_name(elem) + "，实际 " + types.type_name(nt)
            return -1
        }
        if infer_asm_order(args[2], id) < 0 {
            return -1
        }
        node_types[id] = types.named(TK_BOOL)
        g_typed = g_typed + 1
        return types.named(TK_BOOL)
    }
    sm_err_line = s_lines[id]
    sm_err_col = s_cols[id]
    sm_err_msg = "atomic<T> 不支持方法 '" + mname + "'（支持: load/store/fetch_add/fetch_sub/fetch_and/fetch_or/fetch_xor/compare_exchange）"
    return -1
}

// 内存序参数解析：标识符 Relaxed/Acquire/Release/AcqRel/SeqCst → 0..4。
// 返回 0 成功；-1 报错（sm_err_* 已置）。
func infer_asm_order(node: i64, id: i64) -> i64 {
    if s_tags[node] != S_N_VAR {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "内存序必须是 Relaxed / Acquire / Release / AcqRel / SeqCst（标识符常量）"
        return -1
    }
    var nm = sstate.name_str(node)
    if nm == "Relaxed" {
        return 0
    }
    if nm == "Acquire" {
        return 1
    }
    if nm == "Release" {
        return 2
    }
    if nm == "AcqRel" {
        return 3
    }
    if nm == "SeqCst" {
        return 4
    }
    sm_err_line = s_lines[id]
    sm_err_col = s_cols[id]
    sm_err_msg = "未知内存序 '" + nm + "'（合法: Relaxed/Acquire/Release/AcqRel/SeqCst）"
    return -1
}

// ==================== 泛型调用路径（T3b 单态化 + 调用点推断）====================// 实参表类型细化：`table_new_*()` 变量/返回的类型是裸 table（元素类型在
// var_table_elem / table_ret_elem），泛型推断需带元素类型（table<T> 匹配）。
// 例如 Box<table<i64>>(t)：t 的裸 table 若直接绑定 T 会与显式 table<i64> 冲突。
func refine_arg_ty(a: i64, t: i64) -> i64 {
    if t == TK_TABLE || t == TK_MAP {
        var te: i64 = -1
        if s_tags[a] == S_N_VAR {
            te = var_table_elem(intern.intern(sstate.name_str(a)))
        }
        if te >= 0 {
            if t == TK_MAP {
                return types.map_of(te)
            }
            return types.table_of(te)
        }
    }
    return t
}

// 显式类型实参解析（调用点 N_TYPE_ARGS → 类型实参表；-1 槽 = 无显式实参）。
// 返回实参表；解析失败返回空表且 sm_err_* 已置（调用方据 sm_err_msg 判定）。
func parse_explicit_args(id: i64) -> table<i64> {
    var out: table<i64> = table_new_i64()
    var off = sstate.slot_off(id)
    if off == 1 && sstate.nchild(id) > 0 {
        var slot = sstate.child(id, 0)
        if slot >= 0 && s_tags[slot] == S_N_TYPE_ARGS {
            out = sgen.parse_type_args_ast(slot)
            // 无显式实参 → 空表；解析失败也是空表（sm_err_* 区分）
        }
    }
    return out
}

// 泛型函数调用：`max(3, 5)`（推断）/ `max<i64>(9, 4)`（显式）/ `pick(5, "hi")`。
// 流程：显式实参解析 → 实参类型表 → 模板形参 AST 模式匹配绑定 TypeVar →
// 构造 mangled 名 → 单态化展开（instantiate_fn）→ 重写调用名 → 实例化签名
// 的常规参数检查 → 返回实例化返回类型。
pub func infer_generic_fn_call(full_name: string, gti: i64, id: i64, args: table<i64>) -> i64 {
    var nc = len(args)
    var explicit = parse_explicit_args(id)
    if len(explicit) == 0 && str_len(sm_err_msg) > 0 {
        return -1  // 显式类型实参解析失败（sm_err_* 已置）
    }
    // 实参类型表（infer_expr 已知类型）
    var arg_tys: table<i64> = table_new_i64()
    var k: i64 = 0
    while k < nc {
        var at = infer_expr(args[k])
        if at < 0 {
            return -1
        }
        at = refine_arg_ty(args[k], at)
        table_push(arg_tys, at)
        k = k + 1
    }
    // 推断类型实参（AST 模式匹配绑定 TypeVar）
    var tmpl_node = gty_node[gti]
    var args_t = sgen.infer_type_args(tmpl_node, gti, explicit, 0, arg_tys, id)
    if len(args_t) == 0 {
        return -1  // 推断失败/冲突已报错
    }
    // 单态化展开
    var mangled = sgen.mangle(full_name, args_t)
    var sig = sgen.instantiate_fn(gti, args_t, s_lines[id], s_cols[id])
    if sig < 0 {
        return -1
    }
    // 重写调用名 → mangled（irgen 按名生成；检查循环去重后走普通路径）
    s_names[id] = intern.intern(mangled)
    // 可见性校验
    var vr = sstate.check_visibility(mangled, sig, id)
    if vr < 0 {
        return -1
    }
    // S1.2 安全边界：泛型 unsafe 函数在安全代码中调用 = 编译错误
    if sstate.sig_unsafe(sig) == 1 && g_unsafe_depth == 0 {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "调用 unsafe 函数 '" + full_name + "' 必须在 unsafe 块或 unsafe 函数中（安全代码禁止触底）"
        return -1
    }
    // 参数个数（实例化签名）
    var req = sg_required[sig]
    var total = sg_nparams[sig]
    if nc < req || nc > total {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "函数 '" + full_name + "' 期望 " + to_string(req) + " 个参数，实际 " + to_string(nc) + " 个"
        return -1
    }
    // 参数类型检查（实例化形参已具体化 → 现有类型系统自然验证）
    var off = sg_off[sig]
    var j2: i64 = 0
    while j2 < nc {
        var want = sp_tys[off + j2]
        var at = arg_tys[j2]
        if !stype.types_compatible(want, at) && !stype.types_match(want, at, args[j2]) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "调用 '" + full_name + "' 参数类型不匹配：期望 " + types.type_name(want) + "，实际 " + types.type_name(at)
            return -1
        }
        // ref 参数实参校验（对齐普通路径）
        if sp_refs[off + j2] == 1 {
            if !sstate.is_addressable(args[j2]) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "调用 '" + full_name + "' 的 ref 参数需要可寻址的变量实参（不能是字面量/下标/调用结果等不可取地址）"
                return -1
            }
        }
        j2 = j2 + 1
    }
    var rt = sg_ret[sig]
    node_types[id] = rt
    g_typed = g_typed + 1
    return rt
}

// 泛型 struct 构造：`Box<i64>(42)`（显式）/ `Box(3.14)`（推断）。
// 流程：显式实参解析 → 实参类型表 → 模板字段类型 AST 匹配绑定 TypeVar →
// 展开 struct（instantiate_struct，字段拍平）→ 重写调用名 → 实例化字段类型
// 校验 → 返回实例化 struct 类型 id。
pub func infer_generic_struct_construct(full_name: string, gti: i64, id: i64, args: table<i64>) -> i64 {
    var nc = len(args)
    var explicit = parse_explicit_args(id)
    if len(explicit) == 0 && str_len(sm_err_msg) > 0 {
        return -1  // 显式类型实参解析失败
    }
    var arg_tys: table<i64> = table_new_i64()
    var k: i64 = 0
    while k < nc {
        var at = infer_expr(args[k])
        if at < 0 {
            return -1
        }
        at = refine_arg_ty(args[k], at)
        table_push(arg_tys, at)
        k = k + 1
    }
    var tmpl_node = gty_node[gti]
    var nfld = sstate.nchild(tmpl_node) - 1
    if nc > nfld {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "构造 '" + full_name + "' 最多 " + to_string(nfld) + " 个参数（字段数），实际 " + to_string(nc) + " 个"
        return -1
    }
    // 推断类型实参（字段类型与实参匹配）
    var args_t = sgen.infer_type_args_fields(tmpl_node, gti, explicit, arg_tys, id)
    if len(args_t) == 0 {
        return -1  // 推断失败/冲突已报错
    }
    // 展开 struct（reg_struct + 字段拍平 + gin 记录）
    var si = sgen.instantiate_struct(gti, args_t)
    if si < 0 {
        return -1
    }
    var mangled = sgen.mangle(full_name, args_t)
    // 重写调用名 → mangled（irgen 构造路径按 st_keys 命中）
    s_names[id] = intern.intern(mangled)
    // 实例化字段类型校验（非 TypeVar 字段的实参匹配也在此暴露）
    var off = cls_fldoff[si]
    var j: i64 = 0
    while j < nc {
        if !stype.types_match(fld_tys[off + j], arg_tys[j], args[j]) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "构造 '" + mangled + "' 参数类型不匹配：字段 '" + intern.lookup(fld_names[off + j]) + "' 期望 " + types.type_name(fld_tys[off + j]) + "，实际 " + types.type_name(arg_tys[j])
            return -1
        }
        j = j + 1
    }
    var rt = types.struct_of(si)
    node_types[id] = rt
    g_typed = g_typed + 1
    return rt
}

// 方法调用推断（命名空间函数 / struct 方法转发 / 枚举变体构造）
pub func infer_method_call(id: i64) -> i64 {
    // MethodCall 接收者 = children[slot_off]（新布局 children[0]=泛型槽→偏移 1；
    // 旧布局无槽→children[0]=接收者。slot_off 统一判定保证自举双兼容）
    var recv = sstate.child(id, sstate.slot_off(id))
    var mname = sstate.name_str(id)
    var args: table<i64> = table_new_i64()
    var nc = sstate.nchild(id)
    var off = sstate.slot_off(id)  // 泛型槽偏移（新布局恒 1，旧布局 0）
    var i: i64 = off + 1
    while i < nc {
        table_push(args, sstate.child(id, i))
        i = i + 1
    }
    // 枚举变体构造探测（EnumName.Variant(args)）：接收者是未绑定变量且命中
    // en_keys → 枚举构造。带 payload 变体校验实参个数与类型；无 payload 变体
    // 空参调用视为常量值，多余实参报错。
    if s_tags[recv] == S_N_VAR {
        var rname = sstate.name_str(recv)
        var eidx = sstate.bs_find(en_keys, intern.intern(rname))
        if eidx >= 0 {
            return infer_enum_construct(eidx, mname, args, id)
        }
        // 泛型 enum 模板构造（Option.Some(42)）：接收者是模板名（gt_* 表，
        // gty_is_struct==2），从 payload 实参推断类型实参后实例化。
        // 须先于 recv_path_name 的 ns 解析（"Option::Some" 无签名会误报）。
        var gidx = sstate.gt_find(rname)
        if gidx >= 0 && gty_is_struct[gidx] == 2 {
            return infer_generic_enum_construct(gidx, mname, args, id)
        }
    }
    // 接收者是命名空间路径（Var 未绑定）→ ns 调用
    var full = ""
    if s_tags[recv] == S_N_VAR {
        var rname = sstate.name_str(recv)
        var rnid = intern.intern(rname)
        var rt2 = lv_find(rnid)
        if rt2 < 0 {
            rt2 = gb_find(rnid)
        }
        if rt2 < 0 {
            // 未绑定：命名空间前缀
            full = rname + "::" + mname
        } else if types.kind(rt2) == K_ATOMIC {
            // S1.2 A1 atomic<T> 内置方法（c.load() / c.fetch_add(1, Relaxed)）
            return infer_atomic_method(rt2, mname, args, id)
        } else if types.kind(rt2) == K_PORT {
            // S2.4：port 对象方法调用（动态分发，vtable 间接调用）
            return infer_port_method(rt2, mname, args, id)
        } else {
            // struct 实例方法转发
            return infer_struct_method(recv, rt2, mname, args, id)
        }
    } else {
        // S2.4：表达式接收者（list[0] / 函数返回值 / 字段访问）——先推断
        // 接收者类型：port 对象 → 动态分发（vtable 间接调用）；其余按
        // 命名空间路径解析（既有行为）。
        var rt3 = infer_expr(recv)
        if rt3 >= 0 && types.kind(rt3) == K_PORT {
            return infer_port_method(rt3, mname, args, id)
        }
        // Path 接收者 → ns 调用
        full = recv_path_name(recv) + "::" + mname
    }
    if full == "::" + mname {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "方法调用的对象必须是 struct 实例或 struct 名，实际是 " + types.type_name(infer_expr(recv))
        return -1
    }
    var sig = sstate.fn_sig(full)
    if sig < 0 {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "命名空间函数 '" + full + "' 未定义"
        return -1
    }
    // 可见性校验
    var vr = sstate.check_visibility(full, sig, id)
    if vr < 0 {
        return -1
    }
    // S1.2 安全边界：unsafe 命名空间函数在安全代码中调用 = 编译错误
    if sstate.sig_unsafe(sig) == 1 && g_unsafe_depth == 0 {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "调用 unsafe 函数 '" + full + "' 必须在 unsafe 块或 unsafe 函数中（安全代码禁止触底）"
        return -1
    }
    var req = sg_required[sig]
    var total = sg_nparams[sig]
    var has_var = sstate.fn_has_variadic(sig) == 1
    if len(args) < req || (!has_var && len(args) > total) {
        var cnt_desc2 = ""
        if has_var {
            cnt_desc2 = to_string(req) + "+"
        } else if req == total {
            cnt_desc2 = to_string(total)
        } else {
            cnt_desc2 = to_string(req) + "-" + to_string(total)
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "命名空间函数 '" + full + "' 期望 " + cnt_desc2 + " 个参数，实际 " + to_string(len(args)) + " 个"
        return -1
    }
    var off = sg_off[sig]
    var j: i64 = 0
    while j < len(args) {
        var at = infer_expr(args[j])
        if at < 0 {
            return -1
        }
        var want = sp_tys[off + j]
        if has_var {
            if j >= total - 1 {
                want = sstate_fn_variadic_elem(sig)   // 变参：元素类型匹配
            }
        }
        if !stype.types_compatible(want, at) && !stype.types_match(want, at, args[j]) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "调用 '" + full + "' 参数类型不匹配：期望 " + types.type_name(want) + "，实际 " + types.type_name(at)
            return -1
        }
        j = j + 1
    }
    var rt = sg_ret[sig]
    node_types[id] = rt
    g_typed = g_typed + 1
    return rt
}

// 枚举变体构造推断：EnumName.Variant(args)（MethodCall，name = 变体名）。
// - 变体未找到 → "枚举 'X' 没有变体 'Y'"
// - 无 payload 变体：空参调用 = 常量值；多余实参报错
// - 带 payload 变体：实参个数必须等于 payload 字段数，逐个类型匹配
// 返回枚举类型 id（types.enum_of(ei)）。
func infer_enum_construct(eidx: i64, vname: string, args: table<i64>, id: i64) -> i64 {
    var ei = en_vals[eidx]
    var ename = sstate.enum_name_of(ei)
    var varoff = en_varoff[ei]
    var nvar = en_nvar[ei]
    var found: i64 = -1
    var k: i64 = 0
    while k < nvar {
        if intern.lookup(en_vnames[varoff + k]) == vname {
            found = k
            break
        }
        k = k + 1
    }
    if found < 0 {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "枚举 '" + ename + "' 没有变体 '" + vname + "'"
        return -1
    }
    var nfld = en_vnfld[varoff + found]
    var nc = len(args)
    if nfld == 0 {
        if nc != 0 {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "无 payload 变体 '" + ename + "." + vname + "' 不接受参数，实际 " + to_string(nc) + " 个"
            return -1
        }
        // 无 payload 变体空参调用：等价常量值
        node_types[id] = types.enum_of(ei)
        g_typed = g_typed + 1
        return types.enum_of(ei)
    }
    if nc != nfld {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "构造 '" + ename + "." + vname + "' 期望 " + to_string(nfld) + " 个参数，实际 " + to_string(nc) + " 个"
        return -1
    }
    // 逐个 payload 字段类型匹配
    var foff = en_vfldoff[varoff + found]
    var j: i64 = 0
    while j < nc {
        var at = infer_expr(args[j])
        if at < 0 {
            return -1
        }
        var want = en_ftys[foff + j]
        if !stype.types_match(want, at, args[j]) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "构造 '" + ename + "." + vname + "' 参数类型不匹配：期望 " + types.type_name(want) + "，实际 " + types.type_name(at)
            return -1
        }
        j = j + 1
    }
    node_types[id] = types.enum_of(ei)
    g_typed = g_typed + 1
    return types.enum_of(ei)
}

// 泛型 enum 模板构造推断（Option.Some(42)）：模板 gti（gty_is_struct==2），
// 变体 vname，实参 args。流程：
//  1. 模板节点定位变体（children[slot_off+k]，name = 变体名）
//  2. payload 字段数 ≠ 实参数 → 报错（无 payload 变体空参调用：T 无法推断 → 报错）
//  3. 逐个实参推断类型 → sgen.infer_type_args_variants 绑定 TypeVar → 类型实参
//  4. sgen.instantiate_enum → 实例化 enum 索引
//  5. 重写接收者名 → mangled 实例名（irgen 构造分派按 en_keys 命中实例）
// 返回枚举类型 id（types.enum_of(实例索引)）。
func infer_generic_enum_construct(gti: i64, vname: string, args: table<i64>, id: i64) -> i64 {
    var tmpl_node = gty_node[gti]
    var full = intern.lookup(gty_keys[gti])
    var soff = sstate.slot_off(tmpl_node)
    var nv = sstate.nchild(tmpl_node) - soff
    var vi: i64 = -1
    var k: i64 = 0
    while k < nv {
        if sstate.name_str(sstate.child(tmpl_node, soff + k)) == vname {
            vi = k
            break
        }
        k = k + 1
    }
    if vi < 0 {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "枚举 '" + full + "' 没有变体 '" + vname + "'"
        return -1
    }
    var v = sstate.child(tmpl_node, soff + vi)
    var np = sstate.nchild(v)
    var nc = len(args)
    if np == 0 {
        // 无 payload 变体（如 Option.None）：无实参可推断类型实参 → 报错
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "泛型枚举 '" + full + "' 的无 payload 变体 '" + vname + "' 无法推断类型参数（一期请用带 payload 变体构造或显式类型标注，如 '" + full + "<i64>." + vname + "' 后续支持）"
        return -1
    }
    if nc != np {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "构造 '" + full + "." + vname + "' 期望 " + to_string(np) + " 个参数，实际 " + to_string(nc) + " 个"
        return -1
    }
    // 逐个实参推断类型
    var arg_tys: table<i64> = table_new_i64()
    var j: i64 = 0
    while j < nc {
        var at = infer_expr(args[j])
        if at < 0 {
            return -1
        }
        at = refine_arg_ty(args[j], at)
        table_push(arg_tys, at)
        j = j + 1
    }
    // 推断类型实参（payload 类型节点绑定 TypeVar；显式实参一期不支持 → 空表）
    var explicit: table<i64> = table_new_i64()
    var args_t = sgen.infer_type_args_variants(tmpl_node, gti, vname, explicit, arg_tys, id)
    if len(args_t) == 0 {
        return -1  // 推断失败/冲突已报错
    }
    // 实例化 enum（reg_enum + 变体收集 + gin 记录）
    var ei = sgen.instantiate_enum(gti, args_t)
    if ei < 0 {
        return -1
    }
    var mangled = sgen.mangle(full, args_t)
    // 重写接收者名 → mangled 实例名（irgen 的 gen_method_call 按 en_keys 命中）
    s_names[sstate.child(id, sstate.slot_off(id))] = intern.intern(mangled)
    // 实例化 payload 类型校验（非 TypeVar 字段的实参匹配在此暴露）
    var varoff = en_varoff[ei]
    var vtag = en_vtags[varoff + vi]
    var foff = en_vfldoff[varoff + vi]
    var jj: i64 = 0
    while jj < nc {
        var want = en_ftys[foff + jj]
        if !stype.types_match(want, arg_tys[jj], args[jj]) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "构造 '" + mangled + "." + vname + "' 参数类型不匹配：期望 " + types.type_name(want) + "，实际 " + types.type_name(arg_tys[jj])
            return -1
        }
        jj = jj + 1
    }
    var rt = types.enum_of(ei)
    node_types[id] = rt
    g_typed = g_typed + 1
    return rt
}

// ==================== S2.3 目标类型引导的泛型 enum 构造 ====================
// `var b: Result<i64, string> = Result.Err("bad")`：Result.Err 的 payload 是 E
// （string 可推断），但 T 无信息（Err 不含 T）→ infer_generic_enum_construct
// 报"无法推断类型参数 T"。目标类型引导：用赋值/return 目标类型（hint_ty，
// 如 Result<i64,string> 的实例化 enum id）反查 gin 记录提取完整类型实参
// [i64, string]，重新实例化并校验 payload 匹配。
// 探测入口：右侧表达式是 MethodCall（接收者 = 泛型 enum 模板名）时调用。
// 返回推断类型；-1 表示"不是可引导的泛型 enum 构造"（不设错误，调用方回退）。
pub func try_enum_construct_hinted(expr: i64, hint_ty: i64) -> i64 {
    // 支持两种形态（S2.3 扩展）：
    //   - MethodCall：EnumName.Variant(args)（带 payload 构造）
    //   - FieldAccess：EnumName.Variant（无 payload 变体裸引用，如 Option.None）
    // 无 payload 变体裸引用在 infer_expr 的 FieldAccess 分支会报"无法推断类型
    // 参数"，此处用 hint 的目标类型实参补全实例化。
    var is_fa: bool = false
    if s_tags[expr] == S_N_METHOD_CALL {
        is_fa = false
    } else if s_tags[expr] == S_N_FIELD_ACCESS {
        is_fa = true
    } else {
        return -1
    }
    var recv: i64 = -1
    if is_fa {
        // FieldAccess(children=[base])：接收者在 children[0]
        recv = sstate.child(expr, 0)
    } else {
        recv = sstate.child(expr, sstate.slot_off(expr))
    }
    if s_tags[recv] != S_N_VAR {
        return -1
    }
    var rname = sstate.name_str(recv)
    var gidx = sstate.gt_find(rname)
    if gidx < 0 || gty_is_struct[gidx] != 2 {
        return -1  // 不是泛型 enum 模板
    }
    // hint 必须是同模板的实例化 enum
    if types.kind(hint_ty) != K_ENUM {
        return -1
    }
    var hei = types.low(hint_ty)
    var hmangled = sstate.enum_name_of(hei)
    var rec = sstate.gin_find(hmangled)
    if rec < 0 || gin_tmpl[rec] != gidx {
        return -1  // hint 不是该模板的实例化
    }
    var args_t = sstate.gin_args(rec)
    if len(args_t) == 0 {
        return -1
    }
    // 变体定位（同 infer_generic_enum_construct）
    var vname = sstate.name_str(expr)
    var tmpl_node = gty_node[gidx]
    var soff = sstate.slot_off(tmpl_node)
    var nv = sstate.nchild(tmpl_node) - soff
    var vi: i64 = -1
    var k: i64 = 0
    while k < nv {
        if sstate.name_str(sstate.child(tmpl_node, soff + k)) == vname {
            vi = k
            break
        }
        k = k + 1
    }
    if vi < 0 {
        return -1
    }
    // 实例化（幂等）
    var ei = sgen.instantiate_enum(gidx, args_t)
    if ei < 0 {
        return -1
    }
    var full = intern.lookup(gty_keys[gidx])
    var mangled = sgen.mangle(full, args_t)
    s_names[recv] = intern.intern(mangled)
    // payload 实参校验（实例化后字段类型已具体化）
    var args: table<i64> = table_new_i64()
    if !is_fa {
        // MethodCall：实参从 slot_off+1 起收集
        var nc = sstate.nchild(expr)
        var off2 = sstate.slot_off(expr)
        var j: i64 = off2 + 1
        while j < nc {
            table_push(args, sstate.child(expr, j))
            j = j + 1
        }
    }
    // FieldAccess（无 payload 裸引用）：args 保持空表，np 必须为 0
    var varoff = en_varoff[ei]
    var np = en_vnfld[varoff + vi]
    if len(args) != np {
        sm_err_line = s_lines[expr]
        sm_err_col = s_cols[expr]
        sm_err_msg = "构造 '" + mangled + "." + vname + "' 期望 " + to_string(np) + " 个参数，实际 " + to_string(len(args)) + " 个"
        return -1
    }
    var foff = en_vfldoff[varoff + vi]
    var jj: i64 = 0
    while jj < len(args) {
        var at = infer_expr(args[jj])
        if at < 0 {
            return -1
        }
        at = refine_arg_ty(args[jj], at)
        var want = en_ftys[foff + jj]
        if !stype.types_match(want, at, args[jj]) {
            sm_err_line = s_lines[expr]
            sm_err_col = s_cols[expr]
            sm_err_msg = "构造 '" + mangled + "." + vname + "' 参数类型不匹配：期望 " + types.type_name(want) + "，实际 " + types.type_name(at)
            return -1
        }
        jj = jj + 1
    }
    node_types[expr] = types.enum_of(ei)
    g_typed = g_typed + 1
    return types.enum_of(ei)
}

// 接收者路径名拼接（Segment 链 / FieldAccess 链 / Var / Path 统一递归）
pub func recv_path_name(recv: i64) -> string {
    var tag = s_tags[recv]
    if tag == S_N_VAR {
        return sstate.name_str(recv)
    }
    if tag == S_N_FIELD_ACCESS {
        // FieldAccess[name=字段名, children=[基址]]：字段名在 name 字段
        var base = sstate.child(recv, 0)
        var bp = recv_path_name(base)
        var fnm = sstate.name_str(recv)
        if bp == "" {
            return fnm
        }
        return bp + "::" + fnm
    }
    if tag == S_N_PATH {
        // Path(children=[Segment...])：逐段拼接
        var out: string = ""
        var nc = sstate.nchild(recv)
        var i: i64 = 0
        while i < nc {
            if i > 0 {
                out = out + "::"
            }
            out = out + sstate.name_str(sstate.child(recv, i))
            i = i + 1
        }
        return out
    }
    // 兜底：逐 child 拼接名字
    var out2: string = ""
    var nc2 = sstate.nchild(recv)
    var j: i64 = 0
    while j < nc2 {
        if j > 0 {
            out2 = out2 + "::"
        }
        out2 = out2 + sstate.name_str(sstate.child(recv, j))
        j = j + 1
    }
    return out2
}

// S2.4 port 方法调用推断（动态分发）：接收者类型 = port 对象。
// 查 port 方法表（方法名 -> 声明序号 = vtable 字段序）；校验实参个数/类型
// （方法签名去 self）；返回类型 = 方法返回类型。irgen 侧生成 vtable
// 间接调用（call_indirect(70)：entry = vtable[序号]，env = data）。
func infer_port_method(pty: i64, mname: string, args: table<i64>, id: i64) -> i64 {
    var pi = types.low(pty)
    var mi = sstate.port_method_idx(pi, mname)
    if mi < 0 {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "port '" + types.type_name(pty) + "' 没有方法 '" + mname + "'"
        return -1
    }
    var np = sstate.port_method_nparams(pi, mi)  // 含 self
    var n_args = len(args)  // 调用点实参（不含 self）
    if n_args != np - 1 {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "方法 '" + mname + "' 期望 " + to_string(np - 1) + " 个参数，实际 " + to_string(n_args) + " 个"
        return -1
    }
    var j: i64 = 0
    while j < n_args {
        var at = infer_expr(args[j])
        if at < 0 {
            return -1
        }
        var want = sstate.port_method_param(pi, mi, 1 + j)  // 去 self
        if !stype.types_compatible(want, at) && !stype.types_match(want, at, args[j]) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "方法 '" + mname + "' 参数类型不匹配：期望 " + types.type_name(want) + "，实际 " + types.type_name(at)
            return -1
        }
        j = j + 1
    }
    var rt = sstate.port_method_ret(pi, mi)
    node_types[id] = rt
    g_typed = g_typed + 1
    return rt
}

// struct 实例方法转发
pub func infer_struct_method(recv: i64, recv_ty: i64, mname: string, args: table<i64>, id: i64) -> i64 {
    var bk = types.kind(recv_ty)
    if bk != K_STRUCT {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "方法调用的对象必须是 struct 实例或 struct 名，实际是 " + types.type_name(recv_ty)
        return -1
    }
    var si = types.low(recv_ty)
    var sname = intern.lookup(st_keys[si])
    var full = sname + "::" + mname
    var sig = sstate.fn_sig(full)
    if sig < 0 {
        // T3b 泛型方法（2026-08-14）：接收者是实例化 struct（如 Box$i64）→
        // 目标函数 = 模板方法（Box::get）→ 从接收者类型提取类型实参 → 展开
        var rec = sstate.gin_find(sname)
        if rec >= 0 && gin_is_struct[rec] == 1 {
            var tmpl_full = intern.lookup(gty_keys[gin_tmpl[rec]])  // "Box"
            var tmpl_method = tmpl_full + "::" + mname              // "Box::get"
            var m_gti = sstate.gt_find(tmpl_method)
            if m_gti >= 0 && gty_is_struct[m_gti] == 0 {
                var gr = infer_generic_method(rec, m_gti, tmpl_method, recv, recv_ty, args, id)
                if gr >= 0 {
                    return gr
                }
                if str_len(sm_err_msg) > 0 {
                    return -1  // 泛型方法推断/展开失败（已报错）
                }
            }
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "struct '" + sname + "'（含继承链）没有方法 '" + mname + "'"
        return -1
    }
    // 方法函数必须 pub
    var vr = sstate.check_visibility(full, sig, id)
    if vr < 0 {
        return -1
    }
    // S1.2 安全边界：unsafe 方法在安全代码中调用 = 编译错误
    if sstate.sig_unsafe(sig) == 1 && g_unsafe_depth == 0 {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "调用 unsafe 方法 '" + full + "' 必须在 unsafe 块或 unsafe 函数中（安全代码禁止触底）"
        return -1
    }
    // 方法：首参 = 接收者（按引用）。参数个数（含接收者对象，对齐 Rust）：
    // required = sg_required（含接收者必选数），total = 形参数，n_args = args+1
    var req_m = sg_required[sig]
    var total = sg_nparams[sig]
    var has_var = sstate.fn_has_variadic(sig) == 1
    var n_args = len(args) + 1
    if n_args < req_m || (!has_var && n_args > total) {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        var cnt_m = ""
        if has_var {
            cnt_m = to_string(req_m) + "+"
        } else if req_m == total {
            cnt_m = to_string(total)
        } else {
            cnt_m = to_string(req_m) + "-" + to_string(total)
        }
        sm_err_msg = "方法 '" + full + "' 期望 " + cnt_m + " 个参数（含接收者对象），实际 " + to_string(n_args) + " 个"
        return -1
    }
    // 接收者类型匹配（首参）
    var off = sg_off[sig]
    var want = sp_tys[off]
    if !stype.types_compatible(want, recv_ty) {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "方法 '" + full + "' 首参类型不匹配：期望 " + types.type_name(want) + "，实际 " + types.type_name(recv_ty)
        return -1
    }
    var j: i64 = 0
    while j < len(args) {
        var at = infer_expr(args[j])
        if at < 0 {
            return -1
        }
        var want2 = sp_tys[off + 1 + j]
        if has_var {
            if 1 + j >= total - 1 {
                want2 = sstate_fn_variadic_elem(sig)   // 变参：元素类型匹配
            }
        }
        if !stype.types_compatible(want2, at) && !stype.types_match(want2, at, args[j]) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "方法 '" + full + "' 参数类型不匹配：期望 " + types.type_name(want2) + "，实际 " + types.type_name(at)
            return -1
        }
        j = j + 1
    }
    var rt = sg_ret[sig]
    node_types[id] = rt
    g_typed = g_typed + 1
    return rt
}

// ==================== 泛型方法调用（T3b） ====================
// 接收者 = 实例化 struct（rec 为其 gin 记录），目标 = 模板方法（tmpl_method
// 如 "Box::get"）。类型实参：首参（接收者，Box<T> ↔ recv_ty）匹配 + 其余实参
// 推断；然后展开方法模板（mangled = Box$i64::get，与 irgen 方法分派一致）。
// 返回实例化返回类型；失败 -1（推断/展开失败已报错；未报错 = 不适用）。
func infer_generic_method(rec: i64, m_gti: i64, tmpl_method: string, recv: i64, recv_ty: i64, args: table<i64>, id: i64) -> i64 {
    // 显式类型实参（MethodCall 的 N_TYPE_ARGS，`b.get<i64>(...)`）
    var explicit = parse_explicit_args(id)
    if len(explicit) == 0 && str_len(sm_err_msg) > 0 {
        return -1
    }
    // 实参类型表：接收者为首参（类型 = 实例化 struct）
    var m_args_t: table<i64> = table_new_i64()
    table_push(m_args_t, recv_ty)
    var k: i64 = 0
    while k < len(args) {
        var at = infer_expr(args[k])
        if at < 0 {
            return -1
        }
        table_push(m_args_t, at)
        k = k + 1
    }
    // 推断类型实参（首参 Box<T> ↔ recv_ty 绑定 T，其余实参补全）
    var tmpl_node = gty_node[m_gti]
    var args_t = sgen.infer_type_args(tmpl_node, m_gti, explicit, 0, m_args_t, id)
    if len(args_t) == 0 {
        return -1  // 推断失败/冲突已报错
    }
    // 展开方法模板（mangled = Box$i64::get，与 irgen gen_method_call 分派名一致）
    var mangled = sgen.mangle(tmpl_method, args_t)
    var sig2 = sgen.instantiate_fn(m_gti, args_t, s_lines[id], s_cols[id])
    if sig2 < 0 {
        return -1
    }
    // 可见性校验
    var vr = sstate.check_visibility(mangled, sig2, id)
    if vr < 0 {
        return -1
    }
    // 参数个数（含接收者对象）
    var req_m = sg_required[sig2]
    var total = sg_nparams[sig2]
    var n_args = len(args) + 1
    if n_args < req_m || n_args > total {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "方法 '" + tmpl_method + "' 期望 " + to_string(req_m) + "-" + to_string(total) + " 个参数（含接收者对象），实际 " + to_string(n_args) + " 个"
        return -1
    }
    // 接收者类型匹配（首参 = 实例化 struct，与实例化形参一致）
    var off = sg_off[sig2]
    var want = sp_tys[off]
    if !stype.types_compatible(want, recv_ty) {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "方法 '" + tmpl_method + "' 首参类型不匹配：期望 " + types.type_name(want) + "，实际 " + types.type_name(recv_ty)
        return -1
    }
    // 其余实参类型检查（实例化形参已具体化）
    var j: i64 = 0
    while j < len(args) {
        var at = infer_expr(args[j])
        if at < 0 {
            return -1
        }
        var want2 = sp_tys[off + 1 + j]
        if !stype.types_compatible(want2, at) && !stype.types_match(want2, at, args[j]) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "方法 '" + tmpl_method + "' 参数类型不匹配：期望 " + types.type_name(want2) + "，实际 " + types.type_name(at)
            return -1
        }
        j = j + 1
    }
    var rt = sg_ret[sig2]
    node_types[id] = rt
    g_typed = g_typed + 1
    return rt
}

}
