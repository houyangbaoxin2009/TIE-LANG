type tie<logic>
// compiler/frontend/semantic_test.tie —— 自举 v2 T2.6 完整语义分析器验收程序
// ============================================================
// 作用：
//   1) 无参数运行：对 corpus.txt（101 文件）中 pass 文件做
//      parser.parse_src + semantic.check，断言返回 "OK:" 开头；
//   2) 负例断言（与 Rust semantic 行为对齐）：未声明变量/类型不匹配/
//      const 赋值/函数重复定义/循环外 break；
//   3) check_debug 输出类型表/签名摘要（人工比对 Rust）；
//   4) 输出「semantic 验收通过」exit 0。
// 编译运行：target\release\tie-llvm.exe compiler\frontend\semantic_test.tie
// 注：types 命名空间经 semantic 树（scheck→scollect→sinfer→sbuiltin→stype→data→
// types.tie）内联提供，无需显式 import——显式 import 会产生未归一化路径
// （"../" 不折叠）导致同一文件被重复展开（intern_pool 重复定义）。
import "./semantic.tie"

// 断言辅助
func tcheck(ok: bool, what: string) -> bool {
    if !ok {
        println("自检失败: " + what)
    }
    return ok
}

// 字符串断言：失败打印期望/实际
func tcheck_str(got: string, want: string, what: string) -> bool {
    if got != want {
        println("自检失败: " + what)
        println("  期望: [" + want + "]")
        println("  实际: [" + got + "]")
        return false
    }
    return true
}

// 是否 ERR: 协议错误
func has_err(s: string) -> bool {
    return str_len(s) >= 4 &&
        str_char(s, 0) == "E" && str_char(s, 1) == "R" &&
        str_char(s, 2) == "R" && str_char(s, 3) == ":"
}

// 是否 OK: 开头
func is_ok(s: string) -> bool {
    return str_len(s) >= 3 &&
        str_char(s, 0) == "O" && str_char(s, 1) == "K" && str_char(s, 2) == ":"
}

// 路径目录：返回最后一个 '/' 之前的子串（含 '/'）；无 '/' 返回 ""
func path_dir_of(path: string) -> string {
    var n = str_len(path)
    var i: i64 = n - 1
    var last: i64 = -1
    while i >= 0 {
        if str_char(path, i) == "/" {
            last = i
            break
        }
        i = i - 1
    }
    if last < 0 {
        return ""
    }
    return str.slice(path, 0, last + 1)
}

// 检查单个 pass 文件：parse + import 展开 + check 全通过
func check_file(path: string) -> i64 {
    var src = file_read(path)
    var r = semantic.check_src(src, path_dir_of(path))
    if !is_ok(r) {
        println("  [" + path + "] 语义错误: " + str.slice(r, 0, 120))
        return 0
    }
    return 1
}

// 负例：期望包含关键字的消息
func expect_err(src: string, keyword: string, label: string) -> i64 {
    var r = semantic.check_src(src, "")
    if is_ok(r) {
        println("  [" + label + "] 期望语义错误但通过")
        return 0
    }
    // 检查消息含关键字
    if str.contains(r, keyword) {
        return 1
    }
    println("  [" + label + "] 消息缺关键字 '" + keyword + "': " + r)
    return 0
}

func main() {
    var ok: bool = true

    // ============ corpus 全量检查 ============
    var corpus = file_read("scripts/bench/corpus.txt")
    var total_ok: i64 = 0
    var total_err: i64 = 0
    var total_excl: i64 = 0
    var n = str_len(corpus)
    var pos: i64 = 0
    var line_start: i64 = 0
    while pos <= n {
        var at_end: bool = false
        if pos == n {
            at_end = true
        } else {
            if str_char(corpus, pos) == "\n" {
                at_end = true
            }
        }
        if at_end {
            var line = str.slice(corpus, line_start, pos)
            var line_len = str_len(line)
            // 兼容 CRLF 行尾（corpus.txt 为 CRLF）：剥离尾随 \r，
            // 否则 role 字段变成 "pass\r" 匹配失败 → corpus 恒 0/0
            if line_len > 0 && str_char(line, line_len - 1) == "\r" {
                line = str.slice(line, 0, line_len - 1)
                line_len = line_len - 1
            }
            var is_comment: bool = false
            if line_len > 0 {
                if str_char(line, 0) == "#" {
                    is_comment = true
                }
            }
            if line_len > 0 && !is_comment {
                // 格式：<path> <pass|fail>
                var space_at: i64 = -1
                var i: i64 = 0
                while i < line_len {
                    if str_char(line, i) == " " {
                        space_at = i
                        break
                    }
                    i = i + 1
                }
                var path = ""
                var role = ""
                if space_at >= 0 {
                    path = str.slice(line, 0, space_at)
                    role = str.slice(line, space_at + 1, line_len)
                }
                if role == "pass" {
                    var r = check_file(path)
                    if r == 1 {
                        total_ok = total_ok + 1
                    } else if r == 0 {
                        total_err = total_err + 1
                    } else {
                        total_excl = total_excl + 1
                    }
                }
            }
            line_start = pos + 1
        }
        pos = pos + 1
    }
    println("corpus pass: " + to_string(total_ok) + "/" + to_string(total_ok + total_err) + "（excluded " + to_string(total_excl) + "，ERR " + to_string(total_err) + "）")
    ok = tcheck(total_err == 0, "corpus 全部 pass") && ok

    // ============ 负例断言 ============
    var neg_ok: i64 = 0
    var neg_total: i64 = 0
    var n1 = expect_err("func main() {\n    var x = 1\n    println(y)\n}\n", "未声明的变量", "未声明变量")
    neg_total = neg_total + 1
    neg_ok = neg_ok + n1
    var n2 = expect_err("func main() {\n    var x: i64 = \"hello\"\n}\n", "类型不匹配", "类型不匹配")
    neg_total = neg_total + 1
    neg_ok = neg_ok + n2
    var n3 = expect_err("func main() {\n    const K: i64 = 1\n    K = 2\n}\n", "不能给 const", "const 赋值")
    neg_total = neg_total + 1
    neg_ok = neg_ok + n3
    var n4 = expect_err("func f() {}\nfunc f() {}\nfunc main() {}\n", "重复定义", "函数重复定义")
    neg_total = neg_total + 1
    neg_ok = neg_ok + n4
    var n5 = expect_err("func main() {\n    break\n}\n", "只能出现在循环体内", "循环外 break")
    neg_total = neg_total + 1
    neg_ok = neg_ok + n5
    println("负例断言：" + to_string(neg_ok) + "/" + to_string(neg_total) + " 通过")
    ok = tcheck(neg_ok == neg_total, "负例全部通过") && ok

    // ============ 类型表验证（check_debug）============
    var hello = file_read("examples/hello.tie")
    var dbg = semantic.check_debug_src(hello, "examples/")
    println("类型表/签名摘要：")
    println(dbg)

    // ============ TypeVar 类型参数（types.tie，泛型单态化铺垫）============
    // 编码：5<<40 = 5497558138880；kind(5<<40 段) = 5（K_TYPEVAR）。
    // 名字即身份：同名类型参数全局同 id、跨函数稳定（mangling 友好）。
    var tv_t = types.var_of("T")
    var tv_u = types.var_of("U")
    ok = tcheck(tv_t != tv_u, "TypeVar 编码唯一（T ≠ U）") && ok
    ok = tcheck(types.var_of("T") == tv_t, "TypeVar 幂等（同名同 id）") && ok
    ok = tcheck(tv_t >= 5497558138880, "TypeVar id 落在 5<<40 段") && ok
    ok = tcheck(types.kind(tv_t) == 5, "TypeVar kind = K_TYPEVAR(5)") && ok
    ok = tcheck(types.is_typevar(tv_t) && !types.is_typevar(types.named(3)), "is_typevar 判定（TypeVar 真/普通类型假）") && ok
    ok = tcheck(types.type_name(tv_t) == "T", "type_name 还原类型参数名") && ok
    // table<TypeVar>：var_of 结果恒 ≥ NEST_SLOT_OFF(100)，table_of 走嵌套
    // 聚合序号表路径（nest_tbl_elems 查/登记），table_elem 可完整还原。
    var tv_tbl = types.table_of(tv_t)
    ok = tcheck(types.kind(tv_tbl) == 1, "table<TypeVar> kind = K_TABLE(1)") && ok
    ok = tcheck(types.table_elem(tv_tbl) == tv_t, "table_elem 还原回 TypeVar id") && ok
    ok = tcheck(types.is_typevar(types.table_elem(tv_tbl)), "table 元素 is_typevar") && ok
    ok = tcheck(types.type_name(tv_tbl) == "table<T>", "table<TypeVar> type_name") && ok
    // TypeVar 不是任何具体类型：判据族全 false
    ok = tcheck(!types.is_int(tv_t) && !types.is_float(tv_t) && !types.is_number(tv_t), "TypeVar 非数值") && ok
    ok = tcheck(!types.is_bool_like(tv_t) && !types.is_wide(tv_t), "TypeVar 非布尔/宽类型") && ok
    ok = tcheck(!types.is_table(tv_t) && !types.is_map(tv_t), "TypeVar 非表/映射") && ok
    // 现有编码零破坏：内置/表/映射/tuple 行为不变
    ok = tcheck(types.kind(types.named(3)) == 0 && types.type_name(types.named(3)) == "i64", "内置类型编码不变") && ok
    ok = tcheck(types.kind(types.table_of(3)) == 1 && types.type_name(types.table_of(3)) == "table<i64>", "table<i64> 编码不变") && ok
    ok = tcheck(types.kind(types.tuple_of(0)) == 4 && types.type_name(types.tuple_of(0)) == "tuple", "tuple 编码不变") && ok

    if !ok {
        exit(1)
    }
    println("semantic 验收通过")
}
