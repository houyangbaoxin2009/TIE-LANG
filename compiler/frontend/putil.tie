// tie:library
// compiler/frontend/putil.tie —— T2.5 parser 工具层（模块拆分）
// ============================================================
// 里程碑：自举 v2 计划 T2.5（.omo/plans/self-hosting-v2.md）完整 parser
// 拆分为 5 模块之一（本文件 = 错误/token 流/字面量/判定工具；调试名表
// 拆出到 ./pnames.tie）。对应 proto/parser.tie 345-752 行逻辑搬移
// + fill_pending 新增。
// 依赖：./pst.tie（状态）+ ./ast.tie（N_* 常量 + 节点池，T2.1 复用）
// + ./lexer.tie（T2.4 词法器，经其 import 树传递可达 errors/interner/string）
// + ./pnames.tie（调试名表）。
// 树式无环：本文件是 import 树深层节点，由 pexpr_chain.tie import（传递可达上层）。
import "./pst.tie"
import "./ast.tie"
import "./lexer.tie"
import "./pnames.tie"

namespace putil {

// ---------- 错误槽位 ----------
// 记录语法错误（line/col 1 起；msg 为 errors 表消息或格式函数结果）
pub func set_err(line: i64, col: i64, msg: string) {
    p_err_line = line
    p_err_col = col
    p_err_msg = msg
}

// 组装错误协议文本：ERR:<line> <col> <message>（errors 模块统一拼装）
pub func err_protocol() -> string {
    return errors.err_lex_err(p_err_line, p_err_col, p_err_msg)
}

// ---------- token 流加载（新增：正式版直接消费 lexer 列式表）----------
// 从 lexer 列式 token 表一次性加载到 pst 队列（替代 proto 的协议文本 re-parse）。
// run_lex 成功后调用；随后 putil 的 peek/advance 全走 pst 队列。
pub func fill_pending() {
    g_pending = table_new_i64()
    g_pending_lines = table_new_i64()
    g_pending_cols = table_new_i64()
    g_pending_lexemes = table_new_i64()
    g_pos = 0
    g_pending_idx = 0
    var n = lexer.token_count()
    var i: i64 = 0
    while i < n {
        table_push(g_pending, lexer.token_tag(i))
        table_push(g_pending_lines, lexer.token_line(i))
        table_push(g_pending_cols, lexer.token_col(i))
        table_push(g_pending_lexemes, lexer.token_lexeme_id(i))
        i = i + 1
    }
}

// ---------- 词法游标（含 >> 分裂 pending 队列）----------

// 待消费虚拟 token 个数
pub func pending_n() -> i64 {
    return len(g_pending) - g_pending_idx
}

// 当前有效 token tag（先消费 pending 队列，再消费真实 token 流）
pub func peek_tag() -> i64 {
    if g_pending_idx < len(g_pending) {
        return g_pending[g_pending_idx]
    }
    return lexer.token_tag(g_pos)
}

// 当前有效 token 行号
pub func peek_line() -> i64 {
    if g_pending_idx < len(g_pending) {
        return g_pending_lines[g_pending_idx]
    }
    return lexer.token_line(g_pos)
}

// 当前有效 token 列号
pub func peek_col() -> i64 {
    if g_pending_idx < len(g_pending) {
        return g_pending_cols[g_pending_idx]
    }
    return lexer.token_col(g_pos)
}

// 当前有效 token 的 lexeme 文本（虚拟 token 无 lexeme 返回空串）
pub func peek_lexeme() -> string {
    if g_pending_idx < len(g_pending) {
        return interner.lookup(g_pending_lexemes[g_pending_idx])
    }
    return lexer.token_lexeme(g_pos)
}

// 推进游标：优先消费 pending 队列，队列空时消费真实 token 流
pub func advance() {
    if g_pending_idx < len(g_pending) {
        g_pending_idx = g_pending_idx + 1
    } else {
        g_pos = g_pos + 1
    }
}

// 消费当前 token 若匹配 tag；返回是否消费
pub func eat(tag: i64) -> bool {
    if peek_tag() == tag {
        advance()
        return true
    }
    return false
}

// 第 n 个后续 token 的 tag（n=0 当前，1 下一…；合并 pending 与真实流的合成视图）
pub func peek_n(n: i64) -> i64 {
    var pn = pending_n()
    if n < pn {
        return g_pending[g_pending_idx + n]
    }
    var k = g_pos + (n - pn)
    var total = lexer.token_count()
    if k >= total {
        k = total - 1
    }
    return lexer.token_tag(k)
}

// 当前 token 的可读描述（对齐 Rust describe；错误消息用）
pub func describe(tag: i64) -> string {
    if tag == lex_ident {
        return "标识符 '" + peek_lexeme() + "'"
    }
    if tag == lex_int {
        return "整数 " + peek_lexeme()
    }
    if tag == lex_float {
        return "浮点数 " + peek_lexeme()
    }
    if tag == lex_str {
        return "字符串"
    }
    if tag == lex_typekw {
        return "类型 '" + peek_lexeme() + "'"
    }
    if tag == lex_semi {
        return "分号"
    }
    if tag == lex_eof {
        return "文件结束"
    }
    return pnames.tok_debug_name(tag)
}

// 期望当前 token 为指定 tag；失败报「期望 {what}，实际是 {describe}」
pub func expect(tag: i64, what: string) -> bool {
    if peek_tag() == tag {
        advance()
        return true
    }
    set_err(peek_line(), peek_col(), errors.syn_expect(what, describe(peek_tag())))
    return false
}

// 期望当前为标识符；成功返回其字符串池 id，失败返回 -1
pub func expect_ident() -> i64 {
    if peek_tag() == lex_ident {
        var id = interner.intern(peek_lexeme())
        advance()
        return id
    }
    set_err(peek_line(), peek_col(), errors.syn_expect_ident(describe(peek_tag())))
    return -1
}

// ---------- >> 闭括号分裂（A1/E1 类型参数）----------

// 分裂当前 token（Shr/Ge/ShrEq）为两个：当前位置按 Gt 消费，remainder 成为下一 token。
// 分裂映射：Shr→余 Gt、Ge→余 Eq、ShrEq→余 Ge（Ge 再经一轮分裂为 Gt + Eq）。
// 语义约定：调用方（expect_type_gt）对分裂类 token 返回 true = 已消费第 1 个
// 字符（'>'），分裂出的 remainder（第 2 个字符）顶替当前位置供下一次消费。
func split_current_gt(remainder: i64) {
    if g_pending_idx < len(g_pending) {
        // 当前在 pending 队列中：原位覆盖为 remainder（第 2 个字符），
        // **不推进游标**——第 1 个 '>' 已由 expect_type_gt 的 return true 隐含
        // 消费，下一次 peek 读到 remainder。
        // 曾误推进 g_pending_idx：`table<table<i64>>` 的 >> 分裂后第 2 个 '>'
        // 被跳过直接读到 RParen（语法错误 @9:34 期望 '>' 实得 RParen）。
        g_pending[g_pending_idx] = remainder
    } else {
        // 当前在真实 token 流：记录 span，push remainder 到队尾，消费原位
        table_push(g_pending, remainder)
        table_push(g_pending_lines, lexer.token_line(g_pos))
        table_push(g_pending_cols, lexer.token_col(g_pos))
        g_pos = g_pos + 1
    }
}

// 类型参数闭括号 '>'（支持 Shr/Ge/ShrEq 复合 token 分裂）
pub func expect_type_gt(what: string) -> bool {
    var tag = peek_tag()
    if tag == lex_gt {
        advance()
        return true
    }
    if tag == lex_shr {
        split_current_gt(lex_gt)
        return true
    }
    if tag == lex_ge {
        split_current_gt(lex_eq)
        return true
    }
    if tag == lex_shreq {
        split_current_gt(lex_ge)
        return true
    }
    set_err(peek_line(), peek_col(), errors.syn_expect(what, describe(tag)))
    return false
}

// ---------- 类型关键字与整数字面量 ----------

// 类型关键字文本 → TyKw 索引（对齐 Rust TyKw 枚举顺序）
pub func typekw_index(s: string) -> i64 {
    switch s {
        case "i8": return 0
        case "i16": return 1
        case "i32": return 2
        case "i64": return 3
        case "u8": return 4
        case "u16": return 5
        case "u32": return 6
        case "u64": return 7
        case "f32": return 8
        case "f64": return 9
        case "bool": return 10
        case "trit": return 11
        case "char": return 12
        case "string": return 13
        case "void": return 14
        case "code": return 15
        case "num": return 16
        case "text": return 17
        case "misc": return 18
        case "table": return 19
        case "map": return 20
        default: return -1
    }
}

// 单个字符的数值（0-9 a-f A-F → 0-15；其余 -1）
func digit_val(c: string) -> i64 {
    var cc = char_code(c)
    if cc >= 48 {
        if cc <= 57 {
            return cc - 48
        }
    }
    if cc >= 97 {
        if cc <= 102 {
            return cc - 87
        }
    }
    if cc >= 65 {
        if cc <= 70 {
            return cc - 55
        }
    }
    return -1
}

// 整数字面量 lexeme → i64 值（支持十进制/0x/0b/0o/0t 前缀）
pub func parse_int_lit(lex: string) -> i64 {
    var n = str_len(lex)
    var base: i64 = 10
    var start: i64 = 0
    if n >= 2 {
        var c0 = str_char(lex, 0)
        var c1 = str_char(lex, 1)
        if c0 == "0" {
            if c1 == "x" || c1 == "X" {
                base = 16
                start = 2
            } else if c1 == "b" || c1 == "B" {
                base = 2
                start = 2
            } else if c1 == "o" || c1 == "O" {
                base = 8
                start = 2
            } else if c1 == "t" || c1 == "T" {
                base = 3
                start = 2
            }
        }
    }
    var val: i64 = 0
    var i = start
    while i < n {
        var c = str_char(lex, i)
        var d = digit_val(c)
        if d < 0 {
            break
        }
        if d >= base {
            break
        }
        val = val * base + d
        i = i + 1
    }
    return val
}

// 类型节点是否为表类型（table<T> 或裸 table；VarDecl 省略初始化器判定用）
pub func is_table_type(ty: i64) -> bool {
    if ty < 0 {
        return false
    }
    var tag = ast.tag(ty)
    if tag == N_TABLE_TYPE {
        return true
    }
    if tag == N_NAMED_TYPE {
        if ast.val(ty) == 19 {
            return true
        }
    }
    return false
}

// 是否赋值运算符 token（快速路径预探测，不消费）
pub func is_assign_op_tag(tag: i64) -> bool {
    if tag == lex_eq {
        return true
    }
    if tag >= lex_pluseq {
        if tag <= lex_shreq {
            return true
        }
    }
    return false
}

// 消费赋值运算符；普通 = 返回 -1，复合返回对应二元 op 码，未匹配返回 -2
pub func eat_assign_op() -> i64 {
    var tag = peek_tag()
    var op = -2
    if tag == lex_eq {
        op = -1
    } else if tag == lex_pluseq {
        op = B_ADD
    } else if tag == lex_minuseq {
        op = B_SUB
    } else if tag == lex_stareq {
        op = B_MUL
    } else if tag == lex_slasheq {
        op = B_DIV
    } else if tag == lex_percenteq {
        op = B_MOD
    } else if tag == lex_ampeq {
        op = B_BITAND
    } else if tag == lex_pipeeq {
        op = B_BITOR
    } else if tag == lex_careteq {
        op = B_BITXOR
    } else if tag == lex_shleq {
        op = B_SHL
    } else if tag == lex_shreq {
        op = B_SHR
    }
    if op != -2 {
        advance()
    }
    return op
}

// 表达式是否可寻址（字段赋值 base 校验）：Var 或 FieldAccess 链
pub func is_addressable_base(id: i64) -> bool {
    if id < 0 {
        return false
    }
    var tag = ast.tag(id)
    if tag == N_VAR {
        return true
    }
    if tag == N_FIELD_ACCESS {
        return is_addressable_base(ast.child_at(id, 0))
    }
    return false
}

// 字符串前缀判断（strcmp 逐字符）
pub func has_prefix(s: string, pre: string) -> bool {
    var n = str_len(pre)
    if str_len(s) < n {
        return false
    }
    var i: i64 = 0
    while i < n {
        if str_char(s, i) != str_char(pre, i) {
            return false
        }
        i = i + 1
    }
    return true
}

}
