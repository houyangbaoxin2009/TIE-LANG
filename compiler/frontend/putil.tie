type tie<class>
// compiler/frontend/putil.tie —— T2.5 parser 工具层（模块拆分）
// ============================================================
// 里程碑：自举 v2 计划 T2.5（.omo/plans/self-hosting-v2.md）完整 parser
// 拆分为 5 模块之一（本文件 = 错误/token 流/字面量/判定工具；调试名表
// 拆出到 ./pnames.tie）。对应 proto/parser.tie 345-752 行逻辑搬移
// + fill_pending 新增。
// 依赖：./pst.tie（状态）+ ./ast.tie（N_* 常量 + 节点池，T2.1 复用）
// + ./lexer.tie（T2.4 词法器，经其 import 树传递可达 errors/interner/string）
// + ./pnames.tie（调试名表）。
// 树式无环：本文件是 import 树深层节点，由 pexpr_chain.tie import（传递可达上层）。
import "./pst.tie"
import "./ast.tie"
import "./lexer.tie"
import "./pnames.tie"

namespace putil {

// ---------- 错误槽位 ----------
// 记录语法错误（line/col 1 起；msg 为 errors 表消息或格式函数结果）
pub func set_err(line: i64, col: i64, msg: string) {
    p_err_line = line
    p_err_col = col
    p_err_msg = msg
}

// 组装错误协议文本：ERR:<line> <col> <message>（errors 模块统一拼装）
pub func err_protocol() -> string {
    return errors.err_lex_err(p_err_line, p_err_col, p_err_msg)
}

// ---------- token 流加载（新增：正式版直接消费 lexer 列式表）----------
// 从 lexer 列式 token 表一次性加载到 pst 队列（替代 proto 的协议文本 re-parse）。
// run_lex 成功后调用；随后 putil 的 peek/advance 全走 pst 队列。
pub func fill_pending() {
    g_pending = table_new_i64()
    g_pending_lines = table_new_i64()
    g_pending_cols = table_new_i64()
    g_pending_lexemes = table_new_i64()
    g_pos = 0
    g_pending_idx = 0
    // S2.2：清空延迟闭包登记（闭包函数体快照，见 defer_closure_*）
    g_defer_nodes = table_new_i64()
    g_defer_pos = table_new_i64()
    g_defer_idx = table_new_i64()
    g_defer_pending = table_new_i64()
    g_defer_pending_lines = table_new_i64()
    g_defer_pending_cols = table_new_i64()
    g_defer_pending_lexemes = table_new_i64()
    g_defer_err_line = table_new_i64()
    g_defer_err_col = table_new_i64()
    g_defer_err_msg = table_new_i64()
    // S3.3：清空延迟准引用块登记（块体快照，见 defer_code_*）
    g_defer_code_nodes = table_new_i64()
    g_defer_code_pos = table_new_i64()
    g_defer_code_idx = table_new_i64()
    g_defer_code_pending = table_new_i64()
    g_defer_code_pending_lines = table_new_i64()
    g_defer_code_pending_cols = table_new_i64()
    g_defer_code_pending_lexemes = table_new_i64()
    g_defer_code_err_line = table_new_i64()
    g_defer_code_err_col = table_new_i64()
    g_defer_code_err_msg = table_new_i64()
    var n = lexer.token_count()
    var i: i64 = 0
    while i < n {
        table_push(g_pending, lexer.token_tag(i))
        table_push(g_pending_lines, lexer.token_line(i))
        table_push(g_pending_cols, lexer.token_col(i))
        table_push(g_pending_lexemes, lexer.token_lexeme_id(i))
        i = i + 1
    }
}

// ---------- 词法游标（含 >> 分裂 pending 队列）----------

// 待消费虚拟 token 个数
pub func pending_n() -> i64 {
    return len(g_pending) - g_pending_idx
}

// 当前有效 token tag（先消费 pending 队列，再消费真实 token 流）
pub func peek_tag() -> i64 {
    if g_pending_idx < len(g_pending) {
        return g_pending[g_pending_idx]
    }
    return lexer.token_tag(g_pos)
}

// 当前有效 token 行号
pub func peek_line() -> i64 {
    if g_pending_idx < len(g_pending) {
        return g_pending_lines[g_pending_idx]
    }
    return lexer.token_line(g_pos)
}

// 当前有效 token 列号
pub func peek_col() -> i64 {
    if g_pending_idx < len(g_pending) {
        return g_pending_cols[g_pending_idx]
    }
    return lexer.token_col(g_pos)
}

// 当前有效 token 的 lexeme 文本（虚拟 token 无 lexeme 返回空串）
pub func peek_lexeme() -> string {
    if g_pending_idx < len(g_pending) {
        return interner.lookup(g_pending_lexemes[g_pending_idx])
    }
    return lexer.token_lexeme(g_pos)
}

// 推进游标：优先消费 pending 队列，队列空时消费真实 token 流
pub func advance() {
    if g_pending_idx < len(g_pending) {
        g_pending_idx = g_pending_idx + 1
    } else {
        g_pos = g_pos + 1
    }
}

// 消费当前 token 若匹配 tag；返回是否消费
pub func eat(tag: i64) -> bool {
    if peek_tag() == tag {
        advance()
        return true
    }
    return false
}

// 第 n 个后续 token 的 tag（n=0 当前，1 下一…；合并 pending 与真实流的合成视图）
pub func peek_n(n: i64) -> i64 {
    var pn = pending_n()
    if n < pn {
        return g_pending[g_pending_idx + n]
    }
    var k = g_pos + (n - pn)
    var total = lexer.token_count()
    if k >= total {
        k = total - 1
    }
    return lexer.token_tag(k)
}

// 当前 token 的可读描述（对齐 Rust describe；错误消息用）
pub func describe(tag: i64) -> string {
    if tag == lex_ident {
        return "标识符 '" + peek_lexeme() + "'"
    }
    if tag == lex_int {
        return "整数 " + peek_lexeme()
    }
    if tag == lex_float {
        return "浮点数 " + peek_lexeme()
    }
    if tag == lex_str {
        return "字符串"
    }
    if tag == lex_typekw {
        return "类型 '" + peek_lexeme() + "'"
    }
    if tag == lex_semi {
        return "分号"
    }
    if tag == lex_eof {
        return "文件结束"
    }
    return pnames.tok_debug_name(tag)
}

// 期望当前 token 为指定 tag；失败报「期望 {what}，实际是 {describe}」
pub func expect(tag: i64, what: string) -> bool {
    if peek_tag() == tag {
        advance()
        return true
    }
    set_err(peek_line(), peek_col(), errors.syn_expect(what, describe(peek_tag())))
    return false
}

// 期望当前为标识符；成功返回其字符串池 id，失败返回 -1
pub func expect_ident() -> i64 {
    if peek_tag() == lex_ident {
        var id = interner.intern(peek_lexeme())
        advance()
        return id
    }
    set_err(peek_line(), peek_col(), errors.syn_expect_ident(describe(peek_tag())))
    return -1
}

// ---------- >> 闭括号分裂（A1/E1 类型参数）----------

// 分裂当前 token（Shr/Ge/ShrEq）为两个：当前位置按 Gt 消费，remainder 成为下一 token。
// 分裂映射：Shr→余 Gt、Ge→余 Eq、ShrEq→余 Ge（Ge 再经一轮分裂为 Gt + Eq）。
// 语义约定：调用方（expect_type_gt）对分裂类 token 返回 true = 已消费第 1 个
// 字符（'>'），分裂出的 remainder（第 2 个字符）顶替当前位置供下一次消费。
func split_current_gt(remainder: i64) {
    if g_pending_idx < len(g_pending) {
        // 当前在 pending 队列中：原位覆盖为 remainder（第 2 个字符），
        // **不推进游标**——第 1 个 '>' 已由 expect_type_gt 的 return true 隐含
        // 消费，下一次 peek 读到 remainder。
        // 曾误推进 g_pending_idx：`table<table<i64>>` 的 >> 分裂后第 2 个 '>'
        // 被跳过直接读到 RParen（语法错误 @9:34 期望 '>' 实得 RParen）。
        g_pending[g_pending_idx] = remainder
    } else {
        // 当前在真实 token 流：记录 span，push remainder 到队尾，消费原位
        table_push(g_pending, remainder)
        table_push(g_pending_lines, lexer.token_line(g_pos))
        table_push(g_pending_cols, lexer.token_col(g_pos))
        g_pos = g_pos + 1
    }
}

// 类型参数闭括号 '>'（支持 Shr/Ge/ShrEq 复合 token 分裂）
pub func expect_type_gt(what: string) -> bool {
    var tag = peek_tag()
    if tag == lex_gt {
        advance()
        return true
    }
    if tag == lex_shr {
        split_current_gt(lex_gt)
        return true
    }
    if tag == lex_ge {
        split_current_gt(lex_eq)
        return true
    }
    if tag == lex_shreq {
        split_current_gt(lex_ge)
        return true
    }
    set_err(peek_line(), peek_col(), errors.syn_expect(what, describe(tag)))
    return false
}

// ---------- token 位置保存/恢复（泛型调用 try 探测回退，2026-08-14）----------
// save_pos 快照真实游标 g_pos + pending 队列完整内容 + 语法错误槽；
// restore_pos 恢复到保存时刻。泛型调用点 `<` 歧义处理（`a < b` vs `max<i64>(...)`）
// 用「尝试解析 + 失败回退」：探测期间 split_current_gt 可能原位覆盖 pending 元素
// 或往队尾 push 虚拟 token，restore 必须整体还原——故 save 采用完整快照复制
// （表无 pop/截断原语，重建整表是唯一可靠回退方式）。
pub func save_pos() {
    g_save_pos = g_pos
    g_save_idx = g_pending_idx
    g_save_pending = table_new_i64()
    g_save_pending_lines = table_new_i64()
    g_save_pending_cols = table_new_i64()
    g_save_pending_lexemes = table_new_i64()
    var i: i64 = 0
    while i < len(g_pending) {
        table_push(g_save_pending, g_pending[i])
        table_push(g_save_pending_lines, g_pending_lines[i])
        table_push(g_save_pending_cols, g_pending_cols[i])
        table_push(g_save_pending_lexemes, g_pending_lexemes[i])
        i = i + 1
    }
    g_save_err_line = p_err_line
    g_save_err_col = p_err_col
    g_save_err_msg = p_err_msg
}

// 恢复 token 流与错误槽到最近一次 save_pos 时刻（重建 pending 快照）。
pub func restore_pos() {
    g_pos = g_save_pos
    g_pending_idx = g_save_idx
    g_pending = table_new_i64()
    g_pending_lines = table_new_i64()
    g_pending_cols = table_new_i64()
    g_pending_lexemes = table_new_i64()
    var i: i64 = 0
    while i < len(g_save_pending) {
        table_push(g_pending, g_save_pending[i])
        table_push(g_pending_lines, g_save_pending_lines[i])
        table_push(g_pending_cols, g_save_pending_cols[i])
        table_push(g_pending_lexemes, g_save_pending_lexemes[i])
        i = i + 1
    }
    p_err_line = g_save_err_line
    p_err_col = g_save_err_col
    p_err_msg = g_save_err_msg
}

// ---------- 延迟闭包函数体快照（S2.2）----------
// 闭包字面量 `func(x: i64) -> i64 { ... }` 由 pexpr.parse_primary 解析头部，
// 但函数体是语句块，需要 pstmt_flow 的语句解析——pexpr 在 import 树底层
// 无法调用 pstmt_flow（成环：pstmt_flow → pstmt → pexpr）。方案：parse_primary
// 遇 func 时登记「函数体起始处完整 token 流快照」（多槽，闭包可嵌套/多个），
// 配平跳过函数体 token；整份文件解析完后由 pstmt_flow.parse_deferred_closures
// 逐闭包恢复快照、parse_block 解析函数体、回填到 N_FN_LIT 的 children。
// 与 save_pos/restore_pos 不同：那对是单槽、探测用、立即成对；这里是多槽表。

// 登记当前 token 流快照 + 待回填节点（节点一一对应快照）
pub func defer_closure_push(node: i64) {
    table_push(g_defer_nodes, node)
    table_push(g_defer_pos, g_pos)
    table_push(g_defer_idx, g_pending_idx)
    var snap: table<i64> = table_new_i64()
    var snap_lines: table<i64> = table_new_i64()
    var snap_cols: table<i64> = table_new_i64()
    var snap_lexemes: table<i64> = table_new_i64()
    var i: i64 = 0
    while i < len(g_pending) {
        table_push(snap, g_pending[i])
        table_push(snap_lines, g_pending_lines[i])
        table_push(snap_cols, g_pending_cols[i])
        table_push(snap_lexemes, g_pending_lexemes[i])
        i = i + 1
    }
    table_push(g_defer_pending, snap)
    table_push(g_defer_pending_lines, snap_lines)
    table_push(g_defer_pending_cols, snap_cols)
    table_push(g_defer_pending_lexemes, snap_lexemes)
    table_push(g_defer_err_line, p_err_line)
    table_push(g_defer_err_col, p_err_col)
    table_push(g_defer_err_msg, p_err_msg)
}

// 已登记的延迟闭包个数
pub func defer_closure_count() -> i64 {
    return len(g_defer_nodes)
}

// 第 i 个待回填节点 id
pub func defer_closure_node_at(i: i64) -> i64 {
    return g_defer_nodes[i]
}

// 恢复第 i 个闭包登记时的 token 流快照（游标回到函数体起始 '{' 处）
pub func defer_closure_restore(i: i64) {
    g_pos = g_defer_pos[i]
    g_pending_idx = g_defer_idx[i]
    g_pending = table_new_i64()
    g_pending_lines = table_new_i64()
    g_pending_cols = table_new_i64()
    g_pending_lexemes = table_new_i64()
    var k: i64 = 0
    while k < len(g_defer_pending[i]) {
        table_push(g_pending, g_defer_pending[i][k])
        table_push(g_pending_lines, g_defer_pending_lines[i][k])
        table_push(g_pending_cols, g_defer_pending_cols[i][k])
        table_push(g_pending_lexemes, g_defer_pending_lexemes[i][k])
        k = k + 1
    }
    p_err_line = g_defer_err_line[i]
    p_err_col = g_defer_err_col[i]
    p_err_msg = g_defer_err_msg[i]
}

// ---------- S3.3 延迟准引用块快照（`` `{ stmts } `` 的块体）----------
// 与 defer_closure_* 同构：parse_primary 解析准引用块字面量时只登记
// N_CODE_LIT 节点 + 块体起始 token 流快照，配平跳过块体；整份文件解析完后
// 由 pstmt_flow.parse_deferred_code_blocks 恢复快照、parse_block 解析块体、
// 回填到 N_CODE_LIT 的 children[0]（块形式子 AST = StmtList）。

// 登记当前 token 流快照 + 待回填节点（节点一一对应快照）
pub func defer_code_push(node: i64) {
    table_push(g_defer_code_nodes, node)
    table_push(g_defer_code_pos, g_pos)
    table_push(g_defer_code_idx, g_pending_idx)
    var snap: table<i64> = table_new_i64()
    var snap_lines: table<i64> = table_new_i64()
    var snap_cols: table<i64> = table_new_i64()
    var snap_lexemes: table<i64> = table_new_i64()
    var i: i64 = 0
    while i < len(g_pending) {
        table_push(snap, g_pending[i])
        table_push(snap_lines, g_pending_lines[i])
        table_push(snap_cols, g_pending_cols[i])
        table_push(snap_lexemes, g_pending_lexemes[i])
        i = i + 1
    }
    table_push(g_defer_code_pending, snap)
    table_push(g_defer_code_pending_lines, snap_lines)
    table_push(g_defer_code_pending_cols, snap_cols)
    table_push(g_defer_code_pending_lexemes, snap_lexemes)
    table_push(g_defer_code_err_line, p_err_line)
    table_push(g_defer_code_err_col, p_err_col)
    table_push(g_defer_code_err_msg, p_err_msg)
}

// 已登记的延迟准引用块个数
pub func defer_code_count() -> i64 {
    return len(g_defer_code_nodes)
}

// 第 i 个待回填节点 id
pub func defer_code_node_at(i: i64) -> i64 {
    return g_defer_code_nodes[i]
}

// 恢复第 i 个准引用块登记时的 token 流快照（游标回到块体起始 '{' 处）
pub func defer_code_restore(i: i64) {
    g_pos = g_defer_code_pos[i]
    g_pending_idx = g_defer_code_idx[i]
    g_pending = table_new_i64()
    g_pending_lines = table_new_i64()
    g_pending_cols = table_new_i64()
    g_pending_lexemes = table_new_i64()
    var k: i64 = 0
    while k < len(g_defer_code_pending[i]) {
        table_push(g_pending, g_defer_code_pending[i][k])
        table_push(g_pending_lines, g_defer_code_pending_lines[i][k])
        table_push(g_pending_cols, g_defer_code_pending_cols[i][k])
        table_push(g_pending_lexemes, g_defer_code_pending_lexemes[i][k])
        k = k + 1
    }
    p_err_line = g_defer_code_err_line[i]
    p_err_col = g_defer_code_err_col[i]
    p_err_msg = g_defer_code_err_msg[i]
    // S3.3：进入准引用块体解析上下文（块内 `func name()` 按函数定义解析；
    // 块体解析完成后由 parse_deferred_code_blocks 复位）
    g_in_quasi_block = 1
}

// 准引用上下文中的「名字或插值名」：普通标识符 → 池 id；
// `$name`（S3.3 标识符插值）→ 返回 "$name" 文本的池 id（构造 code 值时
// 把 `$` 前缀名替换为变量的字符串值——gensym 结果作函数/变量名）。
// 只在准引用块（`` `{ ... } `` 延迟解析）与宏体内需要；普通代码里出现
// `$name` 也解析为插值名，语义层对非宏上下文报错。
pub func expect_ident_quasi() -> i64 {
    if peek_tag() == lex_ident {
        var id = interner.intern(peek_lexeme())
        advance()
        return id
    }
    if peek_tag() == lex_dollar {
        if peek_n(1) == lex_ident {
            var nm = "$" + peek_lexeme_n(1)
            var id = interner.intern(nm)
            advance()
            advance()
            return id
        }
    }
    set_err(peek_line(), peek_col(), errors.syn_expect_ident(describe(peek_tag())))
    return -1
}

// 第 n 个后续 token 的 lexeme（n=0 当前，1 下一…；expect_ident_quasi 用）
pub func peek_lexeme_n(n: i64) -> string {
    var pn = pending_n()
    if n < pn {
        return interner.lookup(g_pending_lexemes[g_pending_idx + n])
    }
    var k = g_pos + (n - pn)
    var total = lexer.token_count()
    if k >= total {
        k = total - 1
    }
    return lexer.token_lexeme(k)
}

// ---------- 泛型调用点 '<' 歧义探测（token 层，无副作用，2026-08-14）----------
// 调用点 `ident<...>(...)` 与比较 `a < b` / 链式 `f < g > h` 共用 '<' token。
// 判据：'<' 后是「完整类型实参列表 + '>' + 紧接着 '('」才按泛型调用处理，
// 否则回退为比较。本函数只做 token 结构扫描（不建 AST 节点、不消费 token，
// 内部 save/restore 还原），命中后由调用方以 parse_type_args 正式解析。

// 当前是否为「泛型调用前缀」：`< 完整类型实参列表 > (`。
// 返回 true 时当前位置（'<'）未消费，由调用方决定正式解析。
pub func is_generic_call_ahead() -> bool {
    if peek_tag() != lex_lt {
        return false
    }
    save_pos()
    advance()   // 消费 '<'
    var ok = scan_type_arg_list()
    if ok {
        ok = peek_tag() == lex_lparen
    }
    restore_pos()
    return ok
}

// 扫描「类型实参列表」：至少一个类型实参，实参间逗号分隔，以 '>' 闭合。
// 闭合支持 Shr/Ge/ShrEq 复合 token 分裂（与 expect_type_gt 同款映射——
// 分裂副作用由调用方 save/restore 还原）。
func scan_type_arg_list() -> bool {
    if !scan_one_type_arg() {
        return false
    }
    var d = false
    while !d {
        var tag = peek_tag()
        if tag == lex_comma {
            advance()
            if !scan_one_type_arg() {
                return false
            }
        } else if tag == lex_gt {
            advance()
            d = true
        } else if tag == lex_shr {
            // >> 分裂：第 1 个 '>' 为闭合，余下 Gt 顶替当前位置
            split_current_gt(lex_gt)
            d = true
        } else if tag == lex_ge {
            split_current_gt(lex_eq)
            d = true
        } else if tag == lex_shreq {
            split_current_gt(lex_ge)
            d = true
        } else {
            return false
        }
    }
    return true
}

// 扫描单个类型实参（token 形态）：内建类型关键字（含 table/map 嵌套泛型）、
// 标识符（含嵌套泛型类型引用）、元组类型 `(...)`。与 pexpr_type.parse_type
// 接受的形态一致（探测结果与正式解析保证等价）。
func scan_one_type_arg() -> bool {
    var tag = peek_tag()
    if tag == lex_typekw {
        var lex = peek_lexeme()
        advance()
        if lex == "table" || lex == "map" {
            if peek_tag() == lex_lt {
                advance()   // '<'
                if !scan_type_arg_list() {
                    return false
                }
            }
        }
        return true
    }
    if tag == lex_ident {
        advance()
        if peek_tag() == lex_lt {
            advance()   // '<'
            if !scan_type_arg_list() {
                return false
            }
        }
        return true
    }
    if tag == lex_lparen {
        // 元组类型 (T1, T2) / (name: T1, ...)：圆括号配平跳过（内部可含
        // 表/泛型等任意类型 token，遇到 ')' 才结束）
        advance()
        var depth: i64 = 1
        var d = false
        while !d {
            var t2 = peek_tag()
            if t2 == lex_eof {
                return false
            }
            if t2 == lex_lparen {
                depth = depth + 1
            } else if t2 == lex_rparen {
                depth = depth - 1
                if depth == 0 {
                    advance()
                    d = true
                }
            }
            if !d {
                advance()
            }
        }
        return true
    }
    return false
}

// ---------- 类型关键字与整数字面量 ----------

// 类型关键字文本 → TyKw 索引（对齐 Rust TyKw 枚举顺序）
pub func typekw_index(s: string) -> i64 {
    switch s {
        case "i8": return 0
        case "i16": return 1
        case "i32": return 2
        case "i64": return 3
        case "u8": return 4
        case "u16": return 5
        case "u32": return 6
        case "u64": return 7
        case "f32": return 8
        case "f64": return 9
        case "bool": return 10
        case "trit": return 11
        case "char": return 12
        case "string": return 13
        case "void": return 14
        case "code": return 15
        case "num": return 16
        case "text": return 17
        case "misc": return 18
        case "table": return 19
        case "map": return 20
        default: return -1
    }
}

// 单个字符的数值（0-9 a-f A-F → 0-15；其余 -1）
func digit_val(c: string) -> i64 {
    var cc = char_code(c)
    if cc >= 48 {
        if cc <= 57 {
            return cc - 48
        }
    }
    if cc >= 97 {
        if cc <= 102 {
            return cc - 87
        }
    }
    if cc >= 65 {
        if cc <= 70 {
            return cc - 55
        }
    }
    return -1
}
// 整数字面量 lexeme → i64 值（支持十进制/0x/0b/0o/0t 前缀）
pub func parse_int_lit(lex: string) -> i64 {
    var n = str_len(lex)
    var base: i64 = 10
    var start: i64 = 0
    if n >= 2 {
        var c0 = str_char(lex, 0)
        var c1 = str_char(lex, 1)
        if c0 == "0" {
            if c1 == "x" || c1 == "X" {
                base = 16
                start = 2
            } else if c1 == "b" || c1 == "B" {
                base = 2
                start = 2
            } else if c1 == "o" || c1 == "O" {
                base = 8
                start = 2
            } else if c1 == "t" || c1 == "T" {
                base = 3
                start = 2
            }
        }
    }
    var val: i64 = 0
    var i = start
    while i < n {
        var c = str_char(lex, i)
        var d = digit_val(c)
        if d < 0 {
            break
        }
        if d >= base {
            break
        }
        val = val * base + d
        i = i + 1
    }
    return val
}

// ---------- S1.3 L3 字面量后缀 ----------
// 字面量尾部类型后缀 → TyKw 索引（i8/i16/i32/i64/u8/u16/u32/u64/f32/f64；
// 无后缀返回 -1）。仅匹配精确后缀串（数字后的字母序列）。
pub func parse_lit_suffix(lex: string) -> i64 {
    var n = str_len(lex)
    if n < 2 {
        return -1
    }
    var last2 = slice_str(lex, n - 2, n)
    if last2 == "i8" {
        return 0
    }
    if last2 == "u8" {
        return 4
    }
    if n < 3 {
        return -1
    }
    var last3 = slice_str(lex, n - 3, n)
    if last3 == "i16" {
        return 1
    }
    if last3 == "i32" {
        return 2
    }
    if last3 == "i64" {
        return 3
    }
    if last3 == "u16" {
        return 5
    }
    if last3 == "u32" {
        return 6
    }
    if last3 == "u64" {
        return 7
    }
    if last3 == "f32" {
        return 8
    }
    if last3 == "f64" {
        return 9
    }
    return -1
}

// 剥离字面量尾部类型后缀，返回纯数字文本（无后缀原样返回）。
// 浮点字面量 lexeme 带 f32/f64 后缀时 llvmgen 无法直接输出，须剥离。
pub func strip_lit_suffix(lex: string) -> string {
    var n = str_len(lex)
    if parse_lit_suffix(lex) >= 0 {
        if parse_lit_suffix(lex) == 0 || parse_lit_suffix(lex) == 4 {
            return slice_str(lex, 0, n - 2)
        }
        return slice_str(lex, 0, n - 3)
    }
    return lex
}

// 子串辅助（码点级，越界裁剪）
func slice_str(s: string, start: i64, end: i64) -> string {
    var n = str_len(s)
    var lo = start
    if lo < 0 {
        lo = 0
    }
    if lo > n {
        lo = n
    }
    var hi = end
    if hi < 0 {
        hi = 0
    }
    if hi > n {
        hi = n
    }
    if lo >= hi {
        return ""
    }
    var out: string = ""
    var i: i64 = lo
    while i < hi {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

// 类型节点是否为表类型（table<T> 或裸 table；VarDecl 省略初始化器判定用）
pub func is_table_type(ty: i64) -> bool {
    if ty < 0 {
        return false
    }
    var tag = ast.tag(ty)
    if tag == N_TABLE_TYPE {
        return true
    }
    if tag == N_NAMED_TYPE {
        if ast.val(ty) == 19 {
            return true
        }
    }
    return false
}

// 是否赋值运算符 token（快速路径预探测，不消费）
pub func is_assign_op_tag(tag: i64) -> bool {
    if tag == lex_eq {
        return true
    }
    if tag >= lex_pluseq {
        if tag <= lex_shreq {
            return true
        }
    }
    return false
}

// 消费赋值运算符；普通 = 返回 -1，复合返回对应二元 op 码，未匹配返回 -2
pub func eat_assign_op() -> i64 {
    var tag = peek_tag()
    var op = -2
    if tag == lex_eq {
        op = -1
    } else if tag == lex_pluseq {
        op = B_ADD
    } else if tag == lex_minuseq {
        op = B_SUB
    } else if tag == lex_stareq {
        op = B_MUL
    } else if tag == lex_slasheq {
        op = B_DIV
    } else if tag == lex_percenteq {
        op = B_MOD
    } else if tag == lex_ampeq {
        op = B_BITAND
    } else if tag == lex_pipeeq {
        op = B_BITOR
    } else if tag == lex_careteq {
        op = B_BITXOR
    } else if tag == lex_shleq {
        op = B_SHL
    } else if tag == lex_shreq {
        op = B_SHR
    }
    if op != -2 {
        advance()
    }
    return op
}

// 表达式是否可寻址（字段赋值 base 校验）：Var 或 FieldAccess 链
pub func is_addressable_base(id: i64) -> bool {
    if id < 0 {
        return false
    }
    var tag = ast.tag(id)
    if tag == N_VAR {
        return true
    }
    if tag == N_FIELD_ACCESS {
        return is_addressable_base(ast.child_at(id, 0))
    }
    return false
}

// 字符串前缀判断（strcmp 逐字符）
pub func has_prefix(s: string, pre: string) -> bool {
    var n = str_len(pre)
    if str_len(s) < n {
        return false
    }
    var i: i64 = 0
    while i < n {
        if str_char(s, i) != str_char(pre, i) {
            return false
        }
        i = i + 1
    }
    return true
}

}
