type tie<class>
// compiler/frontend/smove.tie —— S1.5 移动语义独立检查 pass
// ============================================================
// 里程碑：S1.5 移动语义（docs/plans/ui-framework.md §4.2 + roadmap §S1.5）
//
// # 职责
//   移动语义检查 = 变量 live/moved 状态跟踪（编译期）：
//   - 堆类型（string/table/含堆字段聚合）赋值/按值传参/返回即转移所有权，
//     源变量标记 moved；此后读取 = 编译错误 "use of moved value"
//   - 栈类型（i64/f64/bool）拷贝语义，不跟踪
//   - 显式复制用 clone/copy（sbuiltin/irgen 支持，见规划 §3.3）
//
// # 设计：独立 pass（与 sinfer/scheck 解耦）
//   本模块不修改 sinfer/scheck（S1.2-1.4 并行会话在编辑），而是作为
//   semantic 逐函数检查**之后**的独立遍历：读 sstate 全局表（AST 列式表 +
//   lv_* 变量表 + sg_*/sp_* 签名表 + node_types 类型表），自行递归遍历
//   函数体，维护 lv_moved 状态并报错。语义正确性依赖前置阶段已完成的
//   类型推断（node_types）与变量登记（lv_*）。
//
// # 移动触发点（递归遍历识别）
//   | 语句/表达式形态 | 动作 |
//   | --- | --- |
//   | `var b = a`（init 是直接变量，堆类型，非 const） | a → moved |
//   | `b = a`（右侧直接变量，堆类型，非 const，a≠b） | a → moved；b 重新 live |
//   | `f(a)`（实参直接变量，堆类型，形参非 ref，用户函数） | a → moved |
//   | `return a`（返回直接变量，堆类型） | a → moved |
//   | 复杂表达式内的变量读取（非直接移动位置） | 若 moved → 报错 |
//   | 内置/原语调用实参（str_len/table_push 等语言底座） | 借用，不移动 |
//
// # 依赖
//   sstate（AST 表 + lv_moved 工具 + 签名表）+ types（类型判定）。
//   import 树位置：semantic import 本文件（import 去重保证 sstate/types
//   不重复展开）。
//
// 调用：semantic.check_impl/check_ast 逐函数检查循环内
// `scheck.check_fn_walk(fname)` 之后调用 `smove.check_fn_walk(fname)`。

import "./sstate.tie"
import "../middle/types.tie"

// 当前函数名（semantic 逐函数检查循环调用前由 check_fn_walk 设置；
// 命名空间体内不允许 var，置于顶层——与 sstate 的 sm_* 状态同层）
var smv_cur_fn_name: string = "";

namespace smove {

// ==================== 堆类型判定 ====================
// 类型 id 是否为"所有权类型"（移动语义作用域）：
// string/table/map 直判；聚合（struct/tuple/enum）递归查字段——含一个
// 堆字段即 owned。i64/f64/bool/trit/char 等标量 = 栈类型（copy）。
func is_owned(t: i64) -> bool {
    if t < 0 {
        return false
    }
    if t == types.named(TK_STR) {
        return true
    }
    var k = types.kind(t)
    if k == K_TABLE || k == K_MAP {
        return true
    }
    if k == K_STRUCT {
        // struct：递归字段——含任一堆字段即 owned
        var si = types.low(t)
        if si >= 0 && si < len(cls_fldoff) {
            var off = cls_fldoff[si]
            var cnt = cls_nfld[si]
            var i: i64 = 0
            while i < cnt {
                if is_owned(fld_tys[off + i]) {
                    return true
                }
                i = i + 1
            }
        }
        return false
    }
    if k == K_TUPLE {
        // tuple：递归字段
        var ti = types.low(t)
        if ti >= 0 && ti < len(tup_offs) {
            var off = tup_offs[ti]
            var cnt = tup_n[ti]
            var i: i64 = 0
            while i < cnt {
                if is_owned(tup_tys[off + i]) {
                    return true
                }
                i = i + 1
            }
        }
        return false
    }
    if k == K_ENUM {
        // enum：递归 payload 字段（含任一堆 payload 即 owned）
        var ei = types.low(t)
        if ei >= 0 && ei < len(en_varoff) {
            var nvar = en_nvar[ei]
            var v: i64 = 0
            while v < nvar {
                var voff = en_vfldoff[en_varoff[ei] + v]
                var vnf = en_vnfld[en_varoff[ei] + v]
                var f: i64 = 0
                while f < vnf {
                    if is_owned(en_ftys[voff + f]) {
                        return true
                    }
                    f = f + 1
                }
                v = v + 1
            }
        }
        return false
    }
    return false
}

// ==================== 调用名解析（smove 内建简版） ====================
// 裸调用名 → 全名（对齐 sinfer.resolve_call_name 候选 1/2）：
// 候选 1：裸名已有签名；候选 2：当前函数命名空间逐级外层补全。
// 返回全名（找不到原样返回——上层按 fn_sig < 0 判内置借用）。
func resolve_call(fnm: string) -> string {
    if sstate.fn_sig(fnm) >= 0 {
        return fnm
    }
    var full = smv_cur_fn_name
    while str_len(full) > 0 {
        var last = sstate.rfind_ns(full)
        if last < 0 {
            break
        }
        // 前缀 = full[0, last)（last 是 '::' 中第一个 ':' 的下标）
        var prefix = str.slice(full, 0, last)
        var cand = prefix + "::" + fnm
        if sstate.fn_sig(cand) >= 0 {
            return cand
        }
        full = prefix
    }
    return fnm
}

// ==================== 变量状态辅助 ====================
// 表达式节点是否为"直接变量"且堆类型（可移动源）：
// node_types[节点] 已由前置推断填充；再查 lv_vals 确认变量类型。
func is_move_src(e: i64) -> bool {
    if e < 0 {
        return false
    }
    if s_tags[e] != S_N_VAR {
        return false
    }
    var nid = interner.intern(sstate.name_str(e))
    var ty: i64 = -1
    var lt = lv_find(nid)
    if lt >= 0 {
        ty = lt
    }
    if ty < 0 {
        ty = node_types[e]
    }
    return is_owned(ty)
}

// 取变量名 id（-1 = 非变量）
func var_nid(e: i64) -> i64 {
    if e < 0 {
        return -1
    }
    if s_tags[e] != S_N_VAR {
        return -1
    }
    return interner.intern(sstate.name_str(e))
}

// 变量是否 const（不可移动——移动 = 修改 const，改深拷贝语义）
func var_is_const(nid: i64) -> i64 {
    var idx = sstate.bs_find(lv_keys, nid)
    if idx < 0 {
        return 0
    }
    return lv_const[idx]
}

// 局部变量类型查找（对齐 sinfer.lv_find——sstate 全局表直查，不依赖 sinfer）
func lv_find(nid: i64) -> i64 {
    var idx = sstate.bs_find(lv_keys, nid)
    if idx < 0 {
        return -1
    }
    return lv_vals[idx]
}

// 递归遍历表达式：变量出现在"读取位置"（非直接移动位置）→ 若 moved 报错。
// 移动位置（赋值/声明/返回/实参的直接变量）由上层先行处理（mark），
// 此处只检查**复杂表达式内部**的变量读取（如 `b = a + 1` 中 a 是读取）。
// 返回 0 成功 / -1 错误（sm_err_* 已置）。
func check_expr_read(e: i64) -> i64 {
    if e < 0 {
        return 0
    }
    var tag = s_tags[e]
    // 变量读取：查 moved
    if tag == S_N_VAR {
        var nid = interner.intern(sstate.name_str(e))
        if sstate.lv_moved_is(nid) == 1 {
            sm_err_line = s_lines[e]
            sm_err_col = s_cols[e]
            sm_err_msg = "变量 '" + sstate.name_str(e) + "' 已移动（所有权已转移），不可再次使用（需要复制请用 clone）"
            return -1
        }
        return 0
    }
    // 字面量：无变量
    if tag == 0 || tag == 1 || tag == 2 || tag == 3 || tag == 4 || tag == 5 {
        return 0
    }
    // Unary：操作数
    if tag == S_N_UNARY {
        return check_expr_read(sstate.child(e, 0))
    }
    // Binary：左右
    if tag == S_N_BINARY {
        var r1 = check_expr_read(sstate.child(e, 0))
        if r1 < 0 {
            return -1
        }
        return check_expr_read(sstate.child(e, 1))
    }
    // Ternary：条件/真/假
    if tag == S_N_TERNARY {
        var r2 = check_expr_read(sstate.child(e, 0))
        if r2 < 0 {
            return -1
        }
        var r3 = check_expr_read(sstate.child(e, 1))
        if r3 < 0 {
            return -1
        }
        return check_expr_read(sstate.child(e, 2))
    }
    // Range：两端（for 迭代范围）
    if tag == S_N_RANGE {
        var r4 = check_expr_read(sstate.child(e, 0))
        if r4 < 0 {
            return -1
        }
        return check_expr_read(sstate.child(e, 1))
    }
    // Index：基址 + 下标
    if tag == S_N_INDEX {
        var r5 = check_expr_read(sstate.child(e, 0))
        if r5 < 0 {
            return -1
        }
        return check_expr_read(sstate.child(e, 1))
    }
    // FieldAccess：基址
    if tag == S_N_FIELD_ACCESS {
        return check_expr_read(sstate.child(e, 0))
    }
    // TableLit：单元格值（cell = [TableId 或 -1, 值]）
    if tag == S_N_TABLE_LIT {
        var nc = sstate.nchild(e)
        var i: i64 = 0
        while i < nc {
            var cell = sstate.child(e, i)
            var v = sstate.child(cell, 1)
            var r6 = check_expr_read(v)
            if r6 < 0 {
                return -1
            }
            i = i + 1
        }
        return 0
    }
    // TupleLit：字段值（field = [name 或 -1, 值]）
    if tag == S_N_TUPLE_LIT {
        var nc2 = sstate.nchild(e)
        var i2: i64 = 0
        while i2 < nc2 {
            var f = sstate.child(e, i2)
            var v2 = sstate.child(f, 1)
            var r7 = check_expr_read(v2)
            if r7 < 0 {
                return -1
            }
            i2 = i2 + 1
        }
        return 0
    }
    // Call：实参检查（直接变量 = 移动位置，由 check_call_args 处理；
    // 这里递归复杂实参内部）
    if tag == S_N_CALL {
        return check_call(e)
    }
    // MethodCall：接收者按引用（不移动）；实参同 Call
    if tag == S_N_METHOD_CALL {
        return check_method_call(e)
    }
    // Path/其他：无变量读取
    return 0
}

// 调用实参移动处理：用户函数按值传堆参数 → 直接变量实参 mark moved；
// 复杂实参递归读取检查。内置函数（fn_sig < 0）借用。
// 借用语义（实参递归读取检查，不 mark moved）：
//   1) clone/copy（S1.5 显式复制内置）——复制不消耗源；
//   2) 跨命名空间调用（full 含 ::，库/模块函数，如 str::find）——
//      库函数约定只读参数，实参不被移动。这是 std/compiler 迁移的关键：
//      库内部 `find(lower, c)` 按值传参**不**消耗调用方的 c，
//      之后 `out = out + c` 才合法。
// 裸名顶层函数（如用户代码 take_owned(s)）保持移动语义（full 不含 ::）。
func check_call(e: i64) -> i64 {
    var fnm = sstate.name_str(e)
    var full = resolve_call(fnm)
    // clone/copy + 跨命名空间（库函数）借用特判：实参递归读取检查（不 mark moved）
    if fnm == "clone" || fnm == "copy" || full == "clone" || full == "copy" || sstate.rfind_ns(full) >= 0 {
        var base_c = sstate.slot_off(e)
        var nc_c = sstate.nchild(e)
        var i_c: i64 = 0
        while i_c < nc_c - base_c {
            var arg_c = sstate.child(e, base_c + i_c)
            var r_c = check_expr_read(arg_c)
            if r_c < 0 {
                return -1
            }
            i_c = i_c + 1
        }
        return 0
    }
    var sig = sstate.fn_sig(full)
    // 泛型槽偏移：Call children[0] = 类型实参槽（-1 或 N_TYPE_ARGS）
    var base = sstate.slot_off(e)
    var nc = sstate.nchild(e)
    var i: i64 = 0
    while i < nc - base {
        var arg = sstate.child(e, base + i)
        // 复杂实参：递归读取检查
        var r = check_expr_read(arg)
        if r < 0 {
            return -1
        }
        // 用户函数 + 直接变量实参 + 堆类型 + 形参非 ref → 移动
        if sig >= 0 {
            var nid = var_nid(arg)
            if nid >= 0 {
                var off = sg_off[sig]
                if off + i < len(sp_refs) && sp_refs[off + i] == 0 {
                    if var_is_const(nid) == 0 && is_move_src(arg) {
                        sstate.lv_moved_mark(nid)
                    }
                }
            }
        }
        i = i + 1
    }
    return 0
}

// 接收者路径拼接（smove 自写，参考 sinfer.recv_path_name；smove 只
// import sstate+types，不能调 sinfer）——Var / FieldAccess / Path 统一
// 递归拼接为 "a::b::c" 形式，用于命名空间方法调用的完整签名。
func recv_path_name(recv: i64) -> string {
    var tag = s_tags[recv]
    if tag == S_N_VAR {
        return sstate.name_str(recv)
    }
    if tag == S_N_FIELD_ACCESS {
        // FieldAccess[name=字段名, children=[基址]]：基址路径 + :: + 字段名
        var base = sstate.child(recv, 0)
        var bp = recv_path_name(base)
        var fnm = sstate.name_str(recv)
        if bp == "" {
            return fnm
        }
        return bp + "::" + fnm
    }
    if tag == S_N_PATH {
        // Path(children=[Segment...])：顺序拼接
        var out: string = ""
        var nc = sstate.nchild(recv)
        var i: i64 = 0
        while i < nc {
            if i > 0 {
                out = out + "::"
            }
            out = out + sstate.name_str(sstate.child(recv, i))
            i = i + 1
        }
        return out
    }
    // 兜底：children 顺序拼接
    var out2: string = ""
    var nc2 = sstate.nchild(recv)
    var j: i64 = 0
    while j < nc2 {
        if j > 0 {
            out2 = out2 + "::"
        }
        out2 = out2 + sstate.name_str(sstate.child(recv, j))
        j = j + 1
    }
    return out2
}

// 方法调用实参处理：接收者（children[slot_off]）按引用不移动；
// 实参从 slot_off+1 起（同 Call 规则）。
// S1.5 接收者解析：命名空间点号调用（str.slice / str.trim）必须拼出
// 完整签名（str::slice），否则 resolve_call 用裸名解析，命中同文件裸
// 顶层函数（driver.tie 有裸 slice/trim）后 full 无 "::"，借用特判不生效
// → 实参被误标 moved。与 sinfer.infer_method_call 对齐：
//   接收者 S_N_VAR 且未绑定（无本地/全局变量）→ 命名空间前缀 rname::fnm
//   接收者 S_N_PATH / S_N_FIELD_ACCESS          → 路径拼接 path::fnm
//   接收者绑定（struct 实例方法）               → 维持原 resolve_call(fnm)
func check_method_call(e: i64) -> i64 {
    var fnm = sstate.name_str(e)
    var recv = sstate.child(e, sstate.slot_off(e))
    var full = resolve_call(fnm)
    // 接收者命名空间解析（只影响 full，不改变绑定变量的 struct 方法行为）
    if recv >= 0 {
        var rtag = s_tags[recv]
        if rtag == S_N_VAR {
            var rname = sstate.name_str(recv)
            var rnid = interner.intern(rname)
            var rt = lv_find(rnid)
            if rt < 0 {
                var gidx = sstate.bs_find(gb_keys, rnid)
                if gidx >= 0 {
                    rt = gb_vals[gidx]
                }
            }
            if rt < 0 {
                // 未绑定变量 → 命名空间前缀（str.slice → str::slice）
                full = rname + "::" + fnm
            }
        } else if rtag == S_N_PATH || rtag == S_N_FIELD_ACCESS {
            // Path / 字段访问接收者 → 路径拼接（参考 sinfer.recv_path_name）
            var rp = recv_path_name(recv)
            if str_len(rp) > 0 {
                full = rp + "::" + fnm
            }
        }
    }
    // clone/copy + 跨命名空间（库函数）借用特判：与 check_call 一致——
    // 库内部 `set.find(s, x)` 点号调用实参不被移动（full 解析为 set::find 含 ::）。
    // 接收者 + 全部实参递归读取检查（不 mark moved）。
    if fnm == "clone" || fnm == "copy" || full == "clone" || full == "copy" || sstate.rfind_ns(full) >= 0 {
        var recv_c = sstate.child(e, sstate.slot_off(e))
        var r_c = check_expr_read(recv_c)
        if r_c < 0 {
            return -1
        }
        var base_c = sstate.slot_off(e) + 1
        var nc_c = sstate.nchild(e)
        var i_c: i64 = 0
        while i_c < nc_c - base_c {
            var arg_c = sstate.child(e, base_c + i_c)
            var r2_c = check_expr_read(arg_c)
            if r2_c < 0 {
                return -1
            }
            i_c = i_c + 1
        }
        return 0
    }
    var sig = sstate.fn_sig(full)
    // 接收者：按引用（不移动）——只做读取检查（方法内改动不属移动）
    // （recv 已在函数开头解析，供命名空间判断与借用特判共用）
    var r = check_expr_read(recv)
    if r < 0 {
        return -1
    }
    var base = sstate.slot_off(e) + 1
    var nc = sstate.nchild(e)
    var i: i64 = 0
    while i < nc - base {
        var arg = sstate.child(e, base + i)
        var r2 = check_expr_read(arg)
        if r2 < 0 {
            return -1
        }
        if sig >= 0 {
            var nid = var_nid(arg)
            if nid >= 0 {
                var off = sg_off[sig]
                if off + i < len(sp_refs) && sp_refs[off + i] == 0 {
                    if var_is_const(nid) == 0 && is_move_src(arg) {
                        sstate.lv_moved_mark(nid)
                    }
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ==================== 语句检查 ====================
func check_stmt(s: i64) -> i64 {
    var tag = s_tags[s]
    // VarDecl：children=[类型或 -1, 初值]
    if tag == S_N_VAR_DECL {
        var init = sstate.child(s, 1)
        if init >= 0 {
            // 直接变量初值 + 堆类型 + 非 const → 源移动
            var nid = var_nid(init)
            if nid >= 0 {
                if var_is_const(nid) == 0 && is_move_src(init) {
                    sstate.lv_moved_mark(nid)
                }
            } else {
                // 复杂初值：递归读取检查
                var r = check_expr_read(init)
                if r < 0 {
                    return -1
                }
            }
        }
        return 0
    }
    // Assign：name=目标名, children=[值]
    if tag == S_N_ASSIGN {
        var nm = sstate.name_str(s)
        var tgt = interner.intern(nm)
        var val = sstate.child(s, 0)
        var op = s_vals[s]
        if op < 0 {
            // 普通赋值：右侧直接变量（非自身）→ 源移动；自身赋值 a=a 是读取
            var nid = var_nid(val)
            if nid >= 0 && nid != tgt {
                if var_is_const(nid) == 0 && is_move_src(val) {
                    sstate.lv_moved_mark(nid)
                }
            } else {
                // 复杂表达式或 a = a：读取检查（moved 则报错）
                var r = check_expr_read(val)
                if r < 0 {
                    return -1
                }
            }
            // 目标恢复 live（重新赋值 = 重新初始化）
            sstate.lv_moved_unmark(tgt)
        } else {
            // 复合赋值（+= 等）：右侧是读取（先读旧值再写）
            var r2 = check_expr_read(val)
            if r2 < 0 {
                return -1
            }
        }
        return 0
    }
    // Return：children=[表达式或 -1]
    if tag == S_N_RETURN {
        var v = sstate.child(s, 0)
        if v >= 0 {
            var nid = var_nid(v)
            if nid >= 0 {
                if var_is_const(nid) == 0 && is_move_src(v) {
                    sstate.lv_moved_mark(nid)
                }
            } else {
                var r = check_expr_read(v)
                if r < 0 {
                    return -1
                }
            }
        }
        return 0
    }
    // ExprStmt：children=[表达式]
    if tag == S_N_EXPR_STMT {
        return check_expr_read(sstate.child(s, 0))
    }
    // If：children=[条件, then, else]
    // 分支状态隔离：检查条件 → 快照 → 检查 then → 恢复快照 → 检查 else → 恢复快照。
    // 分支内 return/赋值触发的移动标记不泄漏到分支外（分支互斥路径，
    // 如 `if m == 0 { return s }` 后继续用 s 是合法模式）。
    if tag == S_N_IF {
        var r1 = check_expr_read(sstate.child(s, 0))
        if r1 < 0 {
            return -1
        }
        var snap1 = sstate.lv_moved_snap()
        var r2 = check_block(sstate.child(s, 1))
        if r2 < 0 {
            return -1
        }
        sstate.lv_moved_restore(snap1)
        var els = sstate.child(s, 2)
        if els >= 0 {
            var snap2 = sstate.lv_moved_snap()
            var r3 = check_block(els)
            if r3 < 0 {
                return -1
            }
            sstate.lv_moved_restore(snap2)
        }
        return 0
    }
    // While：children=[条件, 体]
    // 循环体状态隔离：条件读取 → 快照 → 检查体 → 恢复（循环每次迭代独立）。
    if tag == S_N_WHILE {
        var r4 = check_expr_read(sstate.child(s, 0))
        if r4 < 0 {
            return -1
        }
        var snap3 = sstate.lv_moved_snap()
        var r4b = check_block(sstate.child(s, 1))
        if r4b < 0 {
            return -1
        }
        sstate.lv_moved_restore(snap3)
        return 0
    }
    // For：name=迭代变量, children=[迭代对象, 体]
    // 迭代对象 = 读取（表遍历借用，不移动）；范围两端 = 读取。
    // 迭代变量每次迭代重新赋值（恢复 live）——循环体内移动它后，
    // 下次迭代重新绑定；循环结束变量保留最后值（重新赋值语义）。
    // 循环体状态隔离（每次迭代独立，移动标记不泄漏到循环外）。
    if tag == S_N_FOR {
        var iter = sstate.child(s, 0)
        var r5 = check_expr_read(iter)
        if r5 < 0 {
            return -1
        }
        // 迭代变量重新赋值（恢复 live）——循环体检查前 unmark
        var iter_nm = sstate.name_str(s)
        if str_len(iter_nm) > 0 {
            var iter_nid = interner.intern(iter_nm)
            sstate.lv_moved_unmark(iter_nid)
        }
        var snap6 = sstate.lv_moved_snap()
        var r5b = check_block(sstate.child(s, 1))
        if r5b < 0 {
            return -1
        }
        sstate.lv_moved_restore(snap6)
        return 0
    }
    // Switch：children=[主体, case..., default]；主体读取 + 各 case 体
    // 各 case 分支状态隔离（互斥路径，移动标记不跨 case 泄漏）。
    if tag == S_N_SWITCH {
        var r6 = check_expr_read(sstate.child(s, 0))
        if r6 < 0 {
            return -1
        }
        var ncases = s_aux[s]
        var i: i64 = 0
        while i < ncases {
            var snap4 = sstate.lv_moved_snap()
            var c = sstate.child(s, 1 + i)
            var r7 = check_switch_case(c)
            if r7 < 0 {
                return -1
            }
            sstate.lv_moved_restore(snap4)
            i = i + 1
        }
        var dflt = sstate.child(s, 1 + ncases)
        if dflt >= 0 {
            var snap5 = sstate.lv_moved_snap()
            var r8 = check_block(dflt)
            if r8 < 0 {
                return -1
            }
            sstate.lv_moved_restore(snap5)
        }
        return 0
    }
    // Break/Continue：无变量
    if tag == S_N_BREAK || tag == S_N_CONTINUE {
        return 0
    }
    // FieldAssign：children=[基址, 值]（基址按引用；值 = 读取/移动）
    if tag == S_N_FIELD_ASSIGN {
        var base = sstate.child(s, 0)
        var r9 = check_expr_read(base)
        if r9 < 0 {
            return -1
        }
        var val2 = sstate.child(s, 1)
        var nid2 = var_nid(val2)
        if nid2 >= 0 {
            if var_is_const(nid2) == 0 && is_move_src(val2) {
                sstate.lv_moved_mark(nid2)
            }
        } else {
            var r10 = check_expr_read(val2)
            if r10 < 0 {
                return -1
            }
        }
        return 0
    }
    // IndexAssign：children=[目标, 值]（目标按引用；值 = 读取/移动）
    if tag == S_N_INDEX_ASSIGN {
        var tgt2 = sstate.child(s, 0)
        var r11 = check_expr_read(tgt2)
        if r11 < 0 {
            return -1
        }
        var val3 = sstate.child(s, 1)
        var nid3 = var_nid(val3)
        if nid3 >= 0 {
            if var_is_const(nid3) == 0 && is_move_src(val3) {
                sstate.lv_moved_mark(nid3)
            }
        } else {
            var r12 = check_expr_read(val3)
            if r12 < 0 {
                return -1
            }
        }
        return 0
    }
    return 0
}

// switch case：children=[PatternList, when 或 -1, 体]
func check_switch_case(c: i64) -> i64 {
    var nc = sstate.nchild(c)
    if nc >= 3 {
        var when_node = sstate.child(c, 1)
        if when_node >= 0 {
            var r = check_expr_read(when_node)
            if r < 0 {
                return -1
            }
        }
        return check_block(sstate.child(c, 2))
    }
    return 0
}

// 语句块检查（StmtList）
func check_block(blk: i64) -> i64 {
    if blk < 0 {
        return 0
    }
    var n = sstate.nchild(blk)
    var i: i64 = 0
    while i < n {
        var s = sstate.child(blk, i)
        var r = check_stmt(s)
        if r < 0 {
            return -1
        }
        i = i + 1
    }
    return 0
}

// ==================== 入口 ====================
// 定位函数节点并检查（对齐 scheck.check_fn_walk：遍历 g_extra_tops 顶层
// FnDef / 命名空间递归）。返回 0 已检查 / -1 错误（sm_err_* 已置）。
pub func check_fn_walk(full: string) -> i64 {
    smv_cur_fn_name = str.clone(full)
    var n = len(g_extra_tops)
    var i: i64 = 0
    while i < n {
        var s = g_extra_tops[i]
        var tag = s_tags[s]
        if tag == S_N_FN_DEF {
            if sstate.ns_full_name(sstate.name_str(s)) == full {
                return check_fn(s)
            }
        } else if tag == S_N_NAMESPACE {
            var nsegs = s_aux[s]
            var j: i64 = 0
            while j < nsegs {
                var seg = sstate.child(s, j)
                sstate.ns_push(s_names[seg])
                j = j + 1
            }
            var body = sstate.child(s, nsegs)
            var r = check_fn_walk_in_ns(body, full)
            j = 0
            while j < nsegs {
                ns_top = ns_top - 1
                j = j + 1
            }
            if r == 0 {
                return 0
            }
            if r < 0 {
                return r
            }
        }
        i = i + 1
    }
    return 0
}

// 命名空间体内递归（含嵌套 namespace）。返回 0 找到 / -1 错误 / 1 未找到。
func check_fn_walk_in_ns(blk: i64, full: string) -> i64 {
    var n = sstate.nchild(blk)
    var i: i64 = 0
    while i < n {
        var s = sstate.child(blk, i)
        var tag = s_tags[s]
        if tag == S_N_FN_DEF {
            if sstate.ns_full_name(sstate.name_str(s)) == full {
                return check_fn(s)
            }
        } else if tag == S_N_NAMESPACE {
            var nsegs = s_aux[s]
            var j: i64 = 0
            while j < nsegs {
                var seg = sstate.child(s, j)
                sstate.ns_push(s_names[seg])
                j = j + 1
            }
            var body = sstate.child(s, nsegs)
            var r = check_fn_walk_in_ns(body, full)
            j = 0
            while j < nsegs {
                ns_top = ns_top - 1
                j = j + 1
            }
            if r == 0 {
                return 0
            }
            if r < 0 {
                return r
            }
        }
        i = i + 1
    }
    return 1
}

// 单函数移动检查：重置 moved 状态，遍历函数体。
// 返回 0 成功 / -1 错误（sm_err_* 已置）。
func check_fn(fn_node: i64) -> i64 {
    sstate.lv_moved_reset()
    var nparams = s_aux[fn_node]
    // 函数体：children[slot_off + 1 + nparams]
    var body = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + nparams)
    return check_block(body)
}

}   // namespace smove
