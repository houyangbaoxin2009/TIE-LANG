const S_N_TABLE_TYPE: i64 = 203;
const S_N_MAP_TYPE: i64 = 204;
// 泛型语法节点（2026-08-14，与 ast.tie 同号权威）：N_TYPE_PARAMS（声明点
// 类型参数列表）/ N_TYPE_PARAM（单个类型参数）/ N_TYPE_ARGS（使用点类型
// 实参列表）。语义层在 FnDef/Struct/Call/MethodCall/StructType 的 children
// 头部读取「泛型槽」时用这三个常量判定（配合 sstate.slot_off 统一偏移）。
const S_N_TYPE_PARAMS: i64 = 125;
const S_N_TYPE_PARAM: i64 = 126;
const S_N_TYPE_ARGS: i64 = 127;
namespace sstate {

// ==================== 工具：协议解析 ====================
// 读取协议行字段（空格分隔，返回第 k 个字段字符串；k 从 0）
pub func pf(line: string, k: i64) -> string {
    var start: i64 = 0
    var cur: i64 = 0
    var n = str_len(line)
    var i: i64 = 0
    var seg: i64 = 0
    while i <= n {
        var at_end: bool = false
        if i == n {
            at_end = true
        } else {
            if str_char(line, i) == " " {
                at_end = true
            }
        }
        if at_end {
            if seg == k {
                return str.slice(line, start, i)
            }
            seg = seg + 1
            start = i + 1
        }
        i = i + 1
    }
    return ""
}

// 十进制字符串 → i64（协议字段解析用；支持负号）
pub func parse_dec(s: string) -> i64 {
    var n = str_len(s)
    var v: i64 = 0
    var neg: bool = false
    var i: i64 = 0
    if n > 0 {
        if str_char(s, 0) == "-" {
            neg = true
            i = 1
        }
    }
    while i < n {
        var cc = char_code(str_char(s, i))
        if cc >= 48 {
            if cc <= 57 {
                v = v * 10 + (cc - 48)
            }
        }
        i = i + 1
    }
    if neg {
        v = 0 - v
    }
    return v
}

// ==================== 工具：协议行单次扫描解析 ====================
// 整行字段一次字符扫描直接累积为 i64，返回字段值表。字段下标对应协议行：
//   0=id 1=tag 2=name 3=val 4=aux 5=line 6=col 7=nchild 8..=子节点 id
// 逐字节等价于原 pf(line,k) + parse_dec 组合：字段以单个空格分隔、全部为
// 十进制整数（允许负号）。语义对齐 parse_dec——负号仅在字段首字符判定、
// 字段内非数字字符跳过、空字段累积为 0。
// 性能动机：原 load_ast/append_ast 每行调用 pf 8+ 次（每次 pf 内部
// str.slice 生成一个字段子串）再各自 parse_dec 独立扫描，大文件（3000+
// 节点）反序列化是性能热点；本函数整行单遍扫描、零中间字段子串分配
// （每行仅一次 str.slice 生成行串本身），把每行的 8+ 次字符串分配降为 0。
func parse_row(line: string) -> table<i64> {
    var out: table<i64> = table_new_i64() // 字段值累积表（按出现顺序 push）
    var n = str_len(line)                 // 行长度（协议行行尾仅 \n，无 \r）
    var v: i64 = 0                        // 当前字段的十进制累积值
    var neg: bool = false                 // 当前字段为负数（仅字段首字符判定）
    var in_field: bool = false            // 已进入字段（防御行内连续空格）
    var i: i64 = 0
    while i < n {
        var ch = str_char(line, i)
        if ch == " " {
            // 空格 = 字段分隔符：把已累积的当前字段落盘，并重置字段状态
            if in_field {
                if neg {
                    v = 0 - v
                }
                table_push(out, v)
                v = 0
                neg = false
                in_field = false
            }
        } else {
            if !in_field {
                // 字段首字符：仅此位置判定负号（对齐 parse_dec 的开头负号语义）
                in_field = true
                if ch == "-" {
                    neg = true
                } else {
                    var cc = char_code(ch)
                    if cc >= 48 {
                        if cc <= 57 {
                            v = v * 10 + (cc - 48)
                        }
                    }
                }
            } else {
                // 字段中间字符：跳过非数字，只累积十进制位（对齐 parse_dec）
                var cc = char_code(ch)
                if cc >= 48 {
                    if cc <= 57 {
                        v = v * 10 + (cc - 48)
                    }
                }
            }
        }
        i = i + 1
    }
    // 行尾没有空格：把最后一个字段落盘（整行为空时 out 保持空表）
    if in_field {
        if neg {
            v = 0 - v
        }
        table_push(out, v)
    }
    return out
}

// 加载 AST 协议文本（首行 N: + 每行 id tag name val aux line col nchild c1...）
// 重建 9 列全局表。返回 0 成功 / -1 失败。
pub func load_ast(ast_text: string) -> i64 {
    // 首行 N:
    var first_end: i64 = 0
    var n = str_len(ast_text)
    var i: i64 = 0
    while i < n {
        if str_char(ast_text, i) == "\n" {
            first_end = i
            break
        }
        i = i + 1
    }
    if first_end == 0 {
        return -1
    }
    var head = str.slice(ast_text, 0, first_end)
    var cnt = parse_dec(str.slice(head, 0, str_len(head) - 1))
    s_n = cnt
    // 预分配 9 列（push -1 占位，避免后续超界）
    s_tags = table_new_i64()
    s_names = table_new_i64()
    s_vals = table_new_i64()
    s_aux = table_new_i64()
    s_coff = table_new_i64()
    s_nchild = table_new_i64()
    s_children = table_new_i64()
    s_lines = table_new_i64()
    s_cols = table_new_i64()
    node_types = table_new_i64()
    var k: i64 = 0
    while k < cnt {
        table_push(s_tags, 0)
        table_push(s_names, 0)
        table_push(s_vals, 0)
        table_push(s_aux, 0)
        table_push(s_coff, 0)
        table_push(s_nchild, 0)
        table_push(s_lines, 0)
        table_push(s_cols, 0)
        table_push(node_types, -1)
        k = k + 1
    }
    // 逐行解析节点（parse_row 整行单次扫描直接累积 i64，零字段子串分配）
    var pos: i64 = first_end + 1
    var node_id: i64 = 0
    while pos < n && node_id < cnt {
        var line_end: i64 = pos
        while line_end < n {
            if str_char(ast_text, line_end) == "\n" {
                break
            }
            line_end = line_end + 1
        }
        // 整行字段一次扫描：f[0]=id f[1]=tag f[2]=name f[3]=val
        // f[4]=aux f[5]=line f[6]=col f[7]=nchild f[8..]=子节点 id
        var f: table<i64> = parse_row(str.slice(ast_text, pos, line_end))
        s_tags[node_id] = f[1]
        s_names[node_id] = f[2]
        s_vals[node_id] = f[3]
        s_aux[node_id] = f[4]
        s_nchild[node_id] = f[7]
        s_lines[node_id] = f[5]
        s_cols[node_id] = f[6]
        node_id = node_id + 1
        pos = line_end + 1
    }
    // 计算子节点偏移并填充 s_children
    var off: i64 = 0
    var j: i64 = 0
    while j < cnt {
        s_coff[j] = off
        off = off + s_nchild[j]
        j = j + 1
    }
    // 二次扫描：填充 s_children
    s_children = table_new_i64()
    var z: i64 = 0
    while z < off {
        table_push(s_children, 0)
        z = z + 1
    }
    pos = first_end + 1
    node_id = 0
    while pos < n && node_id < cnt {
        var line_end: i64 = pos
        while line_end < n {
            if str_char(ast_text, line_end) == "\n" {
                break
            }
            line_end = line_end + 1
        }
        // 子节点字段从下标 8 起连续排列，直接按 f[8 + c] 取用
        var f: table<i64> = parse_row(str.slice(ast_text, pos, line_end))
        var nc = s_nchild[node_id]
        var base = s_coff[node_id]
        var c: i64 = 0
        while c < nc {
            s_children[base + c] = f[8 + c]
            c = c + 1
        }
        node_id = node_id + 1
        pos = line_end + 1
    }
    return 0
}

// ==================== import 展开：追加合并 AST ====================
// 把 import 文件的 AST 协议文本节点追加到当前 s_* 表末尾。
// 新节点 id 自动 = 原 id + base（当前节点总数）；子节点 id 同步偏移。
// 返回新节点段起点 base（>=0 成功；-1 失败）——调用方可用
// base + 新文件节点数 - 1 定位该文件的顶层 StmtList root。
pub func append_ast(ast_text: string) -> i64 {
    // 首行 N:
    var first_end: i64 = 0
    var n = str_len(ast_text)
    var i: i64 = 0
    while i < n {
        if str_char(ast_text, i) == "\n" {
            first_end = i
            break
        }
        i = i + 1
    }
    if first_end == 0 {
        return -1
    }
    var head = str.slice(ast_text, 0, first_end)
    var cnt = parse_dec(str.slice(head, 0, str_len(head) - 1))
    var base = len(s_tags)
    // 逐行解析节点并追加（子节点先暂存，第二次扫描填偏移）
    var pos: i64 = first_end + 1
    var node_id: i64 = 0
    var new_offs: table<i64> = table_new_i64()
    while pos < n && node_id < cnt {
        var line_end: i64 = pos
        while line_end < n {
            if str_char(ast_text, line_end) == "\n" {
                break
            }
            line_end = line_end + 1
        }
        // 整行字段一次扫描：f[0]=id f[1]=tag f[2]=name f[3]=val
        // f[4]=aux f[5]=line f[6]=col f[7]=nchild f[8..]=子节点 id
        var f: table<i64> = parse_row(str.slice(ast_text, pos, line_end))
        table_push(s_tags, f[1])
        table_push(s_names, f[2])
        table_push(s_vals, f[3])
        table_push(s_aux, f[4])
        table_push(s_coff, 0)
        table_push(s_nchild, f[7])
        table_push(s_lines, f[5])
        table_push(s_cols, f[6])
        table_push(node_types, -1)
        table_push(new_offs, 0)
        node_id = node_id + 1
        pos = line_end + 1
    }
    // 计算新节点子段偏移（相对 s_children 当前末尾）
    var off = len(s_children)
    var j: i64 = 0
    while j < cnt {
        new_offs[j] = off
        off = off + s_nchild[base + j]
        j = j + 1
    }
    // 二次扫描：填充子节点（id 偏移 +base，-1 哨兵保持）
    pos = first_end + 1
    node_id = 0
    while pos < n && node_id < cnt {
        var line_end: i64 = pos
        while line_end < n {
            if str_char(ast_text, line_end) == "\n" {
                break
            }
            line_end = line_end + 1
        }
        // 子节点字段从下标 8 起连续排列，直接按 f[8 + c] 取用
        var f: table<i64> = parse_row(str.slice(ast_text, pos, line_end))
        s_coff[base + node_id] = new_offs[node_id]
        var nc = s_nchild[base + node_id]
        var c: i64 = 0
        while c < nc {
            var cid = f[8 + c]
            if cid >= 0 {
                cid = cid + base
            }
            table_push(s_children, cid)
            c = c + 1
        }
        node_id = node_id + 1
        pos = line_end + 1
    }
    s_n = len(s_tags)
    return base
}

// ==================== 节点访问辅助 ====================
pub func nchild(id: i64) -> i64 {
    return s_nchild[id]
}
pub func child(id: i64, k: i64) -> i64 {
    return s_children[s_coff[id] + k]
}
pub func name_str(id: i64) -> string {
    var nid = s_names[id]
    if nid < 0 {
        return ""
    }
    return intern.lookup(nid)
}

// 泛型槽偏移判定（2026-08-14 泛型语法布局，权威约定见 ast.tie 头部注释）：
// 返回 1 表示 children 头部有「泛型槽/类型实参槽」——children[0] == -1 哨兵
// （非泛型但槽仍占位）或 children[0] 是 N_TYPE_PARAMS / N_TYPE_ARGS 节点。
// 消费方读取「返回类型 / 第 i 个参数 / 第 i 个字段 / 第 i 个实参 / 接收者」
// 等位置时必须 +1 偏移。适用节点：FnDef / Struct（N_TYPE_PARAMS 槽）、
// Call / MethodCall / StructType（N_TYPE_ARGS 槽）——T1 起这些节点恒有槽，
// 故对它们恒返回 1。无子节点（nchild==0）或首子节点非槽 → 0。
pub func slot_off(node: i64) -> i64 {
    if s_nchild[node] <= 0 {
        return 0
    }
    var c0 = s_children[s_coff[node]]
    if c0 < 0 {
        return 1  // -1 哨兵：泛型槽存在但为空
    }
    var t0 = s_tags[c0]
    if t0 == S_N_TYPE_PARAMS || t0 == S_N_TYPE_ARGS {
        return 1
    }
    return 0
}

// ==================== 可寻址与可见性辅助 ====================
// P8 可寻址判定（对齐 Rust is_addressable_expr）：只有变量或字段访问链可寻址。
pub func is_addressable(id: i64) -> bool {
    var tag = s_tags[id]
    if tag == 6 {
        return true
    }
    if tag == 15 {
        return is_addressable(child(id, 0))
    }
    return false
}

// 字符串前缀判定（s 是否以 pre 开头）
pub func has_prefix_str(s: string, pre: string) -> bool {
    var n = str_len(s)
    var m = str_len(pre)
    if n < m {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_char(s, i) != str_char(pre, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 查找最后一个 "::" 的位置（命名空间分隔；返回 ':' 下标，-1 = 无）
pub func rfind_ns(s: string) -> i64 {
    var n = str_len(s)
    var i: i64 = 0
    var last: i64 = -1
    while i + 1 < n {
        if str_char(s, i) == ":" {
            if str_char(s, i + 1) == ":" {
                last = i
            }
        }
        i = i + 1
    }
    return last
}

// 私有函数可见性校验（对齐 Rust check_visibility，M2.1.7）：
// 返回 0 = 可见 / -1 = 私有拦截（sm_err_* 已置）。
// 规则：显式 pub 放行；顶层函数（全名无 ::）恒放行；同命名空间或**子命名空间**
// 放行（ns_stack 前缀匹配 prefix）；否则报私有调用错误。
pub func check_visibility(full_name: string, sig: i64, call_node: i64) -> i64 {
    if sg_pub[sig] == 1 {
        return 0
    }
    var last = rfind_ns(full_name)
    if last < 0 {
        return 0
    }
    var prefix = str.slice(full_name, 0, last)
    var cur = cur_ns_prefix()
    if cur == prefix {
        return 0
    }
    if has_prefix_str(cur, prefix + "::") {
        return 0
    }
    sm_err_line = s_lines[call_node]
    sm_err_col = s_cols[call_node]
    sm_err_msg = "函数 '" + full_name + "' 是命名空间 '" + prefix + "' 的私有函数（默认私有，`pub func` 显式导出），不可在命名空间之外调用"
    return -1
}

// 当前函数命名空间前缀（可见性校验用）
pub func cur_ns_prefix() -> string {
    var out: string = ""
    var i: i64 = 0
    while i < ns_top {
        if i > 0 {
            out = out + "::"
        }
        out = out + intern.lookup(ns_stack[i])
        i = i + 1
    }
    return out
}

// ==================== 符号表（并行排序表 + 二分）====================
// 二分查找升序 keys，返回下标或 -1
pub func bs_find(keys: table<i64>, k: i64) -> i64 {
    var lo: i64 = 0
    var hi: i64 = len(keys) - 1
    while lo <= hi {
        var mid = (lo + hi) / 2
        var kv = keys[mid]
        if kv == k {
            return mid
        }
        if kv < k {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return -1
}

// 有序插入 keys（返回插入位置），vals 并行同步插入
pub func sorted_insert(keys: table<i64>, vals: table<i64>, k: i64, v: i64) -> i64 {
    var n = len(keys)
    var lo: i64 = 0
    var hi: i64 = n - 1
    var pos: i64 = n
    while lo <= hi {
        var mid = (lo + hi) / 2
        if keys[mid] < k {
            lo = mid + 1
        } else {
            pos = mid
            hi = mid - 1
        }
    }
    table_push(keys, 0)
    table_push(vals, 0)
    var i: i64 = n
    while i > pos {
        keys[i] = keys[i - 1]
        vals[i] = vals[i - 1]
        i = i - 1
    }
    keys[pos] = k
    vals[pos] = v
    return pos
}

// 全局变量四列有序插入（返回插入位置）：keys/vals/cons/telems 并行同步移位。
// 全局变量收集顺序与 intern id 顺序不一致（import 文件全局先收集、主文件
// 全局后收集但 nid 更小），故 sorted_insert 可能中间插入——若 const/telem
// 仅 table_push 末尾追加会与 keys/vals 错位（读错行的 const/元素类型）。
// 参照 sinfer.lv_add 的五列同步移位模式，四列同位置插入。
pub func sorted_insert_gb(keys: table<i64>, vals: table<i64>, cons: table<i64>, telems: table<i64>, k: i64, v: i64, c: i64, e: i64) -> i64 {
    var n = len(keys)
    var lo: i64 = 0
    var hi: i64 = n - 1
    var pos: i64 = n
    while lo <= hi {
        var mid = (lo + hi) / 2
        if keys[mid] < k {
            lo = mid + 1
        } else {
            pos = mid
            hi = mid - 1
        }
    }
    table_push(keys, 0)
    table_push(vals, 0)
    table_push(cons, 0)
    table_push(telems, 0)
    var i: i64 = n
    while i > pos {
        keys[i] = keys[i - 1]
        vals[i] = vals[i - 1]
        cons[i] = cons[i - 1]
        telems[i] = telems[i - 1]
        i = i - 1
    }
    keys[pos] = k
    vals[pos] = v
    cons[pos] = c
    telems[pos] = e
    return pos
}

// 函数签名登记（重复定义检查，返回签名 id 或 -1）
pub func reg_fn(full_name: string, is_pub: i64, nparams: i64, required: i64, ret_ty: i64, p_tys: table<i64>, p_refs: table<i64>, p_defs: table<i64>) -> i64 {
    var nid = intern.intern(full_name)
    if bs_find(fn_keys, nid) >= 0 {
        sm_err_line = 1
        sm_err_col = 1
        // 命名空间函数 vs 顶层函数措辞（对齐 Rust）：A::f → 函数 'f' 在命名空间 'A' 内重复定义
        var last = rfind_ns(full_name)
        if last >= 0 {
            var bare = str.slice(full_name, last + 2, str_len(full_name))
            var prefix = str.slice(full_name, 0, last)
            sm_err_msg = "函数 '" + bare + "' 在命名空间 '" + prefix + "' 中重复定义"
        } else {
            sm_err_msg = "函数 '" + full_name + "' 重复定义"
        }
        return -1
    }
    var sig = len(sg_nparams)
    var off = len(sp_tys)
    table_push(sg_nparams, nparams)
    table_push(sg_required, required)
    table_push(sg_ret, ret_ty)
    table_push(sg_pub, is_pub)
    table_push(sg_off, off)
    var i: i64 = 0
    while i < nparams {
        table_push(sp_tys, p_tys[i])
        table_push(sp_refs, p_refs[i])
        table_push(sp_defs, p_defs[i])
        i = i + 1
    }
    sorted_insert(fn_keys, fn_vals, nid, sig)
    return sig
}

// 查函数签名 id（未定义返回 -1）
pub func fn_sig(full_name: string) -> i64 {
    var nid = intern.intern(full_name)
    var idx = bs_find(fn_keys, nid)
    if idx < 0 {
        return -1
    }
    return fn_vals[idx]
}

// struct 登记（重复/冲突检查，返回 struct 索引或 -1）
pub func reg_struct(name: string, parent: string) -> i64 {
    var nid = intern.intern(name)
    if bs_find(st_keys, nid) >= 0 {
        sm_err_msg = "struct '" + name + "' 重复定义"
        return -1
    }
    var idx = len(cls_parent)
    var p_nid: i64 = -1
    if parent != "" {
        p_nid = intern.intern(parent)
    }
    table_push(cls_parent, p_nid)
    table_push(cls_fldoff, len(fld_names))
    table_push(cls_nfld, 0)
    table_push(cls_done, 0)
    sorted_insert(st_keys, st_vals, nid, idx)
    // struct 名登记由上层（stype）经 types.set_struct_name 完成
    return idx
}

// ==================== 泛型模板登记辅助（T3b 单态化展开器预置）====================

// 泛型模板索引查询（全名 -> 模板索引；-1 = 未登记）。
// 模板名与普通函数/struct 名分表存储：同一全名只可能在 gty_keys 或
// fn_keys/st_keys 之一（collect 阶段分派，重复定义在各自登记处报错）。
pub func gt_find(full_name: string) -> i64 {
    var nid = intern.intern(full_name)
    var idx = bs_find(gty_keys, nid)
    if idx < 0 {
        return -1
    }
    return gty_vals[idx]
}

// 泛型模板登记：node 的 children[0] 必为 N_TYPE_PARAMS（调用方已判定）。
// 提取类型参数名段（N_TYPE_PARAM 序列的 name 字段，扁平存入 gtyp_names）+
// 登记定义节点 id / 类别。重复定义返回 -1（sm_err_* 已置）；成功返回模板
// 索引。登记本身不检查模板体内 TypeVar 引用（T3b 单态化展开时处理）。
pub func reg_generic(full_name: string, node: i64, is_struct: i64) -> i64 {
    if gt_find(full_name) >= 0 {
        sm_err_line = s_lines[node]
        sm_err_col = s_cols[node]
        sm_err_msg = "泛型模板 '" + full_name + "' 重复定义"
        return -1
    }
    var tp = child(node, 0)  // N_TYPE_PARAMS 节点
    var npar = s_nchild[tp]
    var idx = len(gtyp_nparams)
    var off = len(gtyp_names)
    var i: i64 = 0
    while i < npar {
        var p = child(tp, i)  // N_TYPE_PARAM 节点（name = 类型参数名 id）
        table_push(gtyp_names, s_names[p])
        i = i + 1
    }
    table_push(gtyp_nparams, npar)
    table_push(gtyp_off, off)
    table_push(gty_node, node)
    table_push(gty_is_struct, is_struct)
    sorted_insert(gty_keys, gty_vals, intern.intern(full_name), idx)
    return idx
}

// ==================== 实例化记录辅助（T3b 单态化展开器）====================

// 实例化记录查询（mangled 名 -> 记录索引；-1 = 未实例化）。
// 去重键 = mangled 名（含类型实参片段），同名即同组合。
pub func gin_find(mangled: string) -> i64 {
    var nid = intern.intern(mangled)
    var idx = bs_find(gin_keys, nid)
    if idx < 0 {
        return -1
    }
    return gin_vals[idx]
}

// 实例化记录登记：mangled 名 + 模板索引 + 类型实参表（按模板类型参数顺序）
// + 类别。返回记录索引。调用方保证未重复（gin_find 已判定）。
pub func gin_reg(mangled: string, gti: i64, args: table<i64>, is_struct: i64) -> i64 {
    var rec = len(gin_tmpl)
    var off = len(garg_vals)
    var k: i64 = 0
    while k < len(args) {
        table_push(garg_vals, args[k])
        k = k + 1
    }
    table_push(gin_tmpl, gti)
    table_push(gin_off, off)
    table_push(gin_nargs, len(args))
    table_push(gin_is_struct, is_struct)
    sorted_insert(gin_keys, gin_vals, intern.intern(mangled), rec)
    return rec
}

// 第 rec 条记录的第 k 个类型实参 id（越界返回 -1）
pub func gin_arg_at(rec: i64, k: i64) -> i64 {
    if rec < 0 || rec >= len(gin_tmpl) {
        return -1
    }
    var n = gin_nargs[rec]
    if k < 0 || k >= n {
        return -1
    }
    return garg_vals[gin_off[rec] + k]
}

// 第 rec 条记录的类型实参表副本（推断/匹配用）
pub func gin_args(rec: i64) -> table<i64> {
    var out: table<i64> = table_new_i64()
    if rec < 0 || rec >= len(gin_tmpl) {
        return out
    }
    var n = gin_nargs[rec]
    var k: i64 = 0
    while k < n {
        table_push(out, garg_vals[gin_off[rec] + k])
        k = k + 1
    }
    return out
}

// 模板类型参数名 id 表（按声明顺序；返回新表）
pub func gt_param_names(gti: i64) -> table<i64> {
    var out: table<i64> = table_new_i64()
    if gti < 0 || gti >= len(gtyp_nparams) {
        return out
    }
    var n = gtyp_nparams[gti]
    var off = gtyp_off[gti]
    var k: i64 = 0
    while k < n {
        table_push(out, gtyp_names[off + k])
        k = k + 1
    }
    return out
}

// ==================== 命名空间栈 ====================
// 命名空间段压栈（游标写：复用已分配槽位，避免旧值残留误读）
pub func ns_push(seg_id: i64) {
    if ns_top < len(ns_stack) {
        ns_stack[ns_top] = seg_id
    } else {
        table_push(ns_stack, seg_id)
    }
    ns_top = ns_top + 1
}

// 命名空间段弹栈（游标递减）
pub func ns_pop() {
    if ns_top > 0 {
        ns_top = ns_top - 1
    }
}

// 命名空间全名拼接（ns_stack 段 + 名字）
pub func ns_full_name(name: string) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < ns_top {
        if i > 0 {
            out = out + "::"
        }
        out = out + intern.lookup(ns_stack[i])
        i = i + 1
    }
    if out != "" {
        out = out + "::"
    }
    return out + name
}

// struct 索引 -> 名字（st_keys 按名字排序，须经 st_vals 反查索引位置）
pub func struct_name_of(idx: i64) -> string {
    var n = len(st_keys)
    var i: i64 = 0
    while i < n {
        if st_vals[i] == idx {
            return intern.lookup(st_keys[i])
        }
        i = i + 1
    }
    return "?"
}

}
