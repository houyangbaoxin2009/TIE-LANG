const S_N_VAR_DECL: i64 = 100;
const S_N_FN_DEF: i64 = 101;
const S_N_EXPR_STMT: i64 = 102;
const S_N_ASSIGN: i64 = 103;
const S_N_RETURN: i64 = 104;
const S_N_IF: i64 = 105;
const S_N_WHILE: i64 = 106;
const S_N_FOR: i64 = 107;
const S_N_BREAK: i64 = 108;
const S_N_CONTINUE: i64 = 109;
const S_N_SWITCH: i64 = 110;
const S_N_IMPORT: i64 = 111;
const S_N_NAMESPACE: i64 = 112;
const S_N_USING: i64 = 113;
const S_N_STRUCT: i64 = 114;
const S_N_FIELD_ASSIGN: i64 = 115;
const S_N_INDEX_ASSIGN: i64 = 116;
const S_N_EXTERN: i64 = 117;
const S_N_PARAM: i64 = 118;
const S_N_SWITCH_CASE: i64 = 120;
const S_N_PATTERN_LIST: i64 = 121;
const S_N_STMTLIST: i64 = 122;
const S_N_CLASS_FIELD: i64 = 123;
