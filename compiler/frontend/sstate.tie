type tie<class>
// compiler/frontend/sstate.tie —— T2.6 语义分析全局状态（模块拆分）
// ============================================================
// 里程碑：自举 v2 计划 T2.6（.omo/plans/self-hosting-v2.md）完整语义分析
// 拆分为 8 模块之一（本文件 = AST 9 列 + 符号表全局 + 协议解析 + 节点访问 +
// 工具/登记函数，零依赖除 interner/string/lex 原语）。import 树最深层。
// 对应 proto/semantic.tie 142-231（状态）+ 238-377（load_ast）+ 380-520
// （节点访问/可寻址/可见性）+ 642-755（bs_find/sorted_insert/reg_fn/
// reg_struct/fn_sig）+ 1250-1264（ns_push/ns_pop）逻辑搬移。
// 依赖：无（intern/str 原语直接可用，与 T2.4/T2.5 一致不显式 import）。
// S2.4：port 登记调用 types.set_port_name（port 名表还原）——types 在
// middle（../middle/types.tie），须显式 import（interp_eval 等独立场景
// 的 import 链不保证传递可见；s24 分支曾因缺 import 报未定义）。
import "../middle/types.tie"
// 由 stype.tie import（传递可达上层全部）。

// ==================== AST 全局列式表（协议解析结果）====================
var s_tags: table<i64>;       // 节点 tag
var s_names: table<i64>;      // 字符串池 id（-1=无）
var s_vals: table<i64>;       // 主整数值（字面量值/运算符/标志）
var s_aux: table<i64>;        // 次整数值（nparams/nsegs/ncases/label）
var s_coff: table<i64>;       // 子节点偏移（s_children 段起点）
var s_nchild: table<i64>;     // 子节点数
var s_children: table<i64>;   // 扁平子节点 id 段
var s_lines: table<i64>;      // 起始行（1-based）
var s_cols: table<i64>;       // 起始列（1-based）
var s_n: i64 = 0;             // 节点总数

// ==================== 符号表全局 ====================
var fn_keys: table<i64>;      // 函数全名 id（升序）
var fn_vals: table<i64>;      // 签名 id
var fn_def_nodes: table<i64>; // 函数定义 AST 节点 id（与 fn_keys 平行；性能重构：
                              // check_fn_walk 查表 O(log n) 定位，替代每函数线性
                              // 扫全部顶层 + ns_full_name 拼串比较的 O(N×M) 平方）
var sg_nparams: table<i64>;   // 签名表：参数总数
var sg_required: table<i64>;  // 必选参数数（默认值前）
var sg_ret: table<i64>;       // 返回类型 id
var sg_pub: table<i64>;       // 0/1
var sg_off: table<i64>;       // 参数段偏移（sp_tys/sp_refs/sp_defs）
var sp_tys: table<i64>;       // 参数类型 id（扁平段）
var sp_refs: table<i64>;      // 参数 by_ref 标志（扁平段）
var sp_defs: table<i64>;      // 参数有默认值（扁平段）
var sp_vars: table<i64>;      // 参数变参标志（扁平段；1 = `name: ...T`）

var st_keys: table<i64>;      // struct 名 id（升序）
var st_vals: table<i64>;      // struct 索引
var cls_parent: table<i64>;   // struct 父名 id（-1=无）
var cls_fldoff: table<i64>;   // 字段段偏移（fld_names/fld_tys）
var cls_nfld: table<i64>;     // 字段数（含继承拍平）
var cls_done: table<i64>;     // struct 字段收集完成标志（0/1，拍平递归防重）
var fld_names: table<i64>;    // 拍平字段名 id
var fld_tys: table<i64>;      // 拍平字段类型 id
var fld_defs: table<i64>;     // 拍平字段默认值表达式节点 id（-1 = 无；Point.y = 10）

// ==================== enum 状态表（2026-08-15 enum 语言特性）====================
// enum 表按「名 id（升序）→ 索引」登记，索引行号 = types.enum_of 的负载。
// 变体信息拍平段（en_vnames/en_vtags/en_vfldoff/en_vnfld 共用 en_varoff 段偏移；
// payload 类型单独拍平进 en_ftys，变体经 en_vfldoff 定位其字段段）。
var en_keys: table<i64>;      // enum 名 id（升序，二分）
var en_vals: table<i64>;      // enum 索引
var en_done: table<i64>;      // 变体收集完成标志（0/1，防重复收集）
var en_nvar: table<i64>;      // 变体数
var en_varoff: table<i64>;    // 变体段偏移（en_vnames/en_vtags/en_vfldoff/en_vnfld 共用段）
var en_nslot: table<i64>;     // 槽数 K（所有变体 payload 字段数最大值；后端聚合布局用）
var en_vnames: table<i64>;    // 变体名 id（拍平段）
var en_vtags: table<i64>;     // 变体 tag 值（0..nvar-1，拍平段）
var en_vfldoff: table<i64>;   // 变体 payload 字段段偏移（en_ftys）
var en_vnfld: table<i64>;     // 变体 payload 字段数
var en_ftys: table<i64>;      // 变体 payload 字段类型 id（拍平段）

var gb_keys: table<i64>;      // 全局变量名 id（升序）
var gb_vals: table<i64>;      // 类型 id
var gb_const: table<i64>;     // 0/1
var gb_telem: table<i64>;     // 全局表元素类型 id（-1=非表）

var ext_keys: table<i64>;     // extern 函数名 id（升序）

// S1.2：unsafe 上下文深度（0 = 安全代码）。unsafe fn 体 / unsafe 块 /
// 文件级 type tie<unsafe> 各 +1；语义层触底操作检查 g_unsafe_depth == 0 报错。
var g_unsafe_depth: i64 = 0;

var tre_keys: table<i64>;     // 返回表的函数名 id（升序）
var tre_vals: table<i64>;     // 元素类型 id

var node_types: table<i64>;   // 节点 id -> 类型 id（-1=未推断）

// ==================== 每函数重置的局部状态 ====================
var lv_keys: table<i64>;      // 作用域变量名 id（升序）
var lv_vals: table<i64>;      // 类型 id
var lv_const: table<i64>;     // 0/1
var lv_telem: table<i64>;     // 表变量元素类型 id（-1=非表）
var lv_dyn: table<i64>;       // 表变量动态标志（0/1）
// S1.5 移动语义：变量状态跟踪（live/moved）。**独立升序表**（非 lv_* 并行）：
// 存在即 moved（bs_find >= 0）。移动规则（docs/plans/ui-framework.md §4.2）：
// 堆类型（string/table/含堆字段聚合）赋值/按值传参/返回即转移所有权，源变量
// moved；此后读取 = 编译错误（"use of moved value"）。栈类型不跟踪。
// 维护点：scheck.check_var_decl/check_stmt（赋值/返回移动登记）+ sinfer
// infer_expr S_N_VAR（读取检查）；函数边界（check_fn）重置。独立表的好处：
// 不依赖 lv_insert 同步（lv_* 并行表由 sinfer 维护，S1.2-1.4 并行会话在改）。
var lv_moved: table<i64>;     // 已移动变量名 id（升序，二分）

var lp_stack: table<i64>;     // 循环标签栈（break/continue 上下文；-1=无标签）
var lp_top: i64 = 0;          // lp_stack 逻辑栈顶游标（tie 表无法截断，用游标模拟 pop）
var ns_stack: table<i64>;     // 命名空间段栈（全名补全）
var ns_top: i64 = 0;          // ns_stack 逻辑栈顶游标（同 lp_top）
var using_prefixes: table<i64>;  // using 引入的命名空间段名 id（扁平段 + 长度表）
var using_lens: table<i64>;      // using 前缀段数（与 using_prefixes 并行，按段号分组）

// 返回表的内置函数预登记（元素类型 id）
var tre_bi_keys: table<i64>;  // 内置名 id
var tre_bi_vals: table<i64>;  // 元素类型 id

// ==================== 错误状态 ====================
var sm_err_line: i64 = 0;
var sm_err_col: i64 = 0;
var sm_err_msg: string = "";

// 当前函数全名 id（check_fn 期间；IR 全局初始化不支持负数）
var g_curfn: i64 = 0;
// 当前扫描函数节点（collect 阶段返回表元素预扫描用）
var g_cur_scan_fn: i64 = 0;
// 当前命名空间深度（裸名解析用）
var g_ns_depth: i64 = 0;
// 表达式类型计数（OK: 返回）
var g_typed: i64 = 0;

// struct/tuple 类型 id 缓存与 tuple 字段段
var struct_tys: table<i64>;   // struct 索引 -> 3<<40|idx
var tuple_tys: table<i64>;    // tuple 索引 -> 4<<40|idx
var tup_names: table<i64>;    // tuple 字段名 id（扁平段）
var tup_tys: table<i64>;      // tuple 字段类型 id（扁平段）
var tup_offs: table<i64>;     // tuple 字段段偏移
var tup_n: table<i64>;        // tuple 字段数

// ==================== 泛型模板登记（T3b 单态化展开器预置，2026-08-14）====================
// T1 泛型语法（`func max<T>` / `struct Box<T>`）落地后，本表预置模板登记
// 结构：供 T3b 单态化展开器使用（本任务只建结构 + 查询/登记辅助函数，不实现
// 展开）。登记时机：scollect.collect_fn / collect_struct_decl 检测到 children[0]
// == N_TYPE_PARAMS 时调用 sstate.reg_generic。所有表在 semantic.check_impl /
// check_ast 状态重置时清零。
var gty_keys: table<i64>;      // 泛型模板全名 id（intern，升序）
var gty_vals: table<i64>;      // 模板索引（与 gty_keys 并行，sorted_insert 同插）
var gtyp_nparams: table<i64>;  // 模板索引 -> 类型参数个数
var gtyp_off: table<i64>;      // 模板索引 -> 类型参数名段偏移（gtyp_names 扁平段）
var gtyp_names: table<i64>;    // 类型参数名 id（intern，扁平段；取自 N_TYPE_PARAM.name）
var gty_node: table<i64>;      // 模板索引 -> 定义 AST 节点 id（FnDef / Struct）
var gty_is_struct: table<i64>; // 模板索引 -> 0=函数模板 1=struct 模板
// S2.4 泛型约束段（port 约束，port-model.md §2.3）：gtyp_conoff[模板索引] ->
// gtyp_cons 段偏移；段长 = gtyp_nparams（每类型参数 1 槽，-1 = 无约束）。
// 槽值 = 约束 port 名 id（intern；语义层校验是已登记 port）。
// 实例化（sgen.instantiate_fn/struct）实参化时校验：实参类型必须 impl 该 port。
var gtyp_conoff: table<i64>;  // 模板索引 -> 约束段偏移（gtyp_cons）
var gtyp_cons: table<i64>;    // 约束 port 名 id 扁平段（-1 = 无约束）

// 实例化记录表（gin_*，T3b 单态化展开器 2026-08-14）：
// 同（模板名, 类型实参组合）只展开一次——mangled 名即去重键。
// gin_keys/gin_vals：mangled 名 id（升序）→ 记录索引（sorted_insert 同插）。
// gin_tmpl/gin_off/gin_nargs/gin_is_struct：记录索引 → 模板索引 / 类型实参
// 段偏移（garg_vals 扁平段）/ 实参个数 / 0=函数 1=struct。
// garg_vals：类型实参 id 扁平段（按模板类型参数顺序）。
// 所有表在 semantic.check_impl / check_ast 状态重置时清零。
var gin_keys: table<i64>;      // 实例化 mangled 名 id（升序）
var gin_vals: table<i64>;      // 记录索引（与 gin_keys 并行）
var gin_tmpl: table<i64>;      // 记录索引 -> 模板索引（gty_vals）
var gin_off: table<i64>;       // 记录索引 -> 类型实参段偏移（garg_vals）
var gin_nargs: table<i64>;     // 记录索引 -> 类型实参个数
var gin_is_struct: table<i64>; // 记录索引 -> 0=函数 1=struct
var garg_vals: table<i64>;     // 类型实参 id 扁平段
// 实例化递归深度计数（防无限递归，上限 64）
var g_inst_depth: i64 = 0;

// ==================== 闭包语义状态表（S2.2，2026-08-16）====================
// 闭包（N_FN_LIT func 字面量）延迟检查队列 + 捕获分析。
// infer_expr 遇 N_FN_LIT 时：① 解析返回/参数类型 → types.fn_of 登记 fn 类型；
// ② 保存「登记时 lv 快照」（捕获基准：闭包体检查重建作用域用）；③ 入队
// g_clo_pending（FIFO）。闭包体（语句块）检查延迟到语义主流程末尾由
// scheck.check_pending_closures() 统一处理（sinfer 无 check_block 能力，且
// import 树禁止 sinfer → scheck）。捕获判定在 sinfer S_N_VAR 分支（命中
// lv 且非闭包参数/局部 → 登记 cl_capkeys/cl_capvals）。所有表在
// semantic.check_impl / check_ast 状态重置时清零。
var g_clo_pending: table<i64>;  // 待检查闭包 N_FN_LIT 节点 id（FIFO 登记顺序）
var cl_ret: table<i64>;         // 闭包索引 -> 返回类型 id
var cl_nparams: table<i64>;     // 闭包索引 -> 参数个数
var cl_paroff: table<i64>;      // 闭包索引 -> 参数类型段偏移（cl_ptys）
var cl_ptys: table<i64>;        // 参数类型 id 扁平段
var cl_off: table<i64>;         // 闭包索引 -> lv 快照段偏移（cl_okeys 等）
var cl_nouter: table<i64>;      // 闭包索引 -> 快照条数（登记时 lv_keys 长度）
var cl_okeys: table<i64>;       // 快照变量名 id（扁平段）
var cl_ovals: table<i64>;       // 快照类型 id
var cl_oconst: table<i64>;      // 快照 const 标志
var cl_otelem: table<i64>;      // 快照表元素类型 id
var cl_odyn: table<i64>;        // 快照动态标志
var cl_paramoff: table<i64>;    // 闭包索引 -> 参数名段偏移（cl_params）
var cl_params: table<i64>;      // 闭包参数名 id（扁平段；捕获遮蔽判定）
var cl_locloff: table<i64>;     // 闭包索引 -> 局部名段偏移（cl_locals）
var cl_locals: table<i64>;      // 闭包内声明局部名 id（扁平段；捕获遮蔽判定）
var cl_capoff: table<i64>;      // 闭包索引 -> 捕获段偏移（cl_capkeys/cl_capvals）
var cl_capkeys: table<i64>;     // 捕获变量名 id（扁平段）
var cl_capvals: table<i64>;     // 捕获变量类型 id（扁平段）
var g_clo_depth: i64 = 0;       // 闭包体检查深度（>0 = 在闭包体内）
var g_clo_cur: i64 = -1;        // 当前闭包索引（捕获登记目标；-1 = 无）
var g_clo_ret_stack: table<i64>;// 闭包返回类型栈（S_N_RETURN / ? 解包用）
var g_clo_ret_top: i64 = 0;     // 返回类型栈逻辑栈顶游标（tie 表无法截断）
var cl_parent: table<i64>;      // 闭包索引 -> 父闭包索引（sinfer 登记时 g_clo_cur；
                                // -1 = 直接嵌套在普通函数体）。捕获传播（任务21）
                                // 沿此链把内层闭包捕获上溯到祖先闭包的 env。

// ==================== 顶层 StmtList 根（parse_program 创建的最后节点 id）
var g_root: i64 = 0;

// ==================== 一期并发 actor 状态表 ====================
// actor 表：ac_keys（actor 名 id，升序）→ ac_vals（actor 索引）。索引与
// types.BASE_ACTOR 行号对应（scollect 收集时 set_actor_name 登记同名）。
var ac_keys: table<i64>;
var ac_vals: table<i64>;

// ==================== S2.4 port / impl 状态表（接口模型）====================
// port 表：pt_keys（port 名 id，升序）→ pt_vals（port 索引）。
// port 方法签名表（行 = port 索引）：
//   pm_off[port]  -> pm_names 段偏移（方法名 id，声明顺序 = vtable 字段序）
//   pm_n[port]    -> 方法个数
//   pm_npar[port] -> 方法参数个数表段偏移（pm_npars 扁平段，含 self）
//   pm_paroff[port] -> 参数类型段偏移（pm_ptys 扁平段）
//   pm_ret[port]  -> 返回类型表段偏移（pm_rets 扁平段）
// 方法 m 的签名：参数个数 = pm_npars[pm_npar + m]，参数段 =
// pm_ptys[pm_paroff + m .. +个数]，返回 = pm_rets[pm_ret + m]。
// 参数 0 恒为 self（接收者，类型 = 实现 struct 的占位——签名匹配时跳过）。
var pt_keys: table<i64>;      // port 名 id（升序，二分）
var pt_vals: table<i64>;      // port 索引
var pm_off: table<i64>;       // port 索引 -> 方法名段偏移（pm_names）
var pm_n: table<i64>;         // port 索引 -> 方法个数
var pm_npar: table<i64>;      // port 索引 -> 参数个数表段偏移（pm_npars）
var pm_paroff: table<i64>;    // port 索引 -> 参数类型段偏移（pm_ptys）
var pm_ret: table<i64>;       // port 索引 -> 返回类型表段偏移（pm_rets）
var pm_names: table<i64>;     // 方法名 id 扁平段（声明顺序 = vtable 字段序）
var pm_npars: table<i64>;     // 每方法参数个数（含 self）扁平段
var pm_ptys: table<i64>;      // 每方法参数类型扁平段（含 self 槽位，签名匹配跳过）
var pm_rets: table<i64>;      // 每方法返回类型扁平段
// impl 表：im_keys（升序键 = intern(port名 + "::" + struct名)）→ im_vals（impl 索引）。
// impl 记录（行 = impl 索引）：
//   im_port[impl]  -> port 索引
//   im_struct[impl] -> struct 索引
//   im_poff[impl]  -> im_mnames 段偏移（按 port 方法声明顺序的实现函数全名 id）
//   im_n[impl]     -> 方法个数（= port 方法数，完整性检查后恒等）
var im_keys: table<i64>;      // impl 键 id（升序，二分）
var im_vals: table<i64>;      // impl 索引
var im_port: table<i64>;      // impl 索引 -> port 索引
var im_struct: table<i64>;    // impl 索引 -> struct 索引
var im_poff: table<i64>;      // impl 索引 -> 方法实现全名段偏移（im_mnames）
var im_n: table<i64>;         // impl 索引 -> 方法个数
var im_mnames: table<i64>;    // 方法实现函数全名 id 扁平段（"Struct::method"）

// ==================== import 展开状态（semantic 主入口驱动）====================
var g_imported: table<string>;   // 已导入文件路径集合（去重/防环）
var g_extra_tops: table<i64>;    // 全部文件顶层语句 id（主 + 被导入；collect/查找统一遍历）
// dev33 批次10 任务29 跨文件宏：文件起源跟踪——顶层 StmtList 根 id → 文件 id
//（主文件 0，导入文件按展开顺序递增），供 mexpand 判定宏定义/调用所属文件，
// 实现 pub 宏跨文件可见、非 pub 宏同文件私有。
var g_file_roots: table<i64>;    // 顶层 StmtList 根 id → 文件 id
var g_file_count: i64 = 1;       // 已分配文件 id 数（主文件 0 占位）

const S_N_INT_LIT: i64 = 0;
const S_N_FLOAT_LIT: i64 = 1;
const S_N_STR_LIT: i64 = 2;
const S_N_CHAR_LIT: i64 = 3;
const S_N_BOOL_LIT: i64 = 4;
const S_N_TRIT_LIT: i64 = 5;
const S_N_VAR: i64 = 6;
const S_N_CALL: i64 = 7;
const S_N_UNARY: i64 = 8;
const S_N_BINARY: i64 = 9;
const S_N_TERNARY: i64 = 10;
const S_N_RANGE: i64 = 11;
const S_N_TABLE_LIT: i64 = 12;
const S_N_INDEX: i64 = 13;
const S_N_TUPLE_LIT: i64 = 14;
const S_N_FIELD_ACCESS: i64 = 15;
const S_N_PATH: i64 = 16;
const S_N_TYPE_LIT: i64 = 17;
const S_N_METHOD_CALL: i64 = 18;
const S_N_TABLE_CELL: i64 = 19;
const S_N_TABLE_ID: i64 = 20;
const S_N_TUPLE_FIELD: i64 = 21;
const S_N_SEGMENT: i64 = 22;
const S_N_VAR_DECL: i64 = 100;
const S_N_FN_DEF: i64 = 101;
const S_N_EXPR_STMT: i64 = 102;
const S_N_ASSIGN: i64 = 103;
const S_N_RETURN: i64 = 104;
const S_N_IF: i64 = 105;
const S_N_WHILE: i64 = 106;
const S_N_FOR: i64 = 107;
const S_N_BREAK: i64 = 108;
const S_N_CONTINUE: i64 = 109;
const S_N_SWITCH: i64 = 110;
const S_N_IMPORT: i64 = 111;
const S_N_NAMESPACE: i64 = 112;
const S_N_USING: i64 = 113;
const S_N_STRUCT: i64 = 114;
const S_N_FIELD_ASSIGN: i64 = 115;
const S_N_INDEX_ASSIGN: i64 = 116;
const S_N_EXTERN: i64 = 117;
const S_N_PARAM: i64 = 118;
const S_N_SWITCH_CASE: i64 = 120;
const S_N_PATTERN_LIST: i64 = 121;
const S_N_STMTLIST: i64 = 122;
const S_N_CLASS_FIELD: i64 = 123;
const S_N_TUPLE_TYPE_FIELD: i64 = 124;
const S_N_NAMED_TYPE: i64 = 200;
const S_N_TUPLE_TYPE: i64 = 201;
const S_N_STRUCT_TYPE: i64 = 202;
const S_N_TABLE_TYPE: i64 = 203;
const S_N_MAP_TYPE: i64 = 204;
// 泛型语法节点（2026-08-14，与 ast.tie 同号权威）：N_TYPE_PARAMS（声明点
// 类型参数列表）/ N_TYPE_PARAM（单个类型参数）/ N_TYPE_ARGS（使用点类型
// 实参列表）。语义层在 FnDef/Struct/Call/MethodCall/StructType 的 children
// 头部读取「泛型槽」时用这三个常量判定（配合 sstate.slot_off 统一偏移）。
const S_N_TYPE_PARAMS: i64 = 125;
const S_N_TYPE_PARAM: i64 = 126;
const S_N_TYPE_ARGS: i64 = 127;
const S_N_ENUM: i64 = 128;
const S_N_ENUM_VARIANT: i64 = 129;
const S_N_UNSAFE_BLOCK: i64 = 130;  // unsafe 块（S1.2 U3）
const S_N_ASM: i64 = 131;           // asm! 内联汇编（S1.2 I1）
const S_N_TRY: i64 = 133;           // ? 后缀解包（S2.3，与 ast.tie N_TRY 同号）
const S_N_PANIC: i64 = 134;         // panic 语句（S2.3，与 ast.tie N_PANIC 同号）
const S_N_FN_LIT: i64 = 132;        // func 字面量（S2.2 闭包，与 ast.tie N_FN_LIT 同号）
const S_N_FN_TYPE: i64 = 205;       // 函数值类型（S2.2，与 ast.tie N_FN_TYPE 同号）
// S2.4 port 接口模型（与 ast.tie N_PORT/N_IMPL 同号权威）：
//   编号 138/139：与 S3.3 宏节点（135-137）错开（整合时统一，见 ast.tie）。
const S_N_PORT: i64 = 138;          // port 声明：Port[name=port 名, children=[泛型槽(-1), 方法 FnDef...]]
const S_N_IMPL: i64 = 139;          // impl 块：Impl[children=[port 类型, struct 类型, 方法 FnDef...]]
// S3.3 宏/元编程（与 ast.tie 同号）：
const S_N_MACRO_DEF: i64 = 135;     // 宏定义（M3）
const S_N_CODE_LIT: i64 = 136;      // 准引用字面量（C1）
const S_N_CODE_INTERP: i64 = 137;   // 插值表达式（$x / $(expr)）
// 一期并发 actor（与 ast.tie N_ACTOR 同号）：
const S_N_ACTOR: i64 = 141;         // actor 声明：Actor[name=actor 名, aux=items 数,
                                    //   children=[字段 ClassField..., 方法 FnDef...]]
                                    //   （方法 async 标记经 FnDef val bit2）
const S_N_RUN_ACTOR: i64 = 142;     // run 表达式（run 上下文识别，非保留字）
namespace sstate {

// ==================== 工具：协议解析 ====================
// 读取协议行字段（空格分隔，返回第 k 个字段字符串；k 从 0）
pub func pf(line: string, k: i64) -> string {
    var start: i64 = 0
    var cur: i64 = 0
    var n = str_len(line)
    var i: i64 = 0
    var seg: i64 = 0
    while i <= n {
        var at_end: bool = false
        if i == n {
            at_end = true
        } else {
            if str_char(line, i) == " " {
                at_end = true
            }
        }
        if at_end {
            if seg == k {
                return str.slice(line, start, i)
            }
            seg = seg + 1
            start = i + 1
        }
        i = i + 1
    }
    return ""
}

// 十进制字符串 → i64（协议字段解析用；支持负号）
pub func parse_dec(s: string) -> i64 {
    var n = str_len(s)
    var v: i64 = 0
    var neg: bool = false
    var i: i64 = 0
    if n > 0 {
        if str_char(s, 0) == "-" {
            neg = true
            i = 1
        }
    }
    while i < n {
        var cc = char_code(str_char(s, i))
        if cc >= 48 {
            if cc <= 57 {
                v = v * 10 + (cc - 48)
            }
        }
        i = i + 1
    }
    if neg {
        v = 0 - v
    }
    return v
}

// ==================== 工具：协议行单次扫描解析 ====================
// 整行字段一次字符扫描直接累积为 i64，返回字段值表。字段下标对应协议行：
//   0=id 1=tag 2=name 3=val 4=aux 5=line 6=col 7=nchild 8..=子节点 id
// 逐字节等价于原 pf(line,k) + parse_dec 组合：字段以单个空格分隔、全部为
// 十进制整数（允许负号）。语义对齐 parse_dec——负号仅在字段首字符判定、
// 字段内非数字字符跳过、空字段累积为 0。
// 性能动机：原 load_ast/append_ast 每行调用 pf 8+ 次（每次 pf 内部
// str.slice 生成一个字段子串）再各自 parse_dec 独立扫描，大文件（3000+
// 节点）反序列化是性能热点；本函数整行单遍扫描、零中间字段子串分配
// （每行仅一次 str.slice 生成行串本身），把每行的 8+ 次字符串分配降为 0。
func parse_row(line: string) -> table<i64> {
    var out: table<i64> = table_new_i64() // 字段值累积表（按出现顺序 push）
    var n = str_len(line)                 // 行长度（协议行行尾仅 \n，无 \r）
    var v: i64 = 0                        // 当前字段的十进制累积值
    var neg: bool = false                 // 当前字段为负数（仅字段首字符判定）
    var in_field: bool = false            // 已进入字段（防御行内连续空格）
    var i: i64 = 0
    while i < n {
        var ch = str_char(line, i)
        if ch == " " {
            // 空格 = 字段分隔符：把已累积的当前字段落盘，并重置字段状态
            if in_field {
                if neg {
                    v = 0 - v
                }
                table_push(out, v)
                v = 0
                neg = false
                in_field = false
            }
        } else {
            if !in_field {
                // 字段首字符：仅此位置判定负号（对齐 parse_dec 的开头负号语义）
                in_field = true
                if ch == "-" {
                    neg = true
                } else {
                    var cc = char_code(ch)
                    if cc >= 48 {
                        if cc <= 57 {
                            v = v * 10 + (cc - 48)
                        }
                    }
                }
            } else {
                // 字段中间字符：跳过非数字，只累积十进制位（对齐 parse_dec）
                var cc = char_code(ch)
                if cc >= 48 {
                    if cc <= 57 {
                        v = v * 10 + (cc - 48)
                    }
                }
            }
        }
        i = i + 1
    }
    // 行尾没有空格：把最后一个字段落盘（整行为空时 out 保持空表）
    if in_field {
        if neg {
            v = 0 - v
        }
        table_push(out, v)
    }
    return out
}

// 加载 AST 协议文本（首行 N: + 每行 id tag name val aux line col nchild c1...）
// 重建 9 列全局表。返回 0 成功 / -1 失败。
pub func load_ast(ast_text: string) -> i64 {
    // 首行 N:
    var first_end: i64 = 0
    var n = str_len(ast_text)
    var i: i64 = 0
    while i < n {
        if str_char(ast_text, i) == "\n" {
            first_end = i
            break
        }
        i = i + 1
    }
    if first_end == 0 {
        return -1
    }
    var head = str.slice(ast_text, 0, first_end)
    var cnt = parse_dec(str.slice(head, 0, str_len(head) - 1))
    s_n = cnt
    // 预分配 9 列（push -1 占位，避免后续超界）
    s_tags = table_new_i64()
    s_names = table_new_i64()
    s_vals = table_new_i64()
    s_aux = table_new_i64()
    s_coff = table_new_i64()
    s_nchild = table_new_i64()
    s_children = table_new_i64()
    s_lines = table_new_i64()
    s_cols = table_new_i64()
    node_types = table_new_i64()
    var k: i64 = 0
    while k < cnt {
        table_push(s_tags, 0)
        table_push(s_names, 0)
        table_push(s_vals, 0)
        table_push(s_aux, 0)
        table_push(s_coff, 0)
        table_push(s_nchild, 0)
        table_push(s_lines, 0)
        table_push(s_cols, 0)
        table_push(node_types, -1)
        k = k + 1
    }
    // 逐行解析节点（parse_row 整行单次扫描直接累积 i64，零字段子串分配）
    var pos: i64 = first_end + 1
    var node_id: i64 = 0
    while pos < n && node_id < cnt {
        var line_end: i64 = pos
        while line_end < n {
            if str_char(ast_text, line_end) == "\n" {
                break
            }
            line_end = line_end + 1
        }
        // 整行字段一次扫描：f[0]=id f[1]=tag f[2]=name f[3]=val
        // f[4]=aux f[5]=line f[6]=col f[7]=nchild f[8..]=子节点 id
        var f: table<i64> = parse_row(str.slice(ast_text, pos, line_end))
        s_tags[node_id] = f[1]
        s_names[node_id] = f[2]
        s_vals[node_id] = f[3]
        s_aux[node_id] = f[4]
        s_nchild[node_id] = f[7]
        s_lines[node_id] = f[5]
        s_cols[node_id] = f[6]
        node_id = node_id + 1
        pos = line_end + 1
    }
    // 计算子节点偏移并填充 s_children
    var off: i64 = 0
    var j: i64 = 0
    while j < cnt {
        s_coff[j] = off
        off = off + s_nchild[j]
        j = j + 1
    }
    // 二次扫描：填充 s_children
    s_children = table_new_i64()
    var z: i64 = 0
    while z < off {
        table_push(s_children, 0)
        z = z + 1
    }
    pos = first_end + 1
    node_id = 0
    while pos < n && node_id < cnt {
        var line_end: i64 = pos
        while line_end < n {
            if str_char(ast_text, line_end) == "\n" {
                break
            }
            line_end = line_end + 1
        }
        // 子节点字段从下标 8 起连续排列，直接按 f[8 + c] 取用
        var f: table<i64> = parse_row(str.slice(ast_text, pos, line_end))
        var nc = s_nchild[node_id]
        var base = s_coff[node_id]
        var c: i64 = 0
        while c < nc {
            s_children[base + c] = f[8 + c]
            c = c + 1
        }
        node_id = node_id + 1
        pos = line_end + 1
    }
    return 0
}

// ==================== import 展开：追加合并 AST ====================
// 把 import 文件的 AST 协议文本节点追加到当前 s_* 表末尾。
// 新节点 id 自动 = 原 id + base（当前节点总数）；子节点 id 同步偏移。
// 返回新节点段起点 base（>=0 成功；-1 失败）——调用方可用
// base + 新文件节点数 - 1 定位该文件的顶层 StmtList root。
pub func append_ast(ast_text: string) -> i64 {
    // 首行 N:
    var first_end: i64 = 0
    var n = str_len(ast_text)
    var i: i64 = 0
    while i < n {
        if str_char(ast_text, i) == "\n" {
            first_end = i
            break
        }
        i = i + 1
    }
    if first_end == 0 {
        return -1
    }
    var head = str.slice(ast_text, 0, first_end)
    var cnt = parse_dec(str.slice(head, 0, str_len(head) - 1))
    var base = len(s_tags)
    // 逐行解析节点并追加（子节点先暂存，第二次扫描填偏移）
    var pos: i64 = first_end + 1
    var node_id: i64 = 0
    var new_offs: table<i64> = table_new_i64()
    while pos < n && node_id < cnt {
        var line_end: i64 = pos
        while line_end < n {
            if str_char(ast_text, line_end) == "\n" {
                break
            }
            line_end = line_end + 1
        }
        // 整行字段一次扫描：f[0]=id f[1]=tag f[2]=name f[3]=val
        // f[4]=aux f[5]=line f[6]=col f[7]=nchild f[8..]=子节点 id
        var f: table<i64> = parse_row(str.slice(ast_text, pos, line_end))
        table_push(s_tags, f[1])
        table_push(s_names, f[2])
        table_push(s_vals, f[3])
        table_push(s_aux, f[4])
        table_push(s_coff, 0)
        table_push(s_nchild, f[7])
        table_push(s_lines, f[5])
        table_push(s_cols, f[6])
        table_push(node_types, -1)
        table_push(new_offs, 0)
        node_id = node_id + 1
        pos = line_end + 1
    }
    // 计算新节点子段偏移（相对 s_children 当前末尾）
    var off = len(s_children)
    var j: i64 = 0
    while j < cnt {
        new_offs[j] = off
        off = off + s_nchild[base + j]
        j = j + 1
    }
    // 二次扫描：填充子节点（id 偏移 +base，-1 哨兵保持）
    pos = first_end + 1
    node_id = 0
    while pos < n && node_id < cnt {
        var line_end: i64 = pos
        while line_end < n {
            if str_char(ast_text, line_end) == "\n" {
                break
            }
            line_end = line_end + 1
        }
        // 子节点字段从下标 8 起连续排列，直接按 f[8 + c] 取用
        var f: table<i64> = parse_row(str.slice(ast_text, pos, line_end))
        s_coff[base + node_id] = new_offs[node_id]
        var nc = s_nchild[base + node_id]
        var c: i64 = 0
        while c < nc {
            var cid = f[8 + c]
            if cid >= 0 {
                cid = cid + base
            }
            table_push(s_children, cid)
            c = c + 1
        }
        node_id = node_id + 1
        pos = line_end + 1
    }
    s_n = len(s_tags)
    return base
}

// ==================== 节点访问辅助 ====================
pub func nchild(id: i64) -> i64 {
    return s_nchild[id]
}
pub func child(id: i64, k: i64) -> i64 {
    return s_children[s_coff[id] + k]
}
pub func name_str(id: i64) -> string {
    var nid = s_names[id]
    if nid < 0 {
        return ""
    }
    return intern.lookup(nid)
}

// 泛型槽偏移判定（2026-08-14 泛型语法布局，权威约定见 ast.tie 头部注释）：
// 返回 1 表示 children 头部有「泛型槽/类型实参槽」——children[0] == -1 哨兵
// （非泛型但槽仍占位）或 children[0] 是 N_TYPE_PARAMS / N_TYPE_ARGS 节点。
// 消费方读取「返回类型 / 第 i 个参数 / 第 i 个字段 / 第 i 个实参 / 接收者」
// 等位置时必须 +1 偏移。适用节点：FnDef / Struct（N_TYPE_PARAMS 槽）、
// Call / MethodCall / StructType（N_TYPE_ARGS 槽）——T1 起这些节点恒有槽，
// 故对它们恒返回 1。无子节点（nchild==0）或首子节点非槽 → 0。
pub func slot_off(node: i64) -> i64 {
    if s_nchild[node] <= 0 {
        return 0
    }
    var c0 = s_children[s_coff[node]]
    if c0 < 0 {
        return 1  // -1 哨兵：泛型槽存在但为空
    }
    var t0 = s_tags[c0]
    if t0 == S_N_TYPE_PARAMS || t0 == S_N_TYPE_ARGS {
        return 1
    }
    return 0
}

// ==================== 可寻址与可见性辅助 ====================
// P8 可寻址判定（对齐 Rust is_addressable_expr）：只有变量或字段访问链可寻址。
pub func is_addressable(id: i64) -> bool {
    var tag = s_tags[id]
    if tag == 6 {
        return true
    }
    if tag == 15 {
        return is_addressable(child(id, 0))
    }
    return false
}

// 字符串前缀判定（s 是否以 pre 开头）
pub func has_prefix_str(s: string, pre: string) -> bool {
    var n = str_len(s)
    var m = str_len(pre)
    if n < m {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_char(s, i) != str_char(pre, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 查找最后一个 "::" 的位置（命名空间分隔；返回 ':' 下标，-1 = 无）
pub func rfind_ns(s: string) -> i64 {
    var n = str_len(s)
    var i: i64 = 0
    var last: i64 = -1
    while i + 1 < n {
        if str_char(s, i) == ":" {
            if str_char(s, i + 1) == ":" {
                last = i
            }
        }
        i = i + 1
    }
    return last
}

// 私有函数可见性校验（对齐 Rust check_visibility，M2.1.7）：
// 返回 0 = 可见 / -1 = 私有拦截（sm_err_* 已置）。
// 规则：显式 pub 放行；顶层函数（全名无 ::）恒放行；同命名空间或**子命名空间**
// 放行（ns_stack 前缀匹配 prefix）；否则报私有调用错误。
pub func check_visibility(full_name: string, sig: i64, call_node: i64) -> i64 {
    // S1.2：sg_pub 复用为标志位（bit0=pub, bit1=unsafe）
    if (sg_pub[sig] & 1) == 1 {
        return 0
    }
    var last = rfind_ns(full_name)
    if last < 0 {
        return 0
    }
    var prefix = str.slice(full_name, 0, last)
    var cur = cur_ns_prefix()
    if cur == prefix {
        return 0
    }
    if has_prefix_str(cur, prefix + "::") {
        return 0
    }
    sm_err_line = s_lines[call_node]
    sm_err_col = s_cols[call_node]
    sm_err_msg = "函数 '" + full_name + "' 是命名空间 '" + prefix + "' 的私有函数（默认私有，`pub func` 显式导出），不可在命名空间之外调用"
    return -1
}

// 当前函数命名空间前缀（可见性校验用）
pub func cur_ns_prefix() -> string {
    var out: string = ""
    var i: i64 = 0
    while i < ns_top {
        if i > 0 {
            out = out + "::"
        }
        out = out + intern.lookup(ns_stack[i])
        i = i + 1
    }
    return out
}

// ==================== 符号表（并行排序表 + 二分）====================
// 二分查找升序 keys，返回下标或 -1
pub func bs_find(keys: table<i64>, k: i64) -> i64 {
    var lo: i64 = 0
    var hi: i64 = len(keys) - 1
    while lo <= hi {
        var mid = (lo + hi) / 2
        var kv = keys[mid]
        if kv == k {
            return mid
        }
        if kv < k {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return -1
}

// ==================== S2.2 闭包：扁平段内线性查找 ====================
// 闭包语义状态表的参数名段/局部名段/捕获名段都是「声明/登记顺序」扁平段
// （非升序，不能用 bs_find）。段内成员判定用线性扫（段通常很小：闭包参数
// 数、局部数、捕获数都有限）。off = 段起始下标，n = 段长度，k = 目标名 id。
// 返回 1 = 在段内，0 = 不在。
pub func seg_has(seg: table<i64>, off: i64, n: i64, k: i64) -> i64 {
    var i: i64 = 0
    while i < n {
        if seg[off + i] == k {
            return 1
        }
        i = i + 1
    }
    return 0
}

// ==================== S1.5 移动语义：变量 live/moved 状态 ====================
// 独立升序表 lv_moved：存在即 moved（复用 bs_find 二分）。函数边界（check_fn
// 入口）调用 lv_moved_reset 清空；赋值/按值传参/返回移动时 lv_moved_mark 登记；
// 读取变量前 lv_moved_is 查询——moved 则报 "use of moved value"。
// 表为独立存储（不并入 lv_* 并行表）：S1.2-1.4 并行会话在改 sinfer 的
// lv_insert 五表同步，本表由 scheck/sinfer 额外维护，避免与该同步耦合。

// 重置 moved 状态（每函数开始时调用）
pub func lv_moved_reset() {
    lv_moved = table_new_i64()
}

// 标记变量为 moved（有序插入；重复标记幂等）
pub func lv_moved_mark(nid: i64) {
    if bs_find(lv_moved, nid) >= 0 {
        return
    }
    var n = len(lv_moved)
    var lo: i64 = 0
    var hi: i64 = n - 1
    var pos: i64 = n
    while lo <= hi {
        var mid = (lo + hi) / 2
        if lv_moved[mid] < nid {
            lo = mid + 1
        } else {
            pos = mid
            hi = mid - 1
        }
    }
    table_push(lv_moved, 0)
    var i: i64 = n
    while i > pos {
        lv_moved[i] = lv_moved[i - 1]
        i = i - 1
    }
    lv_moved[pos] = nid
}

// 变量是否已移动（1=moved / 0=live）
pub func lv_moved_is(nid: i64) -> i64 {
    if bs_find(lv_moved, nid) >= 0 {
        return 1
    }
    return 0
}

// 清除单个变量的 moved 标记（重新赋值后变量恢复 live）。
// tie 表无法物理截断，直接重建表（每函数 moved 量极小，成本可忽略）。
pub func lv_moved_unmark(nid: i64) {
    var idx = bs_find(lv_moved, nid)
    if idx < 0 {
        return
    }
    var rebuild = table_new_i64()
    var n = len(lv_moved)
    var j: i64 = 0
    while j < n {
        if lv_moved[j] != nid {
            table_push(rebuild, lv_moved[j])
        }
        j = j + 1
    }
    lv_moved = rebuild
}

// 快照当前 moved 状态（深拷贝独立表）。分支检查用：保存分支入口状态，
// 分支结束用 lv_moved_restore 恢复——分支内 return/赋值触发的移动标记
// **不泄漏到分支外**（分支互斥路径，如 `if m == 0 { return s }` 后 s 仍 live）。
// std/compiler 迁移关键：无分支敏感时此类合法模式被误报 use-of-moved。
pub func lv_moved_snap() -> table<i64> {
    var snap = table_new_i64()
    var n = len(lv_moved)
    var i: i64 = 0
    while i < n {
        table_push(snap, lv_moved[i])
        i = i + 1
    }
    return snap
}

// 恢复 moved 状态（深拷贝重建独立表，避免与快照共享底层数组）。
pub func lv_moved_restore(snap: table<i64>) {
    var rebuild = table_new_i64()
    var n = len(snap)
    var j: i64 = 0
    while j < n {
        table_push(rebuild, snap[j])
        j = j + 1
    }
    lv_moved = rebuild
}

// 有序插入 keys（返回插入位置），vals 并行同步插入
pub func sorted_insert(keys: table<i64>, vals: table<i64>, k: i64, v: i64) -> i64 {
    var n = len(keys)
    var lo: i64 = 0
    var hi: i64 = n - 1
    var pos: i64 = n
    while lo <= hi {
        var mid = (lo + hi) / 2
        if keys[mid] < k {
            lo = mid + 1
        } else {
            pos = mid
            hi = mid - 1
        }
    }
    table_push(keys, 0)
    table_push(vals, 0)
    var i: i64 = n
    while i > pos {
        keys[i] = keys[i - 1]
        vals[i] = vals[i - 1]
        i = i - 1
    }
    keys[pos] = k
    vals[pos] = v
    return pos
}

// 函数表三列有序插入（keys/vals/nodes 并行同步移位；reg_fn 专用）。
// 返回插入位置。
pub func sorted_insert_fn(keys: table<i64>, vals: table<i64>, nodes: table<i64>, k: i64, v: i64, nd: i64) -> i64 {
    var n = len(keys)
    var lo: i64 = 0
    var hi: i64 = n - 1
    var pos: i64 = n
    while lo <= hi {
        var mid = (lo + hi) / 2
        if keys[mid] < k {
            lo = mid + 1
        } else {
            pos = mid
            hi = mid - 1
        }
    }
    table_push(keys, 0)
    table_push(vals, 0)
    table_push(nodes, 0)
    var i: i64 = n
    while i > pos {
        keys[i] = keys[i - 1]
        vals[i] = vals[i - 1]
        nodes[i] = nodes[i - 1]
        i = i - 1
    }
    keys[pos] = k
    vals[pos] = v
    nodes[pos] = nd
    return pos
}

// 全局变量四列有序插入（返回插入位置）：keys/vals/cons/telems 并行同步移位。
// 全局变量收集顺序与 intern id 顺序不一致（import 文件全局先收集、主文件
// 全局后收集但 nid 更小），故 sorted_insert 可能中间插入——若 const/telem
// 仅 table_push 末尾追加会与 keys/vals 错位（读错行的 const/元素类型）。
// 参照 sinfer.lv_add 的五列同步移位模式，四列同位置插入。
pub func sorted_insert_gb(keys: table<i64>, vals: table<i64>, cons: table<i64>, telems: table<i64>, k: i64, v: i64, c: i64, e: i64) -> i64 {
    var n = len(keys)
    var lo: i64 = 0
    var hi: i64 = n - 1
    var pos: i64 = n
    while lo <= hi {
        var mid = (lo + hi) / 2
        if keys[mid] < k {
            lo = mid + 1
        } else {
            pos = mid
            hi = mid - 1
        }
    }
    table_push(keys, 0)
    table_push(vals, 0)
    table_push(cons, 0)
    table_push(telems, 0)
    var i: i64 = n
    while i > pos {
        keys[i] = keys[i - 1]
        vals[i] = vals[i - 1]
        cons[i] = cons[i - 1]
        telems[i] = telems[i - 1]
        i = i - 1
    }
    keys[pos] = k
    vals[pos] = v
    cons[pos] = c
    telems[pos] = e
    return pos
}

// 函数签名登记（重复定义检查，返回签名 id 或 -1）。
// def_node：函数定义 AST 节点 id（fn_def_nodes 平行登记，check_fn_walk 查表用）。
pub func reg_fn(full_name: string, is_pub: i64, nparams: i64, required: i64, ret_ty: i64, p_tys: table<i64>, p_refs: table<i64>, p_defs: table<i64>, p_vars: table<i64>, def_node: i64) -> i64 {
    var nid = intern.intern(full_name)
    if bs_find(fn_keys, nid) >= 0 {
        sm_err_line = 1
        sm_err_col = 1
        // 命名空间函数 vs 顶层函数措辞（对齐 Rust）：A::f → 函数 'f' 在命名空间 'A' 内重复定义
        var last = rfind_ns(full_name)
        if last >= 0 {
            var bare = str.slice(full_name, last + 2, str_len(full_name))
            var prefix = str.slice(full_name, 0, last)
            sm_err_msg = "函数 '" + bare + "' 在命名空间 '" + prefix + "' 中重复定义"
        } else {
            sm_err_msg = "函数 '" + full_name + "' 重复定义"
        }
        return -1
    }
    var sig = len(sg_nparams)
    var off = len(sp_tys)
    table_push(sg_nparams, nparams)
    table_push(sg_required, required)
    table_push(sg_ret, ret_ty)
    table_push(sg_pub, is_pub)
    table_push(sg_off, off)
    var i: i64 = 0
    while i < nparams {
        table_push(sp_tys, p_tys[i])
        table_push(sp_refs, p_refs[i])
        table_push(sp_defs, p_defs[i])
        table_push(sp_vars, p_vars[i])
        i = i + 1
    }
    sorted_insert_fn(fn_keys, fn_vals, fn_def_nodes, nid, sig, def_node)
    return sig
}

// 查函数定义 AST 节点 id（未定义 -1）。check_fn_walk 的 O(log n) 快路径。
pub func fn_def_node(full_name: string) -> i64 {
    var nid = intern.intern(full_name)
    var idx = bs_find(fn_keys, nid)
    if idx < 0 {
        return -1
    }
    return fn_def_nodes[idx]
}

// 查函数签名 id（未定义返回 -1）
pub func fn_sig(full_name: string) -> i64 {
    var nid = intern.intern(full_name)
    var idx = bs_find(fn_keys, nid)
    if idx < 0 {
        return -1
    }
    return fn_vals[idx]
}

// 函数是否含变参（最后一个形参 sp_vars == 1）；nparams=0 或非变参 → 0
pub func fn_has_variadic(sig: i64) -> i64 {
    var n = sg_nparams[sig]
    if n <= 0 {
        return 0
    }
    return sp_vars[sg_off[sig] + n - 1]
}

// S1.2：函数是否 unsafe（签名标志位 bit1）。1 = unsafe fn（调用必须在
// unsafe 上下文，安全代码调用 = 编译错误）
pub func sig_unsafe(sig: i64) -> i64 {
    if sig < 0 {
        return 0
    }
    return (sg_pub[sig] >> 1) & 1
}

// struct 登记（重复/冲突检查，返回 struct 索引或 -1）
pub func reg_struct(name: string, parent: string) -> i64 {
    var nid = intern.intern(name)
    if bs_find(st_keys, nid) >= 0 {
        sm_err_msg = "struct '" + name + "' 重复定义"
        return -1
    }
    var idx = len(cls_parent)
    var p_nid: i64 = -1
    if parent != "" {
        p_nid = intern.intern(parent)
    }
    table_push(cls_parent, p_nid)
    table_push(cls_fldoff, len(fld_names))
    table_push(cls_nfld, 0)
    table_push(cls_done, 0)
    sorted_insert(st_keys, st_vals, nid, idx)
    // struct 名登记由上层（stype）经 types.set_struct_name 完成
    return idx
}

// enum 登记（重名检查，返回 enum 索引或 -1）。
// 入参为枚举名的 interner 池 id（升序二分键）。登记时只 push 变体信息
// 表的占位行（en_nvar/en_varoff/en_nslot/en_done），变体内容由
// scollect.collect_enum_variants 在 check 前统一填充（对齐 struct 两遍收集）。
pub func reg_enum(name_id: i64) -> i64 {
    if bs_find(en_keys, name_id) >= 0 {
        sm_err_msg = "枚举 '" + intern.lookup(name_id) + "' 重复定义"
        return -1
    }
    var idx = len(en_nvar)
    table_push(en_nvar, 0)
    table_push(en_varoff, len(en_vnames))
    table_push(en_nslot, 0)
    table_push(en_done, 0)
    sorted_insert(en_keys, en_vals, name_id, idx)
    // enum 名登记由上层（scollect）经 types.set_enum_name 完成
    return idx
}

// enum 索引 -> 名字（en_keys 按名字排序，须经 en_vals 反查索引位置）
pub func enum_name_of(idx: i64) -> string {
    var n = len(en_keys)
    var i: i64 = 0
    while i < n {
        if en_vals[i] == idx {
            return intern.lookup(en_keys[i])
        }
        i = i + 1
    }
    return "?"
}

// ==================== 泛型模板登记辅助（T3b 单态化展开器预置）====================

// 泛型模板索引查询（全名 -> 模板索引；-1 = 未登记）。
// 模板名与普通函数/struct 名分表存储：同一全名只可能在 gty_keys 或
// fn_keys/st_keys 之一（collect 阶段分派，重复定义在各自登记处报错）。
pub func gt_find(full_name: string) -> i64 {
    var nid = intern.intern(full_name)
    var idx = bs_find(gty_keys, nid)
    if idx < 0 {
        return -1
    }
    return gty_vals[idx]
}

// 泛型模板登记：node 的 children[0] 必为 N_TYPE_PARAMS（调用方已判定）。
// 提取类型参数名段（N_TYPE_PARAM 序列的 name 字段，扁平存入 gtyp_names）+
// 登记定义节点 id / 类别。重复定义返回 -1（sm_err_* 已置）；成功返回模板
// 索引。登记本身不检查模板体内 TypeVar 引用（T3b 单态化展开时处理）。
pub func reg_generic(full_name: string, node: i64, is_struct: i64) -> i64 {
    if gt_find(full_name) >= 0 {
        sm_err_line = s_lines[node]
        sm_err_col = s_cols[node]
        sm_err_msg = "泛型模板 '" + full_name + "' 重复定义"
        return -1
    }
    var tp = child(node, 0)  // N_TYPE_PARAMS 节点
    var npar = s_nchild[tp]
    var idx = len(gtyp_nparams)
    var off = len(gtyp_names)
    // S2.4 泛型约束：每个类型参数 1 槽（约束 port 名 id，-1 = 无约束）。
    // 约束来源：N_TYPE_PARAM.children[0]（parse_type_params 产出：约束类型
    // 节点 N_STRUCT_TYPE 的 name 字段，或 -1 哨兵）。合法性（必须是已登记
    // port）由 sgen.check_generic_constraints 在实例化时校验。
    var con_off = len(gtyp_cons)
    var i: i64 = 0
    while i < npar {
        var p = child(tp, i)  // N_TYPE_PARAM 节点（name = 类型参数名 id）
        table_push(gtyp_names, s_names[p])
        var cons: i64 = -1
        if s_nchild[p] > 0 {
            var cnode = child(p, 0)
            if cnode >= 0 {
                // 约束节点必须是标识符类型引用（N_STRUCT_TYPE，name = port 名）；
                // 其余类型（table<T> 等）不是合法 port 约束
                if s_tags[cnode] != S_N_STRUCT_TYPE {
                    sm_err_line = s_lines[p]
                    sm_err_col = s_cols[p]
                    sm_err_msg = "泛型约束必须是 port 类型（如 <T: Drawable>），实际是其他类型表达式"
                    return -1
                }
                cons = s_names[cnode]
            }
        }
        table_push(gtyp_cons, cons)
        i = i + 1
    }
    table_push(gtyp_nparams, npar)
    table_push(gtyp_off, off)
    table_push(gtyp_conoff, con_off)
    table_push(gty_node, node)
    table_push(gty_is_struct, is_struct)
    sorted_insert(gty_keys, gty_vals, intern.intern(full_name), idx)
    return idx
}

// ==================== S2.4 port / impl 登记辅助 ====================

// port 索引查询（port 名 -> 索引；-1 = 未登记）。
pub func port_find(name: string) -> i64 {
    var nid = intern.intern(name)
    var idx = bs_find(pt_keys, nid)
    if idx < 0 {
        return -1
    }
    return pt_vals[idx]
}

// port 登记（重名检查，返回 port 索引或 -1）。
// 同时登记 types 侧 port 名表（type_name 还原用；追加式与索引顺序一致）。
pub func reg_port(name: string) -> i64 {
    if port_find(name) >= 0 {
        sm_err_msg = "port '" + name + "' 重复定义"
        return -1
    }
    var idx = len(pm_off)
    table_push(pm_off, len(pm_names))
    table_push(pm_n, 0)
    table_push(pm_npar, len(pm_npars))
    table_push(pm_paroff, len(pm_ptys))
    table_push(pm_ret, len(pm_rets))
    sorted_insert(pt_keys, pt_vals, intern.intern(name), idx)
    types.set_port_name(idx, name)
    return idx
}

// actor 索引查询（actor 名 -> 索引；-1 = 未登记）。
pub func actor_find(name: string) -> i64 {
    var nid = intern.intern(name)
    var idx = bs_find(ac_keys, nid)
    if idx < 0 {
        return -1
    }
    return ac_vals[idx]
}

// actor 登记（重名检查，返回 actor 索引或 -1）。
// 同时登记 types 侧 actor 名表（type_name 还原用；追加式与索引顺序一致）。
pub func reg_actor(name: string) -> i64 {
    if actor_find(name) >= 0 {
        sm_err_msg = "actor '" + name + "' 重复定义"
        return -1
    }
    var idx = len(ac_vals)
    sorted_insert(ac_keys, ac_vals, intern.intern(name), idx)
    types.set_actor_name(idx, name)
    return idx
}

// port 方法登记（collect_port 用）：方法名 + 参数类型表（含 self 槽）+ 返回类型。
// 返回方法索引（声明顺序，vtable 字段序）；-1 错误（sm_err_* 已置）。
pub func reg_port_method(pi: i64, mname: string, ptys: table<i64>, ret: i64) -> i64 {
    var nid = intern.intern(mname)
    // 重名检查（port 内方法名唯一）
    var off = pm_off[pi]
    var n = pm_n[pi]
    var k: i64 = 0
    while k < n {
        if pm_names[off + k] == nid {
            sm_err_msg = "port '" + intern.lookup(pt_keys[pi]) + "' 的方法 '" + mname + "' 重复定义"
            return -1
        }
        k = k + 1
    }
    var mi = n
    table_push(pm_names, nid)
    table_push(pm_npars, len(ptys))
    var j: i64 = 0
    while j < len(ptys) {
        table_push(pm_ptys, ptys[j])
        j = j + 1
    }
    table_push(pm_rets, ret)
    pm_n[pi] = n + 1
    return mi
}

// port 方法索引查询（方法名 -> 声明序号；-1 = 无）
pub func port_method_idx(pi: i64, mname: string) -> i64 {
    var nid = intern.intern(mname)
    var off = pm_off[pi]
    var n = pm_n[pi]
    var k: i64 = 0
    while k < n {
        if pm_names[off + k] == nid {
            return k
        }
        k = k + 1
    }
    return -1
}

// port 方法名（第 mi 个；-1 越界兜底）
pub func port_method_name(pi: i64, mi: i64) -> string {
    if mi < 0 || mi >= pm_n[pi] {
        return ""
    }
    return intern.lookup(pm_names[pm_off[pi] + mi])
}

// port 方法参数个数（含 self）
pub func port_method_nparams(pi: i64, mi: i64) -> i64 {
    if mi < 0 || mi >= pm_n[pi] {
        return -1
    }
    return pm_npars[pm_npar[pi] + mi]
}

// port 方法第 k 个参数类型（k 从 0 = self；越界返回 -1）
pub func port_method_param(pi: i64, mi: i64, k: i64) -> i64 {
    var np = port_method_nparams(pi, mi)
    if k < 0 || k >= np {
        return -1
    }
    return pm_ptys[pm_paroff[pi] + mi * np + k]
}

// port 方法返回类型
pub func port_method_ret(pi: i64, mi: i64) -> i64 {
    if mi < 0 || mi >= pm_n[pi] {
        return -1
    }
    return pm_rets[pm_ret[pi] + mi]
}

// impl 键（port 名 + struct 名 -> 升序键）
pub func impl_key(port_name: string, struct_name: string) -> string {
    return port_name + "::" + struct_name
}

// impl 记录查询（port 索引 + struct 索引 -> impl 索引；-1 = 未实现）
pub func impl_find(pi: i64, si: i64) -> i64 {
    var pname = intern.lookup(pt_keys[pi])
    var sname = sstate.struct_name_of(si)
    var nid = intern.intern(impl_key(pname, sname))
    var idx = bs_find(im_keys, nid)
    if idx < 0 {
        return -1
    }
    return im_vals[idx]
}

// impl 登记（collect_impl 用）：port 索引 + struct 索引 + 方法实现全名表
// （按 port 方法声明顺序）。返回 impl 索引；-1 错误（sm_err_* 已置）。
pub func reg_impl(pi: i64, si: i64, mnames: table<i64>) -> i64 {
    var pname = intern.lookup(pt_keys[pi])
    var sname = sstate.struct_name_of(si)
    var key = intern.intern(impl_key(pname, sname))
    if bs_find(im_keys, key) >= 0 {
        sm_err_msg = "port '" + pname + "' 对 struct '" + sname + "' 的 impl 重复定义"
        return -1
    }
    var idx = len(im_port)
    table_push(im_port, pi)
    table_push(im_struct, si)
    table_push(im_poff, len(im_mnames))
    table_push(im_n, len(mnames))
    var k: i64 = 0
    while k < len(mnames) {
        table_push(im_mnames, mnames[k])
        k = k + 1
    }
    sorted_insert(im_keys, im_vals, key, idx)
    return idx
}

// ==================== 实例化记录辅助（T3b 单态化展开器）====================

// 实例化记录查询（mangled 名 -> 记录索引；-1 = 未实例化）。
// 去重键 = mangled 名（含类型实参片段），同名即同组合。
pub func gin_find(mangled: string) -> i64 {
    var nid = intern.intern(mangled)
    var idx = bs_find(gin_keys, nid)
    if idx < 0 {
        return -1
    }
    return gin_vals[idx]
}

// 实例化记录登记：mangled 名 + 模板索引 + 类型实参表（按模板类型参数顺序）
// + 类别。返回记录索引。调用方保证未重复（gin_find 已判定）。
pub func gin_reg(mangled: string, gti: i64, args: table<i64>, is_struct: i64) -> i64 {
    var rec = len(gin_tmpl)
    var off = len(garg_vals)
    var k: i64 = 0
    while k < len(args) {
        table_push(garg_vals, args[k])
        k = k + 1
    }
    table_push(gin_tmpl, gti)
    table_push(gin_off, off)
    table_push(gin_nargs, len(args))
    table_push(gin_is_struct, is_struct)
    sorted_insert(gin_keys, gin_vals, intern.intern(mangled), rec)
    return rec
}

// 第 rec 条记录的第 k 个类型实参 id（越界返回 -1）
pub func gin_arg_at(rec: i64, k: i64) -> i64 {
    if rec < 0 || rec >= len(gin_tmpl) {
        return -1
    }
    var n = gin_nargs[rec]
    if k < 0 || k >= n {
        return -1
    }
    return garg_vals[gin_off[rec] + k]
}

// 第 rec 条记录的类型实参表副本（推断/匹配用）
pub func gin_args(rec: i64) -> table<i64> {
    var out: table<i64> = table_new_i64()
    if rec < 0 || rec >= len(gin_tmpl) {
        return out
    }
    var n = gin_nargs[rec]
    var k: i64 = 0
    while k < n {
        table_push(out, garg_vals[gin_off[rec] + k])
        k = k + 1
    }
    return out
}

// 模板类型参数名 id 表（按声明顺序；返回新表）
pub func gt_param_names(gti: i64) -> table<i64> {
    var out: table<i64> = table_new_i64()
    if gti < 0 || gti >= len(gtyp_nparams) {
        return out
    }
    var n = gtyp_nparams[gti]
    var off = gtyp_off[gti]
    var k: i64 = 0
    while k < n {
        table_push(out, gtyp_names[off + k])
        k = k + 1
    }
    return out
}

// ==================== 命名空间栈 ====================
// 命名空间段压栈（游标写：复用已分配槽位，避免旧值残留误读）
pub func ns_push(seg_id: i64) {
    if ns_top < len(ns_stack) {
        ns_stack[ns_top] = seg_id
    } else {
        table_push(ns_stack, seg_id)
    }
    ns_top = ns_top + 1
}

// 命名空间段弹栈（游标递减）
pub func ns_pop() {
    if ns_top > 0 {
        ns_top = ns_top - 1
    }
}

// 命名空间全名拼接（ns_stack 段 + 名字）
pub func ns_full_name(name: string) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < ns_top {
        if i > 0 {
            out = out + "::"
        }
        out = out + intern.lookup(ns_stack[i])
        i = i + 1
    }
    if out != "" {
        out = out + "::"
    }
    return out + name
}

// struct 索引 -> 名字（st_keys 按名字排序，须经 st_vals 反查索引位置）
pub func struct_name_of(idx: i64) -> string {
    var n = len(st_keys)
    var i: i64 = 0
    while i < n {
        if st_vals[i] == idx {
            return intern.lookup(st_keys[i])
        }
        i = i + 1
    }
    return "?"
}

}
