type tie<class>
// compiler/frontend/pstmt_flow.tie — T2.5 parser 语句分派+控制流（再拆分）
// ============================================================
// 里程碑：自举 v2 计划 T2.5 完整 parser 再拆分（2026-08-11）：
// 原 pstmt.tie 拆出的「语句分派 parse_stmt + 块/if/while/for/标签/
// switch/return 控制流」部分。
// 依赖：./pstmt.tie（var 声明/表达式赋值，经其传递可达 pexpr/putil/ast）。
// 树式无环：由 pstmt_top.tie import。
import "./pstmt.tie"

namespace pstmt_flow {

pub func parse_stmt() -> i64 {
    var tag = putil.peek_tag()
    if tag == lex_var {
        return pstmt.parse_var_decl(0)
    }
    if tag == lex_const {
        return pstmt.parse_var_decl(1)
    }
    if tag == lex_if {
        return parse_if()
    }
    if tag == lex_while {
        return parse_while(-1)
    }
    if tag == lex_for {
        return parse_for(-1)
    }
    if tag == lex_switch {
        return parse_switch()
    }
    if tag == lex_return {
        return parse_return()
    }
    if tag == lex_break {
        return parse_loop_jump(false)
    }
    if tag == lex_continue {
        return parse_loop_jump(true)
    }
    if tag == lex_ident {
        if is_loop_label_ahead() {
            return parse_labeled_loop()
        }
        return pstmt.parse_expr_or_assign()
    }
    if tag == lex_lbrace {
        putil.set_err(putil.peek_line(), putil.peek_col(), "函数体内不能有裸代码块")
        return -1
    }
    if tag == lex_extern {
        putil.set_err(putil.peek_line(), putil.peek_col(), "extern 声明只能出现在文件顶层")
        return -1
    }
    if tag == lex_unsafe {
        // S1.2 U3：`unsafe { ... }` 局部逃逸块（块内可触底）
        // 三期 goto：`unsafe goto #x`（§7.1.5）——unsafe 后跟 goto 关键字
        // 是 goto 跳转语句（无条件 br），否则按 unsafe 块解析。
        // 三期 A 组（§7.1.1 + unsafe-model §13.4）：
        //   `unsafe use g { ... }` 持证越界块 / `unsafe with(share) { ... }`
        //   临时凭据块（unsafe 后跟 use/with 关键字）；
        //   `unsafe.get(share)` 是表达式（unsafe 后跟 . 或标识符调用），
        //   落回 parse_expr_or_assign（parse_primary 识别 N_GUARD_GET）。
        var nxt = putil.peek_n(1)
        if nxt == lex_goto {
            return parse_goto_stmt()
        }
        if nxt == lex_ident && putil.peek_lexeme_n(1) == "use" {
            return parse_guard_use()
        }
        if nxt == lex_ident && putil.peek_lexeme_n(1) == "with" {
            return parse_guard_with()
        }
        // `unsafe.get(share)` 表达式：unsafe 后跟 `.`（get 是方法名）
        if nxt == lex_dot {
            return pstmt.parse_expr_or_assign()
        }
        return parse_unsafe_block()
    }
    if tag == lex_hash {
        // 三期 goto：`#[tag.x]` 语句位置标签（§7.1.5）。`#[]` 紧跟声明
        // = 属性；紧跟语句 + `tag.` 前缀 = 跳转标签（与循环标签命名空间分离）。
        return parse_goto_label()
    }
    if tag == lex_panic {
        // S2.3：`panic(expr)` 不可恢复错误语句
        return parse_panic()
    }
    if tag == lex_func {
        // S3.3：准引用块内语句起始位置的 `func name() {...}` 按函数定义
        // 解析（宏生成函数，见 parse_fn_def_in_block）；普通函数体内 func
        // 保持闭包字面量语义（走 parse_expr_or_assign → 闭包）。
        if g_in_quasi_block != 0 {
            return parse_fn_def_in_block()
        }
        return pstmt.parse_expr_or_assign()
    }
    return pstmt.parse_expr_or_assign()
}

// S3.3 准引用块内函数定义：`func name(params) -> ret { body }`（宏生成函数）。
// 与顶层 parse_fn_def 同构的简化版（无 pub/unsafe/泛型/默认值参数）：
// name/参数名支持 `$` 插值名（expect_ident_quasi——gensym 结果作函数名），
// 产出 N_FN_DEF（name, val=0, aux=nparams, children=[泛型槽-1, 返回类型,
// 参数..., 函数体]——与顶层函数定义布局完全一致，展开后走正常语义检查）。
func parse_fn_def_in_block() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // func
    var name = putil.expect_ident_quasi()
    if name < 0 {
        return -1
    }
    if !putil.expect(lex_lparen, "'('") {
        return -1
    }
    var params: table<i64> = table_new_i64()
    if !putil.eat(lex_rparen) {
        var d = false
        while !d {
            var pname = putil.expect_ident_quasi()
            if pname < 0 {
                return -1
            }
            if !putil.expect(lex_colon, "':'") {
                return -1
            }
            var pty = pexpr_type.parse_type()
            if pty < 0 {
                return -1
            }
            var p = ast.new_node(N_PARAM, pname, 0, 0, putil.peek_line(), putil.peek_col())
            var pkids: table<i64> = table_new_i64()
            table_push(pkids, pty)
            table_push(pkids, -1)
            ast.set_children(p, pkids)
            table_push(params, p)
            if putil.eat(lex_comma) {
                // 继续
            } else {
                if !putil.expect(lex_rparen, "')'") {
                    return -1
                }
                d = true
            }
        }
    }
    var ret_ty = -1
    if putil.eat(lex_arrow) {
        ret_ty = pexpr_type.parse_type()
        if ret_ty < 0 {
            return -1
        }
    } else {
        ret_ty = ast.new_node(N_NAMED_TYPE, interner.intern("void"), 14, -1, line, col)
    }
    var body = parse_block()
    if body < 0 {
        return -1
    }
    var f = ast.new_node(N_FN_DEF, name, 0, len(params), line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, -1)   // 泛型槽（块内函数定义暂不支持泛型）
    table_push(kids, ret_ty)
    var i: i64 = 0
    while i < len(params) {
        table_push(kids, params[i])
        i = i + 1
    }
    table_push(kids, body)
    ast.set_children(f, kids)
    return f
}

// `panic(expr)`：S2.3 不可恢复错误（消息为 string 表达式；可配置目标行为——
// 桌面打印+退出 / 嵌入式 halt / wasm trap，语义层校验）。
func parse_panic() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // panic
    if !putil.expect(lex_lparen, "'('") {
        return -1
    }
    var msg = pexpr.parse_expr()
    if msg < 0 {
        return -1
    }
    if !putil.expect(lex_rparen, "')'") {
        return -1
    }
    if !putil.expect(lex_semi, "语句结束符") {
        return -1
    }
    var n = ast.new_node(N_PANIC, -1, -1, -1, line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, msg)
    ast.set_children(n, kids)
    return n
}

// unsafe 块：`unsafe { stmts }` → N_UNSAFE_BLOCK（children=[StmtList 或直接语句]）。
// 与普通块同结构（N_STMTLIST 包装体），语义层按节点标记开启 unsafe 上下文。
func parse_unsafe_block() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // unsafe
    if !putil.expect(lex_lbrace, "'{'") {
        return -1
    }
    var stmts: table<i64> = table_new_i64()
    var done = false
    while !done {
        if putil.peek_tag() == lex_rbrace {
            putil.advance()
            done = true
        } else if putil.peek_tag() == lex_eof {
            if !putil.expect(lex_rbrace, "'}'") {
                return -1
            }
            done = true
        } else {
            var s = parse_stmt()
            if s < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s)
        }
    }
    var n = ast.new_node(N_UNSAFE_BLOCK, -1, -1, -1, line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, ast.new_node(N_STMTLIST, -1, -1, -1, line, col))
    ast.set_children(n, kids)
    ast.set_children(ast.child_at(n, 0), stmts)
    return n
}

// 三期 goto（§7.1.5）：`unsafe goto #x` 无条件跳转语句（仅 unsafe 上下文）。
// 解析：`unsafe`（已由 parse_stmt 探测，此处直接消费）→ `goto` → `#` → 标签名
// → 分号。产出 N_GOTO[name=目标标签名池 id]。`#` 前缀区分循环标签 `标识符:`。
func parse_goto_stmt() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // unsafe
    putil.advance()   // goto
    if !putil.expect(lex_hash, "'#'") {
        return -1
    }
    var tname = putil.expect_ident()
    if tname < 0 {
        return -1
    }
    if !putil.expect(lex_semi, "语句结束符") {
        return -1
    }
    return ast.new_node(N_GOTO, tname, -1, -1, line, col)
}

// 三期 goto 标签（§7.1.5）：`#[tag.x]` 语句位置标签（标定一条语句前为跳转点）。
// 解析：`#[` → `tag` 段 → `.` → 标签名 → `]`。`#[]` 紧跟声明 = 属性；紧跟语句
// + `tag.` 前缀 = 跳转标签。产出 N_GOTO_LABEL[name=标签名池 id]。
// ASI 可能补分号（`]` 行尾补 `;`），标签后无分号语义，吃掉补充分号。
func parse_goto_label() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // #
    if !putil.expect(lex_lbracket, "'['") {
        return -1
    }
    // 属性名段：必须是 `tag`（标识符或关键字 token 均可读 lexeme）
    if interner.lookup(putil.expect_ident()) != "tag" {
        putil.set_err(line, col, "标签必须是 #[tag.名称] 形式（tag. 前缀区分 goto 标签与属性）")
        return -1
    }
    if !putil.expect(lex_dot, "'.'") {
        return -1
    }
    var tname = putil.expect_ident()
    if tname < 0 {
        return -1
    }
    if !putil.expect(lex_rbracket, "']'") {
        return -1
    }
    putil.eat(lex_semi)   // 吃掉 ASI 补分号（标签本身无分号语义）
    return ast.new_node(N_GOTO_LABEL, tname, -1, -1, line, col)
}

// 三期 A 组 `unsafe use g { ... }` 持证越界块（§7.1.1 + unsafe-model §13.4）：
// unsafe → use → 凭据变量名（guard<cap> 变量）→ { stmts }。块内以凭据身份开启
// 对应能力域（语义层校验 g 的类型与块内持证越界）。产出 N_GUARD_USE[name=凭据
// 变量名池 id, children=[块 StmtList]]。
func parse_guard_use() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // unsafe
    putil.advance()   // use
    var gname = putil.expect_ident()
    if gname < 0 {
        return -1
    }
    var body = parse_block()
    if body < 0 {
        return -1
    }
    var n = ast.new_node(N_GUARD_USE, gname, -1, -1, line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, body)
    ast.set_children(n, kids)
    return n
}

// 三期 A 组 `unsafe with(share) { ... }` 临时凭据块（§7.1.1 + unsafe-model §13.4）：
// unsafe → with → ( 能力域名 ) → { stmts }。块内创建临时 guard<cap> 凭据，退块
// 自动回收。产出 N_GUARD_WITH[children=[能力域名节点, 块 StmtList]]。
func parse_guard_with() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // unsafe
    putil.advance()   // with
    if !putil.expect(lex_lparen, "'('") {
        return -1
    }
    var cap = putil.expect_ident()
    if cap < 0 {
        return -1
    }
    if !putil.expect(lex_rparen, "')'") {
        return -1
    }
    var body = parse_block()
    if body < 0 {
        return -1
    }
    var n = ast.new_node(N_GUARD_WITH, -1, -1, -1, line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, ast.new_node(N_NAMED_TYPE, cap, -1, -1, line, col))
    table_push(kids, body)
    ast.set_children(n, kids)
    return n
}

// ---------- 顶层 import / using / namespace / extern ----------

// import 语句：`import "./x.tie"` 或 `import "./x.tie" as 别名`
pub func parse_block() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    if !putil.expect(lex_lbrace, "'{'") {
        return -1
    }
    var stmts: table<i64> = table_new_i64()
    var done = false
    while !done {
        if putil.peek_tag() == lex_rbrace {
            putil.advance()
            done = true
        } else if putil.peek_tag() == lex_eof {
            if !putil.expect(lex_rbrace, "'}'") {
                return -1
            }
            done = true
        } else {
            var s = parse_stmt()
            if s < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s)
        }
    }
    var list = ast.new_node(N_STMTLIST, -1, -1, -1, line, col)
    ast.set_children(list, stmts)
    return list
}

// ---------- S2.2 延迟闭包函数体回填 ----------

// 回填延迟闭包函数体：parse_primary 解析闭包字面量（func(x: i64) -> i64 {
// ... }）时只解析头部，函数体 token 流被配平跳过并登记快照（pexpr 在
// import 树底层无法调用本模块的语句解析——成环）。整份文件解析完后
// （parse_program 末尾）调用本函数：逐闭包恢复快照 → parse_block 解析
// 函数体 → 追加到 N_FN_LIT 的 children 末尾（布局与 N_FN_DEF 一致）。
// 嵌套闭包：外层闭包函数体内若再有闭包字面量，parse_block 解析时会再次
// 登记到延迟表队尾——循环条件用动态 defer_closure_count()，外层回填后
// 内层自动继续处理。注意从 g_defer_done 游标起处理，仅回填本轮新增闭包：
// parse_deferred_all 外层 while 会反复调用本函数，若不记游标则会重复 parse
// 已回填的闭包体，把其内层闭包二次登记 → count 无限增长死循环（内存爆炸）。
pub func parse_deferred_closures() -> i64 {
    var i: i64 = g_defer_done
    while i < putil.defer_closure_count() {
        var node = putil.defer_closure_node_at(i)
        putil.defer_closure_restore(i)
        var body = parse_block()
        if body < 0 {
            return -1
        }
        // 追加函数体：读旧 children（泛型槽、返回类型、参数...）重建
        var n = ast.child_count(node)
        var kids: table<i64> = table_new_i64()
        var k: i64 = 0
        while k < n {
            table_push(kids, ast.child_at(node, k))
            k = k + 1
        }
        table_push(kids, body)
        ast.set_children(node, kids)
        i = i + 1
        g_defer_done = i   // 游标推进：本轮已回填到 i，外层循环重复调用时从 i 继续
    }
    return 0
}

// ---------- S3.3 延迟准引用块体回填 ----------

// 回填延迟准引用块体：parse_primary 解析 `` `{ stmts } `` 时只登记
// N_CODE_LIT 节点 + 块体 token 流快照（pexpr 在 import 树底层无法调用
// 本模块的语句解析——成环，与 S2.2 闭包同款）。整份文件解析完后由
// pstmt_top.parse_deferred_all 调用本函数：逐块恢复快照 → parse_block
// 解析块体 → 回填到 N_CODE_LIT 的 children[0]（块形式子 AST = StmtList）。
// 嵌套：外层准引用块体内若再有准引用块，parse_block 解析时会再次登记到
// 延迟表队尾——循环条件用动态 defer_code_count()，外层回填后内层自动继续。
// 与闭包同款游标 g_defer_code_done：仅回填本轮新增，避免 parse_deferred_all
// 外层循环重复 parse 已回填块体导致二次登记死循环。
pub func parse_deferred_code_blocks() -> i64 {
    var i: i64 = g_defer_code_done
    while i < putil.defer_code_count() {
        var node = putil.defer_code_node_at(i)
        putil.defer_code_restore(i)
        var body = parse_block()
        if body < 0 {
            return -1
        }
        // 块体解析完成：退出准引用块上下文（函数定义解析仅块内生效）
        g_in_quasi_block = 0
        // 回填块体：N_CODE_LIT 块形式 children = [StmtList]（占位 -1 被替换）
        var kids: table<i64> = table_new_i64()
        table_push(kids, body)
        ast.set_children(node, kids)
        i = i + 1
        g_defer_code_done = i   // 游标推进
    }
    return 0
}

// `if cond { } else { }` / else if 链
func parse_if() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // if
    var cond = pexpr.parse_expr()
    if cond < 0 {
        return -1
    }
    var then_list = parse_block()
    if then_list < 0 {
        return -1
    }
    var else_list = -1
    if putil.eat(lex_else) {
        if putil.peek_tag() == lex_if {
            var inner = parse_if()
            if inner < 0 {
                return -1
            }
            var tmp: table<i64> = table_new_i64()
            table_push(tmp, inner)
            else_list = ast.new_node(N_STMTLIST, -1, -1, -1, line, col)
            ast.set_children(else_list, tmp)
        } else {
            else_list = parse_block()
            if else_list < 0 {
                return -1
            }
        }
    } else {
        else_list = ast.new_node(N_STMTLIST, -1, -1, -1, line, col)
    }
    var n = ast.new_node(N_IF, -1, -1, -1, line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, cond)
    table_push(kids, then_list)
    table_push(kids, else_list)
    ast.set_children(n, kids)
    return n
}

// `while cond { }`（label 为循环标签，E5）
func parse_while(label: i64) -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // while
    var cond = pexpr.parse_expr()
    if cond < 0 {
        return -1
    }
    var body = parse_block()
    if body < 0 {
        return -1
    }
    var n = ast.new_node(N_WHILE, label, -1, -1, line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, cond)
    table_push(kids, body)
    ast.set_children(n, kids)
    return n
}

// `for var in expr { }`（label 为循环标签，E5）
func parse_for(label: i64) -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // for
    var var_id = putil.expect_ident()
    if var_id < 0 {
        return -1
    }
    if !putil.expect(lex_in, "'in'") {
        return -1
    }
    var iter = pexpr.parse_expr()
    if iter < 0 {
        return -1
    }
    var body = parse_block()
    if body < 0 {
        return -1
    }
    var n = ast.new_node(N_FOR, var_id, -1, label, line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, iter)
    table_push(kids, body)
    ast.set_children(n, kids)
    return n
}

// 探测「循环标签前缀」：当前标识符 + 冒号 + while/for（E5）
func is_loop_label_ahead() -> bool {
    if putil.peek_tag() != lex_ident {
        return false
    }
    if putil.peek_n(1) != lex_colon {
        return false
    }
    var n2 = putil.peek_n(2)
    if n2 == lex_while {
        return true
    }
    if n2 == lex_for {
        return true
    }
    return false
}

// `L: while/for` 带标签循环（E5）
func parse_labeled_loop() -> i64 {
    var label = putil.expect_ident()
    if label < 0 {
        return -1
    }
    putil.advance()   // 冒号
    var tag = putil.peek_tag()
    if tag == lex_while {
        return parse_while(label)
    }
    if tag == lex_for {
        return parse_for(label)
    }
    putil.set_err(putil.peek_line(), putil.peek_col(), "标签 '" + interner.lookup(label) + "' 后必须是 while 或 for")
    return -1
}

// `break` / `continue`（可选标签 break L / continue L，E1+E5）
func parse_loop_jump(is_continue: bool) -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // break / continue
    var label = -1
    if putil.peek_tag() == lex_ident {
        var n1 = putil.peek_n(1)
        if n1 == lex_semi {
            label = interner.intern(putil.peek_lexeme())
            putil.advance()
        } else if n1 == lex_eof {
            label = interner.intern(putil.peek_lexeme())
            putil.advance()
        } else if n1 == lex_rbrace {
            label = interner.intern(putil.peek_lexeme())
            putil.advance()
        }
    }
    if !putil.expect(lex_semi, "语句结束符") {
        return -1
    }
    if is_continue {
        return ast.new_node(N_CONTINUE, label, -1, -1, line, col)
    }
    return ast.new_node(N_BREAK, label, -1, -1, line, col)
}

// `switch subject { case ...: ... default: ... }`
func parse_switch() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // switch
    var subject = pexpr.parse_expr()
    if subject < 0 {
        return -1
    }
    if !putil.expect(lex_lbrace, "'{'") {
        return -1
    }
    var cases: table<i64> = table_new_i64()
    var default_list = -1
    var done = false
    while !done {
        var tag = putil.peek_tag()
        if tag == lex_case {
            var cl = putil.peek_line()
            var cc = putil.peek_col()
            putil.advance()   // case
            var pats: table<i64> = table_new_i64()
            var p = parse_case_pattern()
            if p < 0 {
                return -1
            }
            table_push(pats, p)
            while putil.eat(lex_comma) {
                p = parse_case_pattern()
                if p < 0 {
                    return -1
                }
                table_push(pats, p)
            }
            var when_expr = -1
            if putil.eat(lex_when) {
                when_expr = pexpr.parse_expr()
                if when_expr < 0 {
                    return -1
                }
            }
            if !putil.expect(lex_colon, "':'") {
                return -1
            }
            var body = parse_switch_body()
            if body < 0 {
                return -1
            }
            var c = ast.new_node(N_SWITCH_CASE, -1, -1, -1, cl, cc)
            var pl = ast.new_node(N_PATTERN_LIST, -1, -1, -1, cl, cc)
            ast.set_children(pl, pats)
            var ckids: table<i64> = table_new_i64()
            table_push(ckids, pl)
            table_push(ckids, when_expr)
            table_push(ckids, body)
            ast.set_children(c, ckids)
            table_push(cases, c)
        } else if tag == lex_default {
            putil.advance()   // default
            if !putil.expect(lex_colon, "':'") {
                return -1
            }
            default_list = parse_switch_body()
            if default_list < 0 {
                return -1
            }
        } else if tag == lex_rbrace {
            putil.advance()
            done = true
        } else if tag == lex_eof {
            if !putil.expect(lex_rbrace, "'}'") {
                return -1
            }
            done = true
        } else {
            putil.set_err(putil.peek_line(), putil.peek_col(), "switch 体内只允许 case/default/右花括号，实际是 " + putil.describe(tag))
            return -1
        }
    }
    if default_list < 0 {
        default_list = ast.new_node(N_STMTLIST, -1, -1, -1, line, col)
    }
    var n = ast.new_node(N_SWITCH, -1, -1, len(cases), line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, subject)
    var i: i64 = 0
    while i < len(cases) {
        table_push(kids, cases[i])
        i = i + 1
    }
    table_push(kids, default_list)
    ast.set_children(n, kids)
    return n
}

// case/default 分支体：连续语句直到下一个 case/default/右花括号/文件结束
func parse_switch_body() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    var stmts: table<i64> = table_new_i64()
    var done = false
    while !done {
        var tag = putil.peek_tag()
        if tag == lex_case {
            done = true
        } else if tag == lex_default {
            done = true
        } else if tag == lex_rbrace {
            done = true
        } else if tag == lex_eof {
            done = true
        } else {
            var s = parse_stmt()
            if s < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s)
        }
    }
    var list = ast.new_node(N_STMTLIST, -1, -1, -1, line, col)
    ast.set_children(list, stmts)
    return list
}

// case 匹配模式：类型匹配（case string:）或值/区间表达式；
// 批次 7：枚举变体 payload 解构 `[Ident | A.B] "(" Ident ")"` → N_CASE_BIND
func parse_case_pattern() -> i64 {
    if putil.peek_tag() == lex_typekw {
        var line = putil.peek_line()
        var col = putil.peek_col()
        var lid = interner.intern(putil.peek_lexeme())
        var tk = putil.typekw_index(putil.peek_lexeme())
        putil.advance()
        var t = ast.new_node(N_NAMED_TYPE, lid, tk, -1, line, col)
        var tl = ast.new_node(N_TYPE_LIT, -1, -1, -1, line, col)
        var kids: table<i64> = table_new_i64()
        table_push(kids, t)
        ast.set_children(tl, kids)
        return tl
    }
    // 枚举变体绑定模式（仅 Ident 起始才尝试；save/restore 支持回退到普通表达式）
    if putil.peek_tag() == lex_ident {
        var line = putil.peek_line()
        var col = putil.peek_col()
        putil.save_pos()
        var vr = parse_case_variant_ref(line, col)
        if vr >= 0 && putil.peek_tag() == lex_lparen {
            putil.advance()  // '('
            if putil.peek_tag() == lex_ident {
                var bind_name = interner.intern(putil.peek_lexeme())
                putil.advance()
                if putil.expect(lex_rparen, "')'") {
                    var n = ast.new_node(N_CASE_BIND, -1, -1, -1, line, col)
                    var kids: table<i64> = table_new_i64()
                    table_push(kids, vr)
                    table_push(kids, bind_name)
                    ast.set_children(n, kids)
                    return n
                }
            }
        }
        putil.restore_pos()
    }
    return pexpr.parse_expr()
}

// 枚举变体引用链：Ident(.Ident)* → N_VAR / N_FIELD_ACCESS（case pattern 专用；
// 解析失败不消费（调用方 restore_pos 回退））
func parse_case_variant_ref(line: i64, col: i64) -> i64 {
    if putil.peek_tag() != lex_ident {
        return -1
    }
    var nm = interner.intern(putil.peek_lexeme())
    putil.advance()
    var expr = ast.new_node(N_VAR, nm, -1, -1, line, col)
    while putil.peek_tag() == lex_dot {
        putil.advance()
        if putil.peek_tag() != lex_ident {
            return -1
        }
        var field = interner.intern(putil.peek_lexeme())
        putil.advance()
        var fa = ast.new_node(N_FIELD_ACCESS, field, -1, -1, line, col)
        var fkids: table<i64> = table_new_i64()
        table_push(fkids, expr)
        ast.set_children(fa, fkids)
        expr = fa
    }
    return expr
}

// `return [expr]`
func parse_return() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // return
    var expr = -1
    if putil.peek_tag() != lex_semi {
        expr = pexpr.parse_expr()
        if expr < 0 {
            return -1
        }
    }
    if !putil.expect(lex_semi, "语句结束符") {
        return -1
    }
    var n = ast.new_node(N_RETURN, -1, -1, -1, line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, expr)
    ast.set_children(n, kids)
    return n
}

// `var name[: Ty] [= expr]` / `const ...`（解构返回 StmtList）

}
