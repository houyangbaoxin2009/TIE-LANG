type tie<class>
// compiler/frontend/parser.tie —— 自举 v2 T2.5：完整语法分析器（模块拆分后主入口）
// ============================================================
// 里程碑：自举 v2 计划 T2.5（.omo/plans/self-hosting-v2.md）。由 T1.2 原型
// compiler/proto/parser.tie 升版（6/6 文件 AST 与 Rust 一致），行为基准
// Rust crates/tie-frontend/src/parser.rs（语法错误消息逐字对齐）。
// # 模块拆分（2026-08-11）：原 2877 行单文件按「无环 import 树」拆为 4 模块——
//   pst.tie（全局状态）/ putil.tie（token 流/工具/describe）/
//   pexpr.tie（表达式/类型解析）/ pstmt.tie（语句解析）/
//   本文件（parse 主入口 + 协议输出 + parse_debug）。
//   本文件只 import ./pstmt.tie，其余经树传递可达（唯一路径防重复定义）。
// # 相比原型改造：
//   - 节点池复用 ast.tie（T2.1，删除 proto 自带 9 表）；
//   - token 流由「协议文本 re-parse」改为 putil.fill_pending 直接消费
//     lexer 列式表（T2.4 正式版）；
//   - 语法错误消息统一走 errors.tie syn_*（对齐 Rust parser.rs）。
// # 协议（parse 返回值，T2.6 语义单遍将消费）：
//   首行 <N>:（N = 节点总数）
//   之后每行：<id> <tag> <name_id> <val> <aux> <line> <col> <nchild> <c1> <c2>...
//   语法错误：ERR:<line> <col> <message>（对齐 Rust「语法错误 @行:列: 消息」）。
import "./pstmt_top.tie"

namespace parser {

// ---------- 主入口 ----------

// 主入口：token 流 → AST 协议文本。
// 前提：lexer 列式 token 表已被 lexer.tokenize/run_lex 填充（parse_src 内部完成）。
// proto_text 仅用于调试透传（词法错误 ERR 原样返回）。
pub func parse(proto_text: string) -> string {
    if putil.has_prefix(proto_text, "ERR:") {
        return proto_text
    }
    ast.reset()
    g_pos = 0
    g_pending_idx = 0
    g_tmp = 0
    p_err_msg = ""
    putil.fill_pending()
    var root = pstmt_top.parse_program()
    if root < 0 {
        return putil.err_protocol()
    }
    var bp = build_protocol()
    return bp
}

// 便捷入口：源码字符串 → 词法 + 语法 → AST 协议文本（T2.6/验收程序用）
pub func parse_src(src: string) -> string {
    var ok = lexer.run_lex(src)
    if !ok {
        // 词法错误：直接读 lexer 的全局错误槽（词法失败时 token 表不可靠）
        return "ERR:" + to_string(g_err_line) + " " + to_string(g_err_col) + " " + g_err_msg
    }
    var pr = parse("")
    return pr
}

// 内存版便捷入口：源码字符串 → 词法 + 语法 → AST 节点池（保留在 ast 内存，
// 不产出协议文本；T5.3 消除 AST 文本协议往返的性能优化）。
// 返回 0 成功；-1 失败。失败时错误信息在错误槽位中：
//   - 词法错误：lexer 的 g_err_line/g_err_col/g_err_msg（run_lex 返回 false）
//   - 语法错误：putil 的 p_err_line/p_err_col/p_err_msg（parse_program 返回负）
// 错误协议文本统一用 ast_err_protocol() 组装（与 parse_src 返回格式一致）。
// 语义与 parse_src 完全等价：内部逻辑逐行对齐 parse_src → parse("") 的
// 语法分析主体（ast.reset + 游标重置 + fill_pending + parse_program），仅省略
// 末尾 build_protocol() 的文本序列化——AST 留在 ast 全局节点池，由
// semantic.copy_ast_tables / append_ast_mem 直接内存复制，省去大文件（3000+
// 节点）每次编译数千次 to_string/parse + 子串分配。
pub func parse_ast(src: string) -> i64 {
    var ok = lexer.run_lex(src)
    if !ok {
        // 词法错误：lexer 错误槽已置，直接返回 -1（与 parse_src 一致——
        // 词法失败时 token 表不可靠，不进入语法分析）
        return -1
    }
    // —— 以下与 parse("") 的主体完全一致（parse 对 "" 的 "ERR:" 前缀检查
    //   恒不命中，故省略该检查直接展开其内部逻辑）——
    ast.reset()
    g_pos = 0
    g_pending_idx = 0
    g_tmp = 0
    p_err_msg = ""
    putil.fill_pending()
    var root = pstmt_top.parse_program()
    if root < 0 {
        // 语法错误：putil 错误槽已置
        return -1
    }
    // 成功：AST 节点池保留在 ast 全局表内存中，不做 build_protocol 序列化
    return 0
}

// 组装最近一次 parse_ast 失败的错误协议文本：ERR:<line> <col> <msg>。
// 格式对齐 parse_src 的返回（词法错误 "ERR:line col msg" 直接拼 lexer 槽；
// 语法错误走 putil.err_protocol()，两者最终文本一致），供 driver.err_span 与
// semantic 的 import 展开错误消息复用。
// 词法/语法判定：parse_ast 走到语法阶段前 run_lex 必已成功——run_lex 每次
// 开头把 g_err_msg 清空，故 g_err_msg 非空 ⇔ 本次是词法错误；
// 语法错误时 g_err_msg 必为 ""，此时读取 putil 语法错误槽。
pub func ast_err_protocol() -> string {
    if lexer.lex_err_msg() != "" {
        // 词法错误：直接拼 lexer 的 g_err_* 槽（对齐 parse_src 的词法分支）
        return "ERR:" + to_string(lexer.lex_err_line()) + " " +
            to_string(lexer.lex_err_col()) + " " + lexer.lex_err_msg()
    }
    // 语法错误：putil.err_protocol() 组装 p_err_* 槽
    return putil.err_protocol()
}

// 可读 AST 树形输出（缩进展示 tag 名 + lexeme + span + 顶层语句序列），供人工对比
pub func parse_debug(src: string) -> string {
    var ok = lexer.run_lex(src)
    if !ok {
        return "ERR:" + to_string(g_err_line) + " " + to_string(g_err_col) + " " + g_err_msg
    }
    ast.reset()
    g_pos = 0
    g_pending_idx = 0
    g_tmp = 0
    p_err_msg = ""
    putil.fill_pending()
    var root = pstmt_top.parse_program()
    if root < 0 {
        return putil.err_protocol()
    }
    var out: string = "共 " + to_string(ast.count()) + " 个节点，顶层 " +
        to_string(ast.child_count(root)) + " 条语句\n"
    out = out + "顶层语句 tag 序列: " + top_seq(root) + "\n"
    out = out + dump_node(root, 0) + "\n"
    return out
}

// ---------- 树形输出（parse_debug 用）----------

// 顶层语句 tag 序列（Rust --ast 顶层语句变体对照用）
func top_seq(root: i64) -> string {
    var s: string = ""
    var k: i64 = 0
    while k < ast.child_count(root) {
        var c = ast.child_at(root, k)
        s = s + pnames.node_tag_name(ast.tag(c))
        if k + 1 < ast.child_count(root) {
            s = s + " "
        }
        k = k + 1
    }
    return s
}

// 递归树形输出：节点文本 + 子节点缩进
func dump_node(id: i64, depth: i64) -> string {
    var indent: string = ""
    var d: i64 = 0
    while d < depth {
        indent = indent + "  "
        d = d + 1
    }
    var txt: string = indent + node_text(id)
    var k: i64 = 0
    while k < ast.child_count(id) {
        var c = ast.child_at(id, k)
        if c >= 0 {
            txt = txt + "\n" + dump_node(c, depth + 1)
        } else {
            txt = txt + "\n" + indent + "  -1(空)"
        }
        k = k + 1
    }
    return txt
}

// 节点单行文本：tag 名 + 名字 lexeme + 关键标量字段 + span
func node_text(id: i64) -> string {
    var tag = ast.tag(id)
    var s: string = pnames.node_tag_name(tag)
    var nm = ast.name(id)
    if nm >= 0 {
        s = s + " '" + interner.lookup(nm) + "'"
    }
    var v = ast.val(id)
    if tag == N_BINARY {
        s = s + " " + op_symbol(v, false)
    } else if tag == N_UNARY {
        s = s + " " + op_symbol(v, true)
    } else if tag == N_INT_LIT {
        s = s + " " + to_string(v)
    } else if tag == N_BOOL_LIT {
        s = s + " " + to_string(v)
    } else if tag == N_TRIT_LIT {
        s = s + " " + to_string(v)
    } else if tag == N_ASSIGN {
        if v >= 0 {
            s = s + " " + op_symbol(v, false) + "="
        }
    } else if tag == N_FIELD_ASSIGN {
        if v >= 0 {
            s = s + " " + op_symbol(v, false) + "="
        }
    } else if tag == N_INDEX_ASSIGN {
        if v >= 0 {
            s = s + " " + op_symbol(v, false) + "="
        }
    } else if v >= 0 {
        s = s + " v=" + to_string(v)
    }
    s = s + " @" + to_string(ast.line(id)) + ":" + to_string(ast.col(id))
    return s
}

// 运算符编号 → 符号文本（parse_debug 展示用）
func op_symbol(op: i64, is_unary: bool) -> string {
    if is_unary {
        if op == 0 {
            return "-"
        }
        if op == 1 {
            return "!"
        }
        if op == 2 {
            return "++"
        }
        if op == 3 {
            return "--"
        }
        if op == 4 {
            return "++"
        }
        if op == 5 {
            return "--"
        }
        return "?" + to_string(op)
    }
    if op == 0 {
        return "+"
    }
    if op == 1 {
        return "-"
    }
    if op == 2 {
        return "*"
    }
    if op == 3 {
        return "/"
    }
    if op == 4 {
        return "%"
    }
    if op == 5 {
        return "=="
    }
    if op == 6 {
        return "!="
    }
    if op == 7 {
        return "<"
    }
    if op == 8 {
        return ">"
    }
    if op == 9 {
        return "<="
    }
    if op == 10 {
        return ">="
    }
    if op == 11 {
        return "&&"
    }
    if op == 12 {
        return "||"
    }
    if op == 13 {
        return "&"
    }
    if op == 14 {
        return "|"
    }
    if op == 15 {
        return "^"
    }
    if op == 16 {
        return "<<"
    }
    if op == 17 {
        return ">>"
    }
    return "?" + to_string(op)
}

// ---------- AST 协议输出 ----------

// 分治合并行表：把 lines 中的每一行两两配对拼接成一个大字符串。
// 算法思路与 backend/llvmgen.tie 的 join_lines 完全相同（此处独立实现，
// 不 import backend 模块，避免 frontend → backend 的反向依赖环）。
// 原理：每轮把相邻两行拼成一行，行数减半，直到只剩一行——共 log₂N 轮，
// 每轮拷贝总量 ≈ 最终文本大小，总拷贝量 O(total · log N)，每行只参与
// log N 次拼接。相比旧的逐行 `out = out + line` 追加（每次拼接都复制整个
// 已累积输出，总拷贝 O(total · N)，3000+ 节点的大文件产生数百 MB 字符搬运）
// 是数量级差异。
// 语义约定（保证与旧实现逐字节一致）：行表首元素是头行 "<N>:"（无换行），
// 其余元素是节点行（无换行）；合并时在相邻两行之间插入一个 "\n"，整个表
// 合并为一行后再补末尾一个 "\n"。最终文本 =
//   "<N>:\n" + "行0\n" + "行1\n" + ... + "行N-1\n"
// 与旧的 "头行带 \n、每行带 \n" 的逐行拼接结果完全相同。
// 边界：空表（N 节点为 0 时行表仍含头行，故不会命中）返回空串；
// 奇数个行时每轮末位落单的行原样带过，留到下一轮与邻居合并。
func merge_lines(lines: table<string>) -> string {
    var cur = lines
    var n = len(cur)
    if n == 0 {
        return ""
    }
    while n > 1 {
        // 本轮结果表：相邻两行两两合并，行数减半
        var nxt = table_new_string()
        var i: i64 = 0
        while i + 1 < n {
            // 相邻两行拼成一行，中间插入 "\n"（该换行即两行之间的行分隔符）
            table_push(nxt, cur[i] + "\n" + cur[i + 1])
            i = i + 2
        }
        // 奇数个行时，最后落单的一行不带换行直接带过，下一轮再与邻居合并
        if i < n {
            table_push(nxt, cur[i])
        }
        cur = nxt
        n = len(cur)
    }
    // 只剩一行：整表合并完毕（行间换行均已插入），末尾补上最后一个 "\n"
    return cur[0] + "\n"
}

// 组装 AST 协议文本：首行 <N>:（节点总数），随后每行一个节点
// <id> <tag> <name_id> <val> <aux> <line> <col> <nchild> <c1> <c2> ...
// 输出格式与旧实现完全一致：语义分析器 semantic.load_ast 按此协议解析，
// 任何格式变化都会导致全编译器崩溃，故逐行内容与行分隔符均保持不变。
func build_protocol() -> string {
    // 行表逐行收集：头行 + 每个节点行（均不含换行符，换行在 merge_lines
    // 分治合并时统一插入）。表元素共享句柄语义：merge_lines 内部对表句柄的
    // 重新赋值不会改动本函数持有的 lines，行内容（字符串句柄）也不会被修改。
    var lines: table<string> = table_new_string()
    table_push(lines, to_string(ast.count()) + ":")
    var i: i64 = 0
    while i < ast.count() {
        var line: string = to_string(i) + " " + to_string(ast.tag(i)) + " " +
            to_string(ast.name(i)) + " " + to_string(ast.val(i)) + " " +
            to_string(ast.aux(i)) + " " + to_string(ast.line(i)) + " " +
            to_string(ast.col(i)) + " " + to_string(ast.child_count(i))
        var k: i64 = 0
        while k < ast.child_count(i) {
            line = line + " " + to_string(ast.child_at(i, k))
            k = k + 1
        }
        table_push(lines, line)
        i = i + 1
    }
    // 一次性分治合并行表为完整协议文本（O(n log n)，代替 O(n²) 逐行追加）
    return merge_lines(lines)
}

}
