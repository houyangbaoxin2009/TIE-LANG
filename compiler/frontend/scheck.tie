type tie<class>
// compiler/frontend/scheck.tie —— T2.6 语句/函数检查（模块拆分）
// ============================================================
// 里程碑：自举 v2 计划 T2.6（.omo/plans/self-hosting-v2.md）完整语义分析
// 拆分为 8 模块之一（本文件 = 语句检查 + 函数体检查 + switch case 检查）。
// 对应 proto/semantic.tie 3007-3437（check_stmt/check_switch_case/check_block/
// check_var_decl）+ 3554-3597（check_fn）+ 3694-3768（check_fn_walk）逻辑搬移。
// 依赖：./sstate.tie（AST 全局 + 符号表 + 工具）+ ./stype.tie（类型匹配）+
// ./sinfer.tie（表达式推断）。树式无环：由 semantic.tie import。
import "./scollect.tie"

// switch case 值去重表（跨 case 检测重复；switch 分支检查时重置）
var g_case_seen: table<string>;

namespace scheck {

// 语句块检查（StmtList）
pub func check_block(blk: i64) -> i64 {
    var n = sstate.nchild(blk)
    var i: i64 = 0
    while i < n {
        var s = sstate.child(blk, i)
        var r = check_stmt(s)
        if r < 0 {
            return -1
        }
        i = i + 1
    }
    return 0
}

// 字面量节点 → 整数值（IntLit 取 val；CharLit 取 name 池 id 对应码点；
// Unary NEG + IntLit 取负值）。用于 switch case 区间的 start < end 比较
// （对齐 Rust literal_cmp/literal_value）。
func int_lit_val(n: i64) -> i64 {
    var tag = s_tags[n]
    if tag == S_N_INT_LIT {
        return s_vals[n]
    }
    if tag == S_N_CHAR_LIT {
        var lid = s_names[n]
        if lid >= 0 {
            var txt = intern.lookup(lid)
            if str_len(txt) >= 3 {
                // 引号剥掉后取第一个码点
                return char_code(str_char(txt, 1))
            }
        }
        return 0
    }
    if tag == S_N_UNARY {
        // 前缀负号 + 整数 → 取负值（case -1 等）
        var op = s_vals[n]
        var operand = sstate.child(n, 0)
        if op == 0 {
            var v = int_lit_val(operand)
            return 0 - v
        }
    }
    return 0
}

// 字面量 key（重复检测用）：int → "i:<val>"，char → "c:<code>"，str → "s:<lexeme>"，bool → "b:<0/1>"
func lit_key(n: i64) -> string {
    var tag = s_tags[n]
    if tag == S_N_INT_LIT {
        return "i:" + to_string(s_vals[n])
    }
    if tag == S_N_UNARY {
        // case -1：前缀负号 + 整数 → "i:-<val>"
        var op = s_vals[n]
        if op == 0 {
            var v = int_lit_val(n)
            return "i:" + to_string(v)
        }
    }
    if tag == S_N_CHAR_LIT {
        return "c:" + to_string(int_lit_val(n))
    }
    if tag == S_N_BOOL_LIT {
        return "b:" + to_string(s_vals[n])
    }
    if tag == S_N_STR_LIT {
        return "s:" + sstate.name_str(n)
    }
    return "?"
}

// case 值是否编译期字面量（对齐 Rust is_const_literal：整数/浮点/字符/布尔/字符串；
// 前缀负号 + 数字字面量也算——case -1 是 Unary NEG + IntLit）
func is_case_literal(n: i64) -> bool {
    var tag = s_tags[n]
    if tag == S_N_INT_LIT || tag == S_N_FLOAT_LIT || tag == S_N_CHAR_LIT || tag == S_N_BOOL_LIT || tag == S_N_STR_LIT {
        return true
    }
    if tag == S_N_UNARY {
        var op = s_vals[n]
        if op == 0 {
            var operand = sstate.child(n, 0)
            var otag = s_tags[operand]
            if otag == S_N_INT_LIT || otag == S_N_FLOAT_LIT {
                return true
            }
        }
    }
    return false
}

// switch case 检查
pub func check_switch_case(c: i64, subj_ty: i64) -> i64 {
    var plist = sstate.child(c, 0)
    var when_n = sstate.child(c, 1)
    var body = sstate.child(c, 2)
    // 枚举对象：case 值必须是该枚举的变体引用（EnumName.Variant），解析为
    // tag 常量走整数比较路径（与 subject 的 icmp 比较）；不调用 infer_expr
    // （payload 变体的裸引用在值语境会报"需要 payload 参数"）
    if types.kind(subj_ty) == K_ENUM {
        return check_enum_switch_case(c, subj_ty)
    }
    var np = sstate.nchild(plist)
    var i: i64 = 0
    while i < np {
        var p = sstate.child(plist, i)
        // 区间 pattern：通用 range 只允许整数，但 switch case 区间允许整数或字符
        if s_tags[p] == S_N_RANGE {
            var st = sinfer.infer_expr(sstate.child(p, 0))
            if st < 0 {
                return -1
            }
            var en = sinfer.infer_expr(sstate.child(p, 1))
            if en < 0 {
                return -1
            }
            var st_int = types.is_int(st)
            var en_int = types.is_int(en)
            var st_chr = st == TK_CHAR
            var en_chr = en == TK_CHAR
            if !((st_int && en_int) || (st_chr && en_chr)) {
                sm_err_line = s_lines[c]
                sm_err_col = s_cols[c]
                sm_err_msg = "case 区间两端必须是整数或字符字面量（浮点区间不支持）"
                return -1
            }
            // start < end（对齐 Rust：左闭右开，字符按码点比较）
            var stv = int_lit_val(sstate.child(p, 0))
            var env = int_lit_val(sstate.child(p, 1))
            if stv >= env {
                sm_err_line = s_lines[c]
                sm_err_col = s_cols[c]
                sm_err_msg = "case 区间必须 start < end（左闭右开）"
                return -1
            }
            if (st_chr && subj_ty != TK_CHAR) || (st_int && !types.is_int(subj_ty)) {
                sm_err_line = s_lines[c]
                sm_err_col = s_cols[c]
                sm_err_msg = "case 区间类型与 switch 对象类型 " + types.type_name(subj_ty) + " 不匹配"
                return -1
            }
            i = i + 1
            continue
        }
        // case 类型匹配 pattern（对齐 Rust）：仅宽类型/动态容器对象上有意义，
        // 当前 switch subject 限定静态类型 → 一律报错（须在 infer_expr 前拦截，
        // 因为 infer_expr 对 TypeLit 直接报通用错误）
        if s_tags[p] == S_N_TYPE_LIT {
            var tynode = sstate.child(p, 0)
            var tyname = types.type_name(sgen.parse_generic_type_node(tynode))
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "case 类型匹配（" + tyname + "）仅支持宽类型或动态容器对象，当前 switch 对象是静态类型 " + types.type_name(subj_ty)
            return -1
        }
        var pt = sinfer.infer_expr(p)
        if pt < 0 {
            return -1
        }
        // case 值必须是编译期字面量（对齐 Rust is_const_literal）
        if !is_case_literal(p) {
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "case 值必须是字面量（整数/浮点/字符/布尔/字符串）"
            return -1
        }
        if !stype.types_compatible(subj_ty, pt) && !stype.types_match(subj_ty, pt, p) {
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "case 值类型 " + types.type_name(pt) + " 与 switch 对象类型 " + types.type_name(subj_ty) + " 不匹配"
            return -1
        }
        // 重复 case 检测（对齐 Rust seen 表）
        var key = lit_key(p)
        var d: i64 = 0
        var dup: bool = false
        while d < len(g_case_seen) {
            if g_case_seen[d] == key {
                dup = true
                break
            }
            d = d + 1
        }
        if dup {
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "重复的 case 值 " + key
            return -1
        }
        table_push(g_case_seen, key)
        i = i + 1
    }
    if when_n >= 0 {
        var wt = sinfer.infer_expr(when_n)
        if wt < 0 {
            return -1
        }
        if !types.is_bool_like(wt) {
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "when 守卫必须是布尔表达式，实际是 " + types.type_name(wt)
            return -1
        }
    }
    var r = check_block(body)
    if r < 0 {
        return -1
    }
    return 0
}

// 枚举 switch 的 case 检查（subject 类型为 K_ENUM）。
// case 值必须是 `EnumName.Variant`（FieldAccess）且 EnumName 与 switch 对象
// 是同一个枚举——解析为变体 tag 常量（整数值，后端与 tag 提取比较）；
// 区间/类型匹配 pattern 不支持。when 守卫与 body 检查复用常规路径。
func check_enum_switch_case(c: i64, subj_ty: i64) -> i64 {
    var plist = sstate.child(c, 0)
    var when_n = sstate.child(c, 1)
    var body = sstate.child(c, 2)
    var ei = types.low(subj_ty)
    var ename = sstate.enum_name_of(ei)
    var np = sstate.nchild(plist)
    var i: i64 = 0
    while i < np {
        var p = sstate.child(plist, i)
        // 变体引用解析（FieldAccess：base = Var 枚举名，name = 变体名）
        if s_tags[p] != S_N_FIELD_ACCESS {
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "case 值必须是枚举变体引用（如 " + ename + ".Variant）"
            return -1
        }
        var base = sstate.child(p, 0)
        if s_tags[base] != S_N_VAR {
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "case 值必须是枚举变体引用（如 " + ename + ".Variant）"
            return -1
        }
        var bname = sstate.name_str(base)
        var eidx = sstate.bs_find(en_keys, intern.intern(bname))
        if eidx < 0 {
            // 泛型 enum 模板：switch 对象必须是对应模板的实例化
            //（如 subject 是 Option$i64，case 写 Option.Some）。
            // 通过 gin 记录反查：subject 的 mangled 名 → 记录 → 模板匹配。
            var gidx = sstate.gt_find(bname)
            if gidx < 0 || gty_is_struct[gidx] != 2 {
                sm_err_line = s_lines[c]
                sm_err_col = s_cols[c]
                sm_err_msg = "case 值 '" + bname + "' 与 switch 对象枚举类型 " + types.type_name(subj_ty) + " 不匹配"
                return -1
            }
            var rec = sstate.gin_find(sstate.enum_name_of(ei))
            if rec < 0 || gin_tmpl[rec] != gidx {
                sm_err_line = s_lines[c]
                sm_err_col = s_cols[c]
                sm_err_msg = "case 值 '" + bname + "' 与 switch 对象枚举类型 " + types.type_name(subj_ty) + " 不匹配（泛型 enum 实例）"
                return -1
            }
        } else if en_vals[eidx] != ei {
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "case 值 '" + bname + "' 与 switch 对象枚举类型 " + types.type_name(subj_ty) + " 不匹配"
            return -1
        }
        var vname = sstate.name_str(p)
        // 在变体段中找该变体（返回 tag 值 0..nvar-1）
        var varoff = en_varoff[ei]
        var nvar = en_nvar[ei]
        var tag: i64 = -1
        var k: i64 = 0
        while k < nvar {
            if intern.lookup(en_vnames[varoff + k]) == vname {
                tag = en_vtags[varoff + k]
                break
            }
            k = k + 1
        }
        if tag < 0 {
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "枚举 '" + ename + "' 没有变体 '" + vname + "'"
            return -1
        }
        // 重复 case 检测（tag 为去重键，对齐字面量 key 风格）
        var key = "e:" + ename + ":" + vname
        var d: i64 = 0
        var dup: bool = false
        while d < len(g_case_seen) {
            if g_case_seen[d] == key {
                dup = true
                break
            }
            d = d + 1
        }
        if dup {
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "重复的 case 值 " + key
            return -1
        }
        table_push(g_case_seen, key)
        i = i + 1
    }
    if when_n >= 0 {
        var wt = sinfer.infer_expr(when_n)
        if wt < 0 {
            return -1
        }
        if !types.is_bool_like(wt) {
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "when 守卫必须是布尔表达式，实际是 " + types.type_name(wt)
            return -1
        }
    }
    var r = check_block(body)
    if r < 0 {
        return -1
    }
    return 0
}

// 语句检查
pub func check_stmt(s: i64) -> i64 {
    var tag = s_tags[s]
    if tag == S_N_UNSAFE_BLOCK {
        // S1.2 U3：unsafe 块 → 块内开启 unsafe 上下文（+1 深度）
        var saved2 = g_unsafe_depth
        g_unsafe_depth = g_unsafe_depth + 1
        var blk2 = sstate.child(s, 0)
        var r2: i64 = 0
        if blk2 >= 0 {
            r2 = check_block(blk2)
        }
        g_unsafe_depth = saved2
        return r2
    }
    if tag == S_N_PANIC {
        // S2.3：panic("消息") —— 消息必须是 string 表达式（可配置目标行为：
        // 桌面打印+退出 / 嵌入式 halt / wasm trap，irgen 按 target 发射）
        var msg = sstate.child(s, 0)
        var mt = sinfer.infer_expr(msg)
        if mt < 0 {
            return -1
        }
        if !stype.types_match(types.named(TK_STR), mt, msg) {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "panic 消息必须是 string，实际是 " + types.type_name(mt)
            return -1
        }
        return 0
    }
    if tag == S_N_VAR_DECL {
        return check_var_decl(s)
    }
    if tag == S_N_EXPR_STMT {
        var e = sstate.child(s, 0)
        var t = sinfer.infer_expr(e)
        if t < 0 {
            return -1
        }
        return 0
    }
    if tag == S_N_ASSIGN {
        var nm = sstate.name_str(s)
        var nid = intern.intern(nm)
        var target_ty = sinfer.lv_find(nid)
        var is_global: bool = false
        if target_ty < 0 {
            target_ty = sinfer.gb_find(nid)
            if target_ty < 0 {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "赋值目标 '" + nm + "' 未声明"
                return -1
            }
            is_global = true
        }
        if is_global {
            if sinfer.gb_const_of(nid) == 1 {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "不能给 const 变量 '" + nm + "' 赋值"
                return -1
            }
        } else {
            if sinfer.lv_const_of(nid) == 1 {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "不能给 const 变量 '" + nm + "' 赋值"
                return -1
            }
        }
        var vt = sinfer.infer_expr(sstate.child(s, 0))
        if vt < 0 {
            // S2.3 目标类型引导：泛型 enum 构造（Result.Err("x")）类型参数推断不全
            // 时（Err 不含 T，T 无法从实参推出），用赋值目标类型补全
            var sv_l = sm_err_line
            var sv_c = sm_err_col
            var sv_m = sm_err_msg
            var hv = sinfer.try_enum_construct_hinted(sstate.child(s, 0), target_ty)
            if hv >= 0 {
                sm_err_line = 0
                sm_err_col = 0
                sm_err_msg = ""
                vt = hv
            } else {
                if sm_err_msg == sv_m {
                    // 引导未命中（非泛型 enum 构造）：恢复原错误
                    sm_err_line = sv_l
                    sm_err_col = sv_c
                    sm_err_msg = sv_m
                }
                return -1
            }
        }
        // 复合赋值校验（对齐 Rust check_compound_assign，M4）：op >= 0 为复合
        var op = s_vals[s]
        if op >= 0 {
            // `+=` 对 string：value 必须 string（拼接）
            if op == 0 && target_ty == TK_STR {
                if !stype.types_match(target_ty, vt, sstate.child(s, 0)) {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "复合赋值类型不匹配：目标类型 " + types.type_name(target_ty) + " 与表达式 " + types.type_name(vt)
                    return -1
                }
                return 0
            }
            // `+=` `-=` `*=` `/=`：target 必须 number
            if op >= 0 && op <= 3 {
                if !types.is_number(target_ty) {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "复合赋值运算符不能用于 " + types.type_name(target_ty)
                    return -1
                }
                if !stype.types_match(target_ty, vt, sstate.child(s, 0)) {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "复合赋值类型不匹配：目标类型 " + types.type_name(target_ty) + " 与表达式 " + types.type_name(vt)
                    return -1
                }
                return 0
            }
            // `%=`：target 必须 int
            if op == 4 {
                if !types.is_int(target_ty) {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "复合赋值取模只支持整数，目标类型是 " + types.type_name(target_ty)
                    return -1
                }
                if !stype.types_match(target_ty, vt, sstate.child(s, 0)) {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "复合赋值类型不匹配：目标类型 " + types.type_name(target_ty) + " 与表达式 " + types.type_name(vt)
                    return -1
                }
                return 0
            }
            // 位运算复合 `&=` `|=` `^=` `<<=` `>>=`：target 必须 int
            if op >= 13 && op <= 17 {
                if !types.is_int(target_ty) {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "复合赋值位运算只支持整数，目标类型是 " + types.type_name(target_ty)
                    return -1
                }
                if !stype.types_match(target_ty, vt, sstate.child(s, 0)) {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "复合赋值类型不匹配：目标类型 " + types.type_name(target_ty) + " 与表达式 " + types.type_name(vt)
                    return -1
                }
                return 0
            }
        }
        if !stype.types_compatible(target_ty, vt) && !stype.types_match(target_ty, vt, sstate.child(s, 0)) {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "赋值类型不匹配：变量 '" + nm + "' 类型为 " + types.type_name(target_ty) + "，表达式为 " + types.type_name(vt)
            return -1
        }
        return 0
    }
    if tag == S_N_RETURN {
        var v = sstate.child(s, 0)
        if v >= 0 {
            var vt = sinfer.infer_expr(v)
            if vt < 0 {
// S2.3 目标类型引导：return 泛型 enum 构造时类型参数推断不全，
            // 用函数返回类型补全（如 return Result.Err("bad") 于 Result<i64,string>）
            // S2.2 闭包：闭包体内用闭包返回类型（g_clo_ret_stack 栈顶）替代
            var h_ret = sg_ret[g_curfn]
            if g_clo_ret_top > 0 {
                h_ret = g_clo_ret_stack[g_clo_ret_top - 1]
            }
            var rv_l = sm_err_line
            var rv_c = sm_err_col
            var rv_m = sm_err_msg
            var hv = sinfer.try_enum_construct_hinted(v, h_ret)
                if hv >= 0 {
                    sm_err_line = 0
                    sm_err_col = 0
                    sm_err_msg = ""
                    vt = hv
                } else {
                    if sm_err_msg == rv_m {
                        sm_err_line = rv_l
                        sm_err_col = rv_c
                        sm_err_msg = rv_m
                    }
                    return -1
                }
            }
            var ret_ty = sg_ret[g_curfn]
            // S2.2 闭包：闭包体内 return 类型基准用闭包返回类型（栈顶）
            if g_clo_ret_top > 0 {
                ret_ty = g_clo_ret_stack[g_clo_ret_top - 1]
            }
            if !stype.types_compatible(ret_ty, vt) && !stype.types_match(ret_ty, vt, v) {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "return 类型不匹配：函数返回 " + types.type_name(ret_ty) + "，实际返回 " + types.type_name(vt)
                return -1
            }
        }
        return 0
    }
    if tag == S_N_IF {
        var cond = sinfer.infer_expr(sstate.child(s, 0))
        if cond < 0 {
            return -1
        }
        if !types.is_bool_like(cond) {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "if 条件必须是 bool"
            return -1
        }
        var r = check_block(sstate.child(s, 1))
        if r < 0 {
            return -1
        }
        var els = sstate.child(s, 2)
        if els >= 0 {
            r = check_block(els)
            if r < 0 {
                return -1
            }
        }
        return 0
    }
    if tag == S_N_WHILE {
        var cond = sinfer.infer_expr(sstate.child(s, 0))
        if cond < 0 {
            return -1
        }
        if !types.is_bool_like(cond) && !types.is_number(cond) {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "while 条件必须是 bool"
            return -1
        }
        var lbl = s_names[s]
        // 逻辑压栈：复用槽位（lp_stack 表不截断，lp_top 游标定位）
        if lp_top < len(lp_stack) {
            lp_stack[lp_top] = lbl
        } else {
            table_push(lp_stack, lbl)
        }
        lp_top = lp_top + 1
        var r = check_block(sstate.child(s, 1))
        lp_top = lp_top - 1
        if r < 0 {
            return -1
        }
        return 0
    }
    if tag == S_N_FOR {
        var vname = sstate.name_str(s)
        var vnid = intern.intern(vname)
        var iter = sstate.child(s, 0)
        var it = sinfer.infer_expr(iter)
        if it < 0 {
            return -1
        }
        var elem_ty: i64 = types.named(TK_I64)
        if types.is_table(it) {
            var te = types.table_elem(it)
            if te >= 0 {
                elem_ty = te
            } else {
                if s_tags[iter] == S_N_VAR {
                    var itname = sstate.name_str(iter)
                    var itnid = intern.intern(itname)
                    var vte = sinfer.var_table_elem(itnid)
                    if vte >= 0 {
                        elem_ty = vte
                    }
                }
            }
        } else if types.is_int(it) {
            elem_ty = types.named(TK_I64)
        } else {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "for 迭代对象仅支持范围（0..10）或表变量，实际是 " + types.type_name(it)
            return -1
        }
        // for 迭代变量：lv_insert 已实现覆盖
        sinfer.lv_insert(vnid, elem_ty, 0, -1, 0)
        var lbl = s_aux[s]
        // 逻辑压栈：复用槽位
        if lp_top < len(lp_stack) {
            lp_stack[lp_top] = lbl
        } else {
            table_push(lp_stack, lbl)
        }
        lp_top = lp_top + 1
        var r = check_block(sstate.child(s, 1))
        lp_top = lp_top - 1
        if r < 0 {
            return -1
        }
        return 0
    }
    if tag == S_N_BREAK || tag == S_N_CONTINUE {
        if lp_top == 0 {
            var kw = "break"
            if tag == S_N_CONTINUE {
                kw = "continue"
            }
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = kw + " 只能出现在循环体内"
            return -1
        }
        var lbl = s_names[s]
        if lbl >= 0 {
            var found: bool = false
            var i: i64 = lp_top - 1
            while i >= 0 {
                if lp_stack[i] == lbl {
                    found = true
                    break
                }
                i = i - 1
            }
            if !found {
                var kw = "break"
                if tag == S_N_CONTINUE {
                    kw = "continue"
                }
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = kw + " 的标签 '" + intern.lookup(lbl) + "' 未匹配任何外层循环"
                return -1
            }
        }
        return 0
    }
    if tag == S_N_SWITCH {
        var subj = sinfer.infer_expr(sstate.child(s, 0))
        if subj < 0 {
            return -1
        }
        if !types.is_number(subj) && !types.is_bool_like(subj) && subj != TK_STR && subj != TK_CHAR && types.kind(subj) != K_ENUM {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "switch 对象仅支持数字、布尔、字符、字符串或枚举类型，实际是 " + types.type_name(subj)
            return -1
        }
        var ncases = s_aux[s]
        var i: i64 = 0
        // 重置 case 去重表（每个 switch 独立）
        g_case_seen = table_new_string()
        while i < ncases {
            var c = sstate.child(s, 1 + i)
            var r = check_switch_case(c, subj)
            if r < 0 {
                return -1
            }
            i = i + 1
        }
        var dflt = sstate.child(s, 1 + ncases)
        if dflt >= 0 {
            var r = check_block(dflt)
            if r < 0 {
                return -1
            }
        }
        return 0
    }
    if tag == S_N_FIELD_ASSIGN {
        var base = sinfer.infer_expr(sstate.child(s, 0))
        if base < 0 {
            return -1
        }
        var fnm = sstate.name_str(s)
        var bk = types.kind(base)
        if bk != K_STRUCT && bk != K_TUPLE {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "字段赋值的对象必须是 struct 实例，实际是 " + types.type_name(base)
            return -1
        }
        if bk == K_STRUCT {
            var si = types.low(base)
            var off = cls_fldoff[si]
            var cnt = cls_nfld[si]
            var found: bool = false
            var ft: i64 = -1
            var i: i64 = 0
            while i < cnt {
                if intern.lookup(fld_names[off + i]) == fnm {
                    found = true
                    ft = fld_tys[off + i]
                    break
                }
                i = i + 1
            }
            if !found {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "类 '" + intern.lookup(st_keys[si]) + "' 没有字段 '" + fnm + "'"
                return -1
            }
            var vt = sinfer.infer_expr(sstate.child(s, 1))
            if vt < 0 {
                return -1
            }
            if !stype.types_compatible(ft, vt) && !stype.types_match(ft, vt, sstate.child(s, 1)) {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "字段赋值类型不匹配：期望 " + types.type_name(ft) + "，实际 " + types.type_name(vt)
                return -1
            }
        }
        return 0
    }
    if tag == S_N_INDEX_ASSIGN {
        // 目标必须是下标表达式 t[i]（Index 节点）
        var target = sstate.child(s, 0)
        if s_tags[target] != S_N_INDEX {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "下标赋值的目标必须是表元素访问（t[i]）"
            return -1
        }
        var base_node = sstate.child(target, 0)
        var idx_node = sstate.child(target, 1)
        var base = sinfer.infer_expr(base_node)
        if base < 0 {
            return -1
        }
        var idx = sinfer.infer_expr(idx_node)
        if idx < 0 {
            return -1
        }
        var vt = sinfer.infer_expr(sstate.child(s, 1))
        if vt < 0 {
            return -1
        }
        if !types.is_table(base) && base != TK_STR {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "下标赋值的对象必须是表，实际是 " + types.type_name(base)
            return -1
        }
        // 下标类型：map 键值表允许字符串键（E3：m["key"] = v → tie_map_set_string）
        // 与整数键；普通表下标必须是整数
        if !types.is_map(base) {
            if !types.is_int(idx) {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "下标必须是整数，实际是 " + types.type_name(idx)
                return -1
            }
        }
        return 0
    }
    if tag == S_N_IMPORT || tag == S_N_USING || tag == S_N_NAMESPACE || tag == S_N_STRUCT || tag == S_N_ENUM || tag == S_N_FN_DEF || tag == S_N_EXTERN {
        sm_err_line = s_lines[s]
        sm_err_col = s_cols[s]
        sm_err_msg = "语句只能出现在文件顶层"
        return -1
    }
    return 0
}

// 变量声明检查（函数内）
pub func check_var_decl(s: i64) -> i64 {
    var nm = sstate.name_str(s)
    var nid = intern.intern(nm)
    var is_const = s_vals[s]
    // 重复声明对齐 Rust 版：不报错（scope.insert 覆盖语义）
    var ty_node = sstate.child(s, 0)
    var init = sstate.child(s, 1)
    if ty_node >= 0 {
        var ty = sgen.parse_generic_type_node(ty_node)
        if ty < 0 {
            return -1
        }
        // S1.2 S1 指针全归 unsafe：安全代码不能声明指针/切片/原子类型变量
        if types.is_unsafe_ty(ty) && g_unsafe_depth == 0 {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "变量 '" + nm + "' 的指针/切片/原子类型 '" + types.type_name(ty) + "' 只能在 unsafe 代码中使用"
            return -1
        }
        // S3.3：code 类型只能在宏函数体内使用（编译期值，运行期无表示）。
        // 宏体不经过语义检查（interp 编译期执行），此检查拦截普通函数里的
        // code 变量/参数（含展开残留的准引用）。
        if ty == types.named(TK_CODE) {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "code 类型值只能在宏函数体内使用（宏 = 编译期 AST→AST 函数；准引用/插值/宏参数都是编译期构造）"
            return -1
        }
        var it: i64 = -1
        if init >= 0 {
            it = sinfer.infer_expr(init)
            if it < 0 {
                // S2.3 目标类型引导：`var b: Result<i64, string> = Result.Err("bad")`
                // 泛型 enum 构造类型参数推断不全时，用标注类型补全
                var d_l = sm_err_line
                var d_c = sm_err_col
                var d_m = sm_err_msg
                var hv = sinfer.try_enum_construct_hinted(init, ty)
                if hv >= 0 {
                    sm_err_line = 0
                    sm_err_col = 0
                    sm_err_msg = ""
                    it = hv
                } else {
                    if sm_err_msg == d_m {
                        sm_err_line = d_l
                        sm_err_col = d_c
                        sm_err_msg = d_m
                    }
                    return -1
                }
            }
        }
        var telem: i64 = -1
        var dyn: i64 = 0
        if types.is_table(ty) {
            if init >= 0 {
                var itag = s_tags[init]
                if itag == S_N_TABLE_LIT {
                    telem = types.table_elem(it)
                    if telem < 0 {
                        telem = types.named(TK_I64)
                    }
                } else if itag == S_N_CALL {
                    var fnm = sstate.name_str(init)
                    if fnm == "table_new_i64" {
                        telem = types.named(TK_I64)
                    } else if fnm == "table_new_f64" {
                        telem = types.named(TK_F64)
                    } else if fnm == "table_new_string" {
                        telem = types.named(TK_STR)
                    } else if fnm == "table_new_bool" {
                        telem = types.named(TK_BOOL)
                    } else {
                        // 用解析后全名查返回表元素
                        var te2 = sinfer.table_ret_elem(sinfer.resolve_call_name(fnm))
                        if te2 >= 0 {
                            telem = te2
                        }
                    }
                    dyn = 1
                } else if itag == S_N_VAR {
                    var iname = sstate.name_str(init)
                    var inid = intern.intern(iname)
                    var vte = sinfer.var_table_elem(inid)
                    if vte >= 0 {
                        telem = vte
                    }
                    if sinfer.var_dyn(inid) == 1 {
                        dyn = 1
                    }
                }
            } else {
                var te3 = types.table_elem(ty)
                if te3 >= 0 {
                    telem = te3
                }
                dyn = 1
            }
        }
        if init >= 0 {
            if !stype.types_match(ty, it, init) && !stype.types_compatible(ty, it) {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "变量 '" + nm + "' 类型不匹配：标注 " + types.type_name(ty) + "，表达式推导为 " + types.type_name(it)
                return -1
            }
        }
        sinfer.lv_insert(nid, ty, is_const, telem, dyn)
        // S2.2 闭包：闭包体内声明的局部登记到当前闭包局部段（捕获遮蔽判定用）
        if g_clo_depth > 0 && g_clo_cur >= 0 {
            table_push(cl_locals, nid)
        }
        return 0
    }
    if init < 0 {
        sm_err_line = s_lines[s]
        sm_err_col = s_cols[s]
        sm_err_msg = "变量 '" + nm + "' 必须标注类型或初始化"
        return -1
    }
    var it2 = sinfer.infer_expr(init)
    if it2 < 0 {
        return -1
    }
    var telem2: i64 = -1
    var dyn2: i64 = 0
    if types.is_table(it2) {
        telem2 = types.table_elem(it2)
        if telem2 < 0 {
            // 调用/方法调用返回的裸表：查返回表元素类型
            if s_tags[init] == S_N_CALL {
                var fnm2 = sstate.name_str(init)
                // table_new_*：元素类型由调用名决定（对齐 Rust dynamic_table_elem_ty
                // 3844 行 table_new_elem_ty——Rust 侧 table_new_* 表达式类型是裸 table，
                // 元素类型在 VarDecl 处按调用名解析登记）
                var te4: i64 = -1
                if fnm2 == "table_new_i64" {
                    te4 = types.named(TK_I64)
                } else if fnm2 == "table_new_f64" {
                    te4 = types.named(TK_F64)
                } else if fnm2 == "table_new_string" {
                    te4 = types.named(TK_STR)
                } else if fnm2 == "table_new_bool" {
                    te4 = types.named(TK_BOOL)
                }
                if te4 >= 0 {
                    telem2 = te4
                } else {
                    var te2 = sinfer.table_ret_elem(sinfer.resolve_call_name(fnm2))
                    if te2 >= 0 {
                        telem2 = te2
                    } else {
                        telem2 = types.named(TK_I64)
                    }
                }
            } else if s_tags[init] == S_N_METHOD_CALL {
                // 方法调用返回表：recv::mname 查返回表元素（如 str.split → str::split）
                // MethodCall 接收者 = children[slot_off]（新布局 children[0]=泛型槽）
                var recv = sstate.child(init, sstate.slot_off(init))
                var rname = sstate.name_str(recv)
                var mname = sstate.name_str(init)
                var full2 = rname + "::" + mname
                var te3 = sinfer.table_ret_elem(full2)
                if te3 >= 0 {
                    telem2 = te3
                } else {
                    telem2 = types.named(TK_I64)
                }
            } else {
                telem2 = types.named(TK_I64)
            }
        }
        if s_tags[init] != S_N_TABLE_LIT {
            dyn2 = 1
        }
    }
    sinfer.lv_insert(nid, it2, is_const, telem2, dyn2)
    // S2.2 闭包：闭包体内声明的局部登记到当前闭包局部段（捕获遮蔽判定用）
    if g_clo_depth > 0 && g_clo_cur >= 0 {
        table_push(cl_locals, nid)
    }
    return 0
}

// 函数体检查
pub func check_fn(fn_node: i64, full: string) -> i64 {
    var sig = sstate.fn_sig(full)
    if sig < 0 {
        sm_err_line = s_lines[fn_node]
        sm_err_col = s_cols[fn_node]
        sm_err_msg = "内部错误：函数 '" + full + "' 无签名"
        return -1
    }
    g_curfn = sig
    lv_keys = table_new_i64()
    lv_vals = table_new_i64()
    lv_const = table_new_i64()
    lv_telem = table_new_i64()
    lv_dyn = table_new_i64()
    lp_stack = table_new_i64()
    lp_top = 0
    var nparams = sg_nparams[sig]
    var off = sg_off[sig]
    var i: i64 = 0
    while i < nparams {
        // 第 i 个参数节点：children[slot_off + 1 + i]（slot_off 双布局兼容）
        var pnode = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + i)
        var pname = sstate.name_str(pnode)
        var pnid = intern.intern(pname)
        var pty = sp_tys[off + i]
        var prefs = sp_refs[off + i]
        var telem: i64 = -1
        var dyn: i64 = 0
        if types.is_table(pty) {
            telem = types.table_elem(pty)
            if telem < 0 {
                telem = types.named(TK_STR)
            }
            dyn = 1
        }
        sinfer.lv_insert(pnid, pty, 0, telem, dyn)
        i = i + 1
    }
    // 函数体：children[slot_off + 1 + nparams]
    var body = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + nparams)
    // S1.2：unsafe 函数体内开启 unsafe 上下文（safe 代码进 unsafe fn 已被调用
    // 检查拦截；unsafe fn 内部零标记触底）
    var saved_depth = g_unsafe_depth
    if sstate.sig_unsafe(sig) == 1 {
        g_unsafe_depth = g_unsafe_depth + 1
    }
    var r = check_block(body)
    g_unsafe_depth = saved_depth
    if r < 0 {
        return -1
    }
    return 0
}

// 带命名空间上下文的函数检查（顶层遍历 g_extra_tops，进入 namespace 时压段）
pub func check_fn_walk(full: string) -> i64 {
    var n = len(g_extra_tops)
    var i: i64 = 0
    while i < n {
        var s = g_extra_tops[i]
        var tag = s_tags[s]
        if tag == S_N_FN_DEF {
            if sstate.ns_full_name(sstate.name_str(s)) == full {
                var r = check_fn(s, full)
                if r < 0 {
                    return -1
                }
                return 1
            }
        } else if tag == S_N_NAMESPACE {
            var nsegs = s_aux[s]
            var j: i64 = 0
            while j < nsegs {
                var seg = sstate.child(s, j)
                sstate.ns_push(s_names[seg])
                j = j + 1
            }
            var body = sstate.child(s, nsegs)
            var r = check_fn_walk_in_ns(body, full)
            j = 0
            while j < nsegs {
                ns_top = ns_top - 1
                j = j + 1
            }
            if r < 0 {
                return -1
            }
            if r == 1 {
                return 1
            }
        }
        i = i + 1
    }
    return 0
}

// 命名空间体内递归检查（含嵌套 namespace）
func check_fn_walk_in_ns(blk: i64, full: string) -> i64 {
    var n = sstate.nchild(blk)
    var i: i64 = 0
    while i < n {
        var s = sstate.child(blk, i)
        var tag = s_tags[s]
        if tag == S_N_FN_DEF {
            if sstate.ns_full_name(sstate.name_str(s)) == full {
                var r = check_fn(s, full)
                if r < 0 {
                    return -1
                }
                return 1
            }
        } else if tag == S_N_NAMESPACE {
            var nsegs = s_aux[s]
            var j: i64 = 0
            while j < nsegs {
                var seg = sstate.child(s, j)
                sstate.ns_push(s_names[seg])
                j = j + 1
            }
            var body = sstate.child(s, nsegs)
            var r = check_fn_walk_in_ns(body, full)
            j = 0
            while j < nsegs {
                ns_top = ns_top - 1
                j = j + 1
            }
            if r < 0 {
                return -1
            }
            if r == 1 {
                return 1
            }
        }
        i = i + 1
    }
    return 0
}

// ==================== S2.2 闭包：延迟闭包体检查 ====================
// 语义主流程末尾调用。FIFO 处理 g_clo_pending（登记顺序 = 检查顺序；
// 嵌套闭包在外层闭包体检查期间登记，仍按 FIFO 排在外层之后）。
// 每个闭包体用「登记时 lv 快照 + 闭包参数 + 闭包局部」重建独立作用域
// 检查，结束后恢复外层作用域（函数检查残留的 lv 表）。
pub func check_pending_closures() -> i64 {
    var n = len(g_clo_pending)
    var i: i64 = 0
    while i < n {
        var r = check_closure_body(i)
        if r < 0 {
            return -1
        }
        i = i + 1
    }
    return 0
}

// 检查单个闭包体：重建独立 lv 作用域 + 闭包返回类型栈 + 检查后恢复
func check_closure_body(ci: i64) -> i64 {
    var fn_node = g_clo_pending[ci]
    // 保存外层 lv 五表与 loop 栈（函数检查残留，闭包体检查后恢复）
    var s_keys = lv_keys
    var s_vals = lv_vals
    var s_const = lv_const
    var s_telem = lv_telem
    var s_dyn = lv_dyn
    var s_lp = lp_stack
    var s_lpt = lp_top
    // 重建 lv = 登记时快照段（cl_o* 五表并行段，登记时已排序，直拷保持序）
    lv_keys = table_new_i64()
    lv_vals = table_new_i64()
    lv_const = table_new_i64()
    lv_telem = table_new_i64()
    lv_dyn = table_new_i64()
    lp_stack = table_new_i64()
    lp_top = 0
    var ooff = cl_off[ci]
    var nouter = cl_nouter[ci]
    var j: i64 = 0
    while j < nouter {
        table_push(lv_keys, cl_okeys[ooff + j])
        table_push(lv_vals, cl_ovals[ooff + j])
        table_push(lv_const, cl_oconst[ooff + j])
        table_push(lv_telem, cl_otelem[ooff + j])
        table_push(lv_dyn, cl_odyn[ooff + j])
        j = j + 1
    }
    // 闭包参数插入 lv（telem/dyn 表类型处理同 check_fn 参数模板）
    var nparams = cl_nparams[ci]
    var poff = cl_paramoff[ci]
    var tyoff = cl_paroff[ci]
    var k: i64 = 0
    while k < nparams {
        var pnid = cl_params[poff + k]
        var pty = cl_ptys[tyoff + k]
        var telem: i64 = -1
        var dyn: i64 = 0
        if types.is_table(pty) {
            telem = types.table_elem(pty)
            if telem < 0 {
                telem = types.named(TK_STR)
            }
            dyn = 1
        }
        sinfer.lv_insert(pnid, pty, 0, telem, dyn)
        k = k + 1
    }
    // 闭包局部/捕获段起点：检查开始时定位（覆盖登记时占位值，避免
    // 嵌套闭包登记后外层闭包继续追加局部/捕获造成的段污染）
    cl_locloff[ci] = len(cl_locals)
    cl_capoff[ci] = len(cl_capkeys)
    // 压闭包返回类型（S_N_RETURN 检查优先取栈顶而非 sg_ret[g_curfn]）。
    // 复用槽位模式（同 lp_stack/ns_push）：表不截断、top 游标定位——
    // 直接 table_push 会让旧值残留错位（第二次 push 后栈顶索引指到残留值）。
    if g_clo_ret_top < len(g_clo_ret_stack) {
        g_clo_ret_stack[g_clo_ret_top] = cl_ret[ci]
    } else {
        table_push(g_clo_ret_stack, cl_ret[ci])
    }
    g_clo_ret_top = g_clo_ret_top + 1
    // 进入闭包体上下文（S_N_VAR 捕获登记 / check_var_decl 局部登记）
    g_clo_cur = ci
    g_clo_depth = g_clo_depth + 1
    // 闭包体：children[slot+1+nparams]（泛型槽0、返回类型1、参数2..、体末尾）
    var slot = sstate.slot_off(fn_node)
    var body = sstate.child(fn_node, slot + 1 + nparams)
    var r = check_block(body)
    // 退出闭包体上下文
    g_clo_depth = g_clo_depth - 1
    g_clo_cur = -1
    g_clo_ret_top = g_clo_ret_top - 1
    // 恢复外层 lv 五表与 loop 栈
    lv_keys = s_keys
    lv_vals = s_vals
    lv_const = s_const
    lv_telem = s_telem
    lv_dyn = s_dyn
    lp_stack = s_lp
    lp_top = s_lpt
    if r < 0 {
        return -1
    }
    return 0
}

}
