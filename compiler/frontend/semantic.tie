type tie<class>
// compiler/frontend/semantic.tie —— 自举 v2 T2.6：完整语义分析器（主入口）
// ============================================================
// 里程碑：自举 v2 计划 T2.6（.omo/plans/self-hosting-v2.md）。由 T1.3 原型
// compiler/proto/semantic.tie 升版（corpus pass + 负例断言），行为基准
// Rust crates/tie-frontend/src/semantic.rs（错误消息逐字对齐）。
// # 模块拆分（2026-08-11）：原 3802 行单文件按「无环 import 树」拆为 8 模块——
//   sstate.tie（全局状态+AST 9 列+工具）/ stype.tie（类型辅助，复用 types）/
//   sbuiltin.tie（内置函数签名）/ sinfer.tie（表达式推断+调用解析）/
//   scollect.tie（顶层收集）/ scheck.tie（语句/函数检查）/ 本文件（主入口）。
//   类型系统复用 middle/types.tie + middle/data.tie（T2.1 交付）。
// # 相比原型改进：
//   - import 展开（原型跳过，本版实现：读文件 + 递归检查 + 重复导入去重）；
//   - 类型系统走 types.tie（ty_* 自编码与 proto 同构）。
// # 协议：check(ast_text) -> "OK:<typed_count>" 或 "ERR:<line> <col> <msg>"。
// # T2.6 验收：corpus 101 文件 pass + 负例 golden 逐字对齐 Rust。
// import 树：本文件同时 import parser 树（展开 import 用）与 scheck 链
// （语义检查）；两树文件无重叠（parser 树 = pst/ast/lexer/putil/pexpr/...，
// semantic 树 = sstate/stype/sbuiltin/sinfer/scollect/scheck），无环无重复。
// S3.3：mexpand（宏展开 pass）import interp 树（interp → session/value +
// parser 树 + sstate）——与上述两树按「解析后路径」去重，无环。
import "./parser.tie"
import "./scheck.tie"
import "./sgen.tie"
import "./smove.tie"
import "./mexpand.tie"

// ==================== import 展开状态 ====================
// 当前文件目录（相对 import 解析基准）
var g_cur_dir: string = "";

// 泛型预扫描展开状态（T3b）：g_extra_tops 已扫描位置游标（新展开的函数
// 追加到 g_extra_tops 末尾，主循环从该位置续扫）
var g_scan_extra_last: i64 = 0;

namespace semantic {

// 路径目录：返回最后一个 '/' 之前的子串（含 '/'）；无 '/' 返回 ""。
func path_dir(path: string) -> string {
    var n = str_len(path)
    var i: i64 = n - 1
    var last: i64 = -1
    while i >= 0 {
        if str_char(path, i) == "/" {
            last = i
            break
        }
        i = i - 1
    }
    if last < 0 {
        return ""
    }
    return str.slice(path, 0, last + 1)
}

// 归一化路径：折叠 "段/../"（"a/b/../c" → "a/c"），循环直到稳定。
// S3.2：import 展开去重按**字符串**比较，未归一化路径（如 llvmgen 经
// "./../middle/ir.tie" 展开得 "compiler/backend/../middle/ir.tie"，而
// ir_meta 经 "./ir.tie" 得 "compiler/middle/ir.tie"）字符串不同 → 去重
// 失效 → 同一文件二次内联 → 全局变量/函数重复定义。所有解析结果统一
// 归一化后，多入口（driver 树 + tieir_ser 树）正确去重。
// 边界：开头 "../"（相对路径上溯到根外）保留不折叠；"./" 前缀不产生
// 折叠段（"." 段不删）。
// 整合说明：s33 分支另有分段栈实现（功能等价），取本循环折叠版。
func normalize_path(p: string) -> string {
    var out = p
    var changed: bool = true
    while changed {
        changed = false
        var n = str_len(out)
        var i: i64 = 0
        while i + 3 < n {
            // 命中 "/../"（段分隔 + 两点 + 斜杠）
            if str_char(out, i) == "/" && str_char(out, i + 1) == "." &&
                str_char(out, i + 2) == "." && str_char(out, i + 3) == "/" {
                // 找 i 之前的最后一个 '/'（被折叠段的起点）
                var seg_start: i64 = -1
                var j: i64 = i - 1
                while j >= 0 {
                    if str_char(out, j) == "/" {
                        seg_start = j
                        break
                    }
                    j = j - 1
                }
                var remove_start: i64 = 0
                if seg_start >= 0 {
                    // 删除 [seg_start+1, i+4)：保留段前 '/'（"a/b/../c" 删
                    // "b/../" 得 "a/c"——seg_start 指向 "a/" 的 '/'，须 +1）
                    remove_start = seg_start + 1
                }
                // 特例：remove_start == 0 且路径以 "../" 开头 → 根外上溯，
                // 无法折叠，跳过该处（如 "../lib/x.tie"）
                if remove_start == 0 && str_len(out) >= 2 &&
                    str_char(out, 0) == "." && str_char(out, 1) == "." {
                    i = i + 4
                    continue
                }
                var remove_end = i + 4
                var prefix = str.slice(out, 0, remove_start)
                var suffix = str.slice(out, remove_end, str_len(out))
                out = prefix + suffix
                changed = true
                break
            }
            i = i + 1
        }
    }
    return out
}

// 解析 import 路径：相对当前文件目录（处理 "./" 与 "../"）；
// 结果统一经 normalize_path 归一化（去重键一致，见 normalize_path 注释）。
pub func resolve_import_path(path: string) -> string {
    if sstate.has_prefix_str(path, "./") {
        return normalize_path(g_cur_dir + str.slice(path, 2, str_len(path)))
    }
    if sstate.has_prefix_str(path, "../") {
        // g_cur_dir 形如 "examples/"：去掉最后一个非空目录段得 "…/"，
        // 再拼去掉 ../ 的剩余路径（../ext/x → ext/x）
        var d = g_cur_dir
        var dn = str_len(d)
        // 去掉尾部斜杠（若 d 非空且以 / 结尾）
        while dn > 0 {
            if str_char(d, dn - 1) == "/" {
                dn = dn - 1
            } else {
                break
            }
        }
        // 找到上一个 '/'，截断到它（含）——去掉最后一段
        var cut: i64 = -1
        var i: i64 = dn - 1
        while i >= 0 {
            if str_char(d, i) == "/" {
                cut = i + 1
                break
            }
            i = i - 1
        }
        var parent = ""
        if cut >= 0 {
            parent = str.slice(d, 0, cut)
        }
        return normalize_path(parent + str.slice(path, 3, str_len(path)))
    }
    return normalize_path(path)
}

// 已导入集合线性查找（文件少，线性足够）
func imported_has(p: string) -> bool {
    var i: i64 = 0
    while i < len(g_imported) {
        if g_imported[i] == p {
            return true
        }
        i = i + 1
    }
    return false
}

// 剥离文件类型声明行（`type tie` / `type tie<X>`）：头部区 = 最前连续行
// （允许空行），声明行空行占位（行号不变）；其余行原样。
// 与 Rust 链清理脚本 prep/clean.tie 同规则——被导入文件（std/库等）现在带
// 类型声明头部（新文件类型声明体系），import 展开须先剥离再解析。
func strip_type_decl(src: string) -> string {
    var rows = str.split(src, "\n")
    var n: i64 = len(rows)
    var out = table_new_string()
    var in_header = true
    var i: i64 = 0
    while i < n {
        var ln = rows[i]
        if in_header {
            var t = str.trim(ln)
            if str_len(t) == 0 {
                // 头部区空行：保留（占位，行号不变）
                table_push(out, ln)
            } else if sstate.has_prefix_str(t, "type tie") {
                var rest = str.trim(str.slice(t, 8, str_len(t)))
                // 合法声明：`type tie` 或 `type tie<X>`（无尾随内容）→ 空行占位
                if str_len(rest) == 0 {
                    table_push(out, "")
                } else if str_char(rest, 0) == "<" && str_char(rest, str_len(rest) - 1) == ">" {
                    table_push(out, "")
                } else {
                    // 非法形态（如 `type tie<data> extra`）：非声明，头部区结束
                    in_header = false
                    table_push(out, ln)
                }
            } else {
                // 第一个非声明内容行：头部区结束，原样保留
                in_header = false
                table_push(out, ln)
            }
        } else {
            table_push(out, ln)
        }
        i = i + 1
    }
    return str.join(out, "\n")
}

// 递归展开单个 import 节点：读文件 → parse → append_ast 合并，
// 其顶层语句（非 import）进 g_extra_tops，其 import 递归展开。
func expand_one_import(imp_node: i64) -> i64 {
    var p = sstate.name_str(imp_node)
    var full = resolve_import_path(p)
    if imported_has(str.clone(full)) {
        return 0
    }
    table_push(g_imported, full)
    var src = file_read(full)
    if src == "" {
        sm_err_line = s_lines[imp_node]
        sm_err_col = s_cols[imp_node]
        sm_err_msg = "无法读取导入文件 '" + full + "'"
        return -1
    }
    // 剥离文件类型声明行（新体系：被导入文件头部带 `type tie<X>` 声明，
    // 须先清理再解析——与 Rust 链清理脚本 prep/clean.tie 同规则）
    var src2 = strip_type_decl(src)
    // T5.3 内存版：parse_ast 直接把库文件 AST 留在内存（不产协议文本），
    // append_ast_mem 再从 ast 表直拷到 sstate——与原「parse_src → 文本 →
    // append_ast」语义等价但省去协议往返的字符串开销
    var prc = parser.parse_ast(src2)
    if prc < 0 {
        sm_err_line = s_lines[imp_node]
        sm_err_col = s_cols[imp_node]
        // 错误消息与原协议完全一致：原 ast_text 为 "ERR:<line> <col> <msg>"
        //（parse_src 返回），现由 parser.ast_err_protocol() 组装同格式文本
        sm_err_msg = "导入文件 '" + full + "' 解析失败: " + parser.ast_err_protocol()
        return -1
    }
    var base = append_ast_mem()
    if base < 0 {
        return -1
    }
    // import as 别名（M2.1.7）：alias = imp_node.aux（字符串池 id，-1 = 无别名）。
    // 有别名时，把被导入文件顶层 namespace 的段名替换为别名（f2 作为唯一入口）。
    var alias = s_aux[imp_node]
    var new_root = len(s_tags) - 1
    if alias >= 0 {
        var an = sstate.nchild(new_root)
        var ak: i64 = 0
        while ak < an {
            var as_ = sstate.child(new_root, ak)
            if s_tags[as_] == S_N_NAMESPACE {
                var nsegs = s_aux[as_]
                if nsegs > 0 {
                    // 只改第一段（namespace fmt → namespace f2）
                    var first_seg = sstate.child(as_, 0)
                    s_names[first_seg] = alias
                }
            }
            ak = ak + 1
        }
    }
    // 新文件顶层 StmtList root = 追加后最后节点
    // 递归：新文件顶层中的 import 立即展开；其余进 g_extra_tops
    var saved_dir = g_cur_dir
    g_cur_dir = path_dir(full)
    var nc = sstate.nchild(new_root)
    var k: i64 = 0
    while k < nc {
        var s = sstate.child(new_root, k)
        if s_tags[s] == S_N_IMPORT {
            var r = expand_one_import(s)
            if r < 0 {
                g_cur_dir = saved_dir
                return -1
            }
        } else {
            table_push(g_extra_tops, s)
        }
        k = k + 1
    }
    g_cur_dir = saved_dir
    return 0
}

// import 展开总入口：主文件顶层进 g_extra_tops，import 递归展开
func expand_imports() -> i64 {
    g_imported = table_new_string()
    g_extra_tops = table_new_i64()
    var n = sstate.nchild(g_root)
    var i: i64 = 0
    while i < n {
        var s = sstate.child(g_root, i)
        if s_tags[s] == S_N_IMPORT {
            var r = expand_one_import(s)
            if r < 0 {
                return -1
            }
        } else {
            table_push(g_extra_tops, s)
        }
        i = i + 1
    }
    return 0
}

// 便捷入口：源码字符串 + 基准目录 → 可读语义摘要
pub func check_debug_src(src: string, base_dir: string) -> string {
    // 剥离文件类型声明头部（type tie / type tie<X>）——真实管线由预处理完成，
    // check 路径须等效（否则头部声明被当顶层标识符报错）
    var ast_text = parser.parse_src(strip_type_decl(src))
    if sstate.has_prefix_str(ast_text, "ERR:") {
        return ast_text
    }
    return check_debug(ast_text)
}

// ==================== check 主入口 ====================
// 语义检查入口：AST 协议文本 → "OK:<typed>" / "ERR:<line> <col> <msg>"
pub func check(ast_text: string) -> string {
    return check_impl(ast_text, "")
}

// 便捷入口：源码字符串 + 基准目录 → 完整语义检查（parse + import 展开 + check）
pub func check_src(src: string, base_dir: string) -> string {
    // 剥离文件类型声明头部（type tie / type tie<X>）——真实管线由预处理完成，
    // check 路径须等效（否则头部声明被当顶层标识符报错；strip_type_decl 与
    // 展开 import 时同规则，行号占位保一致）
    var ast_text = parser.parse_src(strip_type_decl(src))
    if sstate.has_prefix_str(ast_text, "ERR:") {
        return ast_text
    }
    return check_impl(ast_text, base_dir)
}

// check 核心（含 import 展开）
pub func check_impl(ast_text: string, base_dir: string) -> string {
    g_cur_dir = base_dir
    s_tags = table_new_i64()
    s_names = table_new_i64()
    s_vals = table_new_i64()
    s_aux = table_new_i64()
    s_coff = table_new_i64()
    s_nchild = table_new_i64()
    s_children = table_new_i64()
    s_lines = table_new_i64()
    s_cols = table_new_i64()
    fn_keys = table_new_i64()
    fn_vals = table_new_i64()
    sg_nparams = table_new_i64()
    sg_required = table_new_i64()
    sg_ret = table_new_i64()
    sg_pub = table_new_i64()
    sg_off = table_new_i64()
    sp_tys = table_new_i64()
    sp_refs = table_new_i64()
    sp_defs = table_new_i64()
    sp_vars = table_new_i64()
    st_keys = table_new_i64()
    st_vals = table_new_i64()
    cls_parent = table_new_i64()
    cls_fldoff = table_new_i64()
    cls_nfld = table_new_i64()
    cls_done = table_new_i64()
    fld_names = table_new_i64()
    fld_tys = table_new_i64()
    // enum 状态表重置（2026-08-15 enum 语言特性；每次编译清零）
    en_keys = table_new_i64()
    en_vals = table_new_i64()
    en_done = table_new_i64()
    en_nvar = table_new_i64()
    en_varoff = table_new_i64()
    en_nslot = table_new_i64()
    en_vnames = table_new_i64()
    en_vtags = table_new_i64()
    en_vfldoff = table_new_i64()
    en_vnfld = table_new_i64()
    en_ftys = table_new_i64()
    gb_keys = table_new_i64()
    gb_vals = table_new_i64()
    gb_const = table_new_i64()
    gb_telem = table_new_i64()
    ext_keys = table_new_i64()
    tre_keys = table_new_i64()
    tre_vals = table_new_i64()
    node_types = table_new_i64()
    lv_keys = table_new_i64()
    lv_vals = table_new_i64()
    lv_const = table_new_i64()
    lv_telem = table_new_i64()
    lv_dyn = table_new_i64()
    lp_stack = table_new_i64()
    lp_top = 0
    ns_stack = table_new_i64()
    ns_top = 0
    using_prefixes = table_new_i64()
    using_lens = table_new_i64()
    tuple_tys = table_new_i64()
    tup_names = table_new_i64()
    tup_tys = table_new_i64()
    tup_offs = table_new_i64()
    tup_n = table_new_i64()
    g_curfn = -1
    g_typed = 0
    sm_err_msg = ""
    // 泛型模板登记表重置（gt_*，T3b 单态化展开器预置；每次编译清零）
    gty_keys = table_new_i64()
    gty_vals = table_new_i64()
    gtyp_nparams = table_new_i64()
    gtyp_off = table_new_i64()
    gtyp_names = table_new_i64()
    gty_node = table_new_i64()
    gty_is_struct = table_new_i64()
    // S2.4：泛型约束段 + port/impl 状态表重置（每次编译清零）
    gtyp_conoff = table_new_i64()
    gtyp_cons = table_new_i64()
    pt_keys = table_new_i64()
    pt_vals = table_new_i64()
    pm_off = table_new_i64()
    pm_n = table_new_i64()
    pm_npar = table_new_i64()
    pm_paroff = table_new_i64()
    pm_ret = table_new_i64()
    pm_names = table_new_i64()
    pm_npars = table_new_i64()
    pm_ptys = table_new_i64()
    pm_rets = table_new_i64()
    im_keys = table_new_i64()
    im_vals = table_new_i64()
    im_port = table_new_i64()
    im_struct = table_new_i64()
    im_poff = table_new_i64()
    im_n = table_new_i64()
    im_mnames = table_new_i64()
    g_impl_pending = table_new_i64()
    // 实例化记录表重置（gin_*，T3b 单态化展开器；每次编译清零）
    gin_keys = table_new_i64()
    gin_vals = table_new_i64()
    gin_tmpl = table_new_i64()
    gin_off = table_new_i64()
    gin_nargs = table_new_i64()
    gin_is_struct = table_new_i64()
    garg_vals = table_new_i64()
    // S2.2 闭包语义全局重置（每次编译清零）
    g_clo_pending = table_new_i64()
    cl_ret = table_new_i64()
    cl_nparams = table_new_i64()
    cl_paroff = table_new_i64()
    cl_ptys = table_new_i64()
    cl_off = table_new_i64()
    cl_nouter = table_new_i64()
    cl_okeys = table_new_i64()
    cl_ovals = table_new_i64()
    cl_oconst = table_new_i64()
    cl_otelem = table_new_i64()
    cl_odyn = table_new_i64()
    cl_paramoff = table_new_i64()
    cl_params = table_new_i64()
    cl_locloff = table_new_i64()
    cl_locals = table_new_i64()
    cl_capoff = table_new_i64()
    cl_capkeys = table_new_i64()
    cl_capvals = table_new_i64()
    g_clo_ret_stack = table_new_i64()
    g_clo_depth = 0
    g_clo_cur = -1
    g_clo_ret_top = 0
    g_inst_depth = 0
    if len(tre_bi_keys) == 0 {
        scollect.tre_bi_init()
    }
    if sstate.load_ast(ast_text) < 0 {
        return "ERR:0 0 AST 协议解析失败"
    }
    g_root = s_n - 1
    // import 展开（主文件顶层进 g_extra_tops，import 文件递归合并）
    var er = expand_imports()
    if er < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    var r = scollect.collect_top()
    if r < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // S2.4 impl 块统一处理（struct/port 全部登记后：方法改名 + 签名登记 +
    // 完整性/签名检查 + impl 记录）。须在 expand_generics 之前——泛型约束
    // 校验（instantiate_fn/struct）依赖 impl 表就绪。
    var ifr = scollect.collect_impl_fns()
    if ifr < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // 泛型单态化预扫描展开（T3b）：遍历模板 → 扫描调用点 → 展开 → 去重 →
    // 递归处理新实例化（展开产物进入 fn_keys/st_keys 后由后续阶段覆盖）。
    // 须在 collect_all_struct_fields 之前——展开的 struct 字段拍平由
    // instantiate_struct 即时完成，主流程再遍历 st_keys 时 cls_done 跳过
    var ge = expand_generics()
    if ge < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // 泛型字段类型预实例化（2026-08-14）：字段类型中的模板 struct 引用（如
    // `A<i64>`）在此先行实例化，避免 collect_all_struct_fields 拍平时实例化
    // 副作用顶偏 cls_fldoff（详见 scollect.pre_instantiate_field_types 注释）
    var pr = scollect.pre_instantiate_field_types()
    if pr < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // struct 字段拍平收集（含继承；须在逐函数检查前完成）
    var r3 = scollect.collect_all_struct_fields()
    if r3 < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // enum 变体收集（须在 struct 字段拍平之后——payload 类型可能引用 struct）
    var r5 = scollect.collect_all_enums()
    if r5 < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // 返回表元素预扫描（先于逐函数 check）
    var r4 = scollect.collect_all_return_tables()
    if r4 < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // 逐函数检查（T3b 稳定化：检查期间 infer_call 会触发展开新实例化 → fn_keys
    // 增长，循环重扫直到无新函数——防 sorted_insert 把新签名插到游标之前被跳过）
    var checked: table<i64> = table_new_i64()
    var again: bool = true
    while again {
        again = false
        var i: i64 = 0
        while i < len(fn_keys) {
            var fid = fn_keys[i]
            var chk: i64 = 0
            var has: bool = false
            while chk < len(checked) {
                if checked[chk] == fid {
                    has = true
                    break
                }
                chk = chk + 1
            }
            if !has {
                table_push(checked, fid)
                again = true
                var fname = intern.lookup(fid)
                // S1.5 移动语义：每函数检查前重置 live/moved 状态表
                // （lv_* 局部表在 scheck.check_fn 重置；lv_moved 独立表在此
                // 同步重置——sstate 定义，见 lv_moved_reset）
                sstate.lv_moved_reset()
                var r2 = scheck.check_fn_walk(fname)
                if r2 < 0 {
                    return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
                }
                // S1.5 移动语义独立 pass：类型检查后遍历函数体，跟踪 live/moved
                // （复用已重置的 lv_moved；内置/原语调用借用，用户函数按值堆参数移动）。
                // **默认关闭**（TIE_MOVE_CHECK=1 开启）：现有 std/compiler 代码
                // 大量共享语义，迁移完成前开启会导致编译器自身编译失败（干扰
                // S1.2-1.4 并行会话）。std/compiler 全量迁移完成后默认开启。
                var mv_env = get_env("TIE_MOVE_CHECK")
                if str_len(mv_env) > 0 {
                    var r_mv = smove.check_fn_walk(fname)
                    if r_mv < 0 {
                        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
                    }
                }
            }
            i = i + 1
        }
    }
    // S2.2 闭包体延迟检查：所有函数检查完后 FIFO 处理 g_clo_pending
    // （闭包体用登记时 lv 快照重建独立作用域，不影响外层函数）
    var rc = scheck.check_pending_closures()
    if rc < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    return "OK:" + to_string(g_typed)
}

// 内存版 check 核心（T5.3 消除 AST 文本协议往返；前置条件：
// parser.parse_ast 已成功执行、ast 节点池在内存）。
// 与 check_impl(ast_text, base_dir) 语义完全等价：仅把 sstate.load_ast(协议文本)
// 替换为 copy_ast_tables()（内存直拷 ast 表 → sstate 表），import 展开走内存版
// expand_one_import（parse_ast + append_ast_mem）。状态重置、collect 系列、
// 逐函数 check 循环与错误返回格式全部保留。
// 返回 "OK:<typed>" 或 "ERR:<line> <col> <msg>"。
pub func check_ast(base_dir: string) -> string {
    g_cur_dir = base_dir
    s_tags = table_new_i64()
    s_names = table_new_i64()
    s_vals = table_new_i64()
    s_aux = table_new_i64()
    s_coff = table_new_i64()
    s_nchild = table_new_i64()
    s_children = table_new_i64()
    s_lines = table_new_i64()
    s_cols = table_new_i64()
    fn_keys = table_new_i64()
    fn_vals = table_new_i64()
    sg_nparams = table_new_i64()
    sg_required = table_new_i64()
    sg_ret = table_new_i64()
    sg_pub = table_new_i64()
    sg_off = table_new_i64()
    sp_tys = table_new_i64()
    sp_refs = table_new_i64()
    sp_defs = table_new_i64()
    sp_vars = table_new_i64()
    st_keys = table_new_i64()
    st_vals = table_new_i64()
    cls_parent = table_new_i64()
    cls_fldoff = table_new_i64()
    cls_nfld = table_new_i64()
    cls_done = table_new_i64()
    fld_names = table_new_i64()
    fld_tys = table_new_i64()
    // enum 状态表重置（2026-08-15 enum 语言特性；每次编译清零）
    en_keys = table_new_i64()
    en_vals = table_new_i64()
    en_done = table_new_i64()
    en_nvar = table_new_i64()
    en_varoff = table_new_i64()
    en_nslot = table_new_i64()
    en_vnames = table_new_i64()
    en_vtags = table_new_i64()
    en_vfldoff = table_new_i64()
    en_vnfld = table_new_i64()
    en_ftys = table_new_i64()
    gb_keys = table_new_i64()
    gb_vals = table_new_i64()
    gb_const = table_new_i64()
    gb_telem = table_new_i64()
    ext_keys = table_new_i64()
    tre_keys = table_new_i64()
    tre_vals = table_new_i64()
    node_types = table_new_i64()
    lv_keys = table_new_i64()
    lv_vals = table_new_i64()
    lv_const = table_new_i64()
    lv_telem = table_new_i64()
    lv_dyn = table_new_i64()
    lp_stack = table_new_i64()
    lp_top = 0
    ns_stack = table_new_i64()
    ns_top = 0
    using_prefixes = table_new_i64()
    using_lens = table_new_i64()
    tuple_tys = table_new_i64()
    tup_names = table_new_i64()
    tup_tys = table_new_i64()
    tup_offs = table_new_i64()
    tup_n = table_new_i64()
    g_curfn = -1
    g_typed = 0
    sm_err_msg = ""
    // 泛型模板登记表重置（gt_*，T3b 单态化展开器预置；每次编译清零）
    gty_keys = table_new_i64()
    gty_vals = table_new_i64()
    gtyp_nparams = table_new_i64()
    gtyp_off = table_new_i64()
    gtyp_names = table_new_i64()
    gty_node = table_new_i64()
    gty_is_struct = table_new_i64()
    // S2.4：泛型约束段 + port/impl 状态表重置（每次编译清零）
    gtyp_conoff = table_new_i64()
    gtyp_cons = table_new_i64()
    pt_keys = table_new_i64()
    pt_vals = table_new_i64()
    pm_off = table_new_i64()
    pm_n = table_new_i64()
    pm_npar = table_new_i64()
    pm_paroff = table_new_i64()
    pm_ret = table_new_i64()
    pm_names = table_new_i64()
    pm_npars = table_new_i64()
    pm_ptys = table_new_i64()
    pm_rets = table_new_i64()
    im_keys = table_new_i64()
    im_vals = table_new_i64()
    im_port = table_new_i64()
    im_struct = table_new_i64()
    im_poff = table_new_i64()
    im_n = table_new_i64()
    im_mnames = table_new_i64()
    g_impl_pending = table_new_i64()
    // 实例化记录表重置（gin_*，T3b 单态化展开器；每次编译清零）
    gin_keys = table_new_i64()
    gin_vals = table_new_i64()
    gin_tmpl = table_new_i64()
    gin_off = table_new_i64()
    gin_nargs = table_new_i64()
    gin_is_struct = table_new_i64()
    garg_vals = table_new_i64()
    // S2.2 闭包语义全局重置（每次编译清零）
    g_clo_pending = table_new_i64()
    cl_ret = table_new_i64()
    cl_nparams = table_new_i64()
    cl_paroff = table_new_i64()
    cl_ptys = table_new_i64()
    cl_off = table_new_i64()
    cl_nouter = table_new_i64()
    cl_okeys = table_new_i64()
    cl_ovals = table_new_i64()
    cl_oconst = table_new_i64()
    cl_otelem = table_new_i64()
    cl_odyn = table_new_i64()
    cl_paramoff = table_new_i64()
    cl_params = table_new_i64()
    cl_locloff = table_new_i64()
    cl_locals = table_new_i64()
    cl_capoff = table_new_i64()
    cl_capkeys = table_new_i64()
    cl_capvals = table_new_i64()
    g_clo_ret_stack = table_new_i64()
    g_clo_depth = 0
    g_clo_cur = -1
    g_clo_ret_top = 0
    g_inst_depth = 0
    if len(tre_bi_keys) == 0 {
        scollect.tre_bi_init()
    }
    // 内存直拷：ast 节点池 → sstate 9 列（替代 sstate.load_ast 的文本反序列化）
    if copy_ast_tables() < 0 {
        return "ERR:0 0 AST 协议解析失败"
    }
    g_root = s_n - 1
    // S3.3 宏展开 pass（在 import 展开之前：宏定义与使用限主文件；展开结果
    // 参与类型检查）。失败返回与后续同格式的 ERR 协议文本。
    if mexpand.expand_sstate() < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // import 展开（主文件顶层进 g_extra_tops，import 文件递归合并）
    var er = expand_imports()
    if er < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    var r = scollect.collect_top()
    if r < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // S2.4 impl 块统一处理（同 check_impl：方法改名 + 签名登记 + 完整性/
    // 签名检查 + impl 记录；须在 expand_generics 之前——泛型约束校验依赖
    // impl 表就绪）
    var ifr = scollect.collect_impl_fns()
    if ifr < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // 泛型单态化预扫描展开（T3b）：同 check_impl（见其注释）
    var ge = expand_generics()
    if ge < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // 泛型字段类型预实例化（2026-08-14）：字段类型中的模板 struct 引用（如
    // `A<i64>`）在此先行实例化，避免 collect_all_struct_fields 拍平时实例化
    // 副作用顶偏 cls_fldoff（详见 scollect.pre_instantiate_field_types 注释）
    var pr = scollect.pre_instantiate_field_types()
    if pr < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // struct 字段拍平收集（含继承；须在逐函数检查前完成）
    var r3 = scollect.collect_all_struct_fields()
    if r3 < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // enum 变体收集（须在 struct 字段拍平之后——payload 类型可能引用 struct）
    var r5 = scollect.collect_all_enums()
    if r5 < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // 返回表元素预扫描（先于逐函数 check）
    var r4 = scollect.collect_all_return_tables()
    if r4 < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // 逐函数检查（T3b 稳定化，同 check_impl）
    var checked: table<i64> = table_new_i64()
    var again: bool = true
    while again {
        again = false
        var i: i64 = 0
        while i < len(fn_keys) {
            var fid = fn_keys[i]
            var chk: i64 = 0
            var has: bool = false
            while chk < len(checked) {
                if checked[chk] == fid {
                    has = true
                    break
                }
                chk = chk + 1
            }
            if !has {
                table_push(checked, fid)
                again = true
                var fname = intern.lookup(fid)
                // S1.5 移动语义：每函数检查前重置 live/moved 状态表（同 check_impl）
                sstate.lv_moved_reset()
                var r2 = scheck.check_fn_walk(fname)
                if r2 < 0 {
                    return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
                }
                // S1.5 移动语义独立 pass（同 check_impl，TIE_MOVE_CHECK=1 开启）
                var mv_env2 = get_env("TIE_MOVE_CHECK")
                if str_len(mv_env2) > 0 {
                    var r_mv = smove.check_fn_walk(fname)
                    if r_mv < 0 {
                        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
                    }
                }
            }
            i = i + 1
        }
    }
    // S2.2 闭包体延迟检查：所有函数检查完后 FIFO 处理 g_clo_pending
    // （闭包体用登记时 lv 快照重建独立作用域，不影响外层函数）
    var rc = scheck.check_pending_closures()
    if rc < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    return "OK:" + to_string(g_typed)
}

// ==================== 泛型单态化预扫描（T3b） ====================
// 在 collect_top 之后、collect_all_struct_fields 之前调用：遍历 g_extra_tops
// 中的函数体（顶层 + 命名空间递归），重建扫描期局部变量表后逐个推断函数体
// 表达式——infer_call 遇到泛型调用/构造/方法调用时触发 sgen.instantiate_*
// 展开（复制 AST + TypeVar 替换 + mangled 名登记符号表）。展开产生的新函数
// 追加到 g_extra_tops → 入队继续扫描，直到无新函数（去重由 done 表保证）。
// 推断失败静默跳过（错误状态恢复）——正式逐函数检查阶段 infer_call 会再次
// 推断并报告错误，此处只做"能确定就提前展开"的预扫描。
// 返回 0 成功 / -1 内部错误（sm_err_* 已置）。
func expand_generics() -> i64 {
    var queue: table<i64> = table_new_i64()
    var qpos: i64 = 0
    var done: table<i64> = table_new_i64()
    g_scan_extra_last = 0
    // 初始收集：g_extra_tops 顶层 FnDef（非模板）+ 命名空间递归
    var n0 = len(g_extra_tops)
    var i0: i64 = 0
    while i0 < n0 {
        var s0 = g_extra_tops[i0]
        var t0 = s_tags[s0]
        if t0 == S_N_FN_DEF {
            if !is_tmpl_fn(s0) {
                table_push(queue, s0)
            }
        } else if t0 == S_N_NAMESPACE {
            collect_ns_fns(s0, queue)
        }
        i0 = i0 + 1
    }
    // 主循环：扫描函数体（触发展开）→ 新函数入队
    var total: i64 = 0
    while qpos < len(queue) {
        var fn_node = queue[qpos]
        qpos = qpos + 1
        var h: i64 = 0
        var has: bool = false
        while h < len(done) {
            if done[h] == fn_node {
                has = true
                break
            }
            h = h + 1
        }
        if has {
            continue
        }
        table_push(done, fn_node)
        scan_fn_light(fn_node)
        total = total + 1
        if total > 2000 {
            sm_err_line = s_lines[fn_node]
            sm_err_col = s_cols[fn_node]
            sm_err_msg = "泛型实例化规模超限（超过 2000 个实例化函数），疑似无限递归实例化"
            return -1
        }
        // 新展开的函数追加到 g_extra_tops → 入队（去重由 done 保证）
        var n = len(g_extra_tops)
        var i = g_scan_extra_last
        while i < n {
            var s = g_extra_tops[i]
            if s_tags[s] == S_N_FN_DEF && !is_tmpl_fn(s) {
                table_push(queue, s)
            }
            i = i + 1
        }
        g_scan_extra_last = len(g_extra_tops)
    }
    return 0
}

// 泛型模板函数判定（children[0] == N_TYPE_PARAMS）
func is_tmpl_fn(s: i64) -> bool {
    if sstate.nchild(s) > 0 {
        var c0 = sstate.child(s, 0)
        if c0 >= 0 && s_tags[c0] == S_N_TYPE_PARAMS {
            return true
        }
    }
    return false
}

// 命名空间体内递归收集 FnDef（非模板）入队
func collect_ns_fns(ns_node: i64, queue: ref table<i64>) {
    var nsegs = s_aux[ns_node]
    var body = sstate.child(ns_node, nsegs)
    var nb = sstate.nchild(body)
    var j: i64 = 0
    while j < nb {
        var s = sstate.child(body, j)
        var tag = s_tags[s]
        if tag == S_N_FN_DEF {
            if !is_tmpl_fn(s) {
                table_push(queue, s)
            }
        } else if tag == S_N_NAMESPACE {
            collect_ns_fns(s, queue)
        }
        j = j + 1
    }
}

// 推断函数体单函数：重建扫描期局部变量表 → 扫描语句
func scan_fn_light(fn_node: i64) {
    // 重建 lv_*（sinfer.infer_expr 依赖局部作用域）
    lv_keys = table_new_i64()
    lv_vals = table_new_i64()
    lv_const = table_new_i64()
    lv_telem = table_new_i64()
    lv_dyn = table_new_i64()
    var nparams = s_aux[fn_node]
    var k: i64 = 0
    while k < nparams {
        var p = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + k)
        var pname = sstate.name_str(p)
        var pty = sgen.parse_generic_type_node(sstate.child(p, 0))
        if pty >= 0 {
            var telem: i64 = -1
            var dyn: i64 = 0
            if types.is_table(pty) {
                telem = types.table_elem(pty)
                if telem < 0 {
                    telem = types.named(TK_STR)
                }
                dyn = 1
            }
            sinfer.lv_insert(intern.intern(pname), pty, 0, telem, dyn)
        }
        k = k + 1
    }
    var body = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + nparams)
    scan_stmt_light(body)
}

// 推断表达式（错误状态保存/恢复：预扫描阶段的失败不是真错误，
// 正式检查阶段会再次推断并报告）
func infer_expr_safe(e: i64) -> i64 {
    var sl = sm_err_line
    var sc = sm_err_col
    var smg = sm_err_msg
    var t = sinfer.infer_expr(e)
    sm_err_line = sl
    sm_err_col = sc
    sm_err_msg = smg
    return t
}

// 递归扫描语句：推断表达式（触发泛型展开）+ 维护扫描期局部变量表
func scan_stmt_light(s: i64) {
    var tag = s_tags[s]
    if tag == S_N_VAR_DECL {
        var ty_node = sstate.child(s, 0)
        var init = sstate.child(s, 1)
        var ty: i64 = -1
        var it: i64 = -1
        if ty_node >= 0 {
            var sl = sm_err_line
            var sc = sm_err_col
            var smg = sm_err_msg
            ty = sgen.parse_generic_type_node(ty_node)
            sm_err_line = sl
            sm_err_col = sc
            sm_err_msg = smg
        }
        if init >= 0 {
            it = infer_expr_safe(init)
        }
        var use_ty = ty
        if use_ty < 0 {
            use_ty = it
        }
        if use_ty >= 0 {
            var telem: i64 = -1
            var dyn: i64 = 0
            if types.is_table(use_ty) {
                telem = types.table_elem(use_ty)
                if telem < 0 {
                    telem = types.named(TK_STR)
                }
                dyn = 1
            }
            sinfer.lv_insert(intern.intern(sstate.name_str(s)), use_ty, s_vals[s], telem, dyn)
        }
        return
    }
    if tag == S_N_IF {
        infer_expr_safe(sstate.child(s, 0))
        scan_stmt_light(sstate.child(s, 1))
        var el = sstate.child(s, 2)
        if el >= 0 {
            scan_stmt_light(el)
        }
        return
    }
    if tag == S_N_WHILE {
        infer_expr_safe(sstate.child(s, 0))
        scan_stmt_light(sstate.child(s, 1))
        return
    }
    if tag == S_N_FOR {
        infer_expr_safe(sstate.child(s, 0))
        scan_stmt_light(sstate.child(s, 1))
        return
    }
    if tag == S_N_SWITCH {
        infer_expr_safe(sstate.child(s, 0))
        var ncases = s_aux[s]
        var k: i64 = 0
        while k < ncases {
            var c = sstate.child(s, 1 + k)
            scan_stmt_light(sstate.child(c, 2))
            k = k + 1
        }
        var dflt = sstate.child(s, 1 + ncases)
        if dflt >= 0 {
            scan_stmt_light(dflt)
        }
        return
    }
    if tag == S_N_RETURN {
        var v = sstate.child(s, 0)
        if v >= 0 {
            infer_expr_safe(v)
        }
        return
    }
    if tag == S_N_EXPR_STMT {
        infer_expr_safe(sstate.child(s, 0))
        return
    }
    if tag == S_N_ASSIGN {
        var v = sstate.child(s, 1)
        if v >= 0 {
            infer_expr_safe(v)
        }
        return
    }
    if tag == S_N_FIELD_ASSIGN {
        var v = sstate.child(s, 2)
        if v >= 0 {
            infer_expr_safe(v)
        }
        return
    }
    if tag == S_N_INDEX_ASSIGN {
        var v = sstate.child(s, 1)
        if v >= 0 {
            infer_expr_safe(v)
        }
        return
    }
    // 其他语句类型：忽略（内含表达式由子语句递归覆盖）
}

// ==================== 内存版 AST 表复制（T5.3 消除协议往返）====================
// 把 parser.parse_ast 留在内存的 ast 节点池（ast 命名空间 9 列全局表）复制到
// sstate 的 s_* 9 列表。语义与 sstate.load_ast(协议文本) 完全等价——协议文本
// 就是 build_protocol 对 ast 表的逐字节序列化，此处改为直接内存复制，
// 省去大文件数千次 to_string / parse_row / str.slice 子串分配。
// 返回 0（成功；正常不会失败）。
func copy_ast_tables() -> i64 {
    var cnt = ast.count()
    s_n = cnt
    // 重建 9 列 + node_types（对应 sstate.load_ast 的预分配占位 + 逐行覆写；
    // 此处直接 push 真实值，表内容完全一致）
    s_tags = table_new_i64()
    s_names = table_new_i64()
    s_vals = table_new_i64()
    s_aux = table_new_i64()
    s_coff = table_new_i64()
    s_nchild = table_new_i64()
    s_children = table_new_i64()
    s_lines = table_new_i64()
    s_cols = table_new_i64()
    node_types = table_new_i64()
    var k: i64 = 0
    while k < cnt {
        table_push(s_tags, ast.tag(k))
        table_push(s_names, ast.name(k))
        table_push(s_vals, ast.val(k))
        table_push(s_aux, ast.aux(k))
        table_push(s_coff, 0)
        table_push(s_nchild, ast.child_count(k))
        table_push(s_lines, ast.line(k))
        table_push(s_cols, ast.col(k))
        table_push(node_types, -1)
        k = k + 1
    }
    // 第二遍：前缀和计算子段偏移（与 sstate.load_ast 相同的 s_coff 布局）
    var off: i64 = 0
    var j: i64 = 0
    while j < cnt {
        s_coff[j] = off
        off = off + s_nchild[j]
        j = j + 1
    }
    // 第三遍：预分配扁平子段后逐节点填充（ast.child_at 越界返回 -1 哨兵，
    // 与协议字段 f[8+c] 的值域一致）
    s_children = table_new_i64()
    var z: i64 = 0
    while z < off {
        table_push(s_children, 0)
        z = z + 1
    }
    var i: i64 = 0
    while i < cnt {
        var nc = s_nchild[i]
        var base = s_coff[i]
        var c: i64 = 0
        while c < nc {
            s_children[base + c] = ast.child_at(i, c)
            c = c + 1
        }
        i = i + 1
    }
    return 0
}

// 把当前内存 ast 节点池（最近一次 parser.parse_ast 的结果）追加到 sstate 表
// 末尾（import 展开用）。语义与 sstate.append_ast(协议文本) 完全等价：
// 新节点 id = 原 id + base（调用前 s_tags 长度）；子节点 id >= 0 时 +base
// 偏移，-1 哨兵保持。返回新节点段起点 base（调用方用 base + 新文件节点数 - 1
// 定位该文件的顶层 StmtList root）。
func append_ast_mem() -> i64 {
    var cnt = ast.count()
    var base = len(s_tags)
    // 第一遍：逐节点 push 属性列 + node_types=-1（与 sstate.append_ast 的
    // 逐行追加完全对应；new_offs 暂存各新节点的子段偏移占位）
    var new_offs: table<i64> = table_new_i64()
    var i: i64 = 0
    while i < cnt {
        table_push(s_tags, ast.tag(i))
        table_push(s_names, ast.name(i))
        table_push(s_vals, ast.val(i))
        table_push(s_aux, ast.aux(i))
        table_push(s_coff, 0)
        table_push(s_nchild, ast.child_count(i))
        table_push(s_lines, ast.line(i))
        table_push(s_cols, ast.col(i))
        table_push(node_types, -1)
        table_push(new_offs, 0)
        i = i + 1
    }
    // 第二遍：计算新节点子段偏移（相对 s_children 当前末尾的前缀和）
    var off = len(s_children)
    var j: i64 = 0
    while j < cnt {
        new_offs[j] = off
        off = off + s_nchild[base + j]
        j = j + 1
    }
    // 第三遍：填充子节点（id 偏移 +base，-1 哨兵保持）并落盘 s_coff
    var k: i64 = 0
    while k < cnt {
        s_coff[base + k] = new_offs[k]
        var nc = s_nchild[base + k]
        var c: i64 = 0
        while c < nc {
            var cid = ast.child_at(k, c)
            if cid >= 0 {
                cid = cid + base
            }
            table_push(s_children, cid)
            c = c + 1
        }
        k = k + 1
    }
    s_n = len(s_tags)
    return base
}

// ==================== check_debug：可读输出 ====================
// 返回可读的语义摘要（函数签名/struct/全局变量/节点类型表计数）
pub func check_debug(ast_text: string) -> string {
    var r = check(ast_text)
    var out: string = "语义检查: " + r + "\n"
    out = out + "函数签名 (" + to_string(len(fn_keys)) + "):\n"
    var i: i64 = 0
    while i < len(fn_keys) {
        var sig = fn_vals[i]
        out = out + "  " + intern.lookup(fn_keys[i]) + "(" + to_string(sg_nparams[sig]) + " 参数) -> " + types.type_name(sg_ret[sig]) + "\n"
        i = i + 1
    }
    out = out + "struct (" + to_string(len(st_keys)) + "):\n"
    i = 0
    while i < len(st_keys) {
        var si = st_vals[i]
        out = out + "  " + intern.lookup(st_keys[i]) + " (" + to_string(cls_nfld[si]) + " 字段)\n"
        i = i + 1
    }
    out = out + "全局变量 (" + to_string(len(gb_keys)) + "):\n"
    i = 0
    while i < len(gb_keys) {
        out = out + "  " + intern.lookup(gb_keys[i]) + ": " + types.type_name(gb_vals[i]) + "\n"
        i = i + 1
    }
    out = out + "节点类型表 (" + to_string(g_typed) + " 条目)\n"
    return out
}

}
