type tie<class>
// compiler/config.tie —— S3.1 构建配置模块（命名空间 config）
// ============================================================
// 定位：统一构建配置文件 config.data.tie（type tie<data> 角色）的解析、
// L2 分层合并、P3 profile 激活与访问器。规划见 docs/plans/build-config.md。
//
// 文件格式（tie:data 表字面量）：
//   [
//       "target": "win-x64",
//       "opt": 2,
//       "debug": true,
//       "profile": "dev",
//       "tiec": [
//           "backend": "win32",
//           "features": ["async", "macro", "unsafe"],
//           "emit": "exe",
//           "link": ["user32", "gdi32"],
//           "bounds_check": true,
//       ],
//       "prep": [
//           "modules": ["migrate_str_v1.tie"],
//           "strict_roles": true,
//       ],
//       "pkg": [
//           "registry": "https://reg.tie-lang.org",
//           "cache_dir": ".tie/deps",
//           "verify_signature": true,
//       ],
//       "roles": [
//           "test": ["tests/"],
//           "bench": ["bench/"],
//       ],
//       "advanced": [ "enabled": true, "threads": 0 ],
//       "cache": [ "size": 268435456, "storage": "memory", "path": ".tie-cache" ],
//   ]
// 要点：
//   - 表（键值对集合）与数组（值列表）都用 [...]，靠首个条目区分：
//     首个条目是 `"key": value` 形式 → 表；否则 → 数组；
//   - 支持 // 行注释；条目间逗号可选（容忍尾逗号）；
//   - 值类型：字符串 / 整数 / 浮点 / true / false / 嵌套表 / 嵌套数组。
//
// 分层（L2，低 → 高）：
//   内置默认 < 用户 config（~/.config/tie/config.data.tie）
//   < 项目 config（--config 指定或当前目录 config.data.tie）
//   < profile 覆盖（P3：顶层 "profile" 键或 CLI --profile，取 profiles.<名> 表合并）
//   < CLI 覆盖（driver 侧 apply_cli）。
// 合并规则（P3，§5.2）：
//   - 同键双方都是表 → 递归深合并；
//   - 同键双方都是数组 → 追加合并（父层列表 + 本层列表）；
//     layer 值为字符串 "=" 时重置为空列表；
//   - 其余（标量 / 类型不匹配）→ layer 覆盖 base。
//
// 自包含约束（重要）：本模块**不 import 任何库**（含 std/string.tie）——
// 本模块会被 driver.tie 链式引入，std 库重复 import 会让 str 命名空间
// 重复定义导致编译失败（与 toolchain.tie 同约束）；故所有字符串处理
// 只用语言底座原语（str_len/str_char/char_code/parse_int/parse_float/
// table_new_*/table_push/len + 拼接）+ 自带工具（仿 json.tie / manifest）。
//
// 调用：import 后 config.parse_file(...) / config.load_merge(...) /
//   config.get_str(...) / config.get_list(...) 等；命名空间内互调为裸调用。
// 命名规范：命名空间内函数不加 config_ 前缀（统一 func 写法）。
// 错误契约：parse / load 失败返回 -1，c_err_msg 携带消息（成功时为空串）。
//
// 节点表示（平行表，节点 id 为下标，仿 json.tie）：
//   c_types[i]  节点类型：0=null 1=bool 2=int 3=float 4=str 5=array 6=map
//   c_ivals[i]  int/bool 值；str 节点存字符串池 c_strs 的索引
//   c_fvals[i]  float 值
//   c_strs      字符串池（str 节点文本 + map 键文本，登记序去重）
//   c_kids[i]   array/map：子元素在扁平登记表中的起始下标
//   c_ovals[i]  array/map：子元素个数（数组=元素数；表=键值对数）
//   c_elem_flat 数组元素节点 id 扁平表（追加式，永不修改）
//   c_key_flat  map 键（c_strs 索引）扁平表
//   c_val_flat  map 值节点 id 扁平表（与 c_key_flat 平行，同区间）
//   c_err_msg   最近一次操作错误消息（成功时为空串）
// 解析器位置推进：tie 参数按值传递（无引用参数），pos 无法经参数回传，
// 故所有 parse_* 函数共享**模块级全局 g_cpos**（parse 开头置 0），
// 每个函数消费后推进 g_cpos（约定：函数返回时 g_cpos 指向已消费内容
// 之后的首个未消费字符；失败时 g_cpos 指向错误处）。

// ==================== 节点存储（模块级全局，命名空间外） ====================
var c_types: table<i64>;
var c_ivals: table<i64>;
var c_fvals: table<f64>;
var c_strs: table<string>;
var c_kids: table<i64>;
var c_ovals: table<i64>;
var c_elem_flat: table<i64>;
var c_key_flat: table<i64>;
var c_val_flat: table<i64>;
var c_err_msg: string = "";
// 解析器位置游标（全局，见文件头"位置推进"说明）
var g_cpos: i64 = 0;

namespace config {
// ---------- 节点构造（内部） ----------

// 新建一个节点，返回节点 id。类型码入 c_types，其余槽位填默认值。
func new_node(ty: i64) -> i64 {
    table_push(c_types, ty)
    table_push(c_ivals, 0)
    table_push(c_fvals, 0.0)
    table_push(c_strs, "")
    table_push(c_kids, -1)
    table_push(c_ovals, 0)
    return len(c_types) - 1
}

// 字符串节点：文本入字符串池 c_strs，节点 c_ivals 存其索引。返回节点 id。
func new_str_node(content: string) -> i64 {
    var n = new_node(4)
    var idx: i64 = -1
    var i: i64 = 0
    // 池内去重（与 json 一致：同文本复用索引）
    while i < len(c_strs) {
        if c_strs[i] == content {
            idx = i
        }
        i = i + 1
    }
    if idx < 0 {
        table_push(c_strs, content)
        idx = len(c_strs) - 1
    }
    c_ivals[n] = idx
    return n
}

// 表键登记：向 map 节点追加一个键值对（键为字符串，值节点已构造）。
// 返回 map 节点 id（链式构造用）。
func map_add(n: i64, key: string, val: i64) -> i64 {
    // 键入字符串池（去重），登记键/值
    var k = new_str_node(key)
    table_push(c_key_flat, c_ivals[k])
    table_push(c_val_flat, val)
    c_ovals[n] = c_ovals[n] + 1
    return n
}

// 数组追加一个元素节点。返回 array 节点 id（链式构造用）。
func arr_add(n: i64, val: i64) -> i64 {
    table_push(c_elem_flat, val)
    c_ovals[n] = c_ovals[n] + 1
    return n
}

// 把收集到的键值对一次性登记到全局扁平表，并设置节点键区间。
// 关键：一个 map 的键必须在全局 flat 中连续存放——嵌套构造/解析时若
// 边解析边 push，内层表的键会插入外层表的键序列中间，破坏 map_get 的
// 区间扫描。故所有「构造表」路径都先收集到局部表，完成后统一登记。
func commit_map(n: i64, keys: table<string>, vals: table<i64>) {
    var cnt: i64 = len(keys)
    c_kids[n] = len(c_key_flat)
    c_ovals[n] = cnt
    var i: i64 = 0
    while i < cnt {
        var k = new_str_node(keys[i])
        table_push(c_key_flat, c_ivals[k])
        table_push(c_val_flat, vals[i])
        i = i + 1
    }
}

// 表键覆盖：把 n 中已存在的 key 的值槽替换为 val（不新增键）。
// 键不存在返回 -1（调用方决定如何处理）；成功返回 n。
// 用于 apply_cli：CLI 覆盖的都是默认/配置文件里已有的键，原地改槽位
// 不会破坏全局扁平表的连续布局（新增键需 push 到末尾，会打乱区间）。
func map_set(n: i64, key: string, val: i64) -> i64 {
    if type_of(n) != 6 {
        return -1
    }
    var start: i64 = c_kids[n]
    var cnt: i64 = c_ovals[n]
    var i: i64 = 0
    while i < cnt {
        if c_strs[c_key_flat[start + i]] == key {
            c_val_flat[start + i] = val
            return n
        }
        i = i + 1
    }
    return -1
}

// ---------- 字符串工具（自备，只依赖底座原语） ----------

// 截取 s 的 [start, end) 子串（码点级）；越界自动收敛；start>=end 返回空串。
func slice(s: string, start: i64, end: i64) -> string {
    var n: i64 = str_len(s)
    var lo: i64 = start
    if lo < 0 {
        lo = 0
    }
    if lo > n {
        lo = n
    }
    var hi: i64 = end
    if hi < 0 {
        hi = 0
    }
    if hi > n {
        hi = n
    }
    var out: string = ""
    var i: i64 = lo
    while i < hi {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

// 查找 sub 在 s 中首次出现的位置（0 起字符索引）；未找到返回 -1。
func find(s: string, sub: string) -> i64 {
    var n: i64 = str_len(s)
    var m: i64 = str_len(sub)
    if m == 0 {
        return 0
    }
    if m > n {
        return -1
    }
    var i: i64 = 0
    while i <= n - m {
        var j: i64 = 0
        var matched: bool = true
        while j < m && matched {
            // 嵌套 if 防越界：i+j 必在 [0, n) 内（外层保证 i <= n-m）
            if str_char(s, i + j) != str_char(sub, j) {
                matched = false
            }
            j = j + 1
        }
        if matched {
            return i
        }
        i = i + 1
    }
    return -1
}

// 判断 s 是否以 prefix 开头。
func starts_with(s: string, prefix: string) -> bool {
    var n: i64 = str_len(s)
    var m: i64 = str_len(prefix)
    if m > n {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_char(s, i) != str_char(prefix, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// ---------- 解析（递归下降） ----------

// 跳过空白（空格 32 / 制表 9 / 换行 10 / 回车 13）与 // 行注释，推进 g_cpos。
func skip_ws(s: string) {
    var n: i64 = str_len(s)
    while g_cpos < n {
        var c = str_char(s, g_cpos)
        var cp: i64 = char_code(c)
        if cp == 32 || cp == 9 || cp == 10 || cp == 13 {
            g_cpos = g_cpos + 1
        } else if cp == 47 && g_cpos + 1 < n && str_char(s, g_cpos + 1) == "/" {
            // 行注释：跳到行尾（换行符本身由下一轮跳过）
            while g_cpos < n {
                if str_char(s, g_cpos) == "\n" {
                    break
                }
                g_cpos = g_cpos + 1
            }
        } else {
            return
        }
    }
}

// 解析字符串（含引号）：处理转义 \" \\ \/ \n \r \t。
// 返回 str 节点 id；失败 -1（c_err_msg 已置）。
func parse_string(s: string) -> i64 {
    var n: i64 = str_len(s)
    // 跳过开引号
    g_cpos = g_cpos + 1
    var out: string = ""
    while g_cpos < n {
        var c = str_char(s, g_cpos)
        if c == "\"" {
            // 闭引号：返回字符串节点
            g_cpos = g_cpos + 1
            return new_str_node(out)
        }
        if c == "\\" {
            // 转义序列
            if g_cpos + 1 >= n {
                c_err_msg = "config 字符串转义不完整（位置 " + to_string(g_cpos) + "）"
                return -1
            }
            var e = str_char(s, g_cpos + 1)
            if e == "\"" {
                out = out + "\""
                g_cpos = g_cpos + 2
            } else if e == "\\" {
                out = out + "\\"
                g_cpos = g_cpos + 2
            } else if e == "/" {
                out = out + "/"
                g_cpos = g_cpos + 2
            } else if e == "n" {
                out = out + "\n"
                g_cpos = g_cpos + 2
            } else if e == "r" {
                out = out + "\r"
                g_cpos = g_cpos + 2
            } else if e == "t" {
                out = out + "\t"
                g_cpos = g_cpos + 2
            } else {
                c_err_msg = "config 未知转义 \\" + e + "（位置 " + to_string(g_cpos) + "）"
                return -1
            }
        } else {
            out = out + c
            g_cpos = g_cpos + 1
        }
    }
    c_err_msg = "config 字符串未闭合"
    return -1
}

// 解析关键字字面量（true/false）：匹配整个关键字。
func parse_literal(s: string, word: string, value: i64) -> i64 {
    var m: i64 = str_len(word)
    var n: i64 = str_len(s)
    var i: i64 = 0
    while i < m {
        if g_cpos + i >= n || str_char(s, g_cpos + i) != str_char(word, i) {
            c_err_msg = "config 字面量不完整（位置 " + to_string(g_cpos) + "）"
            return -1
        }
        i = i + 1
    }
    g_cpos = g_cpos + m
    var nd = new_node(1)
    c_ivals[nd] = value
    return nd
}

// 解析数字：-? 整数 (. 小数)?。收集数字字符后用 parse_int/parse_float 解析。
func parse_number(s: string) -> i64 {
    var n: i64 = str_len(s)
    var digits: string = ""
    // 可选负号
    if g_cpos < n && str_char(s, g_cpos) == "-" {
        digits = digits + "-"
        g_cpos = g_cpos + 1
    }
    var is_float: bool = false
    var started: bool = false
    // 整数部分
    while g_cpos < n {
        var c = str_char(s, g_cpos)
        var cp: i64 = char_code(c)
        if cp >= 48 && cp <= 57 {
            digits = digits + c
            started = true
            g_cpos = g_cpos + 1
        } else {
            break
        }
    }
    if !started {
        c_err_msg = "config 数字缺少整数部分（位置 " + to_string(g_cpos) + "）"
        return -1
    }
    // 小数部分
    if g_cpos < n && str_char(s, g_cpos) == "." {
        is_float = true
        digits = digits + "."
        g_cpos = g_cpos + 1
        var fstarted: bool = false
        while g_cpos < n {
            var c2 = str_char(s, g_cpos)
            var cp2: i64 = char_code(c2)
            if cp2 >= 48 && cp2 <= 57 {
                digits = digits + c2
                fstarted = true
                g_cpos = g_cpos + 1
            } else {
                break
            }
        }
        if !fstarted {
            c_err_msg = "config 数字小数部分缺少数字（位置 " + to_string(g_cpos) + "）"
            return -1
        }
    }
    if is_float {
        var nd = new_node(3)
        c_fvals[nd] = parse_float(digits)
        return nd
    }
    var nd2 = new_node(2)
    c_ivals[nd2] = parse_int(digits)
    return nd2
}

// 解析一个值（表/数组/字符串/数字/布尔），推进 g_cpos。失败返回 -1。
// 注意：str_char 返回的单字符立即用于比较，不跨函数持有。
func parse_value(s: string) -> i64 {
    skip_ws(s)
    var n: i64 = str_len(s)
    if g_cpos >= n {
        c_err_msg = "config 值意外结束"
        return -1
    }
    var c = str_char(s, g_cpos)
    var cp: i64 = char_code(c)
    if cp == 91 {
        return parse_container(s)
    }
    if cp == 34 {
        return parse_string(s)
    }
    if cp == 116 {
        return parse_literal(s, "true", 1)
    }
    if cp == 102 {
        return parse_literal(s, "false", 0)
    }
    if cp == 45 || (cp >= 48 && cp <= 57) {
        return parse_number(s)
    }
    c_err_msg = "config 值意外字符（位置 " + to_string(g_cpos) + "）"
    return -1
}

// 解析容器 [ ... ]：表（键值对）或数组（值列表），靠首个条目区分。
// 首条目是 `"key": value` 形式 → 表；否则 → 数组。空容器视为空数组。
// 条目间逗号可选（容忍尾逗号：] 前的 , 跳过）。
func parse_container(s: string) -> i64 {
    var n: i64 = str_len(s)
    // 跳过 [
    g_cpos = g_cpos + 1
    skip_ws(s)
    // 空容器：直接 ] → 空数组
    if g_cpos < n && str_char(s, g_cpos) == "]" {
        var en = new_node(5)
        c_kids[en] = len(c_elem_flat)
        c_ovals[en] = 0
        g_cpos = g_cpos + 1
        return en
    }
    // 探测首条目形态：读一个字符串，看其后是否跟 ':'（表键）还是裸值
    skip_ws(s)
    if g_cpos >= n {
        c_err_msg = "config 容器未闭合"
        return -1
    }
    var is_map: bool = false
    if str_char(s, g_cpos) == "\"" {
        // 可能是键（表）或字符串元素（数组）：先解析字符串，再窥探 ':'
        var save: i64 = g_cpos
        var probe = parse_string(s)
        if probe < 0 {
            return -1
        }
        skip_ws(s)
        if g_cpos < n && str_char(s, g_cpos) == ":" {
            is_map = true
        }
        // 无论表还是数组：游标回退到探测起点，由 body 函数统一从头解析
        //（probe 节点丢弃；表形态 body 会重新读键，数组形态 body 会重新读值）
        g_cpos = save
    }
    if is_map {
        return parse_map_body(s)
    }
    return parse_array_body(s)
}

// 解析表主体（首个键已确认存在，尚未消费）：`"key": value, ...`。
func parse_map_body(s: string) -> i64 {
    var n: i64 = str_len(s)
    var nd = new_node(6)
    // 键/值先收集到局部表，解析完成后统一登记到全局扁平表：
    // 嵌套子表解析时会向 c_key_flat/c_val_flat push 自身键值，
    // 若边解析边登记，子表条目会插入本表键区间中间，破坏连续布局。
    var keys: table<string> = table_new_string()
    var vals: table<i64> = table_new_i64()
    var cnt: i64 = 0
    while true {
        skip_ws(s)
        if g_cpos >= n {
            c_err_msg = "config 表未闭合"
            return -1
        }
        // 键必须是字符串
        if str_char(s, g_cpos) != "\"" {
            c_err_msg = "config 表键必须是字符串（位置 " + to_string(g_cpos) + "）"
            return -1
        }
        var knode = parse_string(s)
        if knode < 0 {
            return -1
        }
        var ktext = c_strs[c_ivals[knode]]
        table_push(keys, ktext)
        skip_ws(s)
        if g_cpos >= n || str_char(s, g_cpos) != ":" {
            c_err_msg = "config 表期望 :（位置 " + to_string(g_cpos) + "）"
            return -1
        }
        g_cpos = g_cpos + 1
        var v = parse_value(s)
        if v < 0 {
            return -1
        }
        table_push(vals, v)
        cnt = cnt + 1
        skip_ws(s)
        if g_cpos >= n {
            c_err_msg = "config 表未闭合"
            return -1
        }
        var c = str_char(s, g_cpos)
        if c == "," {
            g_cpos = g_cpos + 1
            // 尾逗号：跳过空白后若直接是 ] 则闭合
            skip_ws(s)
            if g_cpos < n && str_char(s, g_cpos) == "]" {
                g_cpos = g_cpos + 1
                break
            }
        } else if c == "]" {
            g_cpos = g_cpos + 1
            break
        } else {
            c_err_msg = "config 表期望 , 或 ]（位置 " + to_string(g_cpos) + "）"
            return -1
        }
    }
    commit_map(nd, keys, vals)
    return nd
}

// 解析数组主体（首元素尚未消费）：`v1, v2, ...`。
// 元素先收集到局部表，完成后统一登记（同 parse_map_body：嵌套子表解析
// 时内层元素先 push 到全局 c_elem_flat，若边解析边登记会插入本数组
// 元素序列中间，破坏区间扫描）。
func parse_array_body(s: string) -> i64 {
    var n: i64 = str_len(s)
    var nd = new_node(5)
    var elems: table<i64> = table_new_i64()
    var cnt: i64 = 0
    while true {
        var v = parse_value(s)
        if v < 0 {
            return -1
        }
        table_push(elems, v)
        cnt = cnt + 1
        skip_ws(s)
        if g_cpos >= n {
            c_err_msg = "config 数组未闭合"
            return -1
        }
        var c = str_char(s, g_cpos)
        if c == "," {
            g_cpos = g_cpos + 1
            // 尾逗号：跳过空白后若直接是 ] 则闭合
            skip_ws(s)
            if g_cpos < n && str_char(s, g_cpos) == "]" {
                g_cpos = g_cpos + 1
                break
            }
        } else if c == "]" {
            g_cpos = g_cpos + 1
            break
        } else {
            c_err_msg = "config 数组期望 , 或 ]（位置 " + to_string(g_cpos) + "）"
            return -1
        }
    }
    c_kids[nd] = len(c_elem_flat)
    c_ovals[nd] = cnt
    var i: i64 = 0
    while i < cnt {
        table_push(c_elem_flat, elems[i])
        i = i + 1
    }
    return nd
}

// 剥离 config 文件头部的声明行/注释行/空行（`type tie<data>` 等），返回纯表文本。
// 规则：跳过文件开头所有空行、// 注释行、`type tie` 声明行；遇首个其他行停止。
func strip_header(src: string) -> string {
    var lines: table<string> = table_new_string()
    var cur: string = ""
    var n: i64 = str_len(src)
    var i: i64 = 0
    while i < n {
        var c = str_char(src, i)
        if c == "\n" {
            table_push(lines, cur)
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    if str_len(cur) > 0 {
        table_push(lines, cur)
    }
    var out: string = ""
    var k: i64 = 0
    var started: bool = false
    while k < len(lines) {
        var line = lines[k]
        var t = trim(line)
        if !started {
            if str_len(t) == 0 {
                // 空行跳过
                k = k + 1
                continue
            }
            if starts_with(t, "//") {
                // 注释行跳过
                k = k + 1
                continue
            }
            if starts_with(t, "type tie") {
                // 声明行跳过
                k = k + 1
                continue
            }
            started = true
        }
        if str_len(out) > 0 {
            out = out + "\n"
        }
        out = out + line
        k = k + 1
    }
    return out
}

// 去除字符串首尾空白（空格/制表/换行/回车）。
func trim(s: string) -> string {
    var n: i64 = str_len(s)
    var start: i64 = 0
    while start < n {
        var c = str_char(s, start)
        var cp: i64 = char_code(c)
        if cp == 32 || cp == 9 || cp == 10 || cp == 13 {
            start = start + 1
        } else {
            break
        }
    }
    var end: i64 = n
    while end > start {
        var c2 = str_char(s, end - 1)
        var cp2: i64 = char_code(c2)
        if cp2 == 32 || cp2 == 9 || cp2 == 10 || cp2 == 13 {
            end = end - 1
        } else {
            break
        }
    }
    return slice(s, start, end)
}

// ---------- 解析入口（pub） ----------

// 重置节点存储：清空全部列式表 + 错误消息 + 游标。
func reset_store() {
    c_types = table_new_i64()
    c_ivals = table_new_i64()
    c_fvals = table_new_f64()
    c_strs = table_new_string()
    c_kids = table_new_i64()
    c_ovals = table_new_i64()
    c_elem_flat = table_new_i64()
    c_key_flat = table_new_i64()
    c_val_flat = table_new_i64()
    c_err_msg = ""
    g_cpos = 0
}

// 追加解析（不重置存储）：在既有节点存储之上继续解析，返回根节点 id（>=0）；
// 失败 -1。游标/错误消息归零，但不清空列式表——先前的节点 id 保持有效，
// 供 load_merge 分层合并使用（避免 build_defaults 的根被后续解析清空）。
pub func parse_append(s: string) -> i64 {
    c_err_msg = ""
    g_cpos = 0
    var root = parse_value(s)
    if root < 0 {
        return -1
    }
    // 根值后只允许空白
    skip_ws(s)
    if g_cpos < str_len(s) {
        c_err_msg = "config 根值后有额外内容（位置 " + to_string(g_cpos) + "）"
        return -1
    }
    return root
}

// 解析 config 文本（已剥离头部声明），成功返回根节点 id（>=0）；失败 -1。
// 顶层必须恰一个容器（表或数组）；允许前后空白。独立解析（先重置存储）。
pub func parse(s: string) -> i64 {
    reset_store()
    return parse_append(s)
}

// 解析 config 文件（file_read + 剥离头部 + parse）；失败返回 -1（c_err_msg 含信息）。
pub func parse_file(path: string) -> i64 {
    var content = file_read(path)
    if str_len(content) == 0 {
        c_err_msg = "config 文件为空或读取失败: " + path
        return -1
    }
    var body = strip_header(content)
    return parse(body)
}

// 追加解析 config 文件（不重置存储）：供 load_merge 分层加载使用。
// 失败返回 -1（c_err_msg 含信息）。
func parse_file_append(path: string) -> i64 {
    var content = file_read(path)
    if str_len(content) == 0 {
        c_err_msg = "config 文件为空或读取失败: " + path
        return -1
    }
    var body = strip_header(content)
    return parse_append(body)
}

// 最近一次操作的错误消息（成功时为空串）。
pub func err_msg() -> string {
    return c_err_msg
}

// ---------- 访问器 ----------

// 节点类型码（0-6；非法 id 返回 -1）。
pub func type_of(n: i64) -> i64 {
    if n < 0 || n >= len(c_types) {
        return -1
    }
    return c_types[n]
}

// int/bool 节点的值（bool: 0/1；其他类型返回 0）。
pub func int_val(n: i64) -> i64 {
    if n < 0 || n >= len(c_types) {
        return 0
    }
    if c_types[n] == 1 || c_types[n] == 2 {
        return c_ivals[n]
    }
    return 0
}

// str 节点的文本（其他类型返回空串）。
pub func str_val(n: i64) -> string {
    if n < 0 || n >= len(c_types) {
        return ""
    }
    if c_types[n] == 4 {
        return c_strs[c_ivals[n]]
    }
    return ""
}

// 数组元素个数（非数组返回 0）。
pub func arr_len(n: i64) -> i64 {
    if type_of(n) != 5 {
        return 0
    }
    return c_ovals[n]
}

// 数组第 i 个元素节点（越界返回 -1）。
pub func arr_at(n: i64, i: i64) -> i64 {
    if type_of(n) != 5 {
        return -1
    }
    if i < 0 || i >= c_ovals[n] {
        return -1
    }
    return c_elem_flat[c_kids[n] + i]
}

// 表按键取值节点（键不存在返回 -1；重复键取最后登记——区间靠后者）。
pub func map_get(n: i64, key: string) -> i64 {
    if type_of(n) != 6 {
        return -1
    }
    var start: i64 = c_kids[n]
    var cnt: i64 = c_ovals[n]
    var found: i64 = -1
    var i: i64 = 0
    while i < cnt {
        if c_strs[c_key_flat[start + i]] == key {
            found = c_val_flat[start + i]
        }
        i = i + 1
    }
    return found
}

// 表键个数（非表返回 0）。
pub func map_len(n: i64) -> i64 {
    if type_of(n) != 6 {
        return 0
    }
    return c_ovals[n]
}

// 表第 i 个键名（越界返回空串）。
pub func map_key(n: i64, i: i64) -> string {
    if type_of(n) != 6 {
        return ""
    }
    if i < 0 || i >= c_ovals[n] {
        return ""
    }
    return c_strs[c_key_flat[c_kids[n] + i]]
}

// 表第 i 个值节点（越界返回 -1）。
pub func map_val(n: i64, i: i64) -> i64 {
    if type_of(n) != 6 {
        return -1
    }
    if i < 0 || i >= c_ovals[n] {
        return -1
    }
    return c_val_flat[c_kids[n] + i]
}

// 点分路径查找：path 形如 "tiec.backend"（空段忽略）。
// 逐段 map_get 下钻；任何一段不是表/不存在 → 返回 -1。
pub func path_get(root: i64, path: string) -> i64 {
    if type_of(root) != 6 {
        return -1
    }
    var n: i64 = str_len(path)
    if n == 0 {
        return root
    }
    var cur: i64 = root
    var seg: string = ""
    var i: i64 = 0
    while i <= n {
        var at_end: bool = (i == n)
        var is_dot: bool = false
        if !at_end {
            if str_char(path, i) == "." {
                is_dot = true
            }
        }
        if at_end || is_dot {
            if str_len(seg) > 0 {
                cur = map_get(cur, seg)
                if cur < 0 {
                    return -1
                }
                // 段间不要求中间节点是表（map_get 本身已校验）
                seg = ""
            }
        } else {
            seg = seg + str_char(path, i)
        }
        i = i + 1
    }
    return cur
}

// 便捷访问：路径字符串值（不存在/非字符串 → 空串）。
pub func get_str(root: i64, path: string) -> string {
    var n = path_get(root, path)
    if n < 0 {
        return ""
    }
    return str_val(n)
}

// 便捷访问：路径整数值（不存在/非整数 → 0）。
pub func get_int(root: i64, path: string) -> i64 {
    var n = path_get(root, path)
    if n < 0 {
        return 0
    }
    return int_val(n)
}

// 便捷访问：路径布尔值（不存在/非布尔 → false）。
pub func get_bool(root: i64, path: string) -> bool {
    var n = path_get(root, path)
    if n < 0 {
        return false
    }
    return int_val(n) != 0
}

// 便捷访问：路径数组/字符串 → 逗号分隔序列（跨模块传参载体，规避表参数限制）。
// 数组：逐元素拼接（元素取 str_val，非字符串元素跳过）；字符串：原样返回。
// 不存在 → 空串。
pub func get_list(root: i64, path: string) -> string {
    var n = path_get(root, path)
    if n < 0 {
        return ""
    }
    if type_of(n) == 4 {
        return str_val(n)
    }
    if type_of(n) != 5 {
        return ""
    }
    var out: string = ""
    var cnt: i64 = c_ovals[n]
    var i: i64 = 0
    while i < cnt {
        var e = c_elem_flat[c_kids[n] + i]
        if type_of(e) == 4 {
            if out != "" {
                out = out + ","
            }
            out = out + c_strs[c_ivals[e]]
        }
        i = i + 1
    }
    return out
}

// ---------- 合并（P3 分层合并引擎） ----------

// 数组追加合并：a 元素 + b 元素 → 新数组节点。仅字符串元素保留（配置列表
// 元素均为字符串）；非字符串元素跳过（防类型混杂）。
func concat_arrays(a: i64, b: i64) -> i64 {
    var nd = new_node(5)
    c_kids[nd] = len(c_elem_flat)
    c_ovals[nd] = 0
    var i: i64 = 0
    var n1: i64 = c_ovals[a]
    while i < n1 {
        var e = c_elem_flat[c_kids[a] + i]
        if type_of(e) == 4 {
            arr_add(nd, e)
        }
        i = i + 1
    }
    var j: i64 = 0
    var n2: i64 = c_ovals[b]
    while j < n2 {
        var e2 = c_elem_flat[c_kids[b] + j]
        if type_of(e2) == 4 {
            arr_add(nd, e2)
        }
        j = j + 1
    }
    return nd
}

// 单值合并：决定同键下 base 值 bv 与 layer 值 lv 的合并结果。
// 规则（P3 §5.2）：
//   - 双方都是表 → 递归深合并（merge_maps）；
//   - 双方都是数组 → 追加合并；
//   - layer 值为字符串 "=" → 重置为空数组（清空父层列表）；
//   - 其余（标量/类型不匹配）→ layer 覆盖 base。
func merge_value(bv: i64, lv: i64) -> i64 {
    var bt = type_of(bv)
    var lt = type_of(lv)
    if bt == 6 && lt == 6 {
        return merge_maps(bv, lv)
    }
    if lt == 4 && str_val(lv) == "=" {
        // 重置标记：空数组
        var en = new_node(5)
        c_kids[en] = len(c_elem_flat)
        c_ovals[en] = 0
        return en
    }
    if bt == 5 && lt == 5 {
        return concat_arrays(bv, lv)
    }
    return lv
}

// 深合并两个表节点 → 新表节点（不修改原节点）。
// 过程：先复制 base 全部键值（同键用 merge_value 合并 layer 值）；
// 再追加 layer 独有的键。键值收集到局部表后统一登记（同 parse_map_body
// 的原因：merge_value 递归合并子表时会向全局扁平表 push，若边合并边
// 登记，子表条目会插入本表键区间中间，破坏 map_get 的区间扫描）。
func merge_maps(b: i64, l: i64) -> i64 {
    var nd = new_node(6)
    var keys: table<string> = table_new_string()
    var vals: table<i64> = table_new_i64()
    // 1) base 的键：同键合并 / 独有保留
    var b_start: i64 = c_kids[b]
    var b_cnt: i64 = c_ovals[b]
    var i: i64 = 0
    while i < b_cnt {
        var key = c_strs[c_key_flat[b_start + i]]
        var bv = c_val_flat[b_start + i]
        var lv = map_get(l, key)
        if lv >= 0 {
            var mv = merge_value(bv, lv)
            table_push(keys, key)
            table_push(vals, mv)
        } else {
            table_push(keys, key)
            table_push(vals, bv)
        }
        i = i + 1
    }
    // 2) layer 独有的键（base 中不存在的）→ 直接追加
    var l_start: i64 = c_kids[l]
    var l_cnt: i64 = c_ovals[l]
    var j: i64 = 0
    while j < l_cnt {
        var lkey = c_strs[c_key_flat[l_start + j]]
        var in_base: bool = (map_get(b, lkey) >= 0)
        if !in_base {
            table_push(keys, lkey)
            table_push(vals, c_val_flat[l_start + j])
        }
        j = j + 1
    }
    commit_map(nd, keys, vals)
    return nd
}

// 合并两层配置根（顶层均为表）：返回新根节点（不修改原节点）。
pub func merge(base: i64, layer: i64) -> i64 {
    if type_of(base) != 6 || type_of(layer) != 6 {
        c_err_msg = "config 合并要求顶层均为表（[ \"key\": value, ... ]）"
        return -1
    }
    return merge_maps(base, layer)
}

// ---------- 内置默认 + 分层加载 ----------

// 构造内置默认配置根（表节点）。D1-D7 域默认值 + profiles 节。
// 返回根节点 id。
// 布局纪律：所有表均「先收集键值到局部表，最后 commit_map 统一登记」，
// 保证每个表的键在全局 c_key_flat 中连续——嵌套子表若边构造边 push，
// 子表键会插入父表键区间中间，破坏 map_get 的区间扫描。
func build_defaults() -> i64 {
    // ---------- 子树：tiec ----------
    var tiec_keys: table<string> = table_new_string()
    var tiec_vals: table<i64> = table_new_i64()
    table_push(tiec_keys, "backend")
    table_push(tiec_vals, new_str_node("win32"))
    // D4 features：空列表（语言特性开关）
    var feats = new_node(5)
    c_kids[feats] = len(c_elem_flat)
    c_ovals[feats] = 0
    table_push(tiec_keys, "features")
    table_push(tiec_vals, feats)
    // D6 link：空列表（系统库）
    var links = new_node(5)
    c_kids[links] = len(c_elem_flat)
    c_ovals[links] = 0
    table_push(tiec_keys, "link")
    table_push(tiec_vals, links)
    // D3 细分：emit 产出形态、bounds_check 越界检查
    table_push(tiec_keys, "emit")
    table_push(tiec_vals, new_str_node("exe"))
    var bc_n = new_node(1)
    c_ivals[bc_n] = 0
    table_push(tiec_keys, "bounds_check")
    table_push(tiec_vals, bc_n)
    var tiec = new_node(6)
    commit_map(tiec, tiec_keys, tiec_vals)
    // ---------- 子树：prep ----------
    var prep_keys: table<string> = table_new_string()
    var prep_vals: table<i64> = table_new_i64()
    var mods = new_node(5)
    c_kids[mods] = len(c_elem_flat)
    c_ovals[mods] = 0
    table_push(prep_keys, "modules")
    table_push(prep_vals, mods)
    var sr_n = new_node(1)
    c_ivals[sr_n] = 0
    table_push(prep_keys, "strict_roles")
    table_push(prep_vals, sr_n)
    var prep = new_node(6)
    commit_map(prep, prep_keys, prep_vals)
    // ---------- 子树：pkg ----------
    var pkg_keys: table<string> = table_new_string()
    var pkg_vals: table<i64> = table_new_i64()
    table_push(pkg_keys, "registry")
    table_push(pkg_vals, new_str_node(""))
    table_push(pkg_keys, "cache_dir")
    table_push(pkg_vals, new_str_node(".tie/deps"))
    var vs_n = new_node(1)
    c_ivals[vs_n] = 0
    table_push(pkg_keys, "verify_signature")
    table_push(pkg_vals, vs_n)
    var pkg = new_node(6)
    commit_map(pkg, pkg_keys, pkg_vals)
    // ---------- 子树：roles ----------
    var roles_keys: table<string> = table_new_string()
    var roles_vals: table<i64> = table_new_i64()
    var tests = new_node(5)
    c_kids[tests] = len(c_elem_flat)
    c_ovals[tests] = 0
    arr_add(tests, new_str_node("tests/"))
    table_push(roles_keys, "test")
    table_push(roles_vals, tests)
    var benchs = new_node(5)
    c_kids[benchs] = len(c_elem_flat)
    c_ovals[benchs] = 0
    arr_add(benchs, new_str_node("bench/"))
    table_push(roles_keys, "bench")
    table_push(roles_vals, benchs)
    var roles = new_node(6)
    commit_map(roles, roles_keys, roles_vals)
    // ---------- 子树：advanced ----------
    var adv_keys: table<string> = table_new_string()
    var adv_vals: table<i64> = table_new_i64()
    var adv_en = new_node(1)
    c_ivals[adv_en] = 0
    table_push(adv_keys, "enabled")
    table_push(adv_vals, adv_en)
    var th_n = new_node(2)
    c_ivals[th_n] = 0
    table_push(adv_keys, "threads")
    table_push(adv_vals, th_n)
    var adv = new_node(6)
    commit_map(adv, adv_keys, adv_vals)
    // ---------- 子树：cache ----------
    var cache_keys: table<string> = table_new_string()
    var cache_vals: table<i64> = table_new_i64()
    var size_n = new_node(2)
    c_ivals[size_n] = 268435456
    table_push(cache_keys, "size")
    table_push(cache_vals, size_n)
    table_push(cache_keys, "storage")
    table_push(cache_vals, new_str_node("memory"))
    table_push(cache_keys, "path")
    table_push(cache_vals, new_str_node(".tie-cache"))
    var cache = new_node(6)
    commit_map(cache, cache_keys, cache_vals)
    // ---------- 子树：profiles（dev / release） ----------
    // dev：debug=true, opt=0, tiec.bounds_check=true
    var dev_tiec_keys: table<string> = table_new_string()
    var dev_tiec_vals: table<i64> = table_new_i64()
    var dev_bc = new_node(1)
    c_ivals[dev_bc] = 1
    table_push(dev_tiec_keys, "bounds_check")
    table_push(dev_tiec_vals, dev_bc)
    var dev_tiec = new_node(6)
    commit_map(dev_tiec, dev_tiec_keys, dev_tiec_vals)
    var dev_keys: table<string> = table_new_string()
    var dev_vals: table<i64> = table_new_i64()
    var dev_dbg = new_node(1)
    c_ivals[dev_dbg] = 1
    table_push(dev_keys, "debug")
    table_push(dev_vals, dev_dbg)
    var dev_opt = new_node(2)
    c_ivals[dev_opt] = 0
    table_push(dev_keys, "opt")
    table_push(dev_vals, dev_opt)
    table_push(dev_keys, "tiec")
    table_push(dev_vals, dev_tiec)
    var dev = new_node(6)
    commit_map(dev, dev_keys, dev_vals)
    // release：debug=false, opt=2, tiec.bounds_check=false
    var rel_tiec_keys: table<string> = table_new_string()
    var rel_tiec_vals: table<i64> = table_new_i64()
    var rel_bc = new_node(1)
    c_ivals[rel_bc] = 0
    table_push(rel_tiec_keys, "bounds_check")
    table_push(rel_tiec_vals, rel_bc)
    var rel_tiec = new_node(6)
    commit_map(rel_tiec, rel_tiec_keys, rel_tiec_vals)
    var rel_keys: table<string> = table_new_string()
    var rel_vals: table<i64> = table_new_i64()
    var rel_dbg = new_node(1)
    c_ivals[rel_dbg] = 0
    table_push(rel_keys, "debug")
    table_push(rel_vals, rel_dbg)
    var rel_opt = new_node(2)
    c_ivals[rel_opt] = 2
    table_push(rel_keys, "opt")
    table_push(rel_vals, rel_opt)
    table_push(rel_keys, "tiec")
    table_push(rel_vals, rel_tiec)
    var rel = new_node(6)
    commit_map(rel, rel_keys, rel_vals)
    var profiles_keys: table<string> = table_new_string()
    var profiles_vals: table<i64> = table_new_i64()
    table_push(profiles_keys, "dev")
    table_push(profiles_vals, dev)
    table_push(profiles_keys, "release")
    table_push(profiles_vals, rel)
    var profiles = new_node(6)
    commit_map(profiles, profiles_keys, profiles_vals)
    // ---------- 根 ----------
    var root_keys: table<string> = table_new_string()
    var root_vals: table<i64> = table_new_i64()
    // D1 target：空 = 本机
    table_push(root_keys, "target")
    table_push(root_vals, new_str_node(""))
    // D3 opt：默认 2（与 CLI 默认一致）；debug：默认 false
    var opt_n = new_node(2)
    c_ivals[opt_n] = 2
    table_push(root_keys, "opt")
    table_push(root_vals, opt_n)
    var dbg_n = new_node(1)
    c_ivals[dbg_n] = 0
    table_push(root_keys, "debug")
    table_push(root_vals, dbg_n)
    // P3 profile：默认 dev（Cargo 风格）
    table_push(root_keys, "profile")
    table_push(root_vals, new_str_node("dev"))
    // 子树引用（值节点已构造并登记，此处只登记键）
    table_push(root_keys, "tiec")
    table_push(root_vals, tiec)
    table_push(root_keys, "prep")
    table_push(root_vals, prep)
    table_push(root_keys, "pkg")
    table_push(root_vals, pkg)
    table_push(root_keys, "roles")
    table_push(root_vals, roles)
    table_push(root_keys, "advanced")
    table_push(root_vals, adv)
    table_push(root_keys, "cache")
    table_push(root_vals, cache)
    table_push(root_keys, "profiles")
    table_push(root_vals, profiles)
    var root = new_node(6)
    commit_map(root, root_keys, root_vals)
    return root
}

// 用户级配置路径（Windows: %USERPROFILE%\.config\tie\config.data.tie）。
// get_env 取不到时返回空串（调用方跳过用户层）。
func user_config_path() -> string {
    var home = get_env("USERPROFILE")
    if str_len(home) == 0 {
        home = get_env("HOME")
    }
    if str_len(home) == 0 {
        return ""
    }
    return home + "/.config/tie/config.data.tie"
}

// 分层加载（L2 + P3）：
//   内置默认 < 用户 config（存在才合并）< 项目 config（存在才合并）
//   < profile 覆盖（cli_profile 非空用 CLI；否则取顶层 "profile" 键；
//     profiles.<名> 存在才合并）
// 返回合并后根节点 id；文件解析失败返回 -1（c_err_msg 携带）。
// 参数：
//   project_path —— 项目 config 路径（driver 的 --config；空 = 自动探测
//                   当前目录 config.data.tie，不存在则跳过）
pub func load_merge(project_path: string, cli_profile: string) -> i64 {
    var root = build_defaults()
    // 用户层：~/.config/tie/config.data.tie
    var upath = user_config_path()
    if str_len(upath) > 0 && file_exists(upath) {
        var u = parse_file_append(upath)
        if u < 0 {
            return -1
        }
        root = merge(root, u)
        if root < 0 {
            return -1
        }
    }
    // 项目层：--config 指定 或 当前目录 config.data.tie
    var ppath: string = project_path
    if str_len(ppath) == 0 {
        ppath = "config.data.tie"
    }
    if file_exists(ppath) {
        var p = parse_file_append(ppath)
        if p < 0 {
            return -1
        }
        root = merge(root, p)
        if root < 0 {
            return -1
        }
    }
    // profile 覆盖（P3）：CLI --profile 优先；否则顶层 "profile" 键
    var prof: string = cli_profile
    if str_len(prof) == 0 {
        prof = get_str(root, "profile")
    }
    if str_len(prof) > 0 {
        var pnode = path_get(root, "profiles." + prof)
        if pnode >= 0 && type_of(pnode) == 6 {
            root = merge(root, pnode)
            if root < 0 {
                return -1
            }
        }
    }
    return root
}

// ---------- CLI 覆盖 ----------

// 按字符串值构造标量节点（自动判定类型：true/false → bool；纯数字 → int；
// 含 . 数字 → float；其余 → string）。
func scalar_from_str(v: string) -> i64 {
    if v == "true" {
        var tb = new_node(1)
        c_ivals[tb] = 1
        return tb
    }
    if v == "false" {
        var fb = new_node(1)
        c_ivals[fb] = 0
        return fb
    }
    var n: i64 = str_len(v)
    var is_num: bool = true
    var is_float: bool = false
    var i: i64 = 0
    while i < n {
        var c = str_char(v, i)
        var cp: i64 = char_code(c)
        if cp == 45 {
            // 负号仅允许首位
            if i != 0 {
                is_num = false
            }
        } else if cp == 46 {
            is_float = true
        } else if cp >= 48 && cp <= 57 {
        } else {
            is_num = false
        }
        i = i + 1
    }
    if is_num && n > 0 {
        if is_float {
            var fn = new_node(3)
            c_fvals[fn] = parse_float(v)
            return fn
        }
        var in_n = new_node(2)
        c_ivals[in_n] = parse_int(v)
        return in_n
    }
    return new_str_node(v)
}

// CLI 覆盖：把 root 的 path（点分路径）设置为 value（字符串形态）。
// 路径中间节点必须存在且为表（否则忽略，不报错——CLI 显式意图由调用方保证）。
// 返回 root（链式调用）。
pub func apply_cli(root: i64, path: string, value: string) -> i64 {
    // 解析路径为段表（点分拆分）
    var segs: table<string> = table_new_string()
    var n: i64 = str_len(path)
    var seg: string = ""
    var i: i64 = 0
    while i <= n {
        var at_end: bool = (i == n)
        var is_dot: bool = false
        if !at_end {
            if str_char(path, i) == "." {
                is_dot = true
            }
        }
        if at_end || is_dot {
            if str_len(seg) > 0 {
                table_push(segs, seg)
                seg = ""
            }
        } else {
            seg = seg + str_char(path, i)
        }
        i = i + 1
    }
    if len(segs) == 0 {
        return root
    }
    // 找到父表（除最后一段外的路径前缀）
    var cur: i64 = root
    var k: i64 = 0
    while k < len(segs) - 1 {
        cur = map_get(cur, segs[k])
        if cur < 0 {
            return root
        }
        k = k + 1
    }
    var last_key = segs[len(segs) - 1]
    var vnode = scalar_from_str(value)
    // 覆盖已有键（CLI 覆盖的都是默认/配置文件里已存在的键；原地改槽位
    // 不会 push 全局扁平表，保持键区间连续）。键不存在则忽略（调用方
    // 显式意图保证其存在）。
    map_set(cur, last_key, vnode)
    return root
}

// ---------- 摘要输出（--config-dump） ----------

// 值节点 → 单行摘要文本（字符串带引号；数组 [a,b]；表 {...} 简写计数）。
func val_brief(n: i64) -> string {
    var t = type_of(n)
    if t == 2 {
        return to_string(c_ivals[n])
    }
    if t == 3 {
        return to_string(c_fvals[n])
    }
    if t == 1 {
        if c_ivals[n] != 0 {
            return "true"
        }
        return "false"
    }
    if t == 4 {
        return c_strs[c_ivals[n]]
    }
    if t == 5 {
        var out: string = "["
        var cnt: i64 = c_ovals[n]
        var i: i64 = 0
        while i < cnt {
            if i > 0 {
                out = out + ","
            }
            out = out + val_brief(c_elem_flat[c_kids[n] + i])
            i = i + 1
        }
        return out + "]"
    }
    if t == 6 {
        return "{ " + to_string(c_ovals[n]) + " 键 }"
    }
    return "null"
}

// 表 → 多行摘要文本（每行 `key = value`；嵌套表递归缩进）。
func map_brief(n: i64, indent: string) -> string {
    var out: string = ""
    var cnt: i64 = c_ovals[n]
    var i: i64 = 0
    while i < cnt {
        var key = c_strs[c_key_flat[c_kids[n] + i]]
        var v = c_val_flat[c_kids[n] + i]
        out = out + indent + key + " = "
        if type_of(v) == 6 {
            out = out + "\n" + map_brief(v, indent + "  ")
        } else {
            out = out + val_brief(v) + "\n"
        }
        i = i + 1
    }
    return out
}

// 配置摘要（--config-dump）：返回多行文本，便于验收与调试。
pub func dump(root: i64) -> string {
    if root < 0 || type_of(root) != 6 {
        return ""
    }
    return map_brief(root, "")
}

}