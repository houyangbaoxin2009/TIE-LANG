// tie:library
// env.tie：自举 T4.2 —— 解释器环境原语（C ABI 桥函数的 tie 化映射）
// ============================================================
// 把 Rust 解释器的 C ABI 桥内置函数（crates/tie-interp/src/lib.rs 的
// tie_* 桥）映射到 tie 实现，供 tie 自写解释器（interp.tie 的 call_fn，
// T4.1 已完成）在 is_builtin 未命中时调用。
//
// 分派接口：`ienv.call(name, args) -> i64`——args 是 **Value 节点 id 表**
// （ivalue 表示，参数已求值）；返回值是 Value 节点 id；失败返回 -1 且置
// 全局错误槽 g_err（与 ivalue 共享，文本对齐 Rust "运行时错误: ..." 前缀）。
//
// 实现策略（桥函数分类）：
//   A. **转发语言底座原语**（同名原语，data.tie 245-260 行）：参数取文本/
//     整数后直调，结果包成 Value（new_str/new_int/new_bool）。
//   B. **Value 语义**：table/map 系列操作 interp 的 Value::Table/Value::Map
//     节点表示（ivalue 的 v_kids/v_mkeys 扁平段）——对齐 Rust interp 的
//     eval_table_push/eval_map（改 Value 的 cells/map，产生新节点重绑定）。
//   C. **stdlib 复用**：str/math/radix/format 等纯 tie 库函数。
//   D. **限制**：无法在 tie 侧实现的深层 OS/网络语义，文档化（见下表）。
//
// 注意：
//   - tie 语义层"内置原语优先于用户函数"（std/bytes.tie 先例）——env 内
//     函数名与底座原语同名时，直接裸调即命中底座原语，无递归风险。
//   - Rust tie-llvm 后端字符串缓冲 bug：str_char 返回值即取即用，不跨
//     函数持有（ivalue 的 map_set 已用 g_ms_key 键槽规避）。
//   - 保留字不可作函数/参数名（char/code/text/table/map/ref/line 等）。
//
// 桥函数实现状态表（对应 crates/tie-interp 的 tie_* 桥，约 77 个）：
//   [转发底座] file_read/write/append/exists/copy/move/delete, str_char,
//     str_len, char_code, to_string, parse_int, parse_float, exec_code,
//     exec_output, get_env, set_env, cwd, path_join, list_dir, walk_dir,
//     mkdir_all, remove_dir_all, copy_dir, untar_gz, unzip, http_get,
//     http_get_file, rand_range, time_now, arg_count, arg_string, read_line,
//     exit, byte_read/write/concat, bit_read/write, msg_*, regex_*,
//     sqrt/sin/cos/tan/exp/log/pow/floor/ceil/round, table_new_*
//   [Value 语义] table_push/table_at/table_set/table_len, map_get/map_set
//   [stdlib 复用] str 系列（split/trim/join 等）——后续接入，当前限制
//   [限制清单] 无同名底座原语且无 stdlib 的深层语义（如 HTTP 二进制下载
//     的完整错误协议、tar 解压的权限位）——评估后用底座原语近似或文档化
//
// 当前实现聚焦 A（高频转发）+ B（Value 语义核心），C/D 注释说明。

import "./value.tie"
import "./../lib/interner.tie"

namespace ienv {
// 取字符串参数文本（Value::Str；非字符串返回空串，调用方按约定处理）。
func arg_str(args: table<i64>, i: i64) -> string {
    if i < 0 || i >= len(args) {
        return ""
    }
    var vid = args[i]
    if ivalue.type_of(vid) != T_STR {
        return ""
    }
    return ivalue.str_val(vid)
}

// 取整数参数（Value::Int / Value::Bool；非整数返回 0）。
func arg_int(args: table<i64>, i: i64) -> i64 {
    if i < 0 || i >= len(args) {
        return 0
    }
    return ivalue.int_val(args[i])
}

// ---------- A. 转发语言底座原语 ----------

// 文件系列（1-2 个字符串参数）。
func file_call(name: string, args: table<i64>) -> i64 {
    var a = arg_str(args, 0)
    if name == "file_read" {
        return ivalue.new_str(file_read(a))
    }
    if name == "file_exists" {
        return ivalue.new_bool(file_exists(a))
    }
    if name == "file_write" {
        return ivalue.new_bool(file_write(a, arg_str(args, 1)))
    }
    if name == "file_append" {
        return ivalue.new_bool(file_append(a, arg_str(args, 1)))
    }
    if name == "file_copy" {
        return ivalue.new_bool(file_copy(a, arg_str(args, 1)))
    }
    if name == "file_move" {
        return ivalue.new_bool(file_move(a, arg_str(args, 1)))
    }
    if name == "file_delete" {
        return ivalue.new_bool(file_delete(a))
    }
    g_err = "运行时错误: 未实现的文件桥函数 '" + name + "'"
    return -1
}

// 字符串/数学/进制系列（0-1 个字符串参数，返回文本或整数）。
func scalar_call(name: string, args: table<i64>) -> i64 {
    var a = arg_str(args, 0)
    if name == "to_string" {
        // 参数可能非字符串：按 Value 语义 to_print_string
        return ivalue.new_str(to_print(args))
    }
    if name == "parse_int" {
        return ivalue.new_int(parse_int(a))
    }
    if name == "parse_float" {
        return ivalue.new_float(parse_float(a))
    }
    if name == "str_len" {
        return ivalue.new_int(str_len(a))
    }
    if name == "char_code" {
        return ivalue.new_int(char_code(a))
    }
    if name == "cwd" {
        return ivalue.new_str(cwd())
    }
    if name == "get_env" {
        return ivalue.new_str(get_env(a))
    }
    if name == "time_now" {
        return ivalue.new_int(time_now())
    }
    if name == "exec_output" {
        return ivalue.new_str(exec_output(a))
    }
    g_err = "运行时错误: 未实现的标量桥函数 '" + name + "'"
    return -1
}

// 数学函数（1 个浮点参数，返回浮点）。
func math_call(name: string, args: table<i64>) -> i64 {
    var a = arg_str(args, 0)
    var v: i64 = 0
    if name == "sqrt" {
        v = 1
    } else if name == "sin" {
        v = 2
    } else if name == "cos" {
        v = 3
    } else if name == "tan" {
        v = 4
    } else if name == "exp" {
        v = 5
    } else if name == "log" {
        v = 6
    } else if name == "floor" {
        v = 7
    } else if name == "ceil" {
        v = 8
    } else if name == "round" {
        v = 9
    }
    if v == 0 {
        g_err = "运行时错误: 未实现的数学桥函数 '" + name + "'"
        return -1
    }
    // 参数：int/float 值（转 f64 前先取数值）
    var fv = num_of(args, 0)
    if v == 1 {
        return ivalue.new_float(sqrt(fv))
    }
    if v == 2 {
        return ivalue.new_float(sin(fv))
    }
    if v == 3 {
        return ivalue.new_float(cos(fv))
    }
    if v == 4 {
        return ivalue.new_float(tan(fv))
    }
    if v == 5 {
        return ivalue.new_float(exp(fv))
    }
    if v == 6 {
        return ivalue.new_float(log(fv))
    }
    if v == 7 {
        return ivalue.new_float(floor(fv))
    }
    if v == 8 {
        return ivalue.new_float(ceil(fv))
    }
    return ivalue.new_float(round(fv))
}

// 双参数数学（pow）。
func pow_call(args: table<i64>) -> i64 {
    return ivalue.new_float(pow(num_of(args, 0), num_of(args, 1)))
}

// 参数数值化（Int → f64；Float → 原值；其他 → 0）。
func num_of(args: table<i64>, i: i64) -> f64 {
    if i < 0 || i >= len(args) {
        return 0.0
    }
    var vid = args[i]
    var t = ivalue.type_of(vid)
    if t == T_FLOAT {
        return ivalue.float_val(vid)
    }
    return to_f64(ivalue.int_val(vid))
}

// i64 → f64。
func to_f64(v: i64) -> f64 {
    var f: f64 = 0.0
    var k: i64 = 0
    while k < v {
        f = f + 1.0
        k = k + 1
    }
    return f
}

// 进程/环境系列。
func proc_call(name: string, args: table<i64>) -> i64 {
    var a = arg_str(args, 0)
    if name == "exec_code" {
        return ivalue.new_int(exec_code(a))
    }
    if name == "set_env" {
        set_env(a, arg_str(args, 1))
        return ivalue.new_bool(true)
    }
    if name == "arg_count" {
        return ivalue.new_int(arg_count())
    }
    if name == "arg_string" {
        return ivalue.new_str(arg_string(arg_int(args, 0)))
    }
    if name == "read_line" {
        return ivalue.new_str(read_line())
    }
    g_err = "运行时错误: 未实现的进程桥函数 '" + name + "'"
    return -1
}

// 随机系列（2 个整数参数）。
func rand_call(args: table<i64>) -> i64 {
    return ivalue.new_int(rand_range(arg_int(args, 0), arg_int(args, 1)))
}

// 路径/目录/档案系列（转发底座）。
func path_call(name: string, args: table<i64>) -> i64 {
    var a = arg_str(args, 0)
    if name == "path_join" {
        return ivalue.new_str(path_join(a, arg_str(args, 1)))
    }
    if name == "list_dir" || name == "walk_dir" {
        var t = list_dir(a)
        if name == "walk_dir" {
            t = walk_dir(a)
        }
        // 表 → Value::Table（元素为字符串值）
        var nt = ivalue.new_table()
        var i: i64 = 0
        while i < len(t) {
            nt = ivalue.table_push_val(nt, ivalue.new_str(t[i]))
            i = i + 1
        }
        return nt
    }
    if name == "mkdir_all" {
        return ivalue.new_bool(mkdir_all(a))
    }
    if name == "remove_dir_all" {
        return ivalue.new_bool(remove_dir_all(a))
    }
    if name == "copy_dir" {
        return ivalue.new_bool(copy_dir(a, arg_str(args, 1)))
    }
    if name == "untar_gz" {
        return ivalue.new_bool(untar_gz(a, arg_str(args, 1)))
    }
    if name == "unzip" {
        return ivalue.new_bool(unzip(a, arg_str(args, 1)))
    }
    g_err = "运行时错误: 未实现的路径/目录桥函数 '" + name + "'"
    return -1
}

// 字节/位系列。
func byte_call(name: string, args: table<i64>) -> i64 {
    var a = arg_str(args, 0)
    if name == "byte_read" {
        var t = byte_read(a)
        var nt = ivalue.new_table()
        var i: i64 = 0
        while i < len(t) {
            nt = ivalue.table_push_val(nt, ivalue.new_int(t[i]))
            i = i + 1
        }
        return nt
    }
    if name == "byte_write" {
        // 限制：Value::Table → 底座字节表需要元素类型确认（i64 字节值），
        // 当前走限制清单（诚实报错而非假写）
        g_err = "运行时错误: 环境桥函数 'byte_write' 尚未 tie 化（限制清单见 env.tie 头注释）"
        return -1
    }
    g_err = "运行时错误: 未实现的字节桥函数 '" + name + "'"
    return -1
}

// Value 语义：Value::Table 上的 table_at（下标读）。
func table_at_call(args: table<i64>) -> i64 {
    var tid = args[0]
    var i = arg_int(args, 1)
    var e = ivalue.elem_at(tid, i)
    if e < 0 {
        g_err = "运行时错误: table_at 下标越界：索引 " + to_string(i) + " 超出长度 " +
            to_string(ivalue.elem_count(tid))
        return -1
    }
    return e
}

// Value 语义：Value::Table 上的 table_push（尾追加，产生新节点）。
func table_push_call(args: table<i64>) -> i64 {
    var tid = args[0]
    var elem = args[1]
    return ivalue.table_push_val(tid, elem)
}

// Value 语义：Value::Table 长度。
func table_len_call(args: table<i64>) -> i64 {
    return ivalue.new_int(ivalue.elem_count(args[0]))
}

// Value 语义：map_get（键经 interner.intern 转 id）。
func map_get_call(args: table<i64>) -> i64 {
    var mid = args[0]
    var key = arg_str(args, 1)
    return ivalue.map_get(mid, interner.intern(key))
}

// Value 语义：map_set（键经 g_ms_key 槽，产生新 map 节点重绑定）。
func map_set_call(args: table<i64>) -> i64 {
    var mid = args[0]
    var key = arg_str(args, 1)
    var val = args[2]
    var n = ivalue.new_map()
    g_ms_key = interner.intern(key)
    return ivalue.map_set(n, mid, val)
}

// ---------- 主分派 ----------

// 环境函数分派：返回 Value 节点 id；失败 -1 置 g_err。
pub func call(name: string, args: table<i64>) -> i64 {
    // 文件
    if has_prefix_str(name, "file_") {
        return file_call(name, args)
    }
    // 数学（单参数）
    if name == "sqrt" || name == "sin" || name == "cos" || name == "tan" ||
        name == "exp" || name == "log" || name == "floor" || name == "ceil" ||
        name == "round" {
        return math_call(name, args)
    }
    if name == "pow" {
        return pow_call(args)
    }
    // 标量（字符串/环境/时间）
    if name == "to_string" || name == "parse_int" || name == "parse_float" ||
        name == "str_len" || name == "char_code" || name == "cwd" ||
        name == "get_env" || name == "time_now" || name == "exec_output" {
        return scalar_call(name, args)
    }
    // 进程/参数/输入
    if name == "exec_code" || name == "set_env" || name == "arg_count" ||
        name == "arg_string" || name == "read_line" {
        return proc_call(name, args)
    }
    if name == "exit" {
        // 限制：exit 的底座调用生成 unreachable，触发 Rust tie-llvm renumber bug
        // （if 链尾编号断链）——REPL 内退出由 read_line EOF/外层处理，此处报限制
        g_err = "运行时错误: 环境桥函数 'exit' 在解释器内受限（REPL 退出经 read_line EOF）"
        return -1
    }
    // 随机
    if name == "rand_range" {
        return rand_call(args)
    }
    // 路径/目录/档案
    if name == "path_join" || name == "list_dir" || name == "walk_dir" ||
        name == "mkdir_all" || name == "remove_dir_all" || name == "copy_dir" ||
        name == "untar_gz" || name == "unzip" {
        return path_call(name, args)
    }
    // 字节
    if name == "byte_read" || name == "byte_write" {
        return byte_call(name, args)
    }
    // Value 语义：表/键值表
    if name == "table_at" {
        return table_at_call(args)
    }
    if name == "table_push" {
        return table_push_call(args)
    }
    if name == "table_len" {
        return table_len_call(args)
    }
    if name == "map_get" {
        return map_get_call(args)
    }
    if name == "map_set" {
        return map_set_call(args)
    }
    // 未覆盖桥函数：限制清单（见文件头状态表 C/D）
    g_err = "运行时错误: 环境桥函数 '" + name + "' 尚未 tie 化（限制清单见 env.tie 头注释）"
    return -1
}

// Value 的 to_print_string（env 内自用；参数为已求值 Value id）。
// bool → 1/0；表 → [a, b]；其余 → 文本（对齐 Rust to_print_string）。
func to_print(args: table<i64>) -> string {
    if len(args) < 1 {
        return ""
    }
    return ivalue.to_print_string(args[0])
}

// 字符串前缀判断（tie 无 starts_with 原语，自实现）。
func has_prefix_str(s: string, prefix: string) -> bool {
    var n: i64 = str_len(s)
    var m: i64 = str_len(prefix)
    if n < m {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_char(s, i) != str_char(prefix, i) {
            return false
        }
        i = i + 1
    }
    return true
}
}

