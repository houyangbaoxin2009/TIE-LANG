type tie<class>
// compiler/interp/interp_macro.tie —— 解释器宏执行分区（S3.3 宏展开执行入口）
// ============================================================
// 里程碑：解耦宏任务（compiler-decouple.md 子任务A 前置步）——把宏执行机制从
// interp 主文件拆出，收束宏子系统的函数归属。
// 范式：tie import 是文本内联——被 import 文件全部代码并入编译单元，一切
// 符号全局可见；**同名 `namespace interp` 跨文件闭合并集**。故把 interp 主
// 文件里宏执行入口函数搬家到本文件，interp 主文件 import 本文件即可
// **零逻辑改动**（对齐 interp_bin / interp_call 既有拆分模式）。
//
// # 本文件职责（S3.3 宏/元编程执行入口）
//   宏定义注册 / 宏函数执行 / 过程宏执行 / code 值执行，全部以 **AST 协议
//   文本**为输入（跳过 lexer/parser，不依赖源码解析）：
//   - eval_proto(proto)      ：宏定义协议文本 → load_ast + 归档 + 顶层注册
//   - eval_macro(name, args) ：执行宏函数（形参绑定 code 值，body 为宏体）
//   - eval_macro_proc(...)   ：执行过程宏（形参绑定字符串源码文本）
//   - exec_code_proto(proto) ：执行 code 值文本（C2 thunk `.call()`）
//   宏执行所需的全局状态（g_hyg_*/g_gensym/g_macro_depth/g_clone_* 等）与
//   isess/ivalue/sstate 访问均继承自 interp 主文件（import 文本内联，同
//   namespace 跨文件可见，不自建全局 var，对齐 interp_bin/interp_call）。
//
// # import 树
//   由 interp.tie import（interp → session → value + parser 树 + sstate 树）。
//   本文件不直接 import——依赖 interp 主文件的 import 链传递可见（对齐
//   interp_bin / interp_call）。

namespace interp {

// ==================== S3.3 宏展开执行入口 ====================

// 注册宏定义（mexpand 用）：AST 协议文本（根 = 单个声明节点）→ load_ast +
// 归档 + 顶层注册。成功返回 ""；失败返回错误文本（g_err 同步置位）。
// 与 eval 的"源码第一趟注册"路径等价，但输入是协议文本（宏定义来自
// 编译器 AST 池序列化，非源码），跳过 lexer/parser。
pub func eval_proto(proto: string) -> string {
    g_err = ""
    if sstate.load_ast(proto) < 0 {
        g_err = "内部错误: AST 协议加载失败（宏定义注册）"
        return g_err
    }
    var base = isess.archive_add()
    // 根 = 协议根（id 0 → 归档 id = base，**不是 a_n-1**：协议节点按 id
    // 追加，根不一定是最后创建的节点）：声明节点直接注册；StmtList 走
    // register_top_level
    var root = base
    var t = isess.ntag(root)
    if t == N_MACRO_DEF || t == N_FN_DEF {
        isess.f_put(isess.nname_str(root), root)
        if t == N_MACRO_DEF {
            isess.m_put(isess.nname_str(root))
        }
        return ""
    }
    if t == N_STMTLIST {
        if isess.nchild(root) > 0 {
            var r = register_top_level()
            if has_str_prefix(r, "已定义") {
                return ""
            }
            return r
        }
    }
    g_err = "宏定义注册失败: 协议根既不是声明节点也不是语句列表"
    return g_err
}

// 执行宏函数（mexpand 调用）：name = 宏名，args = 实参 code 文本表
// （AST 协议文本，调用点实参子树序列化）。执行宏体：形参绑定为 code 值，
// return 的 code 值文本原样返回。成功返回协议文本（g_err 为空）；失败返回
// 错误文本（g_err 同步置位）。
pub func eval_macro(name: string, args: table<string>) -> string {
    g_err = ""
    var f = isess.f_get(name)
    if f < 0 {
        g_err = "宏 '" + name + "' 未定义"
        return g_err
    }
    if !isess.m_has(name) {
        g_err = "'" + name + "' 不是宏（未以 macro 声明）"
        return g_err
    }
    // 递归深度限制（宏调用宏 / 展开递归）
    g_macro_depth = g_macro_depth + 1
    if g_macro_depth > 64 {
        g_macro_depth = g_macro_depth - 1
        g_err = "宏展开嵌套过深（超过 64 层，疑似无限递归）：" + name
        return g_err
    }
    // 参数个数检查（宏参数全部必选、无默认值）
    var total = isess.naux(f)
    if len(args) != total {
        g_macro_depth = g_macro_depth - 1
        g_err = "宏 '" + name + "' 期望 " + to_string(total) + " 个 code 参数，实际 " + to_string(len(args)) + " 个"
        return g_err
    }
    var saved_ns = isess.ns_save()
    var saved_base = env_base
    isess.scope_push()
    var i: i64 = 0
    while i < total {
        var p = isess.nchild_at(f, 1 + i)
        var pname = isess.nname_str(p)
        isess.var_declare(pname, ivalue.new_code(args[i]))
        i = i + 1
    }
    env_base = isess.scope_top()
    var body = isess.nchild_at(f, isess.nchild(f) - 1)
    exec_block(body)
    isess.scope_pop()
    env_base = saved_base
    isess.ns_restore(saved_ns)
    g_macro_depth = g_macro_depth - 1
    if g_err != "" {
        return g_err
    }
    if g_flow == FL_RETURN {
        var val = g_flow_val
        g_flow = FL_NORMAL
        if ivalue.type_of(val) == T_CODE {
            return ivalue.code_str(val)
        }
        g_err = "宏 '" + name + "' 必须返回 code 值（return 了一个 " +
            ivalue.type_name(val) + "）"
        return g_err
    }
    g_err = "宏 '" + name + "' 未返回 code 值（函数体缺少 return code 语句）"
    return g_err
}

// 执行过程宏（M4，dev33 批次9）：#[macro] 标记的宏由 mexpand 把实参子树
// 解引用为**源码文本**传入（args = 字符串表），本函数把形参绑定为字符串值
//（普通宏绑定为 code 值）。宏体用 tokenize/deparse 驱动 token 流变换，须
// return code 值（eval_expr/eval_code 构造）。与 eval_macro 同构。
pub func eval_macro_proc(name: string, args: table<string>) -> string {
    g_err = ""
    var f = isess.f_get(name)
    if f < 0 {
        g_err = "过程宏 '" + name + "' 未定义"
        return g_err
    }
    if !isess.m_has(name) {
        g_err = "'" + name + "' 不是宏（未以 macro 声明）"
        return g_err
    }
    g_macro_depth = g_macro_depth + 1
    if g_macro_depth > 64 {
        g_macro_depth = g_macro_depth - 1
        g_err = "宏展开嵌套过深（超过 64 层，疑似无限递归）：" + name
        return g_err
    }
    var total = isess.naux(f)
    if len(args) != total {
        g_macro_depth = g_macro_depth - 1
        g_err = "过程宏 '" + name + "' 期望 " + to_string(total) + " 个参数，实际 " + to_string(len(args)) + " 个"
        return g_err
    }
    var saved_ns = isess.ns_save()
    var saved_base = env_base
    isess.scope_push()
    var i: i64 = 0
    while i < total {
        var p = isess.nchild_at(f, 1 + i)
        var pname = isess.nname_str(p)
        // 过程宏：形参绑定为实参源码文本（字符串值）
        isess.var_declare(pname, ivalue.new_str(args[i]))
        i = i + 1
    }
    env_base = isess.scope_top()
    var body = isess.nchild_at(f, isess.nchild(f) - 1)
    exec_block(body)
    isess.scope_pop()
    env_base = saved_base
    isess.ns_restore(saved_ns)
    g_macro_depth = g_macro_depth - 1
    if g_err != "" {
        return g_err
    }
    if g_flow == FL_RETURN {
        var val = g_flow_val
        g_flow = FL_NORMAL
        if ivalue.type_of(val) == T_CODE {
            return ivalue.code_str(val)
        }
        g_err = "过程宏 '" + name + "' 必须返回 code 值（return 了一个 " +
            ivalue.type_name(val) + "）"
        return g_err
    }
    g_err = "过程宏 '" + name + "' 未返回 code 值（函数体缺少 return code 语句）"
    return g_err
}

// 执行 code 值文本（C2 thunk `.call()` / 编译期执行）：协议文本 → 归档 →
// 根 StmtList 逐语句执行 / 单表达式求值。返回最后值 id（void → Void 值）。
// 失败置 g_err 返回 -1。
func exec_code_proto(proto: string) -> i64 {
    g_err = ""
    if sstate.load_ast(proto) < 0 {
        g_err = "内部错误: AST 协议加载失败（code 执行）"
        return -1
    }
    var base = isess.archive_add()
    var root = base
    var last: i64 = -1
    if isess.ntag(root) == N_STMTLIST {
        var i: i64 = 0
        while i < isess.nchild(root) {
            exec_stmt(isess.nchild_at(root, i))
            if g_err != "" {
                return -1
            }
            if g_flow != FL_NORMAL {
                break
            }
            if g_lastval >= 0 {
                last = g_lastval
            }
            i = i + 1
        }
        if g_flow == FL_RETURN {
            g_flow = FL_NORMAL
            return g_flow_val
        }
    } else {
        var v = gen_expr(root)
        if g_err != "" {
            return -1
        }
        return v
    }
    if last >= 0 {
        return last
    }
    return ivalue.new_void()
}

// ==================== M4 token 流工具（宏环境，dev33 批次9） ====================
// tokenize/deparse/token_* 内置的共享辅助（从 interp_call 归拢——M4 过程宏
// 环境的 token 流解析/转义工具，属宏子系统）。

// 从 eval_expr 的包装程序（s_* 池）抽取 return 表达式子树协议文本。
// 注意：parse_src 的 build_protocol 按**创建顺序**编号节点，顶层 StmtList
// 在 parse_program 末尾创建 → 根是最后一个节点（id = s_n - 1），不是 id 0
//（id 0 是第一个创建的节点，如返回类型 NAMED_TYPE）。导航：
// 根 StmtList[0] = FnDef；FnDef 最后子 = 函数体 StmtList；体[0] = Return；
// Return[0] = 表达式。返回协议文本；失败置 g_err 返回空串。
func expr_from_wrap() -> string {
    if s_n < 1 {
        g_err = "内部错误: eval_expr 包装程序缺少节点"
        return ""
    }
    var root = s_n - 1
    if s_tags[root] != N_STMTLIST {
        g_err = "内部错误: eval_expr 包装程序根不是语句列表 (tag=" +
            to_string(s_tags[root]) + ")"
        return ""
    }
    var fn = s_children[s_coff[root]]
    if fn < 0 {
        g_err = "内部错误: eval_expr 包装程序缺少函数定义"
        return ""
    }
    var body = s_children[s_coff[fn] + s_nchild[fn] - 1]
    if body < 0 {
        g_err = "内部错误: eval_expr 包装程序缺少函数体"
        return ""
    }
    var ret = s_children[s_coff[body]]
    if ret < 0 {
        g_err = "内部错误: eval_expr 包装程序缺少 return 语句"
        return ""
    }
    var expr = s_children[s_coff[ret]]
    if expr < 0 {
        g_err = "eval_expr 表达式为空"
        return ""
    }
    return sstate_subtree_protocol(expr)
}

// token 流 lexeme 转义（序列化）：\ → \\，实际换行 → \n，\r → \r，\t → \t。
// 反斜杠先转义消除歧义：源字符串字面量里的 \n 转义（2 字符）序列化为 \\n，
// 反序列化还原；真正换行符序列化为 \n，反序列化还原。往返一致。
func escape_token_lexeme(s: string) -> string {
    var out: string = ""
    var n = str_len(s)
    var i: i64 = 0
    while i < n {
        var c = str_char(s, i)
        if c == "\\" {
            out = out + "\\\\"
        } else if c == "\n" {
            out = out + "\\n"
        } else if c == "\r" {
            out = out + "\\r"
        } else if c == "\t" {
            out = out + "\\t"
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

// 转义还原：\\ → \，\n → 换行，\r → 回车，\t → 制表；未知转义按字面保留。
func unescape_token_lexeme(s: string) -> string {
    var out: string = ""
    var n = str_len(s)
    var i: i64 = 0
    while i < n {
        var c = str_char(s, i)
        if c == "\\" {
            if i + 1 < n {
                var n2 = str_char(s, i + 1)
                if n2 == "n" {
                    out = out + "\n"
                    i = i + 2
                    continue
                }
                if n2 == "r" {
                    out = out + "\r"
                    i = i + 2
                    continue
                }
                if n2 == "t" {
                    out = out + "\t"
                    i = i + 2
                    continue
                }
                if n2 == "\\" {
                    out = out + "\\"
                    i = i + 2
                    continue
                }
            }
            out = out + c
            i = i + 1
            continue
        }
        out = out + c
        i = i + 1
    }
    return out
}

// 解析 token 流文本 → g_tk_tags/g_tk_lexemes（平行表，lexeme 未转义）。
// 返回 token 数；失败置 g_err 返回 -1。首行 <N>: 头部跳过，其后每行
// <tag> <lexeme>（lexeme 含空格只按首个空格切分）。
func parse_tokens(stream: string) -> i64 {
    g_tk_tags = table_new_i64()
    g_tk_lexemes = table_new_string()
    var lines = split_proto_lines(stream)
    if len(lines) < 1 {
        g_err = "token 流为空"
        return -1
    }
    var i: i64 = 1
    while i < len(lines) {
        var line = lines[i]
        var sp = find_char_str(line, " ")
        if sp < 0 {
            g_err = "token 流格式错误（第 " + to_string(i) + " 行缺少空格分隔）"
            return -1
        }
        var tag = sstate.parse_dec(str.slice(line, 0, sp))
        var lex = str.slice(line, sp + 1, str_len(line))
        table_push(g_tk_tags, tag)
        table_push(g_tk_lexemes, unescape_token_lexeme(lex))
        i = i + 1
    }
    return len(g_tk_tags)
}

// token 流 → 源码文本：逐 token 发射原始拼写（未转义 lexeme），token 间单
// 空格；跳过 Eof token。返回源码字符串（失败置 g_err 返回空串）。
func deparse_tokens(stream: string) -> string {
    var n = parse_tokens(stream)
    if g_err != "" {
        return ""
    }
    var out: string = ""
    var first: bool = true
    var i: i64 = 0
    while i < n {
        if g_tk_tags[i] == lex_eof {
            i = i + 1
            continue
        }
        if !first {
            out = out + " "
        }
        out = out + g_tk_lexemes[i]
        first = false
        i = i + 1
    }
    return out
}

}   // namespace interp