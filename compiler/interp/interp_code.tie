type tie<class>
// compiler/interp/interp_code.tie —— 解释器 code 值构造分区（S3.3 准引用）
// ============================================================
// 里程碑：解耦宏任务（compiler-decouple.md 子任务A 前置步）——把 code 值
// 构造（准引用求值 + 词法卫生 + 插值拼接）从 interp 主文件拆出，收束宏
// 子系统的函数归属。
// 范式：tie import 是文本内联——被 import 文件全部代码并入编译单元，一切
// 符号全局可见；**同名 `namespace interp` 跨文件闭合并集**。故把 interp 主
// 文件里 code 值构造相关函数搬家到本文件，interp 主文件 import 本文件即可
// **零逻辑改动**（对齐 interp_bin / interp_call / interp_macro 既有拆分）。
//
// # 本文件职责（S3.3 code 值 / C1 准引用 + H2 卫生 + 插值）
//   准引用求值 N_CODE_LIT（归档池）→ code 值（AST 协议文本，T_CODE）：
//   - gen_code_lit(id)           ：准引用主流程（卫生 + 克隆 + 序列化 + 插值嵌入）
//   - collect_bindings(id)       ：收集子树绑定名 → 卫生改名映射（__hygN_）
//   - clone_node(old, out)       ：克隆归档池节点到 s_* 池末尾（含改名/登记插值）
//   - sstate_subtree_protocol()  ：子树 → 协议文本（pub，mexpand/实参序列化共用）
//   - splice_proto / row_* / split_* / replace_* / code_root_var_name / join_parts
//                               ：协议文本拼接 / 节点行重映射 / 插值替换辅助
//   所需全局状态（g_hyg_*/g_gensym/g_clone_*）与 isess/ivalue/sstate/interner
//   访问继承自 interp 主文件（import 文本内联，同 namespace 跨文件可见，
//   不自建全局 var）。
//
// # import 树
//   由 interp.tie import（interp → session → value + parser 树 + sstate 树）。
//   本文件不直接 import——依赖 interp 主文件的 import 链传递可见（对齐
//   interp_bin / interp_call / interp_macro）。

namespace interp {

// ==================== S3.3 准引用求值（code 值构造） ====================

// 准引用求值：N_CODE_LIT（归档池）→ code 值（AST 协议文本，T_CODE）。
// 流程（H2 词法卫生 + 插值替换都在构造期完成，展开结果即最终代码）：
//   1. 收集子树绑定名（N_VAR_DECL/N_FN_DEF 的 name，非 $ 前缀）→ 卫生改名
//      映射（__hyg<计数>_<原名>，计数全局递增——多次展开互不冲突）；
//   2. 克隆子树到 s_* 池末尾（克隆时按映射改名：宏体绑定的名字连同其
//      引用一起唯一化；调用方插值代码此时尚未嵌入，保持原名不捕获）；
//   3. 克隆子树序列化为协议文本 P（根 id = 0 约定）；
//   4. 逐个 N_CODE_INTERP（克隆后节点）按值分派嵌入：
//        code 值 → splice_proto（AST 片段拼接进 P）；
//        字符串值 → 替换为 N_VAR（标识符引用，如 gensym 名作变量用）；
//   5. 名字插值（$ 前缀 name 字段）：字符串 → 名字；code 值（根 N_VAR）
//      → 其变量名（插值赋值目标 `$a = ...`）；
//   6. 返回 code 值（T_CODE，文本 = P）。
func gen_code_lit(id: i64) -> i64 {
    var root = isess.nchild_at(id, 0)
    if root < 0 {
        g_err = "内部错误: 准引用节点缺少子 AST"
        return -1
    }
    // 清克隆/卫生映射（模块级表复用；每次准引用求值独立命名空间）
    g_clone_old = table_new_i64()
    g_clone_new = table_new_i64()
    g_hyg_old = table_new_i64()
    g_hyg_new = table_new_i64()
    var g_interp_nodes: table<i64> = table_new_i64()
    // 1. 收集绑定名 + 生成卫生映射
    collect_bindings(root)
    // 2. 克隆子树（含卫生改名 + 登记 N_CODE_INTERP 新 id）
    var new_root = clone_node(root, g_interp_nodes)
    if new_root < 0 {
        return -1
    }
    // 2.5 协议 id 映射：sstate_subtree_protocol 按 BFS 重编号（池 id → 新 id
    // 0..n-1），splice_proto 须用**协议新 id** 而非池 id 匹配。此处用与
    // sstate_subtree_protocol 完全相同的 BFS 遍历计算映射（g_interp_pids
    // 与 g_interp_nodes 平行：池 id → 协议 id）。
    var g_interp_pids: table<i64> = table_new_i64()
    var mo: table<i64> = table_new_i64()
    var mn: table<i64> = table_new_i64()
    var od: table<i64> = table_new_i64()
    table_push(od, new_root)
    table_push(mo, new_root)
    table_push(mn, 0)
    var qi: i64 = 0
    while qi < len(od) {
        var cur = od[qi]
        var kk: i64 = 0
        while kk < s_nchild[cur] {
            var cc = s_children[s_coff[cur] + kk]
            if cc >= 0 {
                var seen2 = false
                var m2: i64 = 0
                while m2 < len(mo) {
                    if mo[m2] == cc {
                        seen2 = true
                        break
                    }
                    m2 = m2 + 1
                }
                if !seen2 {
                    table_push(od, cc)
                    table_push(mo, cc)
                    table_push(mn, len(od) - 1)
                }
            }
            kk = kk + 1
        }
        qi = qi + 1
    }
    var mi: i64 = 0
    while mi < len(g_interp_nodes) {
        var pid2: i64 = -1
        var mj: i64 = 0
        while mj < len(mo) {
            if mo[mj] == g_interp_nodes[mi] {
                pid2 = mn[mj]
                break
            }
            mj = mj + 1
        }
        table_push(g_interp_pids, pid2)
        mi = mi + 1
    }
    // 2.6 按协议 id 降序排序（g_interp_nodes/g_interp_pids 平行）：splice_proto
    // 每次嵌入会把插入点之后的节点 id 重编号（+qn-1）——从大到小处理保证
    // 后续（更小 id）的插值节点不受之前嵌入影响，id 恒为原始映射值。
    var si: i64 = 0
    while si < len(g_interp_pids) - 1 {
        var sj: i64 = si + 1
        while sj < len(g_interp_pids) {
            if g_interp_pids[sj] > g_interp_pids[si] {
                var tp = g_interp_pids[si]
                g_interp_pids[si] = g_interp_pids[sj]
                g_interp_pids[sj] = tp
                var tn = g_interp_nodes[si]
                g_interp_nodes[si] = g_interp_nodes[sj]
                g_interp_nodes[sj] = tn
            }
            sj = sj + 1
        }
        si = si + 1
    }
    // 3. 序列化克隆子树 → 协议文本（根 id = 0）
    var p = sstate_subtree_protocol(new_root)
    if g_err != "" {
        return -1
    }
    // 4. 逐个 N_CODE_INTERP 嵌入（splice_proto 用协议新 id——g_interp_pids）
    var k: i64 = 0
    while k < len(g_interp_nodes) {
        var inode = g_interp_nodes[k]
        var ipid = g_interp_pids[k]
        if ipid < 0 {
            g_err = "内部错误: 插值节点协议 id 映射缺失"
            return -1
        }
        var iname = s_names[inode]
        var ivar = ""
        var ivar_node: i64 = -1
        if iname >= 0 {
            ivar = interner.lookup(iname)
        } else {
            // $(expr) 复杂形式：先求值表达式（宏体环境）
            var ex = s_children[s_coff[inode]]
            var ev = gen_expr(ex)
            if g_err != "" {
                return -1
            }
            if ivalue.type_of(ev) == T_CODE {
                p = splice_proto(p, ipid, ivalue.code_str(ev))
                k = k + 1
                continue
            }
            if ivalue.type_of(ev) == T_STR {
                p = replace_interp_node_with_var(p, ipid, ivalue.str_val(ev))
                k = k + 1
                continue
            }
            g_err = "插值 $(表达式) 必须是 code 或字符串，实际是 " + ivalue.type_name(ev)
            return -1
        }
        var v = isess.lookup(ivar)
        if v < 0 {
            g_err = "插值变量 '" + ivar + "' 未声明"
            return -1
        }
        if ivalue.type_of(v) == T_CODE {
            p = splice_proto(p, ipid, ivalue.code_str(v))
        } else if ivalue.type_of(v) == T_STR {
            p = replace_interp_node_with_var(p, ipid, ivalue.str_val(v))
        } else {
            g_err = "插值变量 '" + ivar + "' 必须是 code 或字符串，实际是 " + ivalue.type_name(v)
            return -1
        }
        k = k + 1
    }
    // 5. 名字插值（$ 前缀 name 字段 → 值）
    p = replace_name_interps(p)
    if g_err != "" {
        return -1
    }
    // 6. code 值
    return ivalue.new_code(p)
}

// 收集子树（归档池）绑定名：N_VAR_DECL / N_FN_DEF 的 name（非 $ 前缀、
// 非空）→ g_hyg_old + 卫生新名 g_hyg_new（__hyg<计数>_<原名>）。
// 递归遍历（含嵌套块/函数体）。N_PARAM 不收集（宏参数/块内函数参数保留
// 原名——插值 `$x` 引用宏参数名，改名会破坏插值）。
func collect_bindings(id: i64) {
    var t = isess.ntag(id)
    if t == N_VAR_DECL || t == N_FN_DEF {
        var nid = isess.nname(id)
        if nid >= 0 {
            var nm = interner.lookup(nid)
            var nml = str_len(nm)
            if nml > 0 {
                if str_char(nm, 0) != "$" {
                    // 已在映射中（同名重复声明）跳过
                    var dup = false
                    var i: i64 = 0
                    while i < len(g_hyg_old) {
                        if g_hyg_old[i] == nid {
                            dup = true
                            break
                        }
                        i = i + 1
                    }
                    if !dup {
                        g_hyg_counter = g_hyg_counter + 1
                        table_push(g_hyg_old, nid)
                        table_push(g_hyg_new, interner.intern("__hyg" + to_string(g_hyg_counter) + "_" + nm))
                    }
                }
            }
        }
    }
    var k: i64 = 0
    while k < isess.nchild(id) {
        var c = isess.nchild_at(id, k)
        if c >= 0 {
            collect_bindings(c)
        }
        k = k + 1
    }
}

// 克隆归档池节点到 s_* 池末尾（递归；含卫生改名与 N_CODE_INTERP 登记）。
// 返回新节点 id。
func clone_node(old: i64, interp_out: ref table<i64>) -> i64 {
    // 已克隆（共享子节点/环防御）：返回既有映射
    var i: i64 = 0
    while i < len(g_clone_old) {
        if g_clone_old[i] == old {
            return g_clone_new[i]
        }
        i = i + 1
    }
    var t = isess.ntag(old)
    var name_id = isess.nname(old)
    // 卫生改名：name ∈ g_hyg_old → g_hyg_new（宏体绑定名唯一化）
    var j: i64 = 0
    while j < len(g_hyg_old) {
        if g_hyg_old[j] == name_id {
            name_id = g_hyg_new[j]
            break
        }
        j = j + 1
    }
    // 追加到 s_* 池
    var new_id = len(s_tags)
    table_push(s_tags, t)
    table_push(s_names, name_id)
    table_push(s_vals, isess.nval(old))
    table_push(s_aux, isess.naux(old))
    table_push(s_coff, 0)
    table_push(s_nchild, isess.nchild(old))
    table_push(s_lines, isess.nline(old))
    table_push(s_cols, isess.ncol(old))
    // 登记映射（递归前登记防环）
    table_push(g_clone_old, old)
    table_push(g_clone_new, new_id)
    // 子节点段：**先占位再原位覆盖**（父段 [seg, seg+nchild) 固定，子段在
    // 父段之后——直接"子克隆前取 len(s_children)"会与第一个子的段重叠，
    // 导致父 children 读取错位（准引用块结构断裂的根因））
    var seg_start = len(s_children)
    var nkid: i64 = 0
    while nkid < isess.nchild(old) {
        table_push(s_children, -1)
        nkid = nkid + 1
    }
    s_coff[new_id] = seg_start
    var k: i64 = 0
    while k < isess.nchild(old) {
        var c = isess.nchild_at(old, k)
        if c < 0 {
            s_children[seg_start + k] = -1
        } else {
            var nc = clone_node(c, interp_out)
            s_children[seg_start + k] = nc
        }
        k = k + 1
    }
    s_n = len(s_tags)
    // 登记 N_CODE_INTERP（插值嵌入用）
    if t == N_CODE_INTERP {
        table_push(interp_out, new_id)
    }
    return new_id
}

// 序列化 s_* 池子树为协议文本（根 id 重映射为 0，其余 BFS 顺序 1..n-1；
// 行格式与 sstate.load_ast 完全兼容）。pub：mexpand（宏定义注册/实参
// 序列化）与 gen_code_lit 共用。
pub func sstate_subtree_protocol(root: i64) -> string {
    // BFS 收集（map_old/map_new 兼作访问标记）
    var map_old: table<i64> = table_new_i64()
    var map_new: table<i64> = table_new_i64()
    var order: table<i64> = table_new_i64()
    table_push(order, root)
    table_push(map_old, root)
    table_push(map_new, 0)
    var qi: i64 = 0
    while qi < len(order) {
        var cur = order[qi]
        var k: i64 = 0
        while k < s_nchild[cur] {
            var c = s_children[s_coff[cur] + k]
            if c >= 0 {
                var seen = false
                var m: i64 = 0
                while m < len(map_old) {
                    if map_old[m] == c {
                        seen = true
                        break
                    }
                    m = m + 1
                }
                if !seen {
                    table_push(order, c)
                    table_push(map_old, c)
                    table_push(map_new, len(order) - 1)
                }
            }
            k = k + 1
        }
        qi = qi + 1
    }
    // 输出协议文本（行格式与 sstate.load_ast 兼容）
    var out: string = to_string(len(order)) + ":\n"
    var n: i64 = 0
    while n < len(order) {
        var oid = order[n]
        var line: string = to_string(map_new[n]) + " " + to_string(s_tags[oid]) + " " +
            to_string(s_names[oid]) + " " + to_string(s_vals[oid]) + " " +
            to_string(s_aux[oid]) + " " + to_string(s_lines[oid]) + " " +
            to_string(s_cols[oid]) + " " + to_string(s_nchild[oid])
        var k: i64 = 0
        while k < s_nchild[oid] {
            var c = s_children[s_coff[oid] + k]
            if c < 0 {
                line = line + " -1"
            } else {
                // 查新 id（线性；子树规模小）
                var mid: i64 = -1
                var m: i64 = 0
                while m < len(map_old) {
                    if map_old[m] == c {
                        mid = map_new[m]
                        break
                    }
                    m = m + 1
                }
                line = line + " " + to_string(mid)
            }
            k = k + 1
        }
        out = out + line + "\n"
        n = n + 1
    }
    return out
}

// 协议文本拼接：把 q（子树协议，根 id=0）嵌入 p（协议，节点 id 连续
// 0..pn-1）替换 interp_id 节点。q 的新 id = 原 id + pn；p 中所有子节点
// 引用 == interp_id 的位置替换为 q 根新 id（= pn）；interp_id 行删除。
// 返回拼接后的协议文本（节点 id 连续）。
func splice_proto(p: string, interp_id: i64, q: string) -> string {
    var p_lines = split_proto_lines(p)
    var q_lines = split_proto_lines(q)
    if len(p_lines) < 1 || len(q_lines) < 1 {
        g_err = "内部错误: 协议文本拼接失败（空协议）"
        return p
    }
    var pn = len(p_lines) - 1        // 首行是 "N:"，其余是节点行
    var qn = len(q_lines) - 1
    var qbase = pn - 1               // q 根新 id：p 删除 interp_id 行后剩 pn-1 个
    var out: string = to_string(pn - 1 + qn) + ":\n"
    var i: i64 = 1
    while i < len(p_lines) {
        var row = p_lines[i]
        // 跳过被替换的插值节点行
        if row_has_id(row, interp_id) {
            i = i + 1
            continue
        }
        // p 保留行：id > interp_id 减 1（删除补偿）；子引用 > interp_id 减 1，
        // == interp_id → qbase（q 根）
        out = out + row_splice_shift(row, interp_id, qbase) + "\n"
        i = i + 1
    }
    // 追加 q 的节点行（id 重映射 +qbase；q 根 id=0 → qbase）
    var j: i64 = 1
    while j < len(q_lines) {
        out = out + row_shift_ids(q_lines[j], qbase) + "\n"
        j = j + 1
    }
    return out
}

// 拼接保留行重映射：首字段（节点 id）> cut 时 -1；子引用（第 9 字段起）
// == cut → repl；> cut → -1；-1 哨兵与其余字段不变。id <= cut 不变
//（插值节点按 id 降序处理，剩余插值 id 均 < cut，不受删除影响）。
func row_splice_shift(row: string, cut: i64, repl: i64) -> string {
    var parts = split_by_space(row)
    if len(parts) < 8 {
        return row
    }
    var out: string = ""
    var i: i64 = 0
    while i < len(parts) {
        if i > 0 {
            out = out + " "
        }
        if i == 0 {
            var v0 = sstate.parse_dec(parts[i])
            if v0 > cut {
                out = out + to_string(v0 - 1)
            } else {
                out = out + parts[i]
            }
        } else if i >= 8 {
            var v = sstate.parse_dec(parts[i])
            if v < 0 {
                out = out + "-1"
            } else if v == cut {
                out = out + to_string(repl)
            } else if v > cut {
                out = out + to_string(v - 1)
            } else {
                out = out + parts[i]
            }
        } else {
            out = out + parts[i]
        }
        i = i + 1
    }
    return out
}

// 解析协议文本为行表（含首行 "N:"）。
func split_proto_lines(proto: string) -> table<string> {
    var rows = table_new_string()
    var n = str_len(proto)
    var start: i64 = 0
    var i: i64 = 0
    while i < n {
        if str_char(proto, i) == "\n" {
            table_push(rows, str.slice(proto, start, i))
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        table_push(rows, str.slice(proto, start, n))
    }
    return rows
}

// 行首 id 是否 == target（节点行首字段）。
func row_has_id(row: string, target: i64) -> bool {
    var sp = find_char_str(row, " ")
    if sp < 0 {
        return false
    }
    var idstr = str.slice(row, 0, sp)
    return sstate.parse_dec(idstr) == target
}

// 行内子节点字段（第 9 个字段起，下标 8）引用 == target → 替换为 repl。
func row_replace_child(row: string, target: i64, repl: i64) -> string {
    var parts = split_by_space(row)
    if len(parts) < 9 {
        return row
    }
    var out: string = ""
    var i: i64 = 0
    while i < len(parts) {
        if i > 0 {
            out = out + " "
        }
        if i >= 8 {
            if sstate.parse_dec(parts[i]) == target {
                out = out + to_string(repl)
                i = i + 1
                continue
            }
        }
        out = out + parts[i]
        i = i + 1
    }
    return out
}

// 行内 id 字段偏移 +off（追加段重映射）：首字段（节点 id）与第 9 字段起
// （子节点引用）偏移；name/val/aux/line/col 与 -1 哨兵不变。
func row_shift_ids(row: string, off: i64) -> string {
    var parts = split_by_space(row)
    if len(parts) < 8 {
        return row
    }
    var out: string = ""
    var i: i64 = 0
    while i < len(parts) {
        if i > 0 {
            out = out + " "
        }
        if i == 0 {
            var v0 = sstate.parse_dec(parts[i])
            out = out + to_string(v0 + off)
        } else if i >= 8 {
            var v = sstate.parse_dec(parts[i])
            if v < 0 {
                out = out + "-1"
            } else {
                out = out + to_string(v + off)
            }
        } else {
            out = out + parts[i]
        }
        i = i + 1
    }
    return out
}

// 按空格拆行（协议行字段；单空格分隔）。
func split_by_space(row: string) -> table<string> {
    var parts = table_new_string()
    var n = str_len(row)
    var start: i64 = 0
    var i: i64 = 0
    while i < n {
        if str_char(row, i) == " " {
            table_push(parts, str.slice(row, start, i))
            start = i + 1
        }
        i = i + 1
    }
    table_push(parts, str.slice(row, start, n))
    return parts
}

// 查找字符串中首个 ch 的位置（协议行辅助）。
func find_char_str(s: string, ch: string) -> i64 {
    var n = str_len(s)
    var i: i64 = 0
    while i < n {
        if str_char(s, i) == ch {
            return i
        }
        i = i + 1
    }
    return -1
}

// 把协议 P 中的 N_CODE_INTERP 节点行替换为 N_VAR 节点行（标识符引用，
// 名字 = s；`$x` 的值是 gensym 字符串时的表达式插值语义）。
func replace_interp_node_with_var(p: string, interp_id: i64, s: string) -> string {
    var p_lines = split_proto_lines(p)
    if len(p_lines) < 1 {
        return p
    }
    var pn = len(p_lines) - 1
    var out: string = to_string(pn) + ":\n"
    var name_id = interner.intern(s)
    var i: i64 = 1
    while i < len(p_lines) {
        var row = p_lines[i]
        if row_has_id(row, interp_id) {
            // 替换为该 N_VAR 节点行（行号/列号沿用插值节点）
            var parts = split_by_space(row)
            var l = "0"
            var c = "0"
            if len(parts) >= 7 {
                l = parts[5]
                c = parts[6]
            }
            out = out + to_string(interp_id) + " 6 " + to_string(name_id) +
                " -1 -1 " + l + " " + c + " 0\n"
        } else {
            out = out + row + "\n"
        }
        i = i + 1
    }
    return out
}

// 名字插值：协议 P 中 name 字段（第 3 个字段，下标 2）以 "$" 开头的节点行
// → 按值分派替换：字符串 → 该字符串；code 值（根 N_VAR）→ 其变量名。
// 覆盖 N_ASSIGN 目标（`$a = ...`）、N_FN_DEF/N_VAR_DECL 名（`func $nm()`）、
// N_FIELD_ACCESS 字段（`self.$field`）、N_PARAM 名。失败置 g_err。
func replace_name_interps(p: string) -> string {
    var p_lines = split_proto_lines(p)
    if len(p_lines) < 1 {
        return p
    }
    var out: string = p_lines[0] + "\n"
    var i: i64 = 1
    while i < len(p_lines) {
        var row = p_lines[i]
        var parts = split_by_space(row)
        if len(parts) >= 3 {
            var nid = sstate.parse_dec(parts[2])
            if nid >= 0 {
                var nm = interner.lookup(nid)
                var nml = str_len(nm)
                if nml > 1 {
                    if str_char(nm, 0) == "$" {
                        var vname = str.slice(nm, 1, nml)
                        var v = isess.lookup(vname)
                        if v < 0 {
                            g_err = "插值名变量 '" + vname + "' 未声明"
                            return p
                        }
                        var new_id: i64 = -1
                        if ivalue.type_of(v) == T_STR {
                            new_id = interner.intern(ivalue.str_val(v))
                        } else if ivalue.type_of(v) == T_CODE {
                            // 赋值目标插值：code 值根必须是 N_VAR → 取其变量名
                            new_id = code_root_var_name(ivalue.code_str(v))
                            if new_id < 0 {
                                return p
                            }
                        } else {
                            g_err = "插值名变量 '" + vname + "' 必须是字符串或 code（实际 " +
                                ivalue.type_name(v) + "）"
                            return p
                        }
                        parts[2] = to_string(new_id)
                        row = join_parts(parts)
                    }
                }
            }
        }
        out = out + row + "\n"
        i = i + 1
    }
    return out
}

// code 值（协议文本）的根节点变量名：解析协议 → 根（id 0）必须是 N_VAR
// → 返回其 name 池 id；否则置 g_err 返回 -1。注意：解析会重建 s_* 池
//（协议文本已独立，无副作用影响调用方）。
func code_root_var_name(proto: string) -> i64 {
    if sstate.load_ast(proto) < 0 {
        g_err = "内部错误: 插值 code 值解析失败"
        return -1
    }
    if s_n < 1 {
        g_err = "插值 code 值缺少节点"
        return -1
    }
    if s_tags[0] != N_VAR {
        g_err = "插值赋值目标必须是变量（code 值根不是变量节点）"
        return -1
    }
    return s_names[0]
}

// 字段拼接（split_by_space 的逆操作）。
func join_parts(parts: table<string>) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < len(parts) {
        if i > 0 {
            out = out + " "
        }
        out = out + parts[i]
        i = i + 1
    }
    return out
}

}   // namespace interp