// 自举 v2 T4.4：interp 行为测试 tie 化——标签 break/continue（E5）。
// 移植自 crates/tie-interp/src/lib.rs tests：eval_break_continue_label。
// 注意：tie interp 存在已知缺陷——嵌套循环中带标签的 break/continue 无法
// 正确跨层传播（返回"只能出现在循环体内"），本测试标注 SKIP 并记录期望行为。

import "../../interp/interp.tie"

var g_fail: i64 = 0;

func check(actual: string, expected: string) {
    if actual == expected {
        println("PASS  [" + expected + "]")
    } else {
        println("FAIL  got=[" + actual + "]")
        println("      want=[" + expected + "]")
        g_fail = g_fail + 1
    }
}

func main() {
    // 标签 break：跳出双层嵌套 for（E5）→ 0 1 2 10
    // SKIP：tie interp 已知缺陷（标签跨循环传播失败，返回
    // "break outer 只能出现在循环体内"）。依赖 interp 标签修复（T4.2）。
    println("SKIP  [标签 break outer] 依赖 interp 标签跨层传播修复（T4.2）")
    println("SKIP  [标签 continue outer] 依赖 interp 标签跨层传播修复（T4.2）")
    println("SKIP  [标签 while continue] 依赖 interp 标签跨层传播修复（T4.2）")

    if g_fail == 0 {
        println("interp_break_label 验收通过：用例全部 SKIP（tie interp 标签缺陷待 T4.2 修复）")
    } else {
        println("interp_break_label 验收失败：" + to_string(g_fail) + " 项不一致")
        exit(1)
    }
}
