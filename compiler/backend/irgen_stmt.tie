type tie<class>
// compiler/backend/irgen_stmt.tie —— 生成器 L4 语句/控制流层 子模块
// ============================================================
// 从 irgen.tie 拆分而来：这是 irgen LLVM 风格分层重构的 S5（第五步）。
// 本文件承载 L4 语句/控制流层：语句主调度器 gen_stmt、switch（gen_switch）、
// for 遍历（gen_for_chars/gen_for_table）、索引读写（gen_index_read/
// gen_index_assign）、打印（gen_println）、块语句（gen_block_stmts）、
// 变量引用收集（find_var_refs/collect_var_refs）等。
//
// 拆分范式：【同 namespace 跨文件】（文本内联）。
// 同 irgen_arith.tie（S3）/ irgen_expr.tie（S4）。irgen.tie 顶层 import 本文件
// 后，本文件被文本内联进同一编译单元，声明与 irgen.tie 相同的 `namespace irgen`，
// 同名 namespace 跨文件闭合并集：
//   - 同 namespace 函数可互相裸名调用（主文件照常裸名调用 gen_stmt 等）；
//   - 可访问主文件顶层全局 var（g_cur_block/g_cur_func/node_types/s_tags 等）；
//   - 本文件只含函数与注释，不含顶层全局 var 声明、不含 import——
//     全局 var 与 import 树均留在 irgen.tie 主文件，避免重复定义。
namespace irgen {
// 表下标读取 t[i]：动态表 → tie_table_at_<suffix>(表指针, i64, ok)。
// 简化（阶段 A）：不生成越界检查块（driver 树索引均有 len 守卫）。
func gen_index_read(id: i64) -> i64 {
    var base = sstate.child(id, 0)
    var idx = sstate.child(id, 1)
    var t = gen_expr(base)
    if t < 0 {
        return -1
    }
    var iv = gen_expr(idx)
    if iv < 0 {
        return -1
    }
    // E3 键值表读取：m[key] → tie_map_get / tie_map_get_string（键为字符串 ptr）。
    // base 类型是 map（作用域变量类型优先，其次 node_types）→ 走 map 桥，
    // 与 Rust 基线 ir.rs gen_index_assign 的 map 分支同构（tie_map_* 专用桥）。
    var base_is_map: bool = false
    var map_val_ty: i64 = types.named(TK_I64)
    if s_tags[base] == 6 {
        var bn_rd = interner.intern(sstate.name_str(base))
        if scope_get(bn_rd) >= 0 && types.is_map(g_lookup_ty) {
            base_is_map = true
            map_val_ty = types.low(g_lookup_ty)
        }
    }
    if !base_is_map {
        var bt_m = node_types[base]
        if types.is_map(bt_m) {
            base_is_map = true
            map_val_ty = types.low(bt_m)
        }
    }
    if base_is_map {
        // 裸 map（id == BASE_MAP，low 解码为 0）默认 i64 值；map<string> → string 值
        if map_val_ty <= 0 {
            map_val_ty = types.named(TK_I64)
        }
        var mret = types.named(TK_I64)
        if map_val_ty == types.named(TK_STR) {
            mret = types.named(TK_STR)
        }
        // 批次 7：内联二分/哈希读（替代 tie_map_get 桥）；缺失键 → 运行时错误
        return s21_map_get(t, iv, mret)
    }
    // 元素类型：base 是表变量 → 优先 irgen 作用域完整类型（参数/局部表变量），
    // 其次 node_types（semantic 持久节点类型），最后 var_table_elem
    //（sinfer.lv_telem 每函数重置，irgen 阶段只能查到最后一个函数——不可靠）
    var elem: i64 = types.named(TK_I64)
    if s_tags[base] == 6 {
        var bname = interner.intern(sstate.name_str(base))
        var matched: bool = false
        // irgen 自维护表变量元素类型（table_new_f64() 变量；语义层 lv_telem
        // 已过期）——最高优先级，f64 表读取必须选 at_f64 桥
        var tv0 = tblvar_get(bname)
        if tv0 >= 0 {
            elem = tv0
            matched = true
        }
        if !matched && scope_get(bname) >= 0 && types.is_table(g_lookup_ty) {
            var le = types.table_elem(g_lookup_ty)
            if le > 0 {
                elem = le
                matched = true
            }
        }
        if !matched {
            var bt2 = node_types[base]
            if types.is_table(bt2) {
                var le2 = types.table_elem(bt2)
                if le2 > 0 {
                    elem = le2
                    matched = true
                }
            }
        }
        if !matched {
            var te = sinfer.var_table_elem(bname)
            if te >= 0 {
                elem = te
                matched = true
            }
        }
        if !matched {
            // 最后 fallback：索引表达式的语义推断类型（裸 table 元素未知时，
            // semantic 按上下文推断——join 里 parts[i] 用于拼接 → TK_STR）
            var nt = node_types[id]
            if nt >= 0 && (nt == types.named(TK_STR) || types.is_int(nt) ||
                types.is_float(nt) || types.is_bool_like(nt)) {
                elem = nt
            }
        }
    } else {
        var bt = node_types[base]
        if types.is_table(bt) {
            var te2 = types.table_elem(bt)
            if te2 > 0 {
                elem = te2
            }
        }
    }
    var suffix = bridge_suffix(elem)
    var ret_ty = types.named(TK_I64)
    // 嵌套表元素（elem 是 table/map）：元素在动态表中存 ptr，读回必须用
    // at_string 桥（返回 ptr）——曾按 bridge_suffix 落 at_i64，返回 i64 与
    // 嵌套表变量的 ptr 槽不符（`var sub = t[i]` → `store ptr %r, ptr %slot`
    // 但 %r 是 i64，LLVM 拒收）。对齐 gen_table_lit 的按值类型选桥。
    // S2.4：port 对象元素（table<Drawable>）同样存 ptr，走 string 桥；但
    // 返回类型标为 K_PORT 本身（= ptr）而非 TK_STR——S2.1 补头逻辑按
    // ins_ty==TK_STR 判补头，port 对象 ptr 被误补头（strlen 扫描打包对象
    // {data,vtable} → 崩溃）。嵌套表/映射句柄同理（elem 类型本身 = ptr，
    // 不补头——补头只服务于真字符串元素）。
    if types.is_table(elem) || types.is_map(elem) || types.kind(elem) == K_PORT {
        suffix = "string"
        ret_ty = elem
    } else if suffix == "string" {
        ret_ty = types.named(TK_STR)
    } else if suffix == "f64" {
        // f64 表元素：返回类型 double（曾落默认 i64 → call i64 @tie_table_at_f64
        // 与 declare double 返回不匹配）
        ret_ty = types.named(TK_F64)
    } else if suffix == "bool" {
        ret_ty = types.named(TK_BOOL)
    }
    // ok 出参槽（越界标志；读越界置 ok=0 并返回元素零值）
    var ok_slot = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
    ir.add_operand(ok_slot, types.named(TK_I8), 2)
    var ok_addr = ir.get_value(ok_slot)
    return s21_table_at(t, iv, ok_addr, ret_ty)
}

// 表下标赋值 t[i] = v → tie_table_set_<suffix> 桥（void）。
// AST：IndexAssign[val=op, children=[目标(Index), 值]]。
func gen_index_assign(id: i64) -> i64 {
    var target = sstate.child(id, 0)
    var val = sstate.child(id, 1)
    var op = s_vals[id]  // 复合赋值码（-1 普通；0..17，对齐 B_*）
    // 目标必须是 Index：children=[base, index]
    var base = sstate.child(target, 0)
    var idx = sstate.child(target, 1)
    var t = gen_expr(base)
    if t < 0 {
        return -1
    }
    var iv = gen_expr(idx)
    if iv < 0 {
        return -1
    }
    // E3 键值表赋值：m[key] = v → tie_map_set / tie_map_set_string（键为字符串 ptr）。
    // base 类型是 map（作用域变量类型优先，其次 node_types）→ 走 map 桥，
    // 与 Rust 基线 ir.rs gen_index_assign 的 map 分支同构（含复合赋值读写回写）。
    var base_is_map: bool = false
    var map_val_ty: i64 = types.named(TK_I64)
    if s_tags[base] == 6 {
        var bn_as = interner.intern(sstate.name_str(base))
        if scope_get(bn_as) >= 0 && types.is_map(g_lookup_ty) {
            base_is_map = true
            map_val_ty = types.low(g_lookup_ty)
        }
    }
    if !base_is_map {
        var bt_m2 = node_types[base]
        if types.is_map(bt_m2) {
            base_is_map = true
            map_val_ty = types.low(bt_m2)
        }
    }
    if base_is_map {
        // 裸 map（low 解码为 0）默认 i64 值；map<string> → string 值
        if map_val_ty <= 0 {
            map_val_ty = types.named(TK_I64)
        }
        var is_str_m = map_val_ty == types.named(TK_STR)
        var pty_m = types.named(TK_I64)
        if is_str_m {
            pty_m = types.named(TK_STR)
        }
        // 复合赋值（m[k] += v）：先读旧值（s21_map_get，缺失 raise）→ 运算 → 写回
        var v_m: i64 = -1
        if op >= 0 {
            var old_m = s21_map_get(t, iv, pty_m)
            if old_m < 0 {
                return -1
            }
            var rv_m = gen_expr(val)
            if rv_m < 0 {
                return -1
            }
            v_m = gen_compound_assign(op, old_m, rv_m, pty_m)
            if v_m < 0 {
                sm_err_msg = "下标复合赋值运算失败（函数 " + g_cur_fn_name + "）"
                return -1
            }
        } else {
            v_m = gen_expr(val)
            if v_m < 0 {
                return -1
            }
        }
        s21_map_set(t, iv, v_m, pty_m)  // 批次 7：内联二分/哈希写（替代 tie_map_set 桥）
        return 0
    }
    // 元素类型：对齐 gen_index_read 的完整推断链（tblvar_get → 作用域类型 →
    // node_types → sinfer → 索引表达式类型 fallback）。曾为简化版只查 sinfer 与
    // node_types，导致 table<string> 等变量（存 string）元素类型推断为 i64，
    // 生成 tie_table_set_i64 传 string 值 → opt 类型错（pkg 编译失败根因）。
    var elem: i64 = types.named(TK_I64)
    if s_tags[base] == 6 {
        var bname = interner.intern(sstate.name_str(base))
        var matched: bool = false
        // irgen 自维护表变量元素类型（table_new_f64() 变量；语义层 lv_telem 已过期）
        var tv0 = tblvar_get(bname)
        if tv0 >= 0 {
            elem = tv0
            matched = true
        }
        if !matched && scope_get(bname) >= 0 && types.is_table(g_lookup_ty) {
            var le = types.table_elem(g_lookup_ty)
            if le > 0 {
                elem = le
                matched = true
            }
        }
        if !matched {
            var bt2 = node_types[base]
            if types.is_table(bt2) {
                var le2 = types.table_elem(bt2)
                if le2 > 0 {
                    elem = le2
                    matched = true
                }
            }
        }
        if !matched {
            var te = sinfer.var_table_elem(bname)
            if te >= 0 {
                elem = te
                matched = true
            }
        }
        if !matched {
            // 最后 fallback：索引表达式节点的语义推断类型（裸 table 元素未知时）
            var nt = node_types[id]
            if nt >= 0 && (nt == types.named(TK_STR) || types.is_int(nt) ||
                types.is_float(nt) || types.is_bool_like(nt)) {
                elem = nt
            }
        }
    } else {
        var bt = node_types[base]
        if types.is_table(bt) {
            var te2 = types.table_elem(bt)
            if te2 > 0 {
                elem = te2
            }
        }
    }
    var suffix = bridge_suffix(elem)
    var pty = types.named(TK_I64)
    // S2.4：port 对象元素（table<Drawable>）存 ptr → set_string 桥
    if types.kind(elem) == K_PORT {
        suffix = "string"
        pty = types.named(TK_STR)
    } else if suffix == "string" {
        pty = types.named(TK_STR)
    } else if suffix == "f64" {
        // f64 表元素：set 桥值参数 double（曾落默认 i64 →
        // tie_table_set_f64(..., i64 %double) 类型错）
        pty = types.named(TK_F64)
    } else if suffix == "bool" {
        pty = types.named(TK_BOOL)
    }
    // 复合赋值（t[i] += v）：先读旧值（s21_table_at 带越界判定）→ 运算 → 写回
    var v: i64 = -1
    if op >= 0 {
        var ok_r = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
        ir.add_operand(ok_r, types.named(TK_I8), 2)
        var old = s21_table_at(t, iv, ir.get_value(ok_r), pty)
        if old < 0 {
            return -1
        }
        var rv = gen_expr(val)
        if rv < 0 {
            return -1
        }
        v = gen_compound_assign(op, old, rv, pty)
        if v < 0 {
            sm_err_msg = "下标复合赋值运算失败（函数 " + g_cur_fn_name + "）"
            return -1
        }
    } else {
        v = gen_expr(val)
        if v < 0 {
            return -1
        }
    }
    s21_table_set(t, iv, pty, v)  // 下标写：越界静默跳过（不追加）
    return 0
}

// Switch：driver 树仅字符串 subject（typekw_index）。逐 case strcmp 比较链：
//   cmp = strcmp(subj, case_val)；命中 → body；否则下一 case / default。
// AST：Switch[aux=ncases, children=[subject]+cases...+[default]]；
//   SwitchCase[children=[PatternList, when 或 -1, body]]。
func gen_switch(id: i64) -> i64 {
    var subject = sstate.child(id, 0)
    var sv = gen_expr(subject)
    if sv < 0 {
        return -1
    }
    // subject 类型分派：字符串 → strcmp 比较链；整数/char → icmp 比较链；
    // 枚举 → 提取 tag（槽 0）后与 case 的 tag 常量 icmp 比较
    var subj_is_str = node_types[subject] == types.named(TK_STR)
    var subj_ty = node_types[subject]
    var subj_is_enum = types.kind(subj_ty) == K_ENUM
    var enum_tag_v: i64 = -1
    if subj_is_enum {
        // 枚举 subject：gen_agg_addr(subject) → agg_gep 下标 0 → load i64（tag）
        var eaddr = gen_agg_addr(subject, subj_ty)
        if eaddr < 0 {
            return -1
        }
        var egp = ir.new_inst(g_cur_block, 27, subj_ty)
        ir.add_operand(egp, eaddr, 0)
        ir.add_operand(egp, 0, 2)
        var egpp = ir.get_value(egp)
        var eld = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(eld, egpp, 0)
        enum_tag_v = ir.get_value(eld)
    }
    var ncases = s_aux[id]
    var exit_blk = ir.new_block(g_cur_func, interner.intern("sw.exit"))
    // 逐个 case：PatternList 多模式（任一命中 → body；含 Range 范围模式）
    var k: i64 = 0
    while k < ncases {
        var case_node = sstate.child(id, 1 + k)
        var pl = sstate.child(case_node, 0)
        var body = sstate.child(case_node, 2)
        var body_blk = ir.new_block(g_cur_func, interner.intern("sw.body"))
        var next_blk = ir.new_block(g_cur_func, interner.intern("sw.next"))
        var npat = sstate.nchild(pl)
        // 逐个模式比较链：eq → body；ne → 下一模式块
        var i: i64 = 0
        while i < npat {
            var pat = sstate.child(pl, i)
            var eq_v: i64 = -1
            if subj_is_enum {
                // 枚举 case：模式 = FieldAccess(Enum.Variant) → 解析为 tag 常量，
                // 与提取出的 subject tag icmp eq（scheck 已校验变体合法）。
                // 不可用 gen_expr(pat)——FieldAccess 枚举分支会构造聚合值。
                var ptag = enum_case_tag(pat, subj_ty)
                if ptag < 0 {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "case 值不是枚举 '" + types.type_name(subj_ty) + "' 的变体引用（函数 " + g_cur_fn_name + "）"
                    return -1
                }
                var pv2 = gen_int_lit_ty(ptag, types.named(TK_I64))
                var is_eq2 = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
                ir.add_operand(is_eq2, enum_tag_v, 0)
                ir.add_operand(is_eq2, pv2, 0)
                ir.add_operand(is_eq2, 0, 2)  // eq
                eq_v = ir.get_value(is_eq2)
            } else if s_tags[pat] == 11 {
                // Range 模式（case 3..7 → sv >= 3 && sv < 7）
                var rs = gen_expr(sstate.child(pat, 0))
                if rs < 0 {
                    return -1
                }
                var re = gen_expr(sstate.child(pat, 1))
                if re < 0 {
                    return -1
                }
                var ge = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp sge
                ir.add_operand(ge, sv, 0)
                ir.add_operand(ge, rs, 0)
                ir.add_operand(ge, 5, 2)  // sge
                var ge_v = ir.get_value(ge)
                var lt = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp slt
                ir.add_operand(lt, sv, 0)
                ir.add_operand(lt, re, 0)
                ir.add_operand(lt, 2, 2)  // slt
                var lt_v = ir.get_value(lt)
                var and = ir.new_inst(g_cur_block, 6, types.named(TK_BOOL))  // and i1
                ir.add_operand(and, ge_v, 0)
                ir.add_operand(and, lt_v, 0)
                eq_v = ir.get_value(and)
            } else {
                var pv = gen_expr(pat)
                if pv < 0 {
                    return -1
                }
                if subj_is_str {
                    // 字符串比较：strcmp(sv, pv) == 0
                    var cmp = gen_ext_call2("strcmp", sv, types.named(TK_STR), pv, types.named(TK_STR), types.named(TK_I32))
                    if cmp < 0 {
                        return -1
                    }
                    var is_eq = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
                    ir.add_operand(is_eq, cmp, 0)
                    ir.add_operand(is_eq, 0, 2)
                    ir.add_operand(is_eq, 0, 2)  // eq
                    eq_v = ir.get_value(is_eq)
                } else {
                    // 整数/char 比较：icmp eq（值可能为 i64 整数或 i32 char——
                    // 以 sv 定义类型为准，llvmgen icmp 按 lhs 定义类型选宽度）
                    var is_eq = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
                    ir.add_operand(is_eq, sv, 0)
                    ir.add_operand(is_eq, pv, 0)
                    ir.add_operand(is_eq, 0, 2)  // eq
                    eq_v = ir.get_value(is_eq)
                }
            }
            var np_blk = ir.new_block(g_cur_func, interner.intern("sw.np"))
            if subj_is_enum && s_tags[pat] == N_CASE_BIND {
                // 批次 7：枚举变体解构——命中 → 绑定块（提取 payload → 绑定变量）→ body
                var bind_blk = ir.new_block(g_cur_func, interner.intern("sw.bind"))
                var cb = ir.new_inst(g_cur_block, 31, -1)
                ir.add_operand(cb, eq_v, 0)
                ir.add_operand(cb, bind_blk, 1)
                ir.add_operand(cb, np_blk, 1)
                // 绑定块：payload 提取 + 变量绑定（gen_case_bind_body）
                g_cur_block = bind_blk
                var bb2 = gen_case_bind_body(subject, subj_ty, pat)
                if bb2 < 0 {
                    return -1
                }
                var brb = ir.new_inst(g_cur_block, 30, -1)  // br body
                ir.add_operand(brb, body_blk, 1)
                g_cur_block = np_blk
            } else {
                var cb = ir.new_inst(g_cur_block, 31, -1)
                ir.add_operand(cb, eq_v, 0)
                ir.add_operand(cb, body_blk, 1)
                ir.add_operand(cb, np_blk, 1)
                g_cur_block = np_blk
            }
            i = i + 1
        }
        // 所有模式未命中 → next case
        if !block_terminated() {
            var bnx = ir.new_inst(g_cur_block, 30, -1)  // br next
            ir.add_operand(bnx, next_blk, 1)
        }
        // body 块
        g_cur_block = body_blk
        var bb = gen_block_stmts(body)
        if bb < 0 {
            return -1
        }
        if !block_terminated() {
            var br1 = ir.new_inst(g_cur_block, 30, -1)  // br exit
            ir.add_operand(br1, exit_blk, 1)
        }
        // next 块
        g_cur_block = next_blk
        k = k + 1
    }
    // default 体（最后一个 child）
    var default_list = sstate.child(id, 1 + ncases)
    if default_list >= 0 && sstate.nchild(default_list) > 0 {
        var db = gen_block_stmts(default_list)
        if db < 0 {
            return -1
        }
    }
    if !block_terminated() {
        var br2 = ir.new_inst(g_cur_block, 30, -1)  // br exit
        ir.add_operand(br2, exit_blk, 1)
    }
    g_cur_block = exit_blk
    return 0
}

// println/print 生成：printf 调用（格式串 + 参数）
// 最小集：空 → "\n"；字符串 → "%s\n" + ptr；整数 → "%lld\n" + i64
// 格式串用真实文本（tie 字符串中 % 原样、\n 为换行），llvmgen 端转义为 c"...\00"
func gen_println(id: i64, newline: bool) -> i64 {
    // Call children = [泛型槽, 实参...]：`println()` 槽占位 → 实参数 = nchild-1
    var nc = sstate.nchild(id) - sstate.slot_off(id)
    var nl = "\n"
    if !newline {
        nl = ""
    }
    if nc == 0 {
        // 空 println → 换行
        var fmt = interner.intern(nl)
        // call_vararg（printf）结果：llvmgen 生成 `%N = call i32 (ptr, ...)`——
        // 必须有结果寄存器，ty 用 i32（TK_I32）
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)  // OK_VALUE 格式串池 id
        return ir.get_value(inst)
    }
    // 实参 = children[slot_off]（children[0] 是泛型槽）
    var arg = sstate.child(id, sstate.slot_off(id))
    var atag = s_tags[arg]
    if atag == 2 {
        // 字符串参数：格式 "%s\n" + 字符串指针
        var sval = gen_str_lit(s_names[arg])
        var fmt = interner.intern("%s" + nl)
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)
        ir.add_operand(inst, sval, 0)
        return ir.get_value(inst)
    }
    if atag == 6 && scope_get(s_names[arg]) >= 0 && g_lookup_ty == types.named(TK_STR) {
        // T4.5：字符串类型变量（如 `var p: string = get_env("PATH")`）→ "%s\n" + ptr
        var sval = gen_var_ref(s_names[arg])
        if sval < 0 {
            return -1
        }
        var fmt = interner.intern("%s" + nl)
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)
        ir.add_operand(inst, sval, 0)
        return ir.get_value(inst)
    }
    // 字符串表达式（str_cat 拼接 / 返回 string 的调用等）：node_types 推断为
    // TK_STR → "%s\n" + ptr。曾漏此分支：拼接结果走 %lld 打印指针值（乱码）
    if node_types[arg] == types.named(TK_STR) {
        var sval2 = gen_expr(arg)
        if sval2 < 0 {
            return -1
        }
        var fmt2 = interner.intern("%s" + nl)
        var inst2 = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst2, fmt2, 0)
        ir.add_operand(inst2, sval2, 0)
        return ir.get_value(inst2)
    }
    // 批次 7：键值表（map）参数 → s21_map_to_string 内联（键升序 {k: v, k2: v2}，
    // 替代旧 %lld 打印指针值）。检测对齐 gen_index_read 的 map 分支（作用域类型
    // 优先，其次 node_types）。
    var m_is_map: bool = false
    var m_vty: i64 = types.named(TK_I64)
    if atag == 6 {
        var mn = interner.intern(sstate.name_str(arg))
        if scope_get(mn) >= 0 && types.is_map(g_lookup_ty) {
            m_is_map = true
            m_vty = types.low(g_lookup_ty)
        }
    }
    if !m_is_map {
        var mt = node_types[arg]
        if types.is_map(mt) {
            m_is_map = true
            m_vty = types.low(mt)
        }
    }
    if m_is_map {
        if m_vty <= 0 {
            m_vty = types.named(TK_I64)
        }
        var mv = gen_expr(arg)
        if mv < 0 {
            return -1
        }
        var ms = s21_map_to_string(mv, m_vty)
        var fm = interner.intern("%s" + nl)
        var im = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(im, fm, 0)
        ir.add_operand(im, ms, 0)
        return ir.get_value(im)
    }
    // 浮点参数（f64/f32）：格式 "%f"（printf 变参要求 double，f32 需 fpext 提升——
    // 语义层 f32 场景罕见，按 f64 处理；f32 值经 fpext 指令提升）
    // num 宽类型变量（语义 node_types=TK_NUM）按槽类型补判——`var b: num = 3.14`
    // 归约后槽是 f64，node_types 仍是 TK_NUM（曾误走 %lld 打印指针值）
    var f_is_f = node_types[arg] == types.named(TK_F64) || node_types[arg] == types.named(TK_F32)
    if !f_is_f && node_types[arg] == types.named(TK_NUM) && s_tags[arg] == 6 {
        var fnid = interner.intern(sstate.name_str(arg))
        if scope_get(fnid) >= 0 && types.is_float(g_lookup_ty) {
            f_is_f = true
        }
    }
    if f_is_f {
        var fv = gen_expr(arg)
        if fv < 0 {
            return -1
        }
        var fref: i64 = fv
        if node_types[arg] == types.named(TK_F32) {
            // f32 → f64 提升（printf 变参提升规则；fpext 无专用 opcode，
            // 用 fsub 0.0 保留值不可行——f32 值作为 f64 操作数需转换指令。
            // 简化：tie 语义层 f32 推断均落 f64，防御性按 double 直传）
        }
        var fmt = interner.intern("%f" + nl)
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)
        ir.add_operand(inst, fref, 0)
        return ir.get_value(inst)
    }
    // 字符参数（char）：格式 "%c"（i32 值，直传）
    if node_types[arg] == types.named(TK_CHAR) {
        var cv = gen_expr(arg)
        if cv < 0 {
            return -1
        }
        var fmt = interner.intern("%c" + nl)
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)
        ir.add_operand(inst, cv, 0)
        return ir.get_value(inst)
    }
    // trit 参数：格式 "%d"（i8 → sext i32，printf 变参提升；对齐 Rust i8/i16 分支）
    if node_types[arg] == types.named(TK_TRIT) {
        var tv = gen_expr(arg)
        if tv < 0 {
            return -1
        }
        var sext = ir.new_inst(g_cur_block, 19, types.named(TK_I32))  // sext i8→i32
        ir.add_operand(sext, types.named(TK_I8), 2)
        ir.add_operand(sext, tv, 0)
        var sv = ir.get_value(sext)
        var fmt = interner.intern("%d" + nl)
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)
        ir.add_operand(inst, sv, 0)
        return ir.get_value(inst)
    }
    // i128/u128 参数（批次 2）：内联除法循环生成十进制字符串 → "%s\n" + ptr。
    // 不能直传 printf（变参 i128 与 %lld 类型不匹配，opt 报类型错）。
    if node_types[arg] == types.named(TK_I128) || node_types[arg] == types.named(TK_U128) {
        var av = gen_expr(arg)
        if av < 0 {
            return -1
        }
        var sv = gen_i128_to_str(av, node_types[arg] == types.named(TK_I128))
        var fmt = interner.intern("%s" + nl)
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)
        ir.add_operand(inst, sv, 0)
        return ir.get_value(inst)
    }
    // 整数参数（i64）：格式 "%lld\n"
    var av = gen_expr(arg)
    if av < 0 {
        return -1
    }
    var fmt = interner.intern("%lld" + nl)
    var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
    ir.add_operand(inst, fmt, 0)
    ir.add_operand(inst, av, 0)
    return ir.get_value(inst)
}

// 语句生成：0 成功 / -1 错误
func gen_stmt(id: i64) -> i64 {
    var tag = s_tags[id]
    if tag == 100 {
        // VarDecl：children=[ty 或 -1, init]
        var nm = s_names[id]
        var ty_node = sstate.child(id, 0)
        var init = sstate.child(id, 1)
        var ty: i64 = types.named(3)  // 默认 i64
        if ty_node >= 0 {
            ty = sgen.parse_generic_type_node(ty_node)
            if ty < 0 {
                return -1
            }
            // 宽类型归约：num/text/misc 是宽类型框（对齐 Rust 语义层展开），
            // llvm_ty 无映射（兜底 ptr）——按 init 的实际推断类型定槽型：
            //   num + 整数 → i64；num + 浮点 → f64；text + 字符串 → ptr；
            //   misc + bool → i1
            if init >= 0 && (ty == types.named(TK_NUM) || ty == types.named(TK_TEXT) ||
                ty == types.named(TK_MISC)) {
                var wt = node_types[init]
                if wt >= 0 {
                    ty = wt
                }
            }
        } else if init >= 0 {
            // 无类型标注：按初始化表达式的推断类型定槽型。
            // 表/映射/字符串 → TK_STR（ptr 槽：表指针 / 字符串指针统一 ptr，
            // 与 llvmgen store 的 to_ptr 转换配套）；bool → TK_BOOL（i1 槽，
            // icmp 结果是 i1——曾默认 i64 槽导致 store i64 %i1 类型错）；
            // 元组/struct → 聚合类型 id（alloca {..} 聚合槽）；
            // 其余默认 i64。
            var it = node_types[init]
            if it >= 0 && (types.is_table(it) || types.is_map(it) || it == types.named(TK_STR)) {
                ty = types.named(TK_STR)
            } else if it == types.named(TK_TRIT) {
                // trit：i8 槽（compare() 返回 trit 变量——曾落入 is_bool_like
                // 判为 i1 槽，store i8 %i1 类型错）
                ty = types.named(TK_TRIT)
            } else if it >= 0 && types.is_bool_like(it) {
                ty = types.named(TK_BOOL)
            } else if it >= 0 && types.is_float(it) {
                // 浮点推断（f64/f32）：mean(...) 返回 f64 → alloca double 槽
                //（曾落默认 i64 → store i64 %double 类型错）
                ty = it
            } else if it >= 0 && types.is_int(it) {
                // S1.3 窄整数推断（后缀字面量 `var a = 42i32`）：窄槽
                //（语义类型 i32 与槽型须一致，否则 load i64 被按 i32 sext 类型错）
                ty = it
            } else if it >= 0 && types.is_unsafe_ty(it) {
                // S1.2：指针/切片/原子类型推断（`var p = addr_of(x)`）→
                // 对应槽（alloca ptr / alloca {ptr,i64} / alloca 元素型）
                ty = it
            } else if it >= 0 && (types.kind(it) == K_TUPLE || types.kind(it) == K_STRUCT || types.kind(it) == K_ENUM || types.kind(it) == K_FN || types.kind(it) == K_PORT) {
                // 聚合变量：alloca 聚合槽，init（构造调用/元组字面量/返回）求聚合值
                // （K_ENUM 2026-08-15：枚举变量同 struct——alloca %enum.X 槽，
                // init 的 FieldAccess/MethodCall 构造求聚合值，store 类型匹配；
                // K_FN S2.2：闭包字面量/函数值参数 → alloca %fn.X 槽；
                // K_PORT S2.4：port 对象（ptr 表示）→ alloca ptr 槽）
                ty = it
            }
        }
        // alloca + store
        var alloca = ir.new_inst(g_cur_block, 20, ty)  // alloca
        ir.add_operand(alloca, ty, 2)  // 类型立即数（占位）
        var av = ir.get_value(alloca)
        if init >= 0 {
            // S2.4：port 对象变量初始化——提升（struct → port 打包）或
            // port 拷贝（ptr 复制）。见 gen_port_coerce 注释。
            if types.kind(ty) == K_PORT {
                var it4 = node_types[init]
                var pv: i64 = -1
                if it4 >= 0 && types.kind(it4) == K_STRUCT {
                    pv = gen_port_coerce(init, ty)
                } else {
                    pv = gen_expr(init)
                }
                if pv < 0 {
                    return -1
                }
                var store = ir.new_inst(g_cur_block, 22, -1)  // store
                ir.add_operand(store, ty, 2)
                ir.add_operand(store, pv, 0)
                ir.add_operand(store, av, 0)
                scope_put(nm, av, ty)
                return 0
            }
            // DEBUG 临时
            // IntLit 初始化：按声明类型生成常量（i32 变量存 i32 值，否则
            // llvmgen 的 store i32 %N 会因 %N 是 i64 const_i 而类型不匹配）；
            // 其余表达式走 gen_expr（结果恒 i64，与 llvmgen store 的 vty 匹配
            // 需初始化类型为 i64——非 i64 初始化目前仅支持整数常量）。
            var iv: i64 = -1
            if s_tags[init] == 4 && ty == types.named(TK_TRIT) {
                // BoolLit 适配 trit（语义层 node_types 仍标 TK_BOOL，但标注类型
                // trit 需生成 i8 值：true→1 / false→-1——否则 store i8 %i1 类型错）
                var tv: i64 = -1
                if s_vals[init] == 1 {
                    tv = 1
                }
                iv = gen_trit_lit(tv)
            } else if s_tags[init] == 1 && ty == types.named(TK_F32) {
                // FloatLit 适配 f32 声明：按 f32 生成常量（S1.3，默认 f64）
                iv = gen_float_lit_ty(s_names[init], types.named(TK_F32))
            } else if s_tags[init] == 0 {
                iv = gen_int_lit_ty(s_vals[init], ty)
            } else if s_tags[init] == 14 && types.kind(ty) == K_TUPLE {
                // 元组字面量 + 元组类型标注：按目标类型构造（(i32,i64) 标注 +
                // (7,8) 字面量——语义层推断字面量为 (i64,i64)，不按目标类型
                // 构造会 store {i64,i64} 到 {i32,i64} 槽，LLVM 类型不匹配）
                iv = gen_tuple_lit_typed(init, ty)
            } else {
                iv = gen_expr(init)
                // S1.3 C2：表达式类型 ≠ 声明类型（数字族）→ 转换。
                // IntLit/FloatLit 已按类型生成（gen_int_lit_ty / 浮点常量），
                // 变量/运算结果按语义层拓宽规则转换（i16 变量 → i64 声明）。
                if iv >= 0 {
                    var it3 = node_types[init]
                    if it3 >= 0 && (types.is_int(it3) || types.is_float(it3)) &&
                        (types.is_int(ty) || types.is_float(ty)) && it3 != ty {
                        var cv2 = gen_coerce(iv, it3, ty)
                        if cv2 < 0 {
                            return -1
                        }
                        iv = cv2
                    }
                }
            }
            if iv < 0 {
                return -1
            }
            var store = ir.new_inst(g_cur_block, 22, -1)  // store
            ir.add_operand(store, ty, 2)
            ir.add_operand(store, iv, 0)
            ir.add_operand(store, av, 0)
        }
        scope_put(nm, av, ty)
        // 表变量元素类型登记（table_push/table_at 选桥用）：
        // init 是 table<T>（含 table_new_* 调用）→ 记录元素类型。语义层
        // var_table_elem 已过期（per-function），table_new_f64() 返回裸 table
        // 无法从 node_types 得知元素类型。
        if init >= 0 {
            var tv_te: i64 = -1
            var it2 = node_types[init]
            if types.is_table(it2) && types.table_elem(it2) > 0 {
                tv_te = types.table_elem(it2)
            } else if s_tags[init] == 7 {
                var init_nm = sstate.name_str(init)
                if init_nm == "table_new_f64" {
                    tv_te = types.named(TK_F64)
                } else if init_nm == "table_new_string" {
                    tv_te = types.named(TK_STR)
                } else if init_nm == "table_new_bool" {
                    tv_te = types.named(TK_BOOL)
                } else if init_nm == "table_new_i64" {
                    tv_te = types.named(TK_I64)
                }
            }
            if tv_te >= 0 {
                // 键统一用 interner.intern（s_names[id] 是 parser 的 intern 池，
                // 与 table_push 的 interner.intern(tname) 不同池，id 不可比）
                tblvar_put(interner.intern(sstate.name_str(id)), tv_te)

            }
        }
        return 0
    }
    if tag == 102 {
        // ExprStmt
        var e = sstate.child(id, 0)
        return gen_expr(e)
    }
    if tag == 130 {
        // S1.2 U3 unsafe 块：语义层已校验块内操作合法（unsafe 上下文），
        // irgen 只遍历子 StmtList 生成（无额外安全检查）
        var blk = sstate.child(id, 0)
        if blk < 0 {
            return 0
        }
        var n = sstate.nchild(blk)
        var i: i64 = 0
        while i < n {
            var r = gen_stmt(sstate.child(blk, i))
            if r < 0 {
                return -1
            }
            i = i + 1
        }
        return 0
    }
    if tag == 104 {
        // Return：children=[expr 或 -1]。ret 类型 = 表达式语义类型（i64/f64/
        // 聚合/字符串 ptr——曾硬编码 i64，元组/浮点返回会类型不匹配）。
        // BoolLit 适配 trit：返回 trit 的函数里 `return false/true` → i8
        var v = sstate.child(id, 0)
        if v >= 0 {
            var rv: i64 = -1
            if s_tags[v] == 4 && g_cur_ret_ty == types.named(TK_TRIT) {
                var tv: i64 = -1
                if s_vals[v] == 1 {
                    tv = 1
                }
                rv = gen_trit_lit(tv)
            } else {
                rv = gen_expr(v)
            }
            if rv < 0 {
                return -1
            }
            var rty = node_types[v]
            if rty < 0 {
                rty = types.named(TK_I64)
            }
            // S1.3 C2：返回值类型 ≠ 函数返回类型（数字族）→ 转换
            // （窄返回类型函数：`return i64 表达式` → trunc 到返回宽度）
            if g_cur_ret_ty >= 0 && (types.is_int(rty) || types.is_float(rty)) &&
                (types.is_int(g_cur_ret_ty) || types.is_float(g_cur_ret_ty)) &&
                rty != g_cur_ret_ty {
                var cr = gen_coerce(rv, rty, g_cur_ret_ty)
                if cr < 0 {
                    return -1
                }
                rv = cr
                rty = g_cur_ret_ty
            }
            var ret = ir.new_inst(g_cur_block, 32, rty)  // ret
            ir.add_operand(ret, rv, 0)
        } else {
            // void 无值 return：main 特判 ret i32 0（CRT 退出码正确性，对齐 Rust 侧
            // gen_stmt 的 void main return 处理——define i32 @main 与 ret void 不匹配）；
            // 其余 void 函数 ret void。
            if g_cur_fn_name == "main" {
                var ret = ir.new_inst(g_cur_block, 32, types.named(TK_I32))  // ret i32 0
                ir.add_operand(ret, 0, 2)
            } else {
                var ret = ir.new_inst(g_cur_block, 32, -1)  // ret void
            }
        }
        return 0
    }
    if tag == 105 {
        // If：children=[cond, then, else]
        var cond = gen_expr(sstate.child(id, 0))
        if cond < 0 {
            return -1
        }
        var then_blk = ir.new_block(g_cur_func, interner.intern("if.then"))
        var else_blk = ir.new_block(g_cur_func, interner.intern("if.else"))
        var merge_blk = ir.new_block(g_cur_func, interner.intern("if.merge"))
        // cond_br：条件 + then + else
        var cbr = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbr, cond, 0)
        ir.add_operand(cbr, then_blk, 1)
        ir.add_operand(cbr, else_blk, 1)
        // then 分支
        g_cur_block = then_blk
        var then_list = sstate.child(id, 1)
        var t = gen_block_stmts(then_list)
        if t < 0 {
            return -1
        }
        if !block_terminated() {
            var br1 = ir.new_inst(g_cur_block, 30, -1)  // br merge
            ir.add_operand(br1, merge_blk, 1)
        }
        // else 分支
        g_cur_block = else_blk
        var else_list = sstate.child(id, 2)
        if else_list >= 0 {
            var e = gen_block_stmts(else_list)
            if e < 0 {
                return -1
            }
        }
        if !block_terminated() {
            var br2 = ir.new_inst(g_cur_block, 30, -1)
            ir.add_operand(br2, merge_blk, 1)
        }
        // merge
        g_cur_block = merge_blk
        return 0
    }
    if tag == 107 {
        // For：name=迭代变量, children=[iter, body]
        // 范围 0..N 最小集；表遍历 `for item in arr`（iter 为 Var 表变量）；
        // 字符串码点迭代 `for c in s.chars()`（dev33 批次4，iter 为 MethodCall）。
        var iter = sstate.child(id, 0)
        var body = sstate.child(id, 1)
        var iter_tag = s_tags[iter]
        if iter_tag == 18 {
            // 字符串码点迭代器 `.chars()`：走 UTF-8 码点步进循环
            if is_chars_method(iter) {
                var fc = gen_for_chars(id, iter, body)
                if fc < 0 {
                    return -1
                }
                return 0
            }
        }
        if iter_tag != 11 {
            // for-in 表迭代（动态表）：计数器 0..len(t) + tie_table_at 读取
            var fr = gen_for_table(id, iter, body)
            if fr < 0 {
                return -1
            }
            return 0
        }
        var start = gen_expr(sstate.child(iter, 0))
        if start < 0 {
            return -1
        }
        var end = gen_expr(sstate.child(iter, 1))
        if end < 0 {
            return -1
        }
        // 循环变量 alloca + 初始值
        var var_alloca = ir.new_inst(g_cur_block, 20, types.named(3))
        ir.add_operand(var_alloca, types.named(3), 2)
        var va = ir.get_value(var_alloca)
        var sv = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(sv, types.named(3), 2)
        ir.add_operand(sv, start, 0)
        ir.add_operand(sv, va, 0)
        scope_put(s_names[id], va, types.named(3))
        // cond/body/step/exit 块
        var cond_blk = ir.new_block(g_cur_func, interner.intern("for.cond"))
        var body_blk = ir.new_block(g_cur_func, interner.intern("for.body"))
        var step_blk = ir.new_block(g_cur_func, interner.intern("for.step"))
        var exit_blk = ir.new_block(g_cur_func, interner.intern("for.exit"))
        // 循环上下文：continue → step（自增后），break → exit
        loop_push(s_aux[id], exit_blk, step_blk)
        var b0 = ir.new_inst(g_cur_block, 30, -1)  // br cond
        ir.add_operand(b0, cond_blk, 1)
        // cond 块：cur < end → body，否则 exit
        g_cur_block = cond_blk
        var cur = ir.new_inst(g_cur_block, 21, types.named(3))
        ir.add_operand(cur, va, 0)
        var cur_v = ir.get_value(cur)
        var cmp = ir.new_inst(g_cur_block, 12, types.named(10))  // icmp, i1
        ir.add_operand(cmp, cur_v, 0)
        ir.add_operand(cmp, end, 0)
        ir.add_operand(cmp, 2, 2)  // lt
        var cmp_v = ir.get_value(cmp)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, cmp_v, 0)
        ir.add_operand(cb, body_blk, 1)
        ir.add_operand(cb, exit_blk, 1)
        // body 块
        g_cur_block = body_blk
        var bb = gen_block_stmts(body)
        if bb < 0 {
            return -1
        }
        if !block_terminated() {
            var bb2 = ir.new_inst(g_cur_block, 30, -1)  // br step
            ir.add_operand(bb2, step_blk, 1)
        }
        // step 块：cur + 1 → store → br cond
        g_cur_block = step_blk
        var add1 = ir.new_inst(g_cur_block, 0, types.named(3))  // add
        ir.add_operand(add1, cur_v, 0)
        ir.add_operand(add1, 1, 2)  // 立即数 1
        var add_v = ir.get_value(add1)
        var st = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st, types.named(3), 2)
        ir.add_operand(st, add_v, 0)
        ir.add_operand(st, va, 0)
        var sb = ir.new_inst(g_cur_block, 30, -1)  // br cond
        ir.add_operand(sb, cond_blk, 1)
        // exit 块
        g_cur_block = exit_blk
        loop_pop()
        return 0
    }
    if tag == 106 {
        // While：children=[cond, body]。cond_br 回边 + 循环上下文
        var cond = sstate.child(id, 0)
        var body = sstate.child(id, 1)
        var label = s_names[id]
        var cond_blk = ir.new_block(g_cur_func, interner.intern("while.cond"))
        var body_blk = ir.new_block(g_cur_func, interner.intern("while.body"))
        var exit_blk = ir.new_block(g_cur_func, interner.intern("while.exit"))
        loop_push(label, exit_blk, cond_blk)
        var b0 = ir.new_inst(g_cur_block, 30, -1)  // br cond
        ir.add_operand(b0, cond_blk, 1)
        // cond 块：条件 → body / exit
        g_cur_block = cond_blk
        var cv = gen_expr(cond)
        if cv < 0 {
            return -1
        }
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, cv, 0)
        ir.add_operand(cb, body_blk, 1)
        ir.add_operand(cb, exit_blk, 1)
        // body 块
        g_cur_block = body_blk
        var bb = gen_block_stmts(body)
        if bb < 0 {
            return -1
        }
        if !block_terminated() {
            var bb2 = ir.new_inst(g_cur_block, 30, -1)  // br cond
            ir.add_operand(bb2, cond_blk, 1)
        }
        // exit 块
        g_cur_block = exit_blk
        loop_pop()
        return 0
    }
    if tag == 108 {
        // Break：br 到循环 exit 块
        var tgt = loop_find_break(s_names[id])
        if tgt < 0 {
            return -1
        }
        var b = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(b, tgt, 1)
        return 0
    }
    if tag == 109 {
        // Continue：br 到循环 cond/step 块
        var tgt = loop_find_cont(s_names[id])
        if tgt < 0 {
            return -1
        }
        var b = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(b, tgt, 1)
        return 0
    }
    if tag == 103 {
        // Assign：name=目标名, val=op（-1 普通；0..17 复合赋值码，对齐 B_*），
        // children=[值]。复合赋值：load 旧值 → 运算 → store（对齐 Rust 同路径）。
        // 注意：目标槽（g_lookup_alloca）必须**先保存**——gen_expr(val) 求值会
        // 覆盖全局槽（x = y 时 y 的 scope_get 覆盖 g_lookup_alloca），曾导致
        // store 存错目标（a &= b 把结果存进 b）。
        var nm = sstate.name_str(id)
        var val = sstate.child(id, 0)
        var op = s_vals[id]
        var nid = interner.intern(nm)
        if scope_get_global(nid) < 0 {
            sm_err_msg = "赋值目标 '" + nm + "' 未入作用域（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var tgt_alloca = g_lookup_alloca
        var tgt_global = g_lookup_is_global
        var tgt_ty = g_lookup_ty
        var vv: i64 = -1
        if op >= 0 {
            // 复合赋值：先 load 旧值
            var cur = ir.new_inst(g_cur_block, 21, tgt_ty)  // load
            if tgt_global > 0 {
                ir.add_operand(cur, tgt_alloca, 3)
            } else {
                ir.add_operand(cur, tgt_alloca, 0)
            }
            var cur_v = ir.get_value(cur)
            var rv = gen_expr(val)
            if rv < 0 {
                return -1
            }
            vv = gen_compound_assign(op, cur_v, rv, tgt_ty)
            if vv < 0 {
                sm_err_msg = "复合赋值运算失败（变量 " + nm + "，函数 " + g_cur_fn_name + "）"
                return -1
            }
        } else {
            if s_tags[val] == 4 && tgt_ty == types.named(TK_TRIT) {
                // BoolLit 适配 trit（t = true 且 t 是 trit 变量 → i8 1）
                var tv: i64 = -1
                if s_vals[val] == 1 {
                    tv = 1
                }
                vv = gen_trit_lit(tv)
            } else {
                vv = gen_expr(val)
            }
            if vv < 0 {
                return -1
            }
        }
        // S1.3 C2/C3：赋值值类型 ≠ 目标槽类型（数字族）→ 转换（拓宽/缩窄）
        var vt = node_types[val]
        if op < 0 && vt >= 0 && (types.is_int(vt) || types.is_float(vt)) &&
            (types.is_int(tgt_ty) || types.is_float(tgt_ty)) && vt != tgt_ty {
            var cv = gen_coerce(vv, vt, tgt_ty)
            if cv < 0 {
                return -1
            }
            vv = cv
        }
        var st = ir.new_inst(g_cur_block, 22, -1)  // store
        ir.add_operand(st, tgt_ty, 2)
        ir.add_operand(st, vv, 0)
        if tgt_global > 0 {
            ir.add_operand(st, tgt_alloca, 3)  // OK_GLOBAL 全局地址（池 id）
        } else {
            ir.add_operand(st, tgt_alloca, 0)  // 本地 alloca
        }
        return 0
    }
    if tag == 110 {
        // Switch：字符串比较链（driver 树仅 typekw_index 一处，字符串 subject）
        return gen_switch(id)
    }
    if tag == 116 {
        // IndexAssign：t[i] = v → tie_table_set 桥
        return gen_index_assign(id)
    }
    if tag == 115 {
        // FieldAssign：obj.field = v（元组/struct 字段赋值；复合赋值 op ≥ 0）
        return gen_field_assign(id)
    }
    if tag == 134 {
        // S2.3：`panic("消息")` 不可恢复错误语句（N_PANIC）→ printf + exit(1)
        return gen_panic(id)
    }
    sm_err_line = s_lines[id]
    sm_err_col = s_cols[id]
    sm_err_msg = "irgen 未支持的语句（tag=" + to_string(tag) + "，函数 " + g_cur_fn_name + "）"
    return -1  // 其他语句后续扩展
}

// 判定 for 迭代对象是否为字符串码点迭代器调用 `s.chars()`（MethodCall）。
// 结构：方法名 == "chars"，接收者（child[slot_off]）为 string 值。仅 for-in
// 路径识别（gen_stmt tag==107 在进 gen_for_table 前探测），与 --prep 探针协调。
func is_chars_method(iter: i64) -> bool {
    if s_tags[iter] != 18 {
        return false
    }
    if sstate.name_str(iter) != "chars" {
        return false
    }
    var recv = sstate.child(iter, sstate.slot_off(iter))
    var rt = node_types[recv]
    if rt < 0 || rt != types.named(TK_STR) {
        return false
    }
    return true
}

// for-in 字符串码点迭代：`for c in s.chars()`（dev33 批次4 语法糖）。
// 布局：循环变量 alloca（TK_STR，单字符）+ 字节位置计数器 alloca（i64）；
// cond 块：字节位置 < str_len(s) 终结（s21_str_head_len O(1)）；body 块每次
// 迭代 s21_utf8_char_at 解码码点 → s21_codepoint_to_str 得单字符字符串 → store
// 到循环变量；step 块：位置 += s21_utf8_seq_len（字节步进）。continue → step，
// break → exit。等价手写 while + utf8_seq_len/utf8_char_at 组合。
func gen_for_chars(id: i64, iter: i64, body: i64) -> i64 {
    // 接收者字符串值（s.chars() 的 s）
    var recv = sstate.child(iter, sstate.slot_off(iter))
    var s = gen_expr(recv)
    if s < 0 {
        return -1
    }
    // 记录当前块（gen_expr 可能切块），循环开始处用。
    // 循环变量 alloca（TK_STR）+ 字节位置计数器 alloca（i64）
    var item_a = ir.new_inst(g_cur_block, 20, types.named(TK_STR))  // alloca string
    ir.add_operand(item_a, types.named(TK_STR), 2)
    var item_ptr = ir.get_value(item_a)
    var pos_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))  // alloca i64
    ir.add_operand(pos_a, types.named(TK_I64), 2)
    var pos_ptr = ir.get_value(pos_a)
    var pos_zero = gen_int_lit_ty(0, types.named(TK_I64))
    var st0 = ir.new_inst(g_cur_block, 22, -1)  // store 0 → pos
    ir.add_operand(st0, types.named(TK_I64), 2)
    ir.add_operand(st0, pos_zero, 0)
    ir.add_operand(st0, pos_ptr, 0)
    // 四块：cond / body / step / exit
    var cond_blk = ir.new_block(g_cur_func, interner.intern("for.cond"))
    var body_blk = ir.new_block(g_cur_func, interner.intern("for.body"))
    var step_blk = ir.new_block(g_cur_func, interner.intern("for.step"))
    var exit_blk = ir.new_block(g_cur_func, interner.intern("for.exit"))
    loop_push(s_aux[id], exit_blk, step_blk)
    var b0 = ir.new_inst(g_cur_block, 30, -1)  // br cond
    ir.add_operand(b0, cond_blk, 1)
    // cond 块：pos < byte_len(s) → body，否则 exit
    g_cur_block = cond_blk
    var cur = ir.new_inst(g_cur_block, 21, types.named(TK_I64))  // load pos
    ir.add_operand(cur, pos_ptr, 0)
    var cur_v = ir.get_value(cur)
    var blen = s21_str_head_len(s)
    var ol = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp ult
    ir.add_operand(ol, cur_v, 0)
    ir.add_operand(ol, blen, 0)
    ir.add_operand(ol, 6, 2)  // ult
    var ol_v = ir.get_value(ol)
    var cb = ir.new_inst(g_cur_block, 31, -1)  // cond_br
    ir.add_operand(cb, ol_v, 0)
    ir.add_operand(cb, body_blk, 1)
    ir.add_operand(cb, exit_blk, 1)
    // body 块：cp = utf8_char_at(s, pos) → 单字符 = str_from_code(cp) → store
    g_cur_block = body_blk
    // 重新 load pos（body 块内 SSA）
    var cur2 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
    ir.add_operand(cur2, pos_ptr, 0)
    var cur2_v = ir.get_value(cur2)
    var cp = s21_utf8_char_at(s, cur2_v)
    // 码点 → 单字符字符串（去 Rust 桥：s21_codepoint_to_str 内联，不链 tie_interp.lib）
    var ch = s21_codepoint_to_str(cp)
    var ist = ir.new_inst(g_cur_block, 22, -1)  // store 单字符 → 循环变量
    ir.add_operand(ist, types.named(TK_STR), 2)
    ir.add_operand(ist, ch, 0)
    ir.add_operand(ist, item_ptr, 0)
    scope_put(s_names[id], item_ptr, types.named(TK_STR))
    var bb = gen_block_stmts(body)
    if bb < 0 {
        return -1
    }
    scope_pop()
    if !block_terminated() {
        var bb2 = ir.new_inst(g_cur_block, 30, -1)  // br step
        ir.add_operand(bb2, step_blk, 1)
    }
    // step 块：pos += utf8_seq_len(s, pos) → store → br cond
    g_cur_block = step_blk
    var cur3 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
    ir.add_operand(cur3, pos_ptr, 0)
    var cur3_v = ir.get_value(cur3)
    var slen = s21_utf8_seq_len(s, cur3_v)
    var np = s21_bin(0, cur3_v, slen)  // add
    var st2 = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(st2, types.named(TK_I64), 2)
    ir.add_operand(st2, np, 0)
    ir.add_operand(st2, pos_ptr, 0)
    var sb = ir.new_inst(g_cur_block, 30, -1)  // br cond
    ir.add_operand(sb, cond_blk, 1)
    // exit 块
    g_cur_block = exit_blk
    loop_pop()
    return 0
}

// for-in 表迭代：`for item in t`（t 为动态表变量/表达式）。
// 布局（对齐 Rust gen_for_dyn_table）：计数器 alloca（0..len(t)，cond 块每次
// 调 tie_table_len）+ 循环变量 alloca（元素类型 T）；body 每次迭代
// tie_table_at 读取元素 → store 到循环变量；continue → step，break → exit。
func gen_for_table(id: i64, iter: i64, body: i64) -> i64 {
    // 表指针（load ptr 槽 / 全局表 load ptr, ptr @g）
    var t = gen_expr(iter)
    if t < 0 {
        return -1
    }
    // 元素类型判定优先级：
    //   1. iter 变量的作用域完整类型（table<T> → table_elem）
    //   2. node_types[iter] 的表元素类型（语义推导）
    //   3. sinfer.var_table_elem（语义层动态表登记）
    //   4. body 中循环变量引用节点的语义类型（for f in entries 里 println(f) 推断）
    //   5. 兜底 i64
    var elem: i64 = types.named(TK_I64)
    var matched: bool = false
    if s_tags[iter] == 6 {
        var bname = interner.intern(sstate.name_str(iter))
        if scope_get(bname) >= 0 && types.is_table(g_lookup_ty) {
            var le = types.table_elem(g_lookup_ty)
            if le > 0 {
                elem = le
                matched = true
            }
        }
        if !matched {
            var bt2 = node_types[iter]
            if types.is_table(bt2) {
                var le2 = types.table_elem(bt2)
                if le2 > 0 {
                    elem = le2
                    matched = true
                }
            }
        }
        if !matched {
            var te = sinfer.var_table_elem(bname)
            if te >= 0 {
                elem = te
                matched = true
            }
        }
    } else {
        var bt = node_types[iter]
        if types.is_table(bt) {
            var le2 = types.table_elem(bt)
            if le2 > 0 {
                elem = le2
                matched = true
            }
        }
    }
    if !matched {
        // body 中循环变量引用类型（`for f in entries { println(f) }` →
        // f 的引用节点被语义层推断为 TK_STR）
        var var_nm = interner.intern(sstate.name_str(id))
        var bn = sstate.nchild(body)
        var bi: i64 = 0
        while bi < bn {
            var st0 = sstate.child(body, bi)
            var refs = find_var_refs(st0, var_nm)
            var ri: i64 = 0
            while ri < len(refs) {
                var rt = node_types[refs[ri]]
                if rt >= 0 && (rt == types.named(TK_STR) || types.is_int(rt) ||
                    types.is_float(rt) || types.is_bool_like(rt)) {
                    elem = rt
                    matched = true
                    break
                }
                ri = ri + 1
            }
            if matched {
                break
            }
            bi = bi + 1
        }
    }
    var suffix = bridge_suffix(elem)
    var elem_llvm_ty = types.named(TK_I64)
    // 嵌套表元素（elem 是 table/map，如 `for row in t`，t 为 table<table<i64>>）：
    // 元素在动态表中存 ptr，for 读行必须用 at_string 桥（返回 ptr）——曾按
    // bridge_suffix 落 at_i64，返回 i64 与循环变量 ptr 槽不符（`store ptr %r,
    // ptr %slot` 但 %r 是 i64，LLVM 拒收），导致 tie_table_len 收到 i64。对齐
    // gen_table_at 3228 行的既有修复（同一约定：表/映射元素 → string 桥）。
    // 嵌套表/映射/port 元素 → string 桥（存 ptr）；但返回类型用 elem 本身
    //（= ptr）而非 TK_STR——S2.1 补头按 ins_ty==TK_STR 判补头，句柄/port
    // 对象被误补头（strlen 扫描 → 崩溃）。真字符串元素保持 TK_STR（需补头）。
    if types.is_table(elem) || types.is_map(elem) || types.kind(elem) == K_PORT {
        suffix = "string"
        elem_llvm_ty = elem
    } else if suffix == "string" {
        elem_llvm_ty = types.named(TK_STR)
    } else if suffix == "bool" {
        elem_llvm_ty = types.named(TK_BOOL)
    } else if suffix == "f64" {
        elem_llvm_ty = types.named(TK_F64)
    }
    // 计数器 alloca（i64）+ store 0
    var idx_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))  // alloca
    ir.add_operand(idx_a, types.named(TK_I64), 2)
    var idx_ptr = ir.get_value(idx_a)
    var i0 = gen_int_lit_ty(0, types.named(TK_I64))
    var st0 = ir.new_inst(g_cur_block, 22, -1)  // store 0
    ir.add_operand(st0, types.named(TK_I64), 2)
    ir.add_operand(st0, i0, 0)
    ir.add_operand(st0, idx_ptr, 0)
    // 循环变量 alloca（元素类型）
    var item_a = ir.new_inst(g_cur_block, 20, elem_llvm_ty)  // alloca
    ir.add_operand(item_a, elem_llvm_ty, 2)
    var item_ptr = ir.get_value(item_a)
    // 四块：cond / body / step / exit
    var cond_blk = ir.new_block(g_cur_func, interner.intern("for.cond"))
    var body_blk = ir.new_block(g_cur_func, interner.intern("for.body"))
    var step_blk = ir.new_block(g_cur_func, interner.intern("for.step"))
    var exit_blk = ir.new_block(g_cur_func, interner.intern("for.exit"))
    loop_push(s_aux[id], exit_blk, step_blk)
    var b0 = ir.new_inst(g_cur_block, 30, -1)  // br cond
    ir.add_operand(b0, cond_blk, 1)
    // cond 块：cur >= len(t) → exit
    g_cur_block = cond_blk
    var cur = ir.new_inst(g_cur_block, 21, types.named(TK_I64))  // load
    ir.add_operand(cur, idx_ptr, 0)
    var cur_v = ir.get_value(cur)
    var tlen = s21_table_len(t)
    if tlen < 0 {
        return -1
    }
    var done = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp sge
    ir.add_operand(done, cur_v, 0)
    ir.add_operand(done, tlen, 0)
    ir.add_operand(done, 5, 2)  // sge
    var done_v = ir.get_value(done)
    var cb = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb, done_v, 0)
    ir.add_operand(cb, exit_blk, 1)
    ir.add_operand(cb, body_blk, 1)
    // body 块：item = table_at(t, cur) → store → 循环体
    g_cur_block = body_blk
    var ok_slot = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
    ir.add_operand(ok_slot, types.named(TK_I8), 2)
    var iv = s21_table_at(t, cur_v, ir.get_value(ok_slot), elem_llvm_ty)
    if iv < 0 {
        return -1
    }
    var ist = ir.new_inst(g_cur_block, 22, -1)  // store
    ir.add_operand(ist, elem_llvm_ty, 2)
    ir.add_operand(ist, iv, 0)
    ir.add_operand(ist, item_ptr, 0)
    scope_put(s_names[id], item_ptr, elem_llvm_ty)
    var bb = gen_block_stmts(body)
    if bb < 0 {
        return -1
    }
    scope_pop()
    if !block_terminated() {
        var bb2 = ir.new_inst(g_cur_block, 30, -1)  // br step
        ir.add_operand(bb2, step_blk, 1)
    }
    // step 块：cur + 1 → store → br cond
    g_cur_block = step_blk
    var add1 = ir.new_inst(g_cur_block, 0, types.named(TK_I64))  // add
    ir.add_operand(add1, cur_v, 0)
    ir.add_operand(add1, 1, 2)
    var add_v = ir.get_value(add1)
    var st2 = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(st2, types.named(TK_I64), 2)
    ir.add_operand(st2, add_v, 0)
    ir.add_operand(st2, idx_ptr, 0)
    var sb = ir.new_inst(g_cur_block, 30, -1)  // br cond
    ir.add_operand(sb, cond_blk, 1)
    // exit 块
    g_cur_block = exit_blk
    loop_pop()
    return 0
}

// 语句树中查找变量引用节点（tag 6，名池 id == target）：返回节点 id 表。
// gen_for_table 用它推断循环变量元素类型（body 里 println(f) → node_types[f]）
func find_var_refs(st: i64, target: i64) -> table<i64> {
    var out = table_new_i64()
    collect_var_refs(st, target, out)
    return out
}

// find_var_refs 的递归实现（深度优先遍历子节点）
func collect_var_refs(st: i64, target: i64, out: table<i64>) {
    if st < 0 {
        return
    }
    if s_tags[st] == 6 && s_names[st] == target {
        table_push(out, st)
        return  // 变量节点是叶子
    }
    var n = sstate.nchild(st)
    var i: i64 = 0
    while i < n {
        collect_var_refs(sstate.child(st, i), target, out)
        i = i + 1
    }
}

// 语句块遍历（StmtList children）。每个块独立作用域（push/pop）。
func gen_block_stmts(blk: i64) -> i64 {
    scope_push()
    var n = sstate.nchild(blk)
    var i: i64 = 0
    while i < n {
        var s = sstate.child(blk, i)
        var r = gen_stmt(s)
        if r < 0 {
            return -1
        }
        i = i + 1
    }
    scope_pop()
    return 0
}

}
