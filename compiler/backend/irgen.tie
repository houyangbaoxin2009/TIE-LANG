        var pat: table<string> = table_new_string()
        if nm == "net_udp_send" {
            table_push(pat, "i")
            table_push(pat, "s")
            table_push(pat, "i")
            table_push(pat, "s")
        } else if nm == "net_tcp_connect" {
            table_push(pat, "s")
            table_push(pat, "i")
        } else if nm == "net_tcp_send" {
            table_push(pat, "i")
            table_push(pat, "s")
        } else if nm == "net_tcp_recv" || nm == "net_udp_recv" {
            table_push(pat, "i")
            table_push(pat, "i")
        } else {
            table_push(pat, "i")
        }
        var atys: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        var k: i64 = 0
        while k < len(pat) {
            var a = call_arg(id, k)
            var v = gen_expr(a)
            if v < 0 {
                return -1
            }
            if pat[k] == "i" {
                var vt = node_types[a]
