type tie<class>
// compiler/backend/irgen.tie —— 自举 v2 T2.8：AST → tie-IR 生成器
// ============================================================
// 里程碑：自举 v2 计划 T2.8（.omo/plans/self-hosting-v2.md）后端 LLVM IR
// 文本生成器。本文件 = AST 协议文本 → tie-IR 列式表（ir.tie 消费）。
// 最小可行集：函数定义/参数/局部变量/算术/比较/if/for 范围/println/print/
// return。未支持语句返回 -1（后续迭代扩展）。
// 依赖：./../frontend/semantic.tie（check_src 填 AST + 类型表；sstate/types/
// interner 经其 import 树传递可达）+ ./llvmgen.tie（消费 tie-IR，保持单根树，
// ir 经 llvmgen 传递可达）。树式无环：driver_test import 本文件。
import "./../frontend/semantic.tie"
import "./llvmgen.tie"
import "./irgen_str.tie"
import "./irgen_vtable.tie"
import "./irgen_closure.tie"
import "./irgen_lit.tie"
import "./irgen_builder.tie"

import "./irgen_arith.tie"
import "./irgen_expr.tie"
import "./irgen_stmt.tie"
import "./irgen_agg.tie"
import "./irgen_call.tie"
import "./irgen_rt.tie"
// ==================== 生成器状态 ====================
// 变量作用域：变量名池 id → (alloca 值 id, 类型 id)（线性表，作用域小）。
// **作用域栈**：g_sc_top 为逻辑栈顶游标（tie 表无法截断，用游标模拟 pop，
// 与 sstate 的 lp_top/ns_top 同款）。函数/块（if/while/for/switch 体）进入
// 时 push（记录当前长度），退出时 pop（游标回退）——同名变量遮蔽 + 跨块
// 不串用。scope_put/scope_get 只查 [0, g_sc_top) 区间。
var g_sc_keys: table<i64>;
var g_sc_allocas: table<i64>;
var g_sc_tys: table<i64>;
var g_sc_top: i64 = 0;
// 循环上下文栈（break → exit 块、continue → 条件/步进块）：最近循环在栈顶。
// 并行表：标签池 id（-1 = 无标签）、break 块、continue 块、栈顶游标。
var g_lp_labels: table<i64>;
var g_lp_breaks: table<i64>;
var g_lp_cont: table<i64>;
var g_lp_top: i64 = 0;
// 三期 goto 标签表（§7.1.5，函数级）：标签名池 id → 目标基本块 id。
// 语义层已做 R1/R2/R3 校验；irgen 按标签表生成 br 目标块。
var g_gt_names: table<i64>;
var g_gt_blks: table<i64>;
// 字符串常量收集（池 id → 全局序号）；llvmgen 生成 @.str.N
var g_str_keys: table<i64>;
var g_str_count: i64 = 0;
// 当前函数/块（生成中）
var g_cur_func: i64 = 0;
var g_cur_block: i64 = 0;
// 参数区是否已输出（entry 顶部）
var g_params_done: bool = false;
// 阶段 A：程序是否使用了 tie-interp 库桥（file_*/regex_*/exec_output 等 Rust 桥）。
// 置位后 driver 链接 tie_interp.lib（Rust 桥）。exec_code/get_env/time_now 已
// 内联到 libc（runtime.a 退役），不再置位本标志。
var g_used_interp: bool = false;
// M5 动态库模式（dev33 批次 12）：driver 在 tig_ast 前经 set_dynlib 注入。
// 置位后 irgen 登记导出面（ir.func_exported）供 llvmgen 输出 dllexport，
// 并对导出函数做边界检查（表/struct 不跨动态库边界）。
var g_dynlib: bool = false;
// 当前编译目标三元组（driver 在 tig_ast 前经 set_target 注入；空 = 未设置）。
// 任务17 asm! 平台条件编译：target("arch") 按此目标匹配。
var g_asm_target: string = "";
// 当前函数的**全名**（命名空间函数含 "::"，如 sstate::child）——调用名解析
// 需要当前命名空间前缀补全（对齐 sinfer.resolve_call_name 的候选 2）。
var g_cur_fn_name: string = "";
// 当前函数返回类型 id（Return 的 BoolLit 适配 trit 用：`return false` 在返回
// trit 的函数里生成 i8 而非 i1）
var g_cur_ret_ty: i64 = 0;
// 表变量元素类型表（函数级）：变量名池 id → 元素类型 id。语义层 lv_telem
// 是 per-function 且在 irgen 阶段已过期（只可靠查到最后一个函数），跨函数
// 场景（exmath::parse_series 里 table_push(result, parse_float(...))）必须由
// irgen 自己登记 table_new_f64()/table<T> 变量的元素类型。
var g_tv_keys: table<i64>;
var g_tv_elems: table<i64>;
// 顶层全局变量登记：name 池 id → 类型 id / 表元素类型 id（对齐 sstate gb_*，
// 直接查 gb_keys/gb_vals/gb_telem；此处仅缓存 llvm 初始化需要的标记）。
// （llvmgen 侧维护 g_global_* 登记表，irgen 仅转发登记。）

// 变量查作用域：命中返回 1 并置 out 参数（tie 无引用返回，用全局槽）
var g_lookup_found: bool = false;
var g_lookup_alloca: i64 = 0;
var g_lookup_ty: i64 = 0;
// 一期并发 A4：actor 工作循环 thunk（@actor_loop）惰性生成标记（每模块仅一次）
var g_actor_loop_gen: i64 = 0;
// 一期并发 A4：actor dispatch/handler 函数急切生成标记（每模块仅一次）
var g_actor_disp_gen: i64 = 0;
// 阶段 A：变量命中形态（0=本地/1=全局标量/2=全局表，scope_get_global 置位）
var g_lookup_is_global: i64 = 0;
// 内置调用结果全局槽（builtin_expr 置位；tie 无引用返回）
var g_builtin_res: i64 = 0;
// 批次5 任务13：用户 extern 名集（顶层 S_N_EXTERN=117，仅声明无函数体）。
// 稀疏收集（用户程序通常 0~若干；编译器自身 0）→ tig_user_call 判定 extern → 路由
// op36（llvmgen 推导 declare + 字符串返回自动扫描 char* → {ptr,len}）。
var g_extern_ids: table<i64>;
var g_extern_ready: i64 = 0;

namespace irgen {
// 变量引用：load 指令（从 alloca 读取）。含全局变量（标量 load @g /
// 表全局 load ptr, ptr @g——表指针本身）。
func tig_var_ref(name_id: i64) -> i64 {
    if scope_get_global(name_id) < 0 {
        sm_err_msg = "变量 '" + intern.lookup(name_id) + "' 未入作用域（函数 " + g_cur_fn_name + "）"
        return -1
    }
    if g_lookup_is_global == 2 {
        // 全局表：load ptr, ptr @g（槽中存表指针）
        var inst = ir.new_inst(g_cur_block, 21, types.named(TK_STR))  // load ptr
        ir.add_operand(inst, g_lookup_alloca, 3)  // OK_GLOBAL 全局地址（池 id）
        return ir.get_value(inst)
    }
    var ty = g_lookup_ty
    var inst = ir.new_inst(g_cur_block, 21, ty)  // load
    if g_lookup_is_global > 0 {
        ir.add_operand(inst, g_lookup_alloca, 3)  // OK_GLOBAL 全局地址（@name）
    } else {
        // 局部槽（alloca %N）：必须 kind 0——kind 3 会让 llvmgen 按值 id
        // 当 intern id 查名字，局部指令 id 与 intern id 数值重叠时误命中全局
        // （如 alloca id=1 而 intern(1)="g" → 生成 load ptr @g 崩溃）
        ir.add_operand(inst, g_lookup_alloca, 0)
    }
    return ir.get_value(inst)
}

// ---------- 函数签名辅助（sstate fn_keys/fn_vals/sg_*） ----------
// 查函数签名 id（sstate.fn_sig）；未定义 -1
func fn_sig_id(full: string) -> i64 {
    return sstate.fn_sig(full)
}

// 签名 → 参数类型 id 表（扁平段 [0, nparams)）
func fn_param_tys(sig: i64) -> table<i64> {
    var off = sg_off[sig]
    var n = sg_nparams[sig]
    var out: table<i64> = table_new_i64()
    var i: i64 = 0
    while i < n {
        table_push(out, sp_tys[off + i])
        i = i + 1
    }
    return out
}

// 签名 → 返回类型 id
func fn_ret_ty(sig: i64) -> i64 {
    return sg_ret[sig]
}

// 签名 → 参数个数
func fn_nparams(sig: i64) -> i64 {
    return sg_nparams[sig]
}

// ---------- 裸调用名解析（irgen 版，对齐 sinfer.resolve_call_name） ----------
// 在当前函数命名空间前缀链中补全裸名（如 sstate 内 child() → sstate::child）。
// 返回全名（裸名已存在或内置 → 原样）。
// 注意：**逐级外层**补全（log::error::no_file 内 lookup → log::error::lookup
// 不存在时继续试 log::lookup）——曾只试最近一层，嵌套命名空间（log.error.no_file）
// 内裸调用私有函数（log::lookup）解析失败报"无签名"
func resolve_call_name(fnm: string) -> string {
    if sstate.fn_sig(fnm) >= 0 {
        return fnm
    }
    // 候选 2：当前函数命名空间前缀**逐级**外层补全
    var full = g_cur_fn_name
    while str_len(full) > 0 {
        var last = sstate.rfind_ns(full)
        if last < 0 {
            break
        }
        var prefix = ig_slice(full, 0, last)
        if prefix == "" {
            break
        }
        var cand = prefix + "::" + fnm
        if sstate.fn_sig(cand) >= 0 {
            return cand
        }
        full = prefix  // 再往上一层
    }
    // 候选 3：using 前缀（driver 树无 using，防御）
    var off: i64 = 0
    var u: i64 = 0
    while u < len(using_lens) {
        var ln = using_lens[u]
        var full2: string = ""
        var i: i64 = 0
        while i < ln {
            if i > 0 {
                full2 = full2 + "::"
            }
            full2 = full2 + intern.lookup(using_prefixes[off + i])
            i = i + 1
        }
        var cand2 = full2 + "::" + fnm
        if sstate.fn_sig(cand2) >= 0 {
            return cand2
        }
        off = off + ln
        u = u + 1
    }
    return fnm
}

// 本地字符串切片 [start, end)（码点级）
// 性能重写（O(n)）：字节定位 + StringBuilder 拷贝（旧逐字符拼接 O(n²)）
func ig_slice(s: string, start: i64, end: i64) -> string {
    var n: i64 = str_len(s)
    if start < 0 {
        start = 0
    }
    if end > n {
        end = n
    }
    if start >= end {
        return ""
    }
    var b: i64 = 0
    var i: i64 = 0
    var bstart: i64 = 0
    while i < end {
        if i == start {
            bstart = b
        }
        b = b + utf8_seq_len(s, b)
        i = i + 1
    }
    var sb = string_builder()
    var k: i64 = bstart
    while k < b {
        sb_append_byte(sb, str_byte(s, k))
        k = k + 1
    }
    return sb_build(sb)
}

// 查找字符串中第一个指定字符的下标（-1 = 无）。
// 历史 bug：gen_call 曾调用未定义的裸 `find_char`（老式点号名兼容探测），
// 导致所有 import 本模块的程序编译报"未定义的函数 'find_char'"。本辅助补齐。
func ig_find_char(s: string, c: string) -> i64 {
    var n = str_len(s)
    var i: i64 = 0
    while i < n {
        if str_char(s, i) == c {
            return i
        }
        i = i + 1
    }
    return -1
}

// 命名空间函数全名 → LLVM 符号（:: → $；对齐 llvmgen.ns_replace）
func ig_ns_sym(full: string) -> string {
    var out: string = ""
    var i: i64 = 0
    var n = str_len(full)
    while i < n {
        if i + 1 < n && str_char(full, i) == ":" && str_char(full, i + 1) == ":" {
            out = out + "$"
            i = i + 2
        } else {
            out = out + str_char(full, i)
            i = i + 1
        }
    }
    return out
}


// tie 运行时桥调用（现仅 exec_output；符号 tie_exec_output，Rust 桥，返回 string）。
// exec_code/get_env/time_now 已内联到 libc，不再经此。
func tig_runtime_call(nm: string, id: i64) -> i64 {
    // tie_exec_output 非 libc → tig_ext_call_typed 自动置 g_used_interp（Rust 桥）
    // Call children = [泛型槽, 实参...]：实参从 children[slot_off] 起
    var off = sstate.slot_off(id)
    var nc = sstate.nchild(id) - off
    var argvals = table_new_i64()
    var k: i64 = 0
    while k < nc {
        var av = tig_expr(sstate.child(id, off + k))
        if av < 0 {
            return -1
        }
        table_push(argvals, av)
        k = k + 1
    }
    var ret_ty: i64 = types.named(TK_I64)
    if nm == "get_env" || nm == "exec_output" {
        ret_ty = types.named(TK_STR)
    }
    var ats: table<i64> = table_new_i64()
    var avs: table<i64> = table_new_i64()
    k = 0
    while k < len(argvals) {
        table_push(ats, types.named(TK_STR))
        table_push(avs, argvals[k])
        k = k + 1
    }
    return tig_ext_call_typed("tie_" + nm, ats, avs, ret_ty)
}

// ==================== 阶段 A：扩展表达式/语句 ====================
// 类型 → LLVM 桥后缀（表元素/实参类型分派；对齐 Rust table_elem_suffix）
// string → string；bool → bool；其余（i64/f64/ptr 等）→ 按 llvm 类型
func bridge_suffix(t: i64) -> string {
    if t == types.named(TK_STR) {
        return "string"
    }
    if t == types.named(TK_BOOL) {
        return "bool"
    }
    if t == types.named(TK_F64) {
        return "f64"
    }
    return "i64"
}

// 元素大小（tie_table_new 参数）：bool=1，其余=8
func elem_size(t: i64) -> i64 {
    if t == types.named(TK_BOOL) {
        return 1
    }
    return 8
}

// Call/MethodCall 实参节点读取（2026-08-14 泛型槽偏移，权威约定见 ast.tie 头）：
// children[0] 是泛型槽（-1 哨兵或 N_TYPE_ARGS），实参从 children[slot_off] 起。
// k 为实参序号（0 起）。与语义层 sstate.slot_off 同源，保证偏移判定一致。
func call_arg(id: i64, k: i64) -> i64 {
    return sstate.child(id, sstate.slot_off(id) + k)
}



// 变参打包：多余实参节点 → 动态表（tie_table_new + 逐元素 push）。
// 元素类型 = 变参元素类型 T（标量）。按值类型选桥（对齐 tig_table_lit）。
func tig_variadic_table(nodes: table<i64>, elem: i64) -> i64 {
    // 元素类型 = 变参元素类型 T（标量）。按值类型选桥（对齐 tig_table_lit）。
    var size = elem_size(elem)
    var size_v = tig_int_lit_ty(size, types.named(TK_I64))
    var t = s21_table_new(size_v)
    var i: i64 = 0
    while i < len(nodes) {
        var v = tig_expr(nodes[i])
        if v < 0 {
            return -1
        }
        var suffix = bridge_suffix(elem)
        var pty = types.named(TK_I64)
        var vt = node_types[nodes[i]]
        if vt >= 0 && (types.is_table(vt) || types.is_map(vt) || vt == types.named(TK_STR)) {
            suffix = "string"
            pty = types.named(TK_STR)
        } else if vt >= 0 && (vt == types.named(TK_F64) || vt == types.named(TK_F32)) {
            suffix = "f64"
            pty = types.named(TK_F64)
        } else if suffix == "string" {
            pty = types.named(TK_STR)
        } else if suffix == "bool" {
            pty = types.named(TK_BOOL)
        }
        s21_table_push(t, pty, v)
        i = i + 1
    }
    return t
}



// 原子内存序标识符 → IMM（Relaxed=0 Acquire=1 Release=2 AcqRel=3 SeqCst=4）
func atomic_order_imm(node: i64) -> i64 {
    var nm = sstate.name_str(node)
    if nm == "Acquire" {
        return 1
    }
    if nm == "Release" {
        return 2
    }
    if nm == "AcqRel" {
        return 3
    }
    if nm == "SeqCst" {
        return 4
    }
    return 0  // Relaxed / 其他（语义层已校验）
}


// ==================== 元组 / struct 聚合（M4/P7 扩展）====================
// 聚合值表示：LLVM 结构体 {T0, T1, ...}——寄存器中是聚合值，变量/参数在
// alloca 聚合槽。字段读写统一走"取地址 → agg_gep → load/store"。
// 对齐 Rust ir.rs：元组构造 insertvalue、字段访问 extractvalue/GEP+load 语义
// 完全一致；tie-IR 用 alloca+store+load 构造聚合值、agg_gep 取字段地址。

// 聚合类型 → 字段索引（元组：命名匹配 + ItemN/数字；struct：命名匹配）
func agg_field_index(ty: i64, fname: string) -> i64 {
    var k = types.kind(ty)
    if k == K_TUPLE {
        var idx = ty - BASE_TUPLE
        var off = tup_offs[idx]
        var n = tup_n[idx]
        var i: i64 = 0
        while i < n {
            var fnid = tup_names[off + i]
            if fnid >= 0 && intern.lookup(fnid) == fname {
                return i
            }
            i = i + 1
        }
        // 匿名元组：ItemN（解构展开，N 从 1 起）或纯数字下标（.0/.1）
        return num_field_index(fname)
    }
    if k == K_STRUCT {
        var idx2 = ty - BASE_STRUCT
        var off2 = cls_fldoff[idx2]
        var n2 = cls_nfld[idx2]
        var i2: i64 = 0
        while i2 < n2 {
            var fnid2 = fld_names[off2 + i2]
            if fnid2 >= 0 && intern.lookup(fnid2) == fname {
                return i2
            }
            i2 = i2 + 1
        }
    }
    return -1
}

// 聚合类型 → 字段类型 id
func agg_field_ty(ty: i64, idx: i64) -> i64 {
    var k = types.kind(ty)
    if k == K_TUPLE {
        var t = ty - BASE_TUPLE
        return tup_tys[tup_offs[t] + idx]
    }
    if k == K_STRUCT {
        var s = ty - BASE_STRUCT
        return fld_tys[cls_fldoff[s] + idx]
    }
    return types.named(TK_I64)
}

// 数字/ItemN 字段名解析：".0"/".1" → 字段下标；".Item1"/".Item2" → N-1。
// 非法数字串返回 -1（parse_int 对非法输入报错，须先自行解析）。
func num_field_index(fname: string) -> i64 {
    var n = str_len(fname)
    var start = 0
    if n >= 5 && ig_slice(fname, 0, 4) == "Item" {
        start = 4
    }
    var val: i64 = 0
    var i: i64 = start
    while i < n {
        var cc = char_code(str_char(fname, i))
        if cc < 48 || cc > 57 {
            return -1  // 非数字字段名（未命中）
        }
        val = val * 10 + (cc - 48)
        i = i + 1
    }
    if start == 4 {
        return val - 1  // ItemN → N-1（1-based）
    }
    return val  // 纯数字 → 字段下标
}



// 符号是否为 libc（llvmgen 无条件 declare 的符号；不触发 tie_interp 链接）
func is_libc_sym(sym: string) -> bool {
    if sym == "printf" || sym == "strlen" || sym == "strcmp" {
        return true
    }
    if sym == "malloc" || sym == "free" || sym == "fopen" || sym == "fwrite" || sym == "fclose" || sym == "fflush" {
        return true
    }
    // S2.1：libc memcpy（StringBuilder 数据拷贝；无需 tie_interp 链接）
    if sym == "memcpy" {
        return true
    }
    // 批次 7：libc memmove（map 有序数组插入平移；重叠安全，无需 tie_interp 链接）
    if sym == "memmove" {
        return true
    }
    if sym == "exit" || sym == "remove" {
        return true
    }
    // libm 数学函数（llvmgen 无条件 declare；f64 → f64）
    if sym == "sqrt" || sym == "sin" || sym == "cos" || sym == "tan" ||
        sym == "exp" || sym == "log" || sym == "floor" || sym == "ceil" ||
        sym == "round" || sym == "pow" {
        return true
    }
    // runtime.a 退役：exec_code/get_env/time_now 内联到 libc 直调（不置 g_used_interp）
    if sym == "system" || sym == "getenv" || sym == "time" {
        return true
    }
    // 一期并发 A4 执行层：kernel32 线程 + 同步原语（系统库默认自动链入，非 interp 桥）
    if sym == "CreateThread" || sym == "WaitForSingleObject" || sym == "CloseHandle" ||
        sym == "GetCurrentThreadId" ||
        sym == "InitializeCriticalSection" || sym == "DeleteCriticalSection" ||
        sym == "EnterCriticalSection" || sym == "LeaveCriticalSection" ||
        sym == "InitializeConditionVariable" || sym == "WakeConditionVariable" ||
        sym == "SleepConditionVariableCS" {
        return true
    }
    return false
}


// 符号扩展：src 类型值 → dst 类型（sext opcode 19）。trit/窄整数提升用。
func tig_sext(v: i64, src_ty: i64, dst_ty: i64) -> i64 {
    var sext = ir.new_inst(g_cur_block, 19, dst_ty)
    ir.add_operand(sext, src_ty, 2)  // 源类型 IMM
    ir.add_operand(sext, v, 0)
    return ir.get_value(sext)
}

// 整数 → f64 提升（sitofp opcode 28）：数学函数整数实参（sqrt(4)）转浮点。
// 已是 f64/f32 直传；窄整数/无符号按有符号 sitofp（tie 整数有符号语义）。
func tig_to_f64(v: i64, vt: i64) -> i64 {
    if types.is_int(vt) {
        var s = ir.new_inst(g_cur_block, 28, types.named(TK_F64))  // sitofp
        ir.add_operand(s, vt, 2)  // 源类型 IMM
        ir.add_operand(s, v, 0)
        return ir.get_value(s)
    }
    return v  // 已 f64/f32（或未知 → 直传）
}

// i8 返回桥 → bool（i1）：call i8 → icmp ne i8 %r, 0（对齐 Rust i8→i1 转换）
func tig_bool_bridge1(sym: string, v: i64, vty: i64) -> i64 {
    var r = tig_ext_call1(sym, v, vty, types.named(TK_I8))
    if r < 0 {
        return -1
    }
    var inst = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp ne
    ir.add_operand(inst, r, 0)
    ir.add_operand(inst, 0, 2)
    ir.add_operand(inst, 1, 2)  // ne
    return ir.get_value(inst)
}

// 双字符串参数 i8 返回桥 → bool（file_copy/file_move/untar_gz/unzip/copy_dir 等）
func tig_bool_bridge2(sym: string, v1: i64, v2: i64) -> i64 {
    var r = tig_ext_call2(sym, v1, types.named(TK_STR), v2, types.named(TK_STR), types.named(TK_I8))
    if r < 0 {
        return -1
    }
    var inst = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp ne
    ir.add_operand(inst, r, 0)
    ir.add_operand(inst, 0, 2)
    ir.add_operand(inst, 1, 2)  // ne
    return ir.get_value(inst)
}




// file_write/file_append：UTF-8 安全桥（tie_file_write / tie_file_append，
// Rust std::fs 覆盖写 / OpenOptions 追加写）。曾用 libc fopen("wb"/"ab") +
// fwrite——中文路径按 ANSI 代码页误读必失败。返回 bool（成功与否）。
func tig_file_write(p: i64, c: i64, append: bool) -> i64 {
    if append {
        return tig_bool_bridge2("tie_file_append", p, c)
    }
    return tig_bool_bridge2("tie_file_write", p, c)
}


// file_exists：UTF-8 安全桥（tie_file_exists，Rust std::fs File::open 探测）。
// 曾用 libc fopen(path, "rb")——Windows ANSI 代码页误读 UTF-8 中文路径，
// 中文目录/文件名的存在性检查必失败（tiec 编译中文路径源文件报"读取源码失败"）。
// 桥返回 i8 → icmp ne 0 → bool（对齐 Rust i8→i1 转换）。
func tig_file_exists(p: i64) -> i64 {
    return tig_bool_bridge1("tie_file_exists", p, types.named(TK_STR))
}

// ==================== 顶层入口 ====================
// 生成 tie-IR（AST 已就绪版，driver.tie 主路径专用）：**前置条件**——调用方
// 必须先执行过 semantic.check_impl（含 parse 的 check_src 等价物），使以下
// 全局状态完整可用：sstate 全局表（s_tags/s_children/s_lines/...）、
// g_extra_tops（顶层声明序列，import 已递归展开填充）、node_types/fn_keys
// （类型/函数签名登记）。driver.frontend() 即满足该条件（parser.parse_src +
// semantic.check_impl，与 semantic.check_src 内部流程完全等价，AST 与类型表
// 状态一致）。
// 本函数**不含**语法/语义检查——只做 生成器状态重置 → 全局变量登记 →
// 顶层函数/命名空间遍历 生成 tie-IR，省去第二次完整前端执行
// （parse + import 展开 + 符号表重建）的性能浪费。调用方在 frontend 失败时
// 已提前返回，故本函数无需再判语义错误。
// 返回 0 成功 / -1 错误（sm_err_* 已置）。
// ==================== 批次5 任务13：用户 extern 判定（稀疏 extern 名集） ====================
// extern 函数仅声明无函数体（顶层 S_N_EXTERN=117，名集 g_extern_ids 见模块头）。
// tig_user_call 判定 full 是 extern → 路由 op36（llvmgen 推导 declare + 字符串返回
// 自动扫描 char* → {ptr,len}）。

// 收集模块全部 extern 函数名（顶层 extern 声明节点），懒初始化
func collect_extern_fns() {
    g_extern_ids = table_new_i64()
    var n2 = len(g_extra_tops)
    var i3: i64 = 0
    while i3 < n2 {
        var s3 = g_extra_tops[i3]
        if s_tags[s3] == 117 {
            table_push(g_extern_ids, interner.intern(sstate.name_str(s3)))
        }
        i3 = i3 + 1
    }
    g_extern_ready = 1
}

// 判定 interned id 是否为用户 extern（稀疏表线性 id 比对，O(externs) ≈ O(1)）。
// 入参为「已 interned」的函数全名 id（tig_user_call 的 sym），避免逐调用 re-intern。
func is_extern_fn_id(fid: i64) -> bool {
    if g_extern_ready == 0 {
        collect_extern_fns()
    }
    var gi2: i64 = 0
    while gi2 < len(g_extern_ids) {
        if g_extern_ids[gi2] == fid {
            return true
        }
        gi2 = gi2 + 1
    }
    return false
}

// 注入编译目标（driver 调用：normalize_target(g_target)，空则本机默认）。
pub func set_target(t: string) {
    g_asm_target = t
}

// 注入动态库模式（driver 在 detect_shared_mode 后调用，M5 dev33 批次 12）。
// 置位后本模块对每个函数登记导出面（ir.func_export_set）+ 导出边界检查。
pub func set_dynlib(v: bool) {
    g_dynlib = v
}

// 动态库边界类型检查（任务 36）：仅标量（整数/浮点/bool/trit/char）与 string
// 可跨动态库边界；void 仅作返回类型。表/map/struct/enum/元组/函数值/port 的
// 堆布局跨语言不可见（内部堆结构，见 docs/plans/dynamic-library.md）→ 违例
// 返回错误消息（空串 = 允许）。
func dynlib_ty_ok(t: i64) -> string {
    if t == types.named(TK_VOID) {
        return ""
    }
    if t == types.named(TK_STR) {
        return ""
    }
    if types.is_int(t) || types.is_float(t) {
        return ""
    }
    if t == types.named(TK_BOOL) || t == types.named(TK_TRIT) || t == types.named(TK_CHAR) {
        return ""
    }
    return "类型 '" + types.type_name(t) + "' 不能跨动态库边界（仅标量与 string 可跨库）"
}

// 平台名匹配：全等（三元组直写）或架构前缀（"x86_64" 匹配 "x86_64-*"）。
// 任务17 asm! 平台条件编译：target("arch") 按 g_asm_target 匹配。
func asm_target_matches(arch: string) -> bool {
    if str_len(g_asm_target) == 0 {
        return false
    }
    if g_asm_target == arch {
        return true
    }
    return has_prefix(g_asm_target, arch + "-")
}

pub func tig_ast() -> i64 {
    // 重置生成器状态
    g_sc_keys = table_new_i64()
    g_sc_allocas = table_new_i64()
    g_sc_tys = table_new_i64()
    g_sc_top = 0
    g_lp_labels = table_new_i64()
    g_lp_breaks = table_new_i64()
    g_lp_cont = table_new_i64()
    g_lp_top = 0
    g_str_keys = table_new_i64()
    g_str_count = 0
    g_used_interp = false
    ir.new_module()
    // 一期并发 A4：actor 工作循环 thunk 急切生成（任何用户函数之前，避免指令
    // 编号交错——llvmgen 逐函数重编号要求函数指令连续）
    gen_actor_loop_eager()
    // 一期并发 A4：actor 方法 handler + dispatch 函数急切生成
    gen_actor_dispatch_eager()
    // S2.4 vtable 全局常量登记（每个 impl 一个：方法函数指针按 port 方法
    // 声明序；llvmgen 在 emit_globals 后输出 @vt.<port>.<struct> 常量）
    reg_all_vtables()
    // 全局变量登记（表全局 → llvmgen 输出 @g = global ptr null，main 入口初始化）
    var n = len(g_extra_tops)
    var i: i64 = 0
    while i < n {
        var s = g_extra_tops[i]
        if s_tags[s] == 100 {
            tig_global_var(s)
        }
        i = i + 1
    }
    // 顶层遍历：FnDef（顶层函数）/ Namespace（递归函数体）/ 全局 VarDecl 已登记
    i = 0
    while i < n {
        var s = g_extra_tops[i]
        if s_tags[s] == 101 {
            // 顶层函数：全名 = 裸名
            var r = tig_fn_def(s, "")
            if r < 0 {
                if str_len(sm_err_msg) == 0 {
                    sm_err_msg = "顶层函数 " + sstate.name_str(s) + " 生成失败"
                }
                return -1
            }
        } else if s_tags[s] == 112 {
            // 命名空间：递归生成体内函数（全名 = ns 段::函数名）
            var nr = tig_ns(s, "")
            if nr < 0 {
                if str_len(sm_err_msg) == 0 {
                    sm_err_msg = "顶层命名空间生成失败"
                }
                return -1
            }
        }
        i = i + 1
    }
    return 0
}

// 生成 tie-IR（完整版）：内部调 semantic.check_src（parse + 语义 + import）
// 填充 AST + 类型表，然后遍历顶层 FnDef。driver-lite.tie 与 backend/
// _driver_test.tie 仍在使用；driver.tie 主路径改用 tig_ast() 避免重复前端。
// 返回 0 成功 / -1 错误（sm_err_* 已置）
pub func tig_src(src: string, base_dir: string) -> i64 {
    var sem = semantic.check_src(src, base_dir)
    if str_len(sem) < 3 {
        return -1
    }
    if str_char(sem, 0) != "O" {
        // 语义错误
        sm_err_msg = sem
        return -1
    }
    // 重置生成器状态
    g_sc_keys = table_new_i64()
    g_sc_allocas = table_new_i64()
    g_sc_tys = table_new_i64()
    g_sc_top = 0
    g_lp_labels = table_new_i64()
    g_lp_breaks = table_new_i64()
    g_lp_cont = table_new_i64()
    g_lp_top = 0
    g_str_keys = table_new_i64()
    g_str_count = 0
    g_used_interp = false
    ir.new_module()
    // 一期并发 A4：actor 工作循环 thunk 急切生成（任何用户函数之前，避免指令
    // 编号交错——llvmgen 逐函数重编号要求函数指令连续）
    gen_actor_loop_eager()
    // 一期并发 A4：actor 方法 handler + dispatch 函数急切生成
    gen_actor_dispatch_eager()
    // S2.4 vtable 全局常量登记（每个 impl 一个：方法函数指针按 port 方法
    // 声明序；llvmgen 在 emit_globals 后输出 @vt.<port>.<struct> 常量）
    reg_all_vtables()
    // 全局变量登记（表全局 → llvmgen 输出 @g = global ptr null，main 入口初始化）
    var n = len(g_extra_tops)
    var i: i64 = 0
    while i < n {
        var s = g_extra_tops[i]
        if s_tags[s] == 100 {
            tig_global_var(s)
        }
        i = i + 1
    }
    // 顶层遍历：FnDef（顶层函数）/ Namespace（递归函数体）/ 全局 VarDecl 已登记
    i = 0
    while i < n {
        var s = g_extra_tops[i]
        if s_tags[s] == 101 {
            // 顶层函数：全名 = 裸名
            var r = tig_fn_def(s, "")
            if r < 0 {
                if str_len(sm_err_msg) == 0 {
                    sm_err_msg = "顶层函数 " + sstate.name_str(s) + " 生成失败"
                }
                return -1
            }
        } else if s_tags[s] == 112 {
            // 命名空间：递归生成体内函数（全名 = ns 段::函数名）
            var nr = tig_ns(s, "")
            if nr < 0 {
                if str_len(sm_err_msg) == 0 {
                    sm_err_msg = "顶层命名空间生成失败"
                }
                return -1
            }
        }
        i = i + 1
    }
    return 0
}

// ==================== S2.4 vtable / port 对象后端 ====================
// reg_all_vtables / tig_ptr_tuple_ty / tig_port_coerce / tig_port_method_call 仍在
// 子文件 compiler/backend/irgen_vtable.tie（同 namespace 文本内联）。以下返回
// tig_global_var / tig_ns / tig_fn_def 三个顶层入口 / 函数生成主逻辑。
// 归属纠偏：这三个函数原被误移入子文件，现迁回主文件顶层入口分区。

// 顶层全局变量声明（tag 100）：登记到 llvmgen 全局段。
// 表全局 → @g = global ptr null（main 入口运行时创建，对齐 T0.4）；
// 标量全局 → @g = global T <字面量零值>。
func tig_global_var(s: i64) {
    var nm = sstate.name_str(s)
    var ty = sgen.parse_generic_type_node(sstate.child(s, 0))
    if ty < 0 {
        ty = types.named(TK_I64)  // 无标注：语义已推断，兜底 i64
    }
    var telem = sinfer.gb_telem_of(intern.intern(nm))
    // 表全局登记：llvmgen 输出 global ptr null + main 入口初始化
    if types.is_table(ty) || telem >= 0 {
        llvmgen.global_table_reg(nm)
    } else {
        llvmgen.global_scalar_reg(nm, ty)
        // const 整数字面量初始值（否则 @g = global i64 0，
        // 顶层 const 读取全为 0——token id 常量等全失效）
        var init = sstate.child(s, 1)
        if sinfer.gb_const_of(intern.intern(nm)) == 1 && init >= 0 && s_tags[init] == 0 {
            llvmgen.global_scalar_init(nm, s_vals[init])
        } else if init >= 0 && s_tags[init] == 2 && ty == types.named(TK_STR) {
            // 顶层字符串全局初始字面量（var/const 均含：如 registry 默认 URL）：
            // @g = global ptr @.str.N（曾忽略字面量 → @g 恒为空串）
            llvmgen.global_str_init(nm, s_names[init])
        }
    }
}
// 命名空间递归：生成体内全部函数（全名 = prefix::函数名）。
// ns_node 为 N_NAMESPACE 节点：children=[Segment...]+[体 StmtList]。
func tig_ns(ns_node: i64, prefix: string) -> i64 {
    var segs: table<string> = table_new_string()
    var nseg = s_aux[ns_node]
    var k: i64 = 0
    while k < nseg {
        var seg = sstate.child(ns_node, k)
        table_push(segs, sstate.name_str(seg))
        k = k + 1
    }
    var body = sstate.child(ns_node, nseg)
    // 本命名空间全名前缀 = 外层 prefix + 本段
    var full_pre: string = prefix
    var j: i64 = 0
    while j < len(segs) {
        if full_pre != "" {
            full_pre = full_pre + "::"
        }
        full_pre = full_pre + segs[j]
        j = j + 1
    }
    // 遍历命名空间体：FnDef → 全名生成；嵌套 Namespace → 递归
    var nb = sstate.nchild(body)
    var i: i64 = 0
    while i < nb {
        var st = sstate.child(body, i)
        var tag = s_tags[st]
        if tag == 101 {
            var r = tig_fn_def(st, full_pre)
            if r < 0 {
                if str_len(sm_err_msg) == 0 {
                    sm_err_msg = "命名空间 " + full_pre + " 的函数 " + sstate.name_str(st) + " 生成失败"
                }
                return -1
            }
        } else if tag == 112 {
            var nr = tig_ns(st, full_pre)
            if nr < 0 {
                return -1
            }
        }
        i = i + 1
    }
    return 0
}

// 函数定义 → tie-IR 函数。prefix 为命名空间前缀（顶层函数传 ""）。
// 函数全名 = prefix::name（命名空间函数）；LLVM 符号由 llvmgen 转 $。
func tig_fn_def(fn_node: i64, prefix: string) -> i64 {
    // 泛型模板声明（children[0] == N_TYPE_PARAMS）：T3b 单态化前不生成 IR——
    // 模板体内 TypeVar 类型（"T"）无法静态编码，生成会报"类 'T' 未定义"。
    // 语义层已把模板登记进 gt_* 表并跳过普通函数检查；此处对称跳过生成。
    if sstate.nchild(fn_node) > 0 {
        var slot0 = sstate.child(fn_node, 0)
        if slot0 >= 0 && s_tags[slot0] == S_N_TYPE_PARAMS {
            return 0
        }
    }
    var bare = sstate.name_str(fn_node)
    var full_name: string = str.clone(bare)
    if prefix != "" {
        full_name = prefix + "::" + bare
    }
    g_cur_fn_name = str.clone(full_name)
    // 每函数重置变量作用域（跨函数不串用；同层函数同名参数/局部正常遮蔽）
    g_sc_keys = table_new_i64()
    g_sc_allocas = table_new_i64()
    g_sc_tys = table_new_i64()
    g_sc_top = 0
    g_lp_labels = table_new_i64()
    g_lp_breaks = table_new_i64()
    g_lp_cont = table_new_i64()
    g_lp_top = 0
    // 三期 goto（§7.1.5）：每函数重置 goto 标签块表（标签块 = 跳转目标）
    g_gt_names = table_new_i64()
    g_gt_blks = table_new_i64()
    g_tv_keys = table_new_i64()
    g_tv_elems = table_new_i64()
    var nparams = s_aux[fn_node]
    // 返回类型：children[slot_off]（新布局 children[0]=泛型槽→偏移 1；
    // 旧布局无槽→children[0]=返回类型。slot_off 统一判定保证自举双兼容）
    var ret_ty = sgen.parse_generic_type_node(sstate.child(fn_node, sstate.slot_off(fn_node)))
    if ret_ty < 0 {
        if str_len(sm_err_msg) == 0 {
            sm_err_msg = "函数 " + full_name + " 返回类型解析失败"
        }
        return -1
    }
    g_cur_ret_ty = ret_ty  // Return 生成期 trit 适配用
    // M5 动态库导出面（dev33 批次 12）：顶层函数恒公有；命名空间函数仅 pub
    // func 导出（N_FN_DEF val bit0 = is_pub，对齐 parser）。导出标记登记进 IR
    // 供 llvmgen 在动态库模式输出 dllexport；动态库模式下对导出函数做边界检查。
    var is_pub: i64 = 1
    if prefix != "" {
        is_pub = s_vals[fn_node] & 1
    }
    if g_dynlib && is_pub == 1 {
        var rberr = dynlib_ty_ok(ret_ty)
        if str_len(rberr) > 0 {
            sm_err_msg = "动态库边界错误: 导出函数 " + full_name + " 返回" + rberr
            return -1
        }
    }
    // 参数类型收集（T0.3 by_ref + M2.1.8 struct 首参自动 ref：ref 参数 LLVM
    // 形参声明为 ptr——按值声明聚合类型（%struct.Counter）会与调用方传的
    // 槽地址不匹配。表 ref 原本 table id → llvm ptr 恰好一致；struct 需显式 ptr）
    var params: table<i64> = table_new_i64()
    var sig0_pre = sstate.fn_sig(full_name)
    var sig_off_pre: i64 = -1
    if sig0_pre >= 0 {
        sig_off_pre = sg_off[sig0_pre]
    }
    var i: i64 = 0
    while i < nparams {
        // 第 i 个参数：children[slot_off + 1 + i]
        var p = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + i)
        var pt = sgen.parse_generic_type_node(sstate.child(p, 0))
        if pt < 0 {
            if str_len(sm_err_msg) == 0 {
                sm_err_msg = "函数 " + full_name + " 参数类型解析失败"
            }
            return -1
        }
        var is_ref_pre = 0
        if sig0_pre >= 0 && sig_off_pre + i < len(sp_refs) {
            is_ref_pre = sp_refs[sig_off_pre + i]
        }
        // 变参参数：签名类型为 table<T>（parser 的 AST 类型节点只有元素类型 T，
        // 必须用语义层已解析的签名类型——LLVM 形参声明为 ptr 表指针）
        if sig0_pre >= 0 && sig_off_pre + i < len(sp_vars) {
            if sp_vars[sig_off_pre + i] == 1 {
                pt = sp_tys[sig_off_pre + i]
            }
        }
        // M5 动态库边界（任务 36）：导出函数参数仅标量/string——表/struct 等堆
        // 布局跨语言不可见，ref 表参数/变参（表打包）亦在此拦截
        if g_dynlib && is_pub == 1 {
            var pberr = dynlib_ty_ok(pt)
            if str_len(pberr) > 0 {
                sm_err_msg = "动态库边界错误: 导出函数 " + full_name + " 参数" + pberr
                return -1
            }
        }
        if is_ref_pre == 1 {
            table_push(params, types.named(TK_STR))  // 引用 → ptr 形参
        } else {
            table_push(params, pt)
        }
        i = i + 1
    }
    var fid = ir.new_func(intern.intern(full_name), ret_ty, params)
    // M5 动态库导出面：登记导出标记（llvmgen gen_func 读 ir.func_exported 输出
    // dllexport；非动态库模式下该标记不影响生成）
    ir.func_export_set(fid, is_pub)
    g_cur_func = fid
    var entry = ir.new_block(fid, interner.intern("entry"))
    g_cur_block = entry
    // 参数入作用域（alloca + store；T0.3 by_ref 参数不 alloca，直接绑定参数寄存器）
    var off = ir.func_params_off(fid)
    var sig0 = sstate.fn_sig(full_name)
    var sig_off = sg_off[sig0]
    i = 0
    while i < nparams {
        // 第 i 个参数：children[slot_off + 1 + i]
        var p = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + i)
        var pname = sstate.name_str(p)
        var pty = params[i]
        // by_ref 标志：sstate sp_refs（语义层已收集）。
        // sig0 < 0（函数签名缺失，如命名空间函数拼接异常）时禁止取 sg_off[-1]——
        // 负索引垃圾值会误判参数为 ref，绑定参数寄存器导致运行时崩溃
        var is_ref = 0
        if sig0 >= 0 && sig_off + i < len(sp_refs) {
            is_ref = sp_refs[sig_off + i]
        }
        var av: i64 = -1
        if is_ref == 1 {
            // T0.3 by_ref：绑定参数寄存器（实参槽地址）。读取 → load ptr, ptr %N；
            // 重绑定赋值 → store ptr, %N 直接写回调用方实参槽
            av = ir.param_val(fid, i)
        } else {
            var alloca = ir.new_inst(g_cur_block, 20, pty)  // alloca
            ir.add_operand(alloca, pty, 2)
            av = ir.get_value(alloca)
            var st = ir.new_inst(g_cur_block, 22, -1)  // store 参数
            ir.add_operand(st, pty, 2)
            // 参数值 id（ir.param_val 取 ir_ops 参数段——曾误用 off+i 段偏移，
            // 与 llvmgen 形参映射 param_ref 不匹配导致 %N 未定义）
            ir.add_operand(st, ir.param_val(fid, i), 0)
            ir.add_operand(st, av, 0)
        }
        scope_put(interner.intern(pname), av, pty)
        i = i + 1
    }
    // 全局表 main 初始化：@g = global ptr null → main 入口 tie_table_new + store
    // （阶段 A 表全局，Rust 版同路径；缺此则 len(g) 对 null 崩溃 0xC0000005）
    if full_name == "main" {
        var gi: i64 = 0
        while gi < len(gb_keys) {
            var gte = gb_telem[gi]
            if gte >= 0 {
                var gsz = elem_size(gte)
                var gsz_v = tig_int_lit_ty(gsz, types.named(TK_I64))
                var gnt = s21_table_new(gsz_v)
                if gnt < 0 {
                    return -1
                }
                var gst = ir.new_inst(g_cur_block, 22, -1)  // store
                ir.add_operand(gst, types.named(TK_STR), 2)
                ir.add_operand(gst, gnt, 0)
                ir.add_operand(gst, interner.intern("@" + intern.lookup(gb_keys[gi])), 3)  // 全局槽
            }
            gi = gi + 1
        }
    }
    // 函数体：children[slot_off + 1 + nparams]
    var body = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + nparams)
    var r = tig_block_stmts(body)
    if r < 0 {
        return -1
    }
    // 末尾补 ret：main → ret i32 0（void main）；其余 void → ret void
    if s_tags[body] == 122 {
        var has_ret = false
        // 简化：检查最后一条语句是否 Return
        var nb = sstate.nchild(body)
        if nb > 0 {
            var last = sstate.child(body, nb - 1)
            if s_tags[last] == 104 {
                has_ret = true
            }
        }
        // 当前块已终止（switch 各 case return 后 exit 块已由 default ret 结束；
        // if 两分支都 return 后 merge 块不可达）→ 不补 ret（曾补死代码
        // `ret ptr %0` 到已终止块，LLVM 报类型错）
        if !has_ret && !block_terminated() {
            if full_name == "main" {
                // main 补 ret i32 0：ty 必须显式 i32（llvmgen 按 ins_ty 输出 ret 类型，
                // ty=-1 会生成 ret ptr 0 / ret void 与 define i32 @main 不匹配）
                var ret = ir.new_inst(g_cur_block, 32, types.named(TK_I32))  // ret i32
                ir.add_operand(ret, 0, 2)  // 立即数 0
            } else if ret_ty == types.named(TK_VOID) {
                var ret = ir.new_inst(g_cur_block, 32, -1)  // ret void
            } else {
                // 非 void 缺 return：按返回类型补零值（曾一律补 ret void——
                // i64 函数 define i64 以 ret void 结束类型不匹配）。
                // string/ptr 用空串常量（曾用 IMM 0——llvmgen ret 的 to_ptr
                // 把字面量 0 误当值 id 0 → ret ptr %0 类型错）。
                // **先建常量再建 ret**：ret 指令会终止块，其后不能追加指令
                var dv = tig_default_val(ret_ty)
                var ret = ir.new_inst(g_cur_block, 32, ret_ty)
                ir.add_operand(ret, dv, 0)
            }
        }
    }
    return 0
}

}
