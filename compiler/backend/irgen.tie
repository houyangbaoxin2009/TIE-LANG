        // 结果 push 进 i64 表会 push_i64(double) 类型错，Rust 按值类型选桥）
        var suffix = bridge_suffix(elem)
        var pty = types.named(TK_I64)
        var vt = node_types[call_arg(id, 1)]
        if vt >= 0 && (types.is_table(vt) || types.is_map(vt) || vt == types.named(TK_STR)) {
            suffix = "string"
            pty = types.named(TK_STR)
        } else if vt >= 0 && (vt == types.named(TK_F64) || vt == types.named(TK_F32)) {
            suffix = "f64"
            pty = types.named(TK_F64)
        } else if suffix == "string" {
            pty = types.named(TK_STR)
        } else if suffix == "bool" {
            pty = types.named(TK_BOOL)
        }
        gen_ext_call2v("tie_table_push_" + suffix, t, types.named(TK_STR), x, pty)
        g_builtin_res = gen_int_lit(0)  // void 结果：哑值（调用方丢弃）
        return 0
    }
    if nm == "exit" {
        g_used_interp = true
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        // C 运行时 exit() 自带 stdio flush，无需显式 fflush
        gen_ext_call1("exit", v, types.named(TK_I64), -1)
        g_builtin_res = gen_int_lit(0)  // exit 不返回：哑值
        return 0
    }
    if nm == "arg_count" {
        g_used_interp = true
