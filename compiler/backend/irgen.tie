            var v = gen_expr(a)
            if v < 0 {
                return -1
            }
            g_builtin_res = s21_str_head_len(v)
            return 0
        }
        g_used_interp = true
        var v2 = gen_expr(a)
        if v2 < 0 {
            return -1
        }
        g_builtin_res = gen_ext_call1("tie_table_len", v2, types.named(TK_STR), types.named(TK_I64))
        return 0
    }
    if nm == "table_new_i64" || nm == "table_new_f64" || nm == "table_new_string" || nm == "table_new_bool" {
