        g_builtin_res = gen_ext_call_typed("tie_" + nm, atys, avs, rty)
        return 0
    }
    if nm == "to_string" {
        g_used_interp = true
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        // 实参类型：f64 → tie_to_string_f64；窄整数（i8/i16/i32/trit/char）→
        // 先 sext 到 i64 再 tie_to_string_i64（C ABI 桥只收 i64；trit 值 -1/0/1
        // 以 i8 存储，直传会生成 `call ptr @tie_to_string_i64(i64 %i8)` 类型错）
        var vt = node_types[call_arg(id, 0)]
        if vt == types.named(TK_F64) || vt == types.named(TK_F32) {
            g_builtin_res = gen_ext_call1("tie_to_string_f64", v, types.named(TK_F64), types.named(TK_STR))
        } else if vt == types.named(TK_I64) || vt == types.named(TK_U64) || vt < 0 {
            g_builtin_res = gen_ext_call1("tie_to_string_i64", v, types.named(TK_I64), types.named(TK_STR))
        } else {
            // 窄类型（trit/char/i8/i16/i32/u8/u16/u32 等）：sext → i64
            var sv = gen_sext(v, vt, types.named(TK_I64))
            if sv < 0 {
                return -1
            }
            g_builtin_res = gen_ext_call1("tie_to_string_i64", sv, types.named(TK_I64), types.named(TK_STR))
        }
        return 0
    }
    if nm == "parse_int" {
        g_used_interp = true
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        // Rust 桥签名 (ptr, ptr ok) -> i64：缺 ok 出参会导致 ABI 错位、
        // 写垃圾指针崩溃（与 tie_table_set 同类 bug）
        var pio = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
        ir.add_operand(pio, types.named(TK_I8), 2)
        g_builtin_res = gen_ext_call2("tie_parse_int", v, types.named(TK_STR),
            ir.get_value(pio), types.named(TK_STR), types.named(TK_I64))
        return 0
    }
    if nm == "parse_float" {
        // 浮点解析：Rust 桥签名 (ptr s, ptr ok) -> double；ok 出参必须占位
        // （ABI 错位会写垃圾指针崩溃，与 parse_int 同类）
        g_used_interp = true
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var pfo = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
        ir.add_operand(pfo, types.named(TK_I8), 2)
        g_builtin_res = gen_ext_call2("tie_parse_float", v, types.named(TK_STR),
            ir.get_value(pfo), types.named(TK_STR), types.named(TK_F64))
        return 0
    }
    if nm == "parse_trit" {
        // trit 解析：Rust 桥签名 (ptr s, ptr ok) -> i8（值域 -1/0/1）
        g_used_interp = true
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var pto = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
        ir.add_operand(pto, types.named(TK_I8), 2)
        g_builtin_res = gen_ext_call2("tie_parse_trit", v, types.named(TK_STR),
            ir.get_value(pto), types.named(TK_STR), types.named(TK_I8))
        return 0
    }
    if nm == "len" {
        // S2.1：len(表) → tie_table_len；len(字符串) → 读 {ptr,len} 长度头（O(1)，
