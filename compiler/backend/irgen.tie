    // ---------- S2.1 字符串 {ptr,len} 原语 ----------
    // 二进制安全字节访问 / UTF-8 码点解码 / StringBuilder（实现见文件尾 s21_* 组）。
    if nm == "str_byte" {
        // str_byte(s, i)：取第 i 字节（0 ≤ i < len(s)；越界未定义——调用方保证）
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var i = gen_expr(call_arg(id, 1))
        if i < 0 {
            return -1
        }
        g_builtin_res = s21_str_byte(v, i)
        return 0
    }
    if nm == "utf8_seq_len" {
        // utf8_seq_len(s, i)：字节 i 起的 UTF-8 序列长度（1-4，按首字节判定）
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var i = gen_expr(call_arg(id, 1))
        if i < 0 {
            return -1
        }
        g_builtin_res = s21_utf8_seq_len(v, i)
        return 0
    }
    if nm == "utf8_char_at" {
        // utf8_char_at(s, i)：字节 i 起的 UTF-8 码点值（分支按序列长度解码）
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var i = gen_expr(call_arg(id, 1))
        if i < 0 {
            return -1
        }
        g_builtin_res = s21_utf8_char_at(v, i)
        return 0
    }
    if nm == "string_builder" {
        // string_builder()：新建 StringBuilder 句柄（i64；两级指针 {cap,len,data}）
        g_builtin_res = s21_sb_new()
        return 0
    }
    if nm == "sb_append" {
        // sb_append(h, s)：原地追加字符串（容量不足自动倍增重分配）；返回 0
        var h = gen_expr(call_arg(id, 0))
        if h < 0 {
            return -1
        }
        var v = gen_expr(call_arg(id, 1))
        if v < 0 {
            return -1
        }
        s21_sb_append(h, v)
        g_builtin_res = gen_int_lit(0)
        return 0
    }
    if nm == "sb_append_byte" {
        // sb_append_byte(h, b)：原地追加单字节（0-255，二进制安全含 \0）；返回 0
        var h = gen_expr(call_arg(id, 0))
        if h < 0 {
            return -1
        }
        var b = gen_expr(call_arg(id, 1))
        if b < 0 {
            return -1
        }
        s21_sb_append_byte(h, b)
        g_builtin_res = gen_int_lit(0)
        return 0
    }
    if nm == "sb_build" {
        // sb_build(h)：一次性产出 string（{头, 数据, \0}；句柄仍有效可复用）
        var h = gen_expr(call_arg(id, 0))
        if h < 0 {
            return -1
        }
        g_builtin_res = s21_sb_build(h)
        return 0
    }
    // ---------- 网络原语（P0：std/net）----------
    // 参数签名：i=整数（窄整数 sext 到 i64）、s=字符串（ptr 直传）；桥符号 tie_<name>；
    // net_close 返回 i8→bool（icmp ne），两个 recv 返回堆串（gen_stmt 统一 free），其余 i64。
    if nm == "net_close" || nm == "net_tcp_accept" || nm == "net_tcp_connect" ||
        nm == "net_tcp_listen" || nm == "net_tcp_recv" || nm == "net_tcp_send" ||
