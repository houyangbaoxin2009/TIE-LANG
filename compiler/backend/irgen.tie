        return 0
    }
    if nm == "file_size" {
        // UTF-8 桥：文件字节大小（tie_file_size，失败返回 -1）
        var p = gen_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        g_builtin_res = gen_ext_call1("tie_file_size", p, types.named(TK_STR), types.named(TK_I64))
        return 0
    }
    if nm == "file_is_dir" || nm == "file_is_file" {
        // UTF-8 桥：路径类型判定（tie_file_is_dir / tie_file_is_file，i8 → bool）
        var p = gen_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        if nm == "file_is_dir" {
            g_builtin_res = gen_bool_bridge1("tie_file_is_dir", p, types.named(TK_STR))
        } else {
            g_builtin_res = gen_bool_bridge1("tie_file_is_file", p, types.named(TK_STR))
        }
        return 0
    }
    if nm == "file_exists" {
        var p = gen_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        g_builtin_res = gen_file_exists(p)
        return 0
    }
    if nm == "file_delete" {
        var p = gen_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        // UTF-8 安全桥（tie_file_delete，Rust std::fs::remove_file）；
        // 曾用 libc remove——ANSI 代码页误读中文路径。桥返回 i8 → bool。
        g_builtin_res = gen_bool_bridge1("tie_file_delete", p, types.named(TK_STR))
        return 0
    }
    if nm == "print_err" {
        g_used_interp = true
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        gen_ext_call1("tie_print_err", v, types.named(TK_STR), -1)
        g_builtin_res = gen_int_lit(0)  // void：哑值
        return 0
    }
    if nm == "mkdir_all" {
        g_used_interp = true
        var p = gen_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        g_builtin_res = gen_ext_call1("tie_mkdir_all", p, types.named(TK_STR), types.named(TK_BOOL))
        return 0
    }
    if nm == "regex_find_all" {
        g_used_interp = true
        var s = gen_expr(call_arg(id, 0))
        if s < 0 {
            return -1
        }
        var p = gen_expr(call_arg(id, 1))
        if p < 0 {
            return -1
        }
        g_builtin_res = gen_ext_call2("tie_regex_find_all", s, types.named(TK_STR), p, types.named(TK_STR), types.named(TK_STR))
        return 0
