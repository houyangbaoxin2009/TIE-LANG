    if nm == "str_from_code" {
        // 码点 → 单字符字符串（与 char_code 对称）。桥签名 (i64) -> ptr（堆串），
        // 独立语句时调用方 gen_stmt 统一 free（与 str_char 同机制）。
        g_used_interp = true
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        // 实参类型：i64 直传；窄整数（trit/char/i8/i16/i32 等）先 sext 到 i64
        // （桥只收 i64，直传会生成 `call ptr @tie_str_from_code(i64 %i8)` 类型错）
        var vt = node_types[call_arg(id, 0)]
        if vt == types.named(TK_I64) || vt == types.named(TK_U64) || vt < 0 {
            g_builtin_res = gen_ext_call1("tie_str_from_code", v, types.named(TK_I64), types.named(TK_STR))
        } else {
            var sv = gen_sext(v, vt, types.named(TK_I64))
            if sv < 0 {
                return -1
