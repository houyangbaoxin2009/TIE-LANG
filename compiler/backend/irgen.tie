    // ---------- M4/M6 补齐：系统能力内置（对齐 Rust ir.rs 同名单分支）----------
    // 数学库（libm，llvmgen 无条件 declare；f64 → f64）。
    // 整数实参（sqrt(4)）→ sitofp 提升为 f64（LLVM 类型必须匹配）
    if nm == "sqrt" || nm == "sin" || nm == "cos" || nm == "tan" ||
        nm == "exp" || nm == "log" || nm == "floor" || nm == "ceil" || nm == "round" {
        var mv = gen_expr(call_arg(id, 0))
        if mv < 0 {
            return -1
        }
        var mvt = node_types[call_arg(id, 0)]
        var mf = gen_to_f64(mv, mvt)
        if mf < 0 {
            return -1
        }
        g_builtin_res = gen_ext_call1(nm, mf, types.named(TK_F64), types.named(TK_F64))
        return 0
    }
    if nm == "pow" {
        var pv1 = gen_expr(call_arg(id, 0))
        if pv1 < 0 {
            return -1
        }
        var pv2 = gen_expr(call_arg(id, 1))
        if pv2 < 0 {
            return -1
        }
        var p1t = node_types[call_arg(id, 0)]
        var p2t = node_types[call_arg(id, 1)]
        var pf1 = gen_to_f64(pv1, p1t)
        var pf2 = gen_to_f64(pv2, p2t)
        if pf1 < 0 || pf2 < 0 {
            return -1
        }
        g_builtin_res = gen_ext_call2("pow", pf1, types.named(TK_F64), pf2, types.named(TK_F64), types.named(TK_F64))
        return 0
    }
    // read_line / cwd / msg_get_lang：零参数 → ptr 返回
    if nm == "read_line" || nm == "cwd" || nm == "msg_get_lang" {
        g_used_interp = true
        var zero_v = gen_int_lit_ty(0, types.named(TK_I64))
        g_builtin_res = gen_ext_call1("tie_" + nm, zero_v, types.named(TK_I64), types.named(TK_STR))
        return 0
    }
    // 单字符串参数 → ptr 返回（list_dir/walk_dir/byte_read 动态表；path_* 堆串；
    // http_get/msg_t 堆串；path_normalize 堆串）
    if nm == "list_dir" || nm == "walk_dir" || nm == "byte_read" ||
        nm == "path_basename" || nm == "path_dirname" || nm == "path_abs" ||
        nm == "path_normalize" || nm == "http_get" || nm == "msg_t" {
        g_used_interp = true
        var sv = gen_expr(call_arg(id, 0))
        if sv < 0 {
            return -1
        }
        g_builtin_res = gen_ext_call1("tie_" + nm, sv, types.named(TK_STR), types.named(TK_STR))
        return 0
    }
    if nm == "eval" {
        // eval：桥名 tie_eval_expr（非 tie_eval——C ABI 桥签名 (ptr) -> ptr）
        g_used_interp = true
        var sv = gen_expr(call_arg(id, 0))
        if sv < 0 {
            return -1
        }
        g_builtin_res = gen_ext_call1("tie_eval_expr", sv, types.named(TK_STR), types.named(TK_STR))
        return 0
    }
    // 双字符串参数 → ptr 返回（path_join/msg_t_lang/eval_call/regex_find）
    if nm == "path_join" || nm == "msg_t_lang" || nm == "eval_call" || nm == "regex_find" {
        g_used_interp = true
        var a1 = gen_expr(call_arg(id, 0))
        if a1 < 0 {
            return -1
        }
        var a2 = gen_expr(call_arg(id, 1))
        if a2 < 0 {
            return -1
        }
        g_builtin_res = gen_ext_call2("tie_" + nm, a1, types.named(TK_STR), a2, types.named(TK_STR), types.named(TK_STR))
        return 0
    }
    // 三字符串参数 → ptr（regex_replace：s, pattern, replacement）
    if nm == "regex_replace" {
        g_used_interp = true
        var r1 = gen_expr(call_arg(id, 0))
        if r1 < 0 {
            return -1
        }
        var r2 = gen_expr(call_arg(id, 1))
        if r2 < 0 {
            return -1
        }
        var r3 = gen_expr(call_arg(id, 2))
        if r3 < 0 {
            return -1
        }
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.named(TK_STR))
        table_push(avs, r1)
        table_push(ats, types.named(TK_STR))
        table_push(avs, r2)
        table_push(ats, types.named(TK_STR))
        table_push(avs, r3)
        g_builtin_res = gen_ext_call_typed("tie_regex_replace", ats, avs, types.named(TK_STR))
        return 0
    }
    // regex_group：字符串 + 字符串 + i64 → ptr
    if nm == "regex_group" {
        g_used_interp = true
        var g1 = gen_expr(call_arg(id, 0))
        if g1 < 0 {
            return -1
        }
        var g2 = gen_expr(call_arg(id, 1))
        if g2 < 0 {
            return -1
        }
        var g3 = gen_expr(call_arg(id, 2))
        if g3 < 0 {
            return -1
        }
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.named(TK_STR))
        table_push(avs, g1)
        table_push(ats, types.named(TK_STR))
        table_push(avs, g2)
        table_push(ats, types.named(TK_I64))
        table_push(avs, g3)
        g_builtin_res = gen_ext_call_typed("tie_regex_group", ats, avs, types.named(TK_STR))
        return 0
    }
    // regex_match：字符串 + 字符串 + ok 出参 → i8 → bool
    if nm == "regex_match" {
        g_used_interp = true
        var m1 = gen_expr(call_arg(id, 0))
        if m1 < 0 {
            return -1
        }
        var m2 = gen_expr(call_arg(id, 1))
        if m2 < 0 {
            return -1
        }
        var mo = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8 ok
        ir.add_operand(mo, types.named(TK_I8), 2)
        var mats: table<i64> = table_new_i64()
        var mavs: table<i64> = table_new_i64()
        table_push(mats, types.named(TK_STR))
        table_push(mavs, m1)
        table_push(mats, types.named(TK_STR))
        table_push(mavs, m2)
        table_push(mats, types.named(TK_STR))
        table_push(mavs, ir.get_value(mo))
        var mr = gen_ext_call_typed("tie_regex_match", mats, mavs, types.named(TK_I8))
        if mr < 0 {
            return -1
        }
        var mi = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp ne 0
        ir.add_operand(mi, mr, 0)
        ir.add_operand(mi, 0, 2)
        ir.add_operand(mi, 1, 2)
        g_builtin_res = ir.get_value(mi)
        return 0
    }
    // 单字符串参数 i8 返回 → bool（file_exists 已有；remove_dir_all/mkdir_all 已有
    // mkdir_all；此处补 remove_dir_all）
    if nm == "remove_dir_all" {
        g_used_interp = true
        var rv = gen_expr(call_arg(id, 0))
        if rv < 0 {
            return -1
        }
        g_builtin_res = gen_bool_bridge1("tie_remove_dir_all", rv, types.named(TK_STR))
        return 0
    }
    // 双字符串参数 i8 返回 → bool（file_copy/file_move/untar_gz/unzip/copy_dir/http_get_file）
    if nm == "file_copy" || nm == "file_move" || nm == "untar_gz" || nm == "unzip" ||
        nm == "copy_dir" || nm == "http_get_file" {
        g_used_interp = true
        var f1 = gen_expr(call_arg(id, 0))
        if f1 < 0 {
            return -1
        }
        var f2 = gen_expr(call_arg(id, 1))
        if f2 < 0 {
            return -1
        }
        g_builtin_res = gen_bool_bridge2("tie_" + nm, f1, f2)
        return 0
    }
    // byte_write：路径 + 字节表 → i8 → bool
    if nm == "byte_write" {
        g_used_interp = true
        var w1 = gen_expr(call_arg(id, 0))
        if w1 < 0 {
            return -1
        }
        var w2 = gen_expr(call_arg(id, 1))
        if w2 < 0 {
            return -1
        }
        g_builtin_res = gen_bool_bridge2("tie_byte_write", w1, w2)
        return 0
    }
    // bit_read：字节表 + 位置 → i64；bit_write：字节表 + 位置 + 位 → i8 → bool
    if nm == "bit_read" {
        g_used_interp = true
        var b1 = gen_expr(call_arg(id, 0))
        if b1 < 0 {
            return -1
        }
        var b2 = gen_expr(call_arg(id, 1))
        if b2 < 0 {
            return -1
        }
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.named(TK_STR))
        table_push(avs, b1)
        table_push(ats, types.named(TK_I64))
        table_push(avs, b2)
        g_builtin_res = gen_ext_call_typed("tie_bit_read", ats, avs, types.named(TK_I64))
        return 0
    }
    if nm == "bit_write" {
        g_used_interp = true
        var bw1 = gen_expr(call_arg(id, 0))
        if bw1 < 0 {
            return -1
        }
        var bw2 = gen_expr(call_arg(id, 1))
        if bw2 < 0 {
            return -1
        }
        var bw3 = gen_expr(call_arg(id, 2))
        if bw3 < 0 {
            return -1
        }
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.named(TK_STR))
        table_push(avs, bw1)
        table_push(ats, types.named(TK_I64))
        table_push(avs, bw2)
        table_push(ats, types.named(TK_I64))
        table_push(avs, bw3)
        var br = gen_ext_call_typed("tie_bit_write", ats, avs, types.named(TK_I8))
        if br < 0 {
            return -1
        }
        var bi = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp ne 0
        ir.add_operand(bi, br, 0)
        ir.add_operand(bi, 0, 2)
        ir.add_operand(bi, 1, 2)
        g_builtin_res = ir.get_value(bi)
        return 0
    }
    // byte_concat：字节表 + 字节表 → 字节表
    if nm == "byte_concat" {
        g_used_interp = true
        var c1 = gen_expr(call_arg(id, 0))
        if c1 < 0 {
            return -1
        }
        var c2 = gen_expr(call_arg(id, 1))
        if c2 < 0 {
            return -1
        }
        g_builtin_res = gen_ext_call2("tie_byte_concat", c1, types.named(TK_STR), c2, types.named(TK_STR), types.named(TK_STR))
        return 0
    }
    // set_env：双字符串参数 void；msg_set_lang：单字符串参数 void；msg_register：三字符串 void
    if nm == "set_env" || nm == "msg_set_lang" {
        g_used_interp = true
        var e1 = gen_expr(call_arg(id, 0))
        if e1 < 0 {
            return -1
        }
        if nm == "set_env" {
            var e2 = gen_expr(call_arg(id, 1))
            if e2 < 0 {
                return -1
            }
            gen_ext_call2v("tie_set_env", e1, types.named(TK_STR), e2, types.named(TK_STR))
        } else {
            gen_ext_call1("tie_msg_set_lang", e1, types.named(TK_STR), -1)
        }
        g_builtin_res = gen_int_lit(0)  // void：哑值
        return 0
    }
    if nm == "msg_register" {
        g_used_interp = true
        var q1 = gen_expr(call_arg(id, 0))
        if q1 < 0 {
            return -1
        }
        var q2 = gen_expr(call_arg(id, 1))
        if q2 < 0 {
            return -1
        }
        var q3 = gen_expr(call_arg(id, 2))
        if q3 < 0 {
            return -1
        }
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.named(TK_STR))
        table_push(avs, q1)
        table_push(ats, types.named(TK_STR))
        table_push(avs, q2)
        table_push(ats, types.named(TK_STR))
        table_push(avs, q3)
        gen_ext_call_typed("tie_msg_register", ats, avs, -1)
        g_builtin_res = gen_int_lit(0)  // void：哑值
        return 0
    }
    // rand_range：i64 + i64 + ok 出参 → i64（对齐 Rust 桥签名）
    if nm == "rand_range" {
        g_used_interp = true
        var d1 = gen_expr(call_arg(id, 0))
        if d1 < 0 {
            return -1
        }
        var d2 = gen_expr(call_arg(id, 1))
        if d2 < 0 {
            return -1
        }
        var ro = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8 ok
        ir.add_operand(ro, types.named(TK_I8), 2)
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.named(TK_I64))
        table_push(avs, d1)
        table_push(ats, types.named(TK_I64))
        table_push(avs, d2)
        table_push(ats, types.named(TK_STR))
        table_push(avs, ir.get_value(ro))
        g_builtin_res = gen_ext_call_typed("tie_rand_range", ats, avs, types.named(TK_I64))
        return 0
    }
    // table_at：表 + 下标 → 元素（与 t[i] 同语义；元素类型 fallback 判定）
    if nm == "table_at" {
        g_used_interp = true
        var tb = gen_expr(call_arg(id, 0))
        if tb < 0 {
            return -1
        }
        var ti = gen_expr(call_arg(id, 1))
        if ti < 0 {
            return -1
        }
        // 元素类型：语义节点类型（表实参的 node_types 可能是 TK_TABLE——元素类型
        // 按 var_table_elem 尽力推断，失败 fallback i64）
        var elem: i64 = types.named(TK_I64)
        var tn = call_arg(id, 0)
        if s_tags[tn] == 6 {
            var te = sinfer.var_table_elem(intern.intern(sstate.name_str(tn)))
            if te >= 0 {
                elem = te
            }
        }
        var suffix = bridge_suffix(elem)
        var ret_ty = types.named(TK_I64)
        if suffix == "string" {
            ret_ty = types.named(TK_STR)
        } else if suffix == "f64" {
            // f64 表元素：返回类型 double（曾落默认 i64 → `call i64 @tie_table_at_f64`
            // 与 declare 的 double 返回不匹配，opt 报类型错）
            ret_ty = types.named(TK_F64)
        } else if suffix == "bool" {
            ret_ty = types.named(TK_BOOL)
        }
        var ok_slot = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
        ir.add_operand(ok_slot, types.named(TK_I8), 2)
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.named(TK_STR))
        table_push(avs, tb)
        table_push(ats, types.named(TK_I64))
        table_push(avs, ti)
        table_push(ats, types.named(TK_STR))
        table_push(avs, ir.get_value(ok_slot))
        g_builtin_res = gen_ext_call_typed("tie_table_at_" + suffix, ats, avs, ret_ty)
        return 0
    }
    return -1  // 非内置
}

// tie 运行时桥调用（exec_code/time_now/get_env/exec_output；全字符串参数，
// 符号 tie_<name>；返回 i64 或 string）
func gen_runtime_call(nm: string, id: i64) -> i64 {
    g_used_runtime = true
    // Call children = [泛型槽, 实参...]：实参从 children[slot_off] 起
    var off = sstate.slot_off(id)
    var nc = sstate.nchild(id) - off
    var argvals = table_new_i64()
    var k: i64 = 0
    while k < nc {
        var av = gen_expr(sstate.child(id, off + k))
        if av < 0 {
            return -1
        }
        table_push(argvals, av)
        k = k + 1
    }
    var ret_ty: i64 = types.named(TK_I64)
    if nm == "get_env" || nm == "exec_output" {
        ret_ty = types.named(TK_STR)
    }
    var ats: table<i64> = table_new_i64()
    var avs: table<i64> = table_new_i64()
    k = 0
    while k < len(argvals) {
        table_push(ats, types.named(TK_STR))
        table_push(avs, argvals[k])
        k = k + 1
    }
    return gen_ext_call_typed("tie_" + nm, ats, avs, ret_ty)
}

// ==================== 阶段 A：扩展表达式/语句 ====================
// 类型 → LLVM 桥后缀（表元素/实参类型分派；对齐 Rust table_elem_suffix）
// string → string；bool → bool；其余（i64/f64/ptr 等）→ 按 llvm 类型
func bridge_suffix(t: i64) -> string {
    if t == types.named(TK_STR) {
        return "string"
    }
    if t == types.named(TK_BOOL) {
        return "bool"
    }
    if t == types.named(TK_F64) {
        return "f64"
    }
    return "i64"
}

// 元素大小（tie_table_new 参数）：bool=1，其余=8
func elem_size(t: i64) -> i64 {
    if t == types.named(TK_BOOL) {
        return 1
    }
    return 8
}

// Call/MethodCall 实参节点读取（2026-08-14 泛型槽偏移，权威约定见 ast.tie 头）：
// children[0] 是泛型槽（-1 哨兵或 N_TYPE_ARGS），实参从 children[slot_off] 起。
// k 为实参序号（0 起）。与语义层 sstate.slot_off 同源，保证偏移判定一致。
func call_arg(id: i64, k: i64) -> i64 {
    return sstate.child(id, sstate.slot_off(id) + k)
}

// 生成用户函数调用（顶层/命名空间函数）→ call(35) 指令。
// full_name 为函数全名（裸调用已 resolve，MethodCall 已拼 prefix::method）。
// arg_start：实参起始 child 下标（Call=slot_off；MethodCall=1+slot_off，
// children[0] 是泛型槽、children[1] 是 receiver）。
// 操作数布局：[0]=符号池id, [1]=返回类型id(IMM), 然后每参数 [类型id(IMM), 值]。
func gen_user_call(full: string, id: i64) -> i64 {
    return gen_user_call_from(full, id, sstate.slot_off(id))
}

func gen_user_call_from(full: string, id: i64, arg_start: i64) -> i64 {
    var sig = sstate.fn_sig(full)
    var probe_i: i64 = 0
    while probe_i < sstate.nchild(id) {
        var pc = sstate.child(id, probe_i)
        probe_i = probe_i + 1
    }
    if sig < 0 {
        sm_err_msg = "函数 '" + full + "' 无签名（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var ret_ty = fn_ret_ty(sig)
    var nparams = fn_nparams(sig)
    var ptys = fn_param_tys(sig)
    var sym = interner.intern(full)
    llvmgen.call_sym_reg(sym)
    // 变参（`...T`）：固定形参数 = nparams - 1，多余实参打包为动态表实参
    var has_var = sstate.fn_has_variadic(sig) == 1
    var fixed_n: i64 = nparams
    var var_elem: i64 = -1
    if has_var {
        fixed_n = nparams - 1
        var_elem = types.table_elem(ptys[nparams - 1])
    }
    // 实参全求值（by_ref 形参 + Var 实参 → 传槽地址跳过 load）
    var nc = sstate.nchild(id)
    var argvals: table<i64> = table_new_i64()
    var argisref: table<i64> = table_new_i64()  // 并行：ref 实参标志（类型 → ptr）
    var argkinds: table<i64> = table_new_i64()  // 并行：操作数 kind（S3.2：ref 全局 → 3）
    var extra_nodes: table<i64> = table_new_i64()  // 变参多余实参（稍后打包）
    var k: i64 = arg_start
    while k < nc {
        var arg_node = sstate.child(id, k)
        var av: i64 = -1
        var is_ref_arg: i64 = 0
        var arg_kind: i64 = 0
        var arg_idx = k - arg_start  // 实参序号（aoff=1 时 children[0] 是路径节点）
        if has_var && arg_idx >= fixed_n {
            // 变参多余实参：收集节点，最后统一打包成表实参（不单独求值/压参）
            table_push(extra_nodes, arg_node)
            k = k + 1
            continue
        }
        if arg_idx < nparams {
            // T0.3 by_ref：实参是 Var 时传实参槽地址（局部 alloca %N / 全局 @g），
            // 函数内 load/store 透过该槽 → 内容修改 + 重绑定都写回调用方。
            // M2.1.8：struct 接收者自动 ref（表 ref 原本 table→ptr 一致，
            // struct 聚合类型必须显式 ptr——形参已声明 ptr，实参须同型）
            var ref_flag = sp_refs[sg_off[sig] + arg_idx]
            if ref_flag == 1 && s_tags[arg_node] == 6 {
                var anm = interner.intern(sstate.name_str(arg_node))
                if scope_get_global(anm) >= 0 {
                    av = g_lookup_alloca
                    is_ref_arg = 1
                    // S3.2：ref 全局实参（标量/表）操作数 kind 用 3（全局地址
                    // @sym，llvmgen typed_ref/opnd_ref 直引）——kind 0 会把
                    // "@name" 池 id 当 SSA 值输出 "%N"（N 是池 id 非本函数
                    // 定义的值）→ opt 报 use of undefined value
                    if g_lookup_is_global >= 1 {
                        arg_kind = 3
                    }
                }
            }
        }
        if av < 0 {
            av = gen_expr(arg_node)
        }
        table_push(argvals, av)
        table_push(argisref, is_ref_arg)
        table_push(argkinds, arg_kind)
        k = k + 1
    }
    // 变参打包：多余实参 → 动态表（无多余实参也要传空表）
    if has_var {
        var tbl = gen_variadic_table(extra_nodes, var_elem)
        if tbl < 0 {
            return -1
        }
        table_push(argvals, tbl)
        table_push(argisref, 0)
        table_push(argkinds, 0)
    }
    var ty35: i64 = -1
    if ret_ty != types.named(TK_VOID) {
        ty35 = ret_ty
    }
    // 只创建一条（曾先建 ret_ty 再覆盖建 -1——void 时遗留无操作数垃圾指令
    // → llvmgen 生成 `call void @()` 空符号）
    var inst = ir.new_inst(g_cur_block, 35, ty35)  // call（void 用 -1）
    ir.add_operand(inst, sym, 0)
    ir.add_operand(inst, ret_ty, 2)  // 返回类型（IMM）
    k = 0
    while k < len(argvals) {
        var pty = types.named(TK_I64)
        if k < nparams {
            if argisref[k] == 1 {
                pty = types.named(TK_STR)  // ref 实参：槽地址 → ptr
            } else {
                pty = ptys[k]
            }
            // S1.3 C2/C3：形参类型（数字族）≠ 实参表达式类型 → 转换
            // （调用点拓宽/常量缩窄；语义层已校验合法性，此处只做 IR 转换）
            var an = sstate.child(id, arg_start + k)
            var at2 = node_types[an]
            if pty >= 0 && at2 >= 0 && (types.is_int(pty) || types.is_float(pty)) &&
                (types.is_int(at2) || types.is_float(at2)) && pty != at2 {
                var ac = gen_coerce(argvals[k], at2, pty)
                if ac < 0 {
                    return -1
                }
                argvals[k] = ac
            }
        }
        ir.add_operand(inst, pty, 2)
        ir.add_operand(inst, argvals[k], argkinds[k])
        k = k + 1
    }
    if ret_ty == types.named(TK_VOID) {
        return gen_int_lit(0)  // void 结果：哑值（调用方丢弃）
    }
    return ir.get_value(inst)
}

// 变参打包：多余实参节点 → 动态表（tie_table_new + 逐元素 push）。
// 元素类型 = 变参元素类型 T（标量）。按值类型选桥（对齐 gen_table_lit）。
func gen_variadic_table(nodes: table<i64>, elem: i64) -> i64 {
    g_used_interp = true
    var size = elem_size(elem)
    var size_v = gen_int_lit_ty(size, types.named(TK_I64))
    var t = gen_ext_call1("tie_table_new", size_v, types.named(TK_I64), types.named(TK_STR))
    var i: i64 = 0
    while i < len(nodes) {
        var v = gen_expr(nodes[i])
        if v < 0 {
            return -1
        }
        var suffix = bridge_suffix(elem)
        var pty = types.named(TK_I64)
        var vt = node_types[nodes[i]]
        if vt >= 0 && (types.is_table(vt) || types.is_map(vt) || vt == types.named(TK_STR)) {
            suffix = "string"
            pty = types.named(TK_STR)
        } else if vt >= 0 && (vt == types.named(TK_F64) || vt == types.named(TK_F32)) {
            suffix = "f64"
            pty = types.named(TK_F64)
        } else if suffix == "string" {
            pty = types.named(TK_STR)
        } else if suffix == "bool" {
            pty = types.named(TK_BOOL)
        }
        gen_ext_call2v("tie_table_push_" + suffix, t, types.named(TK_STR), v, pty)
        i = i + 1
    }
    return t
}

// 方法调用（MethodCall，tag 18）：receiver + 方法名 → 命名空间函数全名。
// receiver 是 Path/Var/FieldAccess 链（未绑定）→ ns 调用；绑定实例 → struct
// 方法转发（obj.method() → StructName::method(obj, ...)，语义层已校验签名）。
func gen_method_call(id: i64) -> i64 {
    // MethodCall 接收者 = children[slot_off]（新布局 children[0]=泛型槽→偏移 1）
    var recv = sstate.child(id, sstate.slot_off(id))
    var mname = sstate.name_str(id)
    // 枚举变体构造探测（EnumName.Variant(args)）：接收者是未绑定变量且命中
    // en_keys → 枚举构造（仿 sinfer.infer_method_call 的枚举分支；实参从
    // children[slot_off + 1] 起）。须先于 struct 实例方法转发——枚举名不可
    // 能是已绑定实例，互不冲突。
    if s_tags[recv] == 6 {
        var rnm = sstate.name_str(recv)
        var eidx2 = sstate.bs_find(en_keys, interner.intern(rnm))
        if eidx2 >= 0 {
            return gen_enum_construct(eidx2, mname, id, 1 + sstate.slot_off(id))
        }
    }
    // 接收者是已绑定实例（局部/全局变量）且类型为 struct → 实例方法转发：
    // 函数全名 = <struct 名>::<方法>，实参 = [receiver 值] + 显式实参
    if s_tags[recv] == 6 {
        var rnid = interner.intern(sstate.name_str(recv))
        if scope_get_global(rnid) >= 0 {
            if types.kind(g_lookup_ty) == K_ATOMIC {
                // S1.2 A1 atomic<T> 内置方法（c.load() / c.fetch_add(1, Relaxed)）
                return gen_atomic_method(recv, g_lookup_ty, mname, id)
            }
            if types.kind(g_lookup_ty) == K_STRUCT {
                var si = g_lookup_ty - BASE_STRUCT
                var full = sstate.struct_name_of(si) + "::" + mname
                if sstate.fn_sig(full) >= 0 {
                    return gen_struct_method_call(full, id, recv, g_lookup_ty)
                }
            }
            if types.kind(g_lookup_ty) == K_PORT {
                // S2.4：port 对象方法调用（动态分发，vtable 间接调用）
                return gen_port_method_call(id, recv, g_lookup_ty, mname)
            }
        }
    }
    // S2.4：表达式接收者（list[0] / 函数返回值 / 字段访问）——port 对象
    // 动态分发（vtable 间接调用）。node_types[recv] 由语义层登记。
    var rt4 = node_types[recv]
    if rt4 >= 0 && types.kind(rt4) == K_PORT {
        return gen_port_method_call(id, recv, rt4, mname)
    }
    var prefix = sinfer.recv_path_name(recv)
    if prefix == "" {
        sm_err_msg = "方法调用接收者不可解析（方法 " + mname + "，函数 " + g_cur_fn_name + "）"
        return -1
    }
    var full = prefix + "::" + mname
    // 实参从 children[slot_off + 1] 开始（children[slot_off]=receiver）
    return gen_user_call_from(full, id, 1 + sstate.slot_off(id))
}

// ==================== S1.2 A1 atomic<T> 方法生成 ====================
// 接收者 = 原子变量槽（alloca）。内存序 IMM 由 irgen 侧解析（Relaxed=0
// Acquire=1 Release=2 AcqRel=3 SeqCst=4；语义层已校验标识符）。
func gen_atomic_method(recv: i64, aty: i64, mname: string, id: i64) -> i64 {
    var rnid = interner.intern(sstate.name_str(recv))
    if scope_get_global(rnid) < 0 {
        sm_err_msg = "原子变量 '" + sstate.name_str(recv) + "' 未入作用域（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var slot = g_lookup_alloca
    var elem = types.table_elem(aty)
    // 实参求值（从 children[slot_off + 1] 起）
    var aoff = 1 + sstate.slot_off(id)
    var nc = sstate.nchild(id)
    var order: i64 = 0
    if mname == "load" {
        // load([order])：0 或 1 参；order 默认 SeqCst
        var ord2: i64 = 4
        if nc > aoff {
            ord2 = atomic_order_imm(sstate.child(id, aoff))
        }
        var inst = ir.new_inst(g_cur_block, 66, elem)
        ir.add_operand(inst, slot, 0)
        ir.add_operand(inst, ord2, 2)  // SeqCst
        return ir.get_value(inst)
    }
    // 取 order（最后一个实参）
    if nc > aoff {
        var last = sstate.child(id, nc - 1)
        order = atomic_order_imm(last)
    }
    if mname == "store" {
        var v = gen_expr(sstate.child(id, aoff))
        if v < 0 {
            return -1
        }
        var vt = node_types[sstate.child(id, aoff)]
        if vt >= 0 && vt != elem && (types.is_int(vt) || types.is_float(vt)) {
            var cv = gen_coerce(v, vt, elem)
            if cv < 0 {
                return -1
            }
            v = cv
        }
        var inst = ir.new_inst(g_cur_block, 67, -1)
        ir.add_operand(inst, elem, 2)  // ① 值类型 IMM
        ir.add_operand(inst, slot, 0)  // ② 地址
        ir.add_operand(inst, v, 0)     // ③ 值
        ir.add_operand(inst, order, 2) // ④ order
        return gen_int_lit(0)
    }
    if mname == "fetch_add" || mname == "fetch_sub" || mname == "fetch_and" ||
        mname == "fetch_or" || mname == "fetch_xor" {
        var v = gen_expr(sstate.child(id, aoff))
        if v < 0 {
            return -1
        }
        var vt = node_types[sstate.child(id, aoff)]
        if vt >= 0 && vt != elem && (types.is_int(vt) || types.is_float(vt)) {
            var cv = gen_coerce(v, vt, elem)
            if cv < 0 {
                return -1
            }
            v = cv
        }
        var opn: i64 = 0
        if mname == "fetch_sub" {
            opn = 1
        } else if mname == "fetch_and" {
            opn = 2
        } else if mname == "fetch_or" {
            opn = 3
        } else if mname == "fetch_xor" {
            opn = 4
        }
        var inst = ir.new_inst(g_cur_block, 68, elem)
        ir.add_operand(inst, slot, 0)
        ir.add_operand(inst, v, 0)
        ir.add_operand(inst, opn, 2)
        ir.add_operand(inst, order, 2)
        return ir.get_value(inst)
    }
    if mname == "compare_exchange" {
        var exp = gen_expr(sstate.child(id, aoff))
        if exp < 0 {
            return -1
        }
        var newv = gen_expr(sstate.child(id, aoff + 1))
        if newv < 0 {
            return -1
        }
        var inst = ir.new_inst(g_cur_block, 69, elem)
        ir.add_operand(inst, slot, 0)
        ir.add_operand(inst, exp, 0)
        ir.add_operand(inst, newv, 0)
        ir.add_operand(inst, order, 2)
        ir.add_operand(inst, order, 2)  // fail order（第一版同 succ）
        // cmpxchg 结果 {Ty, i1}：落内存（tuple 类型 {elem, bool}）+ agg_gep 提取
        var tup = sinfer.tuple2_of(elem, types.named(TK_BOOL))
        var agg = ir.get_value(inst)
        var alloca = ir.new_inst(g_cur_block, 20, tup)
        ir.add_operand(alloca, tup, 2)
        var ap = ir.get_value(alloca)
        var st0 = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st0, tup, 2)
        ir.add_operand(st0, agg, 0)
        ir.add_operand(st0, ap, 0)
        var gp = ir.new_inst(g_cur_block, 27, tup)
        ir.add_operand(gp, ap, 0)
        ir.add_operand(gp, 1, 2)
        var ld = ir.new_inst(g_cur_block, 21, types.named(TK_BOOL))
        ir.add_operand(ld, ir.get_value(gp), 0)
        return ir.get_value(ld)
    }
    sm_err_msg = "atomic 方法 '" + mname + "' 生成失败（函数 " + g_cur_fn_name + "）"
    return -1
}

// 原子内存序标识符 → IMM（Relaxed=0 Acquire=1 Release=2 AcqRel=3 SeqCst=4）
func atomic_order_imm(node: i64) -> i64 {
    var nm = sstate.name_str(node)
    if nm == "Acquire" {
        return 1
    }
    if nm == "Release" {
        return 2
    }
    if nm == "AcqRel" {
        return 3
    }
    if nm == "SeqCst" {
        return 4
    }
    return 0  // Relaxed / 其他（语义层已校验）
}

// struct 实例方法转发调用：函数 = StructName::method，首参 = receiver 聚合值，
// 其余实参 = children[1..]。操作数布局与 gen_user_call_from 完全一致。
func gen_struct_method_call(full: string, id: i64, recv: i64, rty: i64) -> i64 {
    var sig = sstate.fn_sig(full)
    if sig < 0 {
        sm_err_msg = "函数 '" + full + "' 无签名（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var ret_ty = fn_ret_ty(sig)
    var nparams = fn_nparams(sig)
    var ptys = fn_param_tys(sig)
    // 首参 ref 标志（M2.1.8 struct 接收者自动按引用）：sp_refs[sg_off[sig] + 0]
    var first_ref = 0
    var sgo = sg_off[sig]
    if sgo >= 0 && sgo < len(sp_refs) {
        first_ref = sp_refs[sgo]
    }
    var sym = interner.intern(full)
    llvmgen.call_sym_reg(sym)
    // 首参 = receiver（struct 接收者按引用：传槽地址；否则按值传聚合）
    var argvals: table<i64> = table_new_i64()
    var argtys: table<i64> = table_new_i64()  // 并行实参类型（ref 首参 → ptr）
    var rv: i64 = -1
    if first_ref == 1 {
        rv = gen_agg_addr(recv, rty)  // 接收者槽地址（Var → alloca；表达式落内存）
    } else {
        rv = gen_expr(recv)
    }
    if rv < 0 {
        return -1
    }
    table_push(argvals, rv)
    if first_ref == 1 {
        table_push(argtys, types.named(TK_STR))  // 引用 → ptr
    } else {
        table_push(argtys, rty)
    }
    // 其余实参（从 children[slot_off + 1] 起：children[slot_off]=receiver）
    var soff2 = sstate.slot_off(id)
    var nc = sstate.nchild(id)
    var has_var = sstate.fn_has_variadic(sig) == 1
    var fixed_m: i64 = nparams - 1   // 去掉接收者后的固定参数（含变参位置）
    var extra_nodes: table<i64> = table_new_i64()
    var k: i64 = 1 + soff2
    while k < nc {
        var arg_node = sstate.child(id, k)
        var arg_idx = k - soff2  // 形参序号（0 = 接收者）
        if has_var && arg_idx >= fixed_m {
            // 变参多余实参：收集打包（不单独求值/压参）
            table_push(extra_nodes, arg_node)
            k = k + 1
            continue
        }
        var av = gen_expr(arg_node)
        if av < 0 {
            return -1
        }
        table_push(argvals, av)
        var apty = types.named(TK_I64)
        // 形参下标 = 实参序号 + 1（首参 0 = 接收者，已单独压入）；child 下标
        // 与形参下标相差 slot_off（新布局 +1）——ptys[k - soff2] 即该实参的
        // 形参类型（旧布局 soff2=0 → ptys[k]，与历史行为一致）
        if k - soff2 < nparams {
            apty = ptys[k - soff2]
        }
        table_push(argtys, apty)
        k = k + 1
    }
    // 变参打包：多余实参 → 动态表（无多余也要传空表）
    if has_var {
        var var_elem2 = types.table_elem(ptys[nparams - 1])
        var tbl2 = gen_variadic_table(extra_nodes, var_elem2)
        if tbl2 < 0 {
            return -1
        }
        table_push(argvals, tbl2)
        table_push(argtys, ptys[nparams - 1])   // table<T> → ptr
    }
    // 生成 call（同 gen_user_call_from 尾部；实参类型用 argtys 并行表）
    var ty35: i64 = -1
    if ret_ty != types.named(TK_VOID) {
        ty35 = ret_ty
    }
    var inst = ir.new_inst(g_cur_block, 35, ty35)  // call
    ir.add_operand(inst, sym, 0)
    ir.add_operand(inst, ret_ty, 2)
    k = 0
    while k < len(argvals) {
        ir.add_operand(inst, argtys[k], 2)
        ir.add_operand(inst, argvals[k], 0)
        k = k + 1
    }
    if ret_ty == types.named(TK_VOID) {
        return gen_int_lit(0)  // void 结果：哑值（调用方丢弃）
    }
    return ir.get_value(inst)
}

// ==================== 元组 / struct 聚合（M4/P7 扩展）====================
// 聚合值表示：LLVM 结构体 {T0, T1, ...}——寄存器中是聚合值，变量/参数在
// alloca 聚合槽。字段读写统一走"取地址 → agg_gep → load/store"。
// 对齐 Rust ir.rs：元组构造 insertvalue、字段访问 extractvalue/GEP+load 语义
// 完全一致；tie-IR 用 alloca+store+load 构造聚合值、agg_gep 取字段地址。

// 聚合类型 → 字段索引（元组：命名匹配 + ItemN/数字；struct：命名匹配）
func agg_field_index(ty: i64, fname: string) -> i64 {
    var k = types.kind(ty)
    if k == K_TUPLE {
        var idx = ty - BASE_TUPLE
        var off = tup_offs[idx]
        var n = tup_n[idx]
        var i: i64 = 0
        while i < n {
            var fnid = tup_names[off + i]
            if fnid >= 0 && intern.lookup(fnid) == fname {
                return i
            }
            i = i + 1
        }
        // 匿名元组：ItemN（解构展开，N 从 1 起）或纯数字下标（.0/.1）
        return num_field_index(fname)
    }
    if k == K_STRUCT {
        var idx2 = ty - BASE_STRUCT
        var off2 = cls_fldoff[idx2]
        var n2 = cls_nfld[idx2]
        var i2: i64 = 0
        while i2 < n2 {
            var fnid2 = fld_names[off2 + i2]
            if fnid2 >= 0 && intern.lookup(fnid2) == fname {
                return i2
            }
            i2 = i2 + 1
        }
    }
    return -1
}

// 聚合类型 → 字段类型 id
func agg_field_ty(ty: i64, idx: i64) -> i64 {
    var k = types.kind(ty)
    if k == K_TUPLE {
        var t = ty - BASE_TUPLE
        return tup_tys[tup_offs[t] + idx]
    }
    if k == K_STRUCT {
        var s = ty - BASE_STRUCT
        return fld_tys[cls_fldoff[s] + idx]
    }
    return types.named(TK_I64)
}

// 数字/ItemN 字段名解析：".0"/".1" → 字段下标；".Item1"/".Item2" → N-1。
// 非法数字串返回 -1（parse_int 对非法输入报错，须先自行解析）。
func num_field_index(fname: string) -> i64 {
    var n = str_len(fname)
    var start = 0
    if n >= 5 && ig_slice(fname, 0, 4) == "Item" {
        start = 4
    }
    var val: i64 = 0
    var i: i64 = start
    while i < n {
        var cc = char_code(str_char(fname, i))
        if cc < 48 || cc > 57 {
            return -1  // 非数字字段名（未命中）
        }
        val = val * 10 + (cc - 48)
        i = i + 1
    }
    if start == 4 {
        return val - 1  // ItemN → N-1（1-based）
    }
    return val  // 纯数字 → 字段下标
}

// 取聚合 base 的地址（alloca 指针）：Var → 作用域槽地址；表达式 → 求聚合值
// 后 alloca + store（寄存器聚合值落内存，供 GEP 寻址）。
func gen_agg_addr(base: i64, agg: i64) -> i64 {
    if s_tags[base] == 6 {
        var nm = interner.intern(sstate.name_str(base))
        if scope_get_global(nm) >= 0 && g_lookup_is_global == 0 {
            return g_lookup_alloca  // 局部聚合变量槽
        }
    }
    // 表达式（构造调用 / 函数返回 / 字段链）→ 落内存
    var v = gen_expr(base)
    if v < 0 {
        return -1
    }
    var alloca = ir.new_inst(g_cur_block, 20, agg)  // alloca 聚合
    ir.add_operand(alloca, agg, 2)
    var ap = ir.get_value(alloca)
    var st = ir.new_inst(g_cur_block, 22, -1)  // store 聚合值
    ir.add_operand(st, agg, 2)
    ir.add_operand(st, v, 0)
    ir.add_operand(st, ap, 0)
    return ap
}

// 元组字面量 (a, b) → 聚合值：alloca 聚合 → 逐字段 agg_gep + store → load。
// 字段类型取自语义层 tup_tys（node_types[id] 已登记元组类型）。
func gen_tuple_lit(id: i64) -> i64 {
    var agg = node_types[id]
    if agg < 0 {
        sm_err_msg = "元组字面量缺少语义类型（函数 " + g_cur_fn_name + "）"
        return -1
    }
    return gen_tuple_lit_typed(id, agg)
}

// 元组字面量按**目标类型**构造（类型标注适配）：`var w: (i32, i64) = (7, 8)`
// 时语义层把字面量推断为 (i64,i64)，必须按目标 (i32,i64) 构造——IntLit 字段
// 按目标字段类型生成常量（i32 槽存 i32 值；f64 槽转浮点字面量）。
func gen_tuple_lit_typed(id: i64, agg: i64) -> i64 {
    var alloca = ir.new_inst(g_cur_block, 20, agg)  // alloca
    ir.add_operand(alloca, agg, 2)
    var ap = ir.get_value(alloca)
    var nc = sstate.nchild(id)
    var i: i64 = 0
    while i < nc {
        var f = sstate.child(id, i)  // N_TUPLE_FIELD
        var vnode = sstate.child(f, 0)
        var fty = agg_field_ty(agg, i)
        var v: i64 = -1
        if s_tags[vnode] == 0 {
            // IntLit：按目标字段类型生成常量（i32 槽 i32 值 / f64 槽浮点文本）
            if fty == types.named(TK_F64) || fty == types.named(TK_F32) {
                v = gen_float_lit(interner.intern(to_string(s_vals[vnode]) + ".0"))
            } else {
                v = gen_int_lit_ty(s_vals[vnode], fty)
            }
        } else {
            v = gen_expr(vnode)
        }
        if v < 0 {
            return -1
        }
        var gp = ir.new_inst(g_cur_block, 27, agg)  // agg_gep
        ir.add_operand(gp, ap, 0)
        ir.add_operand(gp, i, 2)
        var gpp = ir.get_value(gp)
        var st = ir.new_inst(g_cur_block, 22, -1)  // store
        ir.add_operand(st, fty, 2)
        ir.add_operand(st, v, 0)
        ir.add_operand(st, gpp, 0)
        i = i + 1
    }
    var ld = ir.new_inst(g_cur_block, 21, agg)  // load 聚合值
    ir.add_operand(ld, ap, 0)
    return ir.get_value(ld)
}

// 字段访问（读）：base.field → 地址 + agg_gep + load。
func gen_field_access(id: i64) -> i64 {
    var base = sstate.child(id, 0)
    var fname = sstate.name_str(id)
    var base_ty = node_types[base]
    var bk = types.kind(base_ty)
    if base_ty < 0 || (bk != K_TUPLE && bk != K_STRUCT) {
        sm_err_msg = "字段访问 '.' 的对象不是元组/struct（类型 " + types.type_name(base_ty) + "，函数 " + g_cur_fn_name + "）"
        return -1
    }
    var fidx = agg_field_index(base_ty, fname)
    if fidx < 0 {
        sm_err_msg = "字段 '" + fname + "' 解析失败（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var fty = agg_field_ty(base_ty, fidx)
    var addr = gen_agg_addr(base, base_ty)
    if addr < 0 {
        return -1
    }
    var gp = ir.new_inst(g_cur_block, 27, base_ty)  // agg_gep
    ir.add_operand(gp, addr, 0)
    ir.add_operand(gp, fidx, 2)
    var gpp = ir.get_value(gp)
    var ld = ir.new_inst(g_cur_block, 21, fty)  // load
    ir.add_operand(ld, gpp, 0)
    return ir.get_value(ld)
}

// 字段赋值（FieldAssign 115）：base.field op= value → 地址 + agg_gep + store。
// 复合赋值（op ≥ 0）先 load 旧值运算再写回（对齐 gen_compound_assign）。
func gen_field_assign(id: i64) -> i64 {
    var fname = sstate.name_str(id)
    var base = sstate.child(id, 0)
    var val = sstate.child(id, 1)
    var op = s_vals[id]
    var base_ty = node_types[base]
    var bk = types.kind(base_ty)
    if base_ty < 0 || (bk != K_TUPLE && bk != K_STRUCT) {
        sm_err_msg = "字段赋值的目标不是元组/struct（类型 " + types.type_name(base_ty) + "，函数 " + g_cur_fn_name + "）"
        return -1
    }
    var fidx = agg_field_index(base_ty, fname)
    if fidx < 0 {
        sm_err_msg = "字段 '" + fname + "' 解析失败（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var fty = agg_field_ty(base_ty, fidx)
    var addr = gen_agg_addr(base, base_ty)
    if addr < 0 {
        return -1
    }
    var gp = ir.new_inst(g_cur_block, 27, base_ty)  // agg_gep
    ir.add_operand(gp, addr, 0)
    ir.add_operand(gp, fidx, 2)
    var gpp = ir.get_value(gp)
    if op >= 0 {
        // 复合字段赋值：load 旧值 → 运算 → store
        var cur = ir.new_inst(g_cur_block, 21, fty)  // load
        ir.add_operand(cur, gpp, 0)
        var cur_v = ir.get_value(cur)
        var rv = gen_expr(val)
        if rv < 0 {
            return -1
        }
        var res = gen_compound_assign(op, cur_v, rv, fty)
        if res < 0 {
            sm_err_msg = "复合字段赋值运算失败（字段 " + fname + "，函数 " + g_cur_fn_name + "）"
            return -1
        }
        var st = ir.new_inst(g_cur_block, 22, -1)  // store
        ir.add_operand(st, fty, 2)
        ir.add_operand(st, res, 0)
        ir.add_operand(st, gpp, 0)
        return 0
    }
    var vv = gen_expr(val)
    if vv < 0 {
        return -1
    }
    // S1.3 窄整数字段：赋值值按字段类型转换（i64 值 → i32 字段）
    var vt = node_types[val]
    if vt >= 0 && (types.is_int(vt) || types.is_float(vt)) &&
        (types.is_int(fty) || types.is_float(fty)) && vt != fty {
        var cv = gen_coerce(vv, vt, fty)
        if cv < 0 {
            return -1
        }
        vv = cv
    }
    var st2 = ir.new_inst(g_cur_block, 22, -1)  // store
    ir.add_operand(st2, fty, 2)
    ir.add_operand(st2, vv, 0)
    ir.add_operand(st2, gpp, 0)
    return 0
}

// struct 名判定（构造调用：Call 名命中 st_keys）
func is_struct_name(nm: string) -> bool {
    var nid = interner.intern(nm)
    return sstate.bs_find(st_keys, nid) >= 0
}

// enum 名判定（2026-08-15 enum 语言特性）：枚举名命中 en_keys。
// 仿 is_struct_name——构造分派点（FieldAccess/MethodCall/Call）用。
func is_enum_name(nm: string) -> bool {
    var nid = interner.intern(nm)
    return sstate.bs_find(en_keys, nid) >= 0
}

// 枚举变体 tag 解析：枚举名 + 变体名 → tag 值（0..nvar-1）；-1 = 未找到。
// 在 en_vnames 拍平段（en_varoff[ei] 起 en_nvar[ei] 个）线性查找变体名。
// 供 gen_enum_construct（构造）与 gen_switch（case 模式 → tag 常量）共用。
func enum_variant_tag(ei: i64, vname: string) -> i64 {
    var varoff = en_varoff[ei]
    var nvar = en_nvar[ei]
    var k: i64 = 0
    while k < nvar {
        if intern.lookup(en_vnames[varoff + k]) == vname {
            return en_vtags[varoff + k]
        }
        k = k + 1
    }
    return -1
}

// 枚举 switch 的 case 模式 → tag 常量（-1 = 非法模式）。
// 模式形态：FieldAccess(Enum.Variant)——base 是枚举名 Var，name 是变体名。
// 枚举名解析：普通 enum 直接查 en_keys；泛型 enum 模板名（如 Option）经
// gin 记录反查——subject 是对应模板的实例化时，解析到 subject 的实例
//（scheck 已做同款校验，此处防御性复核）。返回变体 tag 值（0..nvar-1）。
func enum_case_tag(pat: i64, subj_ty: i64) -> i64 {
    var ei = types.low(subj_ty)
    if s_tags[pat] != 15 {
        return -1  // 非 FieldAccess（scheck 已拦截，防御）
    }
    var base = sstate.child(pat, 0)
    if s_tags[base] != 6 {
        return -1  // base 非 Var（scheck 已拦截，防御）
    }
    var bname = sstate.name_str(base)
    var eidx = sstate.bs_find(en_keys, interner.intern(bname))
    var ei2: i64 = -1
    if eidx >= 0 {
        ei2 = en_vals[eidx]
    } else {
        // 泛型 enum 模板：subject 必须是对应模板的实例化
        var gidx = sstate.gt_find(bname)
        if gidx >= 0 && gty_is_struct[gidx] == 2 {
            var rec = sstate.gin_find(sstate.enum_name_of(ei))
            if rec >= 0 && gin_tmpl[rec] == gidx {
                ei2 = ei
            }
        }
    }
    if ei2 != ei {
        return -1  // base 不是同枚举（scheck 已拦截，防御）
    }
    return enum_variant_tag(ei, sstate.name_str(pat))
}

// 枚举构造：EnumName.Variant(args) → 聚合值。
// eidx：en_keys 下标（构造名反查的枚举）；vname：变体名；id：AST 节点
//（MethodCall 取实参；FieldAccess 无实参）；arg_start：实参起始 child
// 下标（MethodCall = slot_off + 1；FieldAccess/无实参 = -1）。
// 布局（对齐 gen_struct_construct）：alloca %enum.X → store tag（槽 0）→
// 逐 payload 槽 store（实参覆盖前 nfld 个；其余槽零值）→ load 聚合值。
// 槽类型统一 i64：窄整数/字符/布尔 payload 经 sext 升宽到 i64（一期白名单
// 限整数系；string payload 无现成 ptr↔i64 桥 → 报"暂不支持"）。
func gen_enum_construct(eidx: i64, vname: string, id: i64, arg_start: i64) -> i64 {
    var ei = en_vals[eidx]
    var ename = sstate.enum_name_of(ei)
    var tag = enum_variant_tag(ei, vname)
    if tag < 0 {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "枚举 '" + ename + "' 没有变体 '" + vname + "'（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var varoff = en_varoff[ei]
    var nfld = en_vnfld[varoff + tag]
    var foff = en_vfldoff[varoff + tag]
    var nslot = en_nslot[ei]
    var agg = types.enum_of(ei)
    // alloca 聚合（类型 = %enum.X）
    var alloca = ir.new_inst(g_cur_block, 20, agg)
    ir.add_operand(alloca, agg, 2)
    var ap = ir.get_value(alloca)
    // store tag（槽 0，i64）
    var tagv = gen_int_lit_ty(tag, types.named(TK_I64))
    var g0 = ir.new_inst(g_cur_block, 27, agg)  // agg_gep 下标 0
    ir.add_operand(g0, ap, 0)
    ir.add_operand(g0, 0, 2)
    var g0p = ir.get_value(g0)
    var st0 = ir.new_inst(g_cur_block, 22, -1)  // store
    ir.add_operand(st0, types.named(TK_I64), 2)
    ir.add_operand(st0, tagv, 0)
    ir.add_operand(st0, g0p, 0)
    // 逐 payload 槽（槽下标 1..nslot；i 从 0 起对应槽 1+i）
    var i: i64 = 0
    while i < nslot {
        var fty: i64 = types.named(TK_I64)
        var v: i64 = -1
        if i < nfld {
            fty = en_ftys[foff + i]
            var arg = sstate.child(id, arg_start + i)
            if fty == types.named(TK_STR) {
                // string payload（S2.3）：槽是 i64，已按 i64 指针值发射的 string
                // 表达式可直接存储——两类：字符串字面量（const_str 发射为
                // ptrtoint i64）与字符串拼接（str_cat 输出同为 ptrtoint i64，
                // 见 llvmgen op==56）；其余 string 变量/调用返回值是 ptr 值，
                // 需 ptrtoint 转 i64 后存储。读取侧（switch case 绑定 / ? 解包）
                // 由消费方按需 inttoptr 还原 ptr。
                v = gen_expr(arg)
                if v < 0 {
                    return -1
                }
                // 跳过转换：字面量（S_N_STR_LIT=2）或字符串拼接（S_N_BINARY=9
                // 且语义类型为 string——比较类二元返回 bool 不会命中）
                var is_i64_ptrval = s_tags[arg] == 2 ||
                    (s_tags[arg] == 9 && node_types[arg] == types.named(TK_STR))
                if !is_i64_ptrval {
                    var pi = ir.new_inst(g_cur_block, 24, types.named(TK_I64))  // ptrtoint
                    ir.add_operand(pi, v, 0)
                    v = ir.get_value(pi)
                }
            } else {
                // 窄整数字段 + 整数字面量：按字段类型生成常量（i32 槽 i32 值）——
                // 否则字面量走 gen_expr 恒 i64，sext i32 %i64 类型不匹配。
                // 非字面量（变量/表达式）gen_expr 产出天然窄类型（i32 变量 load i32、
                // 字符/布尔字面量 i32/i1），sext 源类型与 fty 一致。
                if fty != types.named(TK_I64) && fty != types.named(TK_U64) && s_tags[arg] == 0 {
                    v = gen_int_lit_ty(s_vals[arg], fty)
                } else {
                    v = gen_expr(arg)
                }
                if v < 0 {
                    return -1
                }
                // 窄整数/字符/布尔/trit → sext 升宽到 i64（槽统一 i64；u 类型
                // 升宽用 sext——一期仅 i64 payload 参与验收，符号扩展边界已注释；
                // string 已是 i64 指针值，不参与升宽）
                if fty != types.named(TK_I64) && fty != types.named(TK_U64) {
                    var se = ir.new_inst(g_cur_block, 19, types.named(TK_I64))  // sext
                    ir.add_operand(se, fty, 2)
                    ir.add_operand(se, v, 0)
                    v = ir.get_value(se)
                }
            }
        } else {
            // 无 payload 变体 / 超出实参的槽：零值（聚合不含未定义位）
            v = gen_int_lit_ty(0, types.named(TK_I64))
        }
        var gp = ir.new_inst(g_cur_block, 27, agg)  // agg_gep 下标 1+i
        ir.add_operand(gp, ap, 0)
        ir.add_operand(gp, 1 + i, 2)
        var gpp = ir.get_value(gp)
        var st = ir.new_inst(g_cur_block, 22, -1)  // store i64
        ir.add_operand(st, types.named(TK_I64), 2)
        ir.add_operand(st, v, 0)
        ir.add_operand(st, gpp, 0)
        i = i + 1
    }
    var ld = ir.new_inst(g_cur_block, 21, agg)  // load 聚合值
    ir.add_operand(ld, ap, 0)
    return ir.get_value(ld)
}

// S2.3：`expr ?` 解包展开（N_TRY=133）。语义已由 sinfer.infer_try_unwrap
// 校验：操作数必须是 Result/Option 形态枚举（含 Ok/Some 与 Err/None 变体），
// 当前函数返回类型必须是同一枚举实例；解包类型 = Ok/Some 的 payload 类型
// （node_types[id] 已登记）。IR 布局：gen_agg_addr 落内存 → 槽 0 读 tag →
// icmp eq err_tag → cond_br；err 分支 ret 操作数聚合值本身（返回类型与
// 操作数同实例，Err 值原样返回）；ok 分支解包槽 1（string 槽存 i64 指针值
// → inttoptr 还原 ptr；窄整数槽存 sext 后 i64 → trunc 还原；i64/u64 直用）。
func gen_try(id: i64) -> i64 {
    var operand = sstate.child(id, 0)
    var oty = node_types[operand]
    if oty < 0 || types.kind(oty) != K_ENUM {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "内部错误：'?' 解包操作数缺少枚举类型（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var ei = types.low(oty)
    // 找 Err/None 变体 tag（提前返回分支的判定值）
    var err_tag = enum_variant_tag(ei, "Err")
    if err_tag < 0 {
        err_tag = enum_variant_tag(ei, "None")
    }
    if err_tag < 0 {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "内部错误：'?' 解包枚举缺少 Err/None 变体（函数 " + g_cur_fn_name + "）"
        return -1
    }
    // 1. 操作数落内存（gen_agg_addr 取聚合地址：变量直接槽，表达式 store 到 alloca）
    var eaddr = gen_agg_addr(operand, oty)
    if eaddr < 0 {
        return -1
    }
    // 2. 读 tag（槽 0）：agg_gep 0 → load i64
    var g0 = ir.new_inst(g_cur_block, 27, oty)  // agg_gep
    ir.add_operand(g0, eaddr, 0)
    ir.add_operand(g0, 0, 2)
    var g0p = ir.get_value(g0)
    var ld0 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))  // load i64
    ir.add_operand(ld0, g0p, 0)
    var tag_v = ir.get_value(ld0)
    // 3. icmp eq tag_v, err_tag
    var err_c = gen_int_lit_ty(err_tag, types.named(TK_I64))
    var ic = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp eq
    ir.add_operand(ic, tag_v, 0)
    ir.add_operand(ic, err_c, 0)
    ir.add_operand(ic, 0, 2)  // eq
    var icv = ir.get_value(ic)
    // 4. cond_br → err_blk（提前 return）/ ok_blk（解包）
    var err_blk = ir.new_block(g_cur_func, interner.intern("try.err"))
    var ok_blk = ir.new_block(g_cur_func, interner.intern("try.ok"))
    var cbr = ir.new_inst(g_cur_block, 31, -1)  // cond_br
    ir.add_operand(cbr, icv, 0)
    ir.add_operand(cbr, err_blk, 1)
    ir.add_operand(cbr, ok_blk, 1)
    // 5. err_blk：ret 操作数聚合值（返回类型 == 操作数枚举实例，Err 原样返回）
    g_cur_block = err_blk
    var ld_a = ir.new_inst(g_cur_block, 21, oty)  // load 聚合值
    ir.add_operand(ld_a, eaddr, 0)
    var agg_v = ir.get_value(ld_a)
    var ret_e = ir.new_inst(g_cur_block, 32, oty)  // ret 聚合
    ir.add_operand(ret_e, agg_v, 0)
    // 6. ok_blk：解包 payload（槽 1）
    g_cur_block = ok_blk
    var g1 = ir.new_inst(g_cur_block, 27, oty)  // agg_gep 下标 1
    ir.add_operand(g1, eaddr, 0)
    ir.add_operand(g1, 1, 2)
    var g1p = ir.get_value(g1)
    var uty = node_types[id]  // 解包类型（infer_try_unwrap 已登记）
    if uty < 0 {
        uty = types.named(TK_I64)
    }
    // string payload：槽存 i64 指针值 → load i64 → inttoptr 还原 ptr
    if uty == types.named(TK_STR) {
        var ld1 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(ld1, g1p, 0)
        var pv1 = ir.get_value(ld1)
        var ip = ir.new_inst(g_cur_block, 25, types.named(TK_STR))  // inttoptr
        ir.add_operand(ip, pv1, 0)
        return ir.get_value(ip)
    }
    // 窄整数 payload：槽存 sext 后 i64 → load i64 → trunc 还原（gen_coerce）
    if types.is_int(uty) && uty != types.named(TK_I64) && uty != types.named(TK_U64) {
        var ld2 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(ld2, g1p, 0)
        var pv2 = ir.get_value(ld2)
        return gen_coerce(pv2, types.named(TK_I64), uty)  // trunc opcode 37
    }
    // 其他（i64/u64）：槽统一 i64，load 直用
    var ld3 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
    ir.add_operand(ld3, g1p, 0)
    return ir.get_value(ld3)
}

// S2.3：`panic("消息")` 不可恢复错误语句（N_PANIC=134）→ 打印消息 + 退出。
// 参考 gen_println（call_vararg + 格式串池 id + 消息）与 exit() 先例
// （gen_ext_call1("exit", ...)，C 运行时 exit() 自带 stdio flush）。
// 可配置目标行为（嵌入式 halt / wasm trap）由语义层校验，一期桌面打印+退出。
func gen_panic(id: i64) -> i64 {
    var msg = sstate.child(id, 0)
    var mv = gen_expr(msg)
    if mv < 0 {
        return -1
    }
    // printf 消息：call_vararg + 格式串 "%s\n" + 消息 ptr
    var fmt = interner.intern("%s\n")
    var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
    ir.add_operand(inst, fmt, 0)
    ir.add_operand(inst, mv, 0)
    // exit(1)
    var one = gen_int_lit_ty(1, types.named(TK_I64))
    gen_ext_call1("exit", one, types.named(TK_I64), -1)
    return 0
}

// struct 构造调用：StructName(args...) → 聚合值。
// 布局：alloca 聚合 → 逐字段 store（实参覆盖前 n 个；缺省字段零值——
// 字段默认字面量未登记，与 Rust 行为差异留待后续）→ load 聚合值。
func gen_struct_construct(id: i64, nm: string) -> i64 {
    var nid = interner.intern(nm)
    var sidx = sstate.bs_find(st_keys, nid)
    if sidx < 0 {
        sm_err_msg = "struct '" + nm + "' 未定义（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var si = st_vals[sidx]
    var agg = types.struct_of(si)
    var alloca = ir.new_inst(g_cur_block, 20, agg)  // alloca
    ir.add_operand(alloca, agg, 2)
    var ap = ir.get_value(alloca)
    var off = cls_fldoff[si]
    var nf = cls_nfld[si]
    // 构造调用 children = [泛型槽, 实参...]：实参从 children[slot_off] 起
    var soff = sstate.slot_off(id)
    var nc = sstate.nchild(id) - soff
    var i: i64 = 0
    while i < nf {
        var fty = fld_tys[off + i]
        var v: i64 = -1
        if i < nc {
            v = gen_expr(sstate.child(id, soff + i))
            if v < 0 {
                return -1
            }
            // S1.3 窄整数字段：实参值按字段类型转换（i64 字面量 → i32 字段）
            var an = sstate.child(id, soff + i)
            var at = node_types[an]
            if at >= 0 && (types.is_int(at) || types.is_float(at)) &&
                (types.is_int(fty) || types.is_float(fty)) && at != fty {
                var cv = gen_coerce(v, at, fty)
                if cv < 0 {
                    return -1
                }
                v = cv
            }
        } else if off + i < len(fld_defs) && fld_defs[off + i] >= 0 {
            // 字段默认值（`var y: i64 = 10` → Point(5) 缺省 y 用 10）
            v = gen_expr(fld_defs[off + i])
            if v < 0 {
                return -1
            }
        } else {
            // 无默认值字段：零值（i64=0 / string 空串指针 / bool false）
            v = gen_default_val(fty)
        }
        var gp = ir.new_inst(g_cur_block, 27, agg)  // agg_gep
        ir.add_operand(gp, ap, 0)
        ir.add_operand(gp, i, 2)
        var gpp = ir.get_value(gp)
        var st = ir.new_inst(g_cur_block, 22, -1)  // store
        ir.add_operand(st, fty, 2)
        ir.add_operand(st, v, 0)
        ir.add_operand(st, gpp, 0)
        i = i + 1
    }
    var ld = ir.new_inst(g_cur_block, 21, agg)  // load 聚合值
    ir.add_operand(ld, ap, 0)
    return ir.get_value(ld)
}

// 类型零值生成：i64/整数 → const 0；string/ptr → 空串全局常量；
// bool → false；f64 → 0.0（const_f）；i8/i32 等 → 0 常量
func gen_default_val(ty: i64) -> i64 {
    if ty == types.named(TK_STR) || types.is_table(ty) || types.is_map(ty) {
        return gen_str_lit(interner.intern("\"\""))  // 空串指针
    }
    if ty == types.named(TK_F64) || ty == types.named(TK_F32) {
        return gen_float_lit(interner.intern("0.0"))
    }
    if ty == types.named(TK_BOOL) {
        return gen_bool_lit(0)
    }
    if ty == types.named(TK_I8) || ty == types.named(TK_CHAR) || ty == types.named(TK_TRIT) {
        return gen_int_lit_ty(0, ty)
    }
    return gen_int_lit_ty(0, types.named(TK_I64))
}

// 表字面量 → 动态表指针（tie_table_new + 逐元素 push）。
// 元素类型：语义 node_types 首元素推断；空表 → i64 兜底。
func gen_table_lit(id: i64) -> i64 {
    g_used_interp = true
    // E3 键值表（map）字面量：任一个 cell 带字符串键（TableCell → TableId，
    // TableId name = 字符串键池 id >= 0；数字键 name=-1 不算 map）→ 走 map 桥：
    // tie_table_new(16) + 逐对 tie_map_set / tie_map_set_string（键为字符串 ptr）。
    // 对齐 Rust 基线 gen_table_lit_arg / gen_dyn_table_var 的 map 展开（元素 16 字节）。
    // 背景（普适段错误根因）：map 字面量曾落入普通表路径——tie_table_new(8) +
    // tie_table_push_i64，键全部丢弃、元素宽度 8 与运行时 map 的 16 字节元素不符，
    // 后续 tie_map_set 按 16 字节越界写堆 → 0xC0000374 / 0xC0000005 崩溃，
    // m["a"] 读回 0（键从未写入）。
    var nc = sstate.nchild(id)
    var has_str_key: bool = false
    var ci: i64 = 0
    while ci < nc {
        var ccell = sstate.child(id, ci)
        var cid = sstate.child(ccell, 0)
        if cid >= 0 && s_names[cid] >= 0 {
            has_str_key = true
        }
        ci = ci + 1
    }
    if has_str_key {
        // map 值类型：node_types[id] = map<V> → low 解码 V；裸 map 兜底 i64；
        // 值为 string → tie_map_set_string（对齐 gen_index_read/assign 的 map 分支）。
        var mval_ty: i64 = types.named(TK_I64)
        var lit_ty = node_types[id]
        if types.is_map(lit_ty) {
            var lv = types.low(lit_ty)
            if lv > 0 {
                mval_ty = lv
            }
        }
        var bridge_set = "tie_map_set"
        var pty_v = types.named(TK_I64)
        if mval_ty == types.named(TK_STR) {
            bridge_set = "tie_map_set_string"
            pty_v = types.named(TK_STR)
        }
        var size16 = gen_int_lit_ty(16, types.named(TK_I64))
        var t = gen_ext_call1("tie_table_new", size16, types.named(TK_I64), types.named(TK_STR))
        var i: i64 = 0
        while i < nc {
            var cell = sstate.child(id, i)
            var cid2 = sstate.child(cell, 0)
            if cid2 < 0 || s_names[cid2] < 0 {
                sm_err_msg = "键值表字面量元素缺少字符串键（函数 " + g_cur_fn_name + "）"
                return -1
            }
            // 键字符串 → @.str.N 全局（gen_str_lit 去引号 + 登记常量；键借用约定：
            // 字符串字面量是全局常量，比表存活更久——对齐 Rust string_global）
            var k = gen_str_lit(s_names[cid2])
            var val = sstate.child(cell, 1)
            var v = gen_expr(val)
            if v < 0 {
                return -1
            }
            // ok 出参槽（越界标志；阶段 A 简化不检查，传哑槽——与下标读写 map 分支同款）
            var mok = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
            ir.add_operand(mok, types.named(TK_I8), 2)
            var mats: table<i64> = table_new_i64()
            var mavs: table<i64> = table_new_i64()
            table_push(mats, types.named(TK_STR))
            table_push(mavs, t)
            table_push(mats, types.named(TK_STR))
            table_push(mavs, k)
            table_push(mats, pty_v)
            table_push(mavs, v)
            table_push(mats, types.named(TK_STR))
            table_push(mavs, ir.get_value(mok))
            gen_ext_call_typed(bridge_set, mats, mavs, -1)
            i = i + 1
        }
        return t
    }
    // 普通表字面量（元素类型推断）
    var elem: i64 = types.named(TK_I64)
    if nc > 0 {
        var cell = sstate.child(id, 0)
        var val = sstate.child(cell, 1)
        var vt = node_types[val]
        if vt >= 0 {
            elem = vt
        }
    }
    var size = elem_size(elem)
    // 数字实参必须先转值 id（gen_ext_call* 的实参都是值 id，直接传数字
    // 会被当作值引用生成前向引用 %N）
    var size_v = gen_int_lit_ty(size, types.named(TK_I64))
    var t = gen_ext_call1("tie_table_new", size_v, types.named(TK_I64), types.named(TK_STR))
    // 逐元素 push
    var i: i64 = 0
    while i < nc {
        var cell = sstate.child(id, i)
        var val = sstate.child(cell, 1)
        var v = gen_expr(val)
        if v < 0 {
            return -1
        }
        // 桥选择按**值**的实际类型判定（对齐 table_push 内建路径 + Rust
        // table_elem_suffix）：嵌套表/键值表/字符串值 → push_string 存 ptr；
        // 浮点值 → push_f64；否则按声明元素类型（i64/bool）。
        // 背景：二维表/嵌套表字面量 `[[1,2],[3,4]]` 的外层元素类型是
        // table<i64>，若按 elem 选桥会 push_i64(ptr) 类型错（LLVM 拒收）；
        // 且空内层表 `[]` 的 node_types 落 i64 兜底——只要 elem 本身是表，
        // 全部元素一律 push_string（元素全是 ptr）。
        // S2.4：port 对象元素（table<Drawable>）LLVM 表示 = ptr（堆打包
        // {data,vtable}）——走 string 桥（参数类型 TK_STR = ptr，类型匹配）；
        // 返回场景（at）由调用处把返回类型标为 K_PORT 本身，避开 S2.1 的
        // TK_STR 补头逻辑（补头会对 port 对象 ptr 做 strlen → 崩溃）。
        var suffix = bridge_suffix(elem)
        var pty = types.named(TK_I64)
        if types.is_table(elem) || types.is_map(elem) || types.kind(elem) == K_PORT {
            suffix = "string"
            pty = types.named(TK_STR)
        } else {
            var vt = node_types[val]
            if vt >= 0 && (types.is_table(vt) || types.is_map(vt) || vt == types.named(TK_STR) || types.kind(vt) == K_PORT) {
                suffix = "string"
                pty = types.named(TK_STR)
            } else if vt >= 0 && (vt == types.named(TK_F64) || vt == types.named(TK_F32)) {
                suffix = "f64"
                pty = types.named(TK_F64)
            } else if suffix == "string" {
                pty = types.named(TK_STR)
            } else if suffix == "bool" {
                pty = types.named(TK_BOOL)
            }
        }
        gen_ext_call2v("tie_table_push_" + suffix, t, types.named(TK_STR), v, pty)
        i = i + 1
    }
    return t
}

// 外部桥调用（extern_call 36）通用生成。argtys/argv 并行表（实参 LLVM 类型 id + 值 id）。
// 返回结果值 id（void 桥返回 -1，指令 ty=-1 无结果寄存器）。
// 操作数布局：[0]=符号池id, [1]=返回类型id(IMM), 然后每参数 [类型id(IMM), 值]。
// is_libc：true = libc 符号（不置 g_used_interp）；false = tie_interp 桥。
func gen_ext_call_typed(sym: string, argtys: table<i64>, argv: table<i64>, ret_ty: i64) -> i64 {
    if !is_libc_sym(sym) {
        g_used_interp = true
    }
    var sid = interner.intern(sym)
    var inst = ir.new_inst(g_cur_block, 36, ret_ty)
    ir.add_operand(inst, sid, 0)
    ir.add_operand(inst, ret_ty, 2)  // 返回类型（IMM）
    var k: i64 = 0
    while k < len(argv) {
        ir.add_operand(inst, argtys[k], 2)
        ir.add_operand(inst, argv[k], 0)
        k = k + 1
    }
    if ret_ty < 0 {
        return -1
    }
    return ir.get_value(inst)
}

// 符号是否为 libc（llvmgen 无条件 declare 的符号；不触发 tie_interp 链接）
func is_libc_sym(sym: string) -> bool {
    if sym == "printf" || sym == "strlen" || sym == "strcmp" {
        return true
    }
    if sym == "malloc" || sym == "free" || sym == "fopen" || sym == "fwrite" || sym == "fclose" || sym == "fflush" {
        return true
    }
    // S2.1：libc memcpy（StringBuilder 数据拷贝；无需 tie_interp 链接）
    if sym == "memcpy" {
        return true
    }
    if sym == "exit" || sym == "remove" {
        return true
    }
    // libm 数学函数（llvmgen 无条件 declare；f64 → f64）
    if sym == "sqrt" || sym == "sin" || sym == "cos" || sym == "tan" ||
        sym == "exp" || sym == "log" || sym == "floor" || sym == "ceil" ||
        sym == "round" || sym == "pow" {
        return true
    }
    return false
}

// 便捷：单参数桥（返回非 void）
func gen_ext_call1(sym: string, v: i64, vty: i64, ret_ty: i64) -> i64 {
    var ats: table<i64> = table_new_i64()
    var avs: table<i64> = table_new_i64()
    table_push(ats, vty)
    table_push(avs, v)
    return gen_ext_call_typed(sym, ats, avs, ret_ty)
}

// 符号扩展：src 类型值 → dst 类型（sext opcode 19）。trit/窄整数提升用。
func gen_sext(v: i64, src_ty: i64, dst_ty: i64) -> i64 {
    var sext = ir.new_inst(g_cur_block, 19, dst_ty)
    ir.add_operand(sext, src_ty, 2)  // 源类型 IMM
    ir.add_operand(sext, v, 0)
    return ir.get_value(sext)
}

// 整数 → f64 提升（sitofp opcode 28）：数学函数整数实参（sqrt(4)）转浮点。
// 已是 f64/f32 直传；窄整数/无符号按有符号 sitofp（tie 整数有符号语义）。
func gen_to_f64(v: i64, vt: i64) -> i64 {
    if types.is_int(vt) {
        var s = ir.new_inst(g_cur_block, 28, types.named(TK_F64))  // sitofp
        ir.add_operand(s, vt, 2)  // 源类型 IMM
        ir.add_operand(s, v, 0)
        return ir.get_value(s)
    }
    return v  // 已 f64/f32（或未知 → 直传）
}

// i8 返回桥 → bool（i1）：call i8 → icmp ne i8 %r, 0（对齐 Rust i8→i1 转换）
func gen_bool_bridge1(sym: string, v: i64, vty: i64) -> i64 {
    var r = gen_ext_call1(sym, v, vty, types.named(TK_I8))
    if r < 0 {
        return -1
    }
    var inst = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp ne
    ir.add_operand(inst, r, 0)
    ir.add_operand(inst, 0, 2)
    ir.add_operand(inst, 1, 2)  // ne
    return ir.get_value(inst)
}

// 双字符串参数 i8 返回桥 → bool（file_copy/file_move/untar_gz/unzip/copy_dir 等）
func gen_bool_bridge2(sym: string, v1: i64, v2: i64) -> i64 {
    var r = gen_ext_call2(sym, v1, types.named(TK_STR), v2, types.named(TK_STR), types.named(TK_I8))
    if r < 0 {
        return -1
    }
    var inst = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp ne
    ir.add_operand(inst, r, 0)
    ir.add_operand(inst, 0, 2)
    ir.add_operand(inst, 1, 2)  // ne
    return ir.get_value(inst)
}

// 便捷：双参数桥（返回非 void）
func gen_ext_call2(sym: string, v1: i64, ty1: i64, v2: i64, ty2: i64, ret_ty: i64) -> i64 {
    var ats: table<i64> = table_new_i64()
    var avs: table<i64> = table_new_i64()
    table_push(ats, ty1)
    table_push(avs, v1)
    table_push(ats, ty2)
    table_push(avs, v2)
    return gen_ext_call_typed(sym, ats, avs, ret_ty)
}

// ==================== S2.1 字符串 {ptr,len} 原语实现 ====================
// 字符串运行时布局（S2.1 决策 O2 + F1）：
//   ptr → [8 字节 i64 长度头][UTF-8 数据][\0 边界自动 NUL]
// 长度头位于数据指针 -8 处（load i64, gep(i8, ptr, -8)）——len(s) O(1)；
// 数据 NUL 结尾——旧 strlen/strcmp/printf 与 FFI 传方向零拷贝兼容。
// 所有字符串值统一该布局：字面量 .rodata 带头（llvmgen emit_strings）、
// str_cat malloc 带头（llvmgen op 56）、tie 桥返回自动补头（llvmgen op 36）、
// sb_build 产出带头。以下辅助全部生成普通 tie-IR 指令（零新 opcode）。

// getelementptr i8, ptr base, i64 off（字节步长；off 可为立即数或寄存器）
func s21_gep(base: i64, off: i64, off_is_imm: bool) -> i64 {
    var gp = ir.new_inst(g_cur_block, 23, types.named(TK_I8))  // gep 元素类型 i8
    ir.add_operand(gp, base, 0)
    if off_is_imm {
        ir.add_operand(gp, off, 2)  // OK_IMM 立即数偏移
    } else {
        ir.add_operand(gp, off, 0)  // OK_VALUE 寄存器偏移
    }
    return ir.get_value(gp)
}

// load ty, ptr addr
func s21_load(addr: i64, ty: i64) -> i64 {
    var ld = ir.new_inst(g_cur_block, 21, ty)  // load
    ir.add_operand(ld, addr, 0)
    return ir.get_value(ld)
}

// store ty val, ptr addr（无结果）
func s21_store(addr: i64, val: i64, ty: i64) {
    var st = ir.new_inst(g_cur_block, 22, -1)  // store
    ir.add_operand(st, ty, 2)
    ir.add_operand(st, val, 0)
    ir.add_operand(st, addr, 0)
}

// zext sty %v to i64（无符号扩展；字节 i8 / i1 布尔）
func s21_zext(v: i64, sty: i64) -> i64 {
    var z = ir.new_inst(g_cur_block, 29, types.named(TK_I64))  // zext
    ir.add_operand(z, sty, 2)
    ir.add_operand(z, v, 0)
    return ir.get_value(z)
}

// trunc i64 %v to i8（单字节写入用）
func s21_trunc_i8(v: i64) -> i64 {
    var t = ir.new_inst(g_cur_block, 37, types.named(TK_I8))  // trunc
    ir.add_operand(t, types.named(TK_I64), 2)
    ir.add_operand(t, v, 0)
    return ir.get_value(t)
}

// 整数二元运算快捷（add/sub/and/or/shl，i64）
func s21_bin(op: i64, a: i64, b: i64) -> i64 {
    var s = ir.new_inst(g_cur_block, op, types.named(TK_I64))
    ir.add_operand(s, a, 0)
    ir.add_operand(s, b, 0)
    return ir.get_value(s)
}

// memcpy(dst, src, n)：libc memcpy（extern_call；llvmgen extern_decl 登记，
// is_libc_sym 免 interp 链接；参数全为普通类型——LLVM 内建 memcpy 的 i1
// immarg 参数不能用 SSA 寄存器，故走 libc 版本）
func s21_memcpy(dst: i64, src: i64, n: i64) {
    var ats: table<i64> = table_new_i64()
    var avs: table<i64> = table_new_i64()
    table_push(ats, types.named(TK_STR))
    table_push(avs, dst)
    table_push(ats, types.named(TK_STR))
    table_push(avs, src)
    table_push(ats, types.named(TK_I64))
    table_push(avs, n)
    gen_ext_call_typed("memcpy", ats, avs, -1)
}

// if n > 0: memcpy(dst, src, n)——保护 src 为 null（空缓冲）的零长拷贝
func s21_memcpy_if(dst: i64, src: i64, n: i64) {
    var c = gen_icmp_c(n, gen_int_lit(0), 3)  // sgt
    var t = ir.new_block(g_cur_func, interner.intern("s21.mt"))
    var e = ir.new_block(g_cur_func, interner.intern("s21.me"))
    var cb = ir.new_inst(g_cur_block, 31, -1)  // cond_br
    ir.add_operand(cb, c, 0)
    ir.add_operand(cb, t, 1)
    ir.add_operand(cb, e, 1)
    g_cur_block = t
    s21_memcpy(dst, src, n)
    var br = ir.new_inst(g_cur_block, 30, -1)  // br e
    ir.add_operand(br, e, 1)
    g_cur_block = e
}

// 字符串长度头读取：len(s) = load i64, gep(i8, s, -8)——O(1)
func s21_str_head_len(s: i64) -> i64 {
    var hp = s21_gep(s, -8, true)
    return s21_load(hp, types.named(TK_I64))
}

// 取第 i 字节（0 ≤ i < len(s)；越界未定义——调用方保证）
func s21_str_byte(s: i64, i: i64) -> i64 {
    var bp = s21_gep(s, i, false)
    return s21_zext(s21_load(bp, types.named(TK_I8)), types.named(TK_I8))
}

// UTF-8 序列长度（按首字节判定，无分支算术）：
//   l = 4 - (b<0x80) - (b<0xE0) - (b<0xF0)   （ult 无符号比较，字节值 0-255）
func s21_utf8_seq_len(s: i64, i: i64) -> i64 {
    var b = s21_str_byte(s, i)
    var t1 = s21_zext(gen_icmp_c(b, gen_int_lit(128), 6), types.named(TK_BOOL))
    var t2 = s21_zext(gen_icmp_c(b, gen_int_lit(224), 6), types.named(TK_BOOL))
    var t3 = s21_zext(gen_icmp_c(b, gen_int_lit(240), 6), types.named(TK_BOOL))
    var r = s21_bin(1, gen_int_lit(4), t1)  // sub
    var r2 = s21_bin(1, r, t2)
    return s21_bin(1, r2, t3)
}

// 解码字节 i 起的 UTF-8 码点（序列长度 l 由 utf8_seq_len 判定）。
// 分支结构：默认 cp=b0；l==2 → 2 字节公式；l==3 → 3 字节；否则 4 字节。
// 每分支独立 load 所需字节——l 保证不越界（短序列不读多余字节）。
func s21_utf8_char_at(s: i64, i: i64) -> i64 {
    var l = s21_utf8_seq_len(s, i)
    var b0 = s21_str_byte(s, i)
    // 结果槽（alloca 提升到 entry 由 llvmgen 统一处理）
    var slot = ir.new_inst(g_cur_block, 20, types.named(TK_I64))  // alloca i64
    ir.add_operand(slot, types.named(TK_I64), 2)
    var sv = ir.get_value(slot)
    s21_store(sv, b0, types.named(TK_I64))  // 默认 cp = b0（l==1）
    // 子块：l==2 处理 / l==3 判定 / l==3 处理 / l==4 处理 / 汇合
    var blk2 = ir.new_block(g_cur_func, interner.intern("s21.c2"))
    var blk3c = ir.new_block(g_cur_func, interner.intern("s21.c3c"))
    var blk3 = ir.new_block(g_cur_func, interner.intern("s21.c3"))
    var blk4 = ir.new_block(g_cur_func, interner.intern("s21.c4"))
    var merge = ir.new_block(g_cur_func, interner.intern("s21.cm"))
    // if l == 2 → blk2，else → blk3c
    var c2 = gen_cmp_const(l, 0, 2, types.named(TK_I64))  // eq 2
    var cb2 = ir.new_inst(g_cur_block, 31, -1)  // cond_br
    ir.add_operand(cb2, c2, 0)
    ir.add_operand(cb2, blk2, 1)
    ir.add_operand(cb2, blk3c, 1)
    // blk2：cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
    g_cur_block = blk2
    var bi1 = s21_bin(0, i, gen_int_lit(1))
    var b1 = s21_str_byte(s, bi1)
    var cp2 = s21_bin(7, s21_bin(10, s21_bin(6, b0, gen_int_lit(31)), gen_int_lit(6)), s21_bin(6, b1, gen_int_lit(63)))
    s21_store(sv, cp2, types.named(TK_I64))
    var br2 = ir.new_inst(g_cur_block, 30, -1)  // br merge
    ir.add_operand(br2, merge, 1)
    // blk3c：if l == 3 → blk3，else → blk4
    g_cur_block = blk3c
    var c3 = gen_cmp_const(l, 0, 3, types.named(TK_I64))  // eq 3
    var cb3 = ir.new_inst(g_cur_block, 31, -1)  // cond_br
    ir.add_operand(cb3, c3, 0)
    ir.add_operand(cb3, blk3, 1)
    ir.add_operand(cb3, blk4, 1)
    // blk3：cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
    // 注意：偏移指令在块内重新生成（SSA：不能跨互斥块引用 blk2 的指令值）
    g_cur_block = blk3
    var bi1b = s21_bin(0, i, gen_int_lit(1))
    var b1b = s21_str_byte(s, bi1b)
    var bi2 = s21_bin(0, i, gen_int_lit(2))
    var b2 = s21_str_byte(s, bi2)
    var t3a = s21_bin(10, s21_bin(6, b0, gen_int_lit(15)), gen_int_lit(12))
    var t3b = s21_bin(10, s21_bin(6, b1b, gen_int_lit(63)), gen_int_lit(6))
    var t3c = s21_bin(6, b2, gen_int_lit(63))
    var cp3 = s21_bin(7, s21_bin(7, t3a, t3b), t3c)
    s21_store(sv, cp3, types.named(TK_I64))
    var br3 = ir.new_inst(g_cur_block, 30, -1)  // br merge
    ir.add_operand(br3, merge, 1)
    // blk4：cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
    g_cur_block = blk4
    var bi1c = s21_bin(0, i, gen_int_lit(1))
    var b1c = s21_str_byte(s, bi1c)
    var bi2c = s21_bin(0, i, gen_int_lit(2))
    var b2c = s21_str_byte(s, bi2c)
    var bi3 = s21_bin(0, i, gen_int_lit(3))
    var b3 = s21_str_byte(s, bi3)
    var t4a = s21_bin(10, s21_bin(6, b0, gen_int_lit(7)), gen_int_lit(18))
    var t4b = s21_bin(10, s21_bin(6, b1c, gen_int_lit(63)), gen_int_lit(12))
    var t4c = s21_bin(10, s21_bin(6, b2c, gen_int_lit(63)), gen_int_lit(6))
    var t4d = s21_bin(6, b3, gen_int_lit(63))
    var cp4 = s21_bin(7, s21_bin(7, s21_bin(7, t4a, t4b), t4c), t4d)
    s21_store(sv, cp4, types.named(TK_I64))
    var br4 = ir.new_inst(g_cur_block, 30, -1)  // br merge
    ir.add_operand(br4, merge, 1)
    // merge：结果 = load 槽
    g_cur_block = merge
    return s21_load(sv, types.named(TK_I64))
}

// StringBuilder 句柄 = ptr → { i64 cap, i64 len, ptr data }（两级指针：
// data 重分配可移动，句柄地址稳定）。string_builder() 返回 ptrtoint 句柄。
func s21_sb_new() -> i64 {
    var h = gen_ext_call1("malloc", gen_int_lit(24), types.named(TK_I64), types.named(TK_STR))
    s21_store(s21_gep(h, 0, true), gen_int_lit(0), types.named(TK_I64))    // cap = 0
    s21_store(s21_gep(h, 8, true), gen_int_lit(0), types.named(TK_I64))    // len = 0
    s21_store(s21_gep(h, 16, true), gen_int_lit(0), types.named(TK_STR))   // data = null
    var pi = ir.new_inst(g_cur_block, 24, types.named(TK_I64))  // ptrtoint
    ir.add_operand(pi, h, 0)
    return ir.get_value(pi)
}

// 句柄 i64 → 真 ptr（inttoptr）
func s21_sb_ptr(hv: i64) -> i64 {
    var ip = ir.new_inst(g_cur_block, 25, types.named(TK_STR))  // inttoptr → ptr
    ir.add_operand(ip, hv, 0)
    return ir.get_value(ip)
}

// 若 need > cap：重新分配 data 缓冲（newcap = max(cap*2, need)），
// 拷贝旧数据（len>0 时）、释放旧缓冲、更新句柄 cap/data 字段。
// 生成 if 链后 g_cur_block 推进到汇合块（调用方继续生成追加逻辑）。
func s21_sb_grow(h: i64, cap: i64, len: i64, data: i64, need: i64) {
    var gc = gen_icmp_c(need, cap, 3)  // sgt
    var gt = ir.new_block(g_cur_func, interner.intern("s21.gt"))
    var ge = ir.new_block(g_cur_func, interner.intern("s21.ge"))
    var cb = ir.new_inst(g_cur_block, 31, -1)  // cond_br
    ir.add_operand(cb, gc, 0)
    ir.add_operand(cb, gt, 1)
    ir.add_operand(cb, ge, 1)
    // then：倍增容量（newcap = max(cap*2, need)）
    g_cur_block = gt
    var nc2 = s21_bin(2, cap, gen_int_lit(2))  // mul
    var c_lt = gen_icmp_c(nc2, need, 2)  // slt
    var newcap = gen_select_i(c_lt, need, nc2, types.named(TK_I64))
    var nd = gen_ext_call1("malloc", newcap, types.named(TK_I64), types.named(TK_STR))
    s21_memcpy_if(nd, data, len)
    gen_ext_call1("free", data, types.named(TK_STR), -1)
    s21_store(s21_gep(h, 16, true), nd, types.named(TK_STR))
    s21_store(s21_gep(h, 0, true), newcap, types.named(TK_I64))
    var brg = ir.new_inst(g_cur_block, 30, -1)  // br ge
    ir.add_operand(brg, ge, 1)
    g_cur_block = ge
}

// sb_append(h, s)：原地追加（读 s 长度头 O(1)；增长分支；memcpy 数据段）
func s21_sb_append(hv: i64, s: i64) {
    var h = s21_sb_ptr(hv)
    var cap = s21_load(s21_gep(h, 0, true), types.named(TK_I64))
    var len = s21_load(s21_gep(h, 8, true), types.named(TK_I64))
    var data = s21_load(s21_gep(h, 16, true), types.named(TK_STR))
    var slen = s21_str_head_len(s)
    var need = s21_bin(0, len, slen)
    s21_sb_grow(h, cap, len, data, need)
    // 汇合后重新读 data（增长分支可能已更新）
    var data2 = s21_load(s21_gep(h, 16, true), types.named(TK_STR))
    var dst = s21_gep(data2, len, false)
    s21_memcpy_if(dst, s, slen)
    s21_store(s21_gep(h, 8, true), need, types.named(TK_I64))
}

// sb_append_byte(h, b)：原地追加单字节（trunc i64 → i8；二进制安全含 \0）
func s21_sb_append_byte(hv: i64, b: i64) {
    var h = s21_sb_ptr(hv)
    var cap = s21_load(s21_gep(h, 0, true), types.named(TK_I64))
    var len = s21_load(s21_gep(h, 8, true), types.named(TK_I64))
    var data = s21_load(s21_gep(h, 16, true), types.named(TK_STR))
    var need = s21_bin(0, len, gen_int_lit(1))
    s21_sb_grow(h, cap, len, data, need)
    var data2 = s21_load(s21_gep(h, 16, true), types.named(TK_STR))
    var dst = s21_gep(data2, len, false)
    s21_store(dst, s21_trunc_i8(b), types.named(TK_I8))
    s21_store(s21_gep(h, 8, true), need, types.named(TK_I64))
}

// sb_build(h)：产出 {头, 数据, \0} 字符串（malloc len+9；写头；拷数据；尾 \0）。
// 句柄不释放（探针/短期程序进程退出回收；文档注明可复用）。
func s21_sb_build(hv: i64) -> i64 {
    var h = s21_sb_ptr(hv)
    var len = s21_load(s21_gep(h, 8, true), types.named(TK_I64))
    var data = s21_load(s21_gep(h, 16, true), types.named(TK_STR))
    var size = s21_bin(0, len, gen_int_lit(9))
    var buf = gen_ext_call1("malloc", size, types.named(TK_I64), types.named(TK_STR))
    s21_store(s21_gep(buf, 0, true), len, types.named(TK_I64))  // 长度头
    var d0 = s21_gep(buf, 8, true)  // 数据起始
    s21_memcpy_if(d0, data, len)
    s21_store(s21_gep(d0, len, false), gen_int_lit_ty(0, types.named(TK_I8)), types.named(TK_I8))  // 尾 \0
    return d0
}

// 便捷：双参数 void 桥
func gen_ext_call2v(sym: string, v1: i64, ty1: i64, v2: i64, ty2: i64) {
    var ats: table<i64> = table_new_i64()
    var avs: table<i64> = table_new_i64()
    table_push(ats, ty1)
    table_push(avs, v1)
    table_push(ats, ty2)
    table_push(avs, v2)
    gen_ext_call_typed(sym, ats, avs, -1)
}

// file_write/file_append：UTF-8 安全桥（tie_file_write / tie_file_append，
// Rust std::fs 覆盖写 / OpenOptions 追加写）。曾用 libc fopen("wb"/"ab") +
// fwrite——中文路径按 ANSI 代码页误读必失败。返回 bool（成功与否）。
func gen_file_write(p: i64, c: i64, append: bool) -> i64 {
    if append {
        return gen_bool_bridge2("tie_file_append", p, c)
    }
    return gen_bool_bridge2("tie_file_write", p, c)
}

// 便捷：四参数桥（返回非 void）
func gen_ext_call4(sym: string, v1: i64, ty1: i64, v2: i64, ty2: i64, v3: i64, ty3: i64, v4: i64, ty4: i64) -> i64 {
    var ats: table<i64> = table_new_i64()
    var avs: table<i64> = table_new_i64()
    table_push(ats, ty1)
    table_push(avs, v1)
    table_push(ats, ty2)
    table_push(avs, v2)
    table_push(ats, ty3)
    table_push(avs, v3)
    table_push(ats, ty4)
    table_push(avs, v4)
    return gen_ext_call_typed(sym, ats, avs, types.named(TK_I64))
}

// file_exists：UTF-8 安全桥（tie_file_exists，Rust std::fs File::open 探测）。
// 曾用 libc fopen(path, "rb")——Windows ANSI 代码页误读 UTF-8 中文路径，
// 中文目录/文件名的存在性检查必失败（tiec 编译中文路径源文件报"读取源码失败"）。
// 桥返回 i8 → icmp ne 0 → bool（对齐 Rust i8→i1 转换）。
func gen_file_exists(p: i64) -> i64 {
    return gen_bool_bridge1("tie_file_exists", p, types.named(TK_STR))
}

// 表下标读取 t[i]：动态表 → tie_table_at_<suffix>(表指针, i64, ok)。
// 简化（阶段 A）：不生成越界检查块（driver 树索引均有 len 守卫）。
func gen_index_read(id: i64) -> i64 {
    g_used_interp = true
    var base = sstate.child(id, 0)
    var idx = sstate.child(id, 1)
    var t = gen_expr(base)
    if t < 0 {
        return -1
    }
    var iv = gen_expr(idx)
    if iv < 0 {
        return -1
    }
    // E3 键值表读取：m[key] → tie_map_get / tie_map_get_string（键为字符串 ptr）。
    // base 类型是 map（作用域变量类型优先，其次 node_types）→ 走 map 桥，
    // 与 Rust 基线 ir.rs gen_index_assign 的 map 分支同构（tie_map_* 专用桥）。
    var base_is_map: bool = false
    var map_val_ty: i64 = types.named(TK_I64)
    if s_tags[base] == 6 {
        var bn_rd = interner.intern(sstate.name_str(base))
        if scope_get(bn_rd) >= 0 && types.is_map(g_lookup_ty) {
            base_is_map = true
            map_val_ty = types.low(g_lookup_ty)
        }
    }
    if !base_is_map {
        var bt_m = node_types[base]
        if types.is_map(bt_m) {
            base_is_map = true
            map_val_ty = types.low(bt_m)
        }
    }
    if base_is_map {
        // 裸 map（id == BASE_MAP，low 解码为 0）默认 i64 值；map<string> → string 桥
        if map_val_ty <= 0 {
            map_val_ty = types.named(TK_I64)
        }
        var bridge_get = "tie_map_get"
        var mret = types.named(TK_I64)
        if map_val_ty == types.named(TK_STR) {
            bridge_get = "tie_map_get_string"
            mret = types.named(TK_STR)
        }
        var mok = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
        ir.add_operand(mok, types.named(TK_I8), 2)
        var mats: table<i64> = table_new_i64()
        var mavs: table<i64> = table_new_i64()
        table_push(mats, types.named(TK_STR))
        table_push(mavs, t)
        table_push(mats, types.named(TK_STR))
        table_push(mavs, iv)
        table_push(mats, types.named(TK_STR))
        table_push(mavs, ir.get_value(mok))
        return gen_ext_call_typed(bridge_get, mats, mavs, mret)
    }
    // 元素类型：base 是表变量 → 优先 irgen 作用域完整类型（参数/局部表变量），
    // 其次 node_types（semantic 持久节点类型），最后 var_table_elem
    //（sinfer.lv_telem 每函数重置，irgen 阶段只能查到最后一个函数——不可靠）
    var elem: i64 = types.named(TK_I64)
    if s_tags[base] == 6 {
        var bname = interner.intern(sstate.name_str(base))
        var matched: bool = false
        // irgen 自维护表变量元素类型（table_new_f64() 变量；语义层 lv_telem
        // 已过期）——最高优先级，f64 表读取必须选 at_f64 桥
        var tv0 = tblvar_get(bname)
        if tv0 >= 0 {
            elem = tv0
            matched = true
        }
        if !matched && scope_get(bname) >= 0 && types.is_table(g_lookup_ty) {
            var le = types.table_elem(g_lookup_ty)
            if le > 0 {
                elem = le
                matched = true
            }
        }
        if !matched {
            var bt2 = node_types[base]
            if types.is_table(bt2) {
                var le2 = types.table_elem(bt2)
                if le2 > 0 {
                    elem = le2
                    matched = true
                }
            }
        }
        if !matched {
            var te = sinfer.var_table_elem(bname)
            if te >= 0 {
                elem = te
                matched = true
            }
        }
        if !matched {
            // 最后 fallback：索引表达式的语义推断类型（裸 table 元素未知时，
            // semantic 按上下文推断——join 里 parts[i] 用于拼接 → TK_STR）
            var nt = node_types[id]
            if nt >= 0 && (nt == types.named(TK_STR) || types.is_int(nt) ||
                types.is_float(nt) || types.is_bool_like(nt)) {
                elem = nt
            }
        }
    } else {
        var bt = node_types[base]
        if types.is_table(bt) {
            var te2 = types.table_elem(bt)
            if te2 > 0 {
                elem = te2
            }
        }
    }
    var suffix = bridge_suffix(elem)
    var ret_ty = types.named(TK_I64)
    // 嵌套表元素（elem 是 table/map）：元素在动态表中存 ptr，读回必须用
    // at_string 桥（返回 ptr）——曾按 bridge_suffix 落 at_i64，返回 i64 与
    // 嵌套表变量的 ptr 槽不符（`var sub = t[i]` → `store ptr %r, ptr %slot`
    // 但 %r 是 i64，LLVM 拒收）。对齐 gen_table_lit 的按值类型选桥。
    // S2.4：port 对象元素（table<Drawable>）同样存 ptr，走 string 桥；但
    // 返回类型标为 K_PORT 本身（= ptr）而非 TK_STR——S2.1 补头逻辑按
    // ins_ty==TK_STR 判补头，port 对象 ptr 被误补头（strlen 扫描打包对象
    // {data,vtable} → 崩溃）。嵌套表/映射句柄同理（elem 类型本身 = ptr，
    // 不补头——补头只服务于真字符串元素）。
    if types.is_table(elem) || types.is_map(elem) || types.kind(elem) == K_PORT {
        suffix = "string"
        ret_ty = elem
    } else if suffix == "string" {
        ret_ty = types.named(TK_STR)
    } else if suffix == "f64" {
        // f64 表元素：返回类型 double（曾落默认 i64 → call i64 @tie_table_at_f64
        // 与 declare double 返回不匹配）
        ret_ty = types.named(TK_F64)
    } else if suffix == "bool" {
        ret_ty = types.named(TK_BOOL)
    }
    // ok 出参槽（越界标志；阶段 A 简化不检查，传哑槽）
    var ok_slot = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
    ir.add_operand(ok_slot, types.named(TK_I8), 2)
    var ok_addr = ir.get_value(ok_slot)
    var ats: table<i64> = table_new_i64()
    var avs: table<i64> = table_new_i64()
    table_push(ats, types.named(TK_STR))
    table_push(avs, t)
    table_push(ats, types.named(TK_I64))
    table_push(avs, iv)
    table_push(ats, types.named(TK_STR))
    table_push(avs, ok_addr)
    return gen_ext_call_typed("tie_table_at_" + suffix, ats, avs, ret_ty)
}

// 表下标赋值 t[i] = v → tie_table_set_<suffix> 桥（void）。
// AST：IndexAssign[val=op, children=[目标(Index), 值]]。
func gen_index_assign(id: i64) -> i64 {
    g_used_interp = true
    var target = sstate.child(id, 0)
    var val = sstate.child(id, 1)
    var op = s_vals[id]  // 复合赋值码（-1 普通；0..17，对齐 B_*）
    // 目标必须是 Index：children=[base, index]
    var base = sstate.child(target, 0)
    var idx = sstate.child(target, 1)
    var t = gen_expr(base)
    if t < 0 {
        return -1
    }
    var iv = gen_expr(idx)
    if iv < 0 {
        return -1
    }
    // E3 键值表赋值：m[key] = v → tie_map_set / tie_map_set_string（键为字符串 ptr）。
    // base 类型是 map（作用域变量类型优先，其次 node_types）→ 走 map 桥，
    // 与 Rust 基线 ir.rs gen_index_assign 的 map 分支同构（含复合赋值读写回写）。
    var base_is_map: bool = false
    var map_val_ty: i64 = types.named(TK_I64)
    if s_tags[base] == 6 {
        var bn_as = interner.intern(sstate.name_str(base))
        if scope_get(bn_as) >= 0 && types.is_map(g_lookup_ty) {
            base_is_map = true
            map_val_ty = types.low(g_lookup_ty)
        }
    }
    if !base_is_map {
        var bt_m2 = node_types[base]
        if types.is_map(bt_m2) {
            base_is_map = true
            map_val_ty = types.low(bt_m2)
        }
    }
    if base_is_map {
        // 裸 map（low 解码为 0）默认 i64 值；map<string> → string 桥
        if map_val_ty <= 0 {
            map_val_ty = types.named(TK_I64)
        }
        var is_str_m = map_val_ty == types.named(TK_STR)
        var bridge_set = "tie_map_set"
        var bridge_get = "tie_map_get"
        var pty_m = types.named(TK_I64)
        if is_str_m {
            bridge_set = "tie_map_set_string"
            bridge_get = "tie_map_get_string"
            pty_m = types.named(TK_STR)
        }
        // 复合赋值（m[k] += v）：先读旧值（tie_map_get 带 ok）→ 运算 → 写回
        var v_m: i64 = -1
        if op >= 0 {
            var r_ok = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
            ir.add_operand(r_ok, types.named(TK_I8), 2)
            var rats: table<i64> = table_new_i64()
            var ravs: table<i64> = table_new_i64()
            table_push(rats, types.named(TK_STR))
            table_push(ravs, t)
            table_push(rats, types.named(TK_STR))
            table_push(ravs, iv)
            table_push(rats, types.named(TK_STR))
            table_push(ravs, ir.get_value(r_ok))
            var old_m = gen_ext_call_typed(bridge_get, rats, ravs, pty_m)
            if old_m < 0 {
                return -1
            }
            var rv_m = gen_expr(val)
            if rv_m < 0 {
                return -1
            }
            v_m = gen_compound_assign(op, old_m, rv_m, pty_m)
            if v_m < 0 {
                sm_err_msg = "下标复合赋值运算失败（函数 " + g_cur_fn_name + "）"
                return -1
            }
        } else {
            v_m = gen_expr(val)
            if v_m < 0 {
                return -1
            }
        }
        var w_ok = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
        ir.add_operand(w_ok, types.named(TK_I8), 2)
        var ats_m: table<i64> = table_new_i64()
        var avs_m: table<i64> = table_new_i64()
        table_push(ats_m, types.named(TK_STR))
        table_push(avs_m, t)
        table_push(ats_m, types.named(TK_STR))
        table_push(avs_m, iv)
        table_push(ats_m, pty_m)
        table_push(avs_m, v_m)
        table_push(ats_m, types.named(TK_STR))
        table_push(avs_m, ir.get_value(w_ok))
        gen_ext_call_typed(bridge_set, ats_m, avs_m, -1)
        return 0
    }
    // 元素类型：对齐 gen_index_read 的完整推断链（tblvar_get → 作用域类型 →
    // node_types → sinfer → 索引表达式类型 fallback）。曾为简化版只查 sinfer 与
    // node_types，导致 table<string> 等变量（存 string）元素类型推断为 i64，
    // 生成 tie_table_set_i64 传 string 值 → opt 类型错（pkg 编译失败根因）。
    var elem: i64 = types.named(TK_I64)
    if s_tags[base] == 6 {
        var bname = interner.intern(sstate.name_str(base))
        var matched: bool = false
        // irgen 自维护表变量元素类型（table_new_f64() 变量；语义层 lv_telem 已过期）
        var tv0 = tblvar_get(bname)
        if tv0 >= 0 {
            elem = tv0
            matched = true
        }
        if !matched && scope_get(bname) >= 0 && types.is_table(g_lookup_ty) {
            var le = types.table_elem(g_lookup_ty)
            if le > 0 {
                elem = le
                matched = true
            }
        }
        if !matched {
            var bt2 = node_types[base]
            if types.is_table(bt2) {
                var le2 = types.table_elem(bt2)
                if le2 > 0 {
                    elem = le2
                    matched = true
                }
            }
        }
        if !matched {
            var te = sinfer.var_table_elem(bname)
            if te >= 0 {
                elem = te
                matched = true
            }
        }
        if !matched {
            // 最后 fallback：索引表达式节点的语义推断类型（裸 table 元素未知时）
            var nt = node_types[id]
            if nt >= 0 && (nt == types.named(TK_STR) || types.is_int(nt) ||
                types.is_float(nt) || types.is_bool_like(nt)) {
                elem = nt
            }
        }
    } else {
        var bt = node_types[base]
        if types.is_table(bt) {
            var te2 = types.table_elem(bt)
            if te2 > 0 {
                elem = te2
            }
        }
    }
    var suffix = bridge_suffix(elem)
    var pty = types.named(TK_I64)
    // S2.4：port 对象元素（table<Drawable>）存 ptr → set_string 桥
    if types.kind(elem) == K_PORT {
        suffix = "string"
        pty = types.named(TK_STR)
    } else if suffix == "string" {
        pty = types.named(TK_STR)
    } else if suffix == "f64" {
        // f64 表元素：set 桥值参数 double（曾落默认 i64 →
        // tie_table_set_f64(..., i64 %double) 类型错）
        pty = types.named(TK_F64)
    } else if suffix == "bool" {
        pty = types.named(TK_BOOL)
    }
    // 复合赋值（t[i] += v）：先读旧值（tie_table_at 带 ok）→ 运算 → 写回
    var v: i64 = -1
    if op >= 0 {
        var ats_r: table<i64> = table_new_i64()
        var avs_r: table<i64> = table_new_i64()
        table_push(ats_r, types.named(TK_STR))
        table_push(avs_r, t)
        table_push(ats_r, types.named(TK_I64))
        table_push(avs_r, iv)
        var ok_r = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
        ir.add_operand(ok_r, types.named(TK_I8), 2)
        table_push(ats_r, types.named(TK_STR))
        table_push(avs_r, ir.get_value(ok_r))
        var old = gen_ext_call_typed("tie_table_at_" + suffix, ats_r, avs_r, pty)
        if old < 0 {
            return -1
        }
        var rv = gen_expr(val)
        if rv < 0 {
            return -1
        }
        v = gen_compound_assign(op, old, rv, pty)
        if v < 0 {
            sm_err_msg = "下标复合赋值运算失败（函数 " + g_cur_fn_name + "）"
            return -1
        }
    } else {
        v = gen_expr(val)
        if v < 0 {
            return -1
        }
    }
    var ats: table<i64> = table_new_i64()
    var avs: table<i64> = table_new_i64()
    table_push(ats, types.named(TK_STR))
    table_push(avs, t)
    table_push(ats, types.named(TK_I64))
    table_push(avs, iv)
    table_push(ats, pty)
    table_push(avs, v)
    // ok 标志槽（越界标志）：Rust 桥签名 (ptr, i64, val, ptr ok)，
    // 缺此参数会导致 ABI 错位、运行时写垃圾指针崩溃（0xC0000005）
    var set_ok = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
    ir.add_operand(set_ok, types.named(TK_I8), 2)
    table_push(ats, types.named(TK_STR))
    table_push(avs, ir.get_value(set_ok))
    gen_ext_call_typed("tie_table_set_" + suffix, ats, avs, -1)
    return 0
}

// Switch：driver 树仅字符串 subject（typekw_index）。逐 case strcmp 比较链：
//   cmp = strcmp(subj, case_val)；命中 → body；否则下一 case / default。
// AST：Switch[aux=ncases, children=[subject]+cases...+[default]]；
//   SwitchCase[children=[PatternList, when 或 -1, body]]。
func gen_switch(id: i64) -> i64 {
    var subject = sstate.child(id, 0)
    var sv = gen_expr(subject)
    if sv < 0 {
        return -1
    }
    // subject 类型分派：字符串 → strcmp 比较链；整数/char → icmp 比较链；
    // 枚举 → 提取 tag（槽 0）后与 case 的 tag 常量 icmp 比较
    var subj_is_str = node_types[subject] == types.named(TK_STR)
    var subj_ty = node_types[subject]
    var subj_is_enum = types.kind(subj_ty) == K_ENUM
    var enum_tag_v: i64 = -1
    if subj_is_enum {
        // 枚举 subject：gen_agg_addr(subject) → agg_gep 下标 0 → load i64（tag）
        var eaddr = gen_agg_addr(subject, subj_ty)
        if eaddr < 0 {
            return -1
        }
        var egp = ir.new_inst(g_cur_block, 27, subj_ty)
        ir.add_operand(egp, eaddr, 0)
        ir.add_operand(egp, 0, 2)
        var egpp = ir.get_value(egp)
        var eld = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(eld, egpp, 0)
        enum_tag_v = ir.get_value(eld)
    }
    var ncases = s_aux[id]
    var exit_blk = ir.new_block(g_cur_func, interner.intern("sw.exit"))
    // 逐个 case：PatternList 多模式（任一命中 → body；含 Range 范围模式）
    var k: i64 = 0
    while k < ncases {
        var case_node = sstate.child(id, 1 + k)
        var pl = sstate.child(case_node, 0)
        var body = sstate.child(case_node, 2)
        var body_blk = ir.new_block(g_cur_func, interner.intern("sw.body"))
        var next_blk = ir.new_block(g_cur_func, interner.intern("sw.next"))
        var npat = sstate.nchild(pl)
        // 逐个模式比较链：eq → body；ne → 下一模式块
        var i: i64 = 0
        while i < npat {
            var pat = sstate.child(pl, i)
            var eq_v: i64 = -1
            if subj_is_enum {
                // 枚举 case：模式 = FieldAccess(Enum.Variant) → 解析为 tag 常量，
                // 与提取出的 subject tag icmp eq（scheck 已校验变体合法）。
                // 不可用 gen_expr(pat)——FieldAccess 枚举分支会构造聚合值。
                var ptag = enum_case_tag(pat, subj_ty)
                if ptag < 0 {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "case 值不是枚举 '" + types.type_name(subj_ty) + "' 的变体引用（函数 " + g_cur_fn_name + "）"
                    return -1
                }
                var pv2 = gen_int_lit_ty(ptag, types.named(TK_I64))
                var is_eq2 = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
                ir.add_operand(is_eq2, enum_tag_v, 0)
                ir.add_operand(is_eq2, pv2, 0)
                ir.add_operand(is_eq2, 0, 2)  // eq
                eq_v = ir.get_value(is_eq2)
            } else if s_tags[pat] == 11 {
                // Range 模式（case 3..7 → sv >= 3 && sv < 7）
                var rs = gen_expr(sstate.child(pat, 0))
                if rs < 0 {
                    return -1
                }
                var re = gen_expr(sstate.child(pat, 1))
                if re < 0 {
                    return -1
                }
                var ge = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp sge
                ir.add_operand(ge, sv, 0)
                ir.add_operand(ge, rs, 0)
                ir.add_operand(ge, 5, 2)  // sge
                var ge_v = ir.get_value(ge)
                var lt = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp slt
                ir.add_operand(lt, sv, 0)
                ir.add_operand(lt, re, 0)
                ir.add_operand(lt, 2, 2)  // slt
                var lt_v = ir.get_value(lt)
                var and = ir.new_inst(g_cur_block, 6, types.named(TK_BOOL))  // and i1
                ir.add_operand(and, ge_v, 0)
                ir.add_operand(and, lt_v, 0)
                eq_v = ir.get_value(and)
            } else {
                var pv = gen_expr(pat)
                if pv < 0 {
                    return -1
                }
                if subj_is_str {
                    // 字符串比较：strcmp(sv, pv) == 0
                    var cmp = gen_ext_call2("strcmp", sv, types.named(TK_STR), pv, types.named(TK_STR), types.named(TK_I32))
                    if cmp < 0 {
                        return -1
                    }
                    var is_eq = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
                    ir.add_operand(is_eq, cmp, 0)
                    ir.add_operand(is_eq, 0, 2)
                    ir.add_operand(is_eq, 0, 2)  // eq
                    eq_v = ir.get_value(is_eq)
                } else {
                    // 整数/char 比较：icmp eq（值可能为 i64 整数或 i32 char——
                    // 以 sv 定义类型为准，llvmgen icmp 按 lhs 定义类型选宽度）
                    var is_eq = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
                    ir.add_operand(is_eq, sv, 0)
                    ir.add_operand(is_eq, pv, 0)
                    ir.add_operand(is_eq, 0, 2)  // eq
                    eq_v = ir.get_value(is_eq)
                }
            }
            var np_blk = ir.new_block(g_cur_func, interner.intern("sw.np"))
            var cb = ir.new_inst(g_cur_block, 31, -1)
            ir.add_operand(cb, eq_v, 0)
            ir.add_operand(cb, body_blk, 1)
            ir.add_operand(cb, np_blk, 1)
            g_cur_block = np_blk
            i = i + 1
        }
        // 所有模式未命中 → next case
        if !block_terminated() {
            var bnx = ir.new_inst(g_cur_block, 30, -1)  // br next
            ir.add_operand(bnx, next_blk, 1)
        }
        // body 块
        g_cur_block = body_blk
        var bb = gen_block_stmts(body)
        if bb < 0 {
            return -1
        }
        if !block_terminated() {
            var br1 = ir.new_inst(g_cur_block, 30, -1)  // br exit
            ir.add_operand(br1, exit_blk, 1)
        }
        // next 块
        g_cur_block = next_blk
        k = k + 1
    }
    // default 体（最后一个 child）
    var default_list = sstate.child(id, 1 + ncases)
    if default_list >= 0 && sstate.nchild(default_list) > 0 {
        var db = gen_block_stmts(default_list)
        if db < 0 {
            return -1
        }
    }
    if !block_terminated() {
        var br2 = ir.new_inst(g_cur_block, 30, -1)  // br exit
        ir.add_operand(br2, exit_blk, 1)
    }
    g_cur_block = exit_blk
    return 0
}

// println/print 生成：printf 调用（格式串 + 参数）
// 最小集：空 → "\n"；字符串 → "%s\n" + ptr；整数 → "%lld\n" + i64
// 格式串用真实文本（tie 字符串中 % 原样、\n 为换行），llvmgen 端转义为 c"...\00"
func gen_println(id: i64, newline: bool) -> i64 {
    // Call children = [泛型槽, 实参...]：`println()` 槽占位 → 实参数 = nchild-1
    var nc = sstate.nchild(id) - sstate.slot_off(id)
    var nl = "\n"
    if !newline {
        nl = ""
    }
    if nc == 0 {
        // 空 println → 换行
        var fmt = interner.intern(nl)
        // call_vararg（printf）结果：llvmgen 生成 `%N = call i32 (ptr, ...)`——
        // 必须有结果寄存器，ty 用 i32（TK_I32）
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)  // OK_VALUE 格式串池 id
        return ir.get_value(inst)
    }
    // 实参 = children[slot_off]（children[0] 是泛型槽）
    var arg = sstate.child(id, sstate.slot_off(id))
    var atag = s_tags[arg]
    if atag == 2 {
        // 字符串参数：格式 "%s\n" + 字符串指针
        var sval = gen_str_lit(s_names[arg])
        var fmt = interner.intern("%s" + nl)
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)
        ir.add_operand(inst, sval, 0)
        return ir.get_value(inst)
    }
    if atag == 6 && scope_get(s_names[arg]) >= 0 && g_lookup_ty == types.named(TK_STR) {
        // T4.5：字符串类型变量（如 `var p: string = get_env("PATH")`）→ "%s\n" + ptr
        var sval = gen_var_ref(s_names[arg])
        if sval < 0 {
            return -1
        }
        var fmt = interner.intern("%s" + nl)
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)
        ir.add_operand(inst, sval, 0)
        return ir.get_value(inst)
    }
    // 字符串表达式（str_cat 拼接 / 返回 string 的调用等）：node_types 推断为
    // TK_STR → "%s\n" + ptr。曾漏此分支：拼接结果走 %lld 打印指针值（乱码）
    if node_types[arg] == types.named(TK_STR) {
        var sval2 = gen_expr(arg)
        if sval2 < 0 {
            return -1
        }
        var fmt2 = interner.intern("%s" + nl)
        var inst2 = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst2, fmt2, 0)
        ir.add_operand(inst2, sval2, 0)
        return ir.get_value(inst2)
    }
    // 浮点参数（f64/f32）：格式 "%f"（printf 变参要求 double，f32 需 fpext 提升——
    // 语义层 f32 场景罕见，按 f64 处理；f32 值经 fpext 指令提升）
    // num 宽类型变量（语义 node_types=TK_NUM）按槽类型补判——`var b: num = 3.14`
    // 归约后槽是 f64，node_types 仍是 TK_NUM（曾误走 %lld 打印指针值）
    var f_is_f = node_types[arg] == types.named(TK_F64) || node_types[arg] == types.named(TK_F32)
    if !f_is_f && node_types[arg] == types.named(TK_NUM) && s_tags[arg] == 6 {
        var fnid = interner.intern(sstate.name_str(arg))
        if scope_get(fnid) >= 0 && types.is_float(g_lookup_ty) {
            f_is_f = true
        }
    }
    if f_is_f {
        var fv = gen_expr(arg)
        if fv < 0 {
            return -1
        }
        var fref: i64 = fv
        if node_types[arg] == types.named(TK_F32) {
            // f32 → f64 提升（printf 变参提升规则；fpext 无专用 opcode，
            // 用 fsub 0.0 保留值不可行——f32 值作为 f64 操作数需转换指令。
            // 简化：tie 语义层 f32 推断均落 f64，防御性按 double 直传）
        }
        var fmt = interner.intern("%f" + nl)
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)
        ir.add_operand(inst, fref, 0)
        return ir.get_value(inst)
    }
    // 字符参数（char）：格式 "%c"（i32 值，直传）
    if node_types[arg] == types.named(TK_CHAR) {
        var cv = gen_expr(arg)
        if cv < 0 {
            return -1
        }
        var fmt = interner.intern("%c" + nl)
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)
        ir.add_operand(inst, cv, 0)
        return ir.get_value(inst)
    }
    // trit 参数：格式 "%d"（i8 → sext i32，printf 变参提升；对齐 Rust i8/i16 分支）
    if node_types[arg] == types.named(TK_TRIT) {
        var tv = gen_expr(arg)
        if tv < 0 {
            return -1
        }
        var sext = ir.new_inst(g_cur_block, 19, types.named(TK_I32))  // sext i8→i32
        ir.add_operand(sext, types.named(TK_I8), 2)
        ir.add_operand(sext, tv, 0)
        var sv = ir.get_value(sext)
        var fmt = interner.intern("%d" + nl)
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)
        ir.add_operand(inst, sv, 0)
        return ir.get_value(inst)
    }
    // 整数参数（i64）：格式 "%lld\n"
    var av = gen_expr(arg)
    if av < 0 {
        return -1
    }
    var fmt = interner.intern("%lld" + nl)
    var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
    ir.add_operand(inst, fmt, 0)
    ir.add_operand(inst, av, 0)
    return ir.get_value(inst)
}

// 语句生成：0 成功 / -1 错误
func gen_stmt(id: i64) -> i64 {
    var tag = s_tags[id]
    if tag == 100 {
        // VarDecl：children=[ty 或 -1, init]
        var nm = s_names[id]
        var ty_node = sstate.child(id, 0)
        var init = sstate.child(id, 1)
        var ty: i64 = types.named(3)  // 默认 i64
        if ty_node >= 0 {
            ty = sgen.parse_generic_type_node(ty_node)
            if ty < 0 {
                return -1
            }
            // 宽类型归约：num/text/misc 是宽类型框（对齐 Rust 语义层展开），
            // llvm_ty 无映射（兜底 ptr）——按 init 的实际推断类型定槽型：
            //   num + 整数 → i64；num + 浮点 → f64；text + 字符串 → ptr；
            //   misc + bool → i1
            if init >= 0 && (ty == types.named(TK_NUM) || ty == types.named(TK_TEXT) ||
                ty == types.named(TK_MISC)) {
                var wt = node_types[init]
                if wt >= 0 {
                    ty = wt
                }
            }
        } else if init >= 0 {
            // 无类型标注：按初始化表达式的推断类型定槽型。
            // 表/映射/字符串 → TK_STR（ptr 槽：表指针 / 字符串指针统一 ptr，
            // 与 llvmgen store 的 to_ptr 转换配套）；bool → TK_BOOL（i1 槽，
            // icmp 结果是 i1——曾默认 i64 槽导致 store i64 %i1 类型错）；
            // 元组/struct → 聚合类型 id（alloca {..} 聚合槽）；
            // 其余默认 i64。
            var it = node_types[init]
            if it >= 0 && (types.is_table(it) || types.is_map(it) || it == types.named(TK_STR)) {
                ty = types.named(TK_STR)
            } else if it == types.named(TK_TRIT) {
                // trit：i8 槽（compare() 返回 trit 变量——曾落入 is_bool_like
                // 判为 i1 槽，store i8 %i1 类型错）
                ty = types.named(TK_TRIT)
            } else if it >= 0 && types.is_bool_like(it) {
                ty = types.named(TK_BOOL)
            } else if it >= 0 && types.is_float(it) {
                // 浮点推断（f64/f32）：mean(...) 返回 f64 → alloca double 槽
                //（曾落默认 i64 → store i64 %double 类型错）
                ty = it
            } else if it >= 0 && types.is_int(it) {
                // S1.3 窄整数推断（后缀字面量 `var a = 42i32`）：窄槽
                //（语义类型 i32 与槽型须一致，否则 load i64 被按 i32 sext 类型错）
                ty = it
            } else if it >= 0 && types.is_unsafe_ty(it) {
                // S1.2：指针/切片/原子类型推断（`var p = addr_of(x)`）→
                // 对应槽（alloca ptr / alloca {ptr,i64} / alloca 元素型）
                ty = it
            } else if it >= 0 && (types.kind(it) == K_TUPLE || types.kind(it) == K_STRUCT || types.kind(it) == K_ENUM || types.kind(it) == K_FN || types.kind(it) == K_PORT) {
                // 聚合变量：alloca 聚合槽，init（构造调用/元组字面量/返回）求聚合值
                // （K_ENUM 2026-08-15：枚举变量同 struct——alloca %enum.X 槽，
                // init 的 FieldAccess/MethodCall 构造求聚合值，store 类型匹配；
                // K_FN S2.2：闭包字面量/函数值参数 → alloca %fn.X 槽；
                // K_PORT S2.4：port 对象（ptr 表示）→ alloca ptr 槽）
                ty = it
            }
        }
        // alloca + store
        var alloca = ir.new_inst(g_cur_block, 20, ty)  // alloca
        ir.add_operand(alloca, ty, 2)  // 类型立即数（占位）
        var av = ir.get_value(alloca)
        if init >= 0 {
            // S2.4：port 对象变量初始化——提升（struct → port 打包）或
            // port 拷贝（ptr 复制）。见 gen_port_coerce 注释。
            if types.kind(ty) == K_PORT {
                var it4 = node_types[init]
                var pv: i64 = -1
                if it4 >= 0 && types.kind(it4) == K_STRUCT {
                    pv = gen_port_coerce(init, ty)
                } else {
                    pv = gen_expr(init)
                }
                if pv < 0 {
                    return -1
                }
                var store = ir.new_inst(g_cur_block, 22, -1)  // store
                ir.add_operand(store, ty, 2)
                ir.add_operand(store, pv, 0)
                ir.add_operand(store, av, 0)
                scope_put(nm, av, ty)
                return 0
            }
            // DEBUG 临时
            // IntLit 初始化：按声明类型生成常量（i32 变量存 i32 值，否则
            // llvmgen 的 store i32 %N 会因 %N 是 i64 const_i 而类型不匹配）；
            // 其余表达式走 gen_expr（结果恒 i64，与 llvmgen store 的 vty 匹配
            // 需初始化类型为 i64——非 i64 初始化目前仅支持整数常量）。
            var iv: i64 = -1
            if s_tags[init] == 4 && ty == types.named(TK_TRIT) {
                // BoolLit 适配 trit（语义层 node_types 仍标 TK_BOOL，但标注类型
                // trit 需生成 i8 值：true→1 / false→-1——否则 store i8 %i1 类型错）
                var tv: i64 = -1
                if s_vals[init] == 1 {
                    tv = 1
                }
                iv = gen_trit_lit(tv)
            } else if s_tags[init] == 1 && ty == types.named(TK_F32) {
                // FloatLit 适配 f32 声明：按 f32 生成常量（S1.3，默认 f64）
                iv = gen_float_lit_ty(s_names[init], types.named(TK_F32))
            } else if s_tags[init] == 0 {
                iv = gen_int_lit_ty(s_vals[init], ty)
            } else if s_tags[init] == 14 && types.kind(ty) == K_TUPLE {
                // 元组字面量 + 元组类型标注：按目标类型构造（(i32,i64) 标注 +
                // (7,8) 字面量——语义层推断字面量为 (i64,i64)，不按目标类型
                // 构造会 store {i64,i64} 到 {i32,i64} 槽，LLVM 类型不匹配）
                iv = gen_tuple_lit_typed(init, ty)
            } else {
                iv = gen_expr(init)
                // S1.3 C2：表达式类型 ≠ 声明类型（数字族）→ 转换。
                // IntLit/FloatLit 已按类型生成（gen_int_lit_ty / 浮点常量），
                // 变量/运算结果按语义层拓宽规则转换（i16 变量 → i64 声明）。
                if iv >= 0 {
                    var it3 = node_types[init]
                    if it3 >= 0 && (types.is_int(it3) || types.is_float(it3)) &&
                        (types.is_int(ty) || types.is_float(ty)) && it3 != ty {
                        var cv2 = gen_coerce(iv, it3, ty)
                        if cv2 < 0 {
                            return -1
                        }
                        iv = cv2
                    }
                }
            }
            if iv < 0 {
                return -1
            }
            var store = ir.new_inst(g_cur_block, 22, -1)  // store
            ir.add_operand(store, ty, 2)
            ir.add_operand(store, iv, 0)
            ir.add_operand(store, av, 0)
        }
        scope_put(nm, av, ty)
        // 表变量元素类型登记（table_push/table_at 选桥用）：
        // init 是 table<T>（含 table_new_* 调用）→ 记录元素类型。语义层
        // var_table_elem 已过期（per-function），table_new_f64() 返回裸 table
        // 无法从 node_types 得知元素类型。
        if init >= 0 {
            var tv_te: i64 = -1
            var it2 = node_types[init]
            if types.is_table(it2) && types.table_elem(it2) > 0 {
                tv_te = types.table_elem(it2)
            } else if s_tags[init] == 7 {
                var init_nm = sstate.name_str(init)
                if init_nm == "table_new_f64" {
                    tv_te = types.named(TK_F64)
                } else if init_nm == "table_new_string" {
                    tv_te = types.named(TK_STR)
                } else if init_nm == "table_new_bool" {
                    tv_te = types.named(TK_BOOL)
                } else if init_nm == "table_new_i64" {
                    tv_te = types.named(TK_I64)
                }
            }
            if tv_te >= 0 {
                // 键统一用 interner.intern（s_names[id] 是 parser 的 intern 池，
                // 与 table_push 的 interner.intern(tname) 不同池，id 不可比）
                tblvar_put(interner.intern(sstate.name_str(id)), tv_te)

            }
        }
        return 0
    }
    if tag == 102 {
        // ExprStmt
        var e = sstate.child(id, 0)
        return gen_expr(e)
    }
    if tag == 130 {
        // S1.2 U3 unsafe 块：语义层已校验块内操作合法（unsafe 上下文），
        // irgen 只遍历子 StmtList 生成（无额外安全检查）
        var blk = sstate.child(id, 0)
        if blk < 0 {
            return 0
        }
        var n = sstate.nchild(blk)
        var i: i64 = 0
        while i < n {
            var r = gen_stmt(sstate.child(blk, i))
            if r < 0 {
                return -1
            }
            i = i + 1
        }
        return 0
    }
    if tag == 104 {
        // Return：children=[expr 或 -1]。ret 类型 = 表达式语义类型（i64/f64/
        // 聚合/字符串 ptr——曾硬编码 i64，元组/浮点返回会类型不匹配）。
        // BoolLit 适配 trit：返回 trit 的函数里 `return false/true` → i8
        var v = sstate.child(id, 0)
        if v >= 0 {
            var rv: i64 = -1
            if s_tags[v] == 4 && g_cur_ret_ty == types.named(TK_TRIT) {
                var tv: i64 = -1
                if s_vals[v] == 1 {
                    tv = 1
                }
                rv = gen_trit_lit(tv)
            } else {
                rv = gen_expr(v)
            }
            if rv < 0 {
                return -1
            }
            var rty = node_types[v]
            if rty < 0 {
                rty = types.named(TK_I64)
            }
            // S1.3 C2：返回值类型 ≠ 函数返回类型（数字族）→ 转换
            // （窄返回类型函数：`return i64 表达式` → trunc 到返回宽度）
            if g_cur_ret_ty >= 0 && (types.is_int(rty) || types.is_float(rty)) &&
                (types.is_int(g_cur_ret_ty) || types.is_float(g_cur_ret_ty)) &&
                rty != g_cur_ret_ty {
                var cr = gen_coerce(rv, rty, g_cur_ret_ty)
                if cr < 0 {
                    return -1
                }
                rv = cr
                rty = g_cur_ret_ty
            }
            var ret = ir.new_inst(g_cur_block, 32, rty)  // ret
            ir.add_operand(ret, rv, 0)
        } else {
            // void 无值 return：main 特判 ret i32 0（CRT 退出码正确性，对齐 Rust 侧
            // gen_stmt 的 void main return 处理——define i32 @main 与 ret void 不匹配）；
            // 其余 void 函数 ret void。
            if g_cur_fn_name == "main" {
                var ret = ir.new_inst(g_cur_block, 32, types.named(TK_I32))  // ret i32 0
                ir.add_operand(ret, 0, 2)
            } else {
                var ret = ir.new_inst(g_cur_block, 32, -1)  // ret void
            }
        }
        return 0
    }
    if tag == 105 {
        // If：children=[cond, then, else]
        var cond = gen_expr(sstate.child(id, 0))
        if cond < 0 {
            return -1
        }
        var then_blk = ir.new_block(g_cur_func, interner.intern("if.then"))
        var else_blk = ir.new_block(g_cur_func, interner.intern("if.else"))
        var merge_blk = ir.new_block(g_cur_func, interner.intern("if.merge"))
        // cond_br：条件 + then + else
        var cbr = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbr, cond, 0)
        ir.add_operand(cbr, then_blk, 1)
        ir.add_operand(cbr, else_blk, 1)
        // then 分支
        g_cur_block = then_blk
        var then_list = sstate.child(id, 1)
        var t = gen_block_stmts(then_list)
        if t < 0 {
            return -1
        }
        if !block_terminated() {
            var br1 = ir.new_inst(g_cur_block, 30, -1)  // br merge
            ir.add_operand(br1, merge_blk, 1)
        }
        // else 分支
        g_cur_block = else_blk
        var else_list = sstate.child(id, 2)
        if else_list >= 0 {
            var e = gen_block_stmts(else_list)
            if e < 0 {
                return -1
            }
        }
        if !block_terminated() {
            var br2 = ir.new_inst(g_cur_block, 30, -1)
            ir.add_operand(br2, merge_blk, 1)
        }
        // merge
        g_cur_block = merge_blk
        return 0
    }
    if tag == 107 {
        // For：name=迭代变量, children=[iter, body]
        // 范围 0..N 最小集；表遍历 `for item in arr`（iter 为 Var 表变量）
        var iter = sstate.child(id, 0)
        var body = sstate.child(id, 1)
        var iter_tag = s_tags[iter]
        if iter_tag != 11 {
            // for-in 表迭代（动态表）：计数器 0..len(t) + tie_table_at 读取
            var fr = gen_for_table(id, iter, body)
            if fr < 0 {
                return -1
            }
            return 0
        }
        var start = gen_expr(sstate.child(iter, 0))
        if start < 0 {
            return -1
        }
        var end = gen_expr(sstate.child(iter, 1))
        if end < 0 {
            return -1
        }
        // 循环变量 alloca + 初始值
        var var_alloca = ir.new_inst(g_cur_block, 20, types.named(3))
        ir.add_operand(var_alloca, types.named(3), 2)
        var va = ir.get_value(var_alloca)
        var sv = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(sv, types.named(3), 2)
        ir.add_operand(sv, start, 0)
        ir.add_operand(sv, va, 0)
        scope_put(s_names[id], va, types.named(3))
        // cond/body/step/exit 块
        var cond_blk = ir.new_block(g_cur_func, interner.intern("for.cond"))
        var body_blk = ir.new_block(g_cur_func, interner.intern("for.body"))
        var step_blk = ir.new_block(g_cur_func, interner.intern("for.step"))
        var exit_blk = ir.new_block(g_cur_func, interner.intern("for.exit"))
        // 循环上下文：continue → step（自增后），break → exit
        loop_push(s_aux[id], exit_blk, step_blk)
        var b0 = ir.new_inst(g_cur_block, 30, -1)  // br cond
        ir.add_operand(b0, cond_blk, 1)
        // cond 块：cur < end → body，否则 exit
        g_cur_block = cond_blk
        var cur = ir.new_inst(g_cur_block, 21, types.named(3))
        ir.add_operand(cur, va, 0)
        var cur_v = ir.get_value(cur)
        var cmp = ir.new_inst(g_cur_block, 12, types.named(10))  // icmp, i1
        ir.add_operand(cmp, cur_v, 0)
        ir.add_operand(cmp, end, 0)
        ir.add_operand(cmp, 2, 2)  // lt
        var cmp_v = ir.get_value(cmp)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, cmp_v, 0)
        ir.add_operand(cb, body_blk, 1)
        ir.add_operand(cb, exit_blk, 1)
        // body 块
        g_cur_block = body_blk
        var bb = gen_block_stmts(body)
        if bb < 0 {
            return -1
        }
        if !block_terminated() {
            var bb2 = ir.new_inst(g_cur_block, 30, -1)  // br step
            ir.add_operand(bb2, step_blk, 1)
        }
        // step 块：cur + 1 → store → br cond
        g_cur_block = step_blk
        var add1 = ir.new_inst(g_cur_block, 0, types.named(3))  // add
        ir.add_operand(add1, cur_v, 0)
        ir.add_operand(add1, 1, 2)  // 立即数 1
        var add_v = ir.get_value(add1)
        var st = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st, types.named(3), 2)
        ir.add_operand(st, add_v, 0)
        ir.add_operand(st, va, 0)
        var sb = ir.new_inst(g_cur_block, 30, -1)  // br cond
        ir.add_operand(sb, cond_blk, 1)
        // exit 块
        g_cur_block = exit_blk
        loop_pop()
        return 0
    }
    if tag == 106 {
        // While：children=[cond, body]。cond_br 回边 + 循环上下文
        var cond = sstate.child(id, 0)
        var body = sstate.child(id, 1)
        var label = s_names[id]
        var cond_blk = ir.new_block(g_cur_func, interner.intern("while.cond"))
        var body_blk = ir.new_block(g_cur_func, interner.intern("while.body"))
        var exit_blk = ir.new_block(g_cur_func, interner.intern("while.exit"))
        loop_push(label, exit_blk, cond_blk)
        var b0 = ir.new_inst(g_cur_block, 30, -1)  // br cond
        ir.add_operand(b0, cond_blk, 1)
        // cond 块：条件 → body / exit
        g_cur_block = cond_blk
        var cv = gen_expr(cond)
        if cv < 0 {
            return -1
        }
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, cv, 0)
        ir.add_operand(cb, body_blk, 1)
        ir.add_operand(cb, exit_blk, 1)
        // body 块
        g_cur_block = body_blk
        var bb = gen_block_stmts(body)
        if bb < 0 {
            return -1
        }
        if !block_terminated() {
            var bb2 = ir.new_inst(g_cur_block, 30, -1)  // br cond
            ir.add_operand(bb2, cond_blk, 1)
        }
        // exit 块
        g_cur_block = exit_blk
        loop_pop()
        return 0
    }
    if tag == 108 {
        // Break：br 到循环 exit 块
        var tgt = loop_find_break(s_names[id])
        if tgt < 0 {
            return -1
        }
        var b = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(b, tgt, 1)
        return 0
    }
    if tag == 109 {
        // Continue：br 到循环 cond/step 块
        var tgt = loop_find_cont(s_names[id])
        if tgt < 0 {
            return -1
        }
        var b = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(b, tgt, 1)
        return 0
    }
    if tag == 103 {
        // Assign：name=目标名, val=op（-1 普通；0..17 复合赋值码，对齐 B_*），
        // children=[值]。复合赋值：load 旧值 → 运算 → store（对齐 Rust 同路径）。
        // 注意：目标槽（g_lookup_alloca）必须**先保存**——gen_expr(val) 求值会
        // 覆盖全局槽（x = y 时 y 的 scope_get 覆盖 g_lookup_alloca），曾导致
        // store 存错目标（a &= b 把结果存进 b）。
        var nm = sstate.name_str(id)
        var val = sstate.child(id, 0)
        var op = s_vals[id]
        var nid = interner.intern(nm)
        if scope_get_global(nid) < 0 {
            sm_err_msg = "赋值目标 '" + nm + "' 未入作用域（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var tgt_alloca = g_lookup_alloca
        var tgt_global = g_lookup_is_global
        var tgt_ty = g_lookup_ty
        var vv: i64 = -1
        if op >= 0 {
            // 复合赋值：先 load 旧值
            var cur = ir.new_inst(g_cur_block, 21, tgt_ty)  // load
            if tgt_global > 0 {
                ir.add_operand(cur, tgt_alloca, 3)
            } else {
                ir.add_operand(cur, tgt_alloca, 0)
            }
            var cur_v = ir.get_value(cur)
            var rv = gen_expr(val)
            if rv < 0 {
                return -1
            }
            vv = gen_compound_assign(op, cur_v, rv, tgt_ty)
            if vv < 0 {
                sm_err_msg = "复合赋值运算失败（变量 " + nm + "，函数 " + g_cur_fn_name + "）"
                return -1
            }
        } else {
            if s_tags[val] == 4 && tgt_ty == types.named(TK_TRIT) {
                // BoolLit 适配 trit（t = true 且 t 是 trit 变量 → i8 1）
                var tv: i64 = -1
                if s_vals[val] == 1 {
                    tv = 1
                }
                vv = gen_trit_lit(tv)
            } else {
                vv = gen_expr(val)
            }
            if vv < 0 {
                return -1
            }
        }
        // S1.3 C2/C3：赋值值类型 ≠ 目标槽类型（数字族）→ 转换（拓宽/缩窄）
        var vt = node_types[val]
        if op < 0 && vt >= 0 && (types.is_int(vt) || types.is_float(vt)) &&
            (types.is_int(tgt_ty) || types.is_float(tgt_ty)) && vt != tgt_ty {
            var cv = gen_coerce(vv, vt, tgt_ty)
            if cv < 0 {
                return -1
            }
            vv = cv
        }
        var st = ir.new_inst(g_cur_block, 22, -1)  // store
        ir.add_operand(st, tgt_ty, 2)
        ir.add_operand(st, vv, 0)
        if tgt_global > 0 {
            ir.add_operand(st, tgt_alloca, 3)  // OK_GLOBAL 全局地址（池 id）
        } else {
            ir.add_operand(st, tgt_alloca, 0)  // 本地 alloca
        }
        return 0
    }
    if tag == 110 {
        // Switch：字符串比较链（driver 树仅 typekw_index 一处，字符串 subject）
        return gen_switch(id)
    }
    if tag == 116 {
        // IndexAssign：t[i] = v → tie_table_set 桥
        return gen_index_assign(id)
    }
    if tag == 115 {
        // FieldAssign：obj.field = v（元组/struct 字段赋值；复合赋值 op ≥ 0）
        return gen_field_assign(id)
    }
    if tag == 134 {
        // S2.3：`panic("消息")` 不可恢复错误语句（N_PANIC）→ printf + exit(1)
        return gen_panic(id)
    }
    sm_err_line = s_lines[id]
    sm_err_col = s_cols[id]
    sm_err_msg = "irgen 未支持的语句（tag=" + to_string(tag) + "，函数 " + g_cur_fn_name + "）"
    return -1  // 其他语句后续扩展
}

// for-in 表迭代：`for item in t`（t 为动态表变量/表达式）。
// 布局（对齐 Rust gen_for_dyn_table）：计数器 alloca（0..len(t)，cond 块每次
// 调 tie_table_len）+ 循环变量 alloca（元素类型 T）；body 每次迭代
// tie_table_at 读取元素 → store 到循环变量；continue → step，break → exit。
func gen_for_table(id: i64, iter: i64, body: i64) -> i64 {
    g_used_interp = true
    // 表指针（load ptr 槽 / 全局表 load ptr, ptr @g）
    var t = gen_expr(iter)
    if t < 0 {
        return -1
    }
    // 元素类型判定优先级：
    //   1. iter 变量的作用域完整类型（table<T> → table_elem）
    //   2. node_types[iter] 的表元素类型（语义推导）
    //   3. sinfer.var_table_elem（语义层动态表登记）
    //   4. body 中循环变量引用节点的语义类型（for f in entries 里 println(f) 推断）
    //   5. 兜底 i64
    var elem: i64 = types.named(TK_I64)
    var matched: bool = false
    if s_tags[iter] == 6 {
        var bname = interner.intern(sstate.name_str(iter))
        if scope_get(bname) >= 0 && types.is_table(g_lookup_ty) {
            var le = types.table_elem(g_lookup_ty)
            if le > 0 {
                elem = le
                matched = true
            }
        }
        if !matched {
            var bt2 = node_types[iter]
            if types.is_table(bt2) {
                var le2 = types.table_elem(bt2)
                if le2 > 0 {
                    elem = le2
                    matched = true
                }
            }
        }
        if !matched {
            var te = sinfer.var_table_elem(bname)
            if te >= 0 {
                elem = te
                matched = true
            }
        }
    } else {
        var bt = node_types[iter]
        if types.is_table(bt) {
            var le2 = types.table_elem(bt)
            if le2 > 0 {
                elem = le2
                matched = true
            }
        }
    }
    if !matched {
        // body 中循环变量引用类型（`for f in entries { println(f) }` →
        // f 的引用节点被语义层推断为 TK_STR）
        var var_nm = interner.intern(sstate.name_str(id))
        var bn = sstate.nchild(body)
        var bi: i64 = 0
        while bi < bn {
            var st0 = sstate.child(body, bi)
            var refs = find_var_refs(st0, var_nm)
            var ri: i64 = 0
            while ri < len(refs) {
                var rt = node_types[refs[ri]]
                if rt >= 0 && (rt == types.named(TK_STR) || types.is_int(rt) ||
                    types.is_float(rt) || types.is_bool_like(rt)) {
                    elem = rt
                    matched = true
                    break
                }
                ri = ri + 1
            }
            if matched {
                break
            }
            bi = bi + 1
        }
    }
    var suffix = bridge_suffix(elem)
    var elem_llvm_ty = types.named(TK_I64)
    // 嵌套表元素（elem 是 table/map，如 `for row in t`，t 为 table<table<i64>>）：
    // 元素在动态表中存 ptr，for 读行必须用 at_string 桥（返回 ptr）——曾按
    // bridge_suffix 落 at_i64，返回 i64 与循环变量 ptr 槽不符（`store ptr %r,
    // ptr %slot` 但 %r 是 i64，LLVM 拒收），导致 tie_table_len 收到 i64。对齐
    // gen_table_at 3228 行的既有修复（同一约定：表/映射元素 → string 桥）。
    // 嵌套表/映射/port 元素 → string 桥（存 ptr）；但返回类型用 elem 本身
    //（= ptr）而非 TK_STR——S2.1 补头按 ins_ty==TK_STR 判补头，句柄/port
    // 对象被误补头（strlen 扫描 → 崩溃）。真字符串元素保持 TK_STR（需补头）。
    if types.is_table(elem) || types.is_map(elem) || types.kind(elem) == K_PORT {
        suffix = "string"
        elem_llvm_ty = elem
    } else if suffix == "string" {
        elem_llvm_ty = types.named(TK_STR)
    } else if suffix == "bool" {
        elem_llvm_ty = types.named(TK_BOOL)
    } else if suffix == "f64" {
        elem_llvm_ty = types.named(TK_F64)
    }
    // 计数器 alloca（i64）+ store 0
    var idx_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))  // alloca
    ir.add_operand(idx_a, types.named(TK_I64), 2)
    var idx_ptr = ir.get_value(idx_a)
    var i0 = gen_int_lit_ty(0, types.named(TK_I64))
    var st0 = ir.new_inst(g_cur_block, 22, -1)  // store 0
    ir.add_operand(st0, types.named(TK_I64), 2)
    ir.add_operand(st0, i0, 0)
    ir.add_operand(st0, idx_ptr, 0)
    // 循环变量 alloca（元素类型）
    var item_a = ir.new_inst(g_cur_block, 20, elem_llvm_ty)  // alloca
    ir.add_operand(item_a, elem_llvm_ty, 2)
    var item_ptr = ir.get_value(item_a)
    // 四块：cond / body / step / exit
    var cond_blk = ir.new_block(g_cur_func, interner.intern("for.cond"))
    var body_blk = ir.new_block(g_cur_func, interner.intern("for.body"))
    var step_blk = ir.new_block(g_cur_func, interner.intern("for.step"))
    var exit_blk = ir.new_block(g_cur_func, interner.intern("for.exit"))
    loop_push(s_aux[id], exit_blk, step_blk)
    var b0 = ir.new_inst(g_cur_block, 30, -1)  // br cond
    ir.add_operand(b0, cond_blk, 1)
    // cond 块：cur >= len(t) → exit
    g_cur_block = cond_blk
    var cur = ir.new_inst(g_cur_block, 21, types.named(TK_I64))  // load
    ir.add_operand(cur, idx_ptr, 0)
    var cur_v = ir.get_value(cur)
    var tlen = gen_ext_call1("tie_table_len", t, types.named(TK_STR), types.named(TK_I64))
    if tlen < 0 {
        return -1
    }
    var done = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp sge
    ir.add_operand(done, cur_v, 0)
    ir.add_operand(done, tlen, 0)
    ir.add_operand(done, 5, 2)  // sge
    var done_v = ir.get_value(done)
    var cb = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb, done_v, 0)
    ir.add_operand(cb, exit_blk, 1)
    ir.add_operand(cb, body_blk, 1)
    // body 块：item = table_at(t, cur) → store → 循环体
    g_cur_block = body_blk
    var ok_slot = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
    ir.add_operand(ok_slot, types.named(TK_I8), 2)
    var ats: table<i64> = table_new_i64()
    var avs: table<i64> = table_new_i64()
    table_push(ats, types.named(TK_STR))
    table_push(avs, t)
    table_push(ats, types.named(TK_I64))
    table_push(avs, cur_v)
    table_push(ats, types.named(TK_STR))
    table_push(avs, ir.get_value(ok_slot))
    var iv = gen_ext_call_typed("tie_table_at_" + suffix, ats, avs, elem_llvm_ty)
    if iv < 0 {
        return -1
    }
    var ist = ir.new_inst(g_cur_block, 22, -1)  // store
    ir.add_operand(ist, elem_llvm_ty, 2)
    ir.add_operand(ist, iv, 0)
    ir.add_operand(ist, item_ptr, 0)
    scope_put(s_names[id], item_ptr, elem_llvm_ty)
    var bb = gen_block_stmts(body)
    if bb < 0 {
        return -1
    }
    scope_pop()
    if !block_terminated() {
        var bb2 = ir.new_inst(g_cur_block, 30, -1)  // br step
        ir.add_operand(bb2, step_blk, 1)
    }
    // step 块：cur + 1 → store → br cond
    g_cur_block = step_blk
    var add1 = ir.new_inst(g_cur_block, 0, types.named(TK_I64))  // add
    ir.add_operand(add1, cur_v, 0)
    ir.add_operand(add1, 1, 2)
    var add_v = ir.get_value(add1)
    var st2 = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(st2, types.named(TK_I64), 2)
    ir.add_operand(st2, add_v, 0)
    ir.add_operand(st2, idx_ptr, 0)
    var sb = ir.new_inst(g_cur_block, 30, -1)  // br cond
    ir.add_operand(sb, cond_blk, 1)
    // exit 块
    g_cur_block = exit_blk
    loop_pop()
    return 0
}

// 语句树中查找变量引用节点（tag 6，名池 id == target）：返回节点 id 表。
// gen_for_table 用它推断循环变量元素类型（body 里 println(f) → node_types[f]）
func find_var_refs(st: i64, target: i64) -> table<i64> {
    var out = table_new_i64()
    collect_var_refs(st, target, out)
    return out
}

// find_var_refs 的递归实现（深度优先遍历子节点）
func collect_var_refs(st: i64, target: i64, out: table<i64>) {
    if st < 0 {
        return
    }
    if s_tags[st] == 6 && s_names[st] == target {
        table_push(out, st)
        return  // 变量节点是叶子
    }
    var n = sstate.nchild(st)
    var i: i64 = 0
    while i < n {
        collect_var_refs(sstate.child(st, i), target, out)
        i = i + 1
    }
}

// 语句块遍历（StmtList children）。每个块独立作用域（push/pop）。
func gen_block_stmts(blk: i64) -> i64 {
    scope_push()
    var n = sstate.nchild(blk)
    var i: i64 = 0
    while i < n {
        var s = sstate.child(blk, i)
        var r = gen_stmt(s)
        if r < 0 {
            return -1
        }
        i = i + 1
    }
    scope_pop()
    return 0
}

// ==================== 顶层入口 ====================
// 生成 tie-IR（AST 已就绪版，driver.tie 主路径专用）：**前置条件**——调用方
// 必须先执行过 semantic.check_impl（含 parse 的 check_src 等价物），使以下
// 全局状态完整可用：sstate 全局表（s_tags/s_children/s_lines/...）、
// g_extra_tops（顶层声明序列，import 已递归展开填充）、node_types/fn_keys
// （类型/函数签名登记）。driver.frontend() 即满足该条件（parser.parse_src +
// semantic.check_impl，与 semantic.check_src 内部流程完全等价，AST 与类型表
// 状态一致）。
// 本函数**不含**语法/语义检查——只做 生成器状态重置 → 全局变量登记 →
// 顶层函数/命名空间遍历 生成 tie-IR，省去第二次完整前端执行
// （parse + import 展开 + 符号表重建）的性能浪费。调用方在 frontend 失败时
// 已提前返回，故本函数无需再判语义错误。
// 返回 0 成功 / -1 错误（sm_err_* 已置）。
pub func gen_ast() -> i64 {
    // 重置生成器状态
    g_sc_keys = table_new_i64()
    g_sc_allocas = table_new_i64()
    g_sc_tys = table_new_i64()
    g_sc_top = 0
    g_lp_labels = table_new_i64()
    g_lp_breaks = table_new_i64()
    g_lp_cont = table_new_i64()
    g_lp_top = 0
    g_str_keys = table_new_i64()
    g_str_count = 0
    g_used_runtime = false
    g_used_interp = false
    ir.new_module()
    // S2.4 vtable 全局常量登记（每个 impl 一个：方法函数指针按 port 方法
    // 声明序；llvmgen 在 emit_globals 后输出 @vt.<port>.<struct> 常量）
    reg_all_vtables()
    // 全局变量登记（表全局 → llvmgen 输出 @g = global ptr null，main 入口初始化）
    var n = len(g_extra_tops)
    var i: i64 = 0
    while i < n {
        var s = g_extra_tops[i]
        if s_tags[s] == 100 {
            gen_global_var(s)
        }
        i = i + 1
    }
    // 顶层遍历：FnDef（顶层函数）/ Namespace（递归函数体）/ 全局 VarDecl 已登记
    i = 0
    while i < n {
        var s = g_extra_tops[i]
        if s_tags[s] == 101 {
            // 顶层函数：全名 = 裸名
            var r = gen_fn_def(s, "")
            if r < 0 {
                if str_len(sm_err_msg) == 0 {
                    sm_err_msg = "顶层函数 " + sstate.name_str(s) + " 生成失败"
                }
                return -1
            }
        } else if s_tags[s] == 112 {
            // 命名空间：递归生成体内函数（全名 = ns 段::函数名）
            var nr = gen_ns(s, "")
            if nr < 0 {
                if str_len(sm_err_msg) == 0 {
                    sm_err_msg = "顶层命名空间生成失败"
                }
                return -1
            }
        }
        i = i + 1
    }
    return 0
}

// 生成 tie-IR（完整版）：内部调 semantic.check_src（parse + 语义 + import）
// 填充 AST + 类型表，然后遍历顶层 FnDef。driver-lite.tie 与 backend/
// _driver_test.tie 仍在使用；driver.tie 主路径改用 gen_ast() 避免重复前端。
// 返回 0 成功 / -1 错误（sm_err_* 已置）
pub func gen_src(src: string, base_dir: string) -> i64 {
    var sem = semantic.check_src(src, base_dir)
    if str_len(sem) < 3 {
        return -1
    }
    if str_char(sem, 0) != "O" {
        // 语义错误
        sm_err_msg = sem
        return -1
    }
    // 重置生成器状态
    g_sc_keys = table_new_i64()
    g_sc_allocas = table_new_i64()
    g_sc_tys = table_new_i64()
    g_sc_top = 0
    g_lp_labels = table_new_i64()
    g_lp_breaks = table_new_i64()
    g_lp_cont = table_new_i64()
    g_lp_top = 0
    g_str_keys = table_new_i64()
    g_str_count = 0
    g_used_runtime = false
    g_used_interp = false
    ir.new_module()
    // S2.4 vtable 全局常量登记（每个 impl 一个：方法函数指针按 port 方法
    // 声明序；llvmgen 在 emit_globals 后输出 @vt.<port>.<struct> 常量）
    reg_all_vtables()
    // 全局变量登记（表全局 → llvmgen 输出 @g = global ptr null，main 入口初始化）
    var n = len(g_extra_tops)
    var i: i64 = 0
    while i < n {
        var s = g_extra_tops[i]
        if s_tags[s] == 100 {
            gen_global_var(s)
        }
        i = i + 1
    }
    // 顶层遍历：FnDef（顶层函数）/ Namespace（递归函数体）/ 全局 VarDecl 已登记
    i = 0
    while i < n {
        var s = g_extra_tops[i]
        if s_tags[s] == 101 {
            // 顶层函数：全名 = 裸名
            var r = gen_fn_def(s, "")
            if r < 0 {
                if str_len(sm_err_msg) == 0 {
                    sm_err_msg = "顶层函数 " + sstate.name_str(s) + " 生成失败"
                }
                return -1
            }
        } else if s_tags[s] == 112 {
            // 命名空间：递归生成体内函数（全名 = ns 段::函数名）
            var nr = gen_ns(s, "")
            if nr < 0 {
                if str_len(sm_err_msg) == 0 {
                    sm_err_msg = "顶层命名空间生成失败"
                }
                return -1
            }
        }
        i = i + 1
    }
    return 0
}

// ==================== S2.4 vtable / port 对象后端 ====================
// port 对象 LLVM 表示 = 单个 ptr（指向堆上打包对象 {data, vtable}）：
//   提升（struct → port）：malloc(16) → [0]=struct 槽地址（data，self 按引用）
//                            → [1]=@vt.<port>.<struct> 全局常量（vtable）
//   动态调用（port 方法）：data = gep(obj,0)；vtable = gep(obj,1) →
//                           entry = vtable[方法序号] → call_indirect(70)
// vtable 全局常量：每个 impl 一个，字段 = 方法实现函数指针（按 port 方法
// 声明序），llvmgen emit_vtables 输出。与闭包 C2（call_indirect 70）同构：
// 方法入口签名 fn(ptr self, args...) -> R，env = data 即 self 槽地址。

// 遍历 impl 记录 → llvmgen.vtable_reg（vt.<port>.<struct> + 方法全名表）
func reg_all_vtables() {
    var n = len(im_keys)
    var i: i64 = 0
    while i < n {
        var ii = im_vals[i]
        var pi = im_port[ii]
        var si = im_struct[ii]
        var vt = "vt." + types.type_name(types.port_of(pi)) + "." + sstate.struct_name_of(si)
        var mnames: table<string> = table_new_string()
        var nm = im_n[ii]
        var off = im_poff[ii]
        var j: i64 = 0
        while j < nm {
            table_push(mnames, intern.lookup(im_mnames[off + j]))
            j = j + 1
        }
        llvmgen.vtable_reg(vt, mnames)
        i = i + 1
    }
}

// N 字段全 ptr 聚合类型（打包对象 {ptr,ptr} / vtable {ptr×N}）：
// 复用 sstate tuple 登记（tup_* 表），字段类型全 TK_STR（LLVM ptr）。
// 查重复用 gen_tuple_ty（布局相同即同 id）。
func gen_ptr_tuple_ty(n: i64) -> i64 {
    var ftys: table<i64> = table_new_i64()
    var k: i64 = 0
    while k < n {
        table_push(ftys, types.named(TK_STR))
        k = k + 1
    }
    return gen_tuple_ty(ftys)
}

// 提升代码生成：具体类型值（struct）→ port 对象（打包 {data, vtable}）。
// 语义（docs/plans/port-model.md §4.1/4.2，I1 隐式 vtable）：
//   data = struct 实例槽地址（方法 self 按引用接收，与 M2.1.8 一致）
//   vtable = 全局常量 @vt.<port>.<struct>（llvmgen 已登记）
//   打包 = malloc(16) + 两字段 store；返回打包对象指针（port 对象 = ptr）。
// 生命周期归 arena/unsafe（调用方保证：被提升对象存活 ≥ 接口对象使用时间）。
// init 为 struct 类型表达式（node_types[init] = K_STRUCT，语义层已校验 impl）。
func gen_port_coerce(init: i64, port_ty: i64) -> i64 {
    var s_ty = node_types[init]
    if s_ty < 0 {
        sm_err_msg = "提升操作数类型缺失（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var vt_name = "vt." + types.type_name(port_ty) + "." + types.type_name(s_ty)
    // struct 槽地址（self 按引用 = 传地址；Var → 槽地址，表达式落内存）
    var addr = gen_agg_addr(init, s_ty)
    if addr < 0 {
        return -1
    }
    // malloc(16)：打包对象 {ptr, ptr}
    var size = gen_int_lit_ty(16, types.named(TK_I64))
    var obj = gen_ext_call1("malloc", size, types.named(TK_I64), types.named(TK_STR))
    if obj < 0 {
        return -1
    }
    var tup2 = gen_ptr_tuple_ty(2)
    // [0] = data（struct 槽地址）
    var g0 = ir.new_inst(g_cur_block, 27, tup2)  // agg_gep
    ir.add_operand(g0, obj, 0)
    ir.add_operand(g0, 0, 2)
    var st0 = ir.new_inst(g_cur_block, 22, -1)  // store ptr
    ir.add_operand(st0, types.named(TK_STR), 2)
    ir.add_operand(st0, addr, 0)
    ir.add_operand(st0, ir.get_value(g0), 0)
    // [1] = vtable 全局常量地址（const_global 63；store 时 llvmgen to_ptr
    // 直引 @vt.xxx —— 与闭包 entry 字段同模式）
    var g1 = ir.new_inst(g_cur_block, 27, tup2)  // agg_gep
    ir.add_operand(g1, obj, 0)
    ir.add_operand(g1, 1, 2)
    var vt = ir.new_inst(g_cur_block, 63, types.named(TK_STR))  // const_global
    ir.add_operand(vt, interner.intern(vt_name), 0)
    var st1 = ir.new_inst(g_cur_block, 22, -1)  // store ptr
    ir.add_operand(st1, types.named(TK_STR), 2)
    ir.add_operand(st1, ir.get_value(vt), 0)
    ir.add_operand(st1, ir.get_value(g1), 0)
    return obj
}

// port 对象方法调用（动态分发）：vtable 间接调用（call_indirect 70）。
//   data = gep(obj, 0) → load（env，方法 self 首参）
//   vtable = gep(obj, 1) → load → entry = vtable[方法序号] → load 函数指针
//   指令：call_indirect [entry, ret_ty IMM, env=data, (ty, val)...]
// 注意：**先求值全部实参收集到表，再 new_inst + add_operand**——实参求值
// （gen_expr）会生成新指令并 push 操作数，若穿插在 call 指令的 add_operand
// 之间会导致操作数段交错（const_i 的字面量被算进 call 段，实参错位）。
// 与闭包 gen_call_indirect 同模式。
func gen_port_method_call(id: i64, recv: i64, pty: i64, mname: string) -> i64 {
    var pi = types.low(pty)
    var mi = sstate.port_method_idx(pi, mname)
    if mi < 0 {
        sm_err_msg = "port '" + types.type_name(pty) + "' 没有方法 '" + mname + "'（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var ret_ty = sstate.port_method_ret(pi, mi)
    // 接收者值：port 对象（ptr）
    var recv_v = gen_expr(recv)
    if recv_v < 0 {
        return -1
    }
    var tup2 = gen_ptr_tuple_ty(2)
    // data = gep(obj, 0) → load ptr
    var g0 = ir.new_inst(g_cur_block, 27, tup2)  // agg_gep
    ir.add_operand(g0, recv_v, 0)
    ir.add_operand(g0, 0, 2)
    var ld0 = ir.new_inst(g_cur_block, 21, types.named(TK_STR))  // load ptr
    ir.add_operand(ld0, ir.get_value(g0), 0)
    // vtable = gep(obj, 1) → load ptr（vtable 聚合地址）
    var g1 = ir.new_inst(g_cur_block, 27, tup2)  // agg_gep
    ir.add_operand(g1, recv_v, 0)
    ir.add_operand(g1, 1, 2)
    var ld1 = ir.new_inst(g_cur_block, 21, types.named(TK_STR))  // load ptr
    ir.add_operand(ld1, ir.get_value(g1), 0)
    // entry = vtable[方法序号]：vtable 聚合类型 = {ptr × port 方法数}
    var vt_ty = gen_ptr_tuple_ty(pm_n[pi])
    var g2 = ir.new_inst(g_cur_block, 27, vt_ty)  // agg_gep
    ir.add_operand(g2, ir.get_value(ld1), 0)
    ir.add_operand(g2, mi, 2)
    var ld2 = ir.new_inst(g_cur_block, 21, types.named(TK_STR))  // load ptr
    ir.add_operand(ld2, ir.get_value(g2), 0)
    // 先求值全部实参（收集到表；求值可能生成指令，须在 call 指令创建前）
    var soff2 = sstate.slot_off(id)
    var nc = sstate.nchild(id)
    var argvals: table<i64> = table_new_i64()
    var j: i64 = 1 + soff2
    while j < nc {
        var av = gen_expr(sstate.child(id, j))
        if av < 0 {
            return -1
        }
        table_push(argvals, av)
        j = j + 1
    }
    // call_indirect(70)：[entry, ret_ty IMM, env=data, (ty, val)...]
    var ty70: i64 = -1
    if ret_ty != types.named(TK_VOID) {
        ty70 = ret_ty
    }
    var inst = ir.new_inst(g_cur_block, 70, ty70)
    ir.add_operand(inst, ir.get_value(ld2), 0)
    ir.add_operand(inst, ret_ty, 2)
    ir.add_operand(inst, ir.get_value(ld0), 0)
    j = 0
    while j < len(argvals) {
        // 实参类型：port 方法签名去 self——第 (j+1) 个显式实参即签名第 (j+1)
        // 个参数（签名下标 0 = self 槽，1 起为显式参数）
        var aty = sstate.port_method_param(pi, mi, j + 1)
        ir.add_operand(inst, aty, 2)
        ir.add_operand(inst, argvals[j], 0)
        j = j + 1
    }
    if ret_ty == types.named(TK_VOID) {
        return gen_int_lit(0)  // void 结果：哑值（调用方丢弃）
    }
    return ir.get_value(inst)
}

// 顶层全局变量声明（tag 100）：登记到 llvmgen 全局段。
// 表全局 → @g = global ptr null（main 入口运行时创建，对齐 T0.4）；
// 标量全局 → @g = global T <字面量零值>。
func gen_global_var(s: i64) {
    var nm = sstate.name_str(s)
    var ty = sgen.parse_generic_type_node(sstate.child(s, 0))
    if ty < 0 {
        ty = types.named(TK_I64)  // 无标注：语义已推断，兜底 i64
    }
    var telem = sinfer.gb_telem_of(intern.intern(nm))
    // 表全局登记：llvmgen 输出 global ptr null + main 入口初始化
    if types.is_table(ty) || telem >= 0 {
        llvmgen.global_table_reg(nm)
    } else {
        llvmgen.global_scalar_reg(nm, ty)
        // const 整数字面量初始值（否则 @g = global i64 0，
        // 顶层 const 读取全为 0——token id 常量等全失效）
        var init = sstate.child(s, 1)
        if sinfer.gb_const_of(intern.intern(nm)) == 1 && init >= 0 && s_tags[init] == 0 {
            llvmgen.global_scalar_init(nm, s_vals[init])
        } else if init >= 0 && s_tags[init] == 2 && ty == types.named(TK_STR) {
            // 顶层字符串全局初始字面量（var/const 均含：如 registry 默认 URL）：
            // @g = global ptr @.str.N（曾忽略字面量 → @g 恒为空串）
            llvmgen.global_str_init(nm, s_names[init])
        }
    }
}
// 命名空间递归：生成体内全部函数（全名 = prefix::函数名）。
// ns_node 为 N_NAMESPACE 节点：children=[Segment...]+[体 StmtList]。
func gen_ns(ns_node: i64, prefix: string) -> i64 {
    var segs: table<string> = table_new_string()
    var nseg = s_aux[ns_node]
    var k: i64 = 0
    while k < nseg {
        var seg = sstate.child(ns_node, k)
        table_push(segs, sstate.name_str(seg))
        k = k + 1
    }
    var body = sstate.child(ns_node, nseg)
    // 本命名空间全名前缀 = 外层 prefix + 本段
    var full_pre: string = prefix
    var j: i64 = 0
    while j < len(segs) {
        if full_pre != "" {
            full_pre = full_pre + "::"
        }
        full_pre = full_pre + segs[j]
        j = j + 1
    }
    // 遍历命名空间体：FnDef → 全名生成；嵌套 Namespace → 递归
    var nb = sstate.nchild(body)
    var i: i64 = 0
    while i < nb {
        var st = sstate.child(body, i)
        var tag = s_tags[st]
        if tag == 101 {
            var r = gen_fn_def(st, full_pre)
            if r < 0 {
                if str_len(sm_err_msg) == 0 {
                    sm_err_msg = "命名空间 " + full_pre + " 的函数 " + sstate.name_str(st) + " 生成失败"
                }
                return -1
            }
        } else if tag == 112 {
            var nr = gen_ns(st, full_pre)
            if nr < 0 {
                return -1
            }
        }
        i = i + 1
    }
    return 0
}

// 函数定义 → tie-IR 函数。prefix 为命名空间前缀（顶层函数传 ""）。
// 函数全名 = prefix::name（命名空间函数）；LLVM 符号由 llvmgen 转 $。
func gen_fn_def(fn_node: i64, prefix: string) -> i64 {
    // 泛型模板声明（children[0] == N_TYPE_PARAMS）：T3b 单态化前不生成 IR——
    // 模板体内 TypeVar 类型（"T"）无法静态编码，生成会报"类 'T' 未定义"。
    // 语义层已把模板登记进 gt_* 表并跳过普通函数检查；此处对称跳过生成。
    if sstate.nchild(fn_node) > 0 {
        var slot0 = sstate.child(fn_node, 0)
        if slot0 >= 0 && s_tags[slot0] == S_N_TYPE_PARAMS {
            return 0
        }
    }
    var bare = sstate.name_str(fn_node)
    var full_name: string = str.clone(bare)
    if prefix != "" {
        full_name = prefix + "::" + bare
    }
    g_cur_fn_name = str.clone(full_name)
    // 每函数重置变量作用域（跨函数不串用；同层函数同名参数/局部正常遮蔽）
    g_sc_keys = table_new_i64()
    g_sc_allocas = table_new_i64()
    g_sc_tys = table_new_i64()
    g_sc_top = 0
    g_lp_labels = table_new_i64()
    g_lp_breaks = table_new_i64()
    g_lp_cont = table_new_i64()
    g_lp_top = 0
    g_tv_keys = table_new_i64()
    g_tv_elems = table_new_i64()
    var nparams = s_aux[fn_node]
    // 返回类型：children[slot_off]（新布局 children[0]=泛型槽→偏移 1；
    // 旧布局无槽→children[0]=返回类型。slot_off 统一判定保证自举双兼容）
    var ret_ty = sgen.parse_generic_type_node(sstate.child(fn_node, sstate.slot_off(fn_node)))
    if ret_ty < 0 {
        if str_len(sm_err_msg) == 0 {
            sm_err_msg = "函数 " + full_name + " 返回类型解析失败"
        }
        return -1
    }
    g_cur_ret_ty = ret_ty  // Return 生成期 trit 适配用
    // 参数类型收集（T0.3 by_ref + M2.1.8 struct 首参自动 ref：ref 参数 LLVM
    // 形参声明为 ptr——按值声明聚合类型（%struct.Counter）会与调用方传的
    // 槽地址不匹配。表 ref 原本 table id → llvm ptr 恰好一致；struct 需显式 ptr）
    var params: table<i64> = table_new_i64()
    var sig0_pre = sstate.fn_sig(full_name)
    var sig_off_pre: i64 = -1
    if sig0_pre >= 0 {
        sig_off_pre = sg_off[sig0_pre]
    }
    var i: i64 = 0
    while i < nparams {
        // 第 i 个参数：children[slot_off + 1 + i]
        var p = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + i)
        var pt = sgen.parse_generic_type_node(sstate.child(p, 0))
        if pt < 0 {
            if str_len(sm_err_msg) == 0 {
                sm_err_msg = "函数 " + full_name + " 参数类型解析失败"
            }
            return -1
        }
        var is_ref_pre = 0
        if sig0_pre >= 0 && sig_off_pre + i < len(sp_refs) {
            is_ref_pre = sp_refs[sig_off_pre + i]
        }
        // 变参参数：签名类型为 table<T>（parser 的 AST 类型节点只有元素类型 T，
        // 必须用语义层已解析的签名类型——LLVM 形参声明为 ptr 表指针）
        if sig0_pre >= 0 && sig_off_pre + i < len(sp_vars) {
            if sp_vars[sig_off_pre + i] == 1 {
                pt = sp_tys[sig_off_pre + i]
            }
        }
        if is_ref_pre == 1 {
            table_push(params, types.named(TK_STR))  // 引用 → ptr 形参
        } else {
            table_push(params, pt)
        }
        i = i + 1
    }
    var fid = ir.new_func(intern.intern(full_name), ret_ty, params)
    g_cur_func = fid
    var entry = ir.new_block(fid, interner.intern("entry"))
    g_cur_block = entry
    // 参数入作用域（alloca + store；T0.3 by_ref 参数不 alloca，直接绑定参数寄存器）
    var off = ir.func_params_off(fid)
    var sig0 = sstate.fn_sig(full_name)
    var sig_off = sg_off[sig0]
    i = 0
    while i < nparams {
        // 第 i 个参数：children[slot_off + 1 + i]
        var p = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + i)
        var pname = sstate.name_str(p)
        var pty = params[i]
        // by_ref 标志：sstate sp_refs（语义层已收集）。
        // sig0 < 0（函数签名缺失，如命名空间函数拼接异常）时禁止取 sg_off[-1]——
        // 负索引垃圾值会误判参数为 ref，绑定参数寄存器导致运行时崩溃
        var is_ref = 0
        if sig0 >= 0 && sig_off + i < len(sp_refs) {
            is_ref = sp_refs[sig_off + i]
        }
        var av: i64 = -1
        if is_ref == 1 {
            // T0.3 by_ref：绑定参数寄存器（实参槽地址）。读取 → load ptr, ptr %N；
            // 重绑定赋值 → store ptr, %N 直接写回调用方实参槽
            av = ir.param_val(fid, i)
        } else {
            var alloca = ir.new_inst(g_cur_block, 20, pty)  // alloca
            ir.add_operand(alloca, pty, 2)
            av = ir.get_value(alloca)
            var st = ir.new_inst(g_cur_block, 22, -1)  // store 参数
            ir.add_operand(st, pty, 2)
            // 参数值 id（ir.param_val 取 ir_ops 参数段——曾误用 off+i 段偏移，
            // 与 llvmgen 形参映射 param_ref 不匹配导致 %N 未定义）
            ir.add_operand(st, ir.param_val(fid, i), 0)
            ir.add_operand(st, av, 0)
        }
        scope_put(interner.intern(pname), av, pty)
        i = i + 1
    }
    // 全局表 main 初始化：@g = global ptr null → main 入口 tie_table_new + store
    // （阶段 A 表全局，Rust 版同路径；缺此则 len(g) 对 null 崩溃 0xC0000005）
    if full_name == "main" {
        var gi: i64 = 0
        while gi < len(gb_keys) {
            var gte = gb_telem[gi]
            if gte >= 0 {
                var gsz = elem_size(gte)
                var gsz_v = gen_int_lit_ty(gsz, types.named(TK_I64))
                var gnt = gen_ext_call1("tie_table_new", gsz_v, types.named(TK_I64), types.named(TK_STR))
                if gnt < 0 {
                    return -1
                }
                var gst = ir.new_inst(g_cur_block, 22, -1)  // store
                ir.add_operand(gst, types.named(TK_STR), 2)
                ir.add_operand(gst, gnt, 0)
                ir.add_operand(gst, interner.intern("@" + intern.lookup(gb_keys[gi])), 3)  // 全局槽
            }
            gi = gi + 1
        }
    }
    // 函数体：children[slot_off + 1 + nparams]
    var body = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + nparams)
    var r = gen_block_stmts(body)
    if r < 0 {
        return -1
    }
    // 末尾补 ret：main → ret i32 0（void main）；其余 void → ret void
    if s_tags[body] == 122 {
        var has_ret = false
        // 简化：检查最后一条语句是否 Return
        var nb = sstate.nchild(body)
        if nb > 0 {
            var last = sstate.child(body, nb - 1)
            if s_tags[last] == 104 {
                has_ret = true
            }
        }
        // 当前块已终止（switch 各 case return 后 exit 块已由 default ret 结束；
        // if 两分支都 return 后 merge 块不可达）→ 不补 ret（曾补死代码
        // `ret ptr %0` 到已终止块，LLVM 报类型错）
        if !has_ret && !block_terminated() {
            if full_name == "main" {
                // main 补 ret i32 0：ty 必须显式 i32（llvmgen 按 ins_ty 输出 ret 类型，
                // ty=-1 会生成 ret ptr 0 / ret void 与 define i32 @main 不匹配）
                var ret = ir.new_inst(g_cur_block, 32, types.named(TK_I32))  // ret i32
                ir.add_operand(ret, 0, 2)  // 立即数 0
            } else if ret_ty == types.named(TK_VOID) {
                var ret = ir.new_inst(g_cur_block, 32, -1)  // ret void
            } else {
                // 非 void 缺 return：按返回类型补零值（曾一律补 ret void——
                // i64 函数 define i64 以 ret void 结束类型不匹配）。
                // string/ptr 用空串常量（曾用 IMM 0——llvmgen ret 的 to_ptr
                // 把字面量 0 误当值 id 0 → ret ptr %0 类型错）。
                // **先建常量再建 ret**：ret 指令会终止块，其后不能追加指令
                var dv = gen_default_val(ret_ty)
                var ret = ir.new_inst(g_cur_block, 32, ret_ty)
                ir.add_operand(ret, dv, 0)
            }
        }
    }
    return 0
}

// ==================== S2.2 闭包/函数值后端 ====================
// 数据模型（closure-model.md C2）：
//   fn(A...) -> R 类型 → LLVM 命名结构体 %fn.<签名索引> = { ptr, ptr }
//   （字段 0 = 环境指针 env，字段 1 = 入口函数指针 entry）
//   统一入口签名：fn(ptr env, A...) -> R（env 为隐藏第一参数；无捕获 → null）
//   捕获环境 = tuple 聚合类型（LLVM 内联 {T0, T1, ...}），malloc 分配
//   （与字符串一致无 GC/free，闭包值可安全逃逸出作用域）
//   间接调用：opcode 70 call_indirect——entry(env, args...)

// 闭包节点在 g_clo_pending 中的索引（-1 = 未登记，防御）
func closure_index(id: i64) -> i64 {
    var i: i64 = 0
    while i < len(g_clo_pending) {
        if g_clo_pending[i] == id {
            return i
        }
        i = i + 1
    }
    return -1
}

// 捕获变量存储类型归约（对齐 var_decl 的槽型规则）：
// 表/映射/字符串 → TK_STR（ptr 槽）；bool → TK_BOOL；窄整数/浮点/聚合 → 自身；
// 其余（i64/u64/默认）→ i64
func closure_cap_slot_ty(t: i64) -> i64 {
    if t < 0 {
        return types.named(TK_I64)
    }
    if types.is_table(t) || types.is_map(t) || t == types.named(TK_STR) {
        return types.named(TK_STR)
    }
    if types.is_bool_like(t) {
        return types.named(TK_BOOL)
    }
    if types.is_int(t) || types.is_float(t) || types.is_unsafe_ty(t) {
        return t
    }
    var k = types.kind(t)
    if k == K_TUPLE || k == K_STRUCT || k == K_ENUM || k == K_FN {
        return t
    }
    return types.named(TK_I64)
}

// N 字段 tuple 类型构造（查重登记，仿 sinfer.tuple2_of；环境结构体用）：
// 字段类型表 → tuple 类型 id（tup_offs/tup_n/tup_names/tup_tys/tuple_tys
// 为 sstate 顶层全局，与语义层 tuple 登记同布局）
func gen_tuple_ty(ftys: table<i64>) -> i64 {
    var n = len(ftys)
    var i: i64 = 0
    while i < len(tuple_tys) {
        var off = tup_offs[i]
        if tup_n[i] == n {
            var ok: bool = true
            var j: i64 = 0
            while j < n {
                if tup_tys[off + j] != ftys[j] {
                    ok = false
                    break
                }
                j = j + 1
            }
            if ok {
                return tuple_tys[i]
            }
        }
        i = i + 1
    }
    var idx = len(tuple_tys)
    var off2 = len(tup_names)
    table_push(tup_offs, off2)
    table_push(tup_n, n)
    table_push(tuple_tys, types.tuple_of(idx))
    var k: i64 = 0
    while k < n {
        table_push(tup_names, -1)
        table_push(tup_tys, ftys[k])
        k = k + 1
    }
    return types.tuple_of(idx)
}

// 函数地址 → i64 指针整数（opcode 63 const_global：ptrtoint ptr @sym to i64；
// store/参数等需真 ptr 处由 llvmgen to_ptr 直引 @sym）
func gen_func_addr(name: string) -> i64 {
    var inst = ir.new_inst(g_cur_block, 63, types.named(TK_STR))
    ir.add_operand(inst, interner.intern(name), 0)
    return ir.get_value(inst)
}

// 闭包字面量（N_FN_LIT=132）生成：① 解析返回/参数类型 → 生成入口函数
// clos_<节点id>（签名 fn(ptr env, A...) -> R，捕获变量绑定 env 字段，闭包体
// 正常生成）；② 构造闭包值 {env, entry}：捕获集非空 → malloc(8*ncap) +
// 逐字段 store 外层捕获值；捕获为空 → env = null。返回 %fn.X 聚合值。
func gen_closure_lit(id: i64) -> i64 {
    var slot = sstate.slot_off(id)
    var nparams = s_aux[id]
    // 返回类型：children[slot]（泛型槽占 0，返回类型 = children[slot]）
    var ret_node = sstate.child(id, slot)
    var ret_ty = sgen.parse_generic_type_node(ret_node)
    if ret_ty < 0 {
        if str_len(sm_err_msg) == 0 {
            sm_err_msg = "闭包返回类型解析失败"
        }
        return -1
    }
    // 参数类型收集（N_PARAM：children=[类型]；s_vals = by_ref，s_aux = 变参）
    var ptys: table<i64> = table_new_i64()
    var k: i64 = 0
    while k < nparams {
        var p = sstate.child(id, slot + 1 + k)
        if s_vals[p] == 1 {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "闭包参数暂不支持 ref 修饰（第一版仅普通按值参数）"
            return -1
        }
        if s_aux[p] == 1 {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "闭包参数暂不支持变参（第一版仅普通按值参数）"
            return -1
        }
        var pty = sgen.parse_generic_type_node(sstate.child(p, 0))
        if pty < 0 {
            return -1
        }
        table_push(ptys, pty)
        k = k + 1
    }
    // fn 类型（types.fn_of 查重：与 sinfer 登记的签名 id 一致）
    var fnty = types.fn_of(ret_ty, ptys)
    // 捕获集：cl_capkeys/cl_capvals 的当前闭包段 [cl_capoff[ci], 段末)
    // （段末 = 下一个闭包的 capoff 或表长；check_closure_body 已校准 capoff）
    var ci = closure_index(id)
    var capoff: i64 = 0
    var cap_end: i64 = 0
    var ncap: i64 = 0
    if ci >= 0 {
        capoff = cl_capoff[ci]
        cap_end = len(cl_capkeys)
        if ci + 1 < len(cl_capoff) {
            cap_end = cl_capoff[ci + 1]
        }
        ncap = cap_end - capoff
    }
    // 环境类型（捕获空 → -1：env = null）
    var cap_ty: i64 = -1
    if ncap > 0 {
        var cts: table<i64> = table_new_i64()
        var j: i64 = 0
        while j < ncap {
            table_push(cts, closure_cap_slot_ty(cl_capvals[capoff + j]))
            j = j + 1
        }
        cap_ty = gen_tuple_ty(cts)
    }
    // 保存当前函数/块（入口函数生成会切换）
    var saved_func = g_cur_func
    var saved_block = g_cur_block
    // 生成入口函数
    var cfid = gen_closure_entry_fn(ci, id, ret_ty, ptys, cap_ty, ncap)
    if cfid < 0 {
        return -1
    }
    // 恢复调用方上下文
    g_cur_func = saved_func
    g_cur_block = saved_block
    // 构造闭包值 {env, entry}
    var env_v: i64 = -1
    if ncap > 0 {
        // malloc(8 * ncap)：所有环境字段 8 字节（ptr/i64/聚合地址）
        var sz = gen_int_lit_ty(8 * ncap, types.named(TK_I64))
        env_v = gen_ext_call1("malloc", sz, types.named(TK_I64), types.named(TK_STR))
        // 逐字段 store 捕获值（load 外层槽 → store env 字段 j）
        var j: i64 = 0
        while j < ncap {
            var cnid = cl_capkeys[capoff + j]
            var cv = gen_var_ref(cnid)
            if cv < 0 {
                return -1
            }
            var gp = ir.new_inst(g_cur_block, 27, cap_ty)  // agg_gep 字段 j
            ir.add_operand(gp, env_v, 0)
            ir.add_operand(gp, j, 2)
            var st = ir.new_inst(g_cur_block, 22, -1)  // store 捕获值
            ir.add_operand(st, closure_cap_slot_ty(cl_capvals[capoff + j]), 2)
            ir.add_operand(st, cv, 0)
            ir.add_operand(st, ir.get_value(gp), 0)
            j = j + 1
        }
    } else {
        env_v = gen_int_lit(0)  // null（store 时 to_ptr → inttoptr 0 to ptr）
    }
    var entry_v = gen_func_addr("clos_" + to_string(id))
    return make_tuple2(env_v, types.named(TK_STR), entry_v, types.named(TK_STR), fnty)
}

// 闭包入口函数生成：clos_<节点id>，签名 fn(ptr env, A...) -> R。
// 布局：env 参数（param 0）→ 捕获变量绑定 env 字段地址（闭包体引用捕获
// 变量 = load 字段）；闭包参数 → alloca + store（与 gen_fn_def 一致）；
// 闭包体 → gen_block_stmts；尾部补 ret。返回函数 id。
func gen_closure_entry_fn(ci: i64, id: i64, ret_ty: i64, ptys: table<i64>, cap_ty: i64, ncap: i64) -> i64 {
    // 保存外层作用域（入口函数用独立作用域：捕获变量 + 参数登记；生成完
    // 恢复——否则闭包构造点的 gen_var_ref 会查到入口函数的 env 字段地址，
    // 跨函数引用产生 undefined value）。tie 表变量赋值 = 引用，须开新表。
    var s_keys = g_sc_keys
    var s_allocas = g_sc_allocas
    var s_tys = g_sc_tys
    var s_top = g_sc_top
    var s_lp = g_lp_labels
    var s_lpb = g_lp_breaks
    var s_lpc = g_lp_cont
    var s_lpt = g_lp_top
    g_sc_keys = table_new_i64()
    g_sc_allocas = table_new_i64()
    g_sc_tys = table_new_i64()
    g_sc_top = 0
    g_lp_labels = table_new_i64()
    g_lp_breaks = table_new_i64()
    g_lp_cont = table_new_i64()
    g_lp_top = 0
    var params: table<i64> = table_new_i64()
    table_push(params, types.named(TK_STR))  // env ptr（隐藏第一参数）
    var k: i64 = 0
    while k < len(ptys) {
        table_push(params, ptys[k])
        k = k + 1
    }
    var fid = ir.new_func(interner.intern("clos_" + to_string(id)), ret_ty, params)
    g_cur_func = fid
    var entry = ir.new_block(fid, interner.intern("entry"))
    g_cur_block = entry
    // 捕获变量绑定：env 字段地址入作用域（闭包体 load 字段即取捕获值）
    if ncap > 0 && ci >= 0 {
        var env_v = ir.param_val(fid, 0)
        var j: i64 = 0
        while j < ncap {
            var cnid = cl_capkeys[cl_capoff[ci] + j]
            var gp = ir.new_inst(g_cur_block, 27, cap_ty)  // agg_gep 字段 j
            ir.add_operand(gp, env_v, 0)
            ir.add_operand(gp, j, 2)
            var faddr = ir.get_value(gp)
            scope_put(cnid, faddr, closure_cap_slot_ty(cl_capvals[cl_capoff[ci] + j]))
            j = j + 1
        }
    }
    // 闭包参数：alloca + store + scope_put（env 占参数 0，闭包参数从 1 起）
    var i: i64 = 0
    while i < len(ptys) {
        var p = sstate.child(id, sstate.slot_off(id) + 1 + i)
        var pname = sstate.name_str(p)
        var pty = ptys[i]
        var alloca = ir.new_inst(g_cur_block, 20, pty)  // alloca
        ir.add_operand(alloca, pty, 2)
        var av = ir.get_value(alloca)
        var st = ir.new_inst(g_cur_block, 22, -1)  // store 参数
        ir.add_operand(st, pty, 2)
        ir.add_operand(st, ir.param_val(fid, 1 + i), 0)
        ir.add_operand(st, av, 0)
        scope_put(interner.intern(pname), av, pty)
        i = i + 1
    }
    // 闭包体：children[slot + 1 + nparams]；返回类型基准切换（return/? 解包）
    var saved_ret = g_cur_ret_ty
    var saved_fn_name = g_cur_fn_name
    g_cur_ret_ty = ret_ty
    g_cur_fn_name = "clos_" + to_string(id)
    var body = sstate.child(id, sstate.slot_off(id) + 1 + len(ptys))
    var r = gen_block_stmts(body)
    g_cur_ret_ty = saved_ret
    g_cur_fn_name = saved_fn_name
    if r < 0 {
        return -1
    }
    // 尾部补 ret（同 gen_fn_def；无 main 特例——闭包入口返回类型即闭包返回类型）
    if !block_terminated() {
        if ret_ty == types.named(TK_VOID) {
            var ret = ir.new_inst(g_cur_block, 32, -1)  // ret void
        } else {
            var dv = gen_default_val(ret_ty)
            var ret = ir.new_inst(g_cur_block, 32, ret_ty)
            ir.add_operand(ret, dv, 0)
        }
    }
    // 恢复外层作用域（入口函数作用域已用尽）
    g_sc_keys = s_keys
    g_sc_allocas = s_allocas
    g_sc_tys = s_tys
    g_sc_top = s_top
    g_lp_labels = s_lp
    g_lp_breaks = s_lpb
    g_lp_cont = s_lpc
    g_lp_top = s_lpt
    return fid
}

// 函数值间接调用（fn 类型变量调用）：调用名已解析为 fn 类型变量。
// IR 布局：fn 值落内存（局部变量 → 槽地址；全局/表达式 → load 后落临时
// alloca）→ agg_gep(0) + load = env → agg_gep(1) + load = entry →
// call_indirect(70)：entry(ptr env, args...)。返回类型 = fn 返回类型。
func gen_call_indirect(id: i64, nm: string) -> i64 {
    var fv_ty = g_lookup_ty  // scope_get_global 已填充
    if fv_ty < 0 || !types.is_fn(fv_ty) {
        sm_err_msg = "函数值调用：变量 '" + nm + "' 类型缺失（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var ret_ty = types.fn_ret_ty(fv_ty)
    var nparams = types.fn_nparams_of(fv_ty)
    // 实参求值（闭包参数无 by_ref/变参，普通按值；语义层已校验个数/类型）
    var aoff = sstate.slot_off(id)
    var nc = sstate.nchild(id)
    var argvals: table<i64> = table_new_i64()
    var k: i64 = aoff
    while k < nc {
        var arg_node = sstate.child(id, k)
        var av = gen_expr(arg_node)
        if av < 0 {
            return -1
        }
        table_push(argvals, av)
        k = k + 1
    }
    // fn 值地址：局部变量 → 槽地址直接 GEP；全局 → load 后落临时 alloca。
    // 注意：实参求值（gen_expr）可能再次调用 scope_get_global（实参也是
    // 变量），覆盖 g_lookup_*/g_lookup_alloca 全局副作用——须**重新查找**
    // 调用名，否则 fn 值地址会错取到实参的槽（probe2/probe5 崩溃根因）。
    var fv2 = scope_get_global(interner.intern(nm))
    if fv2 < 0 || !types.is_fn(g_lookup_ty) {
        sm_err_msg = "函数值调用：变量 '" + nm + "' 在实参求值后不可见（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var fn_addr: i64 = -1
    if g_lookup_is_global == 0 {
        fn_addr = g_lookup_alloca  // 局部聚合槽（kind 0）
    } else {
        var fv = gen_var_ref(interner.intern(nm))
        if fv < 0 {
            return -1
        }
        var alloca = ir.new_inst(g_cur_block, 20, fv_ty)  // alloca 聚合
        ir.add_operand(alloca, fv_ty, 2)
        fn_addr = ir.get_value(alloca)
        var st = ir.new_inst(g_cur_block, 22, -1)  // store 聚合值
        ir.add_operand(st, fv_ty, 2)
        ir.add_operand(st, fv, 0)
        ir.add_operand(st, fn_addr, 0)
    }
    // 提取 env（字段 0）与 entry（字段 1）
    var g0 = ir.new_inst(g_cur_block, 27, fv_ty)  // agg_gep 字段 0
    ir.add_operand(g0, fn_addr, 0)
    ir.add_operand(g0, 0, 2)
    var ld0 = ir.new_inst(g_cur_block, 21, types.named(TK_STR))  // load env ptr
    ir.add_operand(ld0, ir.get_value(g0), 0)
    var env_v = ir.get_value(ld0)
    var g1 = ir.new_inst(g_cur_block, 27, fv_ty)  // agg_gep 字段 1
    ir.add_operand(g1, fn_addr, 0)
    ir.add_operand(g1, 1, 2)
    var ld1 = ir.new_inst(g_cur_block, 21, types.named(TK_STR))  // load entry ptr
    ir.add_operand(ld1, ir.get_value(g1), 0)
    var entry_v = ir.get_value(ld1)
    // call_indirect(70)：[entry, ret_ty IMM, env, 参数...]
    var ty70: i64 = -1
    if ret_ty != types.named(TK_VOID) {
        ty70 = ret_ty
    }
    var inst = ir.new_inst(g_cur_block, 70, ty70)
    ir.add_operand(inst, entry_v, 0)
    ir.add_operand(inst, ret_ty, 2)
    ir.add_operand(inst, env_v, 0)
    k = 0
    while k < len(argvals) {
        var pty = types.named(TK_I64)
        if k < nparams {
            pty = types.fn_param_of(fv_ty, k)
        }
        ir.add_operand(inst, pty, 2)
        ir.add_operand(inst, argvals[k], 0)
        k = k + 1
    }
    if ret_ty == types.named(TK_VOID) {
        return gen_int_lit(0)  // void 结果：哑值（调用方丢弃）
    }
    return ir.get_value(inst)
}

// 命名函数提升：`var f: fn(A) -> R = my_func` → 生成适配器函数
// adapt_<节点id>（签名 fn(ptr env, A...) -> R，体内 call @my_func + ret，
// 忽略 env——命名函数无捕获），返回闭包值 {null, @adapt}。
func gen_named_fn_value(id: i64, full: string, fnty: i64) -> i64 {
    var sig = sstate.fn_sig(full)
    if sig < 0 {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "命名函数提升：函数 '" + full + "' 无签名（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var ret_ty = fn_ret_ty(sig)
    var nparams = fn_nparams(sig)
    var ptys = fn_param_tys(sig)
    var adap = "adapt_" + to_string(id)
    // 适配器函数：fn(ptr env, A...) -> R
    var params: table<i64> = table_new_i64()
    table_push(params, types.named(TK_STR))
    var k: i64 = 0
    while k < nparams {
        table_push(params, ptys[k])
        k = k + 1
    }
    var saved_func = g_cur_func
    var saved_block = g_cur_block
    var fid = ir.new_func(interner.intern(adap), ret_ty, params)
    g_cur_func = fid
    var entry = ir.new_block(fid, interner.intern("entry"))
    g_cur_block = entry
    // call @my_func(args...)（实参 = 适配器参数 1..）
    var sym = interner.intern(full)
    llvmgen.call_sym_reg(sym)
    var ty35: i64 = -1
    if ret_ty != types.named(TK_VOID) {
        ty35 = ret_ty
    }
    var inst = ir.new_inst(g_cur_block, 35, ty35)  // call
    ir.add_operand(inst, sym, 0)
    ir.add_operand(inst, ret_ty, 2)
    k = 0
    while k < nparams {
        ir.add_operand(inst, ptys[k], 2)
        ir.add_operand(inst, ir.param_val(fid, 1 + k), 0)
        k = k + 1
    }
    // ret（void → ret void；其余 → ret 调用结果）
    if ret_ty == types.named(TK_VOID) {
        var ret = ir.new_inst(g_cur_block, 32, -1)  // ret void
    } else {
        var ret = ir.new_inst(g_cur_block, 32, ret_ty)
        ir.add_operand(ret, ir.get_value(inst), 0)
    }
    // 恢复调用方上下文
    g_cur_func = saved_func
    g_cur_block = saved_block
    // 闭包值 {null, @adapt_<id>}（无捕获 → env = null）
    var env_v = gen_int_lit(0)  // null（store 时 to_ptr → inttoptr 0 to ptr）
    var entry_v = gen_func_addr(adap)
    return make_tuple2(env_v, types.named(TK_STR), entry_v, types.named(TK_STR), fnty)
}

}


