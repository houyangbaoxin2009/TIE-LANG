type tie<class>
// compiler/backend/irgen_lit.tie —— 生成器 L1 字面量层 子模块
// ============================================================
// 从 irgen.tie 拆分而来：这是 irgen LLVM 风格分层重构的 S2 步。
// 本文件承载 L1 字面量/常量层：整数（tig_int_lit/tig_int_lit_ty）、字符串
//（tig_str_lit）、浮点（tig_float_lit/tig_float_lit_ty）、字符（tig_char_lit）、
// 三进制（tig_trit_lit）、布尔（tig_bool_lit）字面量，外加三目运算
//（tig_ternary）与字符串反转义/切片（str_unescape_quoted/str_slice）。
// 它们生成 const_i/const_str/const_f 等常量指令，被上层语句/表达式生成层裸名调用。
//
// 拆分范式：【同 namespace 跨文件】（文本内联）。
// 同 irgen_builder.tie（S1）。irgen.tie 顶层 import 本文件后，本文件被文本内联
// 进同一编译单元，声明与 irgen.tie 相同的 `namespace irgen`，同名 namespace
// 跨文件闭合并集：
//   - 同 namespace 函数可互相裸名调用（主文件照常裸名调用 tig_int_lit 等）；
//   - 可访问主文件顶层全局 var（g_cur_block/g_cur_func 等）；
//   - 本文件只含函数与注释，不含顶层全局 var 声明、不含 import——
//     全局 var 与 import 树均留在 irgen.tie 主文件，避免重复定义。
namespace irgen {
// 常量：int 字面量 → const_i 指令（值 id 为操作数）
// ty 为结果类型（默认调用方传 i64；i32 变量初始化用 tig_int_lit_ty）
func tig_int_lit(val: i64) -> i64 {
    return tig_int_lit_ty(val, types.named(TK_I64))
}
// 按指定类型生成 int 常量（i32/i64 等）：const_i 结果类型跟随存储目标，
// 避免 llvmgen 的 store 类型不匹配（见 tig_stmt VarDecl 说明）。
func tig_int_lit_ty(val: i64, ty: i64) -> i64 {
    var inst = ir.new_inst(g_cur_block, 60, ty)  // const_i
    ir.add_operand(inst, val, 2)  // OK_IMM 立即数
    return ir.get_value(inst)
}
// 字符串字面量 → const_str 指令（操作数 = 字符串池 id；llvmgen 经 interner 还原文本）。
// 自举前端把字符串字面量的 lexeme 原样存池（**带引号**，反转义留待消费方），
// 故此处先 str_unescape_quoted 去引号 + 反转义，再登记纯文本池 id——
// 否则生成的 @.str.N 会含 \22 引号（Rust 参考 AST 存去引号文本）。
// 结果值：const_str 在 llvmgen 生成 `%N = ptrtoint ptr @.str.N to i64`——必须有结果
// 寄存器，故 ty 用 i64（TK_I64）而非 -1（new_inst 对 ty<0 不分配结果值）。
func tig_str_lit(name_id: i64) -> i64 {
    var clean = str_unescape_quoted(name_id)
    var inst = ir.new_inst(g_cur_block, 62, types.named(TK_I64))  // const_str, i64 结果
    ir.add_operand(inst, clean, 0)  // OK_VALUE 字符串池 id
    return ir.get_value(inst)
}
// 浮点字面量 → const_f 指令（操作数 = 浮点文本的字符串池 id）。
// lexeme 来自词法 lex_float（必然合法，parse_float 编译期执行不会失败）；
// llvmgen 端按 LLVM 语法规范化（补小数点）后输出 fadd double <lit>, 0.0。
func tig_float_lit(name_id: i64) -> i64 {
    return tig_float_lit_ty(name_id, types.named(TK_F64))
}
// 按目标类型生成浮点常量（S1.3 f32：`var d = 1.5f32` → const_f float；
// llvmgen 按 ins_ty 输出 float/double）
func tig_float_lit_ty(name_id: i64, ty: i64) -> i64 {
    var inst = ir.new_inst(g_cur_block, 51, ty)  // const_f
    ir.add_operand(inst, name_id, 0)  // OK_VALUE 浮点文本池 id（原 lexeme）
    return ir.get_value(inst)
}
// 字符字面量 → i32 码点常量（对齐 Rust CharLit → (c as i32, "i32")）。
// lexeme 形如 "'a'" / "'\n'"（带引号）：去引号 + 反转义 → 单字符 → 码点。
func tig_char_lit(name_id: i64) -> i64 {
    var raw = interner.lookup(name_id)
    var n: i64 = str_len(raw)
    if n >= 3 && str_char(raw, 0) == "'" && str_char(raw, n - 1) == "'" {
        raw = str_slice(raw, 1, n - 1)
    }
    // 转义处理（与 str_unescape_quoted 同款字符集）
    var ch: string = ""
    var m: i64 = str_len(raw)
    if m >= 2 && str_char(raw, 0) == "\\" {
        var e = str_char(raw, 1)
        if e == "n" {
            ch = "\n"
        } else if e == "t" {
            ch = "\t"
        } else if e == "r" {
            ch = "\r"
        } else if e == "\\" {
            ch = "\\"
        } else if e == "'" {
            ch = "'"
        } else if e == "0" {
            ch = "\0"
        } else {
            // 未知转义：取转义字符本身（与字符串保留反斜杠不同——字符无歧义）
            ch = e
        }
    } else {
        ch = str_char(raw, 0)
    }
    var cp = char_code(ch)  // 语言底座原语（编译期执行，取码点）
    var inst = ir.new_inst(g_cur_block, 60, types.named(TK_CHAR))  // const_i i32
    ir.add_operand(inst, cp, 2)  // OK_IMM 码点
    return ir.get_value(inst)
}
// trit 字面量 → i8 常量（值域 -1/0/1；driver 树仅 lex_zero → 0）
func tig_trit_lit(v: i64) -> i64 {
    var inst = ir.new_inst(g_cur_block, 60, types.named(TK_I8))  // const_i i8
    ir.add_operand(inst, v, 2)  // OK_IMM
    return ir.get_value(inst)
}
// 三目运算 cond ? then : else：三块短路 + phi 汇合（对齐 Rust tig_expr Ternary）。
// AST：Ternary[children=[cond, then, else]]；then/else 为表达式（无 return），
// 分支内必然以 br merge 结束，无需 block_terminated 检查。
func tig_ternary(id: i64) -> i64 {
    var cond = tig_expr(sstate.child(id, 0))
    if cond < 0 {
        return -1
    }
    var then_blk = ir.new_block(g_cur_func, interner.intern("tern.then"))
    var else_blk = ir.new_block(g_cur_func, interner.intern("tern.else"))
    var merge_blk = ir.new_block(g_cur_func, interner.intern("tern.merge"))
    var cbr = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbr, cond, 0)
    ir.add_operand(cbr, then_blk, 1)
    ir.add_operand(cbr, else_blk, 1)
    // then 分支
    g_cur_block = then_blk
    var tv = tig_expr(sstate.child(id, 1))
    if tv < 0 {
        return -1
    }
    var tv_blk = g_cur_block  // 嵌套短路时值实际产生块
    var br1 = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(br1, merge_blk, 1)
    // else 分支
    g_cur_block = else_blk
    var ev = tig_expr(sstate.child(id, 2))
    if ev < 0 {
        return -1
    }
    var ev_blk = g_cur_block
    var br2 = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(br2, merge_blk, 1)
    // merge：phi 汇合（类型取 then 分支语义类型；兜底 i64）
    g_cur_block = merge_blk
    var pty = node_types[sstate.child(id, 1)]
    if pty < 0 {
        pty = types.named(TK_I64)
    }
    var phi = ir.new_inst(g_cur_block, 33, pty)
    ir.add_operand(phi, tv, 0)
    ir.add_operand(phi, tv_blk, 1)
    ir.add_operand(phi, ev, 0)
    ir.add_operand(phi, ev_blk, 1)
    return ir.get_value(phi)
}
// 字符串字面量 lexeme（带引号）→ 纯文本池 id：去首尾引号 + 反转义
// （\n \t \r \\ \" \' \0，与词法 scan_string 的转义集一致）。
// 返回重新 intern 的纯文本池 id。
func str_unescape_quoted(name_id: i64) -> i64 {
    var raw = interner.lookup(name_id)
    var n: i64 = str_len(raw)
    // 去首尾引号（带引号 lexeme 的约定形态）
    if n >= 2 && str_char(raw, 0) == "\"" && str_char(raw, n - 1) == "\"" {
        raw = str_slice(raw, 1, n - 1)
    }
    var out: string = ""
    var i: i64 = 0
    var m: i64 = str_len(raw)
    while i < m {
        var c = str_char(raw, i)
        if c == "\\" && i + 1 < m {
            var e = str_char(raw, i + 1)
            if e == "n" {
                out = out + "\n"
                i = i + 2
            } else if e == "t" {
                out = out + "\t"
                i = i + 2
            } else if e == "r" {
                out = out + "\r"
                i = i + 2
            } else if e == "\\" {
                out = out + "\\"
                i = i + 2
            } else if e == "\"" {
                out = out + "\""
                i = i + 2
            } else if e == "'" {
                out = out + "'"
                i = i + 2
            } else if e == "0" {
                out = out + "\0"
                i = i + 2
            } else {
                // 未知转义：原样保留反斜杠
                out = out + c
                i = i + 1
            }
        } else {
            out = out + c
            i = i + 1
        }
    }
    return interner.intern(out)
}
// 取字符串 [start, end) 子串（码点级）。str_unescape_quoted 的内部辅助。
// 性能重写（O(n)）：字节定位 + StringBuilder 拷贝（旧逐字符拼接 O(n²)）
func str_slice(s: string, start: i64, end: i64) -> string {
    var n: i64 = str_len(s)
    if start < 0 {
        start = 0
    }
    if end > n {
        end = n
    }
    if start >= end {
        return ""
    }
    var b: i64 = 0
    var i: i64 = 0
    var bstart: i64 = 0
    while i < end {
        if i == start {
            bstart = b
        }
        b = b + utf8_seq_len(s, b)
        i = i + 1
    }
    var sb = string_builder()
    var k: i64 = bstart
    while k < b {
        sb_append_byte(sb, str_byte(s, k))
        k = k + 1
    }
    return sb_build(sb)
}
// bool 字面量 → i1 常量（phi 短路分支用；add 0, v 形式）
func tig_bool_lit(v: i64) -> i64 {
    var inst = ir.new_inst(g_cur_block, 60, types.named(TK_BOOL))
    ir.add_operand(inst, v, 2)
    return ir.get_value(inst)
}
}