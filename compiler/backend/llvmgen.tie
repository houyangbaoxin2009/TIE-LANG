// tie:library
// compiler/backend/llvmgen.tie —— 自举 v2 T2.8：tie-IR → LLVM IR 文本生成
// ============================================================
// 里程碑：自举 v2 计划 T2.8（.omo/plans/self-hosting-v2.md）后端 LLVM IR
// 文本生成器。本文件 = tie-IR 列式表 → .ll 文本（Rust ir.rs run() 契约）。
// 最小可行集：模块头/declare/define/entry 块/指令映射/字符串常量。
// **字符串自省**：遍历 tie-IR 的 const_str(62)/call_vararg(41) 指令收集
// 字符串池 id，经 interner.lookup 还原文本生成 @.str.N（不依赖 irgen）。
// 依赖：./../middle/ir.tie（tie-IR 表访问）。
// types.tie 经 irgen→semantic→…→stype→data 树传递可达（K_NAMED/TK_*）；
// str_char/char_code/str_len/to_string 为语言底座原语（全局可见，无需 import）；
// intern 经 irgen→semantic→…→lex_tokdefs→interner 树传递可达。
// 唯一直接 import ir.tie：避免菱形 import 导致全局变量重复定义。
// 树式无环：irgen import 本文件（本文件不 import irgen）。
// UTF-8 字节级能力复用 std/utf（hex_escape/utf8_bytes/byte_len），
// 不再内联重复实现（编译器自举后亦可继续依赖 std——std 亦为 tie 自写）。
import "./../middle/ir.tie"
import "../../std/utf.tie"

// ==================== 输出缓冲 ====================
// 行收集表：line() 只追加（O(1)），emit() 末尾分治拼接成完整文本。
// 避免 `out_buf = out_buf + s` 的 O(N²) 全量拷贝——tie 字符串不可变，
// str_cat 每次 malloc 新串且旧串无 GC 回收，自编译（10 万级行）会挂起
// 并耗尽内存（曾实测 30s+ / 2.3GB）。
var out_lines: table<string>;
// 值 id → 定义指令 id 索引（value_def 缓存）：值 id 从 0 连续分配
// （ir.new_value 单调递增），直接作表下标 → O(1) 查询，替代全指令
// 线性扫描的 O(N²)（每条指令的每个实参引用都全扫一遍）。
var vdef_cache: table<i64>;
var vdef_cache_ready: i64 = 0;
// 调试：当前生成函数 id（gen_inst 的细粒度诊断用；0 = 未生成，真实 fid 从 0 起）
var g_pfid: i64 = 0;
// 当前函数参数个数（opnd_ref 形参映射用）
var g_pcnt: i64 = 0;
// 指令 id → 块 id 映射（emit 开头构建一次；gen_func 按指令序遍历用）。
// 块 id 创建序 ≠ 值 id 分配序（if/while 嵌套：then/else/merge 块先创建、
// 循环头块后创建）——按块 id 遍历会值编号回退，LLVM 解析拒绝。
var g_inst_blk: table<i64>;
var g_inst_blk_ready: i64 = 0;
// 字符串常量表：池 id → @.str.N 序号（自省收集）
var str_pool: table<i64>;   // 字符串池 id（登记序）
var str_idx: table<i64>;    // 对应 @.str.N
var str_count: i64 = 0;
// printf i32 实参 sext 的新寄存器计数（LLVM 不支持内联 sext 表达式实参，
// 每处 i32 实参生成一个独立 %ext<N> 寄存器）
var g_sext_cnt: i64 = 0;
// T4.5：extern_call(36) 收集的符号名池 id（去重登记序；llvmgen 顶层变量，
// 与 out_buf 等同级——命名空间体内不允许 var）
var ext_syms: table<i64>;
// 阶段 A：全局变量登记（名池 id → 表/标量 + 类型）。表全局 → ptr null 占位
// + main 入口初始化；标量 → 零值 global。
var g_global_names: table<i64>;   // 全局名池 id（登记序）
var g_global_is_table: table<i64>;  // 1 = 表全局（ptr null），0 = 标量
var g_global_tys: table<i64>;     // 标量类型 id（表全局 -1）
var g_global_inits: table<i64>;   // const 标量初始值（-1 = 无；i64 字面量）
var g_global_strs: table<i64>;    // 顶层字符串 const 初始值（字符串池 id；-1 = 无）
// 阶段 A：用户函数调用（call 35）的符号名池 id（去重，与 ext_syms 平行收集；
// 命名空间函数全名经 ns_symbol 转 $，无需 declare）
var call_syms: table<i64>;
// 阶段 A：str_cat 内联序列的临时寄存器计数（与 printf sext 同款独立命名空间，
// 避免与 %N 值编号冲突）
var g_str_reg_cnt: i64 = 0;

namespace llvmgen {

// 全局变量登记：表全局（global ptr null + main 初始化）/ 标量（零值 global）。
// 供 irgen.gen_global_var 调用（driver 树顶层 VarDecl 439 个）。
pub func global_table_reg(nm: string) {
    var nid = interner.intern(nm)
    table_push(g_global_names, nid)
    table_push(g_global_is_table, 1)
    table_push(g_global_tys, -1)
    table_push(g_global_inits, -1)
    table_push(g_global_strs, -1)
}

pub func global_scalar_reg(nm: string, ty: i64) {
    var nid = interner.intern(nm)
    table_push(g_global_names, nid)
    table_push(g_global_is_table, 0)
    table_push(g_global_tys, ty)
    table_push(g_global_inits, -1)
    table_push(g_global_strs, -1)
}

// const 标量初始值（i64 字面量）：emit_globals 输出 @g = global i64 <v>
pub func global_scalar_init(nm: string, v: i64) {
    var nid = interner.intern(nm)
    var i: i64 = 0
    while i < len(g_global_names) {
        if g_global_names[i] == nid {
            g_global_inits[i] = v
            return
        }
        i = i + 1
    }
}

// 顶层字符串 const 初始值：emit_globals 输出 @g = global ptr @.str.N（字面量）
pub func global_str_init(nm: string, lexeme_id: i64) {
    var nid = interner.intern(nm)
    var i: i64 = 0
    while i < len(g_global_names) {
        if g_global_names[i] == nid {
            // 去引号 lexeme → 纯文本池 id（与 gen_str_lit 同款）
            var clean = lexeme_id
            var txt = intern.lookup(lexeme_id)
            var n: i64 = str_len(txt)
            if n >= 2 && str_char(txt, 0) == "\"" && str_char(txt, n - 1) == "\"" {
                var sub: string = ""
                var k: i64 = 1
                while k < n - 1 {
                    sub = sub + str_char(txt, k)
                    k = k + 1
                }
                clean = interner.intern(sub)
            }
            g_global_strs[i] = clean
            return
        }
        i = i + 1
    }
}

// 全局表是否已登记（irgen 查表变量语义类型用）
func global_is_table(nm: string) -> i64 {
    var nid = interner.intern(nm)
    var i: i64 = 0
    while i < len(g_global_names) {
        if g_global_names[i] == nid {
            return g_global_is_table[i]
        }
        i = i + 1
    }
    return 0
}

// 输出聚合类型段（模块头 declare 之后、全局变量之前）：
// 遍历语义层已登记的 struct（st_keys/st_vals + cls_* + fld_*），
// 输出 `%struct.<名> = type { 字段类型... }`（元组内联在 llvm_ty，无需定义）。
func emit_agg_types() {
    var n = len(st_vals)
    var i: i64 = 0
    while i < n {
        var si = st_vals[i]
        var off = cls_fldoff[si]
        var cnt = cls_nfld[si]
        var out: string = "%struct." + intern.lookup(st_keys[i]) + " = type {"
        var j: i64 = 0
        while j < cnt {
            if j > 0 {
                out = out + ","
            }
            out = out + " " + llvm_ty(fld_tys[off + j])
            j = j + 1
        }
        out = out + " }"
        line(out)
        i = i + 1
    }
    if len(st_vals) > 0 {
        line("")
    }
}

// 输出全局变量段（模块头 declare 之后、函数 define 之前）：
//   @g = global ptr null            （表全局，main 入口运行时创建）
//   @g = global T <零值>             （标量；i64→0 / bool→false / string→null / f64→0.0）
func emit_globals() {
    var i: i64 = 0
    while i < len(g_global_names) {
        var nm = intern.lookup(g_global_names[i])
        if g_global_is_table[i] == 1 {
            line("@" + nm + " = global ptr null")
        } else {
            var ty = llvm_ty(g_global_tys[i])
            var init = "0"
            // const 整数字面量初始值（i64 字面量直接输出；其余保持零值）
            if i < len(g_global_inits) && g_global_inits[i] >= 0 && ty == "i64" {
                init = to_string(g_global_inits[i])
            }
            if ty == "ptr" {
                // string 全局默认空串常量（null 会被 strcmp 段错误）；
                // const 字符串全局有初始字面量 → 指向该字面量常量
                if g_global_tys[i] == TK_STR {
                    var eslot = 0
                    if i < len(g_global_strs) && g_global_strs[i] >= 0 {
                        eslot = str_slot(g_global_strs[i])
                    } else {
                        var empty_id = interner.intern("")
                        eslot = str_slot(empty_id)
                    }
                    line("@" + nm + " = global ptr @.str." + to_string(eslot))
                    i = i + 1
                    continue
                }
                init = "null"
            } else if ty == "i1" {
                init = "false"
            } else if ty == "double" {
                init = "0.0"
            } else if ty == "float" {
                init = "0.0"
            }
            line("@" + nm + " = global " + ty + " " + init)
        }
        i = i + 1
    }
    if len(g_global_names) > 0 {
        line("")
    }
}

// 用户函数调用（call 35）符号登记（去重；命名空间函数全名 → $）
pub func call_sym_reg(sid: i64) {
    var dup = false
    var k: i64 = 0
    while k < len(call_syms) {
        if call_syms[k] == sid {
            dup = true
            break
        }
        k = k + 1
    }
    if !dup {
        table_push(call_syms, sid)
    }
}

// 查找子串位置（-1 = 无）
func find_sub(s: string, sub: string) -> i64 {
    var n = str_len(s)
    var m = str_len(sub)
    if m == 0 || n < m {
        return -1
    }
    var i: i64 = 0
    while i + m <= n {
        var j: i64 = 0
        var ok = true
        while j < m {
            if str_char(s, i + j) != str_char(sub, j) {
                ok = false
                break
            }
            j = j + 1
        }
        if ok {
            return i
        }
        i = i + 1
    }
    return -1
}

// 命名空间全名 → LLVM 符号：全部 `::` 转 `$`（sstate::child → sstate$child）
func ns_replace(s: string) -> string {
    var out: string = ""
    var i: i64 = 0
    var n = str_len(s)
    while i < n {
        if i + 1 < n && str_char(s, i) == ":" && str_char(s, i + 1) == ":" {
            out = out + "$"
            i = i + 2
        } else {
            out = out + str_char(s, i)
            i = i + 1
        }
    }
    return out
}

func line(s: string) {
    table_push(out_lines, s)
}

// 行表 → 完整 .ll 文本：分治两两合并。
// 每层合并拷贝总量 ≈ 最终大小，共 log₂N 层（总拷贝 O(total·log N)），
// 且每行只参与 log N 次拼接——相比逐行追加的 O(N²) 全量拷贝是数量级差异。
// 行语义与旧 line() 一致：每行自带尾随 "\n"（N 行 = N 个换行）。
func join_lines() -> string {
    var cur = out_lines
    var n = len(cur)
    if n == 0 {
        return ""
    }
    while n > 1 {
        var nxt = table_new_string()
        var i: i64 = 0
        while i + 1 < n {
            table_push(nxt, cur[i] + "\n" + cur[i + 1])
            i = i + 2
        }
        if i < n {
            table_push(nxt, cur[i])
        }
        cur = nxt
        n = len(cur)
    }
    return cur[0] + "\n"
}

// ==================== 类型映射 ====================
// types 自编码 → LLVM 类型名
func llvm_ty(t: i64) -> string {
    if t == TK_VOID {
        return "void"
    }
    if t == TK_I8 || t == TK_U8 {
        return "i8"
    }
    if t == TK_I16 || t == TK_U16 {
        return "i16"
    }
    if t == TK_I32 || t == TK_U32 {
        return "i32"
    }
    if t == TK_I64 || t == TK_U64 {
        return "i64"
    }
    if t == TK_F32 {
        return "float"
    }
    if t == TK_F64 {
        return "double"
    }
    if t == TK_BOOL {
        return "i1"
    }
    if t == TK_CHAR {
        return "i32"
    }
    if t == TK_TRIT {
        // 平衡三进制：i8 存储（值域 -1/0/1），对齐 Rust ir.rs（TritLit → i8）
        return "i8"
    }
    // 元组/struct 聚合类型（M4/M6 扩展）：
    //   元组 → 内联结构体文本 {f0, f1, ...}（字段类型递归展开）；
    //   struct → 命名结构体 %struct.<名字>（emit_agg_types 输出 type 定义）。
    // 对齐 Rust llvm_ty 的 Tuple/Struct 映射（元组内联、类命名）。
    var agg_k = types.kind(t)
    if agg_k == K_TUPLE {
        var tidx = t - BASE_TUPLE
        var toff = tup_offs[tidx]
        var tn = tup_n[tidx]
        var tout: string = "{"
        var ti: i64 = 0
        while ti < tn {
            if ti > 0 {
                tout = tout + ", "
            }
            tout = tout + llvm_ty(tup_tys[toff + ti])
            ti = ti + 1
        }
        return tout + "}"
    }
    if agg_k == K_STRUCT {
        var sidx2 = t - BASE_STRUCT
        return "%struct." + sstate.struct_name_of(sidx2)
    }
    // string/table/map 等 → ptr（引用类型）
    return "ptr"
}

// ==================== 字符串自省 ====================
// 查找/登记字符串池 id → @.str.N 序号
func str_slot(name_id: i64) -> i64 {
    var i: i64 = 0
    while i < len(str_pool) {
        if str_pool[i] == name_id {
            return str_idx[i]
        }
        i = i + 1
    }
    var n = str_count
    table_push(str_pool, name_id)
    table_push(str_idx, n)
    str_count = str_count + 1
    return n
}

// 遍历 tie-IR 全部指令，收集 const_str(62) 与 call_vararg(41) 的字符串操作数
func collect_strings() {
    str_pool = table_new_i64()
    str_idx = table_new_i64()
    str_count = 0
    var ni = ir.inst_count()
    var i: i64 = 0
    while i < ni {
        var op = ir.ins_op(i)
        var cnt = ir.ins_ops_cnt(i)
        var k: i64 = 0
        if op == 62 {
            // const_str：操作数[0] = 字符串池 id
            if cnt >= 1 {
                str_slot(ir.ins_opnd(i, 0))
            }
        } else if op == 41 {
            // call_vararg：操作数[0] = 格式串池 id
            if cnt >= 1 {
                str_slot(ir.ins_opnd(i, 0))
            }
        }
        i = i + 1
    }
}

// T4.5：遍历全部指令，收集 extern_call(36) 的符号名池 id（去重）。
// 符号名经 interner 还原文本；emit_extern_decls 按符号名输出 declare。
// 阶段 A：同时收集 call(35) 用户函数符号（call_syms；无需 declare，本模块定义）。
func collect_externs() {
    ext_syms = table_new_i64()
    call_syms = table_new_i64()
    var ni = ir.inst_count()
    var i: i64 = 0
    while i < ni {
        var op = ir.ins_op(i)
        if op == 36 && ir.ins_ops_cnt(i) >= 1 {
            var sid = ir.ins_opnd(i, 0)
            var dup = false
            var k: i64 = 0
            while k < len(ext_syms) {
                if ext_syms[k] == sid {
                    dup = true
                    break
                }
                k = k + 1
            }
            if !dup {
                table_push(ext_syms, sid)
            }
        } else if op == 35 && ir.ins_ops_cnt(i) >= 1 {
            var sid2 = ir.ins_opnd(i, 0)
            call_sym_reg(sid2)
        }
        i = i + 1
    }
}

// 符号名 → declare 声明文本（tie 运行时桥签名表；未登记符号返回空串）。
// 与 std/runtime.tie / tie_interp.lib 的导出符号一一对应（阶段 A 扩展）：
//   返回 i64：tie_exec_code(ptr) / tie_time_now() / tie_str_len(ptr) /
//            tie_char_code(ptr) / tie_arg_count() / tie_table_len(ptr) /
//            tie_parse_int(ptr, ptr)
//   返回 ptr：tie_get_env(ptr) / tie_exec_output(ptr) / tie_str_char(ptr, i64) /
//            tie_to_string_i64(i64) / tie_to_string_f64(double) / tie_file_read(ptr) /
//            tie_arg_string(i64) / tie_table_new(i64) / tie_table_at_i64(ptr, i64, ptr) /
//            tie_table_at_string(ptr, i64, ptr) / tie_print_err(ptr) / tie_mkdir_all(ptr) /
//            tie_regex_find_all(ptr, ptr) / tie_read_line() / tie_cwd() / tie_eval_expr(ptr)
//   返回 void：tie_table_push_i64(ptr, i64) / tie_table_push_string(ptr, ptr) /
//            tie_table_push_bool(ptr, i8) / tie_table_set_i64(ptr, i64, i64, ptr) /
//            tie_table_set_string(ptr, i64, ptr, ptr) / tie_byte_write(ptr, ptr) /
//            tie_set_env(ptr, ptr) / tie_msg_register(ptr, ptr, ptr)
//   返回 i8：tie_mkdir_all(ptr) / tie_file_copy(ptr, ptr) / tie_file_move(ptr, ptr) /
//            tie_http_get_file(ptr, ptr) / tie_untar_gz(ptr, ptr) / tie_unzip(ptr, ptr) /
//            tie_copy_dir(ptr, ptr) / tie_byte_write(ptr, ptr)
// 注意：返回 void 的桥在 irgen 用 ty=-1 建指令（无结果寄存器）。
func extern_decl(sym: string) -> string {
    if sym == "tie_exec_code" {
        return "declare i64 @tie_exec_code(ptr)"
    }
    if sym == "tie_get_env" {
        return "declare ptr @tie_get_env(ptr)"
    }
    if sym == "tie_time_now" {
        return "declare i64 @tie_time_now()"
    }
    if sym == "tie_str_len" {
        return "declare i64 @tie_str_len(ptr)"
    }
    if sym == "tie_char_code" {
        return "declare i64 @tie_char_code(ptr)"
    }
    if sym == "tie_str_char" {
        return "declare ptr @tie_str_char(ptr, i64)"
    }
    if sym == "tie_to_string_i64" {
        return "declare ptr @tie_to_string_i64(i64)"
    }
    if sym == "tie_to_string_f64" {
        return "declare ptr @tie_to_string_f64(double)"
    }
    if sym == "tie_parse_int" {
        return "declare i64 @tie_parse_int(ptr, ptr)"
    }
    if sym == "tie_parse_float" {
        return "declare double @tie_parse_float(ptr, ptr)"
    }
    if sym == "tie_parse_trit" {
        return "declare i8 @tie_parse_trit(ptr, ptr)"
    }
    if sym == "tie_list_dir" {
        return "declare ptr @tie_list_dir(ptr)"
    }
    if sym == "tie_http_get" {
        return "declare ptr @tie_http_get(ptr)"
    }
    if sym == "tie_msg_t_lang" {
        return "declare ptr @tie_msg_t_lang(ptr, ptr)"
    }
    if sym == "tie_set_env" {
        return "declare void @tie_set_env(ptr, ptr)"
    }
    if sym == "tie_msg_register" {
        return "declare void @tie_msg_register(ptr, ptr, ptr)"
    }
    if sym == "tie_byte_write" {
        return "declare i8 @tie_byte_write(ptr, ptr)"
    }
    if sym == "tie_exec_output" {
        return "declare ptr @tie_exec_output(ptr)"
    }
    if sym == "tie_arg_count" {
        return "declare i64 @tie_arg_count()"
    }
    if sym == "tie_arg_string" {
        return "declare ptr @tie_arg_string(i64)"
    }
    if sym == "tie_file_read" {
        return "declare ptr @tie_file_read(ptr)"
    }
    if sym == "tie_read_line" {
        return "declare ptr @tie_read_line()"
    }
    if sym == "tie_eval_expr" {
        return "declare ptr @tie_eval_expr(ptr)"
    }
    if sym == "tie_cwd" {
        return "declare ptr @tie_cwd()"
    }
    if sym == "tie_print_err" {
        return "declare void @tie_print_err(ptr)"
    }
    if sym == "tie_table_new" {
        return "declare ptr @tie_table_new(i64)"
    }
    if sym == "tie_table_push_i64" {
        return "declare void @tie_table_push_i64(ptr, i64)"
    }
    if sym == "tie_table_push_string" {
        return "declare void @tie_table_push_string(ptr, ptr)"
    }
    if sym == "tie_table_push_bool" {
        return "declare void @tie_table_push_bool(ptr, i8)"
    }
    if sym == "tie_table_push_f64" {
        return "declare void @tie_table_push_f64(ptr, double)"
    }
    if sym == "tie_table_at_i64" {
        return "declare i64 @tie_table_at_i64(ptr, i64, ptr)"
    }
    if sym == "tie_table_at_f64" {
        return "declare double @tie_table_at_f64(ptr, i64, ptr)"
    }
    if sym == "tie_table_at_ptr" {
        return "declare ptr @tie_table_at_ptr(ptr, i64, ptr)"
    }
    if sym == "tie_table_at_string" {
        return "declare ptr @tie_table_at_string(ptr, i64, ptr)"
    }
    if sym == "tie_table_at_bool" {
        return "declare i8 @tie_table_at_bool(ptr, i64, ptr)"
    }
    if sym == "tie_table_len" {
        return "declare i64 @tie_table_len(ptr)"
    }
    if sym == "tie_table_set_i64" {
        return "declare void @tie_table_set_i64(ptr, i64, i64, ptr)"
    }
    if sym == "tie_table_set_f64" {
        return "declare void @tie_table_set_f64(ptr, i64, double, ptr)"
    }
    if sym == "tie_table_set_ptr" {
        return "declare void @tie_table_set_ptr(ptr, i64, ptr, ptr)"
    }
    if sym == "tie_table_set_string" {
        return "declare void @tie_table_set_string(ptr, i64, ptr, ptr)"
    }
    if sym == "tie_mkdir_all" {
        return "declare i8 @tie_mkdir_all(ptr)"
    }
    if sym == "tie_file_copy" {
        return "declare i8 @tie_file_copy(ptr, ptr)"
    }
    if sym == "tie_file_move" {
        return "declare i8 @tie_file_move(ptr, ptr)"
    }
    if sym == "tie_http_get_file" {
        return "declare i8 @tie_http_get_file(ptr, ptr)"
    }
    if sym == "tie_untar_gz" {
        return "declare i8 @tie_untar_gz(ptr, ptr)"
    }
    if sym == "tie_unzip" {
        return "declare i8 @tie_unzip(ptr, ptr)"
    }
    if sym == "tie_copy_dir" {
        return "declare i8 @tie_copy_dir(ptr, ptr)"
    }
    if sym == "tie_regex_find_all" {
        return "declare ptr @tie_regex_find_all(ptr, ptr)"
    }
    if sym == "tie_regex_match" {
        return "declare i8 @tie_regex_match(ptr, ptr, ptr)"
    }
    if sym == "tie_regex_find" {
        return "declare ptr @tie_regex_find(ptr, ptr)"
    }
    if sym == "tie_regex_group" {
        return "declare ptr @tie_regex_group(ptr, ptr, i64)"
    }
    if sym == "tie_regex_replace" {
        return "declare ptr @tie_regex_replace(ptr, ptr, ptr)"
    }
    if sym == "tie_msg_t" {
        return "declare ptr @tie_msg_t(ptr)"
    }
    if sym == "tie_msg_get_lang" {
        return "declare ptr @tie_msg_get_lang()"
    }
    if sym == "tie_msg_set_lang" {
        return "declare void @tie_msg_set_lang(ptr)"
    }
    if sym == "tie_eval_call" {
        return "declare ptr @tie_eval_call(ptr, ptr)"
    }
    if sym == "tie_byte_read" {
        return "declare ptr @tie_byte_read(ptr)"
    }
    if sym == "tie_byte_concat" {
        return "declare ptr @tie_byte_concat(ptr, ptr)"
    }
    if sym == "tie_bit_read" {
        return "declare i64 @tie_bit_read(ptr, i64)"
    }
    if sym == "tie_bit_write" {
        return "declare i8 @tie_bit_write(ptr, i64, i64)"
    }
    if sym == "tie_remove_dir_all" {
        return "declare i8 @tie_remove_dir_all(ptr)"
    }
    if sym == "tie_walk_dir" {
        return "declare ptr @tie_walk_dir(ptr)"
    }
    if sym == "tie_path_basename" {
        return "declare ptr @tie_path_basename(ptr)"
    }
    if sym == "tie_path_dirname" {
        return "declare ptr @tie_path_dirname(ptr)"
    }
    if sym == "tie_path_abs" {
        return "declare ptr @tie_path_abs(ptr)"
    }
    if sym == "tie_path_normalize" {
        return "declare ptr @tie_path_normalize(ptr)"
    }
    if sym == "tie_path_join" {
        return "declare ptr @tie_path_join(ptr, ptr)"
    }
    if sym == "tie_rand_range" {
        return "declare i64 @tie_rand_range(i64, i64, ptr)"
    }
    return ""
}

// 输出 extern_call 收集到的 declare（模块头，无条件 declare 之后）。
func emit_extern_decls() {
    var i: i64 = 0
    while i < len(ext_syms) {
        var d = extern_decl(intern.lookup(ext_syms[i]))
        if d != "" {
            line(d)
        }
        i = i + 1
    }
    if len(ext_syms) > 0 {
        line("")
    }
}

// 字符串文本 → LLVM 转义（对齐 Rust escape_ir_string：可打印 ASCII 原样，
// 特殊字符 \XX 十六进制；含中文等非 ASCII 码点逐字节转义）
func escape_str(s: string) -> string {
    var out: string = ""
    var n = str_len(s)
    var i: i64 = 0
    while i < n {
        var cc = char_code(str_char(s, i))
        if cc == 92 {
            out = out + "\\5C"
        } else if cc == 34 {
            out = out + "\\22"
        } else if cc == 10 {
            out = out + "\\0A"
        } else if cc == 13 {
            out = out + "\\0D"
        } else if cc == 9 {
            out = out + "\\09"
        } else if cc >= 32 && cc <= 126 {
            out = out + str_char(s, i)
        } else {
            // 非 ASCII 码点（含中文）或 ASCII 控制字符：按 UTF-8 字节序列 \XX 转义
            // （std/utf.hex_escape 字节级编码；码点值 ≠ UTF-8 字节序列）
            out = out + utf.hex_escape(cc)
        }
        i = i + 1
    }
    return out
}

// 输出字符串常量节（模块末尾）
func emit_strings() {
    var i: i64 = 0
    while i < len(str_pool) {
        var txt = intern.lookup(str_pool[i])
        var byte_len = utf.byte_len(txt)
        var esc = escape_str(txt)
        line("@.str." + to_string(str_idx[i]) + " = private unnamed_addr constant [" +
            to_string(byte_len + 1) + " x i8] c\"" + esc + "\\00\"")
        i = i + 1
    }
}

// ==================== 指令映射 ====================
// 操作数引用：OK_VALUE(0) → %N；OK_BLOCK(1) → label；OK_IMM(2) → 立即数
// 参数值 id → 形参位置（-1 = 非参数）。
// 参数值 id 是全局编号，LLVM 形参按位置 %0..%n-1 命名，须映射。
func param_pos(v: i64) -> i64 {
    var i: i64 = 0
    while i < g_pcnt {
        if ir.param_val(g_pfid, i) == v {
            return i
        }
        i = i + 1
    }
    return -1
}

// 参数值 id → 形参位置引用（"%0"..；非参数返回空串）
func param_ref(v: i64) -> string {
    var p = param_pos(v)
    if p < 0 {
        return ""
    }
    return "%" + to_string(p)
}

func opnd_ref(inst_id: i64, k: i64) -> string {
    var v = ir.ins_opnd(inst_id, k)
    var kind = ir.ins_opnd_kind(inst_id, k)
    // IMM 字面量（kind 2）优先直接输出：值 id 0 可能与参数值 id 撞号
    // （strcmp 结果 == 0 曾误输出 %0 参数引用）
    if kind == 2 {
        return to_string(v)
    }
    // 块引用（kind 1）必须优先于参数检查：块 id 与参数值 id 独立编号，
    // 数字可能相同——jpeg encode_pixels 的 br 块 id 1 == 参数 %1，
    // 曾误输出 `br %1`（LLVM 语法错误，opt 报 expected value token）
    if kind == 1 {
        return "label %bb" + to_string(v)
    }
    // 形参引用优先（参数值 id 无定义指令，且 %N 全局编号在 LLVM 中不存在）
    var pr = param_ref(v)
    if pr != "" {
        return pr
    }
    if kind == 0 {
        return "%" + to_string(v)
    }
    if kind == 3 {
        // 全局地址（irgen 伪绑定 "@name" 池 id）→ @name 直接引用
        var gref = global_ref(v)
        if str_len(gref) > 0 {
            return gref
        }
        return "%" + to_string(v)  // 防御（理论上不达）
    }
    return to_string(v)
}

// 全局变量地址解析：v 是"@"+名字 的池 id（irgen scope_get_global 伪绑定）→
// "@name"（LLVM 全局符号）；非全局 → 空串。
// 注意：登记侧存裸名池 id（global_table_reg），引用侧存 "@name" 池 id——
// 两池 id 不同，须按名字（去 @）比较。
func global_ref(v: i64) -> string {
    var nm = intern.lookup(v)
    if str_len(nm) > 0 && str_char(nm, 0) == "@" {
        nm = slice(nm, 1, str_len(nm))
    }
    var nid = interner.intern(nm)
    var i: i64 = 0
    while i < len(g_global_names) {
        if g_global_names[i] == nid {
            return "@" + nm
        }
        i = i + 1
    }
    return ""
}

// 值 id → 定义指令 id 索引表构建（懒执行：首次 value_def 调用时一次性构建）。
// 值 id 从 0 连续分配（ir.value_count 返回总数），直接作表下标。
// 语义：每个值恰好被一条指令定义（SSA），后写的覆盖先写（同值不会重复定义）。
func build_vdef_cache() {
    vdef_cache = table_new_i64()
    var nv = ir.value_count()
    var i: i64 = 0
    while i < nv {
        table_push(vdef_cache, -1)
        i = i + 1
    }
    var ni = ir.inst_count()
    var j: i64 = 0
    while j < ni {
        var v = ir.ins_val(j)
        if v >= 0 {
            vdef_cache[v] = j
        }
        j = j + 1
    }
    vdef_cache_ready = 1
}

// 值 id → 定义指令 id（O(1) 索引；无定义/越界返回 -1）
func value_def(v: i64) -> i64 {
    if vdef_cache_ready == 0 {
        build_vdef_cache()
    }
    if v < 0 || v >= len(vdef_cache) {
        return -1
    }
    return vdef_cache[v]
}

// printf 实参引用：按值定义指令判定类型
//   const_str(62) → "ptr @.str.N"（格式串 %s 需指针，不走寄存器）
//   string 类型值（TK_STR，如 get_env 返回/string 变量 load）→ "ptr %N"（T4.5）
//   i64 结果     → "i64 %N"
//   i32 结果     → 由 call_vararg 分支生成独立 sext（不在本函数内联——
//                  LLVM 新版本不支持 `sext (i32 %N to i64)` 表达式实参）
//   其他/未知    → "i64 %N"
func arg_ref(inst_id: i64, k: i64) -> string {
    var v = ir.ins_opnd(inst_id, k)
    // 形参优先：字符串参数 → ptr %N；浮点 → double %N；其余 → i64 %N
    var pp = param_pos(v)
    if pp >= 0 {
        var ppt = ir.func_param_ty(g_pfid, pp)
        if ppt == TK_STR {
            return "ptr %" + to_string(pp)
        }
        if ppt == TK_F64 || ppt == TK_F32 {
            return llvm_ty(ppt) + " %" + to_string(pp)
        }
        return "i64 %" + to_string(pp)
    }
    var def = value_def(v)
    if def >= 0 {
        if ir.ins_op(def) == 62 {
            var slot = str_slot(ir.ins_opnd(def, 0))
            return "ptr @.str." + to_string(slot)
        }
        var vt = ir.ins_ty(def)
        if vt == TK_STR {
            return "ptr " + to_ptr(v)
        }
        // 浮点实参：double/float 直传（printf %f 匹配；曾默认 i64 %N 类型错）
        if vt == TK_F64 || vt == TK_F32 {
            return llvm_ty(vt) + " %" + to_string(v)
        }
    }
    return "i64 %" + to_string(v)
}

// 单条指令 → .ll 文本（核心子集）
func gen_inst(inst_id: i64) {
    var op = ir.ins_op(inst_id)
    var val = ir.ins_val(inst_id)   // 结果值 id（-1 = 无结果）
    var cnt = ir.ins_ops_cnt(inst_id)

    var reg = ""
    if val >= 0 {
        reg = "%" + to_string(val)
    }

    if op == 20 {
        // alloca
        var ty = llvm_ty(ir.ins_ty(inst_id))
        line(reg + " = alloca " + ty)
        return
    }
    if op == 21 {
        // load：操作数[0] = 地址（全局 kind=3 → opnd_ref 输出 @name）
        var ty = llvm_ty(ir.ins_ty(inst_id))
        line(reg + " = load " + ty + ", ptr " + opnd_ref(inst_id, 0))
        return
    }
    if op == 22 {
        // store：操作数 [类型IMM, 值VALUE, 地址VALUE]（全局 kind=3 → opnd_ref 输出 @name）
        var vty = llvm_ty(ir.ins_opnd(inst_id, 0))
        var vr = opnd_ref(inst_id, 1)
        if vty == "ptr" {
            // 值统一转真 ptr：const_str（i64 指针整数）/str_cat（i64）
            // 不能直接 store ptr %N（%N 类型是 i64）——to_ptr 负责转换
            vr = to_ptr(ir.ins_opnd(inst_id, 1))
        }
        line("store " + vty + " " + vr + ", ptr " + opnd_ref(inst_id, 2))
        return
    }
    if op == 60 {
        // const_i：立即数常量 → add 0, val（结果寄存器 = 值）。
        // 类型按指令 ins_ty（i32 变量初始化是 i32 常量；i64 默认）——
        // 否则 store i32 %N 会因 %N 为 i64 而类型不匹配。
        var v = ir.ins_opnd(inst_id, 0)
        var ty = llvm_ty(ir.ins_ty(inst_id))
        line(reg + " = add " + ty + " 0, " + to_string(v))
        return
    }
    if op == 62 {
        // const_str：字符串全局指针（ptr 类型结果）
        var sid = ir.ins_opnd(inst_id, 0)
        var slot = str_slot(sid)
        // 返回全局字符串指针（作为 ptr 值）
        line(reg + " = ptrtoint ptr @.str." + to_string(slot) + " to i64")
        return
    }
    if op == 0 || op == 1 || op == 2 || op == 3 || op == 4 {
        // add/sub/mul/div/mod
        var opname = ""
        if op == 0 {
            opname = "add"
        } else if op == 1 {
            opname = "sub"
        } else if op == 2 {
            opname = "mul"
        } else if op == 3 {
            opname = "sdiv"
        } else if op == 4 {
            opname = "srem"
        }
        var ty = llvm_ty(ir.ins_ty(inst_id))
        line(reg + " = " + opname + " " + ty + " " + opnd_ref(inst_id, 0) + ", " + opnd_ref(inst_id, 1))
        return
    }
    if op == 12 {
        // icmp：操作数 [lhs VALUE, rhs VALUE, cmp IMM]。
        // 比较类型：按操作数定义指令类型（i64 整数比较；i32 为 strcmp 结果
        // 与 0 比较——字符串比较链）。通用取 llvm_ty(lhs 定义指令类型)。
        var cmp = ir.ins_opnd(inst_id, 2)
        var cname = "eq"
        if cmp == 0 {
            cname = "eq"
        } else if cmp == 1 {
            cname = "ne"
        } else if cmp == 2 {
            cname = "slt"
        } else if cmp == 3 {
            cname = "sgt"
        } else if cmp == 4 {
            cname = "sle"
        } else if cmp == 5 {
            cname = "sge"
        }
        // 类型：默认 i64；lhs 定义指令为 i32（strcmp 结果）→ i32
        var cmp_ty = "i64"
        var lv = ir.ins_opnd(inst_id, 0)
        var def = value_def(lv)
        if def >= 0 {
            cmp_ty = llvm_ty(ir.ins_ty(def))
        }
        // ptr 比较时字面量 0 必须写作 null（LLVM 语法：icmp eq ptr %x, null）
        var op0 = opnd_ref(inst_id, 0)
        var op1 = opnd_ref(inst_id, 1)
        if cmp_ty == "ptr" {
            if op0 == "0" {
                op0 = "null"
            }
            if op1 == "0" {
                op1 = "null"
            }
        }
        line(reg + " = icmp " + cname + " " + cmp_ty + " " + op0 + ", " + op1)
        return
    }
    if op == 19 {
        // sext：符号扩展（trit/窄整数提升）。操作数 [0]=源类型 IMM, [1]=值 VALUE；
        // 目标类型 = ins_ty（如 i64 / i32）。
        var sty = llvm_ty(ir.ins_opnd(inst_id, 0))
        var tty = llvm_ty(ir.ins_ty(inst_id))
        line(reg + " = sext " + sty + " " + opnd_ref(inst_id, 1) + " to " + tty)
        return
    }
    if op == 28 {
        // sitofp：整数转浮点（数学函数整数实参提升）。操作数 [0]=源类型 IMM,
        // [1]=值 VALUE；目标类型 = ins_ty（double）。
        var sty = llvm_ty(ir.ins_opnd(inst_id, 0))
        var tty = llvm_ty(ir.ins_ty(inst_id))
        line(reg + " = sitofp " + sty + " " + opnd_ref(inst_id, 1) + " to " + tty)
        return
    }
    if op == 27 {
        // agg_gep：聚合元素指针（元组/struct 字段）。操作数 [0]=地址 VALUE,
        // [1]=字段下标 IMM；ins_ty = 聚合类型 id → 生成
        // `getelementptr T, ptr, i32 0, i32 <idx>`（双下标：第 0 行 + 字段列）。
        // 注：索引必须 i32（LLVM 18 对结构体 GEP 的 i64 索引报 invalid
        // getelementptr indices；表元素 GEP 是单索引 i8/i64 不受影响）
        var ty = llvm_ty(ir.ins_ty(inst_id))
        line(reg + " = getelementptr " + ty + ", ptr " + opnd_ref(inst_id, 0) + ", i32 0, i32 " + to_string(ir.ins_opnd(inst_id, 1)))
        return
    }
    if op == 13 || op == 14 || op == 15 || op == 16 || op == 17 {
        // fadd(13)/fsub(14)/fmul(15)/fdiv(16)/frem(17)——浮点算术（M4 扩展）
        var opname = ""
        if op == 13 {
            opname = "fadd"
        } else if op == 14 {
            opname = "fsub"
        } else if op == 15 {
            opname = "fmul"
        } else if op == 16 {
            opname = "fdiv"
        } else {
            opname = "frem"
        }
        var ty = llvm_ty(ir.ins_ty(inst_id))
        line(reg + " = " + opname + " " + ty + " " + opnd_ref(inst_id, 0) + ", " + opnd_ref(inst_id, 1))
        return
    }
    if op == 18 {
        // fcmp：操作数 [lhs VALUE, rhs VALUE, cmp IMM]（0=oeq 1=one 2=olt 3=ogt 4=ole 5=oge，
        // 对齐 ir.cmp 常量；ordered 语义防 NaN 误判）
        var cmp = ir.ins_opnd(inst_id, 2)
        var cname = "oeq"
        if cmp == 0 {
            cname = "oeq"
        } else if cmp == 1 {
            cname = "one"
        } else if cmp == 2 {
            cname = "olt"
        } else if cmp == 3 {
            cname = "ogt"
        } else if cmp == 4 {
            cname = "ole"
        } else if cmp == 5 {
            cname = "oge"
        }
        // 操作数类型：取 lhs 定义指令类型（对齐 icmp 分支；fadd 结果 → double）
        var fty = "double"
        var lv0 = ir.ins_opnd(inst_id, 0)
        var def0 = value_def(lv0)
        if def0 >= 0 {
            fty = llvm_ty(ir.ins_ty(def0))
        }
        line(reg + " = fcmp " + cname + " " + fty + " " + opnd_ref(inst_id, 0) + ", " + opnd_ref(inst_id, 1))
        return
    }
    if op == 51 {
        // const_f：浮点常量 → fadd double <lit>, 0.0（结果寄存器；lit 规范化补小数点）。
        // 操作数[0] = 浮点文本的字符串池 id（irgen 存 lexeme 原文本，规避 tie 无
        // f64→文本转换；LLVM 要求字面量含小数点/指数）
        var lit = intern.lookup(ir.ins_opnd(inst_id, 0))
        var lit_txt = lit
        if find_char(lit, ".") < 0 && find_char(lit, "e") < 0 && find_char(lit, "E") < 0 {
            lit_txt = lit + ".0"
        }
        var fty2 = llvm_ty(ir.ins_ty(inst_id))
        line(reg + " = fadd " + fty2 + " " + lit_txt + ", 0.0")
        return
    }
    if op == 34 {
        // select：三目（操作数 [cond VALUE, then VALUE, else VALUE]；ins_ty = 值类型）
        var ty = llvm_ty(ir.ins_ty(inst_id))
        line(reg + " = select i1 " + opnd_ref(inst_id, 0) + ", " + ty + " " + opnd_ref(inst_id, 1) + ", " + ty + " " + opnd_ref(inst_id, 2))
        return
    }
    if op == 6 || op == 7 || op == 8 || op == 10 || op == 11 {
        // and/or/xor/shl/shr（逻辑 i1 / 位运算 i64 按 ins_ty）
        var opname = ""
        if op == 6 {
            opname = "and"
        } else if op == 7 {
            opname = "or"
        } else if op == 8 {
            opname = "xor"
        } else if op == 10 {
            opname = "shl"
        } else if op == 11 {
            opname = "ashr"
        }
        var ty = llvm_ty(ir.ins_ty(inst_id))
        line(reg + " = " + opname + " " + ty + " " + opnd_ref(inst_id, 0) + ", " + opnd_ref(inst_id, 1))
        return
    }
    if op == 33 {
        // phi：操作数 [值1, 块1, 值2, 块2, ...]（值可为 IMM 立即数）。
        // 字符串 phi（ins_ty == TK_STR）：incoming 值须为 ptr——const_str 是
        // i64 指针整数（ptrtoint）直引 @.str.N、str_cat 结果 inttoptr 转 ptr
        //（曾生成 `phi ptr [%11, ...]` 而 %11 是 i64 → 类型不匹配）
        var pty = llvm_ty(ir.ins_ty(inst_id))
        var is_str_phi = ir.ins_ty(inst_id) == TK_STR
        var args = ""
        var k: i64 = 0
        while k + 1 < cnt {
            if k > 0 {
                args = args + ", "
            }
            var vref = opnd_ref(inst_id, k)
            if is_str_phi {
                vref = to_ptr(ir.ins_opnd(inst_id, k))
            }
            args = args + "[" + vref + ", %bb" + to_string(ir.ins_opnd(inst_id, k + 1)) + "]"
            k = k + 2
        }
        line(reg + " = phi " + pty + " " + args)
        return
    }
    if op == 35 {
        // call（阶段 A 用户函数）：操作数 [0]=符号池id, [1]=返回类型IMM,
        // 然后每参数 [类型IMM, 值]。返回类型 = ins_ty（void 用 -1 → call void）。
        var sid = ir.ins_opnd(inst_id, 0)
        var sym = ns_replace(intern.lookup(sid))
        if sym == "" {
        }
        var args = ""
        var k: i64 = 2
        while k + 1 < cnt {
            if k > 2 {
                args = args + ", "
            }
            var pty = llvm_ty(ir.ins_opnd(inst_id, k))
            args = args + pty + " " + typed_ref(inst_id, k + 1)
            k = k + 2
        }
        if ir.ins_ty(inst_id) < 0 || ir.ins_ty(inst_id) == TK_VOID {
            line("call void @" + sym + "(" + args + ")")
        } else {
            line(reg + " = call " + llvm_ty(ir.ins_ty(inst_id)) + " @" + sym + "(" + args + ")")
        }
        return
    }
    if op == 56 {
        // str_cat（字符串拼接）：操作数 [lhs, rhs] → malloc+memcpy 序列。
        // 对齐 Rust gen_binary_str 的 Add：strlen+strlen → malloc(len1+len2+1)
        // → memcpy 两段 → 末尾 \0。
        var lv = ir.ins_opnd(inst_id, 0)
        var rv = ir.ins_opnd(inst_id, 1)
        // 注意：arg 传裸引用（gen_call_i64 内部会加 argty 前缀），
        // 曾误传 "ptr " + ref 导致 `strlen(ptr ptr @.str.N)` 重复前缀
        var n1 = gen_call_i64("strlen", "ptr", str_ptr_ref(lv))
        var n2 = gen_call_i64("strlen", "ptr", str_ptr_ref(rv))
        // total = n1 + n2；size = total + 1
        var total = reg_add(n1, n2)
        var size = reg_add(total, "1")
        var buf = gen_call_ptr("malloc", "i64", size)
        // memcpy(buf, lv, n1) + memcpy(buf+n1, rv, n2)
        line("call void @llvm.memcpy.p0.p0.i64(ptr " + buf + ", ptr " + str_ptr_ref(lv) + ", i64 " + n1 + ", i1 false)")
        var off = reg_gep(buf, n1)
        line("call void @llvm.memcpy.p0.p0.i64(ptr " + off + ", ptr " + str_ptr_ref(rv) + ", i64 " + n2 + ", i1 false)")
        // buf[total] = 0
        var endp = reg_gep(buf, total)
        line("store i8 0, ptr " + endp)
        line(reg + " = ptrtoint ptr " + buf + " to i64")
        return
    }
    if op == 30 {
        // br label %block
        line("br " + opnd_ref(inst_id, 0))
        return
    }
    if op == 31 {
        // cond_br：操作数 [cond VALUE, then BLOCK, else BLOCK]
        var cond = ir.ins_opnd(inst_id, 0)
        var then_b = ir.ins_opnd(inst_id, 1)
        var else_b = ir.ins_opnd(inst_id, 2)
        line("br i1 %" + to_string(cond) + ", label %bb" + to_string(then_b) + ", label %bb" + to_string(else_b))
        return
    }
    if op == 32 {
        // ret：无操作数 → ret void；有 → ret T %N（类型按指令 ins_ty——
        // 显式 return 的表达式是 i64 常量/变量，硬编码 ret i32 会类型不匹配）
        if cnt == 0 {
            line("ret void")
        } else {
            var v0 = ir.ins_opnd(inst_id, 0)
            var fret = llvm_ty(ir.func_ret(g_pfid))
            if fret == "ptr" {
                // 字符串返回：const_str/str_cat 值是 i64 指针整数，须转真 ptr
                line("ret ptr " + to_ptr(v0))
            } else if fret == "void" {
                // main 特例（define i32 @main，irgen 补 ret i32 0）：
                // 按值类型输出；其他 void 函数 → ret void
                var fnm = intern.lookup(ir.func_name(g_pfid))
                if fnm == "main" {
                    // 补 ret（irgen 尾部生成 ret i32 0）：operand 是 IMM(2) 字面量 0，
                    // 不能查 value_def——值 id 0 恰好是第一条指令，会误判为 i64
                    var def = -1
                    if ir.ins_opnd_kind(inst_id, 0) == 0 {
                        def = value_def(v0)
                    }
                    var rty2 = "i32"
                    if def >= 0 {
                        rty2 = llvm_ty(ir.ins_ty(def))
                    }
                    line("ret " + rty2 + " " + opnd_ref(inst_id, 0))
                } else {
                    line("ret void")
                }
            } else {
                // 非 ptr：按值实际类型（bool 函数返回 icmp i1；i32 常量等）
                var rty = fret
                var pp = param_pos(v0)
                if pp >= 0 {
                    rty = llvm_ty(ir.func_param_ty(g_pfid, pp))
                } else {
                    var def = value_def(v0)
                    if def >= 0 {
                        if ir.ins_op(def) == 12 {
                            // icmp 结果恒 i1（irgen 类型标记为 i64 简化）
                            rty = "i1"
                        } else {
                            rty = llvm_ty(ir.ins_ty(def))
                        }
                    }
                }
                line("ret " + rty + " " + opnd_ref(inst_id, 0))
            }
        }
        return
    }
    if op == 41 {
        // call_vararg（printf）：操作数[0] = 格式串池 id；[1..] = 实参
        var fid = ir.ins_opnd(inst_id, 0)
        var slot = str_slot(fid)
        // 实参类型提升：const_str → ptr 直传 @.str.N；i32 结果 → 先生成
        // 独立 sext 指令（LLVM 不支持内联 sext 表达式实参）再传 i64；
        // i64 → 直传。
        var args = ""
        var k: i64 = 1
        while k < cnt {
            if k > 1 {
                args = args + ", "
            }
            var v = ir.ins_opnd(inst_id, k)
            var def = value_def(v)
            var rref = arg_ref(inst_id, k)
            // i32 值实参：生成 sext 到独立寄存器（新寄存器号 g_sext_cnt 递增）
            if def >= 0 {
                if llvm_ty(ir.ins_ty(def)) == "i32" {
                    g_sext_cnt = g_sext_cnt + 1
                    var rn = "%ext" + to_string(g_sext_cnt)
                    line(rn + " = sext i32 %" + to_string(v) + " to i64")
                    rref = "i64 " + rn
                } else if llvm_ty(ir.ins_ty(def)) == "i1" {
                    // bool 值实参：zext i1 → i64（%lld 打印 0/1；sext 会得 -1）
                    g_sext_cnt = g_sext_cnt + 1
                    var rn2 = "%ext" + to_string(g_sext_cnt)
                    line(rn2 + " = zext i1 %" + to_string(v) + " to i64")
                    rref = "i64 " + rn2
                }
            }
            args = args + rref
            k = k + 1
        }
        // 实参列表前缀：非空时补 ", "
        var call_args = ""
        if args != "" {
            call_args = ", " + args
        }
        line(reg + " = call i32 (ptr, ...) @printf(ptr @.str." + to_string(slot) + call_args + ")")
        return
    }
    if op == 36 {
        // extern_call（阶段 A 新布局）：操作数 [0]=符号名池 id, [1]=返回类型IMM,
        // 然后每参数 [类型IMM, 值]。返回类型 = ins_ty（void → call void）。
        var sid = ir.ins_opnd(inst_id, 0)
        var sym = intern.lookup(sid)
        var args = ""
        var k: i64 = 2
        while k + 1 < cnt {
            if k > 2 {
                args = args + ", "
            }
            var pty = llvm_ty(ir.ins_opnd(inst_id, k))
            args = args + pty + " " + typed_ref(inst_id, k + 1)
            k = k + 2
        }
        if ir.ins_ty(inst_id) < 0 || ir.ins_ty(inst_id) == TK_VOID {
            line("call void @" + sym + "(" + args + ")")
        } else {
            line(reg + " = call " + llvm_ty(ir.ins_ty(inst_id)) + " @" + sym + "(" + args + ")")
        }
        return
    }
    // 未支持指令：占位注释
    line("; TODO op=" + to_string(op) + " inst=" + to_string(inst_id))
}

// 类型化实参引用（call/extern_call 通用）：const_str → "@.str.N"（指针直引，
// 不经过寄存器）；否则 "%N"。
func typed_ref(inst_id: i64, k: i64) -> string {
    var v = ir.ins_opnd(inst_id, k)
    // 形参优先（按形参位置 %N；类型由调用方 pty 决定）
    var pr = param_ref(v)
    if pr != "" {
        return pr
    }
    var def = value_def(v)
    if def >= 0 {
        if ir.ins_op(def) == 62 {
            var slot = str_slot(ir.ins_opnd(def, 0))
            return "@.str." + to_string(slot)
        }
        if ir.ins_op(def) == 56 {
            // str_cat 结果（i64 指针整数）→ inttoptr 转 ptr（extern_call 字符串参数）
            g_str_reg_cnt = g_str_reg_cnt + 1
            var r = "%sc" + to_string(g_str_reg_cnt)
            line(r + " = inttoptr i64 %" + to_string(v) + " to ptr")
            return r
        }
    }
    return "%" + to_string(v)
}

// 字符串指针引用（str_cat 用）：const_str → "@.str.N"；其余 → "%N"
func str_ptr_ref(v: i64) -> string {
    return to_ptr(v)
}

// 任意值 → 真 ptr 寄存器名（字符串指针实参统一入口）：
//   const_str(62)  → "@.str.N"（直接引用常量）
//   str_cat(56)    → inttoptr 新寄存器（str_cat 结果是 i64 指针整数，
//                    LLVM 不支持内联 inttoptr 表达式实参，须独立指令）
//   其余（string 变量 load / extern 返回）→ "%N"（本身已是 ptr）
func to_ptr(v: i64) -> string {
    // 形参优先（参数值 id 无定义指令，value_def 返回 -1 会误判）
    var pr = param_ref(v)
    if pr != "" {
        return pr
    }
    var def = value_def(v)
    if def >= 0 {
        if ir.ins_op(def) == 62 {
            var slot = str_slot(ir.ins_opnd(def, 0))
            return "@.str." + to_string(slot)
        }
        if ir.ins_op(def) == 56 {
            // str_cat 结果（i64 指针整数）→ inttoptr 转 ptr
            g_str_reg_cnt = g_str_reg_cnt + 1
            var r = "%sc" + to_string(g_str_reg_cnt)
            line(r + " = inttoptr i64 %" + to_string(v) + " to ptr")
            return r
        }
    }
    return "%" + to_string(v)
}

// 生成 `%N = call i64 @f(ptr arg)`，返回寄存器名（str_cat 辅助；独立寄存器号）
func gen_call_i64(fn: string, argty: string, arg: string) -> string {
    g_str_reg_cnt = g_str_reg_cnt + 1
    var r = "%sc" + to_string(g_str_reg_cnt)
    line(r + " = call i64 @" + fn + "(" + argty + " " + arg + ")")
    return r
}

// 生成 `%N = call ptr @f(i64 arg)`，返回寄存器名（str_cat 辅助；独立寄存器号）
func gen_call_ptr(fn: string, argty: string, arg: string) -> string {
    g_str_reg_cnt = g_str_reg_cnt + 1
    var r = "%sc" + to_string(g_str_reg_cnt)
    line(r + " = call ptr @" + fn + "(" + argty + " " + arg + ")")
    return r
}

// 生成 `%N = add i64 a, b`（str_cat 辅助；a/b 为寄存器或立即数；独立寄存器号）
func reg_add(a: string, b: string) -> string {
    g_str_reg_cnt = g_str_reg_cnt + 1
    var r = "%sc" + to_string(g_str_reg_cnt)
    line(r + " = add i64 " + a + ", " + b)
    return r
}

// 生成 `%N = getelementptr i8, ptr base, i64 off`（str_cat 辅助；独立寄存器号）
func reg_gep(base: string, off: string) -> string {
    g_str_reg_cnt = g_str_reg_cnt + 1
    var r = "%sc" + to_string(g_str_reg_cnt)
    line(r + " = getelementptr i8, ptr " + base + ", i64 " + off)
    return r
}

// T4.5：extern_call 实参引用——tie 运行时桥参数全为字符串（ptr）。
// const_str → "ptr @.str.N"；其余（string 变量 load / 上一条指令结果）→ "ptr %N"。
func ptr_arg_ref(inst_id: i64, k: i64) -> string {
    var v = ir.ins_opnd(inst_id, k)
    var def = value_def(v)
    if def >= 0 {
        if ir.ins_op(def) == 62 {
            var slot = str_slot(ir.ins_opnd(def, 0))
            return "ptr @.str." + to_string(slot)
        }
    }
    return "ptr " + to_ptr(v)
}

// ==================== 模块生成 ====================
// 生成完整 .ll 文本
pub func emit() -> string {
    collect_strings()
    collect_externs()
    out_lines = table_new_string()
    g_sext_cnt = 0
    g_str_reg_cnt = 0
    // 模块头
    line("; ModuleID = 'tie'")
    line("source_filename = \"input.tie\"")
    line("")
    // 无条件 declare
    line("declare i32 @printf(ptr, ...)")
    line("")
    line("declare i64 @strlen(ptr)")
    line("declare i32 @strcmp(ptr, ptr)")
    line("declare ptr @malloc(i64)")
    line("declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)")
    line("")
    line("declare ptr @fopen(ptr, ptr)")
    line("declare i64 @fwrite(ptr, i64, i64, ptr)")
    line("declare i32 @fclose(ptr)")
    line("declare i32 @fflush(ptr)")
    line("declare void @exit(i32)")
    line("declare i32 @remove(ptr)")
    line("declare double @sqrt(double)")
    line("declare double @sin(double)")
    line("declare double @cos(double)")
    line("declare double @tan(double)")
    line("declare double @exp(double)")
    line("declare double @log(double)")
    line("declare double @pow(double, double)")
    line("declare double @floor(double)")
    line("declare double @ceil(double)")
    line("declare double @round(double)")
    line("")
    // T4.5：tie 运行时桥 declare（extern_call 收集，按符号名输出）
    emit_extern_decls()
    // 聚合类型段（struct type 定义；元组内联）
    emit_agg_types()
    // 阶段 A：全局变量段（表 → ptr null；标量 → 零值）
    emit_globals()
    // 各函数
    var nf = ir.func_count()
    var i: i64 = 0
    while i < nf {
        gen_func(i)
        i = i + 1
    }
    // 字符串常量节
    line("")
    emit_strings()
    return join_lines()
}

func build_inst_blk() {
    g_inst_blk = table_new_i64()
    var nb = ir.block_count()
    var bi: i64 = 0
    while bi < nb {
        var st = ir.block_start(bi)
        var en = ir.block_end(bi)
        var k: i64 = st
        while k < en {
            while len(g_inst_blk) <= k {
                table_push(g_inst_blk, -1)
            }
            g_inst_blk[k] = bi
            k = k + 1
        }
        bi = bi + 1
    }
    g_inst_blk_ready = 1
}

// 单个函数生成
func gen_func(fid: i64) {
    g_pfid = fid
    g_pcnt = ir.func_params_cnt(fid)
    var name = intern.lookup(ir.func_name(fid))
    // 命名空间函数全名 → LLVM 符号：`::` 转 `$`（对齐 Rust ns_symbol；
    // 调用点 call(35) 同约定，保证定义与调用两侧符号一致）
    var sym = name
    var ns_pos = find_sub(name, "::")
    if ns_pos >= 0 {
        sym = ns_replace(name)
    }
    var ret_llvm = llvm_ty(ir.func_ret(fid))
    // main 特殊：void main → define i32 @main
    if sym == "main" && ret_llvm == "void" {
        ret_llvm = "i32"
    }
    // 形参列表：`i64 %0, ptr %1, ...`（参数值 id 是全局编号，形参按位置
    // %0..%n-1 命名；opnd_ref 经 param_ref 把参数值 id 映射到位置号）
    var params_llvm = ""
    var pk: i64 = 0
    while pk < g_pcnt {
        if pk > 0 {
            params_llvm = params_llvm + ", "
        }
        params_llvm = params_llvm + llvm_ty(ir.func_param_ty(fid, pk)) + " %" + to_string(pk)
        pk = pk + 1
    }
    line("define " + ret_llvm + " @" + sym + "(" + params_llvm + ") {")
    // 按指令 id 序遍历本函数全部块（块首输出标签）——保证值编号单调递增
    if g_inst_blk_ready == 0 {
        build_inst_blk()
    }
    var ni2 = ir.inst_count()
    var ii: i64 = 0
    while ii < ni2 {
        var blk: i64 = -1
        if ii < len(g_inst_blk) {
            blk = g_inst_blk[ii]
        }
        if blk >= 0 && ir.block_func(blk) == fid {
            if ii == ir.block_start(blk) {
                // 块标签：统一用块 id（bb<N>），避免 block_name 多 if/for 冲突
                line("bb" + to_string(blk) + ":")
            }
            gen_inst(ii)
        }
        ii = ii + 1
    }
    line("}")
    line("")
}

}


