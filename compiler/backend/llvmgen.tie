type tie<class>
// compiler/backend/llvmgen.tie —— 自举 v2 T2.8：tie-IR → LLVM IR 文本生成
// ============================================================
// 里程碑：自举 v2 计划 T2.8（.omo/plans/self-hosting-v2.md）后端 LLVM IR
// 文本生成器。本文件 = tie-IR 列式表 → .ll 文本（Rust ir.rs run() 契约）。
// 最小可行集：模块头/declare/define/entry 块/指令映射/字符串常量。
// **字符串自省**：遍历 tie-IR 的 const_str(62)/call_vararg(41) 指令收集
// 字符串池 id，经 interner.lookup 还原文本生成 @.str.N（不依赖 irgen）。
// 依赖：./../middle/ir.tie（tie-IR 表访问）。
// types.tie 经 irgen→semantic→…→stype→data 树传递可达（K_NAMED/TK_*）；
// str_char/char_code/str_len/to_string 为语言底座原语（全局可见，无需 import）；
// intern 经 irgen→semantic→…→lex_tokdefs→interner 树传递可达。
// 唯一直接 import ir.tie：避免菱形 import 导致全局变量重复定义。
// 树式无环：irgen import 本文件（本文件不 import irgen）。
// UTF-8 字节级能力复用 std/utf（hex_escape/utf8_bytes/byte_len），
// 不再内联重复实现（编译器自举后亦可继续依赖 std——std 亦为 tie 自写）。
// S3.2：import 用 "../middle/ir.tie"（无 "./" 前缀）→ 展开路径归一化为
// "compiler/middle/ir.tie"，与 tieir_ser 树的 ir 展开路径字符串一致，
// import 去重生效（此前 "./../middle/ir.tie" 得 "compiler/backend/../middle/
// ir.tie"，双入口时 ir 全局常量重复定义）
import "../middle/ir.tie"
import "../../std/utf.tie"

// ==================== 输出缓冲 ====================
// 行收集表：line() 只追加（O(1)），emit() 末尾分治拼接成完整文本。
// 避免 `out_buf = out_buf + s` 的 O(N²) 全量拷贝——tie 字符串不可变，
// str_cat 每次 malloc 新串且旧串无 GC 回收，自编译（10 万级行）会挂起
// 并耗尽内存（曾实测 30s+ / 2.3GB）。
var out_lines: table<string>;
// 值 id → 定义指令 id 索引（value_def 缓存）：值 id 从 0 连续分配
// （ir.new_value 单调递增），直接作表下标 → O(1) 查询，替代全指令
// 线性扫描的 O(N²)（每条指令的每个实参引用都全扫一遍）。
var vdef_cache: table<i64>;
var vdef_cache_ready: i64 = 0;
// 调试：当前生成函数 id（gen_inst 的细粒度诊断用；0 = 未生成，真实 fid 从 0 起）
var g_pfid: i64 = 0;
// 当前函数参数个数（opnd_ref 形参映射用）
var g_pcnt: i64 = 0;
// 指令 id → 块 id 映射（emit 开头构建一次；gen_func 按指令序遍历用）。
// 块 id 创建序 ≠ 值 id 分配序（if/while 嵌套：then/else/merge 块先创建、
// 循环头块后创建）——按块 id 遍历会值编号回退，LLVM 解析拒绝。
var g_inst_blk: table<i64>;
var g_inst_blk_ready: i64 = 0;
// 字符串常量表：池 id → @.str.N 序号（自省收集）
var str_pool: table<i64>;   // 字符串池 id（登记序）
var str_idx: table<i64>;    // 对应 @.str.N
var str_count: i64 = 0;
// printf i32 实参 sext 的新寄存器计数（LLVM 不支持内联 sext 表达式实参，
// 每处 i32 实参生成一个独立 %ext<N> 寄存器）
var g_sext_cnt: i64 = 0;
// T4.5：extern_call(36) 收集的符号名池 id（去重登记序；llvmgen 顶层变量，
// 与 out_buf 等同级——命名空间体内不允许 var）
var ext_syms: table<i64>;
// 阶段 A：全局变量登记（名池 id → 表/标量 + 类型）。表全局 → ptr null 占位
// + main 入口初始化；标量 → 零值 global。
var g_global_names: table<i64>;   // 全局名池 id（登记序）
var g_global_is_table: table<i64>;  // 1 = 表全局（ptr null），0 = 标量
var g_global_tys: table<i64>;     // 标量类型 id（表全局 -1）
var g_global_inits: table<i64>;   // const 标量初始值（-1 = 无；i64 字面量）
var g_global_strs: table<i64>;    // 顶层字符串 const 初始值（字符串池 id；-1 = 无）
// 阶段 A：用户函数调用（call 35）的符号名池 id（去重，与 ext_syms 平行收集；
// 命名空间函数全名经 ns_symbol 转 $，无需 declare）
var call_syms: table<i64>;
// S2.4：vtable 全局常量登记（每个 impl 一个：方法函数指针按 port 方法声明序）。
// 符号名 = "vt.<port名>.<struct名>"；类型 = 内联聚合文本 "{ ptr, ... }"
//（函数指针数组）；方法符号 = 实现函数全名（LLVM 符号经 ns_replace 转 $）。
var g_vt_names: table<i64>;   // vtable 符号名池 id（登记序）
var g_vt_tys: table<i64>;     // vtable 聚合类型文本池 id（"{ ptr, ptr }" 等）
var g_vt_n: table<i64>;       // 字段数（= port 方法数）
var g_vt_off: table<i64>;     // 方法符号段偏移（g_vt_syms 扁平段）
var g_vt_syms: table<i64>;    // 方法函数全名池 id（扁平段）
// SSO 短串池（dev33 批次 3）：启用标记。irgen 首次调用 s21_sso_alloc 置位，
// emit 主流程据此刻意输出 @s21_sso_pool / @s21_sso_off / @s21_sso_malloc_cnt。
// 仅用到短串池的程序才带 256KB .bss，纯字面量程序不引入。
var g_sso_enabled: i64 = 0;
// 可捕获 panic（dev33 批次 7）：启用标记。irgen 首次生成 catch_panic/受捕
// panic 置位，emit 据此输出 @tie_panic_jb / @tie_panic_msg / @tie_panic_active。
var g_catch_enabled: i64 = 0;
// 阶段 A：str_cat 内联序列的临时寄存器计数（与 printf sext 同款独立命名空间，
// 避免与 %N 值编号冲突）
var g_str_reg_cnt: i64 = 0;
// 临时 alloca 提升（F1 增强）+ 行级重编号（对齐 Rust renumber_ir）：
// irgen 的 ok 槽等临时 alloca 生成在当前块（循环体内），LLVM 对循环内 alloca
// 生成动态栈分配（sub rsp 无恢复）——百万级循环栈溢出（map-bench 150 轮 →
// 0xC00000FD，普适 map 段错误根因之一）。修复：gen_func 把函数全部 alloca
// 前置到 entry block 输出（收集序），再对函数体行级重编号（%N → 1..N 连续）
// 解决编号倒挂（alloca 值 id 大于后序指令值 id，LLVM 要求块内严格递增）。
// 函数级缓冲：gen_func 期间 line() 写入 g_fn_lines，结束重编号后追加全局。
var g_fn_lines: table<string>;
var g_fn_mode: i64 = 0;
var g_hoisted_allocas: table<i64>;
var g_hoisted_cnt: i64 = 0;
// 重编号映射表：旧值 id → 新值 id（线性，行数规模小）
var g_ren_old: table<i64>;
var g_ren_new: table<i64>;
var g_ren_next: i64 = 1;

namespace llvmgen {

// 本地字符串切片 [start, end)（码点级；对齐 irgen.ig_slice）。
// 历史 bug：global_ref 曾调用未定义的裸 `slice`，导致所有 import 本模块的
// 程序（driver-lite/driver）编译报"未定义的函数 'slice'"。本辅助补齐。
func l_slice(s: string, start: i64, end: i64) -> string {
    var out: string = ""
    var i: i64 = start
    while i < end {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

// 查找字符串中第一个指定字符的下标（-1 = 无）。
// 历史 bug：const_f 曾调用未定义的裸 `find_char`，本辅助补齐。
func l_find_char(s: string, c: string) -> i64 {
    var n = str_len(s)
    var i: i64 = 0
    while i < n {
        if str_char(s, i) == c {
            return i
        }
        i = i + 1
    }
    return -1
}

// 全局变量登记：表全局（global ptr null + main 初始化）/ 标量（零值 global）。
// 供 irgen.gen_global_var 调用（driver 树顶层 VarDecl 439 个）。
pub func global_table_reg(nm: string) {
    var nid = interner.intern(nm)
    table_push(g_global_names, nid)
    table_push(g_global_is_table, 1)
    table_push(g_global_tys, -1)
    table_push(g_global_inits, -1)
    table_push(g_global_strs, -1)
}

pub func global_scalar_reg(nm: string, ty: i64) {
    var nid = interner.intern(nm)
    table_push(g_global_names, nid)
    table_push(g_global_is_table, 0)
    table_push(g_global_tys, ty)
    table_push(g_global_inits, -1)
    table_push(g_global_strs, -1)
}

// const 标量初始值（i64 字面量）：emit_globals 输出 @g = global i64 <v>
pub func global_scalar_init(nm: string, v: i64) {
    var nid = interner.intern(nm)
    var i: i64 = 0
    while i < len(g_global_names) {
        if g_global_names[i] == nid {
            g_global_inits[i] = v
            return
        }
        i = i + 1
    }
}

// 顶层字符串 const 初始值：emit_globals 输出 @g = global ptr @.str.N（字面量）
pub func global_str_init(nm: string, lexeme_id: i64) {
    var nid = interner.intern(nm)
    var i: i64 = 0
    while i < len(g_global_names) {
        if g_global_names[i] == nid {
            // 去引号 lexeme → 纯文本池 id（与 gen_str_lit 同款）
            var clean = lexeme_id
            var txt = intern.lookup(lexeme_id)
            var n: i64 = str_len(txt)
            if n >= 2 && str_char(txt, 0) == "\"" && str_char(txt, n - 1) == "\"" {
                var sub: string = ""
                var k: i64 = 1
                while k < n - 1 {
                    sub = sub + str_char(txt, k)
                    k = k + 1
                }
                clean = interner.intern(sub)
            }
            g_global_strs[i] = clean
            return
        }
        i = i + 1
    }
}

// 全局表是否已登记（irgen 查表变量语义类型用）
func global_is_table(nm: string) -> i64 {
    var nid = interner.intern(nm)
    var i: i64 = 0
    while i < len(g_global_names) {
        if g_global_names[i] == nid {
            return g_global_is_table[i]
        }
        i = i + 1
    }
    return 0
}

// 输出聚合类型段（模块头 declare 之后、全局变量之前）：
// 遍历语义层已登记的 struct（st_keys/st_vals + cls_* + fld_*），
// 输出 `%struct.<名> = type { 字段类型... }`（元组内联在 llvm_ty，无需定义）。
func emit_agg_types() {
    var n = len(st_vals)
    var i: i64 = 0
    while i < n {
        var si = st_vals[i]
        var off = cls_fldoff[si]
        var cnt = cls_nfld[si]
        var out: string = "%struct." + intern.lookup(st_keys[i]) + " = type {"
        var j: i64 = 0
        while j < cnt {
            if j > 0 {
                out = out + ","
            }
            out = out + " " + llvm_ty(fld_tys[off + j])
            j = j + 1
        }
        out = out + " }"
        line(out)
        i = i + 1
    }
    // enum 类型输出（2026-08-15 enum 语言特性）：`%enum.<名> = type { i64, i64×K }`。
    // 布局：槽 0 = tag（变体号 i64），槽 1..K = payload（K = en_nslot[ei]，
    // 所有变体 payload 字段数最大值）。**循环独立于 st_vals**——en_vals 是
    // 按 enum 名升序排列的索引表（与 en_keys 并行），不可复用上面 st_vals 循环。
    var ne = len(en_vals)
    var ei2: i64 = 0
    while ei2 < ne {
        var eidx = en_vals[ei2]
        var eout: string = "%enum." + sstate.enum_name_of(eidx) + " = type { i64"
        var k2: i64 = 0
        while k2 < en_nslot[eidx] {
            eout = eout + ", i64"
            k2 = k2 + 1
        }
        eout = eout + " }"
        line(eout)
        ei2 = ei2 + 1
    }
    // fn 函数值类型输出（S2.2）：`%fn.<签名索引> = type { ptr, ptr }`——
    // 闭包值 = { env 指针, entry 函数指针 }（见 closure-model.md C2）。
    // fn_ret 是 types 命名空间外的全局签名表（fn 类型低负载 = 签名表行号）。
    var nfn = len(fn_ret)
    var fi: i64 = 0
    while fi < nfn {
        line("%fn." + to_string(fi) + " = type { ptr, ptr }")
        fi = fi + 1
    }
    if len(st_vals) > 0 || len(en_vals) > 0 || len(fn_ret) > 0 {
        line("")
    }
}

// 输出全局变量段（模块头 declare 之后、函数 define 之前）：
//   @g = global ptr null            （表全局，main 入口运行时创建）
//   @g = global T <零值>             （标量；i64→0 / bool→false / string→null / f64→0.0）
func emit_globals() {
    var i: i64 = 0
    while i < len(g_global_names) {
        var nm = intern.lookup(g_global_names[i])
        if g_global_is_table[i] == 1 {
            line("@" + nm + " = global ptr null")
        } else {
            var ty = llvm_ty(g_global_tys[i])
            var init = "0"
            // const 整数字面量初始值（i64 字面量直接输出；其余保持零值）
            if i < len(g_global_inits) && g_global_inits[i] >= 0 && ty == "i64" {
                init = to_string(g_global_inits[i])
            }
            if ty == "ptr" {
                // string 全局默认空串常量（null 会被 strcmp 段错误）；
                // const 字符串全局有初始字面量 → 指向该字面量常量
                if g_global_tys[i] == TK_STR {
                    var eslot = 0
                    if i < len(g_global_strs) && g_global_strs[i] >= 0 {
                        eslot = str_slot(g_global_strs[i])
                    } else {
                        var empty_id = interner.intern("")
                        eslot = str_slot(empty_id)
                    }
                    line("@" + nm + " = global ptr " + str_data_ref(eslot))
                    i = i + 1
                    continue
                }
                init = "null"
            } else if ty == "i1" {
                init = "false"
            } else if ty == "double" {
                init = "0.0"
            } else if ty == "float" {
                init = "0.0"
            }
            line("@" + nm + " = global " + ty + " " + init)
        }
        i = i + 1
    }
    if len(g_global_names) > 0 {
        line("")
    }
}

// SSO 短串池启用标记（irgen s21_sso_alloc 首次调用置位；幂等）。
pub func sso_enable() {
    g_sso_enabled = 1
}

// 可捕获 panic 启用标记（irgen 首次生成 catch_panic / 受捕 panic 置位；幂等）。
pub func catch_enable() {
    g_catch_enabled = 1
}

// 输出 SSO 短串池全局段（emit_globals 之后）：仅 g_sso_enabled 时输出。
//   @s21_sso_pool      = 256KB 静态线性池（.bss，零运行时初始化）
//   @s21_sso_off       = 当前 bump 偏移
//   @s21_sso_malloc_cnt = 池满回退 malloc 的累计次数（验收探针断言 = 0）
// 并定义短串池分配 helper @tie_sso_alloc(i64 %n) -> ptr：
//   参数 n = 数据长度（UTF-8 字节）；返回块基址（头位置，调用方写头后取数据）。
//   块 = n + 41（8 头 + 数据 + \0 + 32 尾部填充，漏洞 B 安全余量不变）。
//   短串（n ≤ 31 且池剩余 ≥ n+41）→ 池 bump（零 malloc）；否则回退 malloc 计数。
//   供 llvmgen op56（str_cat）与 gen_ext_str_scan（FFI 收方向）内联调用——
//   与 irgen s21_sso_alloc 逻辑同构（共用 @s21_sso_off / @s21_sso_malloc_cnt）。
func emit_sso_globals() {
    // SSO 短串池段（仅 g_sso_enabled）
    if g_sso_enabled == 1 {
        line("@s21_sso_pool = private global [262144 x i8] zeroinitializer")
        line("@s21_sso_off = private global i64 0")
        line("@s21_sso_malloc_cnt = private global i64 0")
        line("define private ptr @tie_sso_alloc(i64 %n) {")
        line("  %short = icmp sle i64 %n, 31")
        line("  %need = add i64 %n, 41")
        line("  %off = load i64, ptr @s21_sso_off")
        line("  %remain = sub i64 262144, %off")
        line("  %space = icmp sle i64 %need, %remain")
        line("  %ok = and i1 %short, %space")
        line("  br i1 %ok, label %sso.pool, label %sso.heap")
        line("sso.pool:")
        line("  %pb = ptrtoint ptr @s21_sso_pool to i64")
        line("  %p = add i64 %pb, %off")
        line("  %noff = add i64 %off, %need")
        line("  store i64 %noff, ptr @s21_sso_off")
        line("  %pp = inttoptr i64 %p to ptr")
        line("  ret ptr %pp")
        line("sso.heap:")
        line("  %cnt = load i64, ptr @s21_sso_malloc_cnt")
        line("  %ncnt = add i64 %cnt, 1")
        line("  store i64 %ncnt, ptr @s21_sso_malloc_cnt")
        line("  %m = call ptr @malloc(i64 %need)")
        line("  ret ptr %m")
        line("}")
        line("")
    }
    // 可捕获 panic 全局（仅 g_catch_enabled）：jmp_buf（256B，对齐 clang
    // [16 x _SETJMP_FLOAT128]）/ 捕获激活标记（i1）。捕获的 panic 消息由
    // 受捕路径直接 printf 打印（宿主以 catch_panic 返回值判定捕获与否）。
    if g_catch_enabled == 1 {
        line("@tie_panic_jb = private global [256 x i8] zeroinitializer, align 16")
        line("@tie_panic_active = private global i1 false")
        line("")
    }
}

// 用户函数调用（call 35）符号登记（去重；命名空间函数全名 → $）
pub func call_sym_reg(sid: i64) {
    var dup = false
    var k: i64 = 0
    while k < len(call_syms) {
        if call_syms[k] == sid {
            dup = true
            break
        }
        k = k + 1
    }
    if !dup {
        table_push(call_syms, sid)
    }
}

// S2.4 vtable 登记：vt_name = "vt.<port名>.<struct名>"；mnames = 方法实现函数
// 全名表（按 port 方法声明序，如 ["Button::draw", "Button::bounds"]）。
// 类型文本 = 内联聚合 "{ ptr, ... }"（字段数 = 方法数）。幂等（同名跳过）。
// irgen.gen_ast 阶段对每个 impl 记录调用一次；emit_vtables 统一输出。
pub func vtable_reg(vt_name: string, mnames: table<string>) {
    var i: i64 = 0
    while i < len(g_vt_names) {
        if interner.lookup(g_vt_names[i]) == vt_name {
            return  // 已登记（幂等）
        }
        i = i + 1
    }
    table_push(g_vt_names, interner.intern(vt_name))
    // 聚合类型文本：{ ptr, ptr, ... }（n 个 ptr）
    var ty: string = "{"
    var j: i64 = 0
    while j < len(mnames) {
        if j > 0 {
            ty = ty + ", "
        }
        ty = ty + "ptr"
        j = j + 1
    }
    ty = ty + " }"
    table_push(g_vt_tys, interner.intern(ty))
    table_push(g_vt_n, len(mnames))
    table_push(g_vt_off, len(g_vt_syms))
    var k: i64 = 0
    while k < len(mnames) {
        table_push(g_vt_syms, interner.intern(mnames[k]))
        k = k + 1
    }
}

// 输出 vtable 全局常量段（emit_globals 之后）：方法函数指针按 port 方法序。
// LLVM：`@vt.Drawable.Button = global { ptr, ptr } { ptr @Button$draw, ... }`
//（函数前向引用合法；方法函数同模块 define，无需 declare）
func emit_vtables() {
    var i: i64 = 0
    while i < len(g_vt_names) {
        var nm = interner.lookup(g_vt_names[i])
        var ty = interner.lookup(g_vt_tys[i])
        var out = "@" + nm + " = global " + ty + " {"
        var off = g_vt_off[i]
        var n = g_vt_n[i]
        var j: i64 = 0
        while j < n {
            if j > 0 {
                out = out + ","
            }
            var sym = interner.lookup(g_vt_syms[off + j])
            out = out + " ptr @" + ns_replace(sym)
            j = j + 1
        }
        out = out + " }"
        line(out)
        i = i + 1
    }
    if len(g_vt_names) > 0 {
        line("")
    }
}

// 查找子串位置（-1 = 无）
func find_sub(s: string, sub: string) -> i64 {
    var n = str_len(s)
    var m = str_len(sub)
    if m == 0 || n < m {
        return -1
    }
    var i: i64 = 0
    while i + m <= n {
        var j: i64 = 0
        var ok = true
        while j < m {
            if str_char(s, i + j) != str_char(sub, j) {
                ok = false
                break
            }
            j = j + 1
        }
        if ok {
            return i
        }
        i = i + 1
    }
    return -1
}

// 命名空间全名 → LLVM 符号：全部 `::` 转 `$`（sstate::child → sstate$child）
func ns_replace(s: string) -> string {
    var out: string = ""
    var i: i64 = 0
    var n = str_len(s)
    while i < n {
        if i + 1 < n && str_char(s, i) == ":" && str_char(s, i + 1) == ":" {
            out = out + "$"
            i = i + 2
        } else {
            out = out + str_char(s, i)
            i = i + 1
        }
    }
    return out
}

func line(s: string) {
    // 函数级缓冲（gen_func 期间）：alloca 提升 + 重编号在函数级完成后再并入
    if g_fn_mode == 1 {
        table_push(g_fn_lines, s)
        return
    }
    table_push(out_lines, s)
}

// 行首去空白（重编号判定用；llvmgen 不 import std/string 避免菱形 import，
// 这里只剥空格/制表符）
func str_trim_left(s: string) -> string {
    var n = str_len(s)
    var i: i64 = 0
    while i < n {
        var c = str_char(s, i)
        if c == " " || c == "\t" {
            i = i + 1
        } else {
            break
        }
    }
    var sub: string = ""
    while i < n {
        sub = sub + str_char(s, i)
        i = i + 1
    }
    return sub
}

// 前缀判定：s 是否以 pre 开头（str_char 逐字符比较，不依赖 std/string）
func str_prefix(s: string, pre: string) -> bool {
    var n = str_len(s)
    var m = str_len(pre)
    if n < m {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_char(s, i) != str_char(pre, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 行级重编号：把函数体的 %N 值编号重映射为 1..N 连续（对齐 Rust renumber_ir）。
// 背景：alloca 提升到 entry 后，其值 id 可能大于后续块指令的值 id（alloca 在
// 循环体中创建，值 id 分配晚于 entry 早期指令），LLVM 解析要求块内指令编号
// 严格递增——倒挂行报 "instruction expected to be numbered '%N' or greater"。
// 按行扫描：无编号行（标签/注释/空行/define 等）原样保留；有编号行
// `%N = ...` 首现分配新号，行内其余 %N 引用复用映射。str_cat 的 %scN / printf
// 的 %extN 为独立命名空间（非纯数字），不受影响。
func renumber_lines() {
    var out = table_new_string()
    // 每函数独立重编号：映射表清空，新编号从形参个数 g_pcnt 起（形参值 id 占
    // 0..N-1，定义行保留原样 %0..%N-1，指令新编号从 %N 起避免撞号）。
    g_ren_old = table_new_i64()
    g_ren_new = table_new_i64()
    g_ren_next = g_pcnt
    var n = len(g_fn_lines)
    var i: i64 = 0
    while i < n {
        var ln = g_fn_lines[i]
        var t = str_trim_left(ln)
        // 元行（无 %N 操作数，整行跳过）：define 首行、块标签 bbN:、注释、空行。
        // br/store/ret/call void 等指令行仍有 %N 操作数 → 走 renumber_line
        // （引用复用映射；行首无 %N 定义则不产生新编号——对齐 Rust 实现）。
        var no_num: bool = false
        if str_len(t) == 0 {
            no_num = true
        } else {
            var c0 = str_char(t, 0)
            if c0 == ";" || c0 == "(" || c0 == ")" {
                no_num = true
            } else if str_prefix(t, "define") {
                no_num = true
            } else if str_prefix(t, "bb") {
                no_num = true
            } else if str_prefix(t, "unreacha") {
                no_num = true
            }
        }
        // 有编号行：`%N = ...` —— 首 %N 是定义（分配新号），其余 %N 引用复用。
        // 但需注意：定义行开头 `%N =` 的 %N 也要重映射（它不是立即数/非数字）。
        if no_num {
            table_push(out, ln)
        } else {
            var rebuilt = renumber_line(ln)
            table_push(out, rebuilt)
        }
        i = i + 1
    }
    g_fn_lines = out
}

// 单行重编号：行内每个 `%N`（N 为纯数字）重映射；`%scN`/`%extN` 非纯数字不动。
// 定义/引用区分（关键）：行首 `%N = ...` 的 %N 是**指令定义**（总是分配新号，
// 即使 N < g_pcnt——函数体值 id 每函数从 0 起，alloca %0 可能与形参位置 %0
// 撞号）；行内其余 %N 引用按 ren_ref：N < g_pcnt 是形参位置引用（原样保留，
// define 形参列表 %0..%N-1 不变），否则复用指令映射。
func renumber_line(ln: string) -> string {
    var n = str_len(ln)
    var t = str_trim_left(ln)
    // 检测定义：trim 后以 % 开头且首 %N 后跟 " ="
    var lead_def: bool = false
    var lead_old: i64 = -1
    var lead_end: i64 = -1  // 定义 %N 在原始 ln 中的结束下标（相对 ln）
    if str_len(t) > 0 && str_char(t, 0) == "%" {
        var dj: i64 = 1
        var ddig: string = ""
        while dj < str_len(t) {
            var dc = str_char(t, dj)
            if dc == "0" || dc == "1" || dc == "2" || dc == "3" || dc == "4" ||
                dc == "5" || dc == "6" || dc == "7" || dc == "8" || dc == "9" {
                ddig = ddig + dc
                dj = dj + 1
            } else {
                break
            }
        }
        if str_len(ddig) > 0 && dj < str_len(t) && str_char(t, dj) == " " {
            // 确认后跟 "= "（否则是引用行，如 `call @f(%0)`）
            var ek = dj + 1
            while ek < str_len(t) && str_char(t, ek) == " " {
                ek = ek + 1
            }
            if ek < str_len(t) && str_char(t, ek) == "=" {
                lead_def = true
                lead_old = parse_int(ddig)
                // trim 前导空白数 = str_len(ln) - str_len(t)，定义 %N 结束下标
                lead_end = (str_len(ln) - str_len(t)) + dj
            }
        }
    }
    var out: string = ""
    var i: i64 = 0
    while i < n {
        var c = str_char(ln, i)
        if c == "%" && i + 1 < n {
            // 尝试读纯数字后缀
            var j = i + 1
            var digs: string = ""
            var is_num: bool = true
            while j < n {
                var d = str_char(ln, j)
                if d == "0" || d == "1" || d == "2" || d == "3" || d == "4" ||
                    d == "5" || d == "6" || d == "7" || d == "8" || d == "9" {
                    digs = digs + d
                    j = j + 1
                } else {
                    break
                }
            }
            if str_len(digs) == 0 {
                is_num = false
            }
            if is_num {
                var old = parse_int(digs)
                var new_v: i64 = -1
                // 定义位置：%N 后紧跟空格+等号才可能是定义；lead_end == j 时
                // 恰是行首定义 %N（首字符 %，无前导空白）
                if lead_def && i == 0 && j == lead_end {
                    new_v = ren_def(old)
                } else {
                    new_v = ren_ref(old)
                }
                out = out + "%" + to_string(new_v)
                i = j
                continue
            }
        }
        out = out + c
        i = i + 1
    }
    return out
}

// 指令定义重映射：总是分配新号（查表复用）。
func ren_def(old: i64) -> i64 {
    var i: i64 = 0
    while i < len(g_ren_old) {
        if g_ren_old[i] == old {
            return g_ren_new[i]
        }
        i = i + 1
    }
    table_push(g_ren_old, old)
    table_push(g_ren_new, g_ren_next)
    var v = g_ren_next
    g_ren_next = g_ren_next + 1
    return v
}

// 引用重映射：形参位置（old < g_pcnt）原样保留；否则复用/分配指令映射。
func ren_ref(old: i64) -> i64 {
    if old < g_pcnt {
        return old
    }
    return ren_def(old)
}

// 行表 → 完整 .ll 文本：分治两两合并。
// 每层合并拷贝总量 ≈ 最终大小，共 log₂N 层（总拷贝 O(total·log N)），
// 且每行只参与 log N 次拼接——相比逐行追加的 O(N²) 全量拷贝是数量级差异。
// 行语义与旧 line() 一致：每行自带尾随 "\n"（N 行 = N 个换行）。
func join_lines() -> string {
    var cur = out_lines
    var n = len(cur)
    if n == 0 {
        return ""
    }
    while n > 1 {
        var nxt = table_new_string()
        var i: i64 = 0
        while i + 1 < n {
            table_push(nxt, cur[i] + "\n" + cur[i + 1])
            i = i + 2
        }
        if i < n {
            table_push(nxt, cur[i])
        }
        cur = nxt
        n = len(cur)
    }
    return cur[0] + "\n"
}

// ==================== 类型映射 ====================
// types 自编码 → LLVM 类型名
func llvm_ty(t: i64) -> string {
    if t == TK_VOID {
        return "void"
    }
    if t == TK_I8 || t == TK_U8 {
        return "i8"
    }
    if t == TK_I16 || t == TK_U16 {
        return "i16"
    }
    if t == TK_I32 || t == TK_U32 {
        return "i32"
    }
    if t == TK_I64 || t == TK_U64 {
        return "i64"
    }
    if t == TK_I128 || t == TK_U128 {
        // 批次 2（i128/u128）：LLVM 原生 i128 类型（add/sub/mul/sdiv/srem/
        // udiv/icmp 均类型参数化，llvm_ty 映射后自动支持）
        return "i128"
    }
    if t == TK_F32 {
        return "float"
    }
    if t == TK_F64 {
        return "double"
    }
    if t == TK_BOOL {
        return "i1"
    }
    if t == TK_CHAR {
        return "i32"
    }
    if t == TK_TRIT {
        // 平衡三进制：i8 存储（值域 -1/0/1），对齐 Rust ir.rs（TritLit → i8）
        return "i8"
    }
    // 元组/struct 聚合类型（M4/M6 扩展）：
    //   元组 → 内联结构体文本 {f0, f1, ...}（字段类型递归展开）；
    //   struct → 命名结构体 %struct.<名字>（emit_agg_types 输出 type 定义）。
    // 对齐 Rust llvm_ty 的 Tuple/Struct 映射（元组内联、类命名）。
    var agg_k = types.kind(t)
    if agg_k == K_FN {
        // S2.2 fn 函数值类型：命名结构体 %fn.<签名索引> = { ptr, ptr }
        //（字段 0 = 环境指针，字段 1 = 入口函数指针；emit_agg_types 输出定义）。
        // 签名索引 = t - BASE_FN（types.fn 类型低负载）
        return "%fn." + to_string(t - BASE_FN)
    }
    if agg_k == K_PORT {
        // S2.4 port 对象类型：LLVM 表示 = 单个 ptr（指向堆上打包对象
        // {data, vtable}）——表/传参/字段/返回天然支持（探针异构
        // table<Drawable> 依赖此表示；vtable 本身是全局静态常量）。
        return "ptr"
    }
    if agg_k == K_TUPLE {
        var tidx = t - BASE_TUPLE
        var toff = tup_offs[tidx]
        var tn = tup_n[tidx]
        var tout: string = "{"
        var ti: i64 = 0
        while ti < tn {
            if ti > 0 {
                tout = tout + ", "
            }
            tout = tout + llvm_ty(tup_tys[toff + ti])
            ti = ti + 1
        }
        return tout + "}"
    }
    if agg_k == K_STRUCT {
        var sidx2 = t - BASE_STRUCT
        return "%struct." + sstate.struct_name_of(sidx2)
    }
    // enum 聚合类型（2026-08-15 enum 语言特性）：命名结构体 %enum.<名字>，
    // emit_agg_types 输出 `%enum.<名> = type { i64, i64, ..., i64 }`
    //（槽 0 = tag，槽 1..K = payload；K = en_nslot 见 emit_agg_types）。
    if agg_k == K_ENUM {
        var eidx2 = t - BASE_ENUM
        return "%enum." + sstate.enum_name_of(eidx2)
    }
    // S1.2 不安全类型：
    //   ptr<T>  → LLVM opaque ptr（元素类型仅语义信息）
    //   atomic<T> → 元素 LLVM 类型（atomic 是语义包装，LLVM 类型同元素）
    if agg_k == K_PTR {
        return "ptr"
    }
    if agg_k == K_ATOMIC {
        return llvm_ty(types.table_elem(t))
    }
    if agg_k == K_SLICE {
        // slice<T> → {ptr, i64} 聚合（指针 + 长度；LLVM opaque ptr，
        // 元素类型只影响 GEP 步长不体现在类型文本）
        return "{ ptr, i64 }"
    }
    // string/table/map 等 → ptr（引用类型）
    return "ptr"
}

// ==================== 字符串自省 ====================
// 原子内存序名称（S1.2 A1）：order IMM → LLVM ordering 关键字
func at_ord_name(ord: i64) -> string {
    if ord == 1 {
        return "acquire"
    }
    if ord == 2 {
        return "release"
    }
    if ord == 3 {
        return "acq_rel"
    }
    if ord == 4 {
        return "seq_cst"
    }
    return "relaxed"
}

// asm 模板占位符转换（S1.2 I1）：Rust 风格 `{N}` → LLVM `$N`。
// `{N}` 是操作数序号引用；LLVM 语法是 `$N`。字符级扫描替换。
func asm_tmpl_convert(t: string) -> string {
    var out = ""
    var n = str_len(t)
    var i: i64 = 0
    while i < n {
        var c = str_char(t, i)
        if c == "{" {
            // `{N}` → `$N`（N 为数字）；非数字大括号原样保留
            var j = i + 1
            var digits = ""
            while j < n {
                var cc = str_char(t, j)
                if cc >= "0" && cc <= "9" {
                    digits = digits + cc
                    j = j + 1
                } else {
                    break
                }
            }
            if j < n && str_char(t, j) == "}" && str_len(digits) > 0 {
                out = out + "$" + digits
                i = j + 1
                continue
            }
            out = out + c
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}
// S2.1：@.str.N 序号 → 该字符串常量字节长度（与 emit_strings 同款 utf.byte_len）。
// 头部长度字段是 {ptr,len} 表示的编译期来源——字面量在 .rodata 带 8 字节 i64 头。
func str_len_of_slot(slot: i64) -> i64 {
    var i: i64 = 0
    while i < len(str_pool) {
        if str_idx[i] == slot {
            return utf.byte_len(intern.lookup(str_pool[i]))
        }
        i = i + 1
    }
    return 0
}

// S2.1：字符串常量**数据指针**引用（内联 GEP 常量表达式，可直用于实参/ret/
// global 初始化——LLVM 常量表达式允许内联）。
// 字面量布局升级：`{ i64 长度头, [N+1 x i8] 数据+\0 }`（{ptr,len} 表示 +
// 边界自动 NUL：数据末尾保留 \0 供 FFI 零拷贝传递）。数据指针 = GEP 0,1。
// 所有 "@.str.N" 直引点统一走本函数，保证引用指向数据而非头部。
func str_data_ref(slot: i64) -> string {
    var n = str_len_of_slot(slot)
    return "getelementptr ({ i64, [" + to_string(n + 33) + " x i8] }, ptr @.str." +
        to_string(slot) + ", i32 0, i32 1)"
}

// 查找/登记字符串池 id → @.str.N 序号
func str_slot(name_id: i64) -> i64 {
    var i: i64 = 0
    while i < len(str_pool) {
        if str_pool[i] == name_id {
            return str_idx[i]
        }
        i = i + 1
    }
    var n = str_count
    table_push(str_pool, name_id)
    table_push(str_idx, n)
    str_count = str_count + 1
    return n
}

// 遍历 tie-IR 全部指令，收集 const_str(62) 与 call_vararg(41) 的字符串操作数
func collect_strings() {
    str_pool = table_new_i64()
    str_idx = table_new_i64()
    str_count = 0
    var ni = ir.inst_count()
    var i: i64 = 0
    while i < ni {
        var op = ir.ins_op(i)
        var cnt = ir.ins_ops_cnt(i)
        var k: i64 = 0
        if op == 62 {
            // const_str：操作数[0] = 字符串池 id
            if cnt >= 1 {
                str_slot(ir.ins_opnd(i, 0))
            }
        } else if op == 41 {
            // call_vararg：操作数[0] = 格式串池 id
            if cnt >= 1 {
                str_slot(ir.ins_opnd(i, 0))
            }
        }
        i = i + 1
    }
}

// T4.5：遍历全部指令，收集 extern_call(36) 的符号名池 id（去重）。
// 符号名经 interner 还原文本；emit_extern_decls 按符号名输出 declare。
// 阶段 A：同时收集 call(35) 用户函数符号（call_syms；无需 declare，本模块定义）。
func collect_externs() {
    ext_syms = table_new_i64()
    call_syms = table_new_i64()
    var ni = ir.inst_count()
    var i: i64 = 0
    while i < ni {
        var op = ir.ins_op(i)
        if op == 36 && ir.ins_ops_cnt(i) >= 1 {
            var sid = ir.ins_opnd(i, 0)
            var dup = false
            var k: i64 = 0
            while k < len(ext_syms) {
                if ext_syms[k] == sid {
                    dup = true
                    break
                }
                k = k + 1
            }
            if !dup {
                table_push(ext_syms, sid)
            }
        } else if op == 35 && ir.ins_ops_cnt(i) >= 1 {
            var sid2 = ir.ins_opnd(i, 0)
            call_sym_reg(sid2)
        }
        i = i + 1
    }
}

// 符号名 → declare 声明文本（tie 运行时桥签名表；未登记符号返回空串）。
// 与 std/runtime.tie / tie_interp.lib 的导出符号一一对应（阶段 A 扩展）：
//   返回 i64：tie_exec_code(ptr) / tie_time_now() / tie_str_len(ptr) /
//            tie_char_code(ptr) / tie_arg_count() / tie_table_len(ptr) /
//            tie_parse_int(ptr, ptr)
//   返回 ptr：tie_get_env(ptr) / tie_exec_output(ptr) / tie_str_char(ptr, i64) /
//            tie_to_string_i64(i64) / tie_to_string_f64(double) / tie_file_read(ptr) /
//            tie_arg_string(i64) / tie_table_new(i64) / tie_table_at_i64(ptr, i64, ptr) /
//            tie_table_at_string(ptr, i64, ptr) / tie_print_err(ptr) / tie_mkdir_all(ptr) /
//            tie_regex_find_all(ptr, ptr) / tie_read_line() / tie_cwd() / tie_eval_expr(ptr)
//   返回 void：tie_table_push_i64(ptr, i64) / tie_table_push_string(ptr, ptr) /
//            tie_table_push_bool(ptr, i8) / tie_table_set_i64(ptr, i64, i64, ptr) /
//            tie_table_set_string(ptr, i64, ptr, ptr) / tie_byte_write(ptr, ptr) /
//            tie_set_env(ptr, ptr) / tie_msg_register(ptr, ptr, ptr)
//   返回 i8：tie_mkdir_all(ptr) / tie_file_copy(ptr, ptr) / tie_file_move(ptr, ptr) /
//            tie_http_get_file(ptr, ptr) / tie_untar_gz(ptr, ptr) / tie_unzip(ptr, ptr) /
//            tie_copy_dir(ptr, ptr) / tie_byte_write(ptr, ptr)
// 注意：返回 void 的桥在 irgen 用 ty=-1 建指令（无结果寄存器）。
func extern_decl(sym: string) -> string {
    if sym == "tie_exec_code" {
        return "declare i64 @tie_exec_code(ptr)"
    }
    // S2.1：libc memcpy（StringBuilder 数据拷贝；clang 链接 CRT 提供）
    if sym == "memcpy" {
        return "declare void @memcpy(ptr, ptr, i64)"
    }
    // 批次 7 catch_panic：无条件 declare（emit 头部，带 returns_twice/noreturn
    // 属性），此处不重复 declare（LLVM 拒绝重复定义）。
    if sym == "longjmp" || sym == "_setjmp" || sym == "llvm.frameaddress.p0" {
        return ""
    }
    if sym == "tie_get_env" {
        return "declare ptr @tie_get_env(ptr)"
    }
    if sym == "tie_time_now" {
        return "declare i64 @tie_time_now()"
    }
    if sym == "tie_str_len" {
        return "declare i64 @tie_str_len(ptr)"
    }
    if sym == "tie_char_code" {
        return "declare i64 @tie_char_code(ptr)"
    }
    if sym == "tie_str_char" {
        return "declare ptr @tie_str_char(ptr, i64)"
    }
    if sym == "tie_str_from_code" {
        // 码点 → 单字符 UTF-8 字符串（返回堆串，调用方负责 tie_free_result）。
        return "declare ptr @tie_str_from_code(i64)"
    }
    // ---------- 网络原语（P0：std/net）----------
    // 句柄 i64；recv 返回 ptr（堆串）；close 返回 i8（bool 桥）。
    if sym == "tie_net_tcp_listen" {
        return "declare i64 @tie_net_tcp_listen(i64)"
    }
    if sym == "tie_net_tcp_accept" {
        return "declare i64 @tie_net_tcp_accept(i64)"
    }
    if sym == "tie_net_tcp_connect" {
        return "declare i64 @tie_net_tcp_connect(ptr, i64)"
    }
    if sym == "tie_net_tcp_send" {
        return "declare i64 @tie_net_tcp_send(i64, ptr)"
    }
    if sym == "tie_net_tcp_recv" {
        return "declare ptr @tie_net_tcp_recv(i64, i64)"
    }
    if sym == "tie_net_udp_bind" {
        return "declare i64 @tie_net_udp_bind(i64)"
    }
    if sym == "tie_net_udp_send" {
        return "declare i64 @tie_net_udp_send(i64, ptr, i64, ptr)"
    }
    if sym == "tie_net_udp_recv" {
        return "declare ptr @tie_net_udp_recv(i64, i64)"
    }
    if sym == "tie_net_close" {
        return "declare i8 @tie_net_close(i64)"
    }
    if sym == "tie_to_string_i64" {
        return "declare ptr @tie_to_string_i64(i64)"
    }
    if sym == "tie_to_string_f64" {
        return "declare ptr @tie_to_string_f64(double)"
    }
    if sym == "tie_parse_int" {
        return "declare i64 @tie_parse_int(ptr, ptr)"
    }
    if sym == "tie_parse_float" {
        return "declare double @tie_parse_float(ptr, ptr)"
    }
    if sym == "tie_parse_trit" {
        return "declare i8 @tie_parse_trit(ptr, ptr)"
    }
    if sym == "tie_list_dir" {
        return "declare ptr @tie_list_dir(ptr)"
    }
    if sym == "tie_http_get" {
        return "declare ptr @tie_http_get(ptr)"
    }
    if sym == "tie_msg_t_lang" {
        return "declare ptr @tie_msg_t_lang(ptr, ptr)"
    }
    if sym == "tie_set_env" {
        return "declare void @tie_set_env(ptr, ptr)"
    }
    if sym == "tie_msg_register" {
        return "declare void @tie_msg_register(ptr, ptr, ptr)"
    }
    if sym == "tie_byte_write" {
        return "declare i8 @tie_byte_write(ptr, ptr)"
    }
    if sym == "tie_exec_output" {
        return "declare ptr @tie_exec_output(ptr)"
    }
    if sym == "tie_arg_count" {
        return "declare i64 @tie_arg_count()"
    }
    if sym == "tie_arg_string" {
        return "declare ptr @tie_arg_string(i64)"
    }
    if sym == "tie_file_read" {
        return "declare ptr @tie_file_read(ptr)"
    }
    // 完整 fs 桥（UTF-8 路径安全，Windows 宽字符 API；irgen 的 file_* 内置
    // 从 libc fopen/remove 迁至此处——中文路径不再被 ANSI 代码页误读）
    if sym == "tie_file_exists" {
        return "declare i8 @tie_file_exists(ptr)"
    }
    if sym == "tie_file_write" {
        return "declare i8 @tie_file_write(ptr, ptr)"
    }
    if sym == "tie_file_append" {
        return "declare i8 @tie_file_append(ptr, ptr)"
    }
    if sym == "tie_file_delete" {
        return "declare i8 @tie_file_delete(ptr)"
    }
    if sym == "tie_file_size" {
        return "declare i64 @tie_file_size(ptr)"
    }
    if sym == "tie_file_is_dir" {
        return "declare i8 @tie_file_is_dir(ptr)"
    }
    if sym == "tie_file_is_file" {
        return "declare i8 @tie_file_is_file(ptr)"
    }
    if sym == "tie_read_line" {
        return "declare ptr @tie_read_line()"
    }
    if sym == "tie_eval_expr" {
        return "declare ptr @tie_eval_expr(ptr)"
    }
    if sym == "tie_cwd" {
        return "declare ptr @tie_cwd()"
    }
    if sym == "tie_print_err" {
        return "declare void @tie_print_err(ptr)"
    }
    if sym == "tie_table_new" {
        return "declare ptr @tie_table_new(i64)"
    }
    if sym == "tie_table_push_i64" {
        return "declare void @tie_table_push_i64(ptr, i64)"
    }
    if sym == "tie_table_push_string" {
        return "declare void @tie_table_push_string(ptr, ptr)"
    }
    if sym == "tie_table_push_bool" {
        return "declare void @tie_table_push_bool(ptr, i8)"
    }
    if sym == "tie_table_push_f64" {
        return "declare void @tie_table_push_f64(ptr, double)"
    }
    if sym == "tie_table_at_i64" {
        return "declare i64 @tie_table_at_i64(ptr, i64, ptr)"
    }
    if sym == "tie_table_at_f64" {
        return "declare double @tie_table_at_f64(ptr, i64, ptr)"
    }
    if sym == "tie_table_at_ptr" {
        return "declare ptr @tie_table_at_ptr(ptr, i64, ptr)"
    }
    if sym == "tie_table_at_string" {
        return "declare ptr @tie_table_at_string(ptr, i64, ptr)"
    }
    if sym == "tie_table_at_bool" {
        return "declare i8 @tie_table_at_bool(ptr, i64, ptr)"
    }
    if sym == "tie_table_len" {
        return "declare i64 @tie_table_len(ptr)"
    }
    if sym == "tie_table_set_i64" {
