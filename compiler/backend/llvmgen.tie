    }
    if sym == "tie_regex_find_all" {
        return "declare ptr @tie_regex_find_all(ptr, ptr)"
    }
    if sym == "tie_regex_match" {
        return "declare i8 @tie_regex_match(ptr, ptr, ptr)"
    }
    if sym == "tie_regex_find" {
        return "declare ptr @tie_regex_find(ptr, ptr)"
    }
    if sym == "tie_regex_group" {
        return "declare ptr @tie_regex_group(ptr, ptr, i64)"
    }
    if sym == "tie_regex_replace" {
        return "declare ptr @tie_regex_replace(ptr, ptr, ptr)"
    }
    if sym == "tie_msg_t" {
        return "declare ptr @tie_msg_t(ptr)"
    }
    if sym == "tie_msg_get_lang" {
        return "declare ptr @tie_msg_get_lang()"
    }
    if sym == "tie_msg_set_lang" {
        return "declare void @tie_msg_set_lang(ptr)"
    }
    if sym == "tie_eval_call" {
        return "declare ptr @tie_eval_call(ptr, ptr)"
    }
    if sym == "tie_byte_read" {
        return "declare ptr @tie_byte_read(ptr)"
    }
    if sym == "tie_byte_concat" {
        return "declare ptr @tie_byte_concat(ptr, ptr)"
    }
    if sym == "tie_bit_read" {
        return "declare i64 @tie_bit_read(ptr, i64)"
    }
    if sym == "tie_bit_write" {
        return "declare i8 @tie_bit_write(ptr, i64, i64)"
    }
    if sym == "tie_remove_dir_all" {
        return "declare i8 @tie_remove_dir_all(ptr)"
    }
    if sym == "tie_walk_dir" {
        return "declare ptr @tie_walk_dir(ptr)"
    }
    if sym == "tie_path_basename" {
        return "declare ptr @tie_path_basename(ptr)"
    }
    if sym == "tie_path_dirname" {
