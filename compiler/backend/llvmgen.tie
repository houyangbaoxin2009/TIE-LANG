type tie<class>
// compiler/backend/llvmgen.tie —— 自举 v2 T2.8：tie-IR → LLVM IR 文本生成
// ============================================================
// 里程碑：自举 v2 计划 T2.8（.omo/plans/self-hosting-v2.md）后端 LLVM IR
// 文本生成器。本文件 = tie-IR 列式表 → .ll 文本（Rust ir.rs run() 契约）。
// 最小可行集：模块头/declare/define/entry 块/指令映射/字符串常量。
// **字符串自省**：遍历 tie-IR 的 const_str(62)/call_vararg(41) 指令收集
// 字符串池 id，经 interner.lookup 还原文本生成 @.str.N（不依赖 irgen）。
// 依赖：./../middle/ir.tie（tie-IR 表访问）。
// types.tie 经 irgen→semantic→…→stype→data 树传递可达（K_NAMED/TK_*）；
// str_char/char_code/str_len/to_string 为语言底座原语（全局可见，无需 import）；
// intern 经 irgen→semantic→…→lex_tokdefs→interner 树传递可达。
// 唯一直接 import ir.tie：避免菱形 import 导致全局变量重复定义。
// 树式无环：irgen import 本文件（本文件不 import irgen）。
// UTF-8 字节级能力复用 std/utf（hex_escape/utf8_bytes/byte_len），
// 不再内联重复实现（编译器自举后亦可继续依赖 std——std 亦为 tie 自写）。
// S3.2：import 用 "../middle/ir.tie"（无 "./" 前缀）→ 展开路径归一化为
// "compiler/middle/ir.tie"，与 tieir_ser 树的 ir 展开路径字符串一致，
// import 去重生效（此前 "./../middle/ir.tie" 得 "compiler/backend/../middle/
// ir.tie"，双入口时 ir 全局常量重复定义）
import "../middle/ir.tie"
import "../../std/utf.tie"
import "./llvmgen_str.tie"  // 字符串自省+extern 声明+类型映射 子文件（同 namespace 跨文件拆分）
import "./llvmgen_inst.tie"  // 指令映射 子文件（同 namespace 跨文件拆分）

// emit 子阶段计时（性能诊断，TIEC_TIME=1 时输出）：函数生成 vs 归并。
// GetTickCount extern 在 semantic.tie 顶层声明（跨文件 extern 全局可调用，
// 本文件不重复声明——编译器禁止跨文件重复定义同一 extern）。
var e_t_funcs: i64 = 0
var e_t_join: i64 = 0
var g_t_ren: i64 = 0  // renumber_lines 累计（全部函数）

// ==================== 输出缓冲 ====================
// 行收集表：line() 只追加（O(1)），emit() 末尾分治拼接成完整文本。
// 避免 `out_buf = out_buf + s` 的 O(N²) 全量拷贝——tie 字符串不可变，
// str_cat 每次 malloc 新串且旧串无 GC 回收，自编译（10 万级行）会挂起
// 并耗尽内存（曾实测 30s+ / 2.3GB）。
var out_lines: table<string>;
// 值 id → 定义指令 id 索引（value_def 缓存）：值 id 从 0 连续分配
// （ir.new_value 单调递增），直接作表下标 → O(1) 查询，替代全指令
// 线性扫描的 O(N²)（每条指令的每个实参引用都全扫一遍）。
var vdef_cache: table<i64>;
var vdef_cache_ready: i64 = 0;
// 调试：当前生成函数 id（gen_inst 的细粒度诊断用；0 = 未生成，真实 fid 从 0 起）
var g_pfid: i64 = 0;
// 当前函数参数个数（opnd_ref 形参映射用）
var g_pcnt: i64 = 0;
// 指令 id → 块 id 映射（emit 开头构建一次；gen_func 按指令序遍历用）。
// 块 id 创建序 ≠ 值 id 分配序（if/while 嵌套：then/else/merge 块先创建、
// 循环头块后创建）——按块 id 遍历会值编号回退，LLVM 解析拒绝。
var g_inst_blk: table<i64>;
var g_inst_blk_ready: i64 = 0;
// 字符串常量表：池 id → @.str.N 序号（自省收集）
var str_pool: table<i64>;   // 字符串池 id（登记序）
var str_idx: table<i64>;    // 对应 @.str.N
var str_count: i64 = 0;
// printf i32 实参 sext 的新寄存器计数（LLVM 不支持内联 sext 表达式实参，
// 每处 i32 实参生成一个独立 %ext<N> 寄存器）
var g_sext_cnt: i64 = 0;
// T4.5：extern_call(36) 收集的符号名池 id（去重登记序；llvmgen 顶层变量，
// 与 out_buf 等同级——命名空间体内不允许 var）
var ext_syms: table<i64>;
// 阶段 A：全局变量登记（名池 id → 表/标量 + 类型）。表全局 → ptr null 占位
// + main 入口初始化；标量 → 零值 global。
var g_global_names: table<i64>;   // 全局名池 id（登记序）
var g_global_is_table: table<i64>;  // 1 = 表全局（ptr null），0 = 标量
var g_global_tys: table<i64>;     // 标量类型 id（表全局 -1）
var g_global_inits: table<i64>;   // const 标量初始值（-1 = 无；i64 字面量）
var g_global_strs: table<i64>;    // 顶层字符串 const 初始值（字符串池 id；-1 = 无）
// 阶段 A：用户函数调用（call 35）的符号名池 id（去重，与 ext_syms 平行收集；
// 命名空间函数全名经 ns_symbol 转 $，无需 declare）
var call_syms: table<i64>;
// S2.4：vtable 全局常量登记（每个 impl 一个：方法函数指针按 port 方法声明序）。
// 符号名 = "vt.<port名>.<struct名>"；类型 = 内联聚合文本 "{ ptr, ... }"
//（函数指针数组）；方法符号 = 实现函数全名（LLVM 符号经 ns_replace 转 $）。
var g_vt_names: table<i64>;   // vtable 符号名池 id（登记序）
var g_vt_tys: table<i64>;     // vtable 聚合类型文本池 id（"{ ptr, ptr }" 等）
var g_vt_n: table<i64>;       // 字段数（= port 方法数）
var g_vt_off: table<i64>;     // 方法符号段偏移（g_vt_syms 扁平段）
var g_vt_syms: table<i64>;    // 方法函数全名池 id（扁平段）
// SSO 短串池（dev33 批次 3）：启用标记。irgen 首次调用 s21_sso_alloc 置位，
// emit 主流程据此刻意输出 @s21_sso_pool / @s21_sso_off / @s21_sso_malloc_cnt。
// 仅用到短串池的程序才带 256KB .bss，纯字面量程序不引入。
var g_sso_enabled: i64 = 0;
// 可捕获 panic（dev33 批次 7）：启用标记。irgen 首次生成 catch_panic/受捕
// panic 置位，emit 据此输出 @tie_panic_jb / @tie_panic_msg / @tie_panic_active。
var g_catch_enabled: i64 = 0;
// 阶段 A：str_cat 内联序列的临时寄存器计数（与 printf sext 同款独立命名空间，
// 避免与 %N 值编号冲突）
var g_str_reg_cnt: i64 = 0;
// 临时 alloca 提升（F1 增强）+ 行级重编号（对齐 Rust renumber_ir）：
// irgen 的 ok 槽等临时 alloca 生成在当前块（循环体内），LLVM 对循环内 alloca
// 生成动态栈分配（sub rsp 无恢复）——百万级循环栈溢出（map-bench 150 轮 →
// 0xC00000FD，普适 map 段错误根因之一）。修复：gen_func 把函数全部 alloca
// 前置到 entry block 输出（收集序），再对函数体行级重编号（%N → 1..N 连续）
// 解决编号倒挂（alloca 值 id 大于后序指令值 id，LLVM 要求块内严格递增）。
// 函数级缓冲：gen_func 期间 line() 写入 g_fn_lines，结束重编号后追加全局。
var g_fn_lines: table<string>;
var g_fn_mode: i64 = 0;
// 函数指令区间索引（性能：emit 开头构建一次，O(B)）：lo[fid]..hi[fid] =
// 函数 fid 的指令区间。指令表按函数连续（ir.new_inst 顺序 append、块按函数
// 创建），gen_func 遍历从全表 O(F×N) 降为区间 O(N)——不再每函数全量扫全部
// 指令表（此前 400+ 函数 × 几十万指令 = 上亿次迭代，emit funcs 4.4s 主体）。
var g_fn_inst_lo: table<i64>;
var g_fn_inst_hi: table<i64>;
var g_hoisted_allocas: table<i64>;
var g_hoisted_cnt: i64 = 0;
// 重编号映射表（直索引）：旧值 id → 新值 id（-1 = 未设；旧值 id 稠密小整数）
var g_ren_map: table<i64>;
var g_ren_next: i64 = 1;

namespace llvmgen {

// 本地字符串切片 [start, end)（码点级；对齐 irgen.ig_slice）。
// 历史 bug：global_ref 曾调用未定义的裸 `slice`，导致所有 import 本模块的
// 程序（driver-lite/driver）编译报"未定义的函数 'slice'"。本辅助补齐。
func l_slice(s: string, start: i64, end: i64) -> string {
    // 性能重写（O(n)）：字节定位 + StringBuilder 拷贝（旧逐字符拼接 O(n²)）
    var n: i64 = str_len(s)
    if start < 0 {
        start = 0
    }
    if end > n {
        end = n
    }
    if start >= end {
        return ""
    }
    // 一次码点扫描：顺路记录 start 的字节偏移（bstart），扫到 end 得字节偏移（b）
    var b: i64 = 0
    var i: i64 = 0
    var bstart: i64 = 0
    while i < end {
        if i == start {
            bstart = b
        }
        b = b + utf8_seq_len(s, b)
        i = i + 1
    }
    // 字节区间拷贝（start < end 保证 bstart 已被赋值）
    var sb = string_builder()
    var k: i64 = bstart
    while k < b {
        sb_append_byte(sb, str_byte(s, k))
        k = k + 1
    }
    return sb_build(sb)
}

// 查找字符串中第一个指定字符的下标（-1 = 无）。
// 历史 bug：const_f 曾调用未定义的裸 `find_char`，本辅助补齐。
func l_find_char(s: string, c: string) -> i64 {
    var n = str_len(s)
    var i: i64 = 0
    while i < n {
        if str_char(s, i) == c {
            return i
        }
        i = i + 1
    }
    return -1
}

// 全局变量登记：表全局（global ptr null + main 初始化）/ 标量（零值 global）。
// 供 irgen.tig_global_var 调用（driver 树顶层 VarDecl 439 个）。
pub func global_table_reg(nm: string) {
    var nid = interner.intern(nm)
    table_push(g_global_names, nid)
    table_push(g_global_is_table, 1)
    table_push(g_global_tys, -1)
    table_push(g_global_inits, -1)
    table_push(g_global_strs, -1)
}

pub func global_scalar_reg(nm: string, ty: i64) {
    var nid = interner.intern(nm)
    table_push(g_global_names, nid)
    table_push(g_global_is_table, 0)
    table_push(g_global_tys, ty)
    table_push(g_global_inits, -1)
    table_push(g_global_strs, -1)
}

// const 标量初始值（i64 字面量）：emit_globals 输出 @g = global i64 <v>
pub func global_scalar_init(nm: string, v: i64) {
    var nid = interner.intern(nm)
    var i: i64 = 0
    while i < len(g_global_names) {
        if g_global_names[i] == nid {
            g_global_inits[i] = v
            return
        }
        i = i + 1
    }
}

// 顶层字符串 const 初始值：emit_globals 输出 @g = global ptr @.str.N（字面量）
pub func global_str_init(nm: string, lexeme_id: i64) {
    var nid = interner.intern(nm)
    var i: i64 = 0
    while i < len(g_global_names) {
        if g_global_names[i] == nid {
            // 去引号 lexeme → 纯文本池 id（与 tig_str_lit 同款）
            var clean = lexeme_id
            var txt = intern.lookup(lexeme_id)
            var n: i64 = str_len(txt)
            if n >= 2 && str_char(txt, 0) == "\"" && str_char(txt, n - 1) == "\"" {
                var sub: string = ""
                var k: i64 = 1
                while k < n - 1 {
                    sub = sub + str_char(txt, k)
                    k = k + 1
                }
                clean = interner.intern(sub)
            }
            g_global_strs[i] = clean
            return
        }
        i = i + 1
    }
}

// 全局表是否已登记（irgen 查表变量语义类型用）
func global_is_table(nm: string) -> i64 {
    var nid = interner.intern(nm)
    var i: i64 = 0
    while i < len(g_global_names) {
        if g_global_names[i] == nid {
            return g_global_is_table[i]
        }
        i = i + 1
    }
    return 0
}

// 输出聚合类型段（模块头 declare 之后、全局变量之前）：
// 遍历语义层已登记的 struct（st_keys/st_vals + cls_* + fld_*），
// 输出 `%struct.<名> = type { 字段类型... }`（元组内联在 llvm_ty，无需定义）。
func emit_agg_types() {
    var n = len(st_vals)
    var i: i64 = 0
    while i < n {
        var si = st_vals[i]
        var off = cls_fldoff[si]
        var cnt = cls_nfld[si]
        var out: string = "%struct." + intern.lookup(st_keys[i]) + " = type {"
        var j: i64 = 0
        while j < cnt {
            if j > 0 {
                out = out + ","
            }
            out = out + " " + llvm_ty(fld_tys[off + j])
            j = j + 1
        }
        out = out + " }"
        line(out)
        i = i + 1
    }
    // enum 类型输出（2026-08-15 enum 语言特性）：`%enum.<名> = type { i64, i64×K }`。
    // 布局：槽 0 = tag（变体号 i64），槽 1..K = payload（K = en_nslot[ei]，
    // 所有变体 payload 字段数最大值）。**循环独立于 st_vals**——en_vals 是
    // 按 enum 名升序排列的索引表（与 en_keys 并行），不可复用上面 st_vals 循环。
    var ne = len(en_vals)
    var ei2: i64 = 0
    while ei2 < ne {
        var eidx = en_vals[ei2]
        var eout: string = "%enum." + sstate.enum_name_of(eidx) + " = type { i64"
        var k2: i64 = 0
        while k2 < en_nslot[eidx] {
            eout = eout + ", i64"
            k2 = k2 + 1
        }
        eout = eout + " }"
        line(eout)
        ei2 = ei2 + 1
    }
    // fn 函数值类型输出（S2.2）：`%fn.<签名索引> = type { ptr, ptr }`——
    // 闭包值 = { env 指针, entry 函数指针 }（见 closure-model.md C2）。
    // fn_ret 是 types 命名空间外的全局签名表（fn 类型低负载 = 签名表行号）。
    var nfn = len(fn_ret)
    var fi: i64 = 0
    while fi < nfn {
        line("%fn." + to_string(fi) + " = type { ptr, ptr }")
        fi = fi + 1
    }
    if len(st_vals) > 0 || len(en_vals) > 0 || len(fn_ret) > 0 {
        line("")
    }
}

// 输出全局变量段（模块头 declare 之后、函数 define 之前）：
//   @g = global ptr null            （表全局，main 入口运行时创建）
//   @g = global T <零值>             （标量；i64→0 / bool→false / string→null / f64→0.0）
func emit_globals() {
    var i: i64 = 0
    while i < len(g_global_names) {
        var nm = intern.lookup(g_global_names[i])
        if g_global_is_table[i] == 1 {
            line("@" + nm + " = global ptr null")
        } else {
            var ty = llvm_ty(g_global_tys[i])
            var init = "0"
            // const 整数字面量初始值（i64 字面量直接输出；其余保持零值）
            if i < len(g_global_inits) && g_global_inits[i] >= 0 && ty == "i64" {
                init = to_string(g_global_inits[i])
            }
            if ty == "ptr" {
                // string 全局默认空串常量（null 会被 strcmp 段错误）；
                // const 字符串全局有初始字面量 → 指向该字面量常量
                if g_global_tys[i] == TK_STR {
                    var eslot = 0
                    if i < len(g_global_strs) && g_global_strs[i] >= 0 {
                        eslot = str_slot(g_global_strs[i])
                    } else {
                        var empty_id = interner.intern("")
                        eslot = str_slot(empty_id)
                    }
                    line("@" + nm + " = global ptr " + str_data_ref(eslot))
                    i = i + 1
                    continue
                }
                init = "null"
            } else if ty == "i1" {
                init = "false"
            } else if ty == "double" {
                init = "0.0"
            } else if ty == "float" {
                init = "0.0"
            }
            line("@" + nm + " = global " + ty + " " + init)
        }
        i = i + 1
    }
    if len(g_global_names) > 0 {
        line("")
    }
}

// SSO 短串池启用标记（irgen s21_sso_alloc 首次调用置位；幂等）。
pub func sso_enable() {
    g_sso_enabled = 1
}

// 可捕获 panic 启用标记（irgen 首次生成 catch_panic / 受捕 panic 置位；幂等）。
pub func catch_enable() {
    g_catch_enabled = 1
}

// 输出 SSO 短串池全局段（emit_globals 之后）：仅 g_sso_enabled 时输出。
//   @s21_sso_pool      = 256KB 静态线性池（.bss，零运行时初始化）
//   @s21_sso_off       = 当前 bump 偏移
//   @s21_sso_malloc_cnt = 池满回退 malloc 的累计次数（验收探针断言 = 0）
// 并定义短串池分配 helper @tie_sso_alloc(i64 %n) -> ptr：
//   参数 n = 数据长度（UTF-8 字节）；返回块基址（头位置，调用方写头后取数据）。
//   块 = n + 41（8 头 + 数据 + \0 + 32 尾部填充，漏洞 B 安全余量不变）。
//   短串（n ≤ 31 且池剩余 ≥ n+41）→ 池 bump（零 malloc）；否则回退 malloc 计数。
//   供 llvmgen op56（str_cat）与 gen_ext_str_scan（FFI 收方向）内联调用——
//   与 irgen s21_sso_alloc 逻辑同构（共用 @s21_sso_off / @s21_sso_malloc_cnt）。
func emit_sso_globals() {
    // SSO 短串池段（仅 g_sso_enabled）
    if g_sso_enabled == 1 {
        line("@s21_sso_pool = private global [262144 x i8] zeroinitializer")
        line("@s21_sso_off = private global i64 0")
        line("@s21_sso_malloc_cnt = private global i64 0")
        line("define private ptr @tie_sso_alloc(i64 %n) {")
        line("  %short = icmp sle i64 %n, 31")
        line("  %need = add i64 %n, 41")
        line("  %off = load i64, ptr @s21_sso_off")
        line("  %remain = sub i64 262144, %off")
        line("  %space = icmp sle i64 %need, %remain")
        line("  %ok = and i1 %short, %space")
        line("  br i1 %ok, label %sso.pool, label %sso.heap")
        line("sso.pool:")
        line("  %pb = ptrtoint ptr @s21_sso_pool to i64")
        line("  %p = add i64 %pb, %off")
        line("  %noff = add i64 %off, %need")
        line("  store i64 %noff, ptr @s21_sso_off")
        line("  %pp = inttoptr i64 %p to ptr")
        line("  ret ptr %pp")
        line("sso.heap:")
        line("  %cnt = load i64, ptr @s21_sso_malloc_cnt")
        line("  %ncnt = add i64 %cnt, 1")
        line("  store i64 %ncnt, ptr @s21_sso_malloc_cnt")
        line("  %m = call ptr @malloc(i64 %need)")
        line("  ret ptr %m")
        line("}")
        line("")
    }
    // 可捕获 panic 全局（仅 g_catch_enabled）：jmp_buf（256B，对齐 clang
    // [16 x _SETJMP_FLOAT128]）/ 捕获激活标记（i1）。捕获的 panic 消息由
    // 受捕路径直接 printf 打印（宿主以 catch_panic 返回值判定捕获与否）。
    if g_catch_enabled == 1 {
        line("@tie_panic_jb = private global [256 x i8] zeroinitializer, align 16")
        line("@tie_panic_active = private global i1 false")
        line("")
    }
}

// 用户函数调用（call 35）符号登记（去重；命名空间函数全名 → $）
pub func call_sym_reg(sid: i64) {
    var dup = false
    var k: i64 = 0
    while k < len(call_syms) {
        if call_syms[k] == sid {
            dup = true
            break
        }
        k = k + 1
    }
    if !dup {
        table_push(call_syms, sid)
    }
}

// S2.4 vtable 登记：vt_name = "vt.<port名>.<struct名>"；mnames = 方法实现函数
// 全名表（按 port 方法声明序，如 ["Button::draw", "Button::bounds"]）。
// 类型文本 = 内联聚合 "{ ptr, ... }"（字段数 = 方法数）。幂等（同名跳过）。
// irgen.tig_ast 阶段对每个 impl 记录调用一次；emit_vtables 统一输出。
pub func vtable_reg(vt_name: string, mnames: table<string>) {
    var i: i64 = 0
    while i < len(g_vt_names) {
        if interner.lookup(g_vt_names[i]) == vt_name {
            return  // 已登记（幂等）
        }
        i = i + 1
    }
    table_push(g_vt_names, interner.intern(vt_name))
    // 聚合类型文本：{ ptr, ptr, ... }（n 个 ptr）
    var ty: string = "{"
    var j: i64 = 0
    while j < len(mnames) {
        if j > 0 {
            ty = ty + ", "
        }
        ty = ty + "ptr"
        j = j + 1
    }
    ty = ty + " }"
    table_push(g_vt_tys, interner.intern(ty))
    table_push(g_vt_n, len(mnames))
    table_push(g_vt_off, len(g_vt_syms))
    var k: i64 = 0
    while k < len(mnames) {
        table_push(g_vt_syms, interner.intern(mnames[k]))
        k = k + 1
    }
}

// 输出 vtable 全局常量段（emit_globals 之后）：方法函数指针按 port 方法序。
// LLVM：`@vt.Drawable.Button = global { ptr, ptr } { ptr @Button$draw, ... }`
//（函数前向引用合法；方法函数同模块 define，无需 declare）
func emit_vtables() {
    var i: i64 = 0
    while i < len(g_vt_names) {
        var nm = interner.lookup(g_vt_names[i])
        var ty = interner.lookup(g_vt_tys[i])
        var out = "@" + nm + " = global " + ty + " {"
        var off = g_vt_off[i]
        var n = g_vt_n[i]
        var j: i64 = 0
        while j < n {
            if j > 0 {
                out = out + ","
            }
            var sym = interner.lookup(g_vt_syms[off + j])
            out = out + " ptr @" + ns_replace(sym)
            j = j + 1
        }
        out = out + " }"
        line(out)
        i = i + 1
    }
    if len(g_vt_names) > 0 {
        line("")
    }
}

// 查找子串位置（-1 = 无）
func find_sub(s: string, sub: string) -> i64 {
    var n = str_len(s)
    var m = str_len(sub)
    if m == 0 || n < m {
        return -1
    }
    var i: i64 = 0
    while i + m <= n {
        var j: i64 = 0
        var ok = true
        while j < m {
            if str_char(s, i + j) != str_char(sub, j) {
                ok = false
                break
            }
            j = j + 1
        }
        if ok {
            return i
        }
        i = i + 1
    }
    return -1
}

// 命名空间全名 → LLVM 符号：全部 `::` 转 `$`（sstate::child → sstate$child）
func ns_replace(s: string) -> string {
    var out: string = ""
    var i: i64 = 0
    var n = str_len(s)
    while i < n {
        if i + 1 < n && str_char(s, i) == ":" && str_char(s, i + 1) == ":" {
            out = out + "$"
            i = i + 2
        } else {
            out = out + str_char(s, i)
            i = i + 1
        }
    }
    return out
}

func line(s: string) {
    // 函数级缓冲（gen_func 期间）：alloca 提升 + 重编号在函数级完成后再并入
    if g_fn_mode == 1 {
        table_push(g_fn_lines, s)
        return
    }
    table_push(out_lines, s)
}

// 行首去空白（重编号判定用；llvmgen 不 import std/string 避免菱形 import，
// 这里只剥空格/制表符）。
// 性能重构（emit ren 7.4s 热点）：旧版第 2 循环 `sub = sub + str_char(s, i)`
// 逐码点拼接 O(n²)（每次 str_cat 分配新串），且重编号路径每行调用 2 次
// （renumber_lines no_num 判定 + renumber_line lead_def 判定）。IR 行纯 ASCII
// → 字节索引 == 码点索引，改字节探测（O(1) str_byte）+ str_sub_bytes 单次
// memcpy（O(n)），消除 O(n²)。
func str_trim_left(s: string) -> string {
    var n = len(s)
    var i: i64 = 0
    while i < n {
        var b = str_byte(s, i)
        if b == 32 || b == 9 {   // 空格 / 制表符
            i = i + 1
        } else {
            break
        }
    }
    if i >= n {
        return ""
    }
    return str_sub_bytes(s, i, n)
}

// 前缀判定：s 是否以 pre 开头（str_char 逐字符比较，不依赖 std/string）
func str_prefix(s: string, pre: string) -> bool {
    var n = str_len(s)
    var m = str_len(pre)
    if n < m {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_char(s, i) != str_char(pre, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 行级重编号：把函数体的 %N 值编号重映射为 1..N 连续（对齐 Rust renumber_ir）。
// 背景：alloca 提升到 entry 后，其值 id 可能大于后续块指令的值 id（alloca 在
// 循环体中创建，值 id 分配晚于 entry 早期指令），LLVM 解析要求块内指令编号
// 严格递增——倒挂行报 "instruction expected to be numbered '%N' or greater"。
// 按行扫描：无编号行（标签/注释/空行/define 等）原样保留；有编号行
// `%N = ...` 首现分配新号，行内其余 %N 引用复用映射。str_cat 的 %scN / printf
// 的 %extN 为独立命名空间（非纯数字），不受影响。
func renumber_lines() {
    var out = table_new_string()
    // 每函数独立重编号：映射表清空，新编号从形参个数 g_pcnt 起（形参值 id 占
    // 0..N-1，定义行保留原样 %0..%N-1，指令新编号从 %N 起避免撞号）。
    g_ren_map = table_new_i64()
    g_ren_next = g_pcnt
    var n = len(g_fn_lines)
    var i: i64 = 0
    while i < n {
        var ln = g_fn_lines[i]
        var t = str_trim_left(ln)
        // 元行（无 %N 操作数，整行跳过）：define 首行、块标签 bbN:、注释、空行。
        // br/store/ret/call void 等指令行仍有 %N 操作数 → 走 renumber_line
        // （引用复用映射；行首无 %N 定义则不产生新编号——对齐 Rust 实现）。
        // 性能：no_num 判定一次逐字节扫描（str_byte 轻量）替代 str_char + 4 次
        // str_prefix（每行 53 万行累积）；前缀互斥（; ( ) / d / b / u）一次判完。
        var no_num: bool = false
        var tn = str_len(t)
        if tn == 0 {
            no_num = true
        } else {
            var c0 = str_byte(t, 0)
            if c0 == 59 || c0 == 40 || c0 == 41 {  // ';' '(' ')'
                no_num = true
            } else if c0 == 100 {  // 'd' → "define"
                no_num = tn >= 6 && str_byte(t, 1) == 101 && str_byte(t, 2) == 102 &&
                    str_byte(t, 3) == 105 && str_byte(t, 4) == 110 && str_byte(t, 5) == 101
            } else if c0 == 98 {  // 'b' → "bb"（块标签）
                no_num = tn >= 2 && str_byte(t, 1) == 98
            } else if c0 == 117 {  // 'u' → "unreacha"（unreachable 指令）
                no_num = tn >= 8 && str_byte(t, 1) == 110 && str_byte(t, 2) == 114 &&
                    str_byte(t, 3) == 101 && str_byte(t, 4) == 97 && str_byte(t, 5) == 99 &&
                    str_byte(t, 6) == 104 && str_byte(t, 7) == 97
            }
        }
        // 有编号行：`%N = ...` —— 首 %N 是定义（分配新号），其余 %N 引用复用。
        // 但需注意：定义行开头 `%N =` 的 %N 也要重映射（它不是立即数/非数字）。
        if no_num {
            table_push(out, ln)
        } else {
            // 传已 trim 行 t：renumber_line 内部不再二次 str_trim_left（消除
            // 每行双 trim 的重复扫描）。
            var rebuilt = renumber_line(ln, t)
            table_push(out, rebuilt)
        }
        i = i + 1
    }
    g_fn_lines = out
}

// 本地 i64 → StringBuilder（性能重构）：按位数分支直接输出 ASCII 字节。
// 替代 to_string——to_string 是 irgen 内联的整段除法循环 IR（每次 ~40 条
// 指令 + 运行时分配），renumber_line 每 %N 一次，53 万行 × 每行 1-2 个 %N
// = 上百万次 IR 爆炸（emit 阶段 ren 7.3s 的根源）。值编号恒 ≥0 小整数。
func sb_append_i64(sb: i64, v: i64) {
    if v < 10 {
        sb_append_byte(sb, 48 + v)
    } else if v < 100 {
        sb_append_byte(sb, 48 + v / 10)
        sb_append_byte(sb, 48 + v % 10)
    } else if v < 1000 {
        sb_append_byte(sb, 48 + v / 100)
        sb_append_byte(sb, 48 + (v / 10) % 10)
        sb_append_byte(sb, 48 + v % 10)
    } else if v < 10000 {
        sb_append_byte(sb, 48 + v / 1000)
        sb_append_byte(sb, 48 + (v / 100) % 10)
        sb_append_byte(sb, 48 + (v / 10) % 10)
        sb_append_byte(sb, 48 + v % 10)
    } else {
        // 通用回退（值 ≥10000，极少触发）：逆序收集再正序输出
        var digits = table_new_i64()
        var x = v
        while x > 0 {
            table_push(digits, 48 + x % 10)
            x = x / 10
        }
        var k = len(digits) - 1
        while k >= 0 {
            sb_append_byte(sb, digits[k])
            k = k - 1
        }
    }
}

// 单行重编号：行内每个 `%N`（N 为纯数字）重映射；`%scN`/`%extN` 非纯数字不动。
// 定义/引用区分（关键）：行首 `%N = ...` 的 %N 是**指令定义**（总是分配新号，
// 即使 N < g_pcnt——函数体值 id 每函数从 0 起，alloca %0 可能与形参位置 %0
// 撞号）；行内其余 %N 引用按 ren_ref：N < g_pcnt 是形参位置引用（原样保留，
// define 形参列表 %0..%N-1 不变），否则复用指令映射。
// 参数 t：已 str_trim_left 的行（renumber_lines 已 trim，传参避免二次扫描）。
func renumber_line(ln: string, t: string) -> string {
    // 性能重构（段拷贝）：探测仍逐字节 str_byte（O(1) 轻量），但非 % 的普通
    // 字节连续段用 str_sub_bytes 一次整拷入 sb（O(段长) 单次 memcpy）。sb 调用
    // 次数 = 行内 %N 数 + 1，而非字节数——消除逐字节 sb_append_byte 的增长检查
    // 与写回开销（emit ren 7.5s 主因）。值编号用小整数分支转写（免 to_string
    // 内联 IR 爆炸）。定义/引用区分优先按「行首 %N =」模式判定。
    var n = len(ln)
    var tn = len(t)
    // 检测行首定义：trim 后以 % 开头且首 %N 后跟 " ="
    var lead_def: bool = false
    var lead_end: i64 = -1  // 定义 %N 在原始 ln 中的结束下标（字节）
    if tn > 0 && str_byte(t, 0) == 37 {
        var dj: i64 = 1
        var dcnt: i64 = 0
        while dj < tn {
            var dc = str_byte(t, dj)
            if dc >= 48 && dc <= 57 {
                dcnt = dcnt + 1
                dj = dj + 1
            } else {
                break
            }
        }
        if dcnt > 0 && dj < tn && str_byte(t, dj) == 32 {
            var ek = dj + 1
            while ek < tn && str_byte(t, ek) == 32 {
                ek = ek + 1
            }
            if ek < tn && str_byte(t, ek) == 61 {
                lead_def = true
                lead_end = (len(ln) - tn) + dj
            }
        }
    }
    var sb = string_builder()
    var i: i64 = 0
    var seg: i64 = 0  // 当前未拷贝字节段起点
    while i < n {
        var b = str_byte(ln, i)
        if b == 37 && i + 1 < n {
            // 尝试读纯数字后缀（值累算）
            var j = i + 1
            var val: i64 = 0
            var nd: i64 = 0
            while j < n {
                var d = str_byte(ln, j)
                if d >= 48 && d <= 57 {
                    val = val * 10 + (d - 48)
                    nd = nd + 1
                    j = j + 1
                } else {
                    break
                }
            }
            if nd > 0 {
                // 先整拷 [seg, i) 前缀普通字节段
                if i > seg {
                    sb_append(sb, str_sub_bytes(ln, seg, i))
                }
                var new_v: i64 = -1
                // 定义位置：%N 后紧跟空格+等号才可能是定义；lead_end == j 时
                // 恰是行首定义 %N（首字符 %，无前导空白）
                if lead_def && i == 0 && j == lead_end {
                    new_v = ren_def(val)
                } else {
                    new_v = ren_ref(val)
                }
                sb_append_byte(sb, 37)   // '%'
                sb_append_i64(sb, new_v)
                i = j
                seg = j
                continue
            }
        }
        i = i + 1
    }
    // 尾段 [seg, n)
    if n > seg {
        sb_append(sb, str_sub_bytes(ln, seg, n))
    }
    return sb_build(sb)
}

// 指令定义重映射：总是分配新号（查表复用）。
// 性能重写：old 是值 id（稠密小整数）→ 直索引表（g_ren_map[old] = new，
// -1 = 未设）；旧线性查表每函数 O(n²)（每行多个 %N 引用都全扫映射表）。
func ren_def(old: i64) -> i64 {
    while len(g_ren_map) <= old {
        table_push(g_ren_map, -1)
    }
    if g_ren_map[old] >= 0 {
        return g_ren_map[old]
    }
    var v = g_ren_next
    g_ren_map[old] = v
    g_ren_next = g_ren_next + 1
    return v
}

// 引用重映射：形参位置（old < g_pcnt）原样保留；否则复用/分配指令映射。
func ren_ref(old: i64) -> i64 {
    if old < g_pcnt {
        return old
    }
    return ren_def(old)
}

// 行表 → 完整 .ll 文本：分治两两合并。
// 每层合并拷贝总量 ≈ 最终大小，共 log₂N 层（总拷贝 O(total·log N)），
// 且每行只参与 log N 次拼接——相比逐行追加的 O(N²) 全量拷贝是数量级差异。
// 行语义与旧 line() 一致：每行自带尾随 "\n"（N 行 = N 个换行）。
func join_lines() -> string {
    var cur = out_lines
    var n = len(cur)
    if n == 0 {
        return ""
    }
    while n > 1 {
        var nxt = table_new_string()
        var i: i64 = 0
        while i + 1 < n {
            table_push(nxt, cur[i] + "\n" + cur[i + 1])
            i = i + 2
        }
        if i < n {
            table_push(nxt, cur[i])
        }
        cur = nxt
        n = len(cur)
    }
    return cur[0] + "\n"
}

// ==================== 指令映射 ====================
// 本分区已拆分为 compiler/backend/llvmgen_inst.tie（同 llvmgen_str.tie 的
// 「同 namespace 跨文件 + 文本内联」范式）：单指令 → LLVM 文本生成（核心
// 调度器 gen_inst）及全部辅助函数（param_pos/param_ref/opnd_ref/global_ref/
// build_vdef_cache/value_def/arg_ref/is_table_bridge/typed_ref/str_ptr_ref/
// to_ptr/gen_call_i64/gen_call_ptr/reg_add/reg_gep/gen_ext_str_scan/
// ptr_arg_ref）均保留于该子文件，经上方 import 并入本编译单元。

// ==================== 模块生成 ====================
// 生成完整 .ll 文本
pub func emit() -> string {
    collect_strings()
    collect_externs()
    out_lines = table_new_string()
    g_sext_cnt = 0
    g_str_reg_cnt = 0
    // 模块头
    line("; ModuleID = 'tie'")
    line("source_filename = \"input.tie\"")
    line("")
    // 无条件 declare
    line("declare i32 @printf(ptr, ...)")
    line("")
    line("declare i64 @strlen(ptr)")
    line("declare i32 @strcmp(ptr, ptr)")
    line("declare ptr @malloc(i64)")
    line("declare void @free(ptr)")
    line("declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)")
    line("declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)")
    // 批次 7：libc memmove（map 有序数组插入平移；重叠安全，clang 链接 CRT 提供）
    line("declare void @memmove(ptr, ptr, i64)")
    line("")
    line("declare ptr @fopen(ptr, ptr)")
    line("declare i64 @fwrite(ptr, i64, i64, ptr)")
    line("declare i32 @fclose(ptr)")
    line("declare i32 @fflush(ptr)")
    line("declare void @exit(i32)")
    line("declare i32 @remove(ptr)")
    // 批次 7：可捕获 panic（catch_panic）——对齐 clang 对 MSVC setjmp 的生成：
    // `_setjmp(env, frameaddr)` 带 returns_twice（LLVM 据其做栈帧/寄存器保存）；
    // `longjmp(env, val)` noreturn；frameaddr 传当前帧地址（longjmp 回跳锚点）。
    line("declare i32 @_setjmp(ptr, ptr) returns_twice")
    line("declare void @longjmp(ptr, i32) noreturn")
    line("declare ptr @llvm.frameaddress.p0(i32 immarg)")
    line("declare double @sqrt(double)")
    line("declare double @sin(double)")
    line("declare double @cos(double)")
    line("declare double @tan(double)")
    line("declare double @exp(double)")
    line("declare double @log(double)")
    line("declare double @pow(double, double)")
    line("declare double @floor(double)")
    line("declare double @ceil(double)")
    line("declare double @round(double)")
    line("")
    // T4.5：tie 运行时桥 declare（extern_call 收集，按符号名输出）
    emit_extern_decls()
    // 聚合类型段（struct type 定义；元组内联）
    emit_agg_types()
    // 阶段 A：全局变量段（表 → ptr null；标量 → 零值）
    emit_globals()
    // S2.4：vtable 全局常量段（方法函数指针表，每个 impl 一个）
    emit_vtables()
    // 各函数
    var nf = ir.func_count()
    var i: i64 = 0
    unsafe {
        var et0 = GetTickCount()
    }
    while i < nf {
        gen_func(i)
        i = i + 1
    }
    unsafe {
        var et1 = GetTickCount()
    }
    e_t_funcs = et1 - et0
    // 字符串常量节
    line("")
    emit_strings()
    // SSO 短串池全局段 + @tie_sso_alloc helper：**必须在函数遍历之后**输出——
    // op56（str_cat）在 gen_func 时才调 sso_enable()，提前输出会漏 helper。
    emit_sso_globals()
    unsafe {
        var et2 = GetTickCount()
    }
    var joined = join_lines()
    unsafe {
        var et3 = GetTickCount()
    }
    e_t_join = et3 - et2
    // emit 子阶段计时报告（TIEC_TIME=1）
    var etmv = get_env("TIEC_TIME")
    if etmv == "1" {
        println("[emit] funcs=" + to_string(e_t_funcs) + "ms ren=" + to_string(g_t_ren) + "ms join=" + to_string(e_t_join) + "ms")
    }
    return joined
}

func build_inst_blk() {
    g_inst_blk = table_new_i64()
    var nb = ir.block_count()
    var bi: i64 = 0
    while bi < nb {
        var st = ir.block_start(bi)
        var en = ir.block_end(bi)
        var k: i64 = st
        while k < en {
            while len(g_inst_blk) <= k {
                table_push(g_inst_blk, -1)
            }
            g_inst_blk[k] = bi
            k = k + 1
        }
        bi = bi + 1
    }
    build_fn_inst_ranges()
    g_inst_blk_ready = 1
}

// 构建每函数指令区间（O(B) 一次）：遍历块表取每函数 min start / max end。
// 用 min/max 而非「首块 start / 末块 end」，稳健不假设块创建序与函数序一致；
// 区间 [lo, hi) 覆盖函数全部指令（含 alloca 与内联展开指令——它们都按
// new_inst 顺序落在本函数段内）。
func build_fn_inst_ranges() {
    var nf = ir.func_count()
    var big = ir.inst_count()
    g_fn_inst_lo = table_new_i64()
    g_fn_inst_hi = table_new_i64()
    var i: i64 = 0
    while i < nf {
        table_push(g_fn_inst_lo, big)
        table_push(g_fn_inst_hi, 0)
        i = i + 1
    }
    var nb = ir.block_count()
    var bi: i64 = 0
    while bi < nb {
        var fid = ir.block_func(bi)
        var st = ir.block_start(bi)
        var en = ir.block_end(bi)
        if st < g_fn_inst_lo[fid] {
            g_fn_inst_lo[fid] = st
        }
        if en > g_fn_inst_hi[fid] {
            g_fn_inst_hi[fid] = en
        }
        bi = bi + 1
    }
}

// 单个函数生成
func gen_func(fid: i64) {
    g_pfid = fid
    g_pcnt = ir.func_params_cnt(fid)
    var name = intern.lookup(ir.func_name(fid))
    // 命名空间函数全名 → LLVM 符号：`::` 转 `$`（对齐 Rust ns_symbol；
    // 调用点 call(35) 同约定，保证定义与调用两侧符号一致）
    var sym = str.clone(name)
    var ns_pos = find_sub(name, "::")
    if ns_pos >= 0 {
        sym = ns_replace(name)
    }
    var ret_llvm = llvm_ty(ir.func_ret(fid))
    // main 特殊：void main → define i32 @main
    if sym == "main" && ret_llvm == "void" {
        ret_llvm = "i32"
    }
    // 形参列表：`i64 %0, ptr %1, ...`（参数值 id 是全局编号，形参按位置
    // %0..%n-1 命名；opnd_ref 经 param_ref 把参数值 id 映射到位置号）
    var params_llvm = ""
    var pk: i64 = 0
    while pk < g_pcnt {
        if pk > 0 {
            params_llvm = params_llvm + ", "
        }
        params_llvm = params_llvm + llvm_ty(ir.func_param_ty(fid, pk)) + " %" + to_string(pk)
        pk = pk + 1
    }
    line("define " + ret_llvm + " @" + sym + "(" + params_llvm + ") {")
    // F1 增强：临时 alloca 提升到 entry block——本函数全部 alloca（含循环体内
    // 的 ok 槽）前置输出，再对函数体行级重编号解决编号倒挂。流程：
    // 1) 切函数级缓冲 g_fn_lines（line() 重定向）；
    // 2) 收集本函数 alloca 指令 id；
    // 3) 遍历输出：entry block 标签后统一输出全部 alloca（收集序），
    //    gen_inst 对已登记 alloca 跳过（op==20 分支）；
    // 4) renumber_lines() 行级重编号 %N → 1..N 连续；
    // 5) 并入全局 out_lines，恢复全局缓冲。
    g_fn_lines = table_new_string()
    g_fn_mode = 1
    g_hoisted_cnt = 0
    if g_inst_blk_ready == 0 {
        build_inst_blk()
    }
    // 性能：只遍历本函数指令区间 [lo, hi)（build_fn_inst_ranges 一次构建），
    // 替代全表扫描 O(F×N)（此前每函数都扫全部指令表）。保留 block_func 过滤
    // 防区间交叉（按连续假设区间精确，过滤仅兜底，不影响 O(N)）。
    var lo = g_fn_inst_lo[fid]
    var hi = g_fn_inst_hi[fid]
    var ia: i64 = lo
    while ia < hi {
        var blk_a: i64 = -1
        if ia < len(g_inst_blk) {
            blk_a = g_inst_blk[ia]
        }
        if blk_a >= 0 && ir.block_func(blk_a) == fid && ir.ins_op(ia) == 20 {
            table_push(g_hoisted_allocas, ia)
            g_hoisted_cnt = g_hoisted_cnt + 1
        }
        ia = ia + 1
    }
    // 按指令 id 序遍历本函数全部块（块首输出标签）——保证值编号单调递增。
    // entry block（首块）标签后统一输出收集的 alloca——LLVM 要求 alloca 在
    // entry block 内静态分配（循环内 alloca → 动态栈分配，栈溢出）。
    var eblk = ir.func_entry(fid)
    var entry_alloca_done: i64 = 0
    var ii: i64 = lo
    while ii < hi {
        var blk: i64 = -1
        if ii < len(g_inst_blk) {
            blk = g_inst_blk[ii]
        }
        if blk >= 0 && ir.block_func(blk) == fid {
            if ii == ir.block_start(blk) {
                // 块标签：统一用块 id（bb<N>），避免 block_name 多 if/for 冲突
                line("bb" + to_string(blk) + ":")
                // F1 增强：entry block 标签后统一输出全部收集的 alloca——
                // 编号按收集序（值 id 全局递增）严格递增，无回退；后续
                // gen_inst 对已登记 alloca 跳过（op==20 分支）。
                if blk == eblk && entry_alloca_done == 0 {
                    var eh: i64 = 0
                    while eh < g_hoisted_cnt {
                        var ainst = g_hoisted_allocas[eh]
                        var ty_a = llvm_ty(ir.ins_ty(ainst))
                        var v_a = ir.ins_val(ainst)
                        if v_a >= 0 {
                            line("%" + to_string(v_a) + " = alloca " + ty_a)
                        }
                        eh = eh + 1
                    }
                    entry_alloca_done = 1
                }
            }
            gen_inst(ii)
        }
        ii = ii + 1
    }
    line("}")
    line("")
    // 函数级缓冲收尾：行级重编号（%N → 连续新编号，解决 alloca 提升后的
    // 编号倒挂）后并入全局 out_lines，恢复全局 line() 目标。
    // 子计时（累加至全局，emit 报告）：
    var gft0: i64 = 0
    unsafe {
        gft0 = GetTickCount()
    }
    renumber_lines()
    unsafe {
        var gft1 = GetTickCount()
    }
    g_t_ren = g_t_ren + (gft1 - gft0)
    var rn: i64 = 0
    while rn < len(g_fn_lines) {
        table_push(out_lines, g_fn_lines[rn])
        rn = rn + 1
    }
    g_fn_mode = 0
}

}


