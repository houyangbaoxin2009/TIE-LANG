    }
    if sym == "tie_mkdir_all" {
        return "declare i8 @tie_mkdir_all(ptr)"
    }
    if sym == "tie_file_copy" {
        return "declare i8 @tie_file_copy(ptr, ptr)"
    }
    if sym == "tie_file_move" {
        return "declare i8 @tie_file_move(ptr, ptr)"
    }
    if sym == "tie_http_get_file" {
        return "declare i8 @tie_http_get_file(ptr, ptr)"
    }
    if sym == "tie_untar_gz" {
