type tie<class>
// compiler/backend/irgen_expr.tie —— 生成器 L3 表达式层 子模块
// ============================================================
// 从 irgen.tie 拆分而来：这是 irgen LLVM 风格分层重构的 S4（第四步）。
// 本文件承载 L3 表达式层：表达式主调度器 gen_expr、内置原语名判定
// is_builtin_name、巨型内置表达式生成器 builtin_expr（各 tag 表达式分发 /
// 内置调用 → tie_* 桥 / libc / 内联生成）。它们被上层语句/表达式生成层
// 裸名调用，是表达式求值的核心。L6 调用分派层（gen_runtime_call 等）
// 不属于本轮，留在 irgen.tie 主文件。
//
// 拆分范式：【同 namespace 跨文件】（文本内联）。
// 同 irgen_arith.tie（S3）/ irgen_builder.tie（S1）/ irgen_lit.tie（S2）。
// irgen.tie 顶层 import 本文件后，本文件被文本内联进同一编译单元，声明与
// irgen.tie 相同的 `namespace irgen`，同名 namespace 跨文件闭合并集：
//   - 同 namespace 函数可互相裸名调用（主文件照常裸名调用 gen_expr 等）；
//   - 可访问主文件顶层全局 var（g_cur_block/g_cur_func/node_types/s_tags 等）；
//   - 本文件只含函数与注释，不含顶层全局 var 声明、不含 import——
//     全局 var 与 import 树均留在 irgen.tie 主文件，避免重复定义。
namespace irgen {
// 表达式生成：返回结果值 id；-1 错误
func gen_expr(id: i64) -> i64 {
    var tag = s_tags[id]
    if tag == 0 {
        // IntLit：按推断类型生成常量（后缀字面量 i128/u128/窄整数 → 对应
        // 类型；默认 i64）。曾固定 gen_int_lit(i64)——`1i128 << 64` 左操作数
        // 落 i64，移位生成 trunc i128 %i64 类型错（批次 2 修复）。
        var lt = node_types[id]
        if lt >= 0 && lt != types.named(TK_I64) && types.is_int(lt) {
            return gen_int_lit_ty(s_vals[id], lt)
        }
        return gen_int_lit(s_vals[id])
    }
    if tag == 1 {
        // FloatLit：f64 常量（lexeme 文本存池，llvmgen 规范化输出）
        return gen_float_lit(s_names[id])
    }
    if tag == 2 {
        // StrLit
        return gen_str_lit(s_names[id])
    }
    if tag == 3 {
        // CharLit：'a' / 转义 → i32 码点常量（对齐 Rust CharLit → i32）
        return gen_char_lit(s_names[id])
    }
    if tag == 5 {
        // TritLit：zero → i8 0（true/false 走 BoolLit + trit 上下文改写）
        return gen_trit_lit(s_vals[id])
    }
    if tag == 6 {
        // Var
        var vnid6 = interner.intern(sstate.name_str(id))
        if scope_get_global(vnid6) >= 0 {
            return gen_var_ref(vnid6)
        }
        // S2.2 命名函数提升：变量未入作用域但语义类型是 fn 类型 → 命名函数名
        // 用作函数值（生成适配器 + 构造 {null, @adapt}）。节点类型由 sinfer
        // S_N_VAR 分支登记（fn_sig 命中 → fn 类型）。
        if node_types[id] >= 0 && types.is_fn(node_types[id]) {
            var full_nm = resolve_call_name(sstate.name_str(id))
            return gen_named_fn_value(id, full_nm, node_types[id])
        }
        return gen_var_ref(vnid6)
    }
    if tag == 9 {
        // Binary
        return gen_binary(s_vals[id], sstate.child(id, 0), sstate.child(id, 1))
    }
    if tag == 10 {
        // Ternary：cond ? then : else → cond_br + phi（对齐 Rust 三块短路结构）
        return gen_ternary(id)
    }
    if tag == 11 {
        // Range：for 迭代起点/终点
        return gen_expr(sstate.child(id, 0))
    }
    if tag == 7 {
        // Call：println/print / tie 运行时桥内置 / 字符串表数学内置 / 用户函数
        var nm = sstate.name_str(id)
        if nm == "" {
        }
        if nm == "println" || nm == "print" {
            return gen_println(id, nm == "println")
        }
        // S2.2 函数值调用：调用名是 fn 类型变量（闭包字面量/函数值参数/全局 fn）
        // → 间接调用 entry(env, args...)。语义层已校验（sinfer 函数值调用分支），
        // 此处先于 struct/enum/内置/用户函数解析——fn 变量名不可能与类型/函数重名。
        var fv_nid = interner.intern(nm)
        if scope_get_global(fv_nid) >= 0 && types.is_fn(g_lookup_ty) {
            return gen_call_indirect(id, nm)
        }
        // struct 构造调用：StructName(args...) → 聚合值（优先级高于内置/用户
        // 函数解析——构造名不可能与函数/内置重名，语义层已校验）
        if is_struct_name(nm) {
            return gen_struct_construct(id, nm)
        }
        // 枚举构造调用（防御路径：旧式点号名 `EnumName.Variant(...)` 若 parser
        // 产出 Call 则在此处理；现行 parser 对枚举构造产 FieldAccess/MethodCall，
        // 见 tag 15/tag 18 分支。nm 为点号全名时只取枚举段匹配。）
        if is_enum_name(nm) {
            return gen_enum_construct(sstate.bs_find(en_keys, interner.intern(nm)), "", id, sstate.slot_off(id))
        }
        // 内置（语言底座原语 → tie_* 桥或 libc）：非用户函数。
        // 名字命中内置集后失败必须传播（-1 保留原 sm_err_msg），绝不降级为
        // 用户调用——否则内置参数内的未支持表达式会连锁成"函数 X 无签名"
        // 误导错误（历史根因：table_push(j_fvals, 0.0) 曾报 table_push 无签名）
        if is_builtin_name(nm) {
            var br = builtin_expr(nm, id)
            if br >= 0 {
                return g_builtin_res
            }
            if str_len(sm_err_msg) == 0 {
                sm_err_msg = "内置调用 '" + nm + "' 生成失败（函数 " + g_cur_fn_name + "）"
            }
            return -1
        }
        // 用户函数：裸调用名解析（当前命名空间补全）
        var full = resolve_call_name(nm)
        // Call children = [泛型槽, 实参...] → 实参从 children[slot_off] 起
        var aoff = sstate.slot_off(id)
        // 兼容旧式点号名（历史 parser 曾对 `myns.add(...)` 生成 children=[接收者,
        // 实参...]；新 parser 不再产出，防御保留 +1 语义）
        if ig_find_char(nm, ".") >= 0 {
            aoff = aoff + 1
        }
        return gen_user_call_from(full, id, aoff)
    }
    if tag == 4 {
        // BoolLit → i1 常量（trit 上下文 → i8：true=1 / false=-1，对齐 Rust）
        if node_types[id] == types.named(TK_TRIT) {
            var tv: i64 = -1
            if s_vals[id] == 1 {
                tv = 1
            }
            return gen_trit_lit(tv)
        }
        return gen_bool_lit(s_vals[id])
    }
    if tag == 8 {
        // Unary：0=Neg 1=Not（driver 树无 ++/--）
        var op = s_vals[id]
        var operand = sstate.child(id, 0)
        var ov = gen_expr(operand)
        if ov < 0 {
            return -1
        }
        var oty = node_types[operand]
        if op == 2 || op == 3 || op == 4 || op == 5 {
            // 自增/自减（M4）：2=++i 3=--i 4=i++ 5=i--；操作数必须是变量
            // （语义层保证），直接读写其槽：load → add/sub 1 → store；
            // 前缀返回新值，后缀返回旧值（对齐 Rust gen_inc_dec）
            return gen_inc_dec(op, operand)
        }
        if op == 0 {
            // Neg：整数 → sub 0, x；浮点 → fsub 0.0, x（对齐 Rust fneg 语义）。
            // 立即数 0 在浮点上下文必须为 0.0（LLVM：fsub double 0, %x 非法）
            if oty == types.named(TK_F64) || oty == types.named(TK_F32) {
                var zf = gen_float_lit(interner.intern("0.0"))
                var fneg = ir.new_inst(g_cur_block, 14, types.named(TK_F64))  // fsub
                ir.add_operand(fneg, zf, 0)
                ir.add_operand(fneg, ov, 0)
                return ir.get_value(fneg)
            }
            // S1.3 A1 窄整数取负：按操作数宽度生成 sub（i8 取负 → sub i8 0, x）
            var nty = types.named(TK_I64)
            if types.is_int(oty) {
                nty = oty
            }
            var inst = ir.new_inst(g_cur_block, 1, nty)  // sub
            ir.add_operand(inst, 0, 2)
            ir.add_operand(inst, ov, 0)
            return ir.get_value(inst)
        }
        if op == 1 {
            // Not：bool → xor i1 true；trit → sub i8 0, x（取反，-1↔1，0 保持）
            if oty == types.named(TK_TRIT) {
                var tnot = ir.new_inst(g_cur_block, 1, types.named(TK_I8))  // sub i8
                ir.add_operand(tnot, 0, 2)
                ir.add_operand(tnot, ov, 0)
                return ir.get_value(tnot)
            }
            var inst = ir.new_inst(g_cur_block, 8, types.named(TK_BOOL))  // xor
            ir.add_operand(inst, ov, 0)
            ir.add_operand(inst, 1, 2)
            return ir.get_value(inst)
        }
        return -1
    }
    if tag == 18 {
        // MethodCall：命名空间函数调用（receiver 路径 + 方法名）
        return gen_method_call(id)
    }
    if tag == 13 {
        // Index：t[i] 表下标读（动态表 → tie_table_at 桥）
        return gen_index_read(id)
    }
    if tag == 14 {
        // TupleLit：元组字面量 (a, b) → 聚合值（alloca + 逐字段 store + load）
        return gen_tuple_lit(id)
    }
    if tag == 15 {
        // FieldAccess：.q / .Item1 / .0 字段访问（元组/struct）→ 地址 + GEP + load。
        // 枚举变体常量探测（EnumName.Variant 无 payload）：base 是未绑定变量且
        // 命中 en_keys → 枚举构造（仿 sinfer FieldAccess 分支，必须先于
        // gen_field_access——否则枚举名被当变量查作用域报错）
        var base_node15 = sstate.child(id, 0)
        if s_tags[base_node15] == 6 {  // Var
            var bnm15 = sstate.name_str(base_node15)
            var eidx15 = sstate.bs_find(en_keys, interner.intern(bnm15))
            if eidx15 >= 0 {
                return gen_enum_construct(eidx15, sstate.name_str(id), id, -1)
            }
        }
        return gen_field_access(id)
    }
    if tag == 12 {
        // TableLit：动态表创建（仅 var 初始化/实参场景；直接求值 → 建表）
        return gen_table_lit(id)
    }
    if tag == 131 {
        // S1.2 I1 asm!：生成 inline_asm 指令（模板池 id + 操作数方向/值对）。
        // 第一个 out 操作数 → 结果类型（call 返回值）；其余 out 第一版忽略。
        // 任务17：平台条件编译——target("arch") 标注按当前编译目标分支：
        //   无 target 标注 → 始终发射（向后兼容）；
        //   有 target 标注 → 当前目标匹配任一 → 发射；全不匹配 → 明确报错。
        var nc = sstate.nchild(id)
        // ---------- 平台条件编译判定（任务17）----------
        var has_target: bool = false
        var matched: bool = false
        var listed = ""
        var kt: i64 = 0
        while kt < nc {
            var opx = sstate.child(id, kt)
            if s_vals[opx] == 3 {
                has_target = true
                // 平台名（带引号 lexeme 池 id）→ 去引号纯文本
                var arch = interner.lookup(str_unescape_quoted(s_names[opx]))
                if str_len(listed) > 0 {
                    listed = listed + "/"
                }
                listed = listed + arch
                if asm_target_matches(arch) {
                    matched = true
                }
            }
            kt = kt + 1
        }
        if has_target && !matched {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            var cur_t = g_asm_target
            if str_len(cur_t) == 0 {
                cur_t = "（未设置）"
            }
            sm_err_msg = "asm! 平台 target(" + listed + ") 与当前编译目标 " + cur_t + " 不匹配（无目标平台分支可编译）"
            return -1
        }
        var tmpl = s_names[id]
        var out_slot: i64 = -1
        var out_ty: i64 = -1
        var k: i64 = 0
        while k < nc {
            var op0 = sstate.child(id, k)
            if s_vals[op0] == 1 {  // out
                var e0 = sstate.child(op0, 0)
                if s_tags[e0] == 6 {  // Var
                    var nid0 = interner.intern(sstate.name_str(e0))
                    if scope_get_global(nid0) >= 0 {
                        out_slot = g_lookup_alloca
                        out_ty = g_lookup_ty
                    }
                }
                break
            }
            k = k + 1
        }
        var inst = ir.new_inst(g_cur_block, 65, out_ty)  // void（-1）或 out 类型
        ir.add_operand(inst, tmpl, 0)
        k = 0
        while k < nc {
            var op = sstate.child(id, k)
            var dir = s_vals[op]
            if dir == 3 {
                // target("arch") 平台标注（任务17）：不占 asm 操作数，跳过
                k = k + 1
                continue
            }
            var e = sstate.child(op, 0)
            if dir != 1 {
                // in/inout：求值入参（类型 IMM + 值）
                var ev = gen_expr(e)
                if ev < 0 {
                    return -1
                }
                var et2 = node_types[e]
                if et2 < 0 {
                    et2 = types.named(TK_I64)
                }
                ir.add_operand(inst, dir, 2)
                ir.add_operand(inst, et2, 2)
                ir.add_operand(inst, ev, 0)
            } else {
                // out：不占参数（call 返回值承载）；第一版只支持第一个 out
                ir.add_operand(inst, dir, 2)
                ir.add_operand(inst, types.named(TK_I64), 2)
                ir.add_operand(inst, 0, 2)
            }
            k = k + 1
        }
        if out_slot >= 0 {
            // 结果写回 out 变量槽
            var st = ir.new_inst(g_cur_block, 22, -1)
            ir.add_operand(st, out_ty, 2)
            ir.add_operand(st, ir.get_value(inst), 0)
            ir.add_operand(st, out_slot, 0)
        }
        return gen_int_lit(0)  // 哑值（asm 表达式无值）
    }
    if tag == 132 {
        // S2.2 闭包字面量（N_FN_LIT）：生成入口函数 + 构造闭包值 {env, entry}
        return gen_closure_lit(id)
    }
    if tag == 133 {
        // S2.3：`expr ?` 解包（N_TRY）：Result/Option 枚举——Err/None 提前
        // return，Ok/Some 解包 payload。语义由 sinfer.infer_try_unwrap 校验。
        return gen_try(id)
    }
    // 其他表达式后续扩展
    sm_err_line = s_lines[id]
    sm_err_col = s_cols[id]
    sm_err_msg = "irgen 未支持的表达式（tag=" + to_string(tag) + "，函数 " + g_cur_fn_name + "）"
    return -1
}

// 内置原语名判定（builtin_expr 支持集；与 sbuitin 语义层原语表对齐）。
// 命中即内置——调用失败传播错误，不降级为用户函数路径。
func is_builtin_name(nm: string) -> bool {
    // ---------- S1.2 unsafe 指针/内存内置 ----------
    if nm == "addr_of" || nm == "addr_of_field" || nm == "deref" || nm == "deref_write" ||
        nm == "is_null" || nm == "ptr_add" || nm == "ptr_to_int" || nm == "int_to_ptr" ||
        nm == "alloc" || nm == "free" || nm == "memcpy" || nm == "memset" ||
        nm == "slice_of" || nm == "slice_len" || nm == "slice_index" ||
        nm == "volatile_load" || nm == "volatile_store" {
        return true
    }
    // ---------- S1.3 as_* 显式数值转换族 ----------
    if nm == "as_i8" || nm == "as_i16" || nm == "as_i32" || nm == "as_i64" ||
        nm == "as_u8" || nm == "as_u16" || nm == "as_u32" || nm == "as_u64" ||
        nm == "as_f32" || nm == "as_f64" ||
        nm == "as_i128" || nm == "as_u128" {
        return true
    }
    // ---------- S1.3 checked_* 溢出检测族 ----------
    if nm == "checked_add" || nm == "checked_sub" || nm == "checked_mul" ||
        nm == "checked_div" || nm == "checked_shl" || nm == "checked_shr" ||
        nm == "checked_neg" {
        return true
    }
    if nm == "exec_code" || nm == "time_now" || nm == "get_env" || nm == "exec_output" {
        return true
    }
    if nm == "str_len" || nm == "char_code" || nm == "str_char" || nm == "str_from_code" {
        return true
    }
    // ---------- S2.1 字符串 {ptr,len} 原语 ----------
    // 二进制安全字节访问（str_byte）、UTF-8 码点解码（utf8_seq_len/utf8_char_at）、
    // StringBuilder 句柄（string_builder/sb_append/sb_append_byte/sb_build）
    if nm == "str_byte" || nm == "utf8_seq_len" || nm == "utf8_char_at" ||
        nm == "string_builder" || nm == "sb_append" || nm == "sb_append_byte" ||
        nm == "sb_build" || nm == "sb_reset" || nm == "str_sub_bytes" ||
        nm == "sso_malloc_count" || nm == "catch_panic" || nm == "cb_ptr" {
        return true
    }
    // ---------- 网络原语（P0：std/net）----------
    if nm == "net_close" || nm == "net_tcp_accept" || nm == "net_tcp_connect" ||
        nm == "net_tcp_listen" || nm == "net_tcp_recv" || nm == "net_tcp_send" ||
        nm == "net_udp_bind" || nm == "net_udp_recv" || nm == "net_udp_send" {
        return true
    }
    if nm == "to_string" || nm == "parse_int" || nm == "parse_float" || nm == "parse_trit" {
        return true
    }
    if nm == "len" {
        return true
    }
    if nm == "table_new_i64" || nm == "table_new_f64" || nm == "table_new_string" || nm == "table_new_bool" {
        return true
    }
    if nm == "table_push" || nm == "table_at" || nm == "exit" {
        return true
    }
    if nm == "arg_count" || nm == "arg_string" {
        return true
    }
    if nm == "file_read" || nm == "file_write" || nm == "file_append" || nm == "file_exists" || nm == "file_delete" {
        return true
    }
    // 完整 fs 元数据（UTF-8 桥）：大小 / 类型判定
    if nm == "file_size" || nm == "file_is_dir" || nm == "file_is_file" {
        return true
    }
    if nm == "print_err" || nm == "mkdir_all" || nm == "remove_dir_all" || nm == "regex_find_all" {
        return true
    }
    if nm == "regex_match" || nm == "regex_find" || nm == "regex_replace" || nm == "regex_group" {
        return true
    }
    if nm == "sqrt" || nm == "sin" || nm == "cos" || nm == "tan" ||
        nm == "exp" || nm == "log" || nm == "floor" || nm == "ceil" || nm == "round" || nm == "pow" {
        return true
    }
    if nm == "read_line" || nm == "cwd" || nm == "list_dir" || nm == "walk_dir" ||
        nm == "byte_read" || nm == "byte_write" || nm == "byte_concat" {
        return true
    }
    if nm == "bit_read" || nm == "bit_write" {
        return true
    }
    if nm == "path_basename" || nm == "path_dirname" || nm == "path_abs" ||
        nm == "path_normalize" || nm == "path_join" {
        return true
    }
    if nm == "http_get" || nm == "http_get_file" || nm == "untar_gz" || nm == "unzip" ||
        nm == "copy_dir" || nm == "file_copy" || nm == "file_move" {
        return true
    }
    if nm == "eval" || nm == "eval_call" || nm == "set_env" {
        return true
    }
    if nm == "msg_set_lang" || nm == "msg_get_lang" || nm == "msg_register" ||
        nm == "msg_t" || nm == "msg_t_lang" {
        return true
    }
    if nm == "rand_range" {
        return true
    }
    return false
}

// 内置表达式调用分派：返回 0 已处理（g_builtin_res 携带结果值 id）；-1 失败
// （名字已由 is_builtin_name 判定命中——本函数内 -1 一律为真失败，调用方传播）。
func builtin_expr(nm: string, id: i64) -> i64 {
    // ---------- S1.2 unsafe 指针/内存内置 ----------
    // 全部要求 unsafe 上下文（语义层 infer 已拦截安全代码调用）。
    if nm == "addr_of" {
        // addr_of(x) → 变量槽地址（ptr<变量类型>）；非变量表达式 → 求值落
        // 内存后取地址（临时 alloca）
        var arg = call_arg(id, 0)
        var at = node_types[arg]
        if at < 0 {
            sm_err_msg = "addr_of() 实参类型未知（函数 " + g_cur_fn_name + "）"
            return -1
        }
        if s_tags[arg] == 6 {  // Var
            var nid = interner.intern(sstate.name_str(arg))
            if scope_get_global(nid) >= 0 {
                g_builtin_res = g_lookup_alloca
                return 0
            }
        }
        var v = gen_expr(arg)
        if v < 0 {
            return -1
        }
        var alloca = ir.new_inst(g_cur_block, 20, at)
        ir.add_operand(alloca, at, 2)
        var ap = ir.get_value(alloca)
        var st = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st, at, 2)
        ir.add_operand(st, v, 0)
        ir.add_operand(st, ap, 0)
        g_builtin_res = ap
        return 0
    }
    if nm == "addr_of_field" {
        // addr_of_field(obj, "field") → 聚合字段地址（agg_gep）。
        // obj 为变量（槽地址）或表达式（落内存）。字段名是字符串字面量。
        var obj = call_arg(id, 0)
        var fname_node = call_arg(id, 1)
        var agg_ty = node_types[obj]
        if agg_ty < 0 {
            sm_err_msg = "addr_of_field() 对象类型未知（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var fname = ""
        if s_tags[fname_node] == 2 {  // StrLit
            var raw = interner.lookup(s_names[fname_node])
            var rn = str_len(raw)
            if rn >= 2 && str_char(raw, 0) == "\"" && str_char(raw, rn - 1) == "\"" {
                fname = str_slice(raw, 1, rn - 1)
            }
        }
        if str_len(fname) == 0 {
            sm_err_msg = "addr_of_field() 字段名必须是字符串字面量（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var fidx = agg_field_index(agg_ty, fname)
        if fidx < 0 {
            sm_err_msg = "addr_of_field() 字段 '" + fname + "' 不存在（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var oaddr: i64 = -1
        if s_tags[obj] == 6 {
            var nid2 = interner.intern(sstate.name_str(obj))
            if scope_get_global(nid2) >= 0 {
                oaddr = g_lookup_alloca
            }
        }
        if oaddr < 0 {
            var ov = gen_expr(obj)
            if ov < 0 {
                return -1
            }
            var alloca2 = ir.new_inst(g_cur_block, 20, agg_ty)
            ir.add_operand(alloca2, agg_ty, 2)
            oaddr = ir.get_value(alloca2)
            var st2 = ir.new_inst(g_cur_block, 22, -1)
            ir.add_operand(st2, agg_ty, 2)
            ir.add_operand(st2, ov, 0)
            ir.add_operand(st2, oaddr, 0)
        }
        var gp = ir.new_inst(g_cur_block, 27, agg_ty)  // agg_gep
        ir.add_operand(gp, oaddr, 0)
        ir.add_operand(gp, fidx, 2)
        g_builtin_res = ir.get_value(gp)
        return 0
    }
    if nm == "deref" {
        // deref(p) → load 元素类型
        var p = gen_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        var pt = node_types[call_arg(id, 0)]
        var et = types.table_elem(pt)
        if et < 0 {
            sm_err_msg = "deref() 实参必须是指针类型（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var ld = ir.new_inst(g_cur_block, 21, et)  // load
        ir.add_operand(ld, p, 0)
        g_builtin_res = ir.get_value(ld)
        return 0
    }
    if nm == "deref_write" {
        // deref_write(p, v) → store 元素类型
        var p = gen_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        var pt = node_types[call_arg(id, 0)]
        var et = types.table_elem(pt)
        if et < 0 {
            sm_err_msg = "deref_write() 第 1 实参必须是指针类型（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var v = gen_expr(call_arg(id, 1))
        if v < 0 {
            return -1
        }
        var vt = node_types[call_arg(id, 1)]
        if vt >= 0 && vt != et && (types.is_int(vt) || types.is_float(vt)) {
            var cv = gen_coerce(v, vt, et)
            if cv < 0 {
                return -1
            }
            v = cv
        }
        var st = ir.new_inst(g_cur_block, 22, -1)  // store
        ir.add_operand(st, et, 2)
        ir.add_operand(st, v, 0)
        ir.add_operand(st, p, 0)
        g_builtin_res = gen_int_lit(0)
        return 0
    }
    if nm == "volatile_load" {
        // volatile_load(p) → load volatile 元素类型（任务15：MMIO/硬件寄存器读，
        // 发射 volatile 标志——LLVM 保证不被优化删除/合并/重排）。
        var p = gen_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        var pt = node_types[call_arg(id, 0)]
        var et = types.table_elem(pt)
        if et < 0 {
            sm_err_msg = "volatile_load() 实参必须是指针类型（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var vl = ir.new_inst(g_cur_block, 71, et)  // volatile_load（op 71）
        ir.add_operand(vl, p, 0)
        g_builtin_res = ir.get_value(vl)
        return 0
    }
    if nm == "volatile_store" {
        // volatile_store(p, v) → store volatile 元素类型（任务15：MMIO/硬件寄存器写，
        // volatile 标志禁止优化删除/重排/合并）。
        var p = gen_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        var pt = node_types[call_arg(id, 0)]
        var et = types.table_elem(pt)
        if et < 0 {
            sm_err_msg = "volatile_store() 第 1 实参必须是指针类型（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var v = gen_expr(call_arg(id, 1))
        if v < 0 {
            return -1
        }
        var vt = node_types[call_arg(id, 1)]
        if vt >= 0 && vt != et && (types.is_int(vt) || types.is_float(vt)) {
            var cv = gen_coerce(v, vt, et)
            if cv < 0 {
                return -1
            }
            v = cv
        }
        var vs = ir.new_inst(g_cur_block, 72, -1)  // volatile_store（op 72）
        ir.add_operand(vs, et, 2)  // 值类型 IMM
        ir.add_operand(vs, v, 0)   // 值
        ir.add_operand(vs, p, 0)   // 地址
        g_builtin_res = gen_int_lit(0)
        return 0
    }
    if nm == "is_null" {
        // is_null(p) → icmp eq p, null（llvmgen ptr 比较自动把 0 写 null；
        // 立即数 0 必须 IMM 操作数——值 0 会被当值 id 查定义）
        var p = gen_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        var ic = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
        ir.add_operand(ic, p, 0)
        ir.add_operand(ic, 0, 2)  // IMM 0（llvmgen ptr 上下文 → null）
        ir.add_operand(ic, 0, 2)  // eq
        g_builtin_res = ir.get_value(ic)
        return 0
    }
    if nm == "ptr_add" {
        // ptr_add(p, n) → p + n 元素步长（gep 单索引）
        var p = gen_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        var pt = node_types[call_arg(id, 0)]
        var et = types.table_elem(pt)
        if et < 0 {
            sm_err_msg = "ptr_add() 第 1 实参必须是指针类型（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var n = gen_expr(call_arg(id, 1))
        if n < 0 {
            return -1
        }
        var gp = ir.new_inst(g_cur_block, 23, et)  // gep（步长 = 元素大小）
        ir.add_operand(gp, p, 0)
        ir.add_operand(gp, n, 0)
        g_builtin_res = ir.get_value(gp)
        return 0
    }
    if nm == "ptr_to_int" {
        // ptr_to_int(p) → ptrtoint i64
        var p = gen_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        var pi = ir.new_inst(g_cur_block, 24, types.named(TK_I64))
        ir.add_operand(pi, p, 0)
        g_builtin_res = ir.get_value(pi)
        return 0
    }
    if nm == "int_to_ptr" {
        // int_to_ptr(i) → inttoptr ptr（字节指针 ptr<u8>）
        var i = gen_expr(call_arg(id, 0))
        if i < 0 {
            return -1
        }
        var ip = ir.new_inst(g_cur_block, 25, types.named(TK_STR))  // inttoptr → ptr
        ir.add_operand(ip, i, 0)
        g_builtin_res = ir.get_value(ip)
        return 0
    }
    if nm == "alloc" {
        // alloc(n) → malloc（返回 ptr，LLVM ptr 直传）
        g_used_interp = true
        var n = gen_expr(call_arg(id, 0))
        if n < 0 {
            return -1
        }
        g_builtin_res = gen_ext_call1("malloc", n, types.named(TK_I64), types.named(TK_STR))
        return 0
    }
    if nm == "free" {
        // free(p) → libc free
        var p = gen_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        g_used_interp = true
        gen_ext_call1("free", p, types.named(TK_STR), -1)
        g_builtin_res = gen_int_lit(0)
        return 0
    }
    if nm == "memcpy" {
        // memcpy(dst, src, n) → llvm.memcpy.p0.p0.i64（volatile=false, tail=false）
        var dst = gen_expr(call_arg(id, 0))
        if dst < 0 {
            return -1
        }
        var src = gen_expr(call_arg(id, 1))
        if src < 0 {
            return -1
        }
        var n = gen_expr(call_arg(id, 2))
        if n < 0 {
            return -1
        }
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.named(TK_STR))
        table_push(avs, dst)
        table_push(ats, types.named(TK_STR))
        table_push(avs, src)
        table_push(ats, types.named(TK_I64))
        table_push(avs, n)
        table_push(ats, types.named(TK_BOOL))
        table_push(avs, gen_int_lit_ty(1, types.named(TK_BOOL)))
        table_push(ats, types.named(TK_BOOL))
        table_push(avs, gen_int_lit_ty(0, types.named(TK_BOOL)))
        gen_ext_call_typed("llvm.memcpy.p0.p0.i64", ats, avs, -1)
        g_builtin_res = gen_int_lit(0)
        return 0
    }
    if nm == "memset" {
        // memset(p, val, n) → llvm.memset.p0.i64
        var p = gen_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        var val = gen_expr(call_arg(id, 1))
        if val < 0 {
            return -1
        }
        var n = gen_expr(call_arg(id, 2))
        if n < 0 {
            return -1
        }
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.named(TK_STR))
        table_push(avs, p)
        table_push(ats, types.named(TK_I8))
        table_push(avs, val)
        table_push(ats, types.named(TK_I64))
        table_push(avs, n)
        table_push(ats, types.named(TK_BOOL))
        table_push(avs, gen_int_lit_ty(1, types.named(TK_BOOL)))
        table_push(ats, types.named(TK_BOOL))
        table_push(avs, gen_int_lit_ty(0, types.named(TK_BOOL)))
        gen_ext_call_typed("llvm.memset.p0.i64", ats, avs, -1)
        g_builtin_res = gen_int_lit(0)
        return 0
    }
    if nm == "slice_of" {
        // slice_of(obj, start, len) → slice<元素类型> 聚合：指针 + 长度。
        // 字符串路径：数据指针直接 + len（第一版）。
        // 动态表路径（任务16）：表 → 连续内存切片——alloc 连续缓冲 + 逐元素
        // tie_table_at_* 拷贝（全 .tie，无新增 Rust 桥；运行时表数据区在桥内）。
        var arr = call_arg(id, 0)
        var at2 = node_types[arr]
        if types.is_table(at2) {
            // ---------- 动态表 → 连续内存切片（任务16）----------
            // 元素类型：table_elem（typed table<T>）→ var_table_elem（table_new_i64
            // 等语义登记，裸 table 无元素信息）→ i64 兜底。
            var etab: i64 = types.named(TK_I64)
            var te2 = types.table_elem(at2)
            if te2 >= 0 {
                etab = te2
            } else if s_tags[arr] == 6 {
                var te3 = sinfer.var_table_elem(intern.intern(sstate.name_str(arr)))
                if te3 >= 0 {
                    etab = te3
                }
            }
            var tb = gen_expr(arr)
            if tb < 0 {
                return -1
            }
            var start = gen_expr(call_arg(id, 1))
            if start < 0 {
                return -1
            }
            var cnt = gen_expr(call_arg(id, 2))
            if cnt < 0 {
                return -1
            }
            // 分配连续缓冲：cnt * elem_size 字节（malloc 返回 ptr<u8>）
            var esz = elem_size(etab)
            var esz_v = gen_int_lit_ty(esz, types.named(TK_I64))
            var m = ir.new_inst(g_cur_block, 2, types.named(TK_I64))  // mul
            ir.add_operand(m, esz_v, 0)
            ir.add_operand(m, cnt, 0)
            var buf = gen_ext_call1("malloc", ir.get_value(m), types.named(TK_I64), types.named(TK_STR))
            // LLVM opaque ptr：malloc 结果 ptr 直接用于 gep（元素类型 = ins_ty，
            // 步长按 etab）；无需 bitcast。
            var bp = buf
            var suffix = bridge_suffix(etab)
            var ret_ty: i64 = types.named(TK_I64)
            if suffix == "string" {
                ret_ty = types.named(TK_STR)
            } else if suffix == "f64" {
                ret_ty = types.named(TK_F64)
            } else if suffix == "bool" {
                ret_ty = types.named(TK_BOOL)
            }
            // 运行时循环（cnt/start 是运行期值，不能用编译期展开）：计数器 i
            // alloca 0..cnt，body 每次迭代 tie_table_at 读 + 写连续缓冲。
            var i_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))  // alloca i64
            ir.add_operand(i_a, types.named(TK_I64), 2)
            var i_ptr = ir.get_value(i_a)
            var i_zero = gen_int_lit_ty(0, types.named(TK_I64))
            var st0 = ir.new_inst(g_cur_block, 22, -1)  // store 0 → i
            ir.add_operand(st0, types.named(TK_I64), 2)
            ir.add_operand(st0, i_zero, 0)
            ir.add_operand(st0, i_ptr, 0)
            var cond_blk = ir.new_block(g_cur_func, interner.intern("slc.cond"))
            var body_blk = ir.new_block(g_cur_func, interner.intern("slc.body"))
            var step_blk = ir.new_block(g_cur_func, interner.intern("slc.step"))
            var exit_blk = ir.new_block(g_cur_func, interner.intern("slc.exit"))
            var b0 = ir.new_inst(g_cur_block, 30, -1)  // br cond
            ir.add_operand(b0, cond_blk, 1)
            // cond 块：i < cnt → body，否则 exit
            g_cur_block = cond_blk
            var cur = ir.new_inst(g_cur_block, 21, types.named(TK_I64))  // load i
            ir.add_operand(cur, i_ptr, 0)
            var cur_v = ir.get_value(cur)
            var cnd = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp slt
            ir.add_operand(cnd, cur_v, 0)
            ir.add_operand(cnd, cnt, 0)
            ir.add_operand(cnd, 2, 2)  // slt
            var cb = ir.new_inst(g_cur_block, 31, -1)  // cond_br
            ir.add_operand(cb, ir.get_value(cnd), 0)
            ir.add_operand(cb, body_blk, 1)
            ir.add_operand(cb, exit_blk, 1)
            // body 块：idx = start + i；读表元素；写缓冲 buf + i 元素步长
            g_cur_block = body_blk
            var cur2 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))  // load i
            ir.add_operand(cur2, i_ptr, 0)
            var i_v = ir.get_value(cur2)
            var idx = ir.new_inst(g_cur_block, 0, types.named(TK_I64))  // add start + i
            ir.add_operand(idx, start, 0)
            ir.add_operand(idx, i_v, 0)
            var ok_slot = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
            ir.add_operand(ok_slot, types.named(TK_I8), 2)
            var val = s21_table_at(tb, ir.get_value(idx), ir.get_value(ok_slot), ret_ty)
            if val < 0 {
                return -1
            }
            // 写缓冲：buf + i 元素步长（gep 单索引，i 为运行期值）
            var gp = ir.new_inst(g_cur_block, 23, etab)
            ir.add_operand(gp, bp, 0)
            ir.add_operand(gp, i_v, 0)
            var st = ir.new_inst(g_cur_block, 22, -1)  // store
            ir.add_operand(st, etab, 2)
            ir.add_operand(st, val, 0)
            ir.add_operand(st, ir.get_value(gp), 0)
            var bb = ir.new_inst(g_cur_block, 30, -1)  // br step
            ir.add_operand(bb, step_blk, 1)
            // step 块：i += 1
            g_cur_block = step_blk
            var cur3 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))  // load i
            ir.add_operand(cur3, i_ptr, 0)
            var i3 = ir.get_value(cur3)
            var one = gen_int_lit_ty(1, types.named(TK_I64))
            var inc = ir.new_inst(g_cur_block, 0, types.named(TK_I64))  // add i + 1
            ir.add_operand(inc, i3, 0)
            ir.add_operand(inc, one, 0)
            var st2 = ir.new_inst(g_cur_block, 22, -1)  // store i+1 → i
            ir.add_operand(st2, types.named(TK_I64), 2)
            ir.add_operand(st2, ir.get_value(inc), 0)
            ir.add_operand(st2, i_ptr, 0)
            var sb = ir.new_inst(g_cur_block, 30, -1)  // br cond
            ir.add_operand(sb, cond_blk, 1)
            // exit 块
            g_cur_block = exit_blk
            g_builtin_res = make_slice2(buf, cnt, etab)
            return 0
        }
        if at2 != TK_STR {
            sm_err_msg = "slice_of() 第一版只支持字符串或动态表（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var et: i64 = types.named(TK_U8)
        var pv: i64 = -1
        if s_tags[arr] == 6 {
            var nid3 = interner.intern(sstate.name_str(arr))
            if scope_get_global(nid3) >= 0 {
                pv = g_lookup_alloca
            }
        }
        if pv < 0 {
            pv = gen_expr(arr)
            if pv < 0 {
                return -1
            }
            // 字符串字面量（const_str = i64 指针整数）→ inttoptr 转 ptr
            if s_tags[arr] == 2 {
                var ip = ir.new_inst(g_cur_block, 25, types.named(TK_STR))
                ir.add_operand(ip, pv, 0)
                pv = ir.get_value(ip)
            }
        }
        var start = gen_expr(call_arg(id, 1))
        if start < 0 {
            return -1
        }
        var cnt = gen_expr(call_arg(id, 2))
        if cnt < 0 {
            return -1
        }
        // 基址 + start 元素步长（u8 → 字节偏移）
        var gp2 = ir.new_inst(g_cur_block, 23, et)
        ir.add_operand(gp2, pv, 0)
        ir.add_operand(gp2, start, 0)
        var base = ir.get_value(gp2)
        g_builtin_res = make_slice2(base, cnt, et)
        return 0
    }
    if nm == "slice_len" {
        var s = gen_expr(call_arg(id, 0))
        if s < 0 {
            return -1
        }
        g_builtin_res = slice_field(s, 1)  // 长度字段
        return 0
    }
    if nm == "slice_index" {
        // slice_index(s, i) → s[i]：gep 元素步长 + load
        var s = gen_expr(call_arg(id, 0))
        if s < 0 {
            return -1
        }
        var st_ty = node_types[call_arg(id, 0)]
        var et = types.table_elem(st_ty)
        if et < 0 {
            sm_err_msg = "slice_index() 实参必须是切片类型（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var i = gen_expr(call_arg(id, 1))
        if i < 0 {
            return -1
        }
        var sp = slice_field(s, 0)  // 指针字段
        var gp3 = ir.new_inst(g_cur_block, 23, et)
        ir.add_operand(gp3, sp, 0)
        ir.add_operand(gp3, i, 0)
        var ld2 = ir.new_inst(g_cur_block, 21, et)
        ir.add_operand(ld2, ir.get_value(gp3), 0)
        g_builtin_res = ir.get_value(ld2)
        return 0
    }
    // ---------- S1.3 as_* 显式数值转换族 ----------
    // as_i8/as_i16/as_i32/as_i64/as_u8/as_u16/as_u32/as_u64/as_f32/as_f64：
    // 任意数字 → 目标类型（数值转换：截断/饱和由 LLVM 指令映射——trunc/sext/
    // zext/fptosi/sitofp/fpext/fptrunc）。语义层已校验参数为数字。
    var as_dst: i64 = -1
    if nm == "as_i8" {
        as_dst = types.named(TK_I8)
    } else if nm == "as_i16" {
        as_dst = types.named(TK_I16)
    } else if nm == "as_i32" {
        as_dst = types.named(TK_I32)
    } else if nm == "as_i64" {
        as_dst = types.named(TK_I64)
    } else if nm == "as_u8" {
        as_dst = types.named(TK_U8)
    } else if nm == "as_u16" {
        as_dst = types.named(TK_U16)
    } else if nm == "as_u32" {
        as_dst = types.named(TK_U32)
    } else if nm == "as_u64" {
        as_dst = types.named(TK_U64)
    } else if nm == "as_f32" {
        as_dst = types.named(TK_F32)
    } else if nm == "as_f64" {
        as_dst = types.named(TK_F64)
    } else if nm == "as_i128" {
        as_dst = types.named(TK_I128)
    } else if nm == "as_u128" {
        as_dst = types.named(TK_U128)
    }
    if as_dst >= 0 {
        var av = gen_expr(call_arg(id, 0))
        if av < 0 {
            return -1
        }
        var at = node_types[call_arg(id, 0)]
        if at >= 0 && at != as_dst && (types.is_int(at) || types.is_float(at)) {
            var cv = gen_coerce(av, at, as_dst)
            if cv < 0 {
                return -1
            }
            g_builtin_res = cv
        } else {
            g_builtin_res = av
        }
        return 0
    }
    // ---------- S1.3 checked_* 溢出检测族 ----------
    if nm == "checked_add" || nm == "checked_sub" || nm == "checked_mul" ||
        nm == "checked_div" || nm == "checked_shl" || nm == "checked_shr" ||
        nm == "checked_neg" {
        var cv2 = gen_checked(nm, id)
        if cv2 < 0 {
            return -1
        }
        g_builtin_res = cv2
        return 0
    }
    if nm == "exec_code" || nm == "time_now" || nm == "get_env" || nm == "exec_output" {
        g_builtin_res = gen_runtime_call(nm, id)
        return 0
    }
    if nm == "str_len" {
        // 去 Rust 桥（dev33 批次3 关联）：码点计数改为纯 tie 内联——
        // 复用 s21_utf8_seq_len 步进循环累加（等价 tie_str_len），不再链接
        // tie_interp.lib。返回码点数。
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        // 计数槽（i64）：初值 0；字节位置槽：初值 0
        var cnt_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))
        ir.add_operand(cnt_a, types.named(TK_I64), 2)
        var cnt_ptr = ir.get_value(cnt_a)
        var pos_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))
        ir.add_operand(pos_a, types.named(TK_I64), 2)
        var pos_ptr = ir.get_value(pos_a)
        var zlit = gen_int_lit_ty(0, types.named(TK_I64))
        var st0 = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st0, types.named(TK_I64), 2)
        ir.add_operand(st0, zlit, 0)
        ir.add_operand(st0, cnt_ptr, 0)
        var st0b = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st0b, types.named(TK_I64), 2)
        ir.add_operand(st0b, zlit, 0)
        ir.add_operand(st0b, pos_ptr, 0)
        // 四块：cond / body / step / exit
        var cond_blk = ir.new_block(g_cur_func, interner.intern("sl.cond"))
        var body_blk = ir.new_block(g_cur_func, interner.intern("sl.body"))
        var step_blk = ir.new_block(g_cur_func, interner.intern("sl.step"))
        var exit_blk = ir.new_block(g_cur_func, interner.intern("sl.exit"))
        var b0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(b0, cond_blk, 1)
        // cond：pos < byte_len(s) → body，否则 exit
        g_cur_block = cond_blk
        var cur = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(cur, pos_ptr, 0)
        var cur_v = ir.get_value(cur)
        var blen = s21_str_head_len(v)
        var ol = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
        ir.add_operand(ol, cur_v, 0)
        ir.add_operand(ol, blen, 0)
        ir.add_operand(ol, 6, 2)  // ult
        var ol_v = ir.get_value(ol)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, ol_v, 0)
        ir.add_operand(cb, body_blk, 1)
        ir.add_operand(cb, exit_blk, 1)
        // body：cnt = cnt + 1；pos += utf8_seq_len(s, pos)
        g_cur_block = body_blk
        var curc = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(curc, cnt_ptr, 0)
        var curc_v = ir.get_value(curc)
        var inc = s21_bin(0, curc_v, gen_int_lit(1))
        var stc = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(stc, types.named(TK_I64), 2)
        ir.add_operand(stc, inc, 0)
        ir.add_operand(stc, cnt_ptr, 0)
        var cur2 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(cur2, pos_ptr, 0)
        var cur2_v = ir.get_value(cur2)
        var sl = s21_utf8_seq_len(v, cur2_v)
        var np = s21_bin(0, cur2_v, sl)
        var stp = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(stp, types.named(TK_I64), 2)
        ir.add_operand(stp, np, 0)
        ir.add_operand(stp, pos_ptr, 0)
        var bbr = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bbr, step_blk, 1)
        // step → cond（空 step，跳回 cond 即可；此处直接 br cond）
        g_cur_block = step_blk
        var sb2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(sb2, cond_blk, 1)
        // exit：结果 = cnt
        g_cur_block = exit_blk
        var ld = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(ld, cnt_ptr, 0)
        g_builtin_res = ir.get_value(ld)
        return 0
    }
    if nm == "char_code" {
        // 去 Rust 桥（dev33 批次3 关联）：单字符 → 码点，用已内联的
        // s21_utf8_char_at(字符, 0)（等价 tie_char_code，纯 tie 生成，不再
        // 链接 tie_interp.lib）。语义：UTF-8 解码单字符首码点 = 该码点。
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var zlit = gen_int_lit_ty(0, types.named(TK_I64))
        g_builtin_res = s21_utf8_char_at(v, zlit)
        return 0
    }
    if nm == "str_char" {
        // 去 Rust 桥：取第 i 个码点字符，irgen 内联生成——字节位置循环跳过
        // i 个码点（s21_utf8_seq_len 步进）→ s21_utf8_char_at 解码码点 →
        // s21_codepoint_to_str 得单字符。不链接 tie_interp.lib。
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var i = gen_expr(call_arg(id, 1))
        if i < 0 {
            return -1
        }
        // 位置槽（字节 pos）与步进计数器槽（已跳码点数）
        var pos_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))
        ir.add_operand(pos_a, types.named(TK_I64), 2)
        var pos_ptr = ir.get_value(pos_a)
        var k_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))
        ir.add_operand(k_a, types.named(TK_I64), 2)
        var k_ptr = ir.get_value(k_a)
        var zlit = gen_int_lit_ty(0, types.named(TK_I64))
        var stp = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(stp, types.named(TK_I64), 2)
        ir.add_operand(stp, zlit, 0)
        ir.add_operand(stp, pos_ptr, 0)
        var stk = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(stk, types.named(TK_I64), 2)
        ir.add_operand(stk, zlit, 0)
        ir.add_operand(stk, k_ptr, 0)
        // 三块：cond / body / exit（字节定位循环）
        var cond_blk = ir.new_block(g_cur_func, interner.intern("sc.cond"))
        var body_blk = ir.new_block(g_cur_func, interner.intern("sc.body"))
        var exit_blk = ir.new_block(g_cur_func, interner.intern("sc.exit"))
        var b0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(b0, cond_blk, 1)
        // cond：k < i → body，否则 exit
        g_cur_block = cond_blk
        var ku = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(ku, k_ptr, 0)
        var ku_v = ir.get_value(ku)
        var ol = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp
        ir.add_operand(ol, ku_v, 0)
        ir.add_operand(ol, i, 0)
        ir.add_operand(ol, 2, 2)  // slt
        var ol_v = ir.get_value(ol)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, ol_v, 0)
        ir.add_operand(cb, body_blk, 1)
        ir.add_operand(cb, exit_blk, 1)
        // body：pos += utf8_seq_len(s, pos)；k += 1
        g_cur_block = body_blk
        var pu = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(pu, pos_ptr, 0)
        var pu_v = ir.get_value(pu)
        var sl = s21_utf8_seq_len(v, pu_v)
        var np = s21_bin(0, pu_v, sl)  // add
        var stp2 = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(stp2, types.named(TK_I64), 2)
        ir.add_operand(stp2, np, 0)
        ir.add_operand(stp2, pos_ptr, 0)
        var ku2 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(ku2, k_ptr, 0)
        var ku2_v = ir.get_value(ku2)
        var nk = s21_bin(0, ku2_v, gen_int_lit(1))
        var stk2 = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(stk2, types.named(TK_I64), 2)
        ir.add_operand(stk2, nk, 0)
        ir.add_operand(stk2, k_ptr, 0)
        var bbr = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bbr, cond_blk, 1)
        // exit：解码 pos 处码点 → 单字符字符串
        g_cur_block = exit_blk
        var pz = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(pz, pos_ptr, 0)
        var pz_v = ir.get_value(pz)
        var cp = s21_utf8_char_at(v, pz_v)
        g_builtin_res = s21_codepoint_to_str(cp)
        return 0
    }
    if nm == "str_from_code" {
        // 去 Rust 桥：码点 → 单字符 UTF-8 字符串，改 irgen 内联生成
        // s21_codepoint_to_str（纯 tie 内联，不链接 tie_interp.lib）。
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        // 窄整数（trit/char/i8/i16/i32 等）先 sext 到 i64（s21 编码期望 i64）
        var vt = node_types[call_arg(id, 0)]
        var sv = v
        if vt >= 0 && vt != types.named(TK_I64) && vt != types.named(TK_U64) {
            var se = gen_sext(v, vt, types.named(TK_I64))
            if se < 0 {
                return -1
            }
            sv = se
        }
        g_builtin_res = s21_codepoint_to_str(sv)
        return 0
    }
    // ---------- S2.1 字符串 {ptr,len} 原语 ----------
    // 二进制安全字节访问 / UTF-8 码点解码 / StringBuilder（实现见文件尾 s21_* 组）。
    if nm == "str_byte" {
        // str_byte(s, i)：取第 i 字节（0 ≤ i < len(s)；越界未定义——调用方保证）
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var i = gen_expr(call_arg(id, 1))
        if i < 0 {
            return -1
        }
        g_builtin_res = s21_str_byte(v, i)
        return 0
    }
    if nm == "utf8_seq_len" {
        // utf8_seq_len(s, i)：字节 i 起的 UTF-8 序列长度（1-4，按首字节判定）
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var i = gen_expr(call_arg(id, 1))
        if i < 0 {
            return -1
        }
        g_builtin_res = s21_utf8_seq_len(v, i)
        return 0
    }
    if nm == "utf8_char_at" {
        // utf8_char_at(s, i)：字节 i 起的 UTF-8 码点值（分支按序列长度解码）
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var i = gen_expr(call_arg(id, 1))
        if i < 0 {
            return -1
        }
        g_builtin_res = s21_utf8_char_at(v, i)
        return 0
    }
    // SSO 短串池回退 malloc 累计次数（dev33 批次3 验收探针用：断言 = 0）
    if nm == "sso_malloc_count" {
        llvmgen.sso_enable()
        var cnt_id = interner.intern("@s21_sso_malloc_cnt")
        var ldc = ir.new_inst(g_cur_block, 21, types.named(TK_I64))  // load
        ir.add_operand(ldc, cnt_id, 3)  // OK_GLOBAL → @s21_sso_malloc_cnt
        g_builtin_res = ir.get_value(ldc)
        return 0
    }
    // 可捕获 panic（dev33 批次7 任务18）：catch_panic(f) -> bool
    if nm == "catch_panic" {
        var r = gen_catch_panic(id)
        if r < 0 {
            return -1
        }
        return 0
    }
    // 闭包 → C 回调函数指针（dev33 批次8 任务23）：cb_ptr(f) -> string
    if nm == "cb_ptr" {
        var r2 = gen_cb_ptr(id)
        if r2 < 0 {
            return -1
        }
        return 0
    }
    if nm == "string_builder" {
        // string_builder()：新建 StringBuilder 句柄（i64；两级指针 {cap,len,data}）
        g_builtin_res = s21_sb_new()
        return 0
    }
    if nm == "sb_append" {
        // sb_append(h, s)：原地追加字符串（容量不足自动倍增重分配）；返回 0
        var h = gen_expr(call_arg(id, 0))
        if h < 0 {
            return -1
        }
        var v = gen_expr(call_arg(id, 1))
        if v < 0 {
            return -1
        }
        s21_sb_append(h, v)
        g_builtin_res = gen_int_lit(0)
        return 0
    }
    if nm == "sb_append_byte" {
        // sb_append_byte(h, b)：原地追加单字节（0-255，二进制安全含 \0）；返回 0
        var h = gen_expr(call_arg(id, 0))
        if h < 0 {
            return -1
        }
        var b = gen_expr(call_arg(id, 1))
        if b < 0 {
            return -1
        }
        s21_sb_append_byte(h, b)
        g_builtin_res = gen_int_lit(0)
        return 0
    }
    if nm == "sb_build" {
        // sb_build(h)：一次性产出 string（{头, 数据, \0}；句柄仍有效可复用）
        var h = gen_expr(call_arg(id, 0))
        if h < 0 {
            return -1
        }
        g_builtin_res = s21_sb_build(h)
        return 0
    }
    if nm == "sb_reset" {
        // sb_reset(h)：清空复用（len=0，cap/data 缓冲保留；build 后续写必须 reset）
        var h = gen_expr(call_arg(id, 0))
        if h < 0 {
            return -1
        }
        g_builtin_res = s21_sb_reset(h)
        return 0
    }
    if nm == "str_sub_bytes" {
        // str_sub_bytes(s, lo, hi)：字节区间子串 [lo, hi)（clamp 越界；
        // 配合码点→字节偏移表实现 lexeme 切片零重扫）
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var lo = gen_expr(call_arg(id, 1))
        if lo < 0 {
            return -1
        }
        var hi = gen_expr(call_arg(id, 2))
        if hi < 0 {
            return -1
        }
        g_builtin_res = s21_str_sub_bytes(v, lo, hi)
        return 0
    }
    // ---------- 网络原语（P0：std/net）----------
    // 参数签名：i=整数（窄整数 sext 到 i64）、s=字符串（ptr 直传）；桥符号 tie_<name>；
    // net_close 返回 i8→bool（icmp ne），两个 recv 返回堆串（gen_stmt 统一 free），其余 i64。
    if nm == "net_close" || nm == "net_tcp_accept" || nm == "net_tcp_connect" ||
        nm == "net_tcp_listen" || nm == "net_tcp_recv" || nm == "net_tcp_send" ||
        nm == "net_udp_bind" || nm == "net_udp_recv" || nm == "net_udp_send" {
        g_used_interp = true
        if nm == "net_close" {
            // 单参句柄 → i8 桥 → icmp ne → bool（与 file_delete 同模式）
            var h = gen_expr(call_arg(id, 0))
            if h < 0 {
                return -1
            }
            var ht = node_types[call_arg(id, 0)]
            if ht != types.named(TK_I64) && ht != types.named(TK_U64) && ht >= 0 {
                var sh = gen_sext(h, ht, types.named(TK_I64))
                if sh < 0 {
                    return -1
                }
                h = sh
            }
            g_builtin_res = gen_bool_bridge1("tie_net_close", h, types.named(TK_I64))
            return 0
        }
        // 参数模式（i/s）按函数签名构造
        var pat: table<string> = table_new_string()
        if nm == "net_udp_send" {
            table_push(pat, "i")
            table_push(pat, "s")
            table_push(pat, "i")
            table_push(pat, "s")
        } else if nm == "net_tcp_connect" {
            table_push(pat, "s")
            table_push(pat, "i")
        } else if nm == "net_tcp_send" {
            table_push(pat, "i")
            table_push(pat, "s")
        } else if nm == "net_tcp_recv" || nm == "net_udp_recv" {
            table_push(pat, "i")
            table_push(pat, "i")
        } else {
            table_push(pat, "i")
        }
        var atys: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        var k: i64 = 0
        while k < len(pat) {
            var a = call_arg(id, k)
            var v = gen_expr(a)
            if v < 0 {
                return -1
            }
            if pat[k] == "i" {
                var vt = node_types[a]
                if vt == types.named(TK_I64) || vt == types.named(TK_U64) || vt < 0 {
                    table_push(atys, types.named(TK_I64))
                    table_push(avs, v)
                } else {
                    var sv = gen_sext(v, vt, types.named(TK_I64))
                    if sv < 0 {
                        return -1
                    }
                    table_push(atys, types.named(TK_I64))
                    table_push(avs, sv)
                }
            } else {
                table_push(atys, types.named(TK_STR))
                table_push(avs, v)
            }
            k = k + 1
        }
        var rty = types.named(TK_I64)
        if nm == "net_tcp_recv" || nm == "net_udp_recv" {
            rty = types.named(TK_STR)
        }
        g_builtin_res = gen_ext_call_typed("tie_" + nm, atys, avs, rty)
        return 0
    }
    if nm == "to_string" {
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        // 实参类型：f64 → 用 i128 内联除数换成「浮点暂保留 Rust 桥」见下；
        // i64/u64 → gen_i64_to_str（去 Rust）；窄整数 sext → i64 后再内联。
        var vt = node_types[call_arg(id, 0)]
        if vt == types.named(TK_F64) || vt == types.named(TK_F32) {
            // 去 Rust 桥（浮点保留 Rust 桥——待专用 f64→十进制内联，见规划批次）
            g_used_interp = true
            g_builtin_res = gen_ext_call1("tie_to_string_f64", v, types.named(TK_F64), types.named(TK_STR))
        } else if vt == types.named(TK_I128) || vt == types.named(TK_U128) {
            // 批次 2（i128/u128）：内联除法循环生成十进制串
            g_builtin_res = gen_i128_to_str(v, vt == types.named(TK_I128))
        } else if vt == types.named(TK_I64) {
            g_builtin_res = gen_i64_to_str(v, true)
        } else if vt == types.named(TK_U64) {
            g_builtin_res = gen_i64_to_str(v, false)
        } else if vt < 0 {
            g_builtin_res = gen_i64_to_str(v, false)
        } else {
            // 窄类型（trit/char/i8/i16/i32/u8/u16/u32 等）：sext → i64
            var sv = gen_sext(v, vt, types.named(TK_I64))
            if sv < 0 {
                return -1
            }
            g_builtin_res = gen_i64_to_str(sv, true)
        }
        return 0
    }
    if nm == "parse_int" {
        g_used_interp = true
        var v = gen_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        // Rust 桥签名 (ptr, ptr ok) -> i64：缺 ok 出参会导致 ABI 错位、
