type tie<logic>
// compiler/driver.tie —— 自举 T3.2：完整 CLI 编译器驱动（tiec 入口）
// ============================================================
// 对齐 Rust crates/tie-llvm/src/main.rs + driver.rs：参数解析、角色分派、
// 消息格式、退出码。组装前端（parse_ast/check_ast，T5.3 内存 AST 版）+ 中端
//（irgen.gen_ast/llvmgen.emit）+ 后端（backend/toolchain.tie）。中端用
// gen_ast()（AST 已由 frontend 就绪，不再二次执行前端；gen_src 由
// driver-lite/_driver_test 使用）。
//
// 用法：tiec <input.tie> [-o <out>] [-O0|-O1|-O2|-O3] [--target <三元组>]
//                    [--emit-ir] [--keep-ir] [--prep-only] [--config <f>] [--help]
// 退出码：0 成功 / 1 编译失败 / 2 参数错误。
//
// 角色识别：**头部扫描**（读源文件头部注释行找 `// tie:xxx`），不依赖
// prep/core.tie 的 import（避免 import 路径与编译兼容性风险；prep 协议
// 后续可替换）。识别 logic/library/ui/db/data；logic/library → 编译工具链，
// data/ui/db → 提示对应工具链未实现。
//
// opt/target 优先级：CLI 显式 > 头部 `// tie:opt=N` / `// tie:target=` > 默认 O2/无。
import "./backend/irgen.tie"
import "./backend/toolchain.tie"

// ==================== 全局 ====================
var g_input: string = "";
var g_output: string = "";        // -o 指定（空 = 默认）
var g_opt_level: i64 = 0;         // -O 显式（g_opt_set 为 true 时生效）
var g_opt_set: bool = false;      // 是否显式指定 -O
var g_target: string = "";        // --target（空 = 未指定）
var g_emit_ir: bool = false;
var g_keep_ir: bool = false;
var g_prep_only: bool = false;
var g_role: string = "";          // 头部识别的角色

// ==================== 参数解析 ====================

// 打印用法（--help）。返回 0。
func usage() -> i64 {
    println("tiec —— tie 自举编译器（tie 语言自写）")
    println("用法: tiec <input.tie> [选项]")
    println("  -o <file>        输出可执行文件（logic 默认输入同名 .exe；library 默认 .a）")
    println("  -O0|-O1|-O2|-O3  优化级别（默认 -O2）")
    println("  --target <三元组>  交叉编译目标（如 x86_64-pc-windows-msvc）")
    println("  --emit-ir        只生成 LLVM IR（.ll），不继续编译")
    println("  --keep-ir        保留中间 IR 文件（.ll / .opt.ll）")
    println("  --prep-only      只做头部识别并打印结果")
    println("  --config <f>     协调统筹配置文件（单文件编译暂忽略）")
    println("  --help           显示本帮助")
    return 0
}

// 解析参数：返回 0 正常 / 2 请求帮助 / -1 参数错误。g_* 填充解析结果。
func parse_args() -> i64 {
    var n: i64 = arg_count()
    var i: i64 = 0
    var input_set: bool = false
    while i < n {
        var a = arg_string(i)
        if a == "--help" || a == "-h" {
            return 2
        }
        if a == "--emit-ir" {
            g_emit_ir = true
        } else if a == "--keep-ir" {
            g_keep_ir = true
        } else if a == "--prep-only" {
            g_prep_only = true
        } else if a == "-o" {
            if i + 1 >= n {
                return -1
            }
            g_output = arg_string(i + 1)
            i = i + 1
        } else if a == "-O0" {
            g_opt_level = 0
            g_opt_set = true
        } else if a == "-O1" {
            g_opt_level = 1
            g_opt_set = true
        } else if a == "-O2" {
            g_opt_level = 2
            g_opt_set = true
        } else if a == "-O3" {
            g_opt_level = 3
            g_opt_set = true
        } else if a == "--target" {
            if i + 1 >= n {
                return -1
            }
            g_target = arg_string(i + 1)
            i = i + 1
        } else if a == "--config" {
            if i + 1 >= n {
                return -1
            }
            i = i + 1
        } else if str_len(a) > 1 && str_char(a, 0) == "-" {
            // 未知选项
            return -1
        } else {
            if input_set {
                return -1
            }
            g_input = a
            input_set = true
        }
        i = i + 1
    }
    if !input_set {
        return -1
    }
    return 0
}

// 目标三元组别名归一化（对齐 Rust normalize_target）：已知别名映射，
// 未知名称原样透传。
func normalize_target(t: string) -> string {
    if t == "win-x64" || t == "windows-x64" {
        return "x86_64-pc-windows-msvc"
    }
    if t == "win-x86" || t == "windows-x86" {
        return "i686-pc-windows-msvc"
    }
    if t == "win-arm64" || t == "windows-arm64" {
        return "aarch64-pc-windows-msvc"
    }
    if t == "linux-x64" || t == "linux-x86_64" {
        return "x86_64-unknown-linux-gnu"
    }
    if t == "linux-arm64" {
        return "aarch64-unknown-linux-gnu"
    }
    if t == "macos-x64" || t == "macos-x86_64" {
        return "x86_64-apple-darwin"
    }
    if t == "macos-arm64" {
        return "aarch64-apple-darwin"
    }
    return t
}

// ==================== 头部扫描（文件类型声明） ====================

// 从源码头部识别文件类型声明（新体系）：
//   `type tie` → 类型 type；`type tie<X>` → X（X ∈ script/data/ui/class/logic/port/db）。
// 头部区 = 文件最前连续行（允许空行），遇第一个非空非声明行即结束；
// 只扫前 20 行。无声明默认 logic（可执行）。
// 旧 `// tie:xxx` 注释指令体系已彻底移除：该类行只是普通注释，不再识别
// 角色与 opt/target 选项（opt 仅 CLI 默认 O2；target 仅 CLI）。
// 返回 0 成功；声明语法非法返回 -1（由 main 报错退出）。
func scan_header(src: string) -> i64 {
    var lines = split_lines(src)
    var n: i64 = len(lines)
    var i: i64 = 0
    g_role = "logic"
    while i < n && i < 20 {
        var ln = trim(lines[i])
        if str_len(ln) == 0 {
            i = i + 1
            continue
        }
        if has_prefix(ln, "type tie") {
            var rest = trim(slice(ln, 8, str_len(ln)))
            if str_len(rest) == 0 {
                g_role = "type"
                return 0
            }
            // 期望 `<X>` 形式，且无尾随内容
            if str_len(rest) >= 3 && str_char(rest, 0) == "<" && str_char(rest, str_len(rest) - 1) == ">" {
                var sub = trim(slice(rest, 1, str_len(rest) - 1))
                if sub == "script" || sub == "data" || sub == "ui" || sub == "class" || sub == "logic" || sub == "port" || sub == "db" {
                    g_role = sub
                    return 0
                }
                println("文件类型声明错误: 未知类型 '" + sub + "'（第 " + to_string(i + 1) + " 行），合法类型: script/data/ui/class/logic/port/db")
                return -1
            }
            println("文件类型声明错误: 非法声明 '" + ln + "'（第 " + to_string(i + 1) + " 行），应为 `type tie` 或 `type tie<类型>`")
            return -1
        }
        // 第一个非空非声明行：头部区结束
        break
    }
    return 0
}

// 剥离头部区的文件类型声明行（`type tie` / `type tie<X>`），返回清理后源码。
// 新声明是真语法行，必须从正文中移除（旧 `// tie:` 是注释由 lexer 跳过，无需剥离）。
// 头部区 = 文件最前连续行（允许空行），遇第一个非空非声明行即停止；
// 声明行之外的行（含空行/注释/缩进）原样保留，\n 重连。
func strip_type_header(src: string) -> string {
    var lines = split_lines(src)
    var n: i64 = len(lines)
    var out: string = ""
    var in_header = true
    var i: i64 = 0
    while i < n {
        var ln = lines[i]
        var t = trim(ln)
        if in_header {
            if str_len(t) == 0 {
                // 头部区空行：保留
            } else if has_prefix(t, "type tie") {
                // 声明行：剥离
                i = i + 1
                continue
            } else {
                in_header = false
            }
        }
        if str_len(out) > 0 {
            out = out + "\n"
        }
        out = out + ln
        i = i + 1
    }
    return out
}

// ==================== 前端 ====================

// 前端：词法/语法（parser.parse_ast，AST 留内存）→ 语义+import（semantic.check_ast）。
// 返回 0 成功；失败打印错误并返回 -1。
func frontend(src: string, base_dir: string) -> i64 {
    // T5.3 内存版：parse_ast 返回 0/-1（成功时 AST 在 ast 节点池内存），
    // 失败时由 parser.ast_err_protocol() 组装与 parse_src 相同的 "ERR:line col msg"
    var prc = parser.parse_ast(src)
    if prc < 0 {
        println("语法错误 " + err_span(parser.ast_err_protocol()))
        return -1
    }
    var sem = semantic.check_ast(base_dir)
    if has_prefix(sem, "ERR:") {
        println("语义错误 " + err_span(sem))
        return -1
    }
    return 0
}

// ERR 协议文本 → "行:列: 消息"（协议 ERR:<line> <col> <msg>）。
func err_span(proto: string) -> string {
    var rest = slice(proto, 4, str_len(proto))
    var sp1 = find_char(rest, " ")
    if sp1 < 0 {
        return proto
    }
    var sp2: i64 = -1
    var i: i64 = sp1 + 1
    while i < str_len(rest) {
        if str_char(rest, i) == " " {
            sp2 = i
            break
        }
        i = i + 1
    }
    if sp2 < 0 {
        return rest
    }
    return "@" + slice(rest, 0, sp1) + ":" + slice(rest, sp1 + 1, sp2) + ": " +
        slice(rest, sp2 + 1, str_len(rest))
}

// ==================== 主流程 ====================

// 入口：解析参数 → 读文件 → 头部扫描 → 角色分派。返回退出码。
func main() -> i64 {
    var pr = parse_args()
    if pr == 2 {
        return usage()
    }
    if pr < 0 {
        println("参数错误。输入 tiec --help 查看用法。")
        return 2
    }
    // 读源码
    if !file_exists(g_input) {
        println("读取源码失败: " + g_input)
        return 1
    }
    var src = file_read(g_input)
    if str_len(src) == 0 {
        println("读取源码失败: " + g_input)
        return 1
    }
    // 头部扫描（文件类型声明 / 角色）
    if scan_header(src) < 0 {
        return 1
    }
    // 剥离头部声明行（`type tie` / `type tie<X>` 是真语法行，须从正文移除；
    // 旧 `// tie:` 是注释由 lexer 跳过，无需处理）
    var clean = strip_type_header(src)
    // 文件名角色检查：`xxx.<角色>.tie` 提供默认角色，与头部声明不一致时警告
    // （头部声明优先，文件名仅作为提示）
    var fname = file_name_of(g_input)
    var name_role = role_from_filename(fname)
    if str_len(name_role) > 0 && name_role != g_role {
        println("警告: 文件 " + g_input + " 名称声明为 " + name_role + "，与头部声明 " + g_role + " 不一致，已采用头部声明")
    }
    if g_prep_only {
        println("[预处理] 识别为 " + g_role + " 文件（头: " + g_input + "）")
        return 0
    }
    // 角色分派：data/ui/db/port → 未实现提示；logic/script → 编译可执行；
    // class/type → 编译静态库
    if g_role == "data" {
        println("[预处理] 识别为 data 数据交换文件（头: " + g_input + "），已转交数据解析工具链 —— v0.1 数据交换工具链尚未实现")
        return 0
    }
    if g_role == "ui" {
        println("[预处理] 识别为 ui 界面文件（头: " + g_input + "），已转交 UI 工具链 —— v0.1 UI 工具链尚未实现")
        return 0
    }
    if g_role == "db" {
        println("[预处理] 识别为 db 数据库文件（头: " + g_input + "），已转交数据库工具链 —— v0.1 数据库工具链尚未实现")
        return 0
    }
    if g_role == "port" {
        println("[预处理] 识别为 port 端口文件（头: " + g_input + "），已转交端口工具链 —— v0.1 端口工具链尚未实现")
        return 0
    }
    return compile_program(clean)
}

// 编译工具链（logic / library）：前端 → 中端 → 后端。
func compile_program(src: string) -> i64 {
    // base_dir：输入路径的目录（import 展开需要）；\\ 归一化为 /
    var base_dir = dir_of(g_input)
    // 前端
    if frontend(src, base_dir) < 0 {
        return 1
    }
    // 中端：AST → tie-IR → .ll 文本
    // frontend() 已执行完整前端（parse_ast + check_ast），sstate 全局表/
    // g_extra_tops/node_types 均已就绪——直接 gen_ast() 复用，避免前端重复
    // 执行（gen_src 内部会再 parse + check_impl 一遍，行为等价但浪费一倍）
    var rc = irgen.gen_ast()
    if rc < 0 {
        var msg = sm_err_msg
        if str_len(msg) == 0 {
            msg = "irgen 最小集之外的语句（尚未支持）"
        }
        println("IR 生成失败: " + msg)
        return 1
    }
    var ll_text = llvmgen.emit()
    // IR 文件路径：--emit-ir → -o 或 输入.ll；否则中间文件（输出基准）
    var ir_path = replace_ext(g_input, "ll")
    if str_len(g_output) > 0 {
        ir_path = replace_ext(g_output, "ll")
    }
    if !file_write(ir_path, ll_text) {
        println("文件操作失败: 写 IR 文件 " + ir_path)
        return 1
    }
    if g_emit_ir {
        println("已生成 LLVM IR: " + ir_path)
        return 0
    }
    // 后端：opt → 链接/归档
    var opt_path = replace_ext(ir_path, "opt.ll")
    var level = g_opt_level
    if !g_opt_set {
        level = 2
    }
    var orc = tc.opt(ir_path, opt_path, level)
    if orc != 0 {
        println("[中间优化] " + tc_err_msg)
        return 1
    }
    var target = normalize_target(g_target)
    if g_role == "class" || g_role == "type" {
        return compile_library(ir_path, opt_path, target)
    }
    return compile_logic(ir_path, opt_path, target)
}

// logic：clang 链接可执行文件；清理中间文件（除非 --keep-ir）。
// need_interp（T4.5）：程序用了 tie 运行时桥内置（exec_code/get_env/time_now，
// irgen 置 g_used_runtime）→ 链接 std/runtime.a（tie 自写运行时，无需 Rust
// tie-interp 库）。
// 阶段 A：程序用了 tie-interp 库桥（str_len/table_*/file_*/arg_* 等，irgen 置
// g_used_interp）→ 必须链接 tie_interp.lib（Rust 桥，覆盖全部 tie_* 符号）。
// 两者都置时以 interp.lib 为准（其覆盖 runtime.a 的三个符号），避免重复定义。
func compile_logic(ir_path: string, opt_path: string, target: string) -> i64 {
    var exe_path = g_output
    if str_len(exe_path) == 0 {
        exe_path = replace_ext(g_input, "exe")
    }
    // need_interp：优先 tie_interp.lib（stage A 新桥）；否则 runtime.a（T4.5 旧路径）
    // 第三参 prefer_interp = g_used_interp：用 interp 桥时强制 tie_interp.lib
    var bres = tc.link_exe(opt_path, exe_path, target, g_used_interp || g_used_runtime, g_used_interp)
    if bres != 0 {
        println("[后端] " + tc_err_msg)
        return 1
    }
    cleanup(ir_path, opt_path)
    println("编译成功: " + exe_path)
    return 0
}

// library：clang -c 目标文件 + llvm-ar 打包静态库；清理中间文件。
func compile_library(ir_path: string, opt_path: string, target: string) -> i64 {
    var lib_path = g_output
    if str_len(lib_path) == 0 {
        lib_path = replace_ext(g_input, "a")
    }
    var obj_path = replace_ext(g_input, "o")
    var crc = tc.compile_object(opt_path, obj_path, target)
    if crc != 0 {
        println("[后端] " + tc_err_msg)
        return 1
    }
    var arc = tc.archive(obj_path, lib_path)
    if arc != 0 {
        println("[后端] " + tc_err_msg)
        return 1
    }
    cleanup(ir_path, opt_path)
    file_delete(obj_path)
    println("库编译成功: " + lib_path)
    return 0
}

// 清理中间 .ll / .opt.ll（--keep-ir 时保留）。
func cleanup(ir_path: string, opt_path: string) {
    if !g_keep_ir {
        file_delete(ir_path)
        file_delete(opt_path)
    }
}

// ==================== 字符串/路径工具（零依赖） ====================

// 按 \n 拆行（去行尾 \r）。
func split_lines(s: string) -> table<string> {
    var rows = table_new_string()
    var n: i64 = str_len(s)
    var line: string = ""
    var i: i64 = 0
    while i < n {
        var c = str_char(s, i)
        if c == "\n" {
            table_push(rows, line)
            line = ""
        } else if c == "\r" {
        } else {
            line = line + c
        }
        i = i + 1
    }
    if str_len(line) > 0 {
        table_push(rows, line)
    }
    return rows
}

// 判断 s 是否以 prefix 开头。
func has_prefix(s: string, prefix: string) -> bool {
    var n: i64 = str_len(s)
    var m: i64 = str_len(prefix)
    if n < m {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_char(s, i) != str_char(prefix, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 找字符串中首个 ch 的位置；未找到 -1。
func find_char(s: string, ch: string) -> i64 {
    var n: i64 = str_len(s)
    var i: i64 = 0
    while i < n {
        if str_char(s, i) == ch {
            return i
        }
        i = i + 1
    }
    return -1
}

// 取字符串 [start, end) 子串（码点级）。
func slice(s: string, start: i64, end: i64) -> string {
    var out: string = ""
    var i: i64 = start
    while i < end {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

// 去除字符串首尾空白（空格/制表）。
func trim(s: string) -> string {
    var n: i64 = str_len(s)
    var start: i64 = 0
    var end: i64 = n
    while start < end && (str_char(s, start) == " " || str_char(s, start) == "\t") {
        start = start + 1
    }
    while end > start && (str_char(s, end - 1) == " " || str_char(s, end - 1) == "\t") {
        end = end - 1
    }
    return slice(s, start, end)
}

// 取路径的目录部分（含末尾分隔符；无分隔符返回空串）；\ 与 / 都识别，
// 输出归一化为 /（import 展开需要）。
func dir_of(path: string) -> string {
    var n: i64 = str_len(path)
    var last: i64 = -1
    var i: i64 = 0
    while i < n {
        var c = str_char(path, i)
        if c == "/" || c == "\\" {
            last = i
        }
        i = i + 1
    }
    if last < 0 {
        return ""
    }
    var d = slice(path, 0, last + 1)
    var out: string = ""
    var j: i64 = 0
    while j < str_len(d) {
        var c2 = str_char(d, j)
        if c2 == "\\" {
            out = out + "/"
        } else {
            out = out + c2
        }
        j = j + 1
    }
    return out
}

// 替换路径扩展名（basename 最后一个 . 后替换；无 . 直接追加）。
// 例：examples/hello.tie + "exe" → examples/hello.exe；a.opt.ll + "ll" → a.opt.ll。
func replace_ext(path: string, new_ext: string) -> string {
    var n: i64 = str_len(path)
    var last_dot: i64 = -1
    var i: i64 = 0
    while i < n {
        if str_char(path, i) == "." {
            last_dot = i
        }
        i = i + 1
    }
    var base: string = path
    if last_dot > 0 {
        base = slice(path, 0, last_dot)
    }
    return base + "." + new_ext
}

// 取路径的文件名部分（最后一个 / 或 \ 之后；无分隔符返回原串）。
func file_name_of(path: string) -> string {
    var n: i64 = str_len(path)
    var last: i64 = -1
    var i: i64 = 0
    while i < n {
        var c = str_char(path, i)
        if c == "/" || c == "\\" {
            last = i
        }
        i = i + 1
    }
    if last < 0 {
        return path
    }
    return slice(path, last + 1, n)
}

// 从文件名推断角色：`xxx.<角色>.tie` → 角色名；否则空串。
// （新体系文件命名约定：xxx.type.tie → type、xxx.logic.tie → logic 等；
// 头部声明优先，文件名仅作默认，不一致时警告采用头部声明）
func role_from_filename(name: string) -> string {
    var n: i64 = str_len(name)
    var first_dot: i64 = -1
    var last_dot: i64 = -1
    var i: i64 = 0
    while i < n {
        if str_char(name, i) == "." {
            if first_dot < 0 {
                first_dot = i
            }
            last_dot = i
        }
        i = i + 1
    }
    // 需要至少两段（首点存在且与末点不同）：xxx.<角色>.tie
    if first_dot < 0 || last_dot <= first_dot {
        return ""
    }
    if slice(name, last_dot + 1, n) != "tie" {
        return ""
    }
    var role = slice(name, first_dot + 1, last_dot)
    if role == "type" || role == "script" || role == "data" || role == "ui" || role == "class" || role == "logic" || role == "port" || role == "db" {
        return role
    }
    return ""
}
