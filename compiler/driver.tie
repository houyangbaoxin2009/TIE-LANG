type tie<logic>
// compiler/driver.tie —— 自举 T3.2：完整 CLI 编译器驱动（tiec 入口）
// ============================================================
// 对齐 Rust crates/tie-llvm/src/main.rs + driver.rs：参数解析、角色分派、
// 消息格式、退出码。组装前端（parse_ast/check_ast，T5.3 内存 AST 版）+ 中端
//（irgen.tig_ast/llvmgen.emit）+ 后端（backend/toolchain.tie）。中端用
// tig_ast()（AST 已由 frontend 就绪，不再二次执行前端；tig_src 由
// driver-lite/_driver_test 使用）。
//
// 用法：tiec <input.tie> [-o <out>] [-O0|-O1|-O2|-O3] [--target <三元组>]
//                    [--emit-ir] [--keep-ir] [--prep-only] [--config <f>] [--help]
// 退出码：0 成功 / 1 编译失败 / 2 参数错误。
//
// 角色识别：**头部扫描**（`type tie` / `type tie<X>` 声明），不依赖
// prep/core.tie 的 import（避免 import 路径与编译兼容性风险；prep 协议
// 后续可替换）。识别 logic/script/class/type/data/ui/db/port/ir/zd；
// logic/script/class/type → 编译工具链，data/ui/db/port/zd → 提示对应
// 工具链未实现。zd 是 tie:data 的二进制压缩变体（xxx.zd.tie），人类不可读，
// 必须在 file_read（文本读取）之前按文件名预判并直接短接。
//
// opt/target 优先级：CLI 显式 > 头部 `// tie:opt=N` / `// tie:target=` > 默认 O2/无。
import "./backend/irgen.tie"
import "./backend/toolchain.tie"
import "./config.tie"
// S3.2：tieir 序列化（--tieir-out 输出分发单元 / --dump-irt 读回 dump）
import "./middle/tieir_ser.tie"

// 阶段计时探针（性能诊断）：CRT clock()，毫秒精度。
// 环境变量 TIEC_TIME=1 时输出各阶段耗时（不设则零开销静默）。
unsafe extern fn clock() -> i64;

// ==================== 全局 ====================
var g_input: string = "";
var g_output: string = "";        // -o 指定（空 = 默认）
var g_opt_level: i64 = 0;         // -O 显式（g_opt_set 为 true 时生效）
var g_opt_set: bool = false;      // 是否显式指定 -O
var g_target: string = "";        // --target（空 = 未指定）
var g_emit_ir: bool = false;
var g_keep_ir: bool = false;
var g_prep_only: bool = false;
// M5 动态库模式（dev33 批次 12）：--shared 或输出扩展名 .dll/.so → 动态库。
var g_shared: bool = false;
var g_role: string = "";          // 头部识别的角色
// S3.1 构建配置：--config 显式路径（空 = 默认 config.data.tie）+ CLI --profile
var g_config_path: string = "";   // --config <f> 指定（空 = 当前目录 config.data.tie）
var g_cli_profile: string = "";   // --profile <p> 指定（空 = config 顶层 profile 键）
var g_cfg_root: i64 = -1;         // 分层合并后的配置根节点（load_merge 结果）
var g_backend_cli: string = "";   // --backend <b> 指定（空 = 配置 tiec.backend）
// S3.2：tieir 分发（--tieir-out <f> 编译后序列化 .tieir；--dump-irt <f> 只读 dump）
var g_tieir_out: string = "";     // --tieir-out 指定（空 = 不输出 .tieir）
var g_dump_irt: string = "";      // --dump-irt <f> 指定（空 = 不 dump）

// ==================== 参数解析 ====================

// 打印用法（--help）。返回 0。
func usage() -> i64 {
    println("tiec —— tie 自举编译器（tie 语言自写）")
    println("用法: tiec <input.tie> [选项]")
    println("  -o <file>        输出可执行文件（logic 默认输入同名 .exe；library 默认 .a）")
    println("  -O0|-O1|-O2|-O3  优化级别（默认 -O2）")
    println("  --target <三元组>  交叉编译目标（如 x86_64-pc-windows-msvc）")
    println("  --emit-ir        只生成 LLVM IR（.ll），不继续编译")
    println("  --keep-ir        保留中间 IR 文件（.ll / .opt.ll）")
    println("  --shared         编译为动态库（.dll/.so；library 角色，M5）")
    println("  --prep-only      只做头部识别并打印结果")
    println("  --config <f>     构建配置文件（默认查当前目录 config.data.tie）")
    println("  --profile <p>    构建 profile（dev/release，覆盖配置顶层 profile 键）")
    println("  --backend <b>    后端实现选择（win32；其他 port 尚未接入）")
    println("  --tieir-out <f>  编译后序列化 tieir 分发单元（S3.2；.tieir 二进制）")
    println("  --dump-irt <f>   只读 .tieir 并输出可读摘要（S3.2；不编译）")
    println("  --help           显示本帮助")
    return 0
}

// 解析参数：返回 0 正常 / 2 请求帮助 / -1 参数错误。g_* 填充解析结果。
func parse_args() -> i64 {
    var n: i64 = arg_count()
    var i: i64 = 0
    var input_set: bool = false
    while i < n {
        var a = arg_string(i)
        if a == "--help" || a == "-h" {
            return 2
        }
        if a == "--emit-ir" {
            g_emit_ir = true
        } else if a == "--keep-ir" {
            g_keep_ir = true
        } else if a == "--shared" {
            g_shared = true
        } else if a == "--prep-only" {
            g_prep_only = true
        } else if a == "-o" {
            if i + 1 >= n {
                return -1
            }
            g_output = arg_string(i + 1)
            i = i + 1
        } else if a == "-O0" {
            g_opt_level = 0
            g_opt_set = true
        } else if a == "-O1" {
            g_opt_level = 1
            g_opt_set = true
        } else if a == "-O2" {
            g_opt_level = 2
            g_opt_set = true
        } else if a == "-O3" {
            g_opt_level = 3
            g_opt_set = true
        } else if a == "--target" {
            if i + 1 >= n {
                return -1
            }
            g_target = arg_string(i + 1)
            i = i + 1
        } else if a == "--config" {
            if i + 1 >= n {
                return -1
            }
            g_config_path = arg_string(i + 1)
            i = i + 1
        } else if a == "--profile" {
            if i + 1 >= n {
                return -1
            }
            g_cli_profile = arg_string(i + 1)
            i = i + 1
        } else if a == "--backend" {
            if i + 1 >= n {
                return -1
            }
            g_backend_cli = arg_string(i + 1)
            i = i + 1
        } else if a == "--tieir-out" {
            if i + 1 >= n {
                return -1
            }
            g_tieir_out = arg_string(i + 1)
            i = i + 1
        } else if a == "--dump-irt" {
            if i + 1 >= n {
                return -1
            }
            g_dump_irt = arg_string(i + 1)
            i = i + 1
        } else if str_len(a) > 1 && str_char(a, 0) == "-" {
            // 未知选项
            return -1
        } else {
            if input_set {
                return -1
            }
            g_input = a
            input_set = true
        }
        i = i + 1
    }
    if !input_set {
        return -1
    }
    return 0
}

// 目标三元组别名归一化（对齐 Rust normalize_target）：已知别名映射，
// 未知名称原样透传。
func normalize_target(t: string) -> string {
    if t == "win-x64" || t == "windows-x64" {
        return "x86_64-pc-windows-msvc"
    }
    if t == "win-x86" || t == "windows-x86" {
        return "i686-pc-windows-msvc"
    }
    if t == "win-arm64" || t == "windows-arm64" {
        return "aarch64-pc-windows-msvc"
    }
    if t == "linux-x64" || t == "linux-x86_64" {
        return "x86_64-unknown-linux-gnu"
    }
    if t == "linux-arm64" {
        return "aarch64-unknown-linux-gnu"
    }
    if t == "macos-x64" || t == "macos-x86_64" {
        return "x86_64-apple-darwin"
    }
    if t == "macos-arm64" {
        return "aarch64-apple-darwin"
    }
    return t
}

// ==================== 头部扫描（文件类型声明） ====================

// 从源码头部识别文件类型声明（新体系）：
//   `type tie` → 类型 type；`type tie<X>` → X（X ∈ script/data/ui/class/logic/port/db/ir/zd）。
//   ir 角色：直接生成 LLVM IR（.ll），不继续 opt/clang 链接（等价 --emit-ir）。
// 头部区 = 文件最前连续行（允许空行），遇第一个非空非声明行即结束；
// 只扫前 20 行。无声明默认 logic（可执行）。
// 旧 `// tie:xxx` 注释指令体系已彻底移除：该类行只是普通注释，不再识别
// 角色与 opt/target 选项（opt 仅 CLI 默认 O2；target 仅 CLI）。
// 返回 0 成功；声明语法非法返回 -1（由 main 报错退出）。
func scan_header(src: string) -> i64 {
    var lines = split_lines(src)
    var n: i64 = len(lines)
    var i: i64 = 0
    g_role = "logic"
    g_role_param = ""
    g_role_mods = table_new_string()
    while i < n && i < 20 {
        var ln = trim(lines[i])
        if str_len(ln) == 0 {
            i = i + 1
            continue
        }
        if has_prefix(str.clone(ln), "type tie") {
            var rest = trim(str.slice(ln, 8, str_len(ln)))
            if str_len(rest) == 0 {
                g_role = "type"
                return 0
            }
            // 期望 `<X>` 形式，且无尾随内容
            if str_len(rest) >= 3 && str_char(rest, 0) == "<" && str_char(rest, str_len(rest) - 1) == ">" {
                var sub = trim(slice(str.clone(rest), 1, str_len(rest) - 1))
                // S1.4 R2/R3：多角色解析（基础[:参数][, 修饰...]）
                if parse_role_decl(sub) == 0 {
                    g_role = g_role_base
                    return 0
                }
                println("文件类型声明错误: " + g_role_err + "（第 " + to_string(i + 1) + " 行）")
                return -1
            }
            println("文件类型声明错误: 非法声明 '" + ln + "'（第 " + to_string(i + 1) + " 行），应为 `type tie` 或 `type tie<类型>`")
            return -1
        }
        // 第一个非空非声明行：头部区结束
        break
    }
    return 0
}

// ---------- S1.4 R2/R3 多角色解析（driver 侧，与 prep/core.tie 同规则） ----------
var g_role_param: string = "";           // 基础角色参数（如 db:vector 的 vector）
var g_role_mods: table<string>;          // 修饰角色（unsafe/owned/embedded）
var g_role_base: string = "";            // 解析中间结果：基础角色
var g_role_err: string = "";             // 解析错误消息（空 = 成功）

// 修饰角色白名单
func is_valid_mod_role(name: string) -> bool {
    if name == "unsafe" {
        return true
    }
    if name == "owned" {
        return true
    }
    if name == "embedded" {
        return true
    }
    return false
}

// 参数白名单
func is_valid_role_param(base: string, param: string) -> bool {
    if base == "ui" {
        if param == "window" || param == "web" || param == "embedded" {
            return true
        }
    }
    if base == "db" {
        if param == "schema" || param == "seed" || param == "vector" {
            return true
        }
    }
    if base == "data" {
        if param == "config" || param == "asset" {
            return true
        }
    }
    return false
}

// 基础角色白名单
func is_valid_base_role(name: string) -> bool {
    if name == "type" || name == "script" || name == "data" || name == "ui" ||
        name == "class" || name == "logic" || name == "port" || name == "db" ||
        name == "ir" || name == "zd" || name == "tieir" || name == "test" || name == "bench" {
        return true
    }
    return false
}

// 按逗号/冒号拆分角色声明 `db:vector, unsafe` → 全局槽。返回 0 成功。
func parse_role_decl(sub: string) -> i64 {
    g_role_base = ""
    g_role_param = ""
    g_role_mods = table_new_string()
    g_role_err = ""
    var parts = split_char(sub, ",")
    var k: i64 = 0
    var base_set = false
    while k < len(parts) {
        var item = trim(parts[k])
        if str_len(item) == 0 {
            k = k + 1
            continue
        }
        var colon = find_char(str.clone(item), ":")
        if colon >= 0 {
            var base = trim(slice(str.clone(item), 0, colon))
            var param = trim(slice(str.clone(item), colon + 1, str_len(item)))
            if base_set {
                g_role_err = "基础角色重复: '" + item + "'"
                return -1
            }
            if !is_valid_base_role(str.clone(base)) {
                g_role_err = "未知基础角色 '" + base + "'"
                return -1
            }
            if !is_valid_role_param(str.clone(base), str.clone(param)) {
                g_role_err = "角色 '" + base + "' 不支持参数 '" + param + "'"
                return -1
            }
            g_role_base = base
            g_role_param = param
            base_set = true
        } else if is_valid_mod_role(str.clone(item)) {
            var j: i64 = 0
            while j < len(g_role_mods) {
                if g_role_mods[j] == item {
                    g_role_err = "修饰角色重复: '" + item + "'"
                    return -1
                }
                j = j + 1
            }
            table_push(g_role_mods, item)
        } else if is_valid_base_role(str.clone(item)) {
            if base_set {
                g_role_err = "基础角色重复: '" + item + "'"
                return -1
            }
            g_role_base = item
            base_set = true
        } else {
            g_role_err = "未知角色 '" + item + "'（基础: script/data/ui/class/logic/port/db/ir/zd/tieir/test/bench；修饰: unsafe/owned/embedded）"
            return -1
        }
        k = k + 1
    }
    if !base_set {
        g_role_base = "logic"
    }
    return 0
}

// 按字符拆分（码点级；driver 自写工具）
func split_char(s: string, sep: string) -> table<string> {
    var out = table_new_string()
    var n = str_len(s)
    var start: i64 = 0
    var i: i64 = 0
    while i < n {
        if str_char(s, i) == sep {
            table_push(out, slice(s, start, i))
            start = i + 1
        }
        i = i + 1
    }
    table_push(out, slice(s, start, n))
    return out
}

// 剥离头部区的文件类型声明行（`type tie` / `type tie<X>`），返回清理后源码。
// 新声明是真语法行，必须从正文中移除（旧 `// tie:` 是注释由 lexer 跳过，无需剥离）。
// 头部区 = 文件最前连续行（允许空行），遇第一个非空非声明行即停止；
// 声明行之外的行（含空行/注释/缩进）原样保留，\n 重连。
func strip_type_header(src: string) -> string {
    var lines = split_lines(src)
    var n: i64 = len(lines)
    var out: string = ""
    var in_header = true
    var i: i64 = 0
    while i < n {
        var ln = lines[i]
        var t = trim(str.clone(ln))
        if in_header {
            if str_len(t) == 0 {
                // 头部区空行：保留
            } else if has_prefix(t, "type tie") {
                // 声明行：剥离
                i = i + 1
                continue
            } else {
                in_header = false
            }
        }
        if str_len(out) > 0 {
            out = out + "\n"
        }
        out = out + ln
        i = i + 1
    }
    return out
}

// ==================== 前端 ====================

// 前端：词法/语法（parser.parse_ast，AST 留内存）→ 语义+import（semantic.check_ast）。
// 返回 0 成功；失败打印错误并返回 -1。
// 阶段计时（TIEC_TIME=1 时输出）：词法/语法与语义分开计量。
var g_t_parse: i64 = 0;   // parse_ast 耗时（ms）
var g_t_sem: i64 = 0;     // check_ast 耗时（ms）
func frontend(src: string, base_dir: string) -> i64 {
    // T5.3 内存版：parse_ast 返回 0/-1（成功时 AST 在 ast 节点池内存），
    // 失败时由 parser.ast_err_protocol() 组装与 parse_src 相同的 "ERR:line col msg"
    unsafe {
        var t0 = clock()
    }
    var prc = parser.parse_ast(src)
    unsafe {
        var t0e = clock()
    }
    g_t_parse = t0e - t0
    if prc < 0 {
        println("语法错误 " + err_span(parser.ast_err_protocol()))
        return -1
    }
    unsafe {
        var t1 = clock()
    }
    var sem = semantic.check_ast(base_dir)
    unsafe {
        var t1e = clock()
    }
    g_t_sem = t1e - t1
    if has_prefix(str.clone(sem), "ERR:") {
        println("语义错误 " + err_span(sem))
        return -1
    }
    return 0
}

// ERR 协议文本 → "行:列: 消息"（协议 ERR:<line> <col> <msg>）。
func err_span(proto: string) -> string {
    var rest = slice(str.clone(proto), 4, str_len(proto))
    var sp1 = find_char(str.clone(rest), " ")
    if sp1 < 0 {
        return proto
    }
    var sp2: i64 = -1
    var i: i64 = sp1 + 1
    while i < str_len(rest) {
        if str_char(rest, i) == " " {
            sp2 = i
            break
        }
        i = i + 1
    }
    if sp2 < 0 {
        return rest
    }
    return "@" + slice(str.clone(rest), 0, sp1) + ":" + slice(str.clone(rest), sp1 + 1, sp2) + ": " +
        slice(str.clone(rest), sp2 + 1, str_len(rest))
}

// ==================== 主流程 ====================

// 入口：解析参数 → 读文件 → 头部扫描 → 角色分派。返回退出码。
func main() -> i64 {
    var pr = parse_args()
    if pr == 2 {
        return usage()
    }
    if pr < 0 {
        println("参数错误。输入 tiec --help 查看用法。")
        return 2
    }
    // S3.2：--dump-irt 短路——只读 .tieir 输出可读摘要（不编译）
    if str_len(g_dump_irt) > 0 {
        var drc = tieir.read(g_dump_irt)
        if drc != 0 {
            println("tieir 读取失败: " + tieir.err_msg())
            return 1
        }
        print(tieir.dump_text())
        return 0
    }
    // 读源码
    if !file_exists(g_input) {
        println("读取源码失败: " + g_input)
        return 1
    }
    // zd 二进制预判：xxx.zd.tie 是二进制文件（压缩的 tie:data），人类不可读，
    // 必须在 file_read（文本读取）之前按文件名后缀预判并直接短接——二进制
    // 内容文本解码必然失败/乱码。zd 文件由 tiedb compact/decompress 原语处理。
    var zd_len: i64 = str_len(g_input)
    if zd_len >= 7 && slice(str.clone(g_input), zd_len - 7, zd_len) == ".zd.tie" {
        println("[预处理] 识别为 zd 压缩数据文件（头: " + g_input + "），tie:data 压缩格式，用 tiedb compact/decompress 处理")
        return 0
    }
    var src = file_read(g_input)
    if str_len(src) == 0 {
        println("读取源码失败: " + g_input)
        return 1
    }
    // 头部扫描（文件类型声明 / 角色）
    if scan_header(str.clone(src)) < 0 {
        return 1
    }
    // 剥离头部声明行（`type tie` / `type tie<X>` 是真语法行，须从正文移除；
    // 旧 `// tie:` 是注释由 lexer 跳过，无需处理）
    var clean = strip_type_header(src)
    // S1.4 R3 文件名-头部一致性检查（F1）：`xxx.<基础>[-<参数>][-<修饰>...].tie`
    // 与头部声明不一致 = 编译错误（单一真相，升级自现状警告）。
    var fname = file_name_of(str.clone(g_input))
    var name_role = role_from_filename(fname)
    if str_len(name_role) > 0 {
        var mismatch: string = ""
        if name_role != g_role {
            mismatch = "基础角色不一致: 文件名 '" + name_role + "' vs 头部 '" + g_role + "'"
        } else if str_len(g_name_param) > 0 && g_name_param != g_role_param {
            mismatch = "角色参数不一致: 文件名 '" + g_name_param + "' vs 头部 '" + g_role_param + "'"
        } else {
            // 修饰角色集合比较（顺序无关）
            var k2: i64 = 0
            while k2 < len(g_name_mods) {
                var found2 = false
                var j2: i64 = 0
                while j2 < len(g_role_mods) {
                    if g_role_mods[j2] == g_name_mods[k2] {
                        found2 = true
                        break
                    }
                    j2 = j2 + 1
                }
                if !found2 {
                    mismatch = "修饰角色不一致: 文件名含 '" + g_name_mods[k2] + "'，头部未声明"
                    break
                }
                k2 = k2 + 1
            }
        }
        if str_len(mismatch) > 0 {
            println("错误: 文件 " + g_input + " 名称声明与头部声明不一致——" + mismatch)
            println("（R3 单一真相原则：文件名与头部都是角色声明源，不一致 = 编译错误）")
            return 1
        }
    }
    // S1.2 文件级 unsafe 角色（type tie<..., unsafe>）：整文件 unsafe 上下文
    var k3: i64 = 0
    while k3 < len(g_role_mods) {
        if g_role_mods[k3] == "unsafe" {
            g_unsafe_depth = g_unsafe_depth + 1
            break
        }
        k3 = k3 + 1
    }
    if g_prep_only {
        println("[预处理] 识别为 " + g_role + " 文件（头: " + g_input + "）")
        return 0
    }
    // 角色分派：data/ui/db/port → 未实现提示；logic/script → 编译可执行；
    // class/type → 编译静态库
    if g_role == "data" {
        println("[预处理] 识别为 data 数据交换文件（头: " + g_input + "），已转交数据解析工具链 —— v0.1 数据交换工具链尚未实现")
        return 0
    }
    if g_role == "ui" {
        println("[预处理] 识别为 ui 界面文件（头: " + g_input + "），已转交 UI 工具链 —— v0.1 UI 工具链尚未实现")
        return 0
    }
    if g_role == "db" {
        println("[预处理] 识别为 db 数据库文件（头: " + g_input + "），已转交数据库工具链 —— v0.1 数据库工具链尚未实现")
        return 0
    }
    if g_role == "port" {
        println("[预处理] 识别为 port 端口文件（头: " + g_input + "），已转交端口工具链 —— v0.1 端口工具链尚未实现")
        return 0
    }
    // zd 角色：压缩数据文件（tie:data 二进制变体），不编译。正常流程下已按
    // 文件名 `.zd.tie` 预判短接（file_read 之前），此分支兜底头部
    // `type tie<zd>` 声明（非 .zd.tie 文件名）的场景。
    if g_role == "zd" {
        println("[预处理] 识别为 zd 压缩数据文件（头: " + g_input + "），已转交 tiedb 压缩工具链 —— v0.1 尚未实现")
        return 0
    }
    // ir 角色：直接生成 LLVM IR（.ll），不继续 opt/clang 链接（等价 --emit-ir，
    // 但由角色触发而非 CLI 选项）。复用编译工具链 + g_emit_ir 短路。
    if g_role == "ir" {
        g_emit_ir = true
    }
    // M5 动态库模式（dev33 批次 12）：--shared 或输出扩展名 .dll/.so → 动态库。
    // 要求 library 角色（class/type，无 main）；通知 irgen 标记导出面（dllexport）
    // 并做边界检查（表/struct 不跨库）。
    if detect_shared_mode() {
        if g_role != "class" && g_role != "type" {
            println("错误: 动态库模式（--shared 或输出扩展名 .dll/.so）要求 library 角色（type tie<class> / type tie<type>）")
            return 1
        }
        // 置位 g_shared（.dll/.so 扩展名触发的动态库模式也要让后续分派识别）
        g_shared = true
        irgen.set_dynlib(true)
    }
    // S3.1 构建配置：分层合并（内置默认 < 用户 config < 项目 config < profile < CLI）
    g_cfg_root = config.load_merge(g_config_path, g_cli_profile)
    if g_cfg_root < 0 {
        println("构建配置加载失败: " + config.err_msg())
        return 1
    }
    // CLI 显式参数 → 覆盖合并结果（最高优先；CLI 是显式意图，不警告）
    if g_opt_set {
        g_cfg_root = config.apply_cli(g_cfg_root, "opt", to_string(g_opt_level))
    }
    if str_len(g_target) > 0 {
        g_cfg_root = config.apply_cli(g_cfg_root, "target", g_target)
    }
    // --backend 实现选择（P4b 验收）：CLI 显式 > 配置 tiec.backend
    var backend = g_backend_cli
    if str_len(backend) == 0 {
        backend = config.get_str(g_cfg_root, "tiec.backend")
    }
    if str_len(backend) > 0 && backend != "win32" {
        println("[后端] tiec.backend=" + backend + "：该 port 实现尚未接入（win32/LLVM 工具链为当前唯一后端）")
        return 1
    }
    return compile_program(clean)
}

// 编译工具链（logic / library）：前端 → 中端 → 后端。
// 阶段计时（TIEC_TIME=1）：irgen / emit / 写盘分开计量。
var g_t_irgen: i64 = 0;   // irgen.tig_ast 耗时（ms）
var g_t_emit: i64 = 0;    // llvmgen.emit 耗时（ms）
var g_t_write: i64 = 0;   // file_write 耗时（ms）
func compile_program(src: string) -> i64 {
    // base_dir：输入路径的目录（import 展开需要）；\\ 归一化为 /
    var base_dir = dir_of(str.clone(g_input))
    // 前端
    if frontend(src, base_dir) < 0 {
        return 1
    }
    // 中端：AST → tie-IR → .ll 文本
    // frontend() 已执行完整前端（parse_ast + check_ast），sstate 全局表/
    // g_extra_tops/node_types 均已就绪——直接 tig_ast() 复用，避免前端重复
    // 执行（tig_src 内部会再 parse + check_impl 一遍，行为等价但浪费一倍）
    // 任务17：asm! 平台条件编译注入编译目标（CLI --target > 配置 target >
    // 本机默认 x86_64-pc-windows-msvc）。
    var asm_target = normalize_target(g_target)
    if str_len(asm_target) == 0 && g_cfg_root >= 0 {
        var cfg_target = config.get_str(g_cfg_root, "target")
        if str_len(cfg_target) > 0 {
            asm_target = normalize_target(cfg_target)
        }
    }
    if str_len(asm_target) == 0 {
        asm_target = "x86_64-pc-windows-msvc"  // 本机默认（Windows x64 开发机）
    }
    irgen.set_target(asm_target)
    unsafe {
        var t2 = clock()
    }
    var rc = irgen.tig_ast()
    unsafe {
        var t2e = clock()
    }
    g_t_irgen = t2e - t2
    if rc < 0 {
        var msg = sm_err_msg
        if str_len(msg) == 0 {
            msg = "irgen 最小集之外的语句（尚未支持）"
        }
        println("IR 生成失败: " + msg)
        return 1
    }
    // S3.2：--tieir-out 序列化分发单元（IR 主体 + 元信息侧表；与 .ll 生成
    // 并行路径，不影响既有编译流程）
    if str_len(g_tieir_out) > 0 {
        if !tieir.write(g_tieir_out) {
            println("tieir 序列化失败: " + tieir.err_msg())
            return 1
        }
        println("已生成 tieir: " + g_tieir_out)
    }
    unsafe {
        var t3 = clock()
    }
    var ll_text = llvmgen.emit()
    unsafe {
        var t3e = clock()
    }
    g_t_emit = t3e - t3
    // IR 文件路径：--emit-ir → -o 或 输入.ll；否则中间文件（输出基准）
    var ir_path = replace_ext(g_input, "ll")
    if str_len(g_output) > 0 {
        ir_path = replace_ext(g_output, "ll")
    }
    unsafe {
        var t4 = clock()
    }
    if !file_write(ir_path, ll_text) {
        println("文件操作失败: 写 IR 文件 " + ir_path)
        return 1
    }
    unsafe {
        var t4e = clock()
    }
    g_t_write = t4e - t4
    if g_emit_ir {
        // 阶段计时报告（TIEC_TIME=1）：parse/sem/irgen/emit/write 五段
        if get_env("TIEC_TIME") == "1" {
            println("[time] parse=" + to_string(g_t_parse) + "ms sem=" + to_string(g_t_sem) +
                "ms irgen=" + to_string(g_t_irgen) + "ms emit=" + to_string(g_t_emit) +
                "ms write=" + to_string(g_t_write) + "ms")
        }
        println("已生成 LLVM IR: " + ir_path)
        return 0
    }
    // 后端：opt → 链接/归档
    var opt_path = replace_ext(str.clone(ir_path), "opt.ll")
    // S3.1：opt 优先级 CLI 显式 -O > 配置（含 profile 激活）> 默认 2
    var level = g_opt_level
    if !g_opt_set {
        level = 2
        if g_cfg_root >= 0 {
            var cfg_opt = config.get_int(g_cfg_root, "opt")
            if cfg_opt >= 1 && cfg_opt <= 3 {
                level = cfg_opt
            }
        }
    }
    var orc = tc.opt(ir_path, opt_path, level)
    if orc != 0 {
        println("[中间优化] " + tc_err_msg)
        return 1
    }
    // S3.1：target 优先级 CLI --target > 配置 target > 空（本机）
    var target = normalize_target(g_target)
    if str_len(target) == 0 && g_cfg_root >= 0 {
        target = normalize_target(config.get_str(g_cfg_root, "target"))
    }
    if g_role == "class" || g_role == "type" {
        // M5 动态库模式（--shared / 输出 .dll/.so）：走共享库链接（非静态库 .a）
        if g_shared {
            return compile_shared(ir_path, opt_path, target)
        }
        return compile_library(ir_path, opt_path, target)
    }
    return compile_logic(ir_path, opt_path, target)
}

// logic：clang 链接可执行文件；清理中间文件（除非 --keep-ir）。
// 程序用了 tie-interp 库桥（file_*/regex_*/exec_output 等，irgen 置 g_used_interp）
// → 链接 tie_interp.lib（Rust 桥）。exec_code/get_env/time_now 已内联到 libc，
// std/runtime.a 退役——纯程序（无桥）不链接任何运行时库，零依赖。
func compile_logic(ir_path: string, opt_path: string, target: string) -> i64 {
    var exe_path = g_output
    if str_len(exe_path) == 0 {
        exe_path = replace_ext(g_input, "exe")
    }
    // need_interp = g_used_interp：有 Rust 桥才链 tie_interp.lib
    var bres = tc.link_exe(opt_path, exe_path, target, g_used_interp)
    if bres != 0 {
        println("[后端] " + tc_err_msg)
        return 1
    }
    cleanup(ir_path, opt_path)
    println("编译成功: " + exe_path)
    return 0
}

// library：clang -c 目标文件 + llvm-ar 打包静态库；清理中间文件。
func compile_library(ir_path: string, opt_path: string, target: string) -> i64 {
    var lib_path = g_output
    if str_len(lib_path) == 0 {
        lib_path = replace_ext(g_input, "a")
    }
    var obj_path = replace_ext(g_input, "o")
    var crc = tc.compile_object(opt_path, obj_path, target)
    if crc != 0 {
        println("[后端] " + tc_err_msg)
        return 1
    }
    var arc = tc.archive(obj_path, lib_path)
    if arc != 0 {
        println("[后端] " + tc_err_msg)
        return 1
    }
    cleanup(ir_path, opt_path)
    file_delete(obj_path)
    println("库编译成功: " + lib_path)
    return 0
}

// 动态库：clang -shared 链接（Windows .dll / Linux .so，dllexport 导出面由
// irgen 标记）；清理中间文件（除非 --keep-ir）。
func compile_shared(ir_path: string, opt_path: string, target: string) -> i64 {
    var dll_path = g_output
    if str_len(dll_path) == 0 {
        // 默认扩展名：linux 目标 → .so；其余（win/mac）→ .dll
        if is_linux_target(target) {
            dll_path = replace_ext(g_input, "so")
        } else {
            dll_path = replace_ext(g_input, "dll")
        }
    }
    var src = tc.link_shared(opt_path, dll_path, target, g_used_interp)
    if src != 0 {
        println("[后端] " + tc_err_msg)
        return 1
    }
    cleanup(ir_path, opt_path)
    println("动态库编译成功: " + dll_path)
    return 0
}

// 清理中间 .ll / .opt.ll（--keep-ir 时保留）。
func cleanup(ir_path: string, opt_path: string) {
    if !g_keep_ir {
        file_delete(ir_path)
        file_delete(opt_path)
    }
}

// ==================== 字符串/路径工具（零依赖） ====================

// 按 \n 拆行（去行尾 \r）。
// 性能重写（O(n)）：旧实现 line + c 拼接（每行 O(len²)）× str_char(s,i)
// 从头扫（O(i)）三重平方。新实现字节级扫描（\n/\r 为 ASCII 单字节）+
// StringBuilder 累积，语义不变（连续 \n 产空行；尾部无 \n 的末行保留）。
func split_lines(s: string) -> table<string> {
    var rows = table_new_string()
    var n: i64 = len(s)
    var i: i64 = 0
    var sb = string_builder()
    while i < n {
        var b = str_byte(s, i)
        if b == 10 {
            // \n：行结束（每行新建 sb——自举兼容旧原语集；sb_reset 复用留待
            // 编译器自身认识该原语后启用）
            table_push(rows, sb_build(sb))
            sb = string_builder()
        } else if b != 13 {
            // 非 \r：追加字节（二进制安全）
            sb_append_byte(sb, b)
        }
        i = i + 1
    }
    // 尾部无 \n 的末行（非空才保留——与原实现一致）
    var tail = sb_build(sb)
    if tail != "" {
        table_push(rows, tail)
    }
    return rows
}

// 判断 s 是否以 prefix 开头。
func has_prefix(s: string, prefix: string) -> bool {
    var n: i64 = str_len(s)
    var m: i64 = str_len(prefix)
    if n < m {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_char(s, i) != str_char(prefix, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 找字符串中首个 ch 的位置；未找到 -1。
func find_char(s: string, ch: string) -> i64 {
    var n: i64 = str_len(s)
    var i: i64 = 0
    while i < n {
        if str_char(s, i) == ch {
            return i
        }
        i = i + 1
    }
    return -1
}

// 取字符串 [start, end) 子串（码点级）。
func slice(s: string, start: i64, end: i64) -> string {
    var out: string = ""
    var i: i64 = start
    while i < end {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

// 去除字符串首尾空白（空格/制表）。
func trim(s: string) -> string {
    var n: i64 = str_len(s)
    var start: i64 = 0
    var end: i64 = n
    while start < end && (str_char(s, start) == " " || str_char(s, start) == "\t") {
        start = start + 1
    }
    while end > start && (str_char(s, end - 1) == " " || str_char(s, end - 1) == "\t") {
        end = end - 1
    }
    return slice(s, start, end)
}

// 取路径的目录部分（含末尾分隔符；无分隔符返回空串）；\ 与 / 都识别，
// 输出归一化为 /（import 展开需要）。
func dir_of(path: string) -> string {
    var n: i64 = str_len(path)
    var last: i64 = -1
    var i: i64 = 0
    while i < n {
        var c = str_char(path, i)
        if c == "/" || c == "\\" {
            last = i
        }
        i = i + 1
    }
    if last < 0 {
        return ""
    }
    var d = slice(path, 0, last + 1)
    var out: string = ""
    var j: i64 = 0
    while j < str_len(d) {
        var c2 = str_char(d, j)
        if c2 == "\\" {
            out = out + "/"
        } else {
            out = out + c2
        }
        j = j + 1
    }
    return out
}

// 替换路径扩展名（basename 最后一个 . 后替换；无 . 直接追加）。
// 例：examples/hello.tie + "exe" → examples/hello.exe；a.opt.ll + "ll" → a.opt.ll。
func replace_ext(path: string, new_ext: string) -> string {
    var n: i64 = str_len(path)
    var last_dot: i64 = -1
    var i: i64 = 0
    while i < n {
        if str_char(path, i) == "." {
            last_dot = i
        }
        i = i + 1
    }
    var base: string = str.clone(path)
    if last_dot > 0 {
        base = slice(path, 0, last_dot)
    }
    return base + "." + new_ext
}

// 取路径的文件名部分（最后一个 / 或 \ 之后；无分隔符返回原串）。
func file_name_of(path: string) -> string {
    var n: i64 = str_len(path)
    var last: i64 = -1
    var i: i64 = 0
    while i < n {
        var c = str_char(path, i)
        if c == "/" || c == "\\" {
            last = i
        }
        i = i + 1
    }
    if last < 0 {
        return path
    }
    return slice(path, last + 1, n)
}

// 从文件名推断角色（S1.4 F1 连字符格式）：`xxx.<基础>[-<参数>][-<修饰>...].tie`
// → 基础角色（分派用）。参数/修饰写入 g_name_param / g_name_mods（一致性
// 检查用）。无角色段返回空串。
var g_name_param: string = "";
var g_name_mods: table<string>;
func role_from_filename(name: string) -> string {
    g_name_param = ""
    g_name_mods = table_new_string()
    var n: i64 = str_len(name)
    var first_dot: i64 = -1
    var last_dot: i64 = -1
    var i: i64 = 0
    while i < n {
        if str_char(name, i) == "." {
            if first_dot < 0 {
                first_dot = i
            }
            last_dot = i
        }
        i = i + 1
    }
    // 需要至少两段（首点存在且与末点不同）：xxx.<角色>.tie
    if first_dot < 0 || last_dot <= first_dot {
        return ""
    }
    if slice(str.clone(name), last_dot + 1, n) != "tie" {
        return ""
    }
    var role = slice(name, first_dot + 1, last_dot)
    // F1 连字符拆分：第一段 = 基础角色；后续段 = 参数（紧跟基础）或修饰
    var segs = split_char(role, "-")
    var base = segs[0]
    if !is_valid_base_role(str.clone(base)) {
        // 非角色名（如 schema.db.tie 的 db 在第二段）：按现状约定多段解析——
        // 从后往前找已知角色段
        var k = len(segs) - 1
        while k >= 0 {
            if is_valid_base_role(segs[k]) {
                base = segs[k]
                return base
            }
            k = k - 1
        }
        return ""
    }
    // 参数：第二个连字符段命中参数白名单 → g_name_param；其余段修饰
    var seg_i: i64 = 1
    while seg_i < len(segs) {
        var seg = segs[seg_i]
        if str_len(g_name_param) == 0 && is_valid_role_param(str.clone(base), str.clone(seg)) {
            g_name_param = seg
        } else if is_valid_mod_role(str.clone(seg)) {
            table_push(g_name_mods, seg)
        } else {
            // 未知段：非角色文件名（默认逻辑）
            g_name_param = ""
            g_name_mods = table_new_string()
            return ""
        }
        seg_i = seg_i + 1
    }
    return base
}

// ==================== M5 动态库模式工具（dev33 批次 12） ====================

// 动态库模式检测：--shared 显式开关，或输出路径扩展名为 .dll / .so（大小写不敏感）。
func detect_shared_mode() -> bool {
    if g_shared {
        return true
    }
    if str_len(g_output) == 0 {
        return false
    }
    return has_dll_so_ext(g_output)
}

// 路径是否以 .dll（4 字符）/ .so（3 字符）结尾（大小写不敏感）。
func has_dll_so_ext(path: string) -> bool {
    var n: i64 = str_len(path)
    if n >= 4 {
        var tail4 = slice(str.clone(path), n - 4, n)
        if tail4 == ".dll" || tail4 == ".DLL" {
            return true
        }
    }
    if n >= 3 {
        var tail3 = slice(str.clone(path), n - 3, n)
        if tail3 == ".so" || tail3 == ".SO" {
            return true
        }
    }
    return false
}

// 目标三元组是否 Linux（.so 默认扩展名分派用）。
func is_linux_target(target: string) -> bool {
    var n: i64 = str_len(target)
    var i: i64 = 0
    while i <= n - 5 {
        if slice(str.clone(target), i, i + 5) == "linux" {
            return true
        }
        i = i + 1
    }
    return false
}
