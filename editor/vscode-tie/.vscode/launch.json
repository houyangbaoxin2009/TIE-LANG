{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "扩展开发宿主",
      "type": "extensionHost",
      "request": "launch",
      // 加载本目录为待开发扩展
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      // 断点映射到打包产物 out/extension.js
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      // 启动前先构建（tsc 类型检查 + esbuild 打包）
      "preLaunchTask": "npm: compile"
    }
  ]
}
