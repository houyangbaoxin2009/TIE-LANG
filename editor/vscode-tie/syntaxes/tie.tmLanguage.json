{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "tie",
  "scopeName": "source.tie",
  "patterns": [
    { "include": "#comments" },
    { "include": "#filetype" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#namespaces" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.tie", "match": "//.*$" },
        {
          "name": "comment.block.tie",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "filetype": {
      "patterns": [
        {
          "name": "meta.filetype-declaration.tie",
          "match": "^\\s*(type)\\s+(tie)(?:<([a-zA-Z_][a-zA-Z0-9_-]*)>)?",
          "captures": {
            "1": { "name": "keyword.control.directive.tie" },
            "2": { "name": "storage.type.tie" },
            "3": { "name": "entity.name.type.tie" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.tie", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.tie", "match": "\\\\." }] },
        { "name": "string.quoted.single.tie", "begin": "'", "end": "'" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.tie", "match": "\\b(0[xX][0-9a-fA-F_]+|\\d[\\d_]*(\\.[\\d_]+)?)\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tie",
          "match": "\\b(func|var|const|if|else|while|for|return|import|struct|extends|switch|case|default|in|namespace|pub|using|when|type)\\b"
        },
        { "name": "constant.language.tie", "match": "\\b(true|false)\\b" },
        {
          "name": "keyword.operator.tie",
          "match": "::|\\+\\+|--|<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<|>>|<=|>=|==|!=|&&|\\|\\||->|\\.\\.|[+\\-*/%&|^!<>=?:]"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.tie",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|char|string|void|code|num|text|misc|table)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.tie",
          "match": "\\b(println|print|len|read_line|eval)\\b"
        },
        {
          "name": "entity.name.function.tie",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\s*(?=\\()"
        }
      ]
    },
    "namespaces": {
      "patterns": [
        {
          "name": "support.namespace.tie",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\s*(?=\\.)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        { "name": "variable.other.tie", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b" }
      ]
    }
  }
}
