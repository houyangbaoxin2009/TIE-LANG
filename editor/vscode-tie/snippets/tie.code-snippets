{
  "func": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:params}) -> ${3:ret} {",
      "\t${0:// 函数体}",
      "}"
    ],
    "description": "定义函数（带返回类型）"
  },
  "func-void": {
    "prefix": "func",
    "body": [
      "func ${1:name}() {",
      "\t${0:// 函数体}",
      "}"
    ],
    "description": "定义函数（无返回类型）"
  },
  "class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "\tvar ${2:field}: ${3:i64}",
      "",
      "\tmethod ${4:methodName}(${5:params}) -> ${6:ret} {",
      "\t\t${0:// 方法体}",
      "\t}",
      "}"
    ],
    "description": "定义类（含字段与方法）"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:条件} {",
      "\t${0:// 分支体}",
      "}"
    ],
    "description": "if 分支"
  },
  "ifelse": {
    "prefix": "if",
    "body": [
      "if ${1:条件} {",
      "\t${2:// 真分支}",
      "} else {",
      "\t${0:// 假分支}",
      "}"
    ],
    "description": "if / else 双分支"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:0}..${3:10} {",
      "\t${0:// 循环体}",
      "}"
    ],
    "description": "for 范围遍历（含 .. 范围运算符）"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while ${1:条件} {",
      "\t${0:// 循环体}",
      "}"
    ],
    "description": "while 循环"
  },
  "switch": {
    "prefix": "switch",
    "body": [
      "switch ${1:值} {",
      "\tcase ${2:1}:",
      "\t\t${3:// 分支体}",
      "\tdefault:",
      "\t\t${0:// 默认分支}",
      "}"
    ],
    "description": "switch 多分支选择"
  },
  "method": {
    "prefix": "method",
    "body": [
      "method ${1:name}(${2:params}) -> ${3:ret} {",
      "\t${0:// 方法体}",
      "}"
    ],
    "description": "定义实例方法（可访问 this）"
  },
  "static-method": {
    "prefix": "static",
    "body": [
      "static method ${1:name}(${2:params}) -> ${3:ret} {",
      "\t${0:// 静态方法体（无 this，通过类名调用）}",
      "}"
    ],
    "description": "定义静态方法"
  },
  "import": {
    "prefix": "import",
    "body": [
      "import \"${1:./lib.tie}\""
    ],
    "description": "导入 tie 库文件"
  },
  "println": {
    "prefix": "println",
    "body": [
      "println(${1:value})"
    ],
    "description": "打印一行输出"
  }
}
