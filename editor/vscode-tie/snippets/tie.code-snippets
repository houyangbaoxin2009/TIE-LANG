{
  "func": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:params}) -> ${3:ret} {",
      "\t${0:// 函数体}",
      "}"
    ],
    "description": "定义函数（带返回类型）"
  },
  "func-void": {
    "prefix": "func",
    "body": [
      "func ${1:name}() {",
      "\t${0:// 函数体}",
      "}"
    ],
    "description": "定义函数（无返回类型）"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\tvar ${2:field}: ${3:i64}",
      "\t${0:// 字段（纯数据，方法见 ns-method 片段）}",
      "}"
    ],
    "description": "定义 struct（纯数据，M2.1.8）"
  },
  "ns-method": {
    "prefix": "ns",
    "body": [
      "namespace ${1:StructName} {",
      "\tpub func ${2:method}(${3:receiver}: ${1:StructName}, ${4:params}) -> ${5:ret} {",
      "\t\t${0:// 方法体（首参 = 接收者，按引用）}",
      "\t}",
      "}"
    ],
    "description": "定义绑定 struct 的命名空间方法函数（pub func）"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:条件} {",
      "\t${0:// 分支体}",
      "}"
    ],
    "description": "if 分支"
  },
  "ifelse": {
    "prefix": "if",
    "body": [
      "if ${1:条件} {",
      "\t${2:// 真分支}",
      "} else {",
      "\t${0:// 假分支}",
      "}"
    ],
    "description": "if / else 双分支"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:0}..${3:10} {",
      "\t${0:// 循环体}",
      "}"
    ],
    "description": "for 范围遍历（含 .. 范围运算符）"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while ${1:条件} {",
      "\t${0:// 循环体}",
      "}"
    ],
    "description": "while 循环"
  },
  "switch": {
    "prefix": "switch",
    "body": [
      "switch ${1:值} {",
      "\tcase ${2:1}:",
      "\t\t${3:// 分支体}",
      "\tdefault:",
      "\t\t${0:// 默认分支}",
      "}"
    ],
    "description": "switch 多分支选择"
  },
  "func-method": {
    "prefix": "func",
    "body": [
      "pub func ${1:name}(${2:receiver}: ${3:Struct}, ${4:params}) -> ${5:ret} {",
      "\t${0:// 方法函数（namespace Struct 内，首参 = 接收者按引用）}",
      "}"
    ],
    "description": "定义命名空间方法函数（pub func，首参接收者）"
  },
  "static-func": {
    "prefix": "static",
    "body": [
      "pub func ${1:name}(${2:params}) -> ${3:ret} {",
      "\t${0:// 静态风格方法函数（无接收者，struct 名调用）}",
      "}"
    ],
    "description": "定义静态风格方法函数（无接收者）"
  },
  "import": {
    "prefix": "import",
    "body": [
      "import \"${1:./lib.tie}\""
    ],
    "description": "导入 tie 库文件"
  },
  "println": {
    "prefix": "println",
    "body": [
      "println(${1:value})"
    ],
    "description": "打印一行输出"
  }
}
