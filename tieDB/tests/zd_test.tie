type tie<logic>

// ============================================================
// tie:zd 二进制序列化格式验收（tieDB/persist/zd.tie，namespace zd）
//
// 覆盖：标量 roundtrip（i64 边界/f64/bool/char/trit/string 含中文）、
// 表（[1,2,3]/["a","b"]/嵌套 [[1,2],[3,4]]）、map 平行表（["a":1,"b":2]）、
// 元组（(1,2,3) 与异构 (1,"a",true)）、record 字段（Protobuf tag）、
// 紧凑性断言、文件 save/load（含中文）。
//
// 注意（主控决策方案 A）：tie 无 map 键枚举 API 且 tiec 下 map 段错误
// （0xC0000005，编译器 bug，连官方 map-bench.tie 都崩），故 map 用平行表
// （键表 table<string> + 值表 table<i64>）表示，语义等价 map 键值对集合；
// tiec 修复 map 后可无缝升级为 map 类型。
// 另：tie 表元素类型编译期固定，decode 返回裸 table 需显式转参数化表后读元素
// （裸 table → table<T> 赋值类型兼容，运行时按实际元素类型读取）。
//
// 期望输出（每行一个断言结果，1=通过 0=失败，最后是汇总）：
//   === i64 roundtrip ===
//   1×9（0/127/128/-1/-33/2^40/-2^40/-2^63+1/2^32）
//   === f64 roundtrip === 1×3（3.14/-0.5/1e300）
//   === bool/char/trit roundtrip === 1×6（true/false/中/-1/0/1）
//   === string roundtrip === 1×5（中文换行/空串/长串>31/emoji/中文")
//   === 紧凑性 === 1×3（encode_i64(5)=1B/encode_bool(true)=1B/encode_string("hi")=3B）
//   === 表 roundtrip === 1×7（[1,2,3] 3 项/["a","b"] 2 项/嵌套 flat 4+lens 2）
//   === map 平行表 roundtrip === 1×6（2 键/2 值/值序）
//   === 元组 roundtrip === 1×7（(1,2,3) 3 项/异构 3 字段）
//   === record 字段 === 1×6（3 字段 tag/值）
//   === 文件 save/load === 1×5（save true/is_zd/字节一致/中文 roundtrip）
//   === 汇总 === total=57 fail=0
import "../persist/zd.tie"
using zd;

// ---- 标量 roundtrip 辅助 ----
func rt_i64(n: i64) -> i64 {
    var enc = encode_i64(n)
    var (v, p) = decode_i64(enc, 0)
    if p < 0 {
        return 0
    }
    if v == n {
        return 1
    }
    return 0
}

func rt_f64(x: f64) -> i64 {
    var enc = encode_f64(x)
    var (v, p) = decode_f64(enc, 0)
    if p < 0 {
        return 0
    }
    if v == x {
        return 1
    }
    return 0
}

func rt_string(s: string) -> i64 {
    var enc = encode_string(s)
    var (v, p) = decode_string(enc, 0)
    if p < 0 {
        return 0
    }
    if v == s {
        return 1
    }
    return 0
}

func main() {
    var total: i64 = 0
    var fail: i64 = 0
    // 辅助：登记断言结果
    // 注：tie 无嵌套函数，用内联计数的宏式写法——每处断言手动累加

    // ==== i64 roundtrip（边界值）====
    println("=== i64 roundtrip ===")
    var r: i64 = rt_i64(0)
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    r = rt_i64(127)
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    r = rt_i64(128)
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    r = rt_i64(-1)
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    r = rt_i64(-33)
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    r = rt_i64(1099511627776)
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    r = rt_i64(-1099511627776)
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    r = rt_i64(-9223372036854775807)
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    r = rt_i64(4294967296)
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)

    // ==== f64 roundtrip ====
    println("=== f64 roundtrip ===")
    r = rt_f64(3.14)
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    r = rt_f64(-0.5)
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    r = rt_f64(parse_float("1e300"))
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)

    // ==== bool / char / trit roundtrip ====
    println("=== bool/char/trit roundtrip ===")
    var eb = encode_bool(true)
    var (bv, bp) = decode_bool(eb, 0)
    r = 0
    if bp > 0 && bv == 1 && len(eb) == 1 {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    eb = encode_bool(false)
    var (bv2, bp2) = decode_bool(eb, 0)
    r = 0
    if bp2 > 0 && bv2 == 0 {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    // char '中'：0xc4 + i32 码点（20013 = 0x4E2D）
    var ec = encode_char("中")
    var (cv, cp) = decode_char(ec, 0)
    r = 0
    if cp > 0 && cv == "中" {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    // trit -1/0/1
    var et = encode_trit(-1)
    var (tv, tp) = decode_trit(et, 0)
    r = 0
    if tp > 0 && tv == -1 {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    et = encode_trit(0)
    var (tv2, tp2) = decode_trit(et, 0)
    r = 0
    if tp2 > 0 && tv2 == 0 {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    et = encode_trit(1)
    var (tv3, tp3) = decode_trit(et, 0)
    r = 0
    if tp3 > 0 && tv3 == 1 {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)

    // ==== string roundtrip（中文/换行/空/长串>31/emoji）====
    println("=== string roundtrip ===")
    r = rt_string("你好，tie！\n第二行")
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    r = rt_string("")
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    // 长串 >31 字节（触发 str8 0xd9 长度前缀）：40 个 'x' 字节 >31
    var long_s: string = ""
    var li: i64 = 0
    while li < 40 {
        long_s = long_s + "x"
        li = li + 1
    }
    r = rt_string(long_s)
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    // emoji（4 字节 UTF-8）
    r = rt_string("中文😀emoji")
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    r = rt_string("中")
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    // 超长串 >255 字节（触发 str16 0xda 长度前缀）：300 个 'y'
    var long_y: string = ""
    li = 0
    while li < 300 {
        long_y = long_y + "y"
        li = li + 1
    }
    r = rt_string(long_y)
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)

    // ==== 紧凑性断言 ====
    println("=== 紧凑性 ===")
    r = 0
    if len(encode_i64(5)) == 1 {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    r = 0
    if len(encode_bool(true)) == 1 {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    r = 0
    if len(encode_string("hi")) == 3 {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)

    // ==== 表 roundtrip：[1,2,3] / ["a","b"] / 嵌套 [[1,2],[3,4]] ====
    println("=== 表 roundtrip ===")
    var t3 = table_new_i64()
    table_push(t3, 1)
    table_push(t3, 2)
    table_push(t3, 3)
    var et3 = encode_i64_array(t3)
    var (dt0, pt0) = decode_table(et3, 0, 0)
    var dt: table<i64> = dt0
    r = 0
    if pt0 > 0 && len(dt) == 3 && dt[0] == 1 && dt[1] == 2 && dt[2] == 3 {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)

    var ts = table_new_string()
    table_push(ts, "a")
    table_push(ts, "b")
    var ets = encode_string_array(ts)
    var (ds0, pts0) = decode_table(ets, 0, 2)
    var ds: table<string> = ds0
    r = 0
    if pts0 > 0 && len(ds) == 2 && ds[0] == "a" && ds[1] == "b" {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)

    // 嵌套表 [[1,2],[3,4]]（二维表字面量）→ 扁平 [1,2,3,4] + 行长度 [2,2]
    var t2d = [1, 2; 3, 4]
    var et2d = encode_nested_i64_array(t2d)
    var (flat0, lens0, pn0) = decode_table_nested(et2d, 0)
    var flat: table<i64> = flat0
    var lens: table<i64> = lens0
    r = 0
    if pn0 > 0 && len(flat) == 4 && flat[0] == 1 && flat[1] == 2 && flat[2] == 3 && flat[3] == 4 && len(lens) == 2 && lens[0] == 2 && lens[1] == 2 {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)

    // ==== map 平行表 roundtrip：["a":1, "b":2] ====
    println("=== map 平行表 roundtrip ===")
    var mkeys = table_new_string()
    table_push(mkeys, "a")
    table_push(mkeys, "b")
    var mvals = table_new_i64()
    table_push(mvals, 1)
    table_push(mvals, 2)
    var emap = encode_map_i64(mkeys, mvals)
    var (dk0, dv0, pm0) = decode_map(emap, 0, 0)
    var dk: table<string> = dk0
    var dv: table<i64> = dv0
    r = 0
    if pm0 > 0 && len(dk) == 2 && dk[0] == "a" && dk[1] == "b" && len(dv) == 2 && dv[0] == 1 && dv[1] == 2 {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    // map 中文键值
    var mkeys2 = table_new_string()
    table_push(mkeys2, "名字")
    var mvals2 = table_new_i64()
    table_push(mvals2, 42)
    var emap2 = encode_map_i64(mkeys2, mvals2)
    var (dk2_0, dv2_0, pm2_0) = decode_map(emap2, 0, 0)
    var dk2: table<string> = dk2_0
    var dv2: table<i64> = dv2_0
    r = 0
    if pm2_0 > 0 && len(dk2) == 1 && dk2[0] == "名字" && len(dv2) == 1 && dv2[0] == 42 {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)

    // ==== 元组 roundtrip：(1,2,3) 单类型 + 异构 (1,"a",true) ====
    println("=== 元组 roundtrip ===")
    var tu = table_new_i64()
    table_push(tu, 1)
    table_push(tu, 2)
    table_push(tu, 3)
    var etu = encode_tuple(tu)
    var (dtu0, ptu0) = decode_tuple(etu, 0, 0)
    var dtu: table<i64> = dtu0
    r = 0
    if ptu0 > 0 && len(dtu) == 3 && dtu[0] == 1 && dtu[1] == 2 && dtu[2] == 3 {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    // 异构元组 (1,"a",true)：encode_array(3, 各字段编码拼接)，decode 分字段还原。
    // 数组头标签（0x93 fixarray）不参与字段解码——字段字节序列 hbody 直接逐字段解。
    var hbody = table_new_i64()
    hbody = concat(hbody, encode_i64(1))
    hbody = concat(hbody, encode_string("a"))
    hbody = concat(hbody, encode_bool(true))
    var etup = encode_array(3, hbody)
    var (hv1, hp1) = decode_i64(hbody, 0)
    var (hv2, hp2) = decode_string(hbody, hp1)
    var (hv3, hp3) = decode_bool(hbody, hp2)
    r = 0
    if hp3 > 0 && hv1 == 1 && hv2 == "a" && hv3 == 1 && len(etup) == len(hbody) + 1 {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)

    // ==== record 字段（Protobuf tag）：3 字段 i64/string/bool ====
    println("=== record 字段 ===")
    var f1 = encode_field(1, 0, encode_i64(42))     // field 1, varint, 42
    var f2 = encode_field(2, 2, encode_string("hi")) // field 2, len-delimited
    var f3 = encode_field(3, 0, encode_bool(true))   // field 3, varint, true
    var rec = concat(concat(f1, f2), f3)
    var (no1, wt1, vs1, ve1) = decode_field(rec, 0)
    var (iv, ip) = decode_i64(rec, vs1)
    var (no2, wt2, vs2, ve2) = decode_field(rec, ip)
    var (sv, sp) = decode_string(rec, vs2)
    var (no3, wt3, vs3, ve3) = decode_field(rec, sp)
    var (bv3, bp3) = decode_bool(rec, vs3)
    r = 0
    if no1 == 1 && wt1 == 0 && iv == 42 && no2 == 2 && wt2 == 2 && sv == "hi" && no3 == 3 && wt3 == 0 && bv3 == 1 && bp3 > 0 {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)

    // ==== 文件 save/load（含中文，魔数头）====
    println("=== 文件 save/load ===")
    var payload = encode_string("中文持久化测试 persist")
    var saved = save("tieDB/tests/zd_roundtrip.zd", payload)
    r = 0
    if saved {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    var loaded = load("tieDB/tests/zd_roundtrip.zd")
    // is_zd 校验的是**原始文件字节**（含魔数头）；load 已去头，故用 byte_read 检查
    var raw = byte_read("tieDB/tests/zd_roundtrip.zd")
    r = 0
    if is_zd(raw) && !is_zd(loaded) {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    // 去头后字节与原始 payload 一致（len 一致即编码字节完全一致）
    r = 0
    if len(loaded) == len(payload) && len(raw) == len(payload) + 8 {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    // 文件内容 decode 回中文原文
    var (fs, fp) = decode_string(loaded, 0)
    r = 0
    if fp > 0 && fs == "中文持久化测试 persist" {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)
    // 非 zd 数据判定
    var junk = table_new_i64()
    table_push(junk, 0x01)
    table_push(junk, 0x02)
    r = 0
    if !is_zd(junk) {
        r = 1
    }
    total = total + 1
    if r == 0 {
        fail = fail + 1
    }
    println(r)

    // ==== 汇总 ====
    println("=== 汇总 ===")
    println("total=" + to_string(total) + " fail=" + to_string(fail))
    if fail == 0 {
        println("zd 序列化验收通过")
    } else {
        println("zd 序列化验收失败：" + to_string(fail) + " 项未通过")
    }
}
