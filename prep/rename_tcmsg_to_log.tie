// tie:library
// prep/rename_tcmsg_to_log.tie：转换器模块（Harbor M4 改名实战）
//
// 协议：顶层 `func process(src: string) -> string`——输入文本，输出转换后文本。
// 用途：把源码/文档中所有 "tcmsg" 替换为 "log"（Harbor M4 库改名 tcmsg → log，
// 用 tie 语言写转换器完成批量改名，验证 tie-prep 模块系统处理真实任务）。
//
// 挂载方式：tie-prep <输入文件> --module prep/rename_tcmsg_to_log.tie > 输出文件
// 框架（tie-prep）eval 本文件注册 process，再 eval_call 以字符串值直传文本调用。
// 自包含：eval 环境不支持 import，完全基于语言底座原语 str_char / len / 字符串拼接。

// 检查从 i 开始是否命中子串 sub（逐字符匹配，返回是否命中）
func match_at(src: string, n: i64, i: i64, sub: string) -> bool {
    var m: i64 = len(sub)
    if i + m > n {
        return false
    }
    var j: i64 = 0
    while j < m {
        if str_char(src, i + j) != str_char(sub, j) {
            return false
        }
        j = j + 1
    }
    return true
}

// 模块入口（协议约定）：扫描 "tcmsg"（5 字符）出现处替换为 "log"，其余原样保留。
func process(src: string) -> string {
    var n: i64 = len(src)
    var result: string = ""
    var i: i64 = 0
    while i < n {
        if match_at(src, n, i, "tcmsg") {
            result = result + "log"
            i = i + 5
        } else {
            result = result + str_char(src, i)
            i = i + 1
        }
    }
    return result
}
