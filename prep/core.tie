// tie:library
// prep/core.tie：Harbor M3 预处理器核心模块（tie 语言自写，自举阶段一）
//
// 本模块完全用 tie 语言实现预处理逻辑：文件头（// tie: 指令）提取、
// 文件角色判定、正文重建。由 tie-prep（Rust 壳）解释执行：
//   1. Rust 侧完成字节规范化（去 BOM、CRLF→LF）——tie 字符串字面量
//      无法表达 BOM 字符（lexer 仅支持 \n \t \r \\ \" \' \0 转义），
//      且字节规范化属于壳层职责；
//   2. 通过 eval_call("prep::process", src) 调用本模块入口；
//   3. Rust 侧解析返回的协议文本，还原 PreprocessResult。
//
// 协议文本（与 Rust 壳约定）：
//   第 1 行        ROLE:<role>         角色（logic/ui/db/data/library）
//   第 2 行        HEADERS:<n>         头部指令数量
//   接下来 n 行     H:<raw>             每条头部指令原文（剥离 // tie: 前缀后）
//   再 1 行        BODY:<m>            正文的字符数（len 语义，字节——Rust 侧按 str.as_utf 字节截取）
//   剩余内容       <body>              清理后的正文（不含头部行，原样保留）
//
// 设计约束（为什么自包含）：
// - interp 的 eval 不支持 import（REPL v1 限制），模块不能依赖 std/string.tie；
// - 因此内部自带与 string.tie 等价的最小工具集（trim / slice / is_whitespace），
//   全部基于语言底座原语 str_char + len + 拼接实现；
// - 输出协议文本而不是结构化对象，因为 eval_call 只返回一个字符串。
//
// 行为约束（与原 Rust 版 preprocess 逐条对齐）：
// - 头部区 = 文件最前面连续出现的 // tie: 行，允许其间空行；
// - 遇到第一个非头部内容行（非空、非 // tie:）即停止扫描，其后全部是正文；
// - 角色判定按头部指令的首个词（kind）：ui/db/data/library 命中即返回，否则 logic；
// - 正文重建时丢弃头部行及其后的空行（与原版 lines().skip(body_start).join("\n") 一致）。

namespace prep {

// 判断单字符字符串是否为空白字符（空格、制表符、换行、回车）
func is_whitespace(c: string) -> bool {
    if c == " " {
        return true
    }
    if c == "\t" {
        return true
    }
    if c == "\n" {
        return true
    }
    if c == "\r" {
        return true
    }
    return false
}

// 截取字符串 [start, end) 区间的子串；越界自动收敛到边界；空串或 start>=end 返回空串。
// （与 std/string.tie 的 str_slice 逐字符语义一致，但模块自包含不能依赖 import）
func slice(s: string, start: i64, end: i64) -> string {
    var n: i64 = len(s)
    if n == 0 {
        return ""
    }
    var lo: i64 = start
    if lo < 0 {
        lo = 0
    }
    if lo > n {
        lo = n
    }
    var hi: i64 = end
    if hi < 0 {
        hi = 0
    }
    if hi > n {
        hi = n
    }
    if lo >= hi {
        return ""
    }
    var result: string = ""
    var i: i64 = lo
    while i < hi {
        // str_char 越界（含多字节字符的字节间隙）返回空串，拼接空串无副作用
        result = result + str_char(s, i)
        i = i + 1
    }
    return result
}

// 去除字符串首尾空白字符；全空白字符串返回空串
func trim(s: string) -> string {
    var n: i64 = len(s)
    var start: i64 = 0
    while start < n && is_whitespace(str_char(s, start)) {
        start = start + 1
    }
    var end: i64 = n
    while end > start && is_whitespace(str_char(s, end - 1)) {
        end = end - 1
    }
    return slice(s, start, end)
}

// 判断 s 是否以 prefix 开头
func starts_with(s: string, prefix: string) -> bool {
    var n: i64 = len(s)
    var m: i64 = len(prefix)
    if n < m {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_char(s, i) != str_char(prefix, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 按 "\n" 切分行表：保留空行；末尾空串（源以 \n 结尾时 split 产生的尾空）剔除——
// 与 Rust 的 lines() 语义一致，保证与原版正文重建逐字节对齐
func split_lines(s: string) -> table {
    var lines = table_new_string()
    var n: i64 = len(s)
    if n == 0 {
        // 空输入 → 空表（Rust lines() 对空串返回空迭代器）
        return lines
    }
    var cur: string = ""
    var i: i64 = 0
    while i < n {
        var c: string = str_char(s, i)
        if c == "\n" {
            table_push(lines, cur)
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    // 收尾：最后一段压入（含空串）
    table_push(lines, cur)
    // 剔除尾部空元素（对应 Rust lines() 丢弃末尾 \n 产生的空行）：
    // 仅当最后一个元素为空且还有前驱时剔除，中间空行不受影响
    var last: i64 = len(lines) - 1
    if last > 0 && lines[last] == "" {
        var trimmed = table_new_string()
        var j: i64 = 0
        while j < last {
            table_push(trimmed, lines[j])
            j = j + 1
        }
        return trimmed
    }
    return lines
}

// 用 "\n" 连接表元素（无尾部换行，与原版 collect::<Vec<_>>().join("\n") 一致）
func join_lines(lines: table) -> string {
    var n: i64 = len(lines)
    var result: string = ""
    var i: i64 = 0
    while i < n {
        if i > 0 {
            result = result + "\n"
        }
        result = result + lines[i]
        i = i + 1
    }
    return result
}

// 头部指令的 kind：第一个词（按 '=' 或空格切分），用于角色判定
// （与原版 Header::kind 的 split(['=', ' ']).next().trim() 对齐）
func header_kind(raw: string) -> string {
    var n: i64 = len(raw)
    var i: i64 = 0
    while i < n {
        var c: string = str_char(raw, i)
        if c == "=" || c == " " {
            return trim(slice(raw, 0, i))
        }
        i = i + 1
    }
    return trim(raw)
}

// 角色判定：按头部指令出现顺序，命中 ui/db/data/library 即返回；否则默认逻辑
func detect_role(headers: table) -> string {
    var n: i64 = len(headers)
    var i: i64 = 0
    while i < n {
        var k: string = header_kind(headers[i])
        if k == "ui" {
            return "ui"
        }
        if k == "db" {
            return "db"
        }
        if k == "data" {
            return "data"
        }
        if k == "library" {
            return "library"
        }
        i = i + 1
    }
    return "logic"
}

// 模块入口（协议约定：func process(src: string) -> string）
// 输入：已由壳层完成去 BOM + CRLF 归一的源码文本
// 输出：协议文本 ROLE:...\nHEADERS:n\nH:...\nBODY:<字节数>\n<正文>
func process(src: string) -> string {
    var lines = split_lines(src)
    var n: i64 = len(lines)
    var headers = table_new_string()
    var in_header_zone = true

    // 第一遍：提取头部区（头部行与其间空行），同时记录正文开始
    var body_start: i64 = 0
    var content_found = false
    var i: i64 = 0
    while i < n {
        var line = lines[i]
        var trimmed = trim(line)
        var skip_to_next = false
        if in_header_zone {
            if trimmed == "" {
                // 头部区域内的空行：跳过（仍算头部区域）
                skip_to_next = true
            } else if starts_with(trimmed, "// tie:") {
                var raw = trim(slice(trimmed, 7, len(trimmed)))
                table_push(headers, raw)
                skip_to_next = true
            } else {
                // 第一个非头部内容行：正文自此开始
                in_header_zone = false
            }
        }
        if !skip_to_next && !content_found {
            body_start = i
            content_found = true
        }
        i = i + 1
    }

    // 正文重建：body_start 起的所有行（含空行），用 \n 连接
    var body: string = ""
    if body_start < n {
        var body_lines = table_new_string()
        var j: i64 = body_start
        while j < n {
            table_push(body_lines, lines[j])
            j = j + 1
        }
        body = join_lines(body_lines)
    }

    // 角色判定
    var role = detect_role(headers)

    // 组装协议文本（text 是保留宽类型名，用 out）
    var out = "ROLE:" + role + "\n"
    var nh = len(headers)
    out = out + "HEADERS:" + to_string(nh) + "\n"
    var k: i64 = 0
    while k < nh {
        out = out + "H:" + headers[k] + "\n"
        k = k + 1
    }
    out = out + "BODY:" + to_string(len(body)) + "\n"
    out = out + body
    return out
}

}