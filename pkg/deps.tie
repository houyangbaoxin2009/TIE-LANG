type tie<class>
// deps.tie —— 依赖安装与解析模块（Harbor M6 包管理器 E1/E2/E3/E4）
//
// 职责：
//   - **安装**（install / install_one）：按 spec 源安装单个/批量依赖到
//     `.tie/deps/<包名>/`。三种源：
//       * path 源（"path:目录"）：copy_dir 复制本地目录；
//       * git 源（git+... / 含 .git / ssh 形式）：fetch_git 浅克隆；
//       * registry 源（裸版本/约束）：resolve_registry_version 选版本 +
//         fetch_registry 下载解压 tar.gz。
//   - **依赖解析**（resolve）：BFS + 队头指针（无递归）递归读取依赖的 tie.pkg
//     的 dependencies → 去重（同名取满足全部约束的最高版本，registry 冲突时
//     按约束集重选）→ 冲突检测（无满足版本报错）；深度限制 3 防环；
//     解析结果生成 tie.lock 文本（委托 lock 模块）。
//   - **锁文件恢复**（install_from_lock）：按 lock 条目（解析版本/来源）逐项
//     落地到 .tie/deps/，缓存命中不重复拉取（幂等）。
//
// tie 约束处理（重要）：
// - 跨模块传参一律用**逗号分隔字符串序列**（表参数元素类型静态未知）；
//   本模块内新建的局部表（split 结果 / resolve 的队列与结果表）可下标读写；
// - **tie 的 && 非短路**：边界判断与下标不写进同一条件，用嵌套 if；
// - 无 continue/break/递归：迭代 + 队头指针 + return 提前退出；
// - `table`/`text`/`code`/`char`/`bool`/`i64`/`f64` 是类型关键字，不可作
//   变量名/参数名（本模块用 tbl 作表变量名）。
// - import 约定：fetch/lock 经**别名 ft/lk** 引入，import 语句放在**文件末尾**
//   （自身命名空间声明在前）——保证 collect_ns_paths 的命名空间顺序为
//   [deps, fetch, version, lock]，导入方别名（main 的 dp）正确映射到本文件的
//   deps 命名空间（映射取首个命中，顺序错了会映射到 fetch/version）。

namespace deps {
    // ================= 通用字符串工具（自备） =================

    // 拆 s 为字符串动态表（连续分隔符产生空元素；空串返回单空元素表）。
    func split(s: string, sep: string) -> table {
        var tbl = table_new_string()
        var m: i64 = len(sep)
        if m == 0 {
            table_push(tbl, s)
            return tbl
        }
        var n: i64 = len(s)
        var start: i64 = 0
        var i: i64 = 0
        while i < n {
            var matched: bool = true
            var j: i64 = 0
            while j < m && matched {
                if i + j >= n {
                    matched = false
                } else if str_char(s, i + j) != str_char(sep, j) {
                    matched = false
                }
                j = j + 1
            }
            if matched {
                table_push(tbl, slice(s, start, i))
                i = i + m
                start = i
            } else {
                i = i + 1
            }
        }
        table_push(tbl, slice(s, start, n))
        return tbl
    }

    // 截取 s 的 [start, end) 子串；越界自动收敛；start>=end 返回空串。
    func slice(s: string, start: i64, end: i64) -> string {
        var n: i64 = len(s)
        var lo: i64 = start
        if lo < 0 {
            lo = 0
        }
        if lo > n {
            lo = n
        }
        var hi: i64 = end
        if hi < 0 {
            hi = 0
        }
        if hi > n {
            hi = n
        }
        var result: string = ""
        var i: i64 = lo
        while i < hi {
            result = result + str_char(s, i)
            i = i + 1
        }
        return result
    }

    // 判断 s 是否以 prefix 开头。
    func starts_with(s: string, prefix: string) -> bool {
        var n: i64 = len(s)
        var m: i64 = len(prefix)
        if m > n {
            return false
        }
        var i: i64 = 0
        while i < m {
            if str_char(s, i) != str_char(prefix, i) {
                return false
            }
            i = i + 1
        }
        return true
    }

    // 查找 sub 在 s 中首次出现的位置（0 起）；未找到返回 -1。
    func find(s: string, sub: string) -> i64 {
        var n: i64 = len(s)
        var m: i64 = len(sub)
        if m == 0 {
            return 0
        }
        if m > n {
            return -1
        }
        var i: i64 = 0
        while i <= n - m {
            var j: i64 = 0
            var matched: bool = true
            while j < m && matched {
                if str_char(s, i + j) != str_char(sub, j) {
                    matched = false
                }
                j = j + 1
            }
            if matched {
                return i
            }
            i = i + 1
        }
        return -1
    }

    // 从 pos 起查找 sub 首次出现的位置（含 pos）；未找到返回 -1。
    func find_from(s: string, sub: string, pos: i64) -> i64 {
        if pos < 0 {
            return -1
        }
        var n: i64 = len(s)
        var m: i64 = len(sub)
        if m == 0 {
            return pos
        }
        if pos + m > n {
            return -1
        }
        var i: i64 = pos
        while i <= n - m {
            var j: i64 = 0
            var matched: bool = true
            while j < m && matched {
                if str_char(s, i + j) != str_char(sub, j) {
                    matched = false
                }
                j = j + 1
            }
            if matched {
                return i
            }
            i = i + 1
        }
        return -1
    }

    // ================= 源判定透传（main 经 dp 调用，避免重复 import fetch） =================

    // spec 是否为 git 源（透传 ft.is_git）。
    pub func is_git(spec: string) -> bool {
        return ft.is_git(spec)
    }

    // git clone URL（去 git+ 与 #tag，透传 ft.git_url）。
    pub func git_url(spec: string) -> string {
        return ft.git_url(spec)
    }

    // 由 git spec 推导仓库名（透传 ft.git_name）。
    pub func git_name(spec: string) -> string {
        return ft.git_name(spec)
    }

    // 版本/约束合法性校验（透传 ft.valid_version，tie add 用）。
    pub func valid_version(spec: string) -> bool {
        return ft.valid_version(spec)
    }

    // ================= 锁文件透传（main 经 dp 调用，避免重复 import lock） =================

    // tie.lock 是否已存在。
    pub func lock_exists() -> bool {
        return lk.exists()
    }

    // 读取 tie.lock。
    pub func lock_read() -> string {
        return lk.read()
    }

    // 写入 tie.lock。
    pub func lock_write(lock_text: string) -> bool {
        return lk.write(lock_text)
    }

    // 校验锁文件与当前 tie.pkg 直接依赖是否一致（幂等恢复前提）。
    pub func lock_valid(lock_text: string, pkg_src: string) -> bool {
        return lk.valid(lock_text, pkg_src)
    }

    // 锁文件依赖名序列（S3.2 P5c 安装后签名校验用；透传 lk.names）。
    pub func lock_names(lock_text: string) -> string {
        return lk.names(lock_text)
    }

    // ================= 读取依赖的 tie.pkg（自备轻量扫描，不重复 import manifest） =================

    // 扫描依赖包 tie.pkg 的 dependencies 数组：want_name=true 取包名序列，
    // false 取 spec 序列（逗号分隔字符串序列）。
    func scan_deps(src: string, want_name: bool) -> string {
        var out: string = ""
        var p = find(src, "\"dependencies\":")
        if p < 0 {
            return ""
        }
        var lb = find_from(src, "[", p)
        if lb < 0 {
            return ""
        }
        var dstart = lb + 1
        var dend = find_from(src, "]", dstart)
        if dend < 0 {
            return ""
        }
        var pos = dstart
        while pos < dend {
            var q1 = find_from(src, "\"", pos)
            if q1 < 0 {
                return out
            }
            if q1 >= dend {
                return out
            }
            var q2 = find_from(src, "\"", q1 + 1)
            if q2 < 0 {
                return out
            }
            var name = slice(src, q1 + 1, q2)
            var q3 = find_from(src, "\"", q2 + 1)
            if q3 < 0 {
                return out
            }
            if q3 >= dend {
                return out
            }
            var q4 = find_from(src, "\"", q3 + 1)
            if q4 < 0 {
                return out
            }
            var spec = slice(src, q3 + 1, q4)
            if name != "" {
                if out != "" {
                    out = out + ","
                }
                if want_name {
                    out = out + name
                } else {
                    out = out + spec
                }
            }
            pos = q4 + 1
        }
        return out
    }

    // 依赖包 tie.pkg 的依赖名/依赖 spec 序列（与 manifest.dep_names/specs 同语义）。
    func dep_names_of(pkg_src: string) -> string {
        return scan_deps(pkg_src, true)
    }
    func dep_specs_of(pkg_src: string) -> string {
        return scan_deps(pkg_src, false)
    }

    // ================= 底层目录复制（path 源与缓存落地的公共流程） =================

    // 复制 src_dir 的**内容**到 dest（先无条件清旧目标再建目录，保证幂等）。
    // 注：dest 为目录，file_exists 在编译路径对目录恒 false，故直接无条件删。
    func copy_to(dest: string, src_dir: string) -> bool {
        remove_dir_all(dest)
        if !mkdir_all(dest) {
            print_err("[pkg]  创建目录失败: " + dest + "\n")
            return false
        }
        if !copy_dir(src_dir, dest) {
            print_err("[pkg]  安装失败 " + dest + " ← " + src_dir + "\n")
            return false
        }
        return true
    }

    // ================= 单个依赖安装（按 spec 源） =================

    // 安装单个依赖到 .tie/deps/<name>/：path / git / registry 三种源。
    func install_one(name: string, spec: string) -> bool {
        // ---- path 源：复制目录 ----
        if starts_with(spec, "path:") {
            var src = slice(spec, 5, len(spec))
            var ok = copy_to(".tie/deps/" + name, src)
            if ok {
                println("[pkg]  已安装 " + name + " ← " + src)
            }
            return ok
        }
        // ---- git 源：浅克隆 ----
        if ft.is_git(spec) {
            println("[pkg]  拉取 git " + name + " ← " + spec)
            var ok = ft.fetch_git(ft.git_url(spec), ft.git_tag(spec), ".tie/deps/" + name)
            if ok {
                println("[pkg]  已安装 " + name + " ← " + spec)
            }
            return ok
        }
        // ---- registry 源：选版本 + 下载解压 ----
        var ver = ft.resolve_registry_version(name, spec)
        if ver == "" {
            print_err("[pkg]  无满足约束版本: " + name + "@" + spec + "\n")
            return false
        }
        println("[pkg]  下载 " + name + "@" + ver + " ← " + ft.pkg_url(name, ver))
        return ft.fetch_registry(name, ver, ".tie/deps/" + name)
    }

    // ================= 批量安装入口（按 spec 序列；保留供外部直接调用） =================

    // 安装全部依赖（names / specs 为逗号分隔序列，按下标一一对应）。
    // 返回失败个数。
    pub func install(name_seq: string, spec_seq: string) -> i64 {
        var names = split(name_seq, ",")
        var specs = split(spec_seq, ",")
        var n: i64 = len(names)
        var failed: i64 = 0
        var i: i64 = 0
        while i < n {
            if names[i] != "" {
                if !install_one(names[i], specs[i]) {
                    failed = failed + 1
                }
            }
            i = i + 1
        }
        return failed
    }

    // ================= 依赖解析（BFS 递归 + 去重 + 冲突检测） =================

    // 解析全部依赖（顶层依赖名/约束序列 + 根项目名/版本），生成 tie.lock 文本。
    // 返回空串 = 解析失败（git 拉取失败 / 无满足版本 / 冲突，已打印错误）。
    pub func resolve(name_seq: string, spec_seq: string, root_name: string, root_ver: string) -> string {
        // ---- 队列（BFS；无递归用队头指针；q_base = 依赖包目录，path 子依赖相对它解析） ----
        var q_names = table_new_string()
        var q_specs = table_new_string()
        var q_deps = table_new_i64()
        var q_base = table_new_string()
        // ---- 已入队去重（同名同 spec 只处理一次，防环/防重复） ----
        var eq_names = table_new_string()
        var eq_specs = table_new_string()
        // 顶层依赖入队（深度 0，基目录空）
        var top_names = split(name_seq, ",")
        var top_specs = split(spec_seq, ",")
        var tn: i64 = len(top_names)
        var t: i64 = 0
        while t < tn {
            if top_names[t] != "" {
                // S3.2（P4b 接口依赖）：`port:` 前缀 = 接口依赖（依赖 port 而非
                // 具体实现，如 port:window），实现由构建参数（--backend）绑定；
                // 完整支持待 S2.4 port 分支合入——当前版本识别并跳过解析。
                if starts_with(top_specs[t], "port:") {
                    println("[pkg]  接口依赖 " + top_names[t] + "（port: 前缀）待 S2.4 port 支持，跳过解析")
                } else {
                    table_push(q_names, top_names[t])
                    table_push(q_specs, top_specs[t])
                    table_push(q_deps, 0)
                    table_push(q_base, "")
                    table_push(eq_names, top_names[t])
                    table_push(eq_specs, top_specs[t])
                }
            }
            t = t + 1
        }
        // ---- 解析结果（最终写入锁文件：名字/版本/来源/原 spec） ----
        var r_names = table_new_string()
        var r_vers = table_new_string()
        var r_srcs = table_new_string()
        var r_specs = table_new_string()
        // ---- 累积约束（同名多次出现时的冲突检测依据） ----
        var c_names = table_new_string()
        var c_specs = table_new_string()

        // ---- BFS 主循环 ----
        var h: i64 = 0
        while h < len(q_names) {
            var name = q_names[h]
            var spec = q_specs[h]
            var depth = q_deps[h]
            var base = q_base[h]
            var ver: string = ""
            var src: string = ""
            var pkg_dir: string = ""

            // 1) 按源类型解析具体版本 + 定位包目录（读其 tie.pkg 用）
            if starts_with(spec, "path:") {
                var rel = slice(spec, 5, len(spec))
                var full = rel
                if base != "" {
                    full = path_join(base, rel)
                }
                ver = "path"
                src = "path:" + full
                pkg_dir = full
            } else if ft.is_git(spec) {
                var staging = ".tie/cache/git/" + name
                if !ft.fetch_git(ft.git_url(spec), ft.git_tag(spec), staging) {
                    print_err("[pkg]  git 拉取失败: " + spec + "\n")
                    return ""
                }
                var tag = ft.git_tag(spec)
                ver = tag
                if ver == "" {
                    ver = "HEAD"
                }
                src = spec
                pkg_dir = staging
            } else {
                // registry 源：精确版本原样 / 约束查 index 选最高
                var v = ft.resolve_registry_version(name, spec)
                if v == "" {
                    print_err("[pkg]  无满足约束版本: " + name + "@" + spec + "\n")
                    return ""
                }
                var staging = ".tie/cache/registry/" + name + "/" + v
                if !ft.fetch_registry(name, v, staging) {
                    print_err("[pkg]  下载失败: " + name + "@" + v + "\n")
                    return ""
                }
                ver = v
                src = ft.pkg_url(name, v)
                pkg_dir = staging
            }

            // 2) 记录解析结果（同名去重 + 冲突检测）
            var idx: i64 = -1
            var ri: i64 = 0
            while ri < len(r_names) {
                if r_names[ri] == name {
                    idx = ri
                }
                ri = ri + 1
            }
            if idx < 0 {
                // 首次出现：直接记录
                table_push(r_names, name)
                table_push(r_vers, ver)
                table_push(r_srcs, src)
                table_push(r_specs, spec)
            } else {
                // 已解析过：检查新约束是否兼容
                var conflict: bool = false
                var old_ver = r_vers[idx]
                var old_src = r_srcs[idx]
                if old_ver == "path" || old_ver == "HEAD" {
                    // 非版本源（path / git HEAD）：要求来源一致
                    if old_src != src {
                        conflict = true
                    }
                } else {
                    // 版本源（registry / git tag）：新 spec 须也是版本约束
                    if starts_with(spec, "path:") || ft.is_git(spec) {
                        conflict = true
                    } else if !ft.version_ok(old_ver, spec) {
                        // 旧版本不满足新约束 → 尝试按**全部约束**重选（仅 registry 可）
                        if starts_with(old_src, "http://") || starts_with(old_src, "https://") {
                            // 收集该名已累积的全部约束
                            var seq: string = ""
                            var k: i64 = 0
                            while k < len(c_names) {
                                if c_names[k] == name {
                                    if seq != "" {
                                        seq = seq + ","
                                    }
                                    seq = seq + c_specs[k]
                                }
                                k = k + 1
                            }
                            if seq != "" {
                                seq = seq + ","
                            }
                            seq = seq + spec
                            var nv = ft.resolve_from_constraints(name, seq)
                            if nv == "" {
                                conflict = true
                            } else {
                                // 找到满足全部约束的更高版本：更新解析结果
                                r_vers[idx] = nv
                                r_srcs[idx] = ft.pkg_url(name, nv)
                            }
                        } else {
                            conflict = true
                        }
                    }
                }
                if conflict {
                    print_err("[pkg]  依赖冲突: " + name + " 无满足全部约束的版本（新增约束: " + spec + "）\n")
                    return ""
                }
            }

            // 3) 累积约束（同名同约束去重）
            var cdup: bool = false
            var ci2: i64 = 0
            while ci2 < len(c_names) {
                if c_names[ci2] == name {
                    if c_specs[ci2] == spec {
                        cdup = true
                    }
                }
                ci2 = ci2 + 1
            }
            if !cdup {
                table_push(c_names, name)
                table_push(c_specs, spec)
            }

            // 4) 递归读取该依赖的 tie.pkg（深度限制 3 防环）
            if depth < 3 {
                var pkg_file = path_join(pkg_dir, "tie.pkg")
                if file_exists(pkg_file) {
                    var pkg_src = file_read(pkg_file)
                    var cnames = dep_names_of(pkg_src)
                    if cnames != "" {
                        var cspecs = dep_specs_of(pkg_src)
                        var cn = split(cnames, ",")
                        var cs = split(cspecs, ",")
                        var ci: i64 = 0
                        while ci < len(cn) {
                            if cn[ci] != "" {
                                var cname = cn[ci]
                                var cspec = cs[ci]
                                // S3.2（P4b 接口依赖）：port: 前缀跳过递归解析
                                if starts_with(cspec, "port:") {
                                    println("[pkg]  接口依赖 " + cname + "（port: 前缀）待 S2.4 port 支持，跳过解析")
                                } else {
                                    // 同名同 spec 已入队 → 跳过（防重复处理/防环）
                                    var dup: bool = false
                                    var k: i64 = 0
                                    while k < len(eq_names) {
                                        if eq_names[k] == cname {
                                            if eq_specs[k] == cspec {
                                                dup = true
                                            }
                                        }
                                        k = k + 1
                                    }
                                    if !dup {
                                        table_push(q_names, cname)
                                        table_push(q_specs, cspec)
                                        table_push(q_deps, depth + 1)
                                        table_push(q_base, pkg_dir)
                                        table_push(eq_names, cname)
                                        table_push(eq_specs, cspec)
                                    }
                                }
                            }
                            ci = ci + 1
                        }
                    }
                }
            }

            h = h + 1
        }

        // 5) 结果表 → 逗号分隔序列 → 生成锁文件文本
        var n_seq: string = ""
        var v_seq: string = ""
        var s_seq: string = ""
        var sp_seq: string = ""
        var i: i64 = 0
        while i < len(r_names) {
            if i > 0 {
                n_seq = n_seq + ","
                v_seq = v_seq + ","
                s_seq = s_seq + ","
                sp_seq = sp_seq + ","
            }
            n_seq = n_seq + r_names[i]
            v_seq = v_seq + r_vers[i]
            s_seq = s_seq + r_srcs[i]
            sp_seq = sp_seq + r_specs[i]
            i = i + 1
        }
        return lk.make(root_name, root_ver, n_seq, v_seq, s_seq, sp_seq)
    }

    // ================= 锁文件恢复（幂等安装） =================

    // 按锁文件条目安装全部依赖到 .tie/deps/。缓存（.tie/cache）命中不重复拉取。
    // 返回失败个数。
    pub func install_from_lock(lock_text: string) -> i64 {
        var names_seq = lk.names(lock_text)
        if names_seq == "" {
            return 0
        }
        var vers_seq = lk.versions(lock_text)
        var srcs_seq = lk.sources(lock_text)
        var ns = split(names_seq, ",")
        var vs = split(vers_seq, ",")
        var ss = split(srcs_seq, ",")
        var failed: i64 = 0
        var i: i64 = 0
        while i < len(ns) {
            if ns[i] != "" {
                if !install_locked(ns[i], vs[i], ss[i]) {
                    failed = failed + 1
                }
            }
            i = i + 1
        }
        return failed
    }

    // 按锁条目（名字/解析版本/来源）安装单个依赖。
    func install_locked(name: string, ver: string, src: string) -> bool {
        var dest = ".tie/deps/" + name
        // path 源：直接复制
        if starts_with(src, "path:") {
            var p = slice(src, 5, len(src))
            println("[pkg]  安装 " + name + " ← " + p)
            return copy_to(dest, p)
        }
        // git 源：缓存命中则复用，否则浅克隆
        // 注：fetch_git 克隆后会清掉 .git 子目录，缓存存在性用 tie.pkg 文件探测
        //（file_exists 编译路径对目录恒 false，不能直接判断目录本身）
        if ft.is_git(src) {
            var staging = ".tie/cache/git/" + name
            if !file_exists(staging + "/tie.pkg") {
                if !ft.fetch_git(ft.git_url(src), ft.git_tag(src), staging) {
                    print_err("[pkg]  git 拉取失败: " + src + "\n")
                    return false
                }
            }
            println("[pkg]  安装 " + name + " ← " + src)
            return copy_to(dest, staging)
        }
        // registry 源：source 为完整 tar 包 URL；缓存命中则复用，否则下载解压
        var staging = ".tie/cache/registry/" + name + "/" + ver
        if !file_exists(staging + "/tie.pkg") {
            var dir = ".tie/cache/registry/" + name
            if !mkdir_all(dir) {
                print_err("[pkg]  创建目录失败: " + dir + "\n")
                return false
            }
            var tmp = dir + "/" + ver + ".tar.gz"
            if !http_get_file(src, tmp) {
                print_err("[pkg]  下载失败: " + src + "\n")
                return false
            }
            // 无条件清旧目标（目录存在与否都删，幂等）
            remove_dir_all(staging)
            if !untar_gz(tmp, staging) {
                print_err("[pkg]  解压失败: " + tmp + "\n")
                return false
            }
        }
        println("[pkg]  安装 " + name + "@" + ver + " ← " + src)
        return copy_to(dest, staging)
    }
}

// 见文件头「import 约定」：import 必须位于文件末尾（自身命名空间在前），
// 使 collect_ns_paths 的命名空间顺序为 [deps, fetch, version, lock]，
// 保证 main 的别名 dp 正确映射到本文件的 deps 命名空间。
import "./fetch.tie" as ft;
import "./lock.tie" as lk;
