// tie:logic
// byte_demo.tie：D7 字节流原语演示（byte_read/byte_write/bit_read/bit_write/byte_concat）
// 编译运行：cargo run -p tie -- examples/byte_demo.tie

func main() {
    // ---- byte_write → byte_read roundtrip ----
    var ok = byte_write("examples/byte_tmp.bin", byte_of("hello"))
    var data = byte_read("examples/byte_tmp.bin")
    println("write=" + (ok ? "true" : "false") + " len=" + to_string(len(data)))
    println("data: " + to_string(data[0]) + " " + to_string(data[1]) + " " + to_string(data[2]) + " " + to_string(data[3]) + " " + to_string(data[4]))

    // ---- byte_concat ----
    var part1 = byte_of("ab")
    var part2 = byte_of("cd")
    var joined = byte_concat(part1, part2)
    println("concat len=" + to_string(len(joined)) + " [0]=" + to_string(joined[0]) + " [3]=" + to_string(joined[3]))

    // ---- bit_read / bit_write ----
    var bits = byte_of("A") // 0x41 = 0100 0001
    println("bit0=" + to_string(bit_read(bits, 0)) + " bit6=" + to_string(bit_read(bits, 6)))
    var bw = bit_write(bits, 6, 0)
    println("bit_write=" + (bw ? "true" : "false") + " bit6_after=" + to_string(bit_read(bits, 6)))

    println("---")
    var pass: bool = true
    pass = pass && ok
    pass = pass && len(data) == 5
    pass = pass && data[0] == 104 && data[4] == 111 // 'h' 'o'
    pass = pass && len(joined) == 4 && joined[0] == 97 && joined[3] == 100
    pass = pass && bit_read(bits, 0) == 1 && bit_read(bits, 6) == 0
    if pass {
        println("PASS")
    } else {
        println("FAIL")
    }
    file_delete("examples/byte_tmp.bin")
}

// 字符串 → 字节表（ASCII）
func byte_of(s: string) -> table {
    var t = table_new_i64()
    var i: i64 = 0
    while i < len(s) {
        table_push(t, ascii(str_char(s, i)))
        i = i + 1
    }
    return t
}

// 字符 → ASCII 码
func ascii(c: string) -> i64 {
    var lower = "abcdefghijklmnopqrstuvwxyz"
    var i: i64 = 0
    while i < len(lower) {
        if str_char(lower, i) == c {
            return 97 + i
        }
        i = i + 1
    }
    var upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    i = 0
    while i < len(upper) {
        if str_char(upper, i) == c {
            return 65 + i
        }
        i = i + 1
    }
    return 0
}
