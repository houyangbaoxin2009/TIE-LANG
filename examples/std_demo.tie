// tie:logic
// std_demo.tie：标准库演示——导入 assert 与 string 库，演示全部函数与文件操作
// M2.1 起 std 库使用命名空间形式：assert.assert / str.str_trim 等。

import "../std/assert.tie"
import "../std/string.tie"

// 将布尔值转为可读文本（不依赖 to_string 对 bool 的支持）
func bool_str(b: bool) -> string {
    if b {
        return "true"
    }
    return "false"
}

func main() {
    // ---- 断言演示 ----
    assert.assert(true)
    assert.assert_eq(1 + 1, 2)
    assert.assert_neq(1, 2)
    println("断言全部通过")

    // ---- 字符串演示 ----
    var trimmed: string = str.str_trim("  hello  ")
    println("str.str_trim: [" + trimmed + "]")
    assert.assert_eq(len(trimmed), 5)

    var sliced: string = str.str_slice("hello", 1, 4)
    println("str.str_slice: " + sliced)
    assert.assert(sliced == "ell")

    var has: bool = str.str_contains("hello world", "world")
    println("str.str_contains: " + bool_str(has))
    assert.assert(has)

    var sw: bool = str.str_starts_with("hello", "he")
    println("str.str_starts_with: " + bool_str(sw))
    assert.assert(sw)

    var ew: bool = str.str_ends_with("hello", "lo")
    println("str.str_ends_with: " + bool_str(ew))
    assert.assert(ew)

    var replaced: string = str.str_replace("aaa", "a", "b")
    println("str.str_replace: " + replaced)
    assert.assert(replaced == "bbb")

    var found: i64 = str.str_find("hello world", "world")
    println("str.str_find: " + to_string(found))
    assert.assert_eq(found, 6)
    var not_found: i64 = str.str_find("hello", "xyz")
    assert.assert_eq(not_found, -1)

    // ---- 文件操作演示 ----
    var path: string = "std_demo_tmp.txt"
    var w1: bool = file_write(path, "line1\n")
    println("file_write: " + bool_str(w1))
    assert.assert(w1)

    var r1: string = file_read(path)
    println("file_read: " + r1)
    assert.assert(r1 == "line1\n")

    var ex: bool = file_exists(path)
    println("file_exists: " + bool_str(ex))
    assert.assert(ex)

    var w2: bool = file_append(path, "line2\n")
    println("file_append: " + bool_str(w2))
    assert.assert(w2)

    var r2: string = file_read(path)
    println("file_read(追加后): " + r2)
    assert.assert(r2 == "line1\nline2\n")

    // 清理临时文件（file_delete 为 M2.2 新底座原语）
    var del: bool = file_delete(path)
    println("file_delete: " + bool_str(del))
    assert.assert(del)
    assert.assert(!file_exists(path))
}