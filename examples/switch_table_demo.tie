// C5 switch 跳转表验证：整数 case 生成 LLVM switch 指令（O(1) 分派）
func classify(n: i64) -> string {
    switch n {
        case 1:
            return "one"
        case 2:
            return "two"
        case 3:
            return "three"
        default:
            return "other"
    }
}

func main() {
    var i: i64 = 0
    while i < 6 {
        println(classify(i))
        i = i + 1
    }
}
