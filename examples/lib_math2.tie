// lib_math2.tie：P6 二级导入验证——自身再导入 lib_util（嵌套 import）
// M2.1 起示例库使用命名空间形式：math2.add3 / math2.sqsum，内部跨命名空间调用 util.square。
import "./lib_util.tie"

namespace math2 {
pub func add3(a: i64, b: i64, c: i64) -> i64 {
    return a + b + c
}

pub func sqsum(a: i64, b: i64) -> i64 {
    return util.square(a) + util.square(b)
}
}
