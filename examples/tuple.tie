// tuple.tie：P7 元组功能演示
// 覆盖：字面量、命名访问、ItemN 访问、数字下标访问、
//       多值返回、解构、嵌套、类型标注适配

// 多值返回：整除返回商与余数（命名元组类型）
func divmod(a: i64, b: i64) -> (q: i64, r: i64) {
    return (a / b, a % b)
}

// 嵌套元组 + 字符串字段
func info() -> (name: string, scores: (i64, i64)) {
    return ("tie", (98, 100))
}

func main() {
    // 1. 字面量 + ItemN 访问
    var t = (10, 20)
    println(t.Item1)
    println(t.Item2)
    // 2. 数字下标访问
    println(t.0)
    println(t.1)
    // 3. 命名元组：命名访问
    var p = (x: 3, y: 4)
    println(p.x)
    println(p.y)
    // 4. 多值返回 + 命名访问
    var d = divmod(17, 5)
    println(d.q)
    println(d.r)
    // 5. 解构
    var (q, r) = divmod(17, 5)
    println(q)
    println(r)
    // 6. 类型标注适配：字面量适配窄类型
    var w: (i32, i64) = (7, 8)
    println(w.Item1)
    println(w.Item2)
    // 7. 嵌套元组 + 字符串字段
    var i = info()
    println(i.name)
    println(i.scores.Item1)
    println(i.scores.Item2)
    // 8. 返回元组直接字段访问（链式）
    println(divmod(9, 2).q)
    println(divmod(9, 2).r)
}
