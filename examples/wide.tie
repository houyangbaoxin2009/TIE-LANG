// tie:logic
// tie:opt=2

// 宽类型（num/text/misc 类别框）与表字面量语法验证
// M2 表运行时支持单行纯位置表（数字 id），字符串 id 表、二维表留待 M3

func main() {
    // 宽类型 num：整数与浮点均接受，scope 存具体推导类型
    var a: num = 42
    var b: num = 3.14
    println(a)
    println(b)

    // 宽类型 text：字符串与字符均接受
    var s: text = "hello"
    println(s)

    // 宽类型 misc：其余类型（bool）
    var ok: misc = true
    println(ok)

    // 表字面量：逗号分列（单行纯位置表，M2 支持）；下标访问
    var arr: table = [1, 2, 3]
    println(arr[1])
    // 表遍历
    for item in arr {
        println(item)
    }
    println("表字面量解析成功")
}
