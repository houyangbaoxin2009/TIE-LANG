// oop.tie：M2.1.8 struct 数据与逻辑分离演示
// struct = 纯数据（只含字段）；逻辑 = 绑定 struct 名的命名空间函数（pub func），
// obj.method() 调用由编译器转发为 命名空间函数(首参: struct名)（实例方法）/
// struct名.fn()（静态风格，无接收者）。this/static/class 已废弃。

// 静态风格：通过 struct 名调用，无接收者
namespace MathHelper {
    pub func twice(x: i64) -> i64 {
        return x * 2
    }
    pub func greet(name: string) -> string {
        return "Hello, " + name + "!"
    }
}

// 计数器：接收者显式为首参（c.count 字段读写）
struct Counter {
    var count: i64
}
namespace Counter {
    pub func inc(c: Counter) {
        c.count = c.count + 1
    }
    pub func get(c: Counter) -> i64 {
        return c.count
    }
}

// 继承：父 struct 字段 + 子 struct 字段；方法沿继承链转发（子类遮蔽父类）
struct Animal {
    var name: string
    var age: i64
}
struct Dog extends Animal {
    var breed: string
}
namespace Animal {
    pub func speak(a: Animal) -> string {
        return a.name + " makes a sound"
    }
}
namespace Dog {
    pub func speak(d: Dog) -> string {
        return d.name + " barks"
    }
    pub func info(d: Dog) -> string {
        return "I am a " + d.breed
    }
}

// 构造缺省字段：未传参用默认值
struct Point {
    var x: i64
    var y: i64 = 10
}

func main() {
    // 1. struct 名调用（静态风格）
    println(MathHelper.twice(21))
    println(MathHelper.greet("tie"))

    // 2. 构造 + 字段读取 + 方法转发（obj.method() → Counter::get(obj)）
    var c = Counter(0)
    c.inc()
    c.inc()
    c.inc()
    println(c.get())
    // 直接字段读写
    c.count = 100
    println(c.count)

    // 3. 构造缺省字段：未传参用默认值
    var p = Point(5)
    println(p.x)
    println(p.y)

    // 4. 继承：父 struct 字段 + 子 struct 字段 + 方法遮蔽
    var d = Dog("Rex", 3, "Golden")
    println(d.name)
    println(d.age)
    println(d.breed)
    println(d.speak())
    println(d.info())

    // 5. 父 struct 实例：自己的方法
    var a = Animal("Cat", 2)
    println(a.speak())
}
