// oop.tie：P8 class/OOP 功能演示
// 覆盖：类定义、构造（字段位置初始化 + 缺省默认值）、字段读写、
//       实例方法（this）、静态方法（类名调用）、继承（字段拍平 + 方法遮蔽）

// 静态方法：通过类名调用，无 this
class MathHelper {
    static method twice(x: i64) -> i64 {
        return x * 2
    }
    static method greet(name: string) -> string {
        return "Hello, " + name + "!"
    }
}

// 计数器：实例方法 this 字段读写
class Counter {
    var count: i64
    method inc() {
        this.count = this.count + 1
    }
    method get() -> i64 {
        return this.count
    }
}

// 继承：父类字段/方法 + 子类新增字段
class Animal {
    var name: string
    var age: i64
    method speak() -> string {
        return this.name + " makes a sound"
    }
}

class Dog extends Animal {
    var breed: string
    // 遮蔽父类方法
    method speak() -> string {
        return this.name + " barks"
    }
    method info() -> string {
        return "I am a " + this.breed
    }
}

// 构造缺省字段：未传参用默认值
class Point {
    var x: i64
    var y: i64 = 10
}

func main() {
    // 1. 静态方法调用
    println(MathHelper.twice(21))
    println(MathHelper.greet("tie"))

    // 2. 构造 + 字段读取 + 实例方法
    var c = Counter(0)
    c.inc()
    c.inc()
    c.inc()
    println(c.get())
    // 直接字段读写
    c.count = 100
    println(c.count)

    // 3. 构造缺省字段：未传参用默认值
    var p = Point(5)
    println(p.x)
    println(p.y)

    // 4. 继承：父类字段 + 子类字段 + 方法遮蔽
    var d = Dog("Rex", 3, "Golden")
    println(d.name)
    println(d.age)
    println(d.breed)
    println(d.speak())
    println(d.info())

    // 5. 父类实例：自己的方法
    var a = Animal("Cat", 2)
    println(a.speak())
}
