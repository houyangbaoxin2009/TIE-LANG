// tie:library
// lib_math.tie：P6 import 验证用的库文件（被主文件导入）；角色 library → 可独立编译为静态库
// 只定义函数，不定义 main

func add(a: i64, b: i64) -> i64 {
    return a + b
}

func mul(a: i64, b: i64) -> i64 {
    return a * b
}

func greet(name: string) -> string {
    return "Hello, " + name
}

func max2(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}
