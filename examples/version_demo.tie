type tie<logic>
// version_demo.tie：std/version semver 版本库演示
// 编译运行：cargo run -p tie -- examples/version_demo.tie

import "../std/version.tie"

func main() {
    // ---- 版本比较 ----
    println("compare(0.9.0, 1.0.0) = " + to_string(version.compare("0.9.0", "1.0.0")))
    println("compare(1.0.0, 1.0.0) = " + to_string(version.compare("1.0.0", "1.0.0")))
    println("compare(2.1.3, 1.0.0) = " + to_string(version.compare("2.1.3", "1.0.0")))
    println("compare(1.0.0, 1.0.1) = " + to_string(version.compare("1.0.0", "1.0.1")))
    // 缺段补零：1.2 == 1.2.0
    println("compare(1.2, 1.2.0) = " + to_string(version.compare("1.2", "1.2.0")))

    println("---")

    // ---- 约束匹配 ----
    println("satisfies(1.5.0, ^1.2) = " + (version.satisfies("1.5.0", "^1.2") ? "true" : "false"))
    println("satisfies(2.0.0, ^1.2) = " + (version.satisfies("2.0.0", "^1.2") ? "true" : "false"))
    println("satisfies(1.2.0, >=1.0) = " + (version.satisfies("1.2.0", ">=1.0") ? "true" : "false"))
    println("satisfies(0.9.0, >=1.0) = " + (version.satisfies("0.9.0", ">=1.0") ? "true" : "false"))
    println("satisfies(1.5.0, 1.0.0) = " + (version.satisfies("1.5.0", "1.0.0") ? "true" : "false"))
    println("satisfies(1.0.0, 1.0.0) = " + (version.satisfies("1.0.0", "1.0.0") ? "true" : "false"))
    println("satisfies(3.2.1, *) = " + (version.satisfies("3.2.1", "*") ? "true" : "false"))

    println("---")
    // 断言汇总
    var pass: bool = true
    pass = pass && version.compare("0.9.0", "1.0.0") == -1
    pass = pass && version.compare("1.0.0", "1.0.0") == 0
    pass = pass && version.compare("2.1.3", "1.0.0") == 1
    pass = pass && version.satisfies("1.5.0", "^1.2")
    pass = pass && !version.satisfies("2.0.0", "^1.2")
    pass = pass && version.satisfies("1.2.0", ">=1.0")
    pass = pass && !version.satisfies("1.5.0", "1.0.0")
    if pass {
        println("PASS")
    } else {
        println("FAIL")
    }
}
