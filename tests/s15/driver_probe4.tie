type tie<logic>
// S1.5 探针4：1:1 复现 driver 166-179 段（含裸 trim/slice/has_prefix 定义）
// 目标：定位 @173:55 rest moved 的真正触发点
func has_prefix(s: string, prefix: string) -> bool {
    var n = str_len(s)
    var m = str_len(prefix)
    if m > n {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_char(s, i) != str_char(prefix, i) {
            return false
        }
        i = i + 1
    }
    return true
}

func slice(s: string, start: i64, end: i64) -> string {
    var out: string = ""
    var i: i64 = start
    while i < end {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

func trim(s: string) -> string {
    var n: i64 = str_len(s)
    var start: i64 = 0
    var end: i64 = n
    while start < end && (str_char(s, start) == " " || str_char(s, start) == "\t") {
        start = start + 1
    }
    while end > start && (str_char(s, end - 1) == " " || str_char(s, end - 1) == "\t") {
        end = end - 1
    }
    return slice(s, start, end)
}

func main() {
    var lines = ["type tie", "type tie<logic>", "  type tie<data>  "]
    var i: i64 = 0
    while i < len(lines) {
        var ln = trim(lines[i])
        if str_len(ln) == 0 {
            i = i + 1
            continue
        }
        if has_prefix(str.clone(ln), "type tie") {
            var rest = trim(str.slice(ln, 8, str_len(ln)))
            if str_len(rest) == 0 {
                println("base")
            }
            // 173 行：rest 复用链
            if str_len(rest) >= 3 && str_char(rest, 0) == "<" && str_char(rest, str_len(rest) - 1) == ">" {
                var sub = trim(slice(rest, 1, str_len(rest) - 1))
                println("sub:" + sub)
            } else {
                println("rest:" + rest)
            }
        }
        i = i + 1
    }
}
