type tie<logic>
// S1.5 探针8：probe7 结构 + while 循环包裹
// 目标：验证 while 循环体内嵌套作用域移动状态恢复
func main() {
    var i: i64 = 0
    while i < 1 {
        var flag = true
        if flag {
            var rest: string = "abc"
            if str_len(rest) >= 3 && str_char(rest, 0) == "<" && str_char(rest, str_len(rest) - 1) == ">" {
                println("if-pass")
            } else {
                println("if-else")
            }
            var n = str_len(rest)
            println(to_string(n))
        }
        i = i + 1
    }
}