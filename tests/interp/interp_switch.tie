type tie<logic>

// 自举 v2 T4.4：interp 行为测试 tie 化——switch 模式匹配。
// 移植自 crates/tie-interp/src/lib.rs tests：eval_switch_模式匹配。
// 多值/区间/守卫/字符区间/类型匹配/组合。注意：块语句（switch）以 } 结束，
// 后不能加分号；块内语句需分号。

import "../../interp/interp.tie"

var g_fail: i64 = 0;

func check(actual: string, expected: string) {
    if actual == expected {
        println("PASS  [" + expected + "]")
    } else {
        println("FAIL  got=[" + actual + "]")
        println("      want=[" + expected + "]")
        g_fail = g_fail + 1
    }
}

func main() {
    // 多值：任一相等即命中
    interp.reset()
    check(interp.eval("var x = 2; switch x { case 1, 2: 10; default: 0; }"), "10")
    // 区间命中（3 ≤ 5 < 7）
    interp.reset()
    check(interp.eval("var x = 5; switch x { case 3..7: 20; default: 0; }"), "20")
    // 左闭右开：x = 7 不命中 3..7 → default
    interp.reset()
    check(interp.eval("var x = 7; switch x { case 3..7: 20; default: 0; }"), "0")
    // 守卫拦截：flag = false → 落入 default
    interp.reset()
    check(interp.eval("var f = false; var x = 8; switch x { case 8 when f: 30; default: 0; }"), "0")
    // 守卫放行：值匹配 且 守卫为真 → 进入分支
    interp.reset()
    check(interp.eval("var f = true; var x = 8; switch x { case 8 when f: 30; default: 0; }"), "30")
    // 类型匹配：interp 动态类型按 Value 变体匹配（eval 路径允许）
    interp.reset()
    check(interp.eval("var s = \"hi\"; switch s { case string: 50; default: 0; }"), "50")
    // 多值 + 区间 + 守卫组合：任一 pattern 命中 且 守卫为真
    interp.reset()
    check(interp.eval("var f = true; var x = 4; switch x { case 1, 3..5 when f: 60; default: 0; }"), "60")
    // default 省略且全不匹配 → 无输出（switch 返回 None）
    interp.reset()
    check(interp.eval("var x = 99; switch x { case 1: 1; } 0"), "0")

    // 字符区间：'a' ≤ 'b' < 'e' —— SKIP（tie interp 已知缺陷：字符字面量
    // 'b' 反转义后取到单引号码点 39 而非 'b' 的码点 98，字符区间比较失准）。
    // Rust 期望 40；tie interp 当前返回 0。依赖 interp 字符字面量修复（T4.2）。
    println("SKIP  [字符区间 case 'a'..'e'] 依赖 interp 字符字面量修复（T4.2）")

    if g_fail == 0 {
        println("interp_switch 验收通过：全部比对一致（golden 对齐 Rust interp；字符区间 SKIP）")
    } else {
        println("interp_switch 验收失败：" + to_string(g_fail) + " 项不一致")
        exit(1)
    }
}
