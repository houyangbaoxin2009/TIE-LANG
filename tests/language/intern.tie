// tie:logic
// tie:opt=2

// T0.6 验收：字符串池（std/intern.tie）——字符串 → 稳定整数 id 的 intern 机制。
//
// 断言约定（与 std/intern.tie 一致）：
// - id 从 0 递增分配（首次 intern 得 0，之后逐个 +1）；相同串返回相同 id；
// - lookup(id) 对未登记 id 返回空串 "" 哨兵（编译器侧 -1 是"无名字"另一哨兵）；
// - 池为模块级全局状态：跨函数调用 id 稳定。
// 预期输出：intern 验收通过（全部断言通过，无 assert 失败退出）。
import "../../std/assert.tie"
import "../../std/intern.tie"
using intern;
using assert;

// 跨函数 id 稳定验证：probe 内部 intern，调用方 lookup 同一串
func probe(s: string) -> i64 {
    return intern.intern(s)
}

// 跨函数 roundtrip 验证：roundtrip 内部 lookup，调用方比对
func roundtrip(id: i64) -> string {
    return intern.lookup(id)
}

func main() {
    // 1. 相同串返回相同 id；首次登记 id 从 0 递增
    var a = intern.intern("abc")
    var b = intern.intern("abc")
    assert.assert_eq(a, b)
    assert.assert_eq(a, 0)
    // 2. 不同串 id 不同；id 递增
    var c = intern.intern("xyz")
    assert.assert_neq(a, c)
    assert.assert_eq(c, 1)
    // 3. lookup roundtrip：intern 之后能取回原串
    assert.assert_eq_str(intern.lookup(a), "abc")
    assert.assert_eq_str(roundtrip(c), "xyz")
    // 4. 跨函数 id 稳定：probe 登记的串，main 里 lookup 得到同一串
    var pid = probe("跨函数")
    assert.assert_eq_str(intern.lookup(pid), "跨函数")
    // 5. 缺失 id 返回约定哨兵空串
    assert.assert_eq_str(intern.lookup(999), "")
    assert.assert_eq_str(intern.lookup(-1), "")
    // 6. 池条目数
    assert.assert_eq(intern.interned_len(), 3)
    // 7. 乱序登记后二分序正确（后登记的"abc"在前的串仍可查）
    var d = intern.intern("mid")
    assert.assert_eq(d, 3)
    assert.assert_eq(intern.interned_len(), 4)
    assert.assert_eq_str(intern.lookup(0), "abc")
    assert.assert_eq_str(intern.lookup(2), "跨函数")
    // 8. 重复登记不新增条目
    assert.assert_eq(intern.intern("xyz"), c)
    assert.assert_eq(intern.interned_len(), 4)
    println("intern 验收通过")
}
