type tie<logic>
// runtime.a 退役后验收：exec_code / time_now / get_env 内联到 libc。
//
// std/runtime.a 已退役——这三个内置由编译器**内联**到 libc 直调
// （@system / @time / @getenv），编译产物不含 tie_* 运行时符号，也不链接
// runtime.a / tie_interp.lib（纯 libc，零运行时依赖）。
//
// 期望输出（stdout，逐字节）：
//   tie-runtime-ok      ← exec_code("echo tie-runtime-ok") 的子进程输出（继承 stdout）
//   0                   ← exec_code 退出码（echo 成功）
//   <Unix 秒时间戳>      ← time_now()
//   <PATH 环境变量值>    ← get_env("PATH")
func main() {
    // exec_code：执行命令并返回退出码（内联 libc system）
    var rc = exec_code("echo tie-runtime-ok")
    println(rc)
    // time_now：Unix 纪元秒（内联 libc time(0)）
    var t = time_now()
    println(t)
    // get_env：读取环境变量（内联 libc getenv；PATH 常驻，避免 getenv NULL 边界）
    var p: string = get_env("PATH")
    println(p)
}
