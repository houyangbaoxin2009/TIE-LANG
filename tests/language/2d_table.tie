type tie<logic>

// ============================================================
// 二维表字面量验收（特性①）：`[1,2;3,4]` 分号分行 → 语法层 desugar 为
// 嵌套表 `[[1,2],[3,4]]`（table<table<i64>>），`t[0][1]` 二维下标访问正确。
//
// 覆盖场景：
//   1. 二维表字面量赋值：t = [1,2;3,4] → 嵌套表，t[0][1] / t[1][0] 访问
//   2. 外层行数 len(t) / 内层列数 len(t[0])
//   3. 行长度不一致合法：[1;2,3]（行 0 一列、行 1 两列，与嵌套表同规则）
//   4. for 外层遍历行 × 内层遍历元素求和
//
// 期望输出：
//   2 / 3 / 2 / 2 / 2 / 2 / 10
// ============================================================

func main() {
    // 1. 二维表字面量 → 嵌套表：t[0] = [1,2]、t[1] = [3,4]
    var t = [1, 2; 3, 4]
    println(t[0][1])   // 2
    println(t[1][0])   // 3
    // 2. 外层行数 = len(t)；内层列数 = len(t[0])
    println(len(t))    // 2
    println(len(t[0])) // 2
    // 3. 行长度不一致：[1; 2,3] → 行 0 为 [1]、行 1 为 [2,3]
    var u = [1; 2, 3]
    println(len(u))    // 2
    println(len(u[1])) // 2
    // 4. for 遍历二维表：外层行 × 内层元素累加
    var s: i64 = 0
    for row in t {
        for x in row {
            s = s + x
        }
    }
    println(s)         // 10
}
