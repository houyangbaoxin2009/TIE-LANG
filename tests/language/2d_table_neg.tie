type tie<logic>

// ============================================================
// 二维表负例验收（特性①）：
//   1. 二维表（分号分行）含 id 元素：`[1,2; 3:4]` → 语法错误
//      （desugar 为嵌套表时 id 语义无意义）
//
// 单文件编译时**第一个错误即停**（属预期）。
// 期望错误关键字：二维表不支持 id 元素
// ============================================================

func main() {
    var t = [1, 2; 3: 4]
    println(t[0][1])
}
