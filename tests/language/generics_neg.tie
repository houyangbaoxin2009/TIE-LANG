type tie<logic>

// ============================================================
// 泛型系统负例验收（T3b 单态化展开器 + 调用点类型推断）
//
// 每例以注释标注期望错误关键字 + 代码触发（编译应失败）。
// 单文件编译时**第一个错误即停**（属预期）——全部负例覆盖于此，
// 实际触发顺序由语义阶段决定（collect_top 先于函数体检查）。
//
// 覆盖场景（对照 docs/language.md §测试 泛型错误规定）：
//   1. 类型参数推断冲突：max(3, 3.5) → T 推断 i64 vs f64 冲突
//      期望错误关键字：推断冲突
//   2. 无法推断（无信息实参）：identity() 无参调用 → T 无法绑定
//      期望错误关键字：无法推断
//   3. 实例化后类型错误：f<string>("x") → 展开后函数体 `a + 1` 中
//      a 是 string，不支持算术 → 二元运算两侧类型不一致
//      期望错误关键字：类型不一致
//   4. 未定义的泛型调用（推断冲突）：max("a", 1) → T 推断 string vs i64 冲突
//      期望错误关键字：推断冲突
//   5. 实例化深度超限（递归泛型模板自引用）：Loop<i64> 的字段
//      next: Loop<Loop<T>> → mangled 名无限增长，触发 64 层深度防御
//      期望错误关键字：实例化深度超限
// ============================================================

// ----- 负例 1 与 4 共用模板：max（单类型参数，返回类型也是 T）-----
func max<T>(a: T, b: T) -> T {
    if a > b {
        return a
    }
    return b
}

// ----- 负例 2 模板：identity（恒等）-----
func identity<T>(x: T) -> T {
    return x
}

// ----- 负例 3 模板：f（模板体内对 T 用算术，实例化 string 时报错）-----
func f<T>(a: T) -> T {
    return a + 1
}

// ----- 负例 5 模板：Loop（递归自引用，触发实例化深度超限）-----
struct Loop<T> {
    var next: Loop<Loop<T>>;
}

// touch 参数类型引用 Loop<i64> → 实例化 Loop 模板 → 字段 next:
// Loop<Loop<i64>> → 递归实例化 → mangled 无限增长 → 深度防御（64 层）触发。
// （该签名解析在 collect_top 阶段发生，故为单文件的首个实际错误。）
func touch(x: Loop<i64>) -> i64 {
    return 0
}

func main() {
    // 负例 1：类型参数推断冲突（a:T 绑定 i64，b:T 绑定 f64）
    var m1 = max(3, 3.5)
    println(m1)
    // 负例 2：无法推断（无信息实参，无显式类型实参）
    var i1 = identity()
    println(i1)
    // 负例 3：实例化后类型错误（T=string，`a + 1` 不支持）
    var f1 = f("x")
    println(f1)
    // 负例 4：未定义的泛型调用（T 推断 string vs i64 冲突）
    var m2 = max("a", 1)
    println(m2)
    // 负例 5：实例化深度超限（touch 签名已触发，此处保留调用点）
    touch(table_new_i64())
}
