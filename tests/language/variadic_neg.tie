type tie<logic>

// ============================================================
// 变参函数负例验收（特性④）：
//   1. 变参元素类型不匹配：sum(1, "x") → 语义错误
//      （多余实参逐个与变参元素类型 i64 匹配）
//
// 单文件编译时**第一个错误即停**（属预期）。
// 期望错误关键字：变参元素类型不匹配
// ============================================================

func sum(rest: ...i64) -> i64 {
    var s: i64 = 0
    for x in rest {
        s = s + x
    }
    return s
}

func main() {
    println(sum(1, "x"))
}
