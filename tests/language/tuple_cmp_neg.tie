type tie<logic>

// ============================================================
// 元组比较负例验收（特性②）：
//   1. 元组 < 比较 → 语义错误（元组只支持 ==/!= 逐字段比较，< > <= >=
//      无全序意义）
//
// 单文件编译时**第一个错误即停**（属预期）。
// 期望错误关键字：元组只支持 ==/!=
// ============================================================

func main() {
    println((1, 2) < (1, 3))
}
