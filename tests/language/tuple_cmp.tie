type tie<logic>

// ============================================================
// 元组 ==/!= 比较验收（特性②）：逐字段比较，支持嵌套元组 / 字符串字段；
// < > <= >= 对元组仍编译报错（见 tuple_cmp_neg.tie 负例）。
//
// 覆盖场景：
//   1. 数字字段：(1,2) == (1,2) → true；(1,2) != (1,3) → true
//   2. 字符串字段：(1,"a") == (1,"a") → true；(1,"a") == (1,"b") → false
//   3. 嵌套元组：((1,2),3) == ((1,2),3) → true；(1,(2,3)) != (1,(2,4)) → true
//   4. ==/!= 作为 if 条件
//
// 期望输出（bool 以 1/0 打印）：
//   1 / 1 / 1 / 0 / 1 / 1 / yes
// ============================================================

func main() {
    // 1. 数字字段比较
    println((1, 2) == (1, 2))       // 1
    println((1, 2) != (1, 3))       // 1
    // 2. 字符串字段比较（strcmp 逐字段）
    println((1, "a") == (1, "a"))   // 1
    println((1, "a") == (1, "b"))   // 0
    // 3. 嵌套元组递归比较
    println(((1, 2), 3) == ((1, 2), 3)) // 1
    println((1, (2, 3)) != (1, (2, 4))) // 1
    // 4. == 作为 if 条件
    if (1, 2) == (1, 2) {
        println("yes")
    }
}
