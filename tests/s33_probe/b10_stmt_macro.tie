type tie<logic>
// dev33 批次10 任务28：语句级宏（宏出现在语句位置展开）
// ============================================================
// 语句位置宏调用（N_EXPR_STMT 路径）展开为多条语句/语句块：
//   times(n, body) → var i=0; while i<n { body; i=i+1 }（自定义循环）
//   unless(cond, body) → if !cond { body }（守卫）
// 期望输出：sum=6 / log 1..3 / guard ok（sum=106）

macro times(n: code, body: code) -> code {
    var i = gensym("i")
    return `{
        var $i: i64 = 0
        while $i < $n {
            $body
            $i = $i + 1
        }
    };
}

macro unless(cond: code, body: code) -> code {
    return `{
        if !($cond) {
            $body
        }
    };
}

func main() -> i64 {
    var sum = 0
    times(3, `{ sum = sum + 2; })
    println("sum=" + to_string(sum))   // sum=6（自定义循环）

    var k = 0
    times(3, `{
        k = k + 1;
        println("log " + to_string(k));
    })
    // log 1 / log 2 / log 3（多语句循环体）

    var flag = false
    unless(flag, `{ sum = sum + 100; })
    println("sum=" + to_string(sum))   // sum=106（守卫）
    return 0
}
