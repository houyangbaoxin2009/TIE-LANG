# Rust 编译产物
/target/
**/*.rs.bk

# 示例编译产物
/examples/*.exe
/examples/*.ll
/examples/*.o
/examples/*.obj

# IDE 与编辑器
.idea/
.vscode/
# 例外：VSCode 扩展的调试配置（F5 开发调试必需，见 editor/vscode-tie/README.md）
!editor/vscode-tie/.vscode/
!editor/vscode-tie/.vscode/*
*.swp
*.swo

# 系统与临时文件
Thumbs.db
.DS_Store
*.tmp

# 记忆与本地配置（不入库）
.localmemory/
opencode.json

# 代码索引与计划（本地生成，不入库）
.codegraph/
.omo/

# 库编译产物
/examples/*.a
/examples/*.lib
/std/*.a

# 发行版打包产物（dist/）与 REPL 自举产物（repl.exe）
/dist/
/repl/repl.exe

# 自举 v2 REPL 构建产物（T4.3）：compiler/repl.exe（tie 自写解释器 REPL，
# 由 scripts/repl-parity.ps1 / tie-llvm 编译 compiler/repl.tie 生成）与 parity
# 脚本使用的临时 Rust 通道 _rust_repl.exe（repl/repl.tie 编译到 compiler/ 下）
/compiler/repl.exe
/compiler/_rust_repl.exe

# 自举 v2 tiec 编译器产物——tiec.exe 作为 stage0 引导二进制**入库版本化**
# （自举语言惯例：删除 Rust 种子后，clone 即可用 tiec 自举；tiec 自身编译
#  compiler/driver.tie 生成，源码变更后重新自举并提交同步更新）
# /compiler/tiec.exe   ← 不再忽略（入库）

# 自举 v2 测试编译产物（tests/language/*.tie 经 tiec 编译生成）
/tests/language/*.exe

# 包管理器自举产物（pkg.exe，由 tie-llvm 编译 pkg/main.tie 生成）
/pkg/pkg.exe

# 包管理器演示项目产物（tie init 生成：main.exe 编译产物 + .tie/ 安装目录）
/examples/demo_pkg/*.exe
/examples/demo_pkg/.tie/

# 自举 v2 调试/构建残留（bench/diag/日志/中间 IR）
/compiler/*.ll
/compiler/*.exe
# tiec.exe 豁免：stage0 引导二进制入库版本化（见上方 48-51 行说明），
# 否定规则须位于 *.exe 通配之后才能生效
!/compiler/tiec.exe
/compiler/*.bc
/compiler/bench_*
/compiler/cd*.ll
/compiler/diag*
/compiler/selfhost_log*.txt
/compiler/min*.ll
/compiler/test_out.ll

# Logo 渲染临时目录（浏览器 profile 残留）
/assets/.render/
/assets/concepts/.render/
/assets/preview/.render/
# S2.3 错误处理探针编译产物（tests/s23_probe/*.tie 由 tiec 编译生成）
/tests/s23_probe/*.exe
# 文件系统层损坏的 tiec.exe 备份（无法删除，git 读取即崩溃 0xC0000006，忽略）
/compiler/tiec.exe.corrupt
