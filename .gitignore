# Rust 编译产物
/target/
**/*.rs.bk

# 示例编译产物
/examples/*.exe
/examples/*.ll
/examples/*.o
/examples/*.obj

# IDE 与编辑器
.idea/
.vscode/
# 例外：VSCode 扩展的调试配置（F5 开发调试必需，见 editor/vscode-tie/README.md）
!editor/vscode-tie/.vscode/
!editor/vscode-tie/.vscode/*
*.swp
*.swo

# 系统与临时文件
Thumbs.db
.DS_Store
*.tmp

# 记忆与本地配置（不入库）
.localmemory/
opencode.json

# 代码索引与计划（本地生成，不入库）
.codegraph/
.omo/

# 库编译产物
/examples/*.a
/examples/*.lib
/std/*.a

# 发行版打包产物（dist/）与 REPL 自举产物（repl.exe）
/dist/
/repl/repl.exe

# 自举 v2 REPL 构建产物（T4.3）：compiler/repl.exe（tie 自写解释器 REPL，
# 由 scripts/repl-parity.ps1 / tie-llvm 编译 compiler/repl.tie 生成）与 parity
# 脚本使用的临时 Rust 通道 _rust_repl.exe（repl/repl.tie 编译到 compiler/ 下）
/compiler/repl.exe
/compiler/_rust_repl.exe

# 包管理器自举产物（pkg.exe，由 tie-llvm 编译 pkg/main.tie 生成）
/pkg/pkg.exe

# 包管理器演示项目产物（tie init 生成：main.exe 编译产物 + .tie/ 安装目录）
/examples/demo_pkg/*.exe
/examples/demo_pkg/.tie/
