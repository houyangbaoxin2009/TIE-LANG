# Rust 编译产物
/target/
**/*.rs.bk

# 示例编译产物
/examples/*.exe
/examples/*.ll
/examples/*.o
/examples/*.obj

# IDE 与编辑器
.idea/
.vscode/
# 例外：VSCode 扩展的调试配置（F5 开发调试必需，见 editor/vscode-tie/README.md）
!editor/vscode-tie/.vscode/
!editor/vscode-tie/.vscode/*
*.swp
*.swo

# 系统与临时文件
Thumbs.db
.DS_Store
*.tmp

# 记忆与本地配置（不入库）
.localmemory/
opencode.json

# 代码索引与计划（本地生成，不入库）
.codegraph/
.omo/

# 库编译产物
/examples/*.a
/std/*.a

# 发行版打包产物（dist/）与 REPL 自举产物（repl.exe）
/dist/
/repl/repl.exe
